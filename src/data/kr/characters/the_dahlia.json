      ],
      "extra": [
        {
          "id": 10000006,
          "name": "약점 격파 상태",
          "desc": "적의 강인성이 소모되어 0이 됐을 시 진입하는 특수한 상태. 해당 상태에 진입한 목표는 행동 게이지가 감소한다",
          "params": [],
          "type": 2,
          "icon": "SpriteOutput/BuffIcon/Inlevel/IconBuffCommon.png"
        },
        {
          "id": 10000015,
          "name": "슈퍼 격파 피해",
          "desc": "격파 특수효과, 이번 공격의 강인성 감소 수치, 캐릭터 레벨이 높을수록 가하는 슈퍼 격파 피해가 증가한다.\n슈퍼 격파 피해는 치명타를 발동하지 않으며, 피해 증가류 효과의 영향을 받지 않는다.\n슈퍼 격파 피해 역시 격파 피해에 속한다",
