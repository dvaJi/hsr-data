      "messages": {
        "202210000": {
          "id": 202210000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, 파멸에 대해서 말인데",
          "next": [
            202210001
          ]
        },
        "202210001": {
          "id": 202210001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "넌 분명 경험이 풍부하겠지",
          "next": [
            202210002
          ]
        },
        "202210002": {
          "id": 202210002,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210003
          ]
        },
        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "종말 괴수, 팬틸리아, 아이언툼……",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "궁금하네. 그들과 직접 대면했 때 어떤 기분이었는지",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "좋았어요. 손 하나 까딱할 필요도 없이 그냥 쳐다보기만 하면 됐거든요",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "음, 눈빛만으로도 죽일 수 있구나~",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "안타깝게도 아무 감정도 없었어요",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "음~ 감정에 휘둘리지 않는구나?",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "차근차근 진행했어요",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "서로 한 방씩 주고받으니 해결됐죠",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "음, 턴제구나~",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "파멸은 결코 장렬한 순간이 아니지만… 그 아름다움만큼은 의심할 여지가 없지",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "넌 이 길을 계속해서 「개척」해 나갈 거야",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "…「파멸」을 파멸시킬 때까지, 그렇지?",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "우리와 함께할래요? 어차피 당신도 「파멸」을 배반했잖아요",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "그날이 오길 기대하고 있어",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "하지만, 「개척」의 반대편에 선다면",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "「파멸」로 돌아갈 건가요? 두 번의 배반도 일종의 배반이잖아요",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "아이디어 괜찮은데? 마음에 들어",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "만약 「개척」의 반대편에 선다면",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "네가 지핀 불 속으로 걸어 들어갈 수 있겠지",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "그렇다면, 그들의 「각본」처럼",
          "next": [
            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "「기억」을 파멸시키는 절멸 대군이 되는 것도 나쁘지 않은 선택이야",
          "next": [
            202210024
          ]
        },
        "202210024": {
          "id": 202210024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210025
          ]
        },
        "202210025": {
          "id": 202210025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "정신 좀 차리세요!",
          "next": [
            202210026
          ]
        },
        "202210026": {
          "id": 202210026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "사랑, 믿음, 기다림",
          "next": [
            202210027
          ]
        },
