        "202170003": {
          "id": 202170003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "오늘도 좋은 하루야. 물론 이 하루를 꽃으로 장식해 줘야겠지♪",
          "next": [
