      "messages": {
        "150120100": {
          "id": 150120100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "망할 녀석, 뭐 하는 거야?",
          "next": [
            150120101
          ]
        },
        "150120101": {
          "id": 150120101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "누구야?",
          "next": [
            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "모르는 척하지 마! 넌 너굴 통신의 담당자잖아. 이 일 네가 꾸민 짓이지?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "내 손이 말을 안 듣기 시작했어",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "코도 마음대로 움직인다고",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "당장 멈춰",
          "next": [
            150120106,
            150120109
          ]
        },
        "150120106": {
          "id": 150120106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "네가 「밀레니엄 킬러」지?",
          "next": [
            150120107
          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "내 전화번호는 어떻게 안 거야?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "너 내가 누군지도 모르지? 진짜 어이없네, 내가 누군지조차 모르면서 이런 짓까지 한다니",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "네가 그 의사 「무메」지?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "내 전화번호는 어떻게 안 거야?",
          "next": [
            150120111
          ]
        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "아니야! 진짜 어이없네, 내가 누군지도 모르면서 이런 짓까지 한다니",
          "next": [
            150120112
          ]
        },
        "150120112": {
          "id": 150120112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "네 연락처?",
          "next": [
            150120113
          ]
        },
        "150120113": {
          "id": 150120113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "언론사 담당자의 연락처는 공개되어 있어서 확인이 가능하단다. 이것도 모르냐?",
          "next": [
            150120114
          ]
        },
        "150120114": {
          "id": 150120114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "당장 멈춰. 조건을 제시해, 난 다 들어줄 수 있으니까. 이렇게 독하게 굴 필요는 없잖아",
          "next": [
            150120115
          ]
        },
        "150120115": {
          "id": 150120115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "내 다리 방향이 엄청 이상해",
          "next": [
            150120116
          ]
        },
        "150120116": {
          "id": 150120116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "이러지 마",
          "next": []
        }
      },
