  "sections": [
    {
      "id": 2023700,
      "startingMessageId": [
        202370000
      ],
      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "「블레이드 호출기」 플러그인의 버전이 업데이트되었습니다",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "이번 업데이트: 발견한 문제 수정. 충격 완화 성능 향상, 더 많은 냥냥케이크 영상 시청",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "블레이드를 콕 찔렀습니다. 그의 휴대폰이 진동합니다",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "친구 블레이드 님이 온라인 상태입니다",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "마침 잘됐군, 방금 네 생각을 하던 참이었어",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "영광인데요! 어쩌다 제 생각을 했는지 자세히 말해줘요",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "드디어 저랑 회포를 풀려는 건가요?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "아니",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 입력 중입니다",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "전에 무기고에서 마모가 심하지만 재질은 괜찮은 기물을 몇 점 봤는데… 아무도 찾아가지 않는 걸 보니 네가 과거에 남긴 거 같아서",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "마침 네가 메시지를 보냈으니 물어볼게. 어떤 걸 갖고 싶지? 나중에 돌아가면 개조하고 재제작해 줄게",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "제가 뭘 남겼을까요? 무기예요?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "형체를 알아볼 수 없게 된 물건 몇 개인데 구조를 보니 전부 평범한 가정용품인 것 같군",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "물건은 저마다 제 쓰임이 있는 법. 말해봐, 내가 다 만들어줄 테니까",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "에너지 소모가 큰 우주 여행에는 언제 어디서든 절 바로 재워줄 수 있는 「수면 유도기」가 필요하죠",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "과거 선주에서는 그걸 「요람 침대」라고 불렀지",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "좀 평범하지 않은 게 갖고 싶어요",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "잠은 잘 자나?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "얼마 전 우주선에서 수면에 도움이 되는 도구를 몇 개 만들었어. 관심 있나?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "그럼 저 업그레이드할래요! 언제 어디서든 절 바로 재워줄 수 있는 걸 갖고 싶어요",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "그래",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "전 다 괜찮아요, 맘대로 만들어 주세요!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "얼마 전 우주선에서 수면에 도움이 되는 도구를 몇 개 만들었어. 관심 있나?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "오예! 언제 어디서든 절 바로 재워줄 수 있는 수면 유도기를 갖고 싶어요",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "그래",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "재우는 건 어렵지 않지만, 강제 수면 효과를 내려면 추가적인 설계가 필요해",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "백색 소음을 조금 추가하면 더 빨리 잠들 수 있어요",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "간단하지. 쇳조각 몇 개를 덧대면 검을 벼릴 때 나는 윙윙하는 소리를 모방할 수 있어",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "과거에는 이런 소리가 내 정신을 더 맑게 했지. 하지만 어쩌면 너에게 졸음 유발이 될 수도 있겠네",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "물리적인 수면 보조 기능을 추가할 수 있을까요? 마사지나 베개 두드리기 같은 거요",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "…그래",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "공구실에 폐기된 기계 팔 관절 부품이 있는데, 그 동작들을 재현할 수 있겠어",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "소리가 좀 크긴 한데 그냥 백색 소음이라고 치자",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "사람 목소리가 들어간 자장가를 좀 추가할 수 있을까요?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "…그래",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "녹음기 하나를 내장하면 노래 하나를 녹음할 수 있어",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "하지만 난 노래를 잘 못 부르니 기껏해야 네게… 가사를 읊어줄 수 있을 뿐이지",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "네네, 그런 것도 괜찮아요……",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "개조가 끝나면 배송을 받든 직접 찾아가든, 네가 편한 대로 해",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "나중에 연락할게",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "잘 있어",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "친구 블레이드 님이 오프라인 상태입니다",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}