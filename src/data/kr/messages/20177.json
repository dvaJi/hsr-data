      "messages": {
        "201770000": {
          "id": 201770000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "자, 보수도 있어",
          "next": [
            201770001,
            201770002
          ]
        },
        "201770001": {
          "id": 201770001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "얼만데요? 전 아무 일이나 받진 않아서요",
          "next": [
            201770003
          ]
        },
        "201770002": {
          "id": 201770002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "또 테스트하려고요? 저도 이제 시급이 올랐어요",
          "next": [
            201770003
          ]
        },
        "201770003": {
          "id": 201770003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "첨부파일 ≪새 옷 구매 목록 및 정리 가이드≫ 수신 중",
          "next": [
            201770004
          ]
        },
        "201770004": {
          "id": 201770004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "파일이 너무 커서 다운로드할 수 없습니다",
          "next": [
            201770005
          ]
        },
        "201770005": {
          "id": 201770005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "빨리 문자 메시지 시스템을 업그레이드해야겠어",
          "next": [
            201770006
          ]
        },
        "201770006": {
          "id": 201770006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "간단히 말하자면 새 옷을 좀 샀는데 인형들의 힘만으로는 정리가 안 돼",
          "next": [
            201770007,
            201770008
          ]
        },
        "201770007": {
          "id": 201770007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "얼마나 샀길래요? 저도 한 벌 주세요",
          "next": [
            201770009
          ]
        },
        "201770008": {
          "id": 201770008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "저 {NICKNAME}(이)잖아요. 저한테 주세요",
          "next": [
            201770009
          ]
        },
        "201770009": {
          "id": 201770009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "넌 못 입어",
          "next": [
            201770010
          ]
        },
        "201770010": {
          "id": 201770010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "인형한테 사준 거거든",
          "next": [
            201770011,
            201770013
          ]
        },
        "201770011": {
          "id": 201770011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "인형들도 옷을 갈아입어요?",
          "next": [
            201770012
          ]
        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "당연하지, 저렇게 예쁘게 생겼는데 예쁜 옷을 안 사주고 배겨?",
          "next": [
            201770015
          ]
        },
        "201770013": {
          "id": 201770013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이런, 인형이 저보다 옷이 더 많네요",
          "next": [
            201770014
          ]
        },
        "201770014": {
          "id": 201770014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "이제 알았어?",
          "next": [
            201770015
          ]
        },
        "201770015": {
          "id": 201770015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "이번에는 셀 수도 없을 정도로 스타일이 다양해. 정리할 때 종류별로 잘 분류해 놔",
          "next": [
            201770016
          ]
        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "딱 봐도 세련되거나 내 옷처럼 보이는 건 쉽게 구분할 수 있을 거야. 먼저 정리하도록 해",
          "next": [
            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "완•매가 추천한 건 늘 스타일이 비슷하니까, 위에 있는 거랑 같이 둬",
          "next": [
            201770018
          ]
        },
        "201770018": {
          "id": 201770018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "색상이 튀는 건 빈티지 구역에 둬",
          "next": [
            201770019
          ]
        },
        "201770019": {
          "id": 201770019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "패턴이 어렵고 설명하자니 더 난해한 옷은 하이엔드 구역에 두면 돼",
          "next": [
            201770020
          ]
        },
        "201770020": {
          "id": 201770020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "나머지는 가이드를 보고 알아서 해",
          "next": [
            201770021
          ]
        },
        "201770021": {
          "id": 201770021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 위치를 공유했습니다",
          "next": [
            201770022
          ]
        },
        "201770022": {
          "id": 201770022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "옷장 위치를 보냈어, 네 좌표에서 멀지 않을 거야",
          "next": [
            201770023
          ]
        },
        "201770023": {
          "id": 201770023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "소형 우주정거장이 보이면 거기야",
          "next": [
            201770024
          ]
        },
        "201770024": {
          "id": 201770024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "걱정하지 마, 다 들어갈 거야",
          "next": [
            201770025,
            201770027
          ]
        },
        "201770025": {
          "id": 201770025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어디요? 우주정거장? 아스타는 알아요?",
          "next": [
            201770026
          ]
        },
        "201770026": {
          "id": 201770026,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "선입금 후작업이 제 원칙입니다",
          "next": [
            201770029
          ]
        },
        "201770027": {
          "id": 201770027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "인형한테 옷장으로 우주정거장을 사줬다고요? 아스타는 알아요?",
          "next": [
            201770028
          ]
        },
        "201770028": {
          "id": 201770028,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "선입금 후작업이 제 원칙입니다",
          "next": [
            201770029
          ]
        },
        "201770029": {
          "id": 201770029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "나머지 일은 아스타를 찾도록 해",
          "next": [
            201770030
          ]
        },
        "201770030": {
          "id": 201770030,
          "type": "Text",
