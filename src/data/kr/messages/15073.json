      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@히메코 @단항 @웰트 다들 괜찮아?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "수신했으면 대답해 줘, 제발!",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[알림: 현재 통신 신호가 약합니다. 연결 상태를 확인해주세요]",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@Mar. 7th @{NICKNAME} @선데이 수신했어, 우린 괜찮아",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "우린 무사해. @단항, 저쪽에서 걱정하지 않게 답장 부탁하네",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "우리 걱정은 마, 방금 지하에서 튀어나온 촉수 괴물 한 무리를 물리쳤어",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "휴",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그러고 보니, 우리 아스트로폴리스에 꼭 가야 돼? 다른 뜻은 없고, 그냥… 컴퍼니가 좀 못 미더워서",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "선주나 헤르타 우주정거장에 도움을 요청해 보는 건 어때?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "이 문제라면 나도 생각해본 적 있어",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "거리상으로 봤을 때 선주든 헤르타 정거장이든 너무 멀어. 한시가 급한 상황이니, 지금으로서는 아스트로폴리스가 가장 현실적인 대책이야",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "거리보다 더 까다로운 건, 이상 낙원이 컴퍼니 무역 체제의 일부라는 거지",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "성간 무역 협정에 따르면 컴퍼니가 이상 낙원에 대한 우선 처분권을 가지고 있어. 외부 세력이 섣불리 개입했다간 더 복잡한 법적, 외교적 분쟁을 일으킬 수도 있네",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그럼 정말… 다른 방법이 없네요!",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} 항법사의 임무는 너한테 부탁할게",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "걱정 말고 맡겨주세요",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "알아, 널 믿어",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "제가 뭘 해야 할지 모르겠어요…",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "걱정 마, 난 널 믿어. 항법사 대행으로서 너만의 생각이 있겠지",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "위급한 상황이니, 우린 네가 어떤 결정을 내리든 지지할게",
          "next": [
            150730120
          ]
        },
