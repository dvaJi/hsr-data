      "messages": {
        "150220100": {
          "id": 150220100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "{NICKNAME}, 오랜만이야",
          "next": [
            150220101,
            150220103
          ]
        },
        "150220101": {
          "id": 150220101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "설의 님! 설의 님한테 연락을 받을 줄은 몰랐어요!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "너는 여전히 활기가 넘치네",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "확실히 오랫동안 연락을 안 했네요",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "미안, 내가 소홀했어",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "앞으로 시간 날 때 자주 너랑 이야기를 나눌게",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "요즘 이상 낙원을 유람하고 있다면서?",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "작은 부탁이 하나 있어",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "문제없어요, 말씀하세요 판관님!",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "혹시 ≪미스터리 게임≫을 들어본 적 있어?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "나는 이 만화에 관심이 많거든",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "범죄자를 추적하는 전개가 작가의 데뷔작인 ≪볶음왕≫ 보다 더 내 취향이야",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "최근 2차원 시티에서 「미스터리 게임 온리전」이 열린다고 들었는데, 현장에서 많은 2차 창작 작품을 판매한대",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "안타깝게도 나는 신분 때문에 이상 낙원의 만화 전시회에 갈 수 없어",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "아쉬움을 덜 수 있게 나 대신 동인지를 사줬으면 해",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "마침 돌아다니다가 그 만화 전시회장 근처에 왔는데 메시지를 받았어요…. 혹시 절 미행하는 건 아니죠?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "삐삐, 「설의 9527형」 추적 드론 노출됨, 현재 자폭 프로그램 실행 중",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "흑흑흑, 살려주세요! 절 폭파하지 마세요! 동인지 사드릴게요!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "걱정 마, 장난이니까",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "폭발하는 드론은 없으니까 안심해",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "새로운 동인지를 볼 생각에 기대되네, 고마워",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이런 우연이, 저 지금 만화 전시회에 있어요",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "너도 봤어? 그럼 잘됐네, 고마워",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "별거 아니에요, 걱정 말고 맡겨주세요",
          "next": [
            150220124
          ]
        },
        "150220124": {
          "id": 150220124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "새로운 동인지를 볼 생각에 기대되네, 고마워",
          "next": []
        }
      },
