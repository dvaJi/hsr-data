      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "어이~ 방금 역대급으로 억울한 꼴을 당했다면서? 어때, 평소 내 기분이 어떤지 알겠어?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "소식이 어떻게 그렇게 빨라요? 1분도 안 된 일인데 벌써 알았다고요?",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "드디어 제 꼴을 보고 비웃을 수 있게 됐네요? 만족하세요?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "난 사후 취업 센터에 유령 부하를 여럿 둔 몸이잖아. 걔들이 진작부터 근처에 숨어서 나한테 처음부터 끝까지 실시간으로 알려주고 있었어",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "물론, 나도 단순히 빈정거리려고 온 건 아니야. 나한테 널 도울 방법이 있어",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "자세한 건 만나서 얘기하자. 근처에 있으니까 이쪽으로 와",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "스코트 님이 위치를 공유했습니다",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "절 도와주겠다고요? 갑자기 웬 호의래요?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "너 이 녀석, 경계심은 여전하네",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "일단 이리 와서 나랑 얘기 좀 하자. 어차피 내가 널 이길 수 있는 것도 아닌데 뭘 걱정해",
          "next": [
            150930110
          ]
        },
        "150930110": {
          "id": 150930110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "빨리, 나 바빠",
          "next": []
        }
      },
