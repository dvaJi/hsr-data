            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "푸리가 눈물을 글썽이며 상영관을 빠져나오더니, 부리나케 신문사로 달려가는 걸 내가 봤다구리",
          "next": [
