            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "맞다구리! 슈퍼 히어로의 소박한 고민을 너구리도 공감할 수 있을 만큼 잘 연기했어",
          "next": [
