  "sections": [
    {
      "id": 2021100,
      "startingMessageId": [
        202110000
      ],
      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "프리마리우스 경, 난 내 첫 번째 「극한 탐험」 계획을 준비하고 있어",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "그대들은 별을 넘어왔으니 분명 내게 더욱 넓은 차원의 직언을 해 줄 수 있겠지",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "혼자서요? 어디로 가시려고요?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "누군가 함께 가고 싶다고 한다면, 이 카이사르는 당연히 반대하지 않을 거야",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어디로 가시려고요?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "은하열차에 탑승하세요",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "내 여행의 경유지가 될 수도 있겠지만, 그건 나중에 생각해 보지",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "목적지: 미래의 앰포리어스",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "예전에는 길을 걸으면, 기억 속의 모든 나라는 분쟁의 화염이나 검은 물결의 죽음에 휩싸여 있었지",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "기억의 씨앗이 꽃피울 때, 앰포리어스에 생기가 넘칠 거야. 마침 나도 살펴볼 수 있겠군",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "돛단배를 타고 스키아나의 바다를 항해하고 싶어. 그곳의 먹구름과 거센 파도는 끊임없이 싸우고 있거든",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "라돈이란 곳을 들어봤나? 거기엔 구름까지 닿을 수 있는 아주 높은 곳이 있대",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "윙슈트 플라잉과 스카이다이빙 중에 뭘 할지 고민 중이야",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "프리마리우스 경의 의견은 어떤가?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "저는 다 괜찮아요. 어차피 전에도 빙글빙글 돌고, 뛰고, 공중에서 떨어져서 어떤 세계로 들어갔거든요",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "그거 좋은데",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "말하자면 긴데… 전 종종 공중에서 떨어지는 방식으로 어떤 세계로 들어갔어요",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "케리드라 님도 해 봐요",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "그거 좋은데",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "생명을 소중히 여기세요!",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "걱정 마, 카이사르는 그렇게 나약하지 않아",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "얼마 전에 고양이한테 야외 생존 특별 훈련을 받았고, 골드위버 경한테 밧줄 엮는 법도 배웠어",
          "next": [
            202110022
          ]
        },
        "202110022": {
          "id": 202110022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "이제 글래디오럼 경의 수영 특훈을 받아야 하지",
          "next": [
            202110023
          ]
        },
        "202110023": {
          "id": 202110023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "나중에 봐, 프리마리우스 경",
          "next": []
        }
      },
      "participatingContactsIds": [
        1412,
        8001
      ]
    }
  ]
}