            201760007
          ]
        },
        "201760007": {
          "id": 201760007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "재밌는 게 나타났네, 시뮬레이션 우주에 추가하는 걸 고려해 봐야겠어",
          "next": [
            201760008,
            201760010,
            201760012
          ]
        },
        "201760008": {
          "id": 201760008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "테스트하러 가라고 불렀어요?",
          "next": [
            201760009
          ]
        },
        "201760009": {
          "id": 201760009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "절 데리러 올 사람을 보내실 건가요?",
          "next": [
            201760013
          ]
        },
        "201760010": {
          "id": 201760010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어떻게 가죠?",
          "next": [
            201760011
          ]
        },
        "201760011": {
          "id": 201760011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "절 데리러 올 사람을 보내실 건가요?",
          "next": [
            201760013
          ]
        },
        "201760012": {
          "id": 201760012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "얼마나 재밌길래 헤르타 님이 직접 나서요?",
          "next": [
            201760013
          ]
        },
        "201760013": {
          "id": 201760013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "직접 봐",
          "next": [
            201760014
          ]
        },
        "201760014": {
          "id": 201760014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "아, 아니지. 이건 모조품이고 진품은 이미 팔렸어",
          "next": [
            201760015
          ]
        },
        "201760015": {
          "id": 201760015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "잠깐",
          "next": [
            201760016
          ]
        },
        "201760016": {
          "id": 201760016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 위치를 공유했습니다",
          "next": [
            201760017
          ]
        },
        "201760017": {
          "id": 201760017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "도착하면 「구매자: 세상에 단 하나뿐인 헤르타 님」이라고 적힌 입간판을 찾으면 돼",
          "next": [
            201760018
          ]
        },
        "201760018": {
          "id": 201760018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "모조품을 산 거예요?",
          "next": [
            201760019
          ]
        },
        "201760019": {
          "id": 201760019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "진품은 진작에 내가 사 갔는데 깜빡했어",
          "next": [
            201760020
          ]
        },
        "201760020": {
          "id": 201760020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "여긴 아직도 모조품을 입간판처럼 전시해 뒀네",
          "next": [
            201760021
          ]
        },
        "201760021": {
          "id": 201760021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "왜 이렇게 사람이 많이 모였나 했네, 내 팬이잖아?",
          "next": [
            201760022
          ]
        },
        "201760022": {
          "id": 201760022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "팬들은 진품을 만나게 될 줄 상상도 못했을 거예요",
          "next": [
            201760023
          ]
        },
        "201760023": {
          "id": 201760023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "아무도 날 몰라봤어",
          "next": [
            201760024
          ]
        },
        "201760024": {
          "id": 201760024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "근데 내가 엄청 비슷하게 꾸몄다고 칭찬하면서 「헤르타」 응원 굿즈를 주더라",
          "next": [
            201760025
          ]
        },
        "201760025": {
          "id": 201760025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "잘 만들었네, 기념으로 사진 한 장 찍어서 보낼래",
          "next": [
            201760026
          ]
        },
        "201760026": {
          "id": 201760026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
