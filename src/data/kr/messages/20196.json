      "messages": {
        "201960000": {
          "id": 201960000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "운동은?",
          "next": [
            201960001
          ]
        },
        "201960001": {
          "id": 201960001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "오늘의 운동 계획 (완료 시 체크)\n영양 보충 ()\n충분한 준비운동 ()\n어깨+팔 ()\n하체 훈련 ()\n물 마시기 ()",
          "next": [
            201960002,
            201960004,
            201960005
          ]
        },
        "201960002": {
          "id": 201960002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "3일 차 운동 계획 (완료 시 체크)\n영양 보충 (√)\n충분한 준비운동 ( )\n어깨+팔 ( )\n하체 훈련 ( )\n물 마시기 (√)",
          "next": [
            201960003
          ]
        },
        "201960003": {
          "id": 201960003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "좋은 시작이군",
          "next": [
            201960007
          ]
        },
        "201960004": {
          "id": 201960004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "좋아요, 시작해 볼까요!",
          "next": [
            201960007
          ]
        },
        "201960005": {
          "id": 201960005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "오랜만이에요, 마이데이모스!",
          "next": [
            201960006
          ]
        },
        "201960006": {
          "id": 201960006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "오랜만이다, {NICKNAME}",
          "next": [
            201960007
          ]
        },
        "201960007": {
          "id": 201960007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "요즘 운동할 시간이 별로 없었는데, 이제 일정에 넣어야겠어",
          "next": [
            201960008
          ]
        },
        "201960008": {
          "id": 201960008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "생각해 보니까, 네가 아직 관심이 있다면 상황에 따라 맞춤 훈련을 해도 되겠어",
          "next": [
            201960009
          ]
        },
        "201960009": {
          "id": 201960009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "내가 파악한 네 성향을 바탕으로, 맞춤형 훈련 계획을 업데이트했어",
          "next": [
            201960010
          ]
        },
        "201960010": {
          "id": 201960010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "모두 내가 직접 해 본 것들이라서, 난이도도 적당하고 쉽게 따라 할 수 있을 거야",
          "next": [
            201960011
          ]
        },
        "201960011": {
          "id": 201960011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "준비운동: 키메라 추격하기. 몸을 움직이면서 기분 전환도 되는 운동",
          "next": [
            201960012
          ]
        },
        "201960012": {
          "id": 201960012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "어깨+팔 훈련: 크렘노스 아이들을 찾아가기. 한 손으로 세 명을 드는 것부터 시작해서 다섯 명까지 늘리기. 아이들이 전문가",
          "next": [
            201960013
          ]
        },
        "201960013": {
          "id": 201960013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "하체 훈련: 드로마스 들어올리기. 성질 급한 녀석으로 골라야 더 난이도가 있음",
          "next": [
            201960014,
            201960016,
            201960019
          ]
        },
        "201960014": {
          "id": 201960014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "역시 당신이 최고예요, 크렘노스의 골목대장!",
          "next": [
            201960015
          ]
        },
        "201960015": {
          "id": 201960015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "아이들이 너랑 놀길 기다리고 있어",
          "next": [
            201960021
          ]
        },
        "201960016": {
          "id": 201960016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "제가 잘못 들은 거죠? 뭘… 들어 올리라고요?",
          "next": [
            201960017
          ]
        },
        "201960017": {
          "id": 201960017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "드로마스",
          "next": [
            201960018
          ]
        },
        "201960018": {
          "id": 201960018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "철자를 틀리진 않았을 텐데",
          "next": [
            201960021
          ]
        },
        "201960019": {
          "id": 201960019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "식은 죽 먹기죠, 매일 할게요",
          "next": [
            201960020
          ]
        },
        "201960020": {
          "id": 201960020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "역시 내가 사람을 제대로 봤어",
          "next": [
            201960021
          ]
        },
        "201960021": {
          "id": 201960021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "아직 부족하다면, 추천할 만한 것들이 더 있어",
          "next": [
            201960022
          ]
        },
        "201960022": {
          "id": 201960022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "예를 들면, 나랑 레슬링이나 팔씨름 하기랄까",
          "next": [
            201960023
          ]
        },
        "201960023": {
          "id": 201960023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "기다릴게",
          "next": []
        }
      },
