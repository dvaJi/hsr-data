        },
        "150040103": {
          "id": 150040103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "너희 둘 쪽에 문제가 생겼다고 들었어",
          "next": [
            150040104
          ]
        },
        "150040104": {
          "id": 150040104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "무슨 일이죠?",
          "next": [
            150040105
          ]
        },
        "150040105": {
          "id": 150040105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "우리 둘은 괜찮아. 근데 거리를 둘러보다가 자칭 「스파키」라고 하는 녀석을 만났어",
          "next": [
            150040106
          ]
        },
        "150040106": {
          "id": 150040106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그 녀석이 나랑 {NICKNAME}을(를) 쓰러뜨리고, 열차팀을 환월 게임에서 제외시키겠다고 했어",
          "next": [
            150040107
          ]
        },
        "150040107": {
          "id": 150040107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그러니까 빨리 움직여야 해",
          "next": [
            150040108
          ]
        },
        "150040108": {
          "id": 150040108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "그래서, 결정은 했어?",
          "next": [
            150040109
          ]
        },
        "150040109": {
          "id": 150040109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "나는 생각이 좀 있긴 한데, {NICKNAME}은(는) 어떨지 모르겠네",
          "next": [
            150040110
          ]
        },
        "150040110": {
          "id": 150040110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "환월 게임 참여에 관심 있어요",
          "next": [
            150040111
          ]
        },
        "150040111": {
          "id": 150040111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "제가 이기게 된다면 그 권능으로 뭘 할 수 있을지, 아니면 아하한테 뭘 요구할 수 있을지 계속 생각하고 있었어요",
          "next": [
            150040112
          ]
        },
        "150040112": {
          "id": 150040112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "나중에 시간 될 때 같이 이야기해 봐요",
          "next": [
            150040113
          ]
        },
        "150040113": {
          "id": 150040113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "단항 쪽은 상황이 어때? @단항",
          "next": [
            150040114
          ]
        },
        "150040114": {
          "id": 150040114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "선주 특사와 연락이 닿았는데, 그쪽도 문제가 생겨서 도움이 필요한 모양이에요",
          "next": [
            150040115
          ]
        },
        "150040115": {
          "id": 150040115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "저랑 선데이 씨가 가는 중이에요",
          "next": [
            150040116
          ]
        },
        "150040116": {
          "id": 150040116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "필요하면 연락 주세요",
          "next": [
            150040117
          ]
        },
        "150040117": {
          "id": 150040117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "좋아. 히메코 언니, 우린 이제 뭘 하면 돼?",
          "next": [
            150040118
          ]
        },
        "150040118": {
          "id": 150040118,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "내 모교인 「그래피아 아카데미」로 가줬으면 해",
          "next": [
            150040119
          ]
        },
        "150040119": {
          "id": 150040119,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[그래피아 아카데미의 위치]",
          "next": [
            150040120
          ]
        },
        "150040120": {
          "id": 150040120,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "이 학교에는 돌리라는 선생님이 있어",
          "next": [
            150040121
          ]
        },
        "150040121": {
          "id": 150040121,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "내 친구인데, 「환월 게임」에 필요한 가면을 보관하고 있지",
          "next": [
            150040122
          ]
        },
        "150040122": {
          "id": 150040122,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "일이 더 복잡해지기 전에, 우선 그녀를 찾아가서 가면을 받아",
          "next": [
            150040123
          ]
        },
        "150040123": {
          "id": 150040123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "지금 바로 갈게",
          "next": [
            150040124
          ]
        },
        "150040124": {
          "id": 150040124,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "나랑 웰트도 너희 쪽에 합류할게",
          "next": []
        }
