      "messages": {
        "202270000": {
          "id": 202270000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "요즘 한가로운 휴가를 즐기고 , 먹고 마시느라 바쁜 것 같네",
          "next": [
            202270001
          ]
        },
        "202270001": {
          "id": 202270001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "제대로 쉬는 건 네가 나보다 훨씬 잘하는 것 같아",
          "next": [
            202270002
          ]
        },
        "202270002": {
          "id": 202270002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "오해하지 마. 본좌는 진심으로 칭찬한 거니까",
          "next": [
            202270003
          ]
        },
        "202270003": {
          "id": 202270003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "바쁜 일 끝나면 나도 휴가가 있는데, 편히 쉬는 좋은 방법 있어? 너한테 미리 배워야겠어",
          "next": [
            202270004,
            202270006,
            202270008
          ]
        },
        "202270004": {
          "id": 202270004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "푹 자는 거예요. 머리는 텅 비지만, 꿈속엔 뭐든지 있으니까요",
          "next": [
            202270005
          ]
        },
        "202270005": {
          "id": 202270005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "패 놀이 외에 효 사장님은 또 뭘 하실 건가요?",
          "next": [
            202270011
          ]
        },
        "202270006": {
          "id": 202270006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "밖에 나가 한가롭게 돌아다니고, 돈을 쓰면서 자신을 챙겨요",
          "next": [
            202270007
          ]
        },
        "202270007": {
          "id": 202270007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "패 놀이 외에 효 사장님은 또 뭘 하실 건가요?",
          "next": [
            202270011
          ]
        },
        "202270008": {
          "id": 202270008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "몸을 움직여 보세요——운동을 하거나 여행을 가거나, 아니면",
          "next": [
            202270009
          ]
        },
        "202270009": {
          "id": 202270009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "다른 곳에서 놀이를 하는 거예요",
          "next": [
            202270010
          ]
        },
        "202270010": {
          "id": 202270010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "패 놀이 외에 효 사장님은 또 뭘 하실 건가요?",
          "next": [
            202270011
          ]
        },
        "202270011": {
          "id": 202270011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "본좌한테 패 놀이 외에 다른 스트레스 푸는 법이 없다고 생각해? 날 너무 얕보는군",
          "next": [
            202270012
          ]
        },
        "202270012": {
          "id": 202270012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "휴가 기간에 각지의 옥조 유리 기판과 모순된 결합체 통과 기록을 깨야겠어",
          "next": [
            202270013
          ]
        },
        "202270013": {
          "id": 202270013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "그리고 선주의 오행과 세 점법의 수수께끼를 풀고, 경청 일가의 천간지지도 계산하고",
          "next": [
            202270014,
            202270016,
            202270018
          ]
        },
        "202270014": {
          "id": 202270014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그게 정말 쉬는 건가요?",
          "next": [
            202270015
          ]
        },
        "202270015": {
          "id": 202270015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "사실 할 일이 없을 땐 아무것도 안 해도 돼요",
          "next": [
            202270020
          ]
        },
        "202270016": {
          "id": 202270016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "여전히 승부욕이 강하네요",
          "next": [
            202270017
          ]
        },
        "202270017": {
          "id": 202270017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "좀 더 편하게 있어도 돼요",
          "next": [
            202270020
          ]
        },
        "202270018": {
          "id": 202270018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "경청의 천간지지요? 녀석들은 잘 지내고 있나요?",
          "next": [
            202270019
          ]
        },
        "202270019": {
          "id": 202270019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "당연하지. 매일 잘 지내. 주특기가 「까먹기」니까",
          "next": [
            202270020
          ]
        },
        "202270020": {
          "id": 202270020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "그러고 보니 방금 너무 일이 손에 안 잡혀서 앞으로 5년 동안의 재물운을 점쳐봤어",
          "next": [
            202270021
          ]
        },
        "202270021": {
          "id": 202270021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "그런데 웬걸, 아주 절묘한 이치를 깨달았어",
          "next": [
            202270022
          ]
        },
        "202270022": {
          "id": 202270022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "재물을 주면 재물운이 돌아온다는 말이 있잖아",
          "next": [
            202270023
          ]
        },
        "202270023": {
          "id": 202270023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "마침 길시니까 너한테 먼저 실천해 봐야겠어",
          "next": [
            202270024
          ]
        },
        "202270024": {
          "id": 202270024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "잘 받아~",
          "next": [
            202270025
          ]
        },
