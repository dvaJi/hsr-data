        },
        "150660102": {
          "id": 150660102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "아! 신호 연결됐다! 다들 괜찮아? @전체 말 좀 해봐!",
          "next": [
            150660103
