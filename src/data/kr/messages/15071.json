        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "사장님! 그동안 잘 지냈어?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "아, 미안, 습관적으로 업무용 휴대폰을 사용했네",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "나야, 푸리! 이루리는 내 예명이야",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "사장님, 좋은 소식 하나 알려줄게",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "내 솔로 영화의 제작이 확정됐어. ≪이루리의 우울≫이라는 슈퍼 히어로 대작이야!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "와, 축하해! 꿈을 이뤘구나!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "아직 기뻐하기엔 일러. 시작한 지 얼마 안 됐으니까",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "대단한데!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "겸사겸사 물어보는데, 다시 와서 출근할 거야?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "영화 다 찍을 때까지 기다려야지, 이제 막 크랭크인했잖아",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "아, 울보 유령 선배님이 도와달라고 부르네",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "사장님, 시간 나면 언제든지 촬영장에 놀러 와!",
          "next": []
        }
      },
