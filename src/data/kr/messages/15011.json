      "messages": {
        "150110100": {
          "id": 150110100,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "지금 바빠? 너한테 부탁할 일이 있어",
          "next": [
            150110101
          ]
        },
        "150110101": {
          "id": 150110101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "잠깐만, 거기서 움직이지말고 딱 기다려, 금방 갈게",
          "next": [
            150110102,
            150110104
          ]
        },
        "150110102": {
          "id": 150110102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "무슨 일인지 말도 안 했는데! 행동력이 이렇게 강하다고?",
          "next": [
            150110103
          ]
        },
        "150110103": {
          "id": 150110103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "이렇게 잔혹한 업계에서 1위를 차지한 건 바로 「행동력」 덕분이라고, 헤헤",
          "next": [
            150110106
          ]
        },
        "150110104": {
          "id": 150110104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "바로 오프라인에서 만나자고? 왜? 나한테 복수하려고?",
          "next": [
            150110105
          ]
        },
        "150110105": {
          "id": 150110105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "그럴 리가! 당연히 도와주려는 거지",
          "next": [
            150110106
          ]
        },
        "150110106": {
          "id": 150110106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "내 팬들이 다 봤대, 네가 이상방어부에서 담당하는 범죄 현장을 기웃거리면서 또 쓸데없이 참견한다고",
          "next": [
            150110107
          ]
        },
        "150110107": {
          "id": 150110107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "「밀레니엄 킬러」 사건이지? 나도 그 녀석한테 엄청 관심 있거든",
          "next": [
            150110108
          ]
        },
        "150110108": {
          "id": 150110108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "자세한 건 만나서 얘기하자. 곧 도착해",
          "next": [
            150110109
          ]
        },
        "150110109": {
          "id": 150110109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그래, 기다리고 있을게",
          "next": []
        }
      },
