  "sections": [
    {
      "id": 2022800,
      "startingMessageId": [
        202280000
      ],
      "messages": {
        "202280000": {
          "id": 202280000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "{NICKNAME}, 안녕하세요. 접니다, 「내레이터」",
          "next": [
            202280001
          ]
        },
        "202280001": {
          "id": 202280001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "평소에 좋아하는 음식이 뭔지 궁금합니다. 추천 좀 해주실 수 있나요?",
          "next": [
            202280002
          ]
        },
        "202280002": {
          "id": 202280002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "가성비 좋은 영양식이면 좋겠네요",
          "next": [
            202280003,
            202280006,
            202280009
          ]
        },
        "202280003": {
          "id": 202280003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "「웰빙 쌀 볶음」은 연기가 안 나고, 기름과 첨가물이 들어가지 않아. 영양가는 있지만 좀 싱거워",
          "next": [
            202280004
          ]
        },
        "202280004": {
          "id": 202280004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "벨로보그 소시지나 선주의 꼬치 같은 이국적인 간식도 괜찮아. 우주 택배로 다음날 받아볼 수 있어~",
          "next": [
            202280005
          ]
        },
        "202280005": {
          "id": 202280005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "근데 무료 배송이 아니라더군요. 가격을 따져보고 결정해야겠습니다. 추천 감사해요",
          "next": [
            202280011
          ]
        },
        "202280006": {
          "id": 202280006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "추천하기 어려운데… 내가 좋아하는 음식은 영양가가 별로 없는 것 같아서",
          "next": [
            202280007
          ]
        },
        "202280007": {
          "id": 202280007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "꼬치구이, 스튜, 기쁨차, 윙 버거, 케이크……",
          "next": [
            202280008
          ]
        },
        "202280008": {
          "id": 202280008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "불사의 명탐정 식단에 비하면 균형 잡힌 것 같은데요",
          "next": [
            202280011
          ]
        },
        "202280009": {
          "id": 202280009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "난 네가 바나나만 좋아하는 줄 알았어",
          "next": [
            202280010
          ]
        },
        "202280010": {
          "id": 202280010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "제가 먹을 게 아니라 애쉬베일 씨가 드실 거예요",
          "next": [
            202280011
          ]
        },
        "202280011": {
          "id": 202280011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "정말 골치 아프네요. 요즘 애쉬베일 씨는 끼니마다 저와 함께 바나나를 드십니다. 편해서거나 돈을 아끼려고 그러시는 거겠죠",
          "next": [
            202280012
          ]
        },
        "202280012": {
          "id": 202280012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "하지만 인간에게 필요한 복합 영양소가 부족해지면 두뇌 회전이 더 느려질 뿐이에요",
          "next": [
            202280013
          ]
        },
        "202280013": {
          "id": 202280013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "휴대폰을 몇 번이나 깜빡하고 안 가져오는 것도 영양 부족의 임상 증상 중 하나죠",
          "next": [
            202280014
          ]
        },
        "202280014": {
          "id": 202280014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "그러니 애쉬베일 씨의 식습관을 바로잡아드려야겠어요",
          "next": [
            202280015,
            202280016
          ]
        },
        "202280015": {
          "id": 202280015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어떻게 바로잡아? 나도 건강 관리를 하고 싶어!",
          "next": [
            202280018
          ]
        },
        "202280016": {
          "id": 202280016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "완벽한 보모형 조수잖아!",
          "next": [
            202280017
          ]
        },
        "202280017": {
          "id": 202280017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "애쉬베일 씨의 산만한 성격을 생각하면 제가 처리하는 게 당연한 일이죠",
          "next": [
            202280018
          ]
        },
        "202280018": {
          "id": 202280018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "처음 며칠 동안은 바나나를 죽처럼 으깬 후 몰래 다른 과일들을 섞어 넣었습니다",
          "next": [
            202280019
          ]
        },
        "202280019": {
          "id": 202280019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "효과는 좋았죠. 식욕도 정상이고, 눈에 띄는 거부 반응도 없고, 스트레스 반응도 없었어요",
          "next": [
            202280020
          ]
        },
        "202280020": {
          "id": 202280020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "이제부터 전 새로운 재료의 비율을 점차 늘리고, 인간이 좋아하는 따뜻한 음식을 섞어 단계적으로 혼합할 계획입니다",
          "next": [
            202280021
          ]
        },
        "202280021": {
          "id": 202280021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "위장을 보호하면서 미각으로도 다른 인간 음식에 대한 흥미를 다시 불러일으키는 거죠",
          "next": [
            202280022
          ]
        },
        "202280022": {
          "id": 202280022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "치료 주기는 최소 7일입니다. 다시 말해——7일 식단 전환법이죠! 아주 과학적이랍니다!",
          "next": [
            202280023,
            202280024
          ]
        },
        "202280023": {
          "id": 202280023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "7일 식단 전환법이라, 한 수 배웠네!",
          "next": [
            202280026
          ]
        },
        "202280024": {
          "id": 202280024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "네가 오히려 애쉬베일 씨의 주인 같아",
          "next": [
            202280025
          ]
        },
        "202280025": {
          "id": 202280025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "우리가 탐정과 조수 사이라는 건 변하지 않아요",
          "next": [
            202280026
          ]
        },
        "202280026": {
          "id": 202280026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "어디 보자. 어제는 사과 두 개, 달걀 한 개, 찹쌀 한 그릇, 바나나 한 스푼, 소금 세 통을 넣었네요",
          "next": [
            202280027
          ]
        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "오, 애쉬베일 씨가 곧 돌아올 테니 오늘의 「애플바나나 소금타르트」를 준비하러 가야겠군요",
          "next": [
            202280028
          ]
        },
        "202280028": {
          "id": 202280028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "다음에 봬요",
          "next": []
        }
      },
      "participatingContactsIds": [
        1504,
        8001
      ]
    }
  ]
}