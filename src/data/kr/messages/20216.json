        "202160002": {
          "id": 202160002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "돌아서기 전에 마지막으로 별을 한번 바라봤어, 봐봐~",
          "next": [
            202160003
