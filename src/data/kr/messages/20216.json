          ]
        },
        "202160004": {
          "id": 202160004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "별하늘을 볼 때마다, 내가 은하에서 뭘 할 수 있을지 상상하게 돼",
          "next": [
            202160005
          ]
        },
        "202160005": {
          "id": 202160005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "헷, 「미의 기사」 키레네, 멋진 이름이지 않아?",
          "next": [
            202160006
          ]
        },
        "202160006": {
          "id": 202160006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "생각의 폭을 더 넓혀보면, 나도 「스타하트 헌터」가 되면 아주 잘 어울리지 않을까? 아니면… 무명객?",
          "next": [
            202160007
          ]
        },
        "202160007": {
          "id": 202160007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "하지만 이건 다 너무 사치스러운 소원이야",
          "next": [
            202160008
          ]
        },
        "202160008": {
          "id": 202160008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "난 아무도 가져본 적 없는 별을 갖게 됐으니까, 그렇지?♪",
          "next": [
            202160009
          ]
        },
        "202160009": {
          "id": 202160009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "별을 바라보며 그리워하면 눈에 빛이 담길 거야",
          "next": [
            202160010
          ]
        },
        "202160010": {
          "id": 202160010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "아마도 이게 내 가장 큰 소원이겠지——",
          "next": [
            202160011
          ]
        },
        "202160011": {
          "id": 202160011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, 앞으로 펼쳐질 기나긴 여정에서 영원히 빛나야 해. 알겠지?",
          "next": [
            202160012
