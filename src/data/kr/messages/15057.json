  ],
  "sections": [
    {
      "id": 1505701,
      "startingMessageId": [
        150570101
      ],
      "messages": {
        "150570101": {
          "id": 150570101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "어이, {NICKNAME} {F#자매님}{M#형제님}!",
          "next": [
            150570102
          ]
        },
        "150570102": {
          "id": 150570102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "안 그래도 찾으려던 참이었는데, 문자 메시지가 왔네요",
          "next": [
            150570103
          ]
        },
        "150570103": {
          "id": 150570103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "우리 둘은 늘 척하면 척이잖아",
          "next": [
            150570104
          ]
        },
        "150570104": {
          "id": 150570104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "좋은 소식 하나 알려줄게",
          "next": [
            150570105
          ]
        },
        "150570105": {
          "id": 150570105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "우리 콜라보 그림책이 제법 잘 팔리고 있어. 이 돈을 송금하고 나면, 아이들이 꿈을 실현하는 데 한 발짝 더 다가가게 될 거야",
          "next": [
            150570106,
            150570107
          ]
        },
        "150570106": {
          "id": 150570106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "정말 잘됐네요. 모든 일이 순조롭길 바랄게요",
          "next": [
            150570108
          ]
        },
        "150570107": {
          "id": 150570107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이 일로 이리저리 뛰어다니느라 정말 고생 많으셨어요",
          "next": [
            150570108
          ]
        },
        "150570108": {
          "id": 150570108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "근데 좀 궁금하네요. 대체 뭘 위해 이런 일들을 하시는 건가요?",
          "next": [
            150570109
          ]
        },
        "150570109": {
          "id": 150570109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "당신이 어린아이를 좋아하는 건 알지만, 상상 속의 우주선을 위해 그렇게까지 무리할 줄은 몰랐어요",
          "next": [
            150570110
          ]
        },
        "150570110": {
          "id": 150570110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "하하, 난 슉슉이가 더 이해하기 힘든 것 같아",
          "next": [
            150570111
          ]
        },
        "150570111": {
          "id": 150570111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "그 녀석을 만들어낸 건 나지만, 녀석이 대체 왜 나랑 이런 귀찮은 일을 같이 해주는 건지 모르겠단 말이지",
          "next": [
            150570112
          ]
        },
        "150570112": {
          "id": 150570112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "슉슉을 구성하는 원력은 머나먼 행성에서 왔어. 하지만 녀석은 그 행성에 가본 적 없지. 환조종이 그렇게 먼 곳에 도달하는 건 절대 불가능하거든",
          "next": [
            150570113
          ]
        },
        "150570113": {
          "id": 150570113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "「성간 비행호」라는 게 수십 년 뒤에 진짜로 완성된다고 쳐도, 그 녀석이 그 우주선을 몰고 출항할 수는 없을 거야",
          "next": [
            150570114
          ]
        },
        "150570114": {
          "id": 150570114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "그 점은 그 녀석 자신이 제일 잘 알고 있지",
          "next": [
            150570115
          ]
        },
        "150570115": {
          "id": 150570115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "하지만 녀석은 여전히 자기를 「함장」이라 부르면서, 영원히 닿을 수 없는 그 미래를 위해 애쓰고 있어",
          "next": [
            150570116
          ]
        },
        "150570116": {
          "id": 150570116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "오늘 아이들이 최근에 공유한 그림을 보고 나서야, 이 삼포도 슉슉이를 완전히 이해하게 됐어",
          "next": [
            150570117
          ]
        },
        "150570117": {
          "id": 150570117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "아이들이 꿈꾸는 미래는 정말 눈부시고 감동적이야",
          "next": [
            150570118
          ]
        },
        "150570118": {
          "id": 150570118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "슉슉 함장도 분명 이게 정해진 미래가 되길 바랄 거야",
          "next": [
            150570119,
            150570120
          ]
        },
        "150570119": {
          "id": 150570119,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이렇게 할 가치가 있다는 걸 저도 완전히 이해했어요",
          "next": [
            150570121
          ]
        },
        "150570120": {
          "id": 150570120,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "아직도 이해가 안 돼요",
          "next": [
            150570121
          ]
        },
        "150570121": {
          "id": 150570121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "은하에서 원력을 구체화할 수 있는 곳은 몇 군데 안 되지만, 사실 다른 곳에서도 원력은 엄청 대단한 거라고",
          "next": [
            150570122
          ]
        },
        "150570122": {
          "id": 150570122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "「소원」은 인류가 창조할 수 있는 가장 위대한 에너지야. 핵에너지보다 대단하고, 허수 에너지보다도 대단하지",
          "next": [
            150570123
          ]
        },
        "150570123": {
          "id": 150570123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "그건 운명에 얽매여 심연에 갇힌 작은 불티들을 하늘로 날아오르는 화려한 불꽃으로 탈바꿈시켜 주고, 방황하는 아이가 머나먼 별바다를 바라보며 언젠가 자신도 전례 없이 위대한 미래에 도달할 수 있다고 믿게 해줘",
          "next": [
            150570124
          ]
        },
        "150570124": {
          "id": 150570124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "어쩌면 아이들이 망망한 별바다에서 본 한순간의 섬광은, 히메코 씨와 무명객들이 다시 여정을 시작하며 남긴 빛일지도 몰라",
          "next": [
            150570125,
            150570127
          ]
        },
        "150570125": {
          "id": 150570125,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "말씀 참 잘하시네요. 아주 문학적이에요",
          "next": [
            150570126
          ]
        },
        "150570126": {
          "id": 150570126,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "아이고, {F#자매님}{M#형제님}, 이러면 내가 다 쑥스럽잖아",
          "next": [
            150570129
          ]
        },
        "150570127": {
          "id": 150570127,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "왜 갑자기 감상에 젖었나요?",
          "next": [
            150570128
          ]
        },
        "150570128": {
          "id": 150570128,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "에구, 나이가 들어서 그렇지",
          "next": [
            150570129
          ]
        },
        "150570129": {
          "id": 150570129,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "자, 얘기는 여기까지 하고, 이 삼포는 마저 일하러 가볼게",
          "next": []
        }
      },
      "participatingContactsIds": [
        1108,
        8001
      ]
    }
  ]
}