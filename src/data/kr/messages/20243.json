  "sections": [
    {
      "id": 2024300,
      "startingMessageId": [
        202430000
      ],
      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME} 씨, 방금 해변에서 소리 샘플을 좀 더 수집했어요",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "예를 들어 코코넛이 바닥에 굴러떨어지는 소리, 소다수 기포가 보글거리는 소리, 철판 위에서 오징어가 지글지글 익어가는 소리……",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 입력 중입니다",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그 말을 들으니 배고파지네요, 오징어 꼬치 두 개 먹고 싶어요",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "사실 저도요……",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "정말 맛있는 음악… 아니, 이 오징어 정말 듣기 좋네요",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "하하, 영감이 떠오르지 않아 머릿속이 텅 비어 있을 때에 비하면 맛의 자극을 느끼는 편이 확실히 정신이 번쩍 들죠",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "사실 좀 더 바닷가 분위기가 나는 소리도 있어요, 들어보세요",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "이건 파도가 밀려나는 소리예요. 쏴아아—— 보글보글보글보글——",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다(거품소리 감지됨)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "바닷바람이 녹슨 닻을 스쳐 지나가는 소리는, 휘——웅——휘——웅——",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다(저음 감지됨)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "갈매기가 날아가는 소리는, 푸드득——훅훅——끼룩끼룩——아!",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다(새소리 감지됨)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "죄송해요, 저 「아」 소리는 저예요…. 방금 손에 들고 있던 간식을 갈매기에게 뺏겼거든요…",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "샘플 수량은 이제 충분한데, 왠지… 「영혼을 강타하는」 소리가 조금 부족한 것 같아요",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME} 씨, 혹시 순식간에 기운을 차리게 하는 소리에 대한 영감 없을까요?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "열차가 워프할 때의 굉음을 들어보세요",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 「워프 굉음.mp3」 첨부 파일을 수락했습니다",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "「개척」을 대표하는 소리가 확실히 영혼을 강타하네요",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "기상 알람 소리를 들어보세요",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 「기상 알람.mp3」 첨부 파일을 수락했습니다",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "심정지도… 일종의 영혼 강타겠죠",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "하지만 청중들의 심신 건강을 위해 한 옥타브 낮출게요",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "제 영혼의 노랫소리를 들어보세요",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 「욕실 열창.mp3」 첨부 파일을 수락했습니다",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "이건 당신의 노랫소리인가요? 확실히… 영혼을 강타하네요",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "음…. 간단하게 합성해 볼 수 있을 것 같아요!",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wing it now! Cast aside the unchanging score. Swing now! We aren't bolted parts anymore……",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다(원곡 감지됨)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "≪오직 바람을 쫓아≫ 리믹스 버전이에요. 「영혼을 강타하는」 샘플에 바닷바람의 반주가 더해지니까 여름 페스티벌의 분위기가 한층 더 살아나지 않나요?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "갑자기 영감이 떠올랐어요. 녹음실에 좀 다녀올게요",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "기발한 아이디어 고마워요!",
          "next": [
            202430033
          ]
        },
        "202430033": {
          "id": 202430033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
