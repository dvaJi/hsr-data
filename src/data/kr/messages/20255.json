      "messages": {
        "202550000": {
          "id": 202550000,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 241,
          "next": [
            202550001
          ]
        },
        "202550001": {
          "id": 202550001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "나 또 왔어!",
          "next": [
            202550002
          ]
        },
        "202550002": {
          "id": 202550002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "이 옛날 번호를 되찾느라 고생을 좀 하긴 했지만 건진 게 많아",
          "next": [
            202550003
          ]
        },
        "202550003": {
          "id": 202550003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "헤헤",
          "next": [
            202550004,
            202550005,
            202550006
          ]
        },
        "202550004": {
          "id": 202550004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "아니, 어떻게 별 5개가 된 거예요?",
          "next": [
            202550007
          ]
        },
        "202550005": {
          "id": 202550005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "한마음으로 뭉친 빚쟁이들은 따돌렸나요?",
          "next": [
            202550009
          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "헤헤…. 뭐 좀 건졌어요? 이 번호에 소액결제 한도가 좀 남아 있어서 빚을 갚을 수 있게 됐나요?",
          "next": [
            202550011
          ]
        },
        "202550007": {
          "id": 202550007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "많으면 좋지 뭘 그래, 무려 별이 다섯 개!",
          "next": [
            202550008
          ]
        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "하긴, 빚쟁이들이 가끔 남기는 악평도 좀 상쇄해야죠",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "아니, 하지만 그들의 기대를 저버리지 않도록 열심히 할게",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "그거 기대 맞아요?",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "예리하네, 대리인",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "이 메모장의 가치 좀 봐. 지난 10년간의 성과에 맞먹는 수준이야",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "운명의 길을 걷는 자가 자신의 에이언즈를 신랄하게 평가한 녹음, 무심코 저장한 가십 영상까지, 모두 독점 소재잖아?",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "옛날에 어쩌다 이 번호를 잃어버렸더라……",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "말만 하지 말고! 공유해 주세요",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "또 당신만의 야사를 그리려고요?",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "작가님, 배고파요, 밥 주세요",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "서두르지 마~ 먼저 하나 공유해 줄게",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "그렇게 막 나가는 얘기는 아니야",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "내 말은, 스케일이 그렇게 작진 않다는 거야! 야사는 당연히 남의 이야기가 재밌잖아, 예를 들면…",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "소재가 정말 많네. ≪약향이 감도는 바람≫에 새로 써먹을 소재가 생긴 것 같아……",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "일단 아무거나 하나 공유해 줄게",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "수백 앰버기원 전, 한 허구 역사학자가 마지막 글을 남겼어——",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「타이츠론스는 꿈틀거리며 하루에 천 리를 이동한다. 오직 이름 없는 행성 하나를 위해서…」",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「그리고 그때, 에나와 시페도 행성 근처의 은밀한 구석에 매복해 있었다…」",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「그들은 우로보로스와 우연히 마주쳤다. 외나무다리에서 만난 신들은 팽팽하게 맞서며 불꽃을 튀겼지만, 이 모든 건 바로 단 한 사람…」",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「바로 그곳에 있는 아하 때문이었다」",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "본인한테 너무 취하지 마시죠!",
          "next": [
            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이것도 결국 본인 야사잖아요! 왜 또 이 레퍼토리인데요!",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "솔직히 좀 질리는데, 다른 신선한 거 없어요?",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "아직 안 끝났어… 역사학자들이 미처 알아내지 못한 진실: 「신들이 이름 없는 행성을 탐내는 이유는…」",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「아하가 예전에 연습 삼아 만든 각본, 화집, 2차 창작물이 모두 그곳에 숨겨져 있기 때문이다」",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「그는 그곳에 눌러앉고 싶어 한다. 그는 독차지하고 싶어 한다. 그, 그리고 그는, 손에 넣고자 한다…」",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "헤헤, 사실 정말 그리긴 했거든",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "메모장에 미리 써둔 게 몇 편 더 있으니까 바로 보내줄게. 한번 감상해 봐",
          "next": [
            202550036
          ]
        },
        "202550036": {
          "id": 202550036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "더는 애태우지 않을게. 이러다가 데이터를 다 쓰면 안 되니까",
          "next": [
            202550037
          ]
        },
        "202550037": {
          "id": 202550037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 입력 중입니다",
          "next": [
            202550038
          ]
        },
        "202550038": {
          "id": 202550038,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "시스템에 의해 채팅이 금지되었습니다",
          "next": [
            202550039,
            202550040
          ]
        },
        "202550039": {
          "id": 202550039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "내용이 너무 충격적인가? 아니면 진짜 데이터를 다 썼나??",
          "next": [
            202550041
          ]
        },
        "202550040": {
          "id": 202550040,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "내용이 너무 충격적인가? 아니면 진짜 데이터를 다 썼나??",
          "next": [
            202550041
          ]
        },
        "202550041": {
          "id": 202550041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "메시지 전송에 실패했습니다",
          "next": [
            202550042
          ]
        },
        "202550042": {
          "id": 202550042,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "해당 사용자의 계정 오류 및 사기 행위가 감지되어 사용이 중단됐습니다",
          "next": []
        }
      },
