  "sections": [
    {
      "id": 2020900,
      "startingMessageId": [
        202090000
      ],
      "messages": {
        "202090000": {
          "id": 202090000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "회색 물고기, 이제 출발하려고? 너희에게 줄 배웅 선물로 꿀 음료를 준비했어. 스페셜 블렌드라서 네 의견도 좀 들어보고 싶어",
          "next": [
            202090001
          ]
        },
        "202090001": {
          "id": 202090001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090002,
            202090003,
            202090004
          ]
        },
        "202090002": {
          "id": 202090002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "신경 써 주셔서 감사해요!",
          "next": [
            202090007
          ]
        },
        "202090003": {
          "id": 202090003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "신나게 마실게요!",
          "next": [
            202090007
          ]
        },
        "202090004": {
          "id": 202090004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "제가 마셔도 돼요?",
          "next": [
            202090005
          ]
        },
        "202090005": {
          "id": 202090005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "이전 경험을 바탕으로, 인간의 입맛에 맞게 농도를 조금 낮췄어",
          "next": [
            202090006
          ]
        },
        "202090006": {
          "id": 202090006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090007
          ]
        },
        "202090007": {
          "id": 202090007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "이건 협곡의 꿀을 베이스로 하고, 갓 짜낸 문 후르츠를 더했어. 새콤달콤해서 분홍빛 해파리가 좋아할 거야",
          "next": [
            202090008
          ]
        },
        "202090008": {
          "id": 202090008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090009
          ]
        },
        "202090009": {
          "id": 202090009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "푸른 용 물고기를 보면 심해에 남은 얼음이 떠올라——여기에 민트와 생강 맛을 가미한 꿀 음료를 더하면, 그가 생각하는 데 도움이 될 거야",
          "next": [
            202090010
          ]
        },
        "202090010": {
          "id": 202090010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090011
          ]
        },
        "202090011": {
          "id": 202090011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "몇 병은 받는 사람이 표시되어 있지 않지만, 누구에게 더 어울릴지 네가 잘 알고 있을 거야",
          "next": [
            202090012
          ]
        },
        "202090012": {
          "id": 202090012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090013
          ]
        },
        "202090013": {
          "id": 202090013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "한 병은 목으로 넘기면 뜨거운 태양처럼 따뜻해져. 그런데 밤에만 나타나는 붉은 관 해삼으로 만들어서 그런지 마시고 나면 잠들기 더 아쉬워지지",
          "next": [
            202090014
          ]
        },
        "202090014": {
          "id": 202090014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090015
          ]
        },
        "202090015": {
          "id": 202090015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "갈색 꿀 음료는 해저산의 영양분인 미네랄이 섞여서, 오래 보관해도 원래의 맛이 그대로 유지돼",
          "next": [
            202090016
          ]
        },
        "202090016": {
          "id": 202090016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090017
          ]
        },
        "202090017": {
          "id": 202090017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "마지막 병에는 은빛 물고기 떼가 서로 지느러미를 휘저으며 만들어낸 즙이 들어있어. 시원하고 맛이 조화로우며, 특히 여운이 놀랍도록 좋아",
          "next": [
            202090018
          ]
        },
        "202090018": {
          "id": 202090018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090019,
            202090020
          ]
        },
        "202090019": {
          "id": 202090019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그럼 제 거는요?",
          "next": [
            202090023
          ]
        },
        "202090020": {
          "id": 202090020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "레시피가 정말 특이하네요. 히실렌스 씨는 분명 히메코 씨랑 얘기가 잘 통할 거예요",
          "next": [
            202090021
          ]
        },
        "202090021": {
          "id": 202090021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "그렇다면 다행이야. 마음에 들어 하면 좋겠다",
          "next": [
            202090022
          ]
        },
        "202090022": {
          "id": 202090022,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090023
          ]
        },
        "202090023": {
          "id": 202090023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "회색 물고기, 마지막 병에는 푸른빛 별 조각과 순금박, 그리고 분홍빛 달콤한 술이 들어 있어——",
          "next": [
            202090024
          ]
        },
        "202090024": {
          "id": 202090024,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090025
          ]
        },
        "202090025": {
          "id": 202090025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "내가 「앰포리어스의 기억」이라고 이름을 지었지. 유리잔에 따를 때마다 수많은 별과 같은 미광이 일렁일 거야. 한번 마셔 봐",
          "next": [
            202090026
          ]
        },
        "202090026": {
          "id": 202090026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
          "next": [
            202090027
          ]
        },
        "202090027": {
          "id": 202090027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "우리의 기억이 잔 속의 꿀 음료처럼 영원히, 영원히 빛나기를. 그 달콤함이 오래도록 마르지 않기를",
          "next": [
            202090028
          ]
        },
        "202090028": {
          "id": 202090028,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "음성 메시지가 변환되었습니다",
