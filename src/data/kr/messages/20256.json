        "202560019": {
          "id": 202560019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "만능 일꾼은 역시 나랑 아주 취향이 잘 맞는다니까~",
          "next": [
            202560020
          ]
        },
        "202560020": {
          "id": 202560020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "「너구리 밥 먹여주기」? 내 의뢰도 맡았었네!",
