        "202030010": {
          "id": 202030010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "앗, 작은 새가 날아가 버렸네요. 사진을 찍을 수 있었는데!",
          "next": [
            202030011
