      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "하이, 주인공",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "이 예약 문자 메시지를 받았다는 건, 내 계획에 분명 또또또 차질이 생겼다는 뜻이겠군",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "물론, 네가 이미 스텔라론에 의해 하늘로 날아갔고, 현재 이 메시지를 보고 있는 게 미래의 나일 가능성도 배제할 순 없지",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "하지만 네 휴대폰이 그렇게까지 튼튼할 것 같진 않네",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "아삿 프라마드? 또 너야?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "네 계획은 수포로 돌아갔어. 우리가 널 쓰러뜨렸다고!",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[연락하신 번호는 없는 번호입니다. 메시지 전송에 실패했습니다]",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "솔직히 말해서, 이 스토리 전개는 딱히 거부감이 들지 않아",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "오히려 난 너희의 승리를 기대하고 있어",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "이게 내가 틀렸다는 걸 증명할지도 모르지",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "너희가 이 게임을 클리어할 수 있다는 전제하에 말이야",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "누가 이기든, 그분은 깨어나서 우릴 한입에 삼켜버릴 거야",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "메시지를 못 받겠지만, 그래도… 왜 이런 짓을 한 거야?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "내가 뭘 묻고 싶은지 분명 알고 있겠지",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[연락하신 번호는 없는 번호입니다. 메시지 전송에 실패했습니다]",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "이런… 왜 이런 짓을 했을까?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "아하가 배후에 숨어 세계의 부패를 방관하고 있으니, 내가 그를 대신해 우주를 향해 도전장을 내밀 수밖에",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "그리고 이제, 새로운 도전의 이름은, 부활한 「탐식」을 쓰러트리는 거다",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "영웅이 파멸 속에서 탄생해 도전을 겪고 진정한 환락을 세상에 되돌려줄 것인가",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "아니면 야수가 복수를 완성해 환락이 광기로 전락하기 전 존엄한 멸망을 맞이하게 할 것인가",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "주인공, 이 농담에 더 나은 결말을 써줄 수 있겠나?",
          "next": []
        }
      },
      "participatingContactsIds": [
        232,
