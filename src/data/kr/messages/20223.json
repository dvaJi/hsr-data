      "messages": {
        "202230000": {
          "id": 202230000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "첨부파일 ≪스파키 방송 비즈니스 협력 계약.pdf≫을 전송했습니다",
          "next": [
            202230001
          ]
        },
        "202230001": {
          "id": 202230001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "어떤 협력 타입이 더 맞을 거 같아? 내가 자세히 설명해 줄게",
          "next": [
            202230002
          ]
        },
        "202230002": {
          "id": 202230002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "우리가 제공하는 자원은 업계 정상급이야~",
          "next": [
            202230003
          ]
        },
        "202230003": {
          "id": 202230003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "바빠? 내가 밀크티 시켜줄까? 뭐 마시고 싶어?",
          "next": [
            202230004,
            202230005,
            202230006
          ]
        },
        "202230004": {
          "id": 202230004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "무슨 협력? 난 비싼 몸이야",
          "next": [
            202230007
          ]
        },
        "202230005": {
          "id": 202230005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "우리 사장인 폼폼한테 얘기해",
          "next": [
            202230007
          ]
        },
        "202230006": {
          "id": 202230006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "사장 나오라고 해. 난 VVVIP 고객이야",
          "next": [
            202230007
          ]
        },
        "202230007": {
          "id": 202230007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "내가 할게~ 회색머리는 내가 직접 응대하겠다고 했거든",
          "next": [
            202230008
          ]
        },
        "202230008": {
          "id": 202230008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "본론을 말하자면, 나한테 좋은 아이디어가 있어",
          "next": [
            202230009
          ]
        },
        "202230009": {
          "id": 202230009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "넌 인맥이 넓으니까, 친구들을 불러서 우리랑 힘을 합치는 게 어때? 올스타 라인업 방송을 하는 거지!",
          "next": [
            202230010
          ]
        },
        "202230010": {
          "id": 202230010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "프로그램 이름은——≪파키와 그녀의 친구들≫",
          "next": [
            202230011,
            202230013
          ]
        },
        "202230011": {
          "id": 202230011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "내 인맥, 네 인맥? 내 친구, 네 친구?",
          "next": [
            202230012
          ]
        },
        "202230012": {
          "id": 202230012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "너의 친구가 곧 나의 친구이자 모두의 친구지~",
          "next": [
            202230015
          ]
        },
        "202230013": {
          "id": 202230013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "너랑 협력하면 나한테 뭐가 좋은데?",
          "next": [
            202230014
          ]
        },
        "202230014": {
          "id": 202230014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "명명권을 공유하는 거야. 풀네임은 ≪파키와 회색머리와 그들의 친구들≫",
          "next": [
            202230015
          ]
        },
        "202230015": {
          "id": 202230015,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 215,
          "next": [
            202230016
          ]
        },
        "202230016": {
          "id": 202230016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "다른 건 일단 제쳐두고, 게스트 선정부터 해보자~",
          "next": [
            202230017
          ]
        },
        "202230017": {
          "id": 202230017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "스파클 가이드에게 어떤 인맥이 있는지 알려줘~",
          "next": [
            202230018,
            202230022,
            202230026
          ]
        },
        "202230018": {
          "id": 202230018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "이상 낙원에도 내 인맥이 있어. 다들 거물급이야",
          "next": [
            202230019
          ]
        },
        "202230019": {
          "id": 202230019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "페나코니 전 결정권자, 그리고 선주 장군과도 대화할 수 있지",
          "next": [
            202230020
          ]
        },
        "202230020": {
          "id": 202230020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "닭 날개 소년도 네티즌이 잘 아니까 고려해 볼 수 있어~",
          "next": [
            202230021
          ]
        },
        "202230021": {
          "id": 202230021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "하지만 스파클 가이드는 「괴물 신인 조합——효앤키!」의 홍보 헤드라인을 더 좋아해. 그래! 효광 장군은 너한테 맡길게",
          "next": [
            202230031
          ]
        },
        "202230022": {
          "id": 202230022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "게임계의 블랙홀을 추천할게. 출연하면 효과가 좋을 거야",
          "next": [
            202230023
          ]
        },
        "202230023": {
          "id": 202230023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "공허의 에이언즈IX",
          "next": [
            202230024
          ]
        },
        "202230024": {
          "id": 202230024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "블랙홀은 맞는데… 그는 표정 관리 서투른 걸로도 유명해",
          "next": [
            202230025
          ]
        },
        "202230025": {
          "id": 202230025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "정말 부를 수 있다면 스파클 가이드도 고려해 볼게",
          "next": [
            202230031
          ]
        },
        "202230026": {
          "id": 202230026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "난 인맥이 없어. 네가 직접 골드 스파키, 우드 스파키, 아쿠아 스파키, 테라 스파키를 다 불러오지 그래?",
          "next": [
            202230027
          ]
        },
        "202230027": {
          "id": 202230027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "회색머리, 너…",
          "next": [
            202230028
          ]
        },
        "202230028": {
          "id": 202230028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "내 오랜 팬이구나! 내가 그녀들을 없애지 않은 건 어떻게 안 거야!",
          "next": [
            202230029
          ]
        },
        "202230029": {
          "id": 202230029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "그냥 헛소리한 건데",
          "next": [
            202230030
          ]
        },
        "202230030": {
          "id": 202230030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "헤헤, 그녀들을 전부 한자리에 모으는 것도 스파클 가이드가 고민해 봐야겠어~",
          "next": [
            202230031
          ]
        },
        "202230031": {
          "id": 202230031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "그럼 우선 조수한테 초청 초안을 준비하라고 하자!",
          "next": [
            202230032
          ]
        },
        "202230032": {
          "id": 202230032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "참, 협력 계약에 너도 나와야 한다고 적혀있어~",
          "next": [
            202230033
          ]
        },
        "202230033": {
          "id": 202230033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "어떤 특기를 보여줄지 얼른 생각해 봐~",
          "next": []
        }
      },
