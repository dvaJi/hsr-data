        "202180008": {
          "id": 202180008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "히아킨은 우리의 이모티콘 제작 마스터야. 은하열차의 의인화, 야구 방망이 키메라, 그리고 열심히 글 쓰는 너도 있지",
          "next": [
            202180009
          ]
        },
        "202180009": {
          "id": 202180009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
