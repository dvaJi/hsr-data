      ],
      "messages": {
        "202460000": {
          "id": 202460000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "요즘 아스트로폴리스의 햇볕이 유난히 따갑네",
          "next": [
            202460001
          ]
        },
        "202460001": {
          "id": 202460001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "방금 생각난 건데, 나한테 아주 확실한 피서법이 있어. 너한테 공유해 줄게",
          "next": [
            202460002,
            202460003
          ]
        },
        "202460002": {
          "id": 202460002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어벤츄린 씨의 피서법은 신용 포인트가 많이 들지 않나요?",
          "next": [
            202460004
          ]
        },
        "202460003": {
          "id": 202460003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "옷을 좀 얇게 입어볼까요? 일단, 전 수영복이 없어요",
          "next": [
            202460005
          ]
        },
        "202460004": {
          "id": 202460004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "정반대야, 오히려 본연의 모습으로 돌아가는 게 핵심이지",
          "next": [
            202460006
          ]
        },
        "202460005": {
          "id": 202460005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "음, 다음에 내 거랑 똑같은 맞춤형 휴양지 세트를 한 벌 선물할게",
          "next": [
            202460006
          ]
        },
        "202460006": {
          "id": 202460006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "사실 츠가냐에는 이런 전통이 있거든. 충분히 큰 바위나 그늘진 모래 언덕을 찾아 그늘에 반듯이 누워 호흡을 늦추는 거야",
          "next": [
            202460007
          ]
        },
        "202460007": {
          "id": 202460007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그리고 갓 끓인 펄펄 끓는 진한 향신료 차를 큰 컵으로 세 잔 마신 다음, 몸을 모래에 파묻고 모래찜질을 해",
          "next": [
            202460008
          ]
        },
        "202460008": {
          "id": 202460008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그 상태에서 태양이 증발시키는 수분보다 땀을 더 많이 흘리기만 하면, 속세를 초월한 듯한 극한의 시원함을 느낄 수 있지",
          "next": [
            202460009
          ]
        },
        "202460009": {
          "id": 202460009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "아쉽게도 난 어릴 때 제대로 해볼 기회가 없었어",
          "next": [
            202460010
          ]
        },
        "202460010": {
          "id": 202460010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "근데 아까 해변에서 문득 생각이 나길래, 따뜻한 차를 마시고 눈을 감은 채 가만히 쉬고 있었거든",
          "next": [
            202460011
          ]
        },
        "202460011": {
          "id": 202460011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "내가 일사병으로 쓰러진 건 아닌지 보안요원이 몇 번이고 확인하지 않았다면 아마 반나절은 더 누워 있었을 거야",
          "next": [
            202460012,
            202460013,
            202460014
          ]
        },
        "202460012": {
          "id": 202460012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그게 그렇게까지 열중할 일인가요? 나중에 차가운 얼음 소다수를 10잔은 마셔줘야 열을 식힐 수 있을 것 같은데",
          "next": [
            202460017
          ]
        },
        "202460013": {
          "id": 202460013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "글자만 봐도 땀이 나네요. 열을 식혀줄 차가운 얼음 소다수로 배상하세요",
          "next": [
            202460017
          ]
        },
        "202460014": {
          "id": 202460014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어린 시절의 아쉬움을 달랠 때가 왔어요! 가요!",
          "next": [
            202460015
          ]
        },
        "202460015": {
          "id": 202460015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "저도 같이 모래에 파묻힐게요! 대신 나중에 차가운 얼음 소다수 10잔 사서 열을 식혀주신다면요",
          "next": [
            202460016
          ]
        },
        "202460016": {
          "id": 202460016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "네가 그렇게 말하니까 나도 불타오르네, 친구",
          "next": [
            202460017
          ]
        },
        "202460017": {
          "id": 202460017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "걱정 마, 네가 마시고 싶어 하는 차가운 얼음 소다수는 얼마든지 있으니까",
          "next": [
            202460018
          ]
        },
        "202460018": {
          "id": 202460018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "브랜드 측에서 내게 1,200만 상당의 소다수 쿠폰을 줬어. 한 달에 100만은 고사하고, 1년 내내 마셔도 다 못 마실걸",
          "next": [
            202460019
          ]
        },
        "202460019": {
          "id": 202460019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "마침 네가 말을 꺼냈으니, 앞으로 은하열차의 여름 음료는 내가 다 쏠게",
          "next": [
            202460020
          ]
        },
        "202460020": {
          "id": 202460020,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202460021
          ]
        },
        "202460021": {
          "id": 202460021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "참, 아스트로폴리스에서 외부인한테는 공개되지 않은 작은 찻집을 하나 발견했는데, 거기 차 맛이 고향의 맛이랑 비슷하더라",
          "next": [
            202460022
          ]
        },
        "202460022": {
          "id": 202460022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "시간 날 때 내가 데려가서 맛보여 줄게",
          "next": []
        }
      },
      "participatingContactsIds": [
        1304,
