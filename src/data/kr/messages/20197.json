      "messages": {
        "201970000": {
          "id": 201970000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪크렘노스의 심야식당≫ 첨부 파일을 발송했습니다",
          "next": [
            201970001
          ]
        },
        "201970001": {
          "id": 201970001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪오크마 브런치 제안서≫ 첨부 파일을 발송했습니다",
          "next": [
            201970002
          ]
        },
        "201970002": {
          "id": 201970002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪네스티아와 세르세스의 맛있는 듀엣≫ 첨부 파일을 발송했습니다",
          "next": [
            201970003
          ]
        },
        "201970003": {
          "id": 201970003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪아이도니아의 죽은 것을 살리는 레시피≫ 첨부 파일을 발송했습니다",
          "next": [
            201970004
          ]
        },
        "201970004": {
          "id": 201970004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪돈 주고도 못 사는 야누스의 미각≫ 첨부 파일을 발송했습니다",
          "next": [
            201970005
          ]
        },
        "201970005": {
          "id": 201970005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "스스로에게 도전해 보고 싶어",
          "next": [
            201970006
          ]
        },
        "201970006": {
          "id": 201970006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "먹을래?",
          "next": [
            201970007,
            201970008,
            201970010
          ]
        },
        "201970007": {
          "id": 201970007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "네, 셰프님! 전 뭐든 다 먹어요",
          "next": [
            201970012
          ]
        },
        "201970008": {
          "id": 201970008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "셰프님, 보내주신 모든 요리를 다 먹어볼 수 있나요?",
          "next": [
            201970009
          ]
        },
        "201970009": {
          "id": 201970009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "네 배가 감당할 수 있다면 가능하지",
          "next": [
            201970012
          ]
        },
        "201970010": {
          "id": 201970010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그럼 요리 부탁드려요!",
          "next": [
            201970011
          ]
        },
        "201970011": {
          "id": 201970011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "좋아",
          "next": [
            201970012
          ]
        },
        "201970012": {
          "id": 201970012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "그럼 ≪크렘노스의 심야식당≫부터 시작해 볼까",
          "next": [
            201970013
          ]
        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "위에 나온 요리법과 스타일을 모두 시도해 봤지만, 크렘노스 요리가 제일 자신 있지",
          "next": [
            201970014,
            201970015,
            201970016
          ]
        },
        "201970014": {
          "id": 201970014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "사슴 심장 육회 무침이요?",
          "next": [
            201970017
          ]
        },
        "201970015": {
          "id": 201970015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "도마뱀 다리 구이요?",
          "next": [
            201970017
          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "많이 자극적인가요?",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "우리를 단단히 오해하고 있나 보네",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "그건 과거 크렘노스인이 용사를 시험하기 위해 쓰던 낡은 관습일 뿐이야. 내가 이미 없앴지",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "오늘날 크렘노스의 요리는 모두 균형 잡힌 영양과 건강한 식재료를 사용해",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "게다가 다른 요리법의 장점을 흡수해서 융합하고 발전시켰지",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "어떤 맛을 좋아해?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "자극적인 음식을 좋아해요",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "그럼 구름양갈비 간장조림을 해 보자. 이 요리는 염분 보충도 되고, 식욕을 돋울 수 있거든. 석류즙을 곁들이면 최고지",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "평범한 음식으로 주세요",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "새콤 콩 페이스트에 석류 허니 팬케이크를 곁들이면, 언제 먹어도 맛있지",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "전 맛이 특이한 것만 먹어요",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "저승의 바다 생선 통조림이 네 취향에 맞을 것 같은데",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "내가 요리할 때 잘 안 쓰는 재료지",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "아니면 10년 이상 보관해 둔 짐승고기를 가져올 수도 있어",
          "next": [
            201970030
          ]
        },
        "201970030": {
          "id": 201970030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "그 맛은 절대 못 잊을걸",
          "next": [
            201970031
          ]
        },
        "201970031": {
          "id": 201970031,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1404,
          "next": [
            201970032
          ]
        },
        "201970032": {
          "id": 201970032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "크렘노스성에는 이런 속담이 퍼져 있어. 「장군이 되고 싶은 전사는 먼저 훌륭한 주방장이 되어야 한다」",
          "next": [
            201970033
          ]
        },
        "201970033": {
          "id": 201970033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "그러니까, 내 요리 실력과 식재료 조합 센스를 믿어",
          "next": [
            201970034
          ]
        },
        "201970034": {
          "id": 201970034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "맛있게 먹길 바란다",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1404
      ]
    }
  ]
