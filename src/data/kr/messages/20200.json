      "messages": {
        "202000000": {
          "id": 202000000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "오랜만이다, {NICKNAME}",
          "next": [
            202000001
          ]
        },
        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "현재, 천외의 정보가 앰포리어스에 전해지면서 나무 정원의 학생들 사이에 새로운 지식의 물결이 일어나고 있어",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "방금 학생이 테스트 문제를 하나 보내왔어",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "≪당신은 어떤 에이언즈인지 테스트해 보세요≫ 첨부 파일을 발송했습니다",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "해 본 적 있어?",
          "next": [
            202000005,
            202000006,
            202000007
          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "할 필요도 없죠, 전 당연히 아키비리니까요",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "전 나누크예요. 당신을 절멸 대군으로 임명하죠",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "전 아하예요, 하멘!",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "대충 살펴보니, 운명의 길이라는 개념적인 차원에 의존하여 개인의 자아인지와 행동 예측을 분류하고 밝혀내려 했더군",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "친구 아낙사 님이 오프라인 상태입니다",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "친구 아낙사 님이 온라인 상태입니다",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "난 우로보로스다",
          "next": [
            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "평가는 다음과 같아",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「당신은 우로보로스와 무관하지 않다——마치 드로마스가 적토를 씹어 삼키듯이, 당신은 진리를 갈망하고, 삼키고, 차지하고 싶어 한다. 욕망이야말로 당신 행동의 본능이다」",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「당신의 인생 좌우명: 영원히 만족하지 마라!」",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "로봇 머리여야 하는 거 아닌가요?",
          "next": [
            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "묘하게 잘 어울려요",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "아주 좋은 탐식이네요",
          "next": [
            202000018
          ]
        },
        "202000018": {
          "id": 202000018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "좀 흥미롭기는 한데 그게 다야",
          "next": [
            202000019
          ]
        },
        "202000019": {
          "id": 202000019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "어쨌든",
          "next": [
            202000020
          ]
        },
        "202000020": {
          "id": 202000020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "숙제가 역시 부족했나 보군",
          "next": []
        }
