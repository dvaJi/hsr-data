          ]
        },
        "202250006": {
          "id": 202250006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "대담하게 생각해. 이 행운 비법은 각종 놀이에도 응용할 수 있으니까",
          "next": [
            202250010
          ]
        },
        "202250007": {
          "id": 202250007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "하지만 전 원래 패 놀이를 잘 못해요",
          "next": [
            202250008
          ]
        },
        "202250008": {
          "id": 202250008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "대담하게 생각해. 이 행운 비법은 각종 놀이에도 응용할 수 있으니까",
