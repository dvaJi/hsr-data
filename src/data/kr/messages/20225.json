        },
        "202250014": {
          "id": 202250014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "예전에 내 대전 상대가 5연패한 뒤 목이 너무 말라서 「망고 패향차」를 마셨다가 결국 50연패를 자기 패 놀이 역사에 새기고 말았지~",
          "next": [
            202250015,
