          ]
        },
        "202250001": {
          "id": 202250001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "이 행운을 타고 1,000연승을 돌파할 수 있게 본좌의 「행운 비법」을 홍보해야겠어",
          "next": [
            202250002
          ]
        },
        "202250002": {
          "id": 202250002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "물론 계획도, 성공도 사람이 하기에 달렸지——이 비법을 꼭 사용할 필요는 없고, 즐겁게 노는 게 제일 중요해",
          "next": [
            202250003
          ]
        },
        "202250003": {
          "id": 202250003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "아무 이유 없이 진다면 한번 써보는 것도 좋아",
          "next": [
            202250004,
            202250007
          ]
        },
        "202250004": {
          "id": 202250004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "제가 받을게요!",
          "next": [
            202250005
          ]
        },
        "202250005": {
          "id": 202250005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "가르쳐 주세요. 저도 패 놀이에서 이기고 싶어요!",
          "next": [
