      ],
      "messages": {
        "202470035": {
          "id": 202470035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "친구, 빨리, 3초 안에 대답해!",
          "next": [
            202470036
          ]
        },
        "202470036": {
          "id": 202470036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "빨간색, 파란색?",
          "next": [
            202470037,
            202470038,
            202470039
          ]
        },
        "202470037": {
          "id": 202470037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "빨간색이요!",
          "next": [
            202470040
          ]
        },
        "202470038": {
          "id": 202470038,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "파란색이요!",
          "next": [
            202470040
          ]
        },
        "202470039": {
          "id": 202470039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "파멸하라! 전 가위를 낼게요!",
          "next": [
            202470041
          ]
        },
        "202470040": {
          "id": 202470040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "나랑 통했네",
          "next": [
            202470043
          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "네가 예상대로 내지 않을 줄 알았어. 근데 이번 판엔 선택지가 두 개뿐이야",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "내가 대신 아무거나 하나 골라줄게. 우린 마음이 통할 거라 믿어",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "또 무슨 내기를 하시려고요?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그게, 어떤 꼬마가 내 파라솔 주변을 몇 바퀴째 맴도는 거야",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "난 꼬마가 길을 잃은 건 줄 알았는데, 알고 보니 내 발밑의 모래를 노리고 있었대",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "내 쪽에 있는 모래가 온 해변을 통틀어서 가장 곱다나. 이런 모래가 있어야만 아주 튼튼한 모래성을 쌓을 수 있대",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그래도 어린 친구가 꽤 재미난 게, 나한테 바로 땅을 넘기라고 요구하진 않았어",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "대신 눈앞에 있는 빨간색과 파란색 소라게 중 어느 쪽이 먼저 결승선을 통과할지 내기를 제안했지",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "꼬마가 이기면 이 완벽한 모래밭은 꼬마 차지가 되는 거야",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "들어오는 내기는 다 받아주시나 봐요. 애들 상대로 너무한 거 아니에요?",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어쩐지 왜 저한테 물어보나 했어요. 어벤츄린 씨가 고르면 무조건 이기잖아요",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "그럼 우리가 이기면요?",
          "next": [
            202470054
          ]
        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그러니까 네가 골라줘",
          "next": [
            202470054
          ]
        },
        "202470054": {
          "id": 202470054,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 입력 중입니다",
          "next": [
            202470055
          ]
        },
        "202470055": {
          "id": 202470055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "잠깐만, 저 게가 곧 결승선을 통과하겠어",
          "next": [
            202470056
          ]
        },
        "202470056": {
          "id": 202470056,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "우리가 이겼어",
          "next": [
            202470057
          ]
        },
        "202470057": {
          "id": 202470057,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "상대방이 입력 중입니다",
          "next": [
            202470068
          ]
        },
        "202470058": {
          "id": 202470058,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "꼬마의 간식을 받았나요?",
          "next": [
            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "모래 삽을 받았나요?",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "반지를 받았어",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "꼬마가 어른한테는 플라스틱 삽이랑 간식은 필요 없대. 근데 판돈이 대등하지 않으면 게임이 공평하지 않잖아",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그래서 꼬마가 나한테 악몽을 먹어 치워주는 마법 반지를 하나 줬어",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "정말 귀엽네. 단종된 희귀품인데 마침 나한테 필요하던 거야",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "음, 그 친구한테 디럭스 9스쿱 아이스크림을 하나 사주기로 했어",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "그런 다음 모래성 왕국 건설에 합법적으로 지분을 투자하라고 초대할 거야",
          "next": [
            202470066
          ]
        },
        "202470066": {
          "id": 202470066,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202470067
          ]
        },
        "202470067": {
          "id": 202470067,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "나중에 봐, 친구. 우린 모래를 옮기러 갈게",
          "next": []
        },
        "202470068": {
          "id": 202470068,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "꼬마가 나한테 진 대가로 뭘 줬는지 맞혀봐",
          "next": [
            202470058,
            202470059
          ]
        }
      },
      "participatingContactsIds": [
        1304,
