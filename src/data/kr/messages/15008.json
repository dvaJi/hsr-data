        "150080101": {
          "id": 150080101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} @Mar. 7th 괜찮아?",
          "next": [
            150080102
          ]
        },
        "150080102": {
          "id": 150080102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "너희 둘 쪽에 문제가 생겼다고 들었어",
          "next": [
            150080103
          ]
        },
        "150080103": {
          "id": 150080103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "무슨 일이죠?",
          "next": [
            150080104
          ]
        },
        "150080104": {
          "id": 150080104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "우리 둘은 괜찮아. 근데 거리를 둘러보다가 자칭 「스파키」라고 하는 녀석을 만났어",
          "next": [
            150080105
          ]
        },
        "150080105": {
          "id": 150080105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그 녀석이 나랑 {NICKNAME}을(를) 쓰러뜨리고, 열차팀을 환월 게임에서 제외시키겠다고 했어",
          "next": [
            150080106
          ]
        },
        "150080106": {
          "id": 150080106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "그러니까 빨리 움직여야 해",
          "next": [
            150080107
          ]
        },
        "150080107": {
          "id": 150080107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "그래서, 결정은 했어?",
          "next": [
            150080108
          ]
        },
        "150080108": {
          "id": 150080108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "나는 생각이 좀 있긴 한데, {NICKNAME}은(는) 어떨지 모르겠네",
          "next": [
            150080109
          ]
        },
        "150080109": {
          "id": 150080109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "환월 게임 참여에 관심 있어요",
          "next": [
            150080110
          ]
        },
        "150080110": {
          "id": 150080110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "제가 이기게 된다면 그 권능으로 뭘 할 수 있을지, 아니면 아하한테 뭘 요구할 수 있을지 계속 생각하고 있었어요",
          "next": [
            150080111
          ]
        },
        "150080111": {
          "id": 150080111,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "나중에 시간 될 때 같이 이야기해 봐요",
          "next": [
            150080112
          ]
        },
        "150080112": {
          "id": 150080112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "단항 쪽은 상황이 어때? @단항",
          "next": [
            150080113
          ]
        },
        "150080113": {
          "id": 150080113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "선주 특사와 연락이 닿았는데, 그쪽도 문제가 생겨서 도움이 필요한 모양이에요",
          "next": [
            150080114
          ]
        },
        "150080114": {
          "id": 150080114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "저랑 선데이 씨가 가는 중이에요",
          "next": [
            150080115
          ]
        },
        "150080115": {
          "id": 150080115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "제가 도울 일이 있다면 연락 주세요",
          "next": [
            150080116
          ]
        },
        "150080116": {
          "id": 150080116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "좋아. 히메코 언니, 우린 이제 뭘 하면 돼?",
          "next": [
            150080117
          ]
        },
        "150080117": {
          "id": 150080117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "내 모교인 「그래피아 아카데미」로 가줬으면 해",
          "next": [
            150080118
          ]
        },
        "150080118": {
          "id": 150080118,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[그래피아 아카데미의 위치]",
          "next": [
            150080119
          ]
        },
        "150080119": {
          "id": 150080119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "이 학교에는 돌리라는 선생님이 있어",
          "next": [
            150080120
          ]
        },
        "150080120": {
          "id": 150080120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "내 친구인데, 「환월 게임」에 필요한 가면을 보관하고 있지",
          "next": [
            150080121
          ]
        },
        "150080121": {
          "id": 150080121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "일이 더 복잡해지기 전에, 우선 그녀를 찾아가서 가면을 받아",
          "next": [
            150080122
          ]
        },
        "150080122": {
          "id": 150080122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "지금 바로 갈게",
          "next": [
            150080123
          ]
        },
        "150080123": {
          "id": 150080123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "나랑 웰트도 너희 쪽에 합류할게",
          "next": []
        }
