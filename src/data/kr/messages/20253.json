        "202530028": {
          "id": 202530028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "선주 호협의 이야기, 정말 피가 끓어오른다니까!",
          "next": [
            202530029
          ]
