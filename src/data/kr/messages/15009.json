      "messages": {
        "150090101": {
          "id": 150090101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "안녕하세요, 채링 헌책방의 점장입니다. 갑자기 실례하게 됐네요",
          "next": [
            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "혹시 방금 ≪연지의 기록≫ 문서를 찾으셨나요?",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "그러긴 했어요",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "근데 어떻게 알았어요?",
          "next": [
            150090105
          ]
        },
        "150090105": {
          "id": 150090105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "광장에 있는 ≪연지의 기록≫이 알려줬어요",
          "next": [
            150090106
          ]
        },
        "150090106": {
          "id": 150090106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "방금 페이지에 당신이 그것을 구하는 용감한 모습이 떠올랐어요",
          "next": [
            150090115
          ]
        },
        "150090107": {
          "id": 150090107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "≪연지의 기록≫이 뭐예요?",
          "next": [
            150090108
          ]
        },
        "150090108": {
          "id": 150090108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "기억 나는 것 같기도 하고, 안 나는 것 같기도 하고",
          "next": [
            150090109
          ]
        },
        "150090109": {
          "id": 150090109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "책이자 환조종이기도 해요",
          "next": [
            150090110
          ]
        },
        "150090110": {
          "id": 150090110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "기억나요? 전에 광장을 지나갈 때 봤잖아요",
          "next": [
            150090115
          ]
        },
        "150090111": {
          "id": 150090111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "어라? 사람을 잘못 찾으신 것 같은데요",
          "next": [
            150090112
          ]
        },
        "150090112": {
          "id": 150090112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "틀림없어요. ≪연지의 기록≫에 당신이 그것을 구하는 용감한 모습이 떠올랐어요",
          "next": [
            150090113
          ]
        },
        "150090113": {
          "id": 150090113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "사기 치려는 거 아니에요. 직접 광장에 와서 확인해 보세요",
          "next": [
            150090114
          ]
        },
        "150090114": {
          "id": 150090114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "≪연지의 기록≫은 책이자 환조종이기도 해요",
          "next": [
            150090115
          ]
        },
        "150090115": {
          "id": 150090115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "그건 광장 한가운데 잔디밭에 있어요. 아무 때나 오시면 돼요",
          "next": [
            150090116
          ]
        },
        "150090116": {
          "id": 150090116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "방금 얻은 그 문서처럼",
          "next": [
            150090117
          ]
        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "잃어버린 ≪연지의 기록≫에는 옛 벤자이텐고쿠 문명의 기원에 관한 귀중한 전설이 담겨있어요",
          "next": [
            150090118
          ]
        },
        "150090118": {
          "id": 150090118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "그럼, 거기서 봐요",
          "next": []
        }
