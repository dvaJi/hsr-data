  "sections": [
    {
      "id": 2023700,
      "startingMessageId": [
        202370000
      ],
      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Se ha actualizado la versión del complemento Buscador de Blade.",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nuevo: corrección de errores conocidos, mejora de la amortiguación y más videos de miaudalenas vistos.",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le diste un toque al teléfono de Blade y vibró.",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Tu amigo Blade se ha conectado.",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Qué oportuno, justo pensaba en ti.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Qué honor! Cuéntame, ¿qué estabas pensando?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Por fin vamos a ponernos al día?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "No.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Hace poco vi en la armería algunas piezas muy desgastadas, pero de buen material. Nadie las reclama. Deben ser cosas que dejaste en el pasado.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ya que me escribes, aprovecho para preguntar: ¿qué quieres? Cuando regrese, puedo modificarlas y reforjarlas.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Qué dejé atrás? ¿Armas?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Varias piezas que ya son irreconocibles. Por su estructura, parecen ser objetos de uso cotidiano.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Todo material merece ser aprovechado. Dime, puedo forjar cualquier cosa.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Para los viajes interestelares, que agotan mucho, necesito una máquina para dormir que me ayude a conciliar el sueño al instante en cualquier momento y lugar.",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "En Xianzhou, antes lo llamábamos \"cuna\".",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Preferiría algo que no sea tan común.",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "¿Duermes bien?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Hace un tiempo forjé en la nave unos artefactos para ayudar a conciliar el sueño. ¿Qué te parecen?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Entonces quiero una mejora! Necesito algo que me ayude a entrar en un sueño profundo al instante, en cualquier lugar y momento.",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "De acuerdo.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡No tengo preferencias, haz lo que quieras!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Hace un tiempo forjé en la nave unos artefactos para ayudar a conciliar el sueño. ¿Qué te parecen?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Genial! Necesito algo que me ayude a entrar en un sueño profundo al instante, en cualquier lugar y momento.",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "De acuerdo.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Lograr que alguien se duerma no es difícil, pero conseguir un efecto de sueño forzado requiere un diseño adicional.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Puedes añadir algo de ruido blanco para conciliar el sueño más rápido.",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Es sencillo. Al añadir unas piezas de hierro, se puede simular el zumbido de la forja.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ese sonido antes me ponía en alerta, pero a ti quizá te ayude a dormir.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Se puede añadir alguna función para ayudar a dormir? Como masajes o que dé golpecitos en la almohada.",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Está bien.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "En el taller hay articulaciones de brazos mecánicos en desuso que pueden simular esos movimientos.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Solo que hacen bastante ruido, tómalo como si fuera ruido blanco.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Se puede añadir alguna canción de cuna con voz?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Está bien.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Le integraré un reproductor para poder grabar una canción.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Pero no sé cantar bien. Como mucho puedo decirte algunas... letras.",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bueno, con que recites algo está bien.",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Una vez terminada la modificación, puedo enviártelo o puedes venir a buscarlo. Como prefieras.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Hablamos luego.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Adiós.",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Tu amigo Blade se ha desconectado.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}