      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "¡Vaya! Me enteré de que acabas de sufrir una humillación sin precedentes. ¿Qué tal? ¿Ya entiendes cómo me siento normalmente?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Cómo te enteras de todo tan rápido? Eso pasó hace menos de un minuto y ya lo sabes.",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Estás feliz? Por fin puedes reírte de mí, ¿verdad?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Tengo a unos cuantos espectros secuaces en el Centro de Empleo del Más Allá que se escondieron cerca para transmitirme todo en directo.",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Por supuesto, no he venido solo a burlarme, tengo una forma de ayudarte.",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Hablemos de los detalles cuando nos veamos. Estoy cerca, ven a buscarme.",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Skott ha compartido su ubicación.",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Ayudarme? ¿Por qué eres tan amable de repente?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Sigues tan alerta como siempre.",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Ven primero a charlar conmigo. Igual no puedo ganarte, ¿a qué le tienes miedo?",
          "next": [
            150930110
          ]
        },
        "150930110": {
          "id": 150930110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Apúrate, estoy ocupado.",
          "next": []
        }
      },
