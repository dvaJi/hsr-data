        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Las «Crónicas de la Grasa Flotante» perdidas contienen valiosas leyendas sobre el origen de la civilización del antiguo Benzaitengoku.",
