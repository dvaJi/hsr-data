            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¿Has encontrado algún texto de «Crónicas de la Grasa Flotante» recientemente?",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sí, pero...",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Cómo lo sabes?",
          "next": [
