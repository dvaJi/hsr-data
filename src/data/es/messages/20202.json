          ]
        },
        "202020004": {
          "id": 202020004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Ciny, Ciny, Ciny, Ciny!",
          "next": [
            202020005
          ]
        },
        "202020005": {
          "id": 202020005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Qué sucede?",
          "next": [
            202020006
          ]
        },
        "202020006": {
          "id": 202020006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "No es nada. Ica estaba trepando por mi pierna y presionó los atajos de teclado.",
          "next": [
            202020007
          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Pero sí debería buscarte, Cenici. Después de todo, la batalla final no será nada fácil.",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¿Tus heridas están mejorando? ¿Dormiste bien? ¿Tienes apetito? ¿Te sientes cansad{F#a}{M#o} en el trabajo? ¿Tienes alguna otra molestia?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Estoy muy bien!",
          "next": [
            202020010
          ]
        },
        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¡Entonces me quedo tranquila!",
          "next": [
            202020018
          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Me gusta comer pero no hacer ejercicio... ¿Hay alguna cura para eso, doctora?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Si tu cuerpo quiere dormir, déjalo descansar. Debes estar muy cansad{F#a}{M#o}, no te fuerces demasiado.",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Si quieres una comida saludable y deliciosa, hay otra forma...",
          "next": [
            202020014
          ]
        },
        "202020014": {
          "id": 202020014,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020015": {
          "id": 202020015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Cómo puedo curar la falta de motivación en el trabajo?",
          "next": [
            202020016
          ]
        },
        "202020016": {
          "id": 202020016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¿Demasiada presión? ¡Es fácil!",
          "next": [
            202020017
          ]
        },
        "202020017": {
          "id": 202020017,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020018": {
          "id": 202020018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¡Ven al Patio Claroscuro! Te prepararé unos bocadillos.",
          "next": [
            202020019
          ]
        },
        "202020019": {
          "id": 202020019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Podemos tomar el sol, disfrutar de la brisa y contar cuántas veces suena la campanilla de viento.",
          "next": [
            202020020
          ]
        },
        "202020020": {
          "id": 202020020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Encenderemos un incienso de hierbas crepuscular hecho por mí.",
          "next": [
            202020021
          ]
        },
        "202020021": {
          "id": 202020021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Luego, nos recostaremos en la suave y acogedora mecedora para disfrutar de las canciones de cuna de Ica.",
          "next": [
            202020022,
            202020025
          ]
        },
        "202020022": {
          "id": 202020022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Iré ahora mismo!",
          "next": [
            202020023
          ]
        },
        "202020023": {
          "id": 202020023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Bien, Ica y yo te esperamos.",
          "next": [
            202020024
          ]
        },
