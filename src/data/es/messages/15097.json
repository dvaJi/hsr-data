        },
        "150970102": {
          "id": 150970102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Una persona te ha dejado un mensaje.",
          "next": [
            150970103
          ]
        },
        "150970103": {
          "id": 150970103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"Gracias por traer de vuelta a todos los pequeños. Te han preparado un regalo de agradecimiento. ¡Ven a recogerlo a la 'Base secreta de los mejores amigos' cuando tengas tiempo!\".",
          "next": [
            150970104
          ]
        },
        "150970104": {
          "id": 150970104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"¡Además! También te dejé un regalo en Bidimensia. En cuanto a la ubicación exacta...\".",
          "next": [
            150970106
          ]
        },
        "150970105": {
          "id": 150970105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Eso es todo, ¡te espero allí!",
          "next": []
        },
        "150970106": {
          "id": 150970106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "1. ¡Es un lugar donde se puede ver la fabuluna!",
          "next": [
            150970107
          ]
        },
        "150970107": {
          "id": 150970107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "2. ¡Es un lugar muy alto!",
          "next": [
            150970108
          ]
        },
        "150970108": {
          "id": 150970108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "3. ¡Es un lugar donde una caja de hierro se mueve bajo tus pies!",
          "next": [
            150970109
          ]
        },
        "150970109": {
          "id": 150970109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"Esas son todas las pistas. ¡Ven a buscarlo!\".",
