  "sections": [
    {
      "id": 2024800,
      "startingMessageId": [
        202470035
      ],
      "messages": {
        "202470035": {
          "id": 202470035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¡Rápido! ¡Dame una respuesta en tres segundos!",
          "next": [
            202470036
          ]
        },
        "202470036": {
          "id": 202470036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¿Rojo o azul?",
          "next": [
            202470037,
            202470038,
            202470039
          ]
        },
        "202470037": {
          "id": 202470037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Rojo!",
          "next": [
            202470040
          ]
        },
        "202470038": {
          "id": 202470038,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Azul!",
          "next": [
            202470040
          ]
        },
        "202470039": {
          "id": 202470039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Cualquiera! ¡Tijeras!",
          "next": [
            202470041
          ]
        },
        "202470040": {
          "id": 202470040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Lo sabía.",
          "next": [
            202470043
          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Sabía que no jugarías según las reglas, pero en esta ronda solo hay dos opciones.",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Elegiré uno al azar por ti. Confío en que nos leeremos la mente.",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿A qué estás apostando esta vez?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hay un niño que ya dio varias vueltas alrededor de mi sombrilla.",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Pensé que estaba perdido, pero resulta que estaba mirando la arena bajo mis pies.",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Dicen que aquí tengo la arena más fina de toda la playa, y que solo con este tipo de arena se puede construir el castillo de arena más resistente.",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Pero el pequeño es bastante interesante, no me pidió directamente que le cediera el terreno.",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Me propuso una apuesta: cuál de los dos cangrejos ermitaños frente a nosotros cruzaría primero la línea de meta, el rojo o el azul.",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Si gana, esta arena perfecta será suya.",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Entonces aceptas cualquier apuesta? ¿No te da miedo meterte con un niño?",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Con razón vienes a preguntarme. Si tú apuestas, ya se sabe quién va a ganar.",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Y si ganamos?",
          "next": [
            202470054
          ]
        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Así que, te invito a apostar.",
          "next": [
            202470054
          ]
        },
        "202470054": {
          "id": 202470054,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202470055
          ]
        },
        "202470055": {
          "id": 202470055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Un momento, ese cangrejo está a punto de cruzar la meta.",
          "next": [
            202470056
          ]
        },
        "202470056": {
          "id": 202470056,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ganamos.",
          "next": [
            202470057
          ]
        },
        "202470057": {
          "id": 202470057,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202470068
          ]
        },
        "202470058": {
          "id": 202470058,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Tus propios bocadillos?",
          "next": [
            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Una pala de plástico para construir castillos de arena?",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Un anillo.",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "El niño dijo que los adultos no necesitan palas de plástico ni bocadillos, pero si las apuestas no son equivalentes, el juego no es justo.",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Así que me dio un anillo mágico capaz de devorar pesadillas.",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Qué adorable. Una joya de edición limitada. Justo lo que necesito.",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Sí, he decidido comprarle un helado de nueve bolas de lujo.",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Luego, invitarlo a invertir legalmente en la construcción del Reino del Castillo de Arena.",
          "next": [
            202470066
          ]
        },
        "202470066": {
          "id": 202470066,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202470067
          ]
        },
        "202470067": {
          "id": 202470067,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hasta pronto, amig{F#a}{M#o}, nos vamos a mover arena.",
          "next": []
        },
        "202470068": {
          "id": 202470068,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Adivina qué perdió contra mí.",
          "next": [
            202470058,
            202470059
          ]
        }
      },
      "participatingContactsIds": [
        1304,
        8001
      ]
    }
  ]
}