          ]
        },
        "150150106": {
          "id": 150150106,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡No me digas que a ti también te pasó algo!",
          "next": [
            150150107
          ]
        },
        "150150107": {
          "id": 150150107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1009,
          "text": "¿Peppy? Lo siento, estoy de compras en Planarcadia, y tengo tantas cosas en las manos que solo puedo enviarte un mensaje de voz. Es posible que Peppy se haya escapado mientras no prestaba atención, voy a revisar su sistema de rastreo.",
          "next": [
            150150108
          ]
        },
        "150150108": {
