        "150150101": {
          "id": 150150101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Asta! ¡Ven rápido a la @Puerta de Planarcadia! ¡Peppy está en graves problemas!",
          "next": [
            150150102
          ]
        },
        "150150102": {
          "id": 150150102,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Parece que está un poco muerto!",
          "next": [
            150150103,
            150150105
          ]
        },
        "150150103": {
          "id": 150150103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Por favor, por favor, responde a mi mensaje!",
          "next": [
            150150104
          ]
        },
        "150150104": {
          "id": 150150104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Al menos déjame asegurarme de que estás bien!",
