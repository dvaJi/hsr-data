        "202010015": {
          "id": 202010015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Por favor, genera una foto del profesor Anaxa. Contenido: una valiosa imagen del profesor Anaxa montando un droma y atacando a Castrum Kremnos.",
