            202120007
          ]
        },
        "202120004": {
          "id": 202120004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿No es un poco temprano para caminar sonámbula?",
          "next": [
            202120007
          ]
        },
        "202120005": {
          "id": 202120005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Amiga, recuerda cambiar de cuenta.",
