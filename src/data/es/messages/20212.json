        },
        "202120020": {
          "id": 202120020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ay, quería ayudar sin que se dieran cuenta, pero parece que me descubrieron.",
          "next": [
            202120021
          ]
        },
        "202120021": {
          "id": 202120021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Todos esos selfis son para Siete de Marzo.",
          "next": [
            202120022
