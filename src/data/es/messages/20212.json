            202120006
          ]
        },
        "202120006": {
          "id": 202120006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Pero ahora es de noche.",
          "next": [
            202120007
          ]
        },
        "202120007": {
          "id": 202120007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1413,
          "next": [
            202120008
          ]
        },
        "202120008": {
          "id": 202120008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Solo vine a hacer un pequeño trato contigo.",
          "next": [
            202120009
          ]
        },
        "202120009": {
          "id": 202120009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Todavía tengo algunos de tus \"recuerdos\". No querrás que se hagan públicos, ¿verdad?",
          "next": [
            202120010,
            202120011
          ]
        },
        "202120010": {
          "id": 202120010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Te escucho.",
          "next": [
            202120012
          ]
        },
        "202120011": {
          "id": 202120011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Quienes son rectos no temen que su sombra esté torcida.",
          "next": [
            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Seguiste al droma con el corazón roto y, sin que se diera cuenta, te tomaste un selfi con él con la frase \"solo los tontos se enamoran\".",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Fuiste con un adivino callejero y te tomaste un selfi frente a su puesto con la frase \"nosotros decidimos nuestro destino\".",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Saliste a dar un paseo, te encontraste con un bardo y comenzaste una batalla de rap... además de tomar un selfi.",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Esta mañana, te tomaste un selfi cuando tenías el pelo todo despeinado.",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Pensaste que habías engordado, así que te tomaste un selfi.",
          "next": [
            202120017
          ]
        },
        "202120017": {
          "id": 202120017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202120018,
            202120019,
            202120020
          ]
        },
        "202120018": {
          "id": 202120018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bien, parece que necesitamos del poder del \"Olvido\".",
          "next": [
            202120023
