        "202120002": {
          "id": 202120002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Despierta!",
          "next": [
            202120003
          ]
        },
        "202120003": {
          "id": 202120003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Llegó tu ropa nueva, hay un cazatalentos tocando la puerta, y tu jugo favorito está haciendo una colaboración con Robin.",
