      "messages": {
        "202230000": {
          "id": 202230000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Se ha enviado el archivo adjunto \"Acuerdo de colaboración comercial con el canal de Chispa.pdf\".",
          "next": [
            202230001
          ]
        },
        "202230001": {
          "id": 202230001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Cariño, ¿qué tipo de colaboración te parece más adecuada? Te explicaré todo en detalle.",
          "next": [
            202230002
          ]
        },
        "202230002": {
          "id": 202230002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Los recursos que proporcionamos son los mejores de la industria.",
          "next": [
            202230003
          ]
        },
        "202230003": {
          "id": 202230003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Cariño, ¿estás ocupad{F#a}{M#o}? Déjame invitarte un té con leche, ¿qué sabor te gustaría?",
          "next": [
            202230004,
            202230005,
            202230006
          ]
        },
        "202230004": {
          "id": 202230004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Colaboración? Soy muy {F#cara}{M#caro}.",
          "next": [
            202230007
          ]
        },
        "202230005": {
          "id": 202230005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Habla con mi jefe, Pom-Pom.",
          "next": [
            202230007
          ]
        },
        "202230006": {
          "id": 202230006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dile a tu jefa que venga, soy {F#una clienta}{M#un cliente} VVVIP.",
          "next": [
            202230007
          ]
        },
        "202230007": {
          "id": 202230007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡Yo me encargo! Me dijeron específicamente que yo me ocupara de pelo gris.",
          "next": [
            202230008
          ]
        },
        "202230008": {
          "id": 202230008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Volvamos al asunto que nos ocupa. Tengo una idea brillante",
          "next": [
            202230009
          ]
        },
        "202230009": {
          "id": 202230009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡Como tienes tantos contactos, llama a tus amigos y unamos fuerzas para hacer un directo con un elenco estelar! ¿Qué te parece?",
          "next": [
            202230010
          ]
        },
        "202230010": {
          "id": 202230010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡El programa se llamará \"Chispita y sus amigos\"!",
          "next": [
            202230011,
            202230013
          ]
        },
        "202230011": {
          "id": 202230011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Mis contactos o tus contactos? ¿Mis amigos o tus amigos?",
          "next": [
            202230012
          ]
        },
        "202230012": {
          "id": 202230012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Tus amigos son mis amigos. ¡Nuestros amigos!",
          "next": [
            202230015
          ]
        },
        "202230013": {
          "id": 202230013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Qué gano yo si colaboro contigo?",
          "next": [
            202230014
          ]
        },
        "202230014": {
          "id": 202230014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Compartiremos los derechos del título y el nombre completo será \"Chispita, pelo gris y sus amigos\".",
          "next": [
            202230015
          ]
        },
        "202230015": {
          "id": 202230015,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 215,
          "next": [
            202230016
          ]
        },
        "202230016": {
          "id": 202230016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Dejemos todo lo demás de lado y empecemos con la preselección de invitados.",
          "next": [
            202230017
          ]
        },
        "202230017": {
          "id": 202230017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Cuéntame quiénes son tus contactos.",
          "next": [
            202230018,
            202230022,
            202230026
          ]
        },
        "202230018": {
          "id": 202230018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tengo contactos en Planarcadia, y son personas muy importantes.",
          "next": [
            202230019
          ]
        },
        "202230019": {
          "id": 202230019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Puedo hablar con el antiguo líder de Colonipenal y con una general de Xianzhou.",
          "next": [
            202230020
          ]
        },
        "202230020": {
          "id": 202230020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "El chico de las alitas de pollo ya es una cara conocida para la audiencia. Podríamos considerarlo.",
          "next": [
            202230021
          ]
        },
        "202230021": {
          "id": 202230021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Pero prefiero que el titular promocional sea \"¡Nuevo grupo monstruoso: Chispyao!\". ¡Sí! Encárgate de convencer a la general Yao Guang.",
          "next": [
            202230031
          ]
        },
        "202230022": {
          "id": 202230022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Recomiendo un agujero negro del juego, será muy vistoso.",
          "next": [
            202230023
          ]
        },
        "202230023": {
          "id": 202230023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "El Eón de la Nihilidad, IX.",
          "next": [
            202230024
          ]
        },
        "202230024": {
          "id": 202230024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Sí, es un agujero negro... pero también es conocido por su pésimo control de las emociones.",
          "next": [
            202230025
          ]
        },
        "202230025": {
          "id": 202230025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Si de verdad puedes llamarlo, lo consideraré.",
          "next": [
            202230031
          ]
        },
        "202230026": {
          "id": 202230026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No tengo contactos, mejor llama tú misma a Chispe, Chispi, Chispo y Chispu.",
          "next": [
            202230027
          ]
        },
        "202230027": {
          "id": 202230027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Pelo gris...",
          "next": [
            202230028
          ]
        },
        "202230028": {
          "id": 202230028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡Eres {F#una auténtica}{M#un auténtico} fan! ¿Cómo sabías que no había dado de baja ninguna de esas cuentas?",
          "next": [
            202230029
          ]
        },
        "202230029": {
          "id": 202230029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Solo estaba bromeando.",
          "next": [
            202230030
          ]
        },
        "202230030": {
          "id": 202230030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Ji, ji, consideraré reunirlas a todas.",
          "next": [
            202230031
          ]
        },
        "202230031": {
          "id": 202230031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡Ahora el asistente preparará un borrador de la invitación!",
          "next": [
            202230032
          ]
        },
        "202230032": {
          "id": 202230032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Por cierto, en el acuerdo de colaboración pone que tú también debes aparecer ante la cámara.",
          "next": [
            202230033
          ]
        },
        "202230033": {
          "id": 202230033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "¡Piensa rápido qué espectáculo vas a hacer!",
          "next": []
        }
      },
