            150920106
          ]
        },
        "150920106": {
          "id": 150920106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ja, ja, ja, ja, ¿qué clase de broma es esa? Llevamos tanto tiempo buscando libros antiguos juntos, ¡hace mucho que somos amig{F#a}{M#o}s inseparables!",
          "next": [
            150920107
          ]
        },
        "150920107": {
          "id": 150920107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ejem, es broma. Sigo en Astrópolis, te espero en el lugar de siempre.",
          "next": []
        },
        "150920108": {
