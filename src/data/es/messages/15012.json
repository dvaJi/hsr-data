          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Cómo conseguiste mi número de teléfono?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "¿Ni siquiera sabes quién soy? Es ridículo que quieras llegar tan lejos sin siquiera saber quién soy.",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eres el doctor Izol, ¿verdad?",
