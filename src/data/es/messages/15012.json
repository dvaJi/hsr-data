        },
        "150120101": {
          "id": 150120101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Quién eres?",
          "next": [
            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "¡No te hagas {F#la tonta}{M#el tonto}! Tú eres {F#la}{M#el} responsable de la Agencia Pachicom, ¿tú planeaste todo esto?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ya no puedo controlar mis manos.",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Mi nariz también se mueve sin control.",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "¡Detente ahora mismo!",
