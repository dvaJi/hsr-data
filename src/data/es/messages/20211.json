      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Dux Protagonis, estoy preparando mi primera \"Exploración Extrema\".",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tú que estás acostumbrad{F#a}{M#o} a viajar por las estrellas, seguro puedes darme algún consejo.",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Te vas sola? ¿A dónde quieres ir?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Si alguien quiere acompañarme, no me opongo.",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿A dónde vas?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eres bienvenida en el Expreso Astral.",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Podría ser una parada en mi viaje, pero eso lo veremos más adelante.",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Destino: Amphoreus del futuro.",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "De mis viajes pasados, recuerdo las naciones consumidas por fuegos ardientes del conflicto o por la marea oscura.",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Cuando las Semillas de la memoria florezcan, Amphoreus cobrará vida, y será mi oportunidad de explorar.",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Quiero navegar por las aguas de Skiana, donde las nubes oscuras y las olas gigantes luchan sin cesar.",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "¿Has oído hablar de Ladón? Dicen que allí hay un lugar tan alto que puede tocar las nubes.",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Estoy entre el vuelo con traje de alas y el paracaidismo.",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "¿Qué me recomiendas, Dux Protagonis?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cualquiera. Después de todo, estoy acostumbrad{F#a}{M#o} a girar, saltar, y aterrizar en mundos nuevos desde las alturas.",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Suena muy bien.",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es una larga historia, pero estoy acostumbrad{F#a}{M#o} a aterrizar en mundos nuevos desde las alturas.",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Deberías intentarlo.",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Suena muy bien.",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Por favor, ten cuidado!",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "No te preocupes, soy fuerte.",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Hace poco recibí el entrenamiento de supervivencia en la naturaleza con la gatita y el entrenamiento de tejido de cuerdas de Dux Tejedora de Oro.",
          "next": [
