          ]
        },
        "201970005": {
          "id": 201970005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Quiero ponerme a prueba.",
          "next": [
            201970006
          ]
        },
        "201970006": {
          "id": 201970006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "¿Quieres comer?",
          "next": [
            201970007,
            201970008,
            201970010
          ]
        },
        "201970007": {
          "id": 201970007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sí, chef. Yo como de todo.",
          "next": [
            201970012
          ]
        },
        "201970008": {
          "id": 201970008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chef, ¿has probado todos los menús que enviaste?",
          "next": [
            201970009
          ]
        },
        "201970009": {
          "id": 201970009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Si puedes comerlo todo, adelante.",
          "next": [
            201970012
          ]
        },
        "201970010": {
          "id": 201970010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Que pase el chef Midei!",
          "next": [
            201970011
          ]
        },
        "201970011": {
          "id": 201970011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Está bien.",
          "next": [
            201970012
          ]
        },
        "201970012": {
          "id": 201970012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Empecemos con el «Restaurante nocturno de Kremnos».",
          "next": [
            201970013
          ]
        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Aunque he probado todas las recetas y estilos mencionados, la comida de Kremnos definitivamente es mi especialidad.",
          "next": [
            201970014,
            201970015,
            201970016
          ]
        },
        "201970014": {
          "id": 201970014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Tartar de corazón de ciervo?",
          "next": [
            201970017
          ]
        },
        "201970015": {
          "id": 201970015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Patas de lagarto a la parrilla?",
          "next": [
            201970017
          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Es porque ya te acostumbraste?",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Parece que tienes un concepto errado sobre nosotros.",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Esas eran viejas costumbres que los habitantes de Kremnos usaban para poner a prueba a los guerreros. Las abolí hace mucho tiempo.",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "La comida de Kremnos de hoy en día es nutritiva, saludable y abundante.",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "También ha integrado lo mejor de otras cocinas para crear algo nuevo y mejorado.",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "¿Qué sabores te gustan?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Me encanta la comida con sabores fuertes.",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Entonces, ¿qué te parecen las costillas de oveja de las nubes en salsa? Ese plato es excelente para reponer la sal y estimular el apetito. Lo mejor es acompañarlo con jugo de granada.",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Quiero algo más normal.",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Puré de frejoles con pastel de granada, una combinación que nunca falla.",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Si no sabe raro, no lo como.",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Entonces, la conserva de pescado del mar Estigio podría ser de tu agrado.",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Rara vez la uso para cocinar.",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "O podría conseguir carne que haya estado almacenada por más de diez años.",
          "next": [
            201970030
          ]
        },
        "201970030": {
          "id": 201970030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Un olor que jamás olvidarás.",
          "next": [
            201970031
          ]
        },
        "201970031": {
          "id": 201970031,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1404,
          "next": [
            201970032
          ]
        },
        "201970032": {
          "id": 201970032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hay un proverbio muy difundido en Castrum Kremnos: \"Un soldado que aspira a ser general, primero debe ser un excelente cocinero\".",
          "next": [
            201970033
          ]
        },
        "201970033": {
          "id": 201970033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Así que, confía en mi nivel de cocina y mis combinaciones.",
          "next": [
            201970034
          ]
        },
        "201970034": {
          "id": 201970034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "¡Buen provecho!",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1404
      ]
    }
  ]
}