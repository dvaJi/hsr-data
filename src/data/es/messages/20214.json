        "202140007": {
          "id": 202140007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Intenté imitarlos un poco. En ese momento, generalmente suelen decir: me gusta, quiero más, sigue así.",
