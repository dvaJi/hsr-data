          ]
        },
        "150220101": {
          "id": 150220101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Xueyi! ¡No esperaba recibir un mensaje tuyo!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "¡Sigues tan enérgic{F#a}{M#o} como siempre!",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hace mucho que no hablamos.",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Lo siento, ha sido mi culpa.",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Cuando tenga tiempo, hablaré contigo más seguido.",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Oí que estás viajando por Planarcadia.",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Quiero pedirte un favor.",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Por supuesto, adelante, su señoría!",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "¿Has oído hablar de «Juego del laberinto»?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Me interesa mucho este comic.",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Perseguir criminales me parece más apropiado que «La estrella de la cocina», el debut de la autora.",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "He oído que en Bidimensia están llevando a cabo una convención exclusiva de «Juego del laberinto», y están vendiendo muchas obras de arte de los fans.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Por desgracia, debido a mi posición, no puedo asistir personalmente a la convención de cómics en Planarcadia.",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Espero que puedas comprarme algunos fanzines para aliviar mi pesar.",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Justo estaba dando vueltas cerca de la convención cuando recibí tu mensaje... ¿No me estarás siguiendo?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Bip, bip, el dron de rastreo \"Xueyi Modelo 9527\" ha sido descubierto. Iniciando autodestrucción.",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Ahhh! ¡Ten piedad! ¡No me mates! ¡Te compraré fanzines!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "No temas, solo estaba bromeando.",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "No hay drones que puedan explotar solitos, no te preocupes.",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Estoy ansiosa por ver los nuevos fanzines. Gracias.",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Qué coincidencia! Justo estoy cerca de la convención.",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "¿Tú también lo has visto? Excelente, gracias.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No te preocupes, es algo sencillo. Déjamelo a mí.",
          "next": [
            150220124
          ]
        },
