        },
        "202440015": {
          "id": 202440015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tengo que pensar en el contenido del próximo video... {NICKNAME}, ¿tienes alguna sugerencia?",
