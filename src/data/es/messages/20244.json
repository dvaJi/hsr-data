        },
        "202440021": {
          "id": 202440021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "¡Qué buena idea! De hecho, una vez descubrí que, si ahuecas una zanahoria y le haces unos agujeros, al soplarla produce un sonido maravilloso.",
