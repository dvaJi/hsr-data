        },
        "202440017": {
          "id": 202440017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Por ejemplo, Chispa, de la sección de directos, o la Pequeña Gui y Sushang, de la sección cazafantasmas de Xianzhou.",
