  "sections": [
    {
      "id": 2023000,
      "startingMessageId": [
        202300000
      ],
      "messages": {
        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¿Cómo puede existir una criatura tan adorable en el mundo?",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Sus patitas son suaves y huele delicioso, como el arroz.",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Lástima que mi cámara esté rota y no pueda tomarle fotos a este perrito.",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Estoy de acuerdo! ¡Los perritos hacen del mundo un lugar mejor!",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Tienes un perro? Déjame acariciarlo.",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "No, es el perrito del cliente que hizo el encargo.",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lo siento, pero yo soy más de gatos.",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, ya veo.",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Una persona importante cuya identidad no puede revelarse recibió esta mañana una carta amenazante de origen desconocido.",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Solo contenía cuatro palabras: \"Vas a morir, perro\".",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Acepté el encargo sin dudar ni un instante.",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ahora, nadie se atreverá a tocarle un pelo al perrito.",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Y si resulta que \"perro\" no se refería al perrito?",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¿Te refieres al cliente? Por supuesto que lo sé. No te preocupes, Narrador fue a protegerlo.",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "El perrito me necesita más que el cliente.",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pues yo creo que tú lo necesitas más a él.",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Por qué no adoptas un perro? Así no tendrás que estar todo el día acariciando a los de los demás.",
          "next": [
            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¡Ay! Si tuviera dinero para comprar comida para perros, tendría uno.",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "El cliente del encargo dice que a los perros también se les llama \"absorbeplata\"... No puedo dejar que el cachorrito sufra conmigo.",
          "next": [
            202300019
          ]
        },
        "202300019": {
          "id": 202300019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1504,
          "next": [
            202300020
          ]
        },
        "202300020": {
          "id": 202300020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Espera, está pasando algo raro.",
          "next": [
            202300021
          ]
        },
        "202300021": {
          "id": 202300021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202300022
          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Quieto, no muerdas mi billetera, no hay dinero. Los perritos no pueden comerse eso. ¡Guau, guau, guau, guau!",
          "next": [
            202300023
          ]
        },
        "202300023": {
          "id": 202300023,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300024
          ]
        },
        "202300024": {
          "id": 202300024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¿Cómo puedes decir groserías tan feas? ¡Guau, guau, guau! ¿Me oyes? Los perritos no dicen groserías. ¡Guau, guau, guau, guau!",
          "next": [
            202300025
          ]
        },
        "202300025": {
          "id": 202300025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300026
          ]
        },
        "202300026": {
          "id": 202300026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¡Guau, guau, guau, mi dinero, guau, guau, guau! ¡Guau, guau, guau, guau!",
          "next": [
            202300027
          ]
        },
        "202300027": {
          "id": 202300027,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300028
          ]
        },
        "202300028": {
          "id": 202300028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¡Los perritos buenos no ladran! ¡Guau, guau, guau, guau, guau, guau!",
          "next": [
            202300029
          ]
        },
        "202300029": {
          "id": 202300029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300030
          ]
        },
        "202300030": {
          "id": 202300030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¡Narrador, guau, guau, guau, guau, guau, guau, guau, guau, guau, guau!",
          "next": [
            202300031
          ]
        },
        "202300031": {
          "id": 202300031,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300032
          ]
        },
        "202300032": {
          "id": 202300032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "¡Guau, guau, guau, guau, guau, guau, guau, guau, guau, guau!",
          "next": [
            202300033
          ]
        },
        "202300033": {
          "id": 202300033,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202300034
          ]
        },
        "202300034": {
          "id": 202300034,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Tu amigo Ashveil se ha desconectado.",
          "next": []
        }
      },
