      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt ¿Están todos bien?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "¡Respondan si me reciben, respondan si me reciben!",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Aviso: La señal es débil en este momento. Comprueba la conexión.",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@Siete de Marzo @{NICKNAME} @Sunday Recibido, todos estamos bien.",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Estamos bien. @Dan Heng, confírmanos que estás a salvo.",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "No te preocupes por nosotros. Acabamos de repeler una oleada de monstruos con tentáculos que emergieron del subsuelo.",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Uf.",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Por cierto, ¿de verdad tenemos que ir a Astrópolis? No es por nada, es solo que... la Corporación no me da mucha confianza.",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "¿Podemos intentar pedir ayuda a Xianzhou o a la Estación Espacial de la señora Herta?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Yo también lo estuve pensando.",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "En términos de distancia, Xianzhou y la Estación Espacial Herta están demasiado lejos. El tiempo apremia, así que nuestra mejor opción de rescate sigue siendo el plan de ir a Astrópolis.",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Más que la distancia, el verdadero problema es que Planarcadia forma parte de la red comercial de la Corporación.",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Según el acuerdo comercial interastral, la Corporación tiene prioridad absoluta sobre ella. Si una facción externa interviene a la fuerza, podría desatar un caos legal y diplomático muy complejo.",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "En ese caso... ¡No nos queda otra!",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME}, te encargo la misión de navegación.",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No te preocupes, me haré cargo.",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Lo sé, confío en ti.",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Yo... no sé qué hacer...",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "No te preocupes, tengo fe en ti. Como {F#piloto interina}{M#piloto interino}, seguro que sabrás qué camino tomar.",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "La situación es crítica, apoyaremos cualquier decisión que tomes.",
          "next": [
            150730120
          ]
        },
        "150730120": {
          "id": 150730120,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Aviso: La señal es débil en este momento. Comprueba la conexión.",
          "next": []
        }
      },
