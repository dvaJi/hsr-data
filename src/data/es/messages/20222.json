        },
        "202220019": {
          "id": 202220019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¡Últimos 10 segundos! Esta es la batalla decisiva para que Chispa vuelva a ser la streamer número uno. ¡Chispifans, no escatimen sus votos!",
