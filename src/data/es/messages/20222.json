          ]
        },
        "202220017": {
          "id": 202220017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¡Humanos, conejos, hongos y mecatrones bailan al unísono con sus pañuelos, creando un maravilloso baile que trasciende las especies!",
