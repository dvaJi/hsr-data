            202220008
          ]
        },
        "202220008": {
          "id": 202220008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¡Mecatrueno saca un pañuelo y lo agita a la velocidad de la luz!",
          "next": [
            202220009
