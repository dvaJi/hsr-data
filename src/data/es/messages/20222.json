        "202220001": {
          "id": 202220001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "El canal de Bailes Nonstop de Chispita que sigues está transmitiendo en vivo y el invitado especial para el duelo de hoy es... ¡Mecatrueno!",
          "next": [
            202220002
          ]
        },
        "202220002": {
          "id": 202220002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¿No tienes cobertura? ¡No hay problema! ¡Tu asistente te mantendrá al día con una transmisión en vivo por escrito!",
          "next": [
            202220003,
            202220004
          ]
        },
        "202220003": {
          "id": 202220003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Quién eres? ¿Quién le dio a seguir?",
