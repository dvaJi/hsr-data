            202220005
          ]
        },
        "202220004": {
          "id": 202220004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "(Pensé que le habían bloqueado la cuenta).",
          "next": [
            202220005
          ]
        },
        "202220005": {
          "id": 202220005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¡Tachán! Chispa ha llevado el ambiente de la pista de baile hasta su punto álgido, y con sus movimientos está mostrando a todo el mundo...",
          "next": [
            202220006
          ]
        },
        "202220006": {
          "id": 202220006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "¡Lo adorable que puede llegar a ser el ama de la arcadia!",
