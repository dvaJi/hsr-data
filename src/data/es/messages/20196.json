        },
        "201960005": {
          "id": 201960005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Cuánto tiempo sin verte, Mideimos!",
          "next": [
            201960006
          ]
        },
        "201960006": {
          "id": 201960006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "¡Cuánto tiempo sin verte, {NICKNAME}!",
          "next": [
            201960007
          ]
        },
        "201960007": {
          "id": 201960007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "No he tenido mucho tiempo para ejercitarme últimamente. Es hora de incluirlo en mi agenda.",
          "next": [
            201960008
          ]
        },
        "201960008": {
          "id": 201960008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Lo he estado pensando. Si todavía te interesa, podemos adaptar el entrenamiento a las circunstancias.",
          "next": [
            201960009
          ]
        },
        "201960009": {
          "id": 201960009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Basado en lo que sé de ti, he actualizado un plan de entrenamiento personalizado.",
          "next": [
            201960010
          ]
        },
        "201960010": {
          "id": 201960010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "He practicado todos los ejercicios. Son de dificultad moderada y fáciles de aprender.",
          "next": [
            201960011
          ]
        },
        "201960011": {
          "id": 201960011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ejercicio de calentamiento: perseguir a las quimeras. Ayuda a ejercitar los músculos y mantiene el buen humor.",
          "next": [
            201960012
          ]
        },
        "201960012": {
          "id": 201960012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Entrenamiento de hombros y brazos: puedes buscar a algunos niños de Kremnos y levantar tres con una mano, o incluso cinco. Son muy profesionales.",
          "next": [
            201960013
          ]
        },
        "201960013": {
          "id": 201960013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Entrenamiento de piernas: levantar dromas. Asegúrate de elegir uno que se enfade con facilidad para que sea más desafiante.",
          "next": [
            201960014,
            201960016,
            201960019
          ]
        },
        "201960014": {
          "id": 201960014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eso es muy típico de ti, ¡el rey de los niños de Kremnos!",
          "next": [
            201960015
          ]
        },
        "201960015": {
          "id": 201960015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Los niños están ansiosos por jugar contigo.",
          "next": [
            201960021
          ]
        },
        "201960016": {
          "id": 201960016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Leí bien? ¿Levantar qué?",
          "next": [
            201960017
          ]
        },
        "201960017": {
          "id": 201960017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Dromas.",
          "next": [
            201960018
          ]
        },
        "201960018": {
          "id": 201960018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Creo que lo escribí bien.",
          "next": [
            201960021
          ]
        },
        "201960019": {
          "id": 201960019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pan comido. Lo haré todos los días.",
          "next": [
            201960020
          ]
        },
        "201960020": {
          "id": 201960020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Sabía que no me equivocaba sobre ti.",
          "next": [
            201960021
          ]
        },
        "201960021": {
          "id": 201960021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Si quieres más diversión, tengo otros proyectos para recomendarte.",
          "next": [
            201960022
          ]
        },
        "201960022": {
          "id": 201960022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Por ejemplo, luchas o competencias de fuerza.",
          "next": [
            201960023
          ]
        },
        "201960023": {
          "id": 201960023,
