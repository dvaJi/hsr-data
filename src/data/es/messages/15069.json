      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Hola, protagonista.",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Si recibes este mensaje programado, significa que seguramente ha surgido otro imprevisto en mi plan por enésima vez.",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Por supuesto, tampoco puede descartarse que el Estelaron ya te haya volado por los aires y que, en este preciso momento, quien esté viendo este mensaje sea mi yo del futuro.",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Pero supongo que tu teléfono no es de tan buena calidad.",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Asat Pramad? ¿Otra vez tú?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu plan fracasó, ¡te derrotamos!",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "El número al que intenta contactar no existe. Error en el envío del mensaje.",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "A decir verdad, no me opongo a este desarrollo de la trama.",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Al contrario, espero con ansias su victoria.",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Tal vez esto demuestre que me equivoco.",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "La condición es que puedan superar este juego.",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Gane quien gane, despertará y nos tragará de un bocado.",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sé que no puedes recibir mensajes, pero... ¿por qué lo hiciste?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Seguro que puedes adivinar lo que quiero preguntar.",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "El número al que intenta contactar no existe. Error en el envío del mensaje.",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ay... ¿por qué lo hiciste?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ya que Aha se esconde entre bastidores e ignora la podredumbre del mundo, actuaré en su lugar y desafiaré al universo.",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Y ahora, el nuevo desafío se llama: derrotar a la Voracidad revivida.",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "¿Habrá {F#una heroína}{M#un héroe} nacid{F#a}{M#o} de la Destrucción que, tras superar el desafío, devuelve la verdadera Exultación al mundo?",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "¿O la bestia cumplirá su venganza, para que la Exultación afronte un final digno antes de sucumbir a la locura?",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Protagonista, ¿puedes escribir un final mejor para este chiste?",
          "next": []
        }
