      "messages": {
        "202470000": {
          "id": 202470000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Se ha detectado una señal SOS de posible naufragio: Tras detectar peligro, Aventurino llamó a los servicios de emergencia desde esta ubicación aproximada. Eres el contacto de emergencia en su agenda más cercano en este momento. Por eso recibes este mensaje.",
          "next": [
            202470001
          ]
        },
        "202470001": {
          "id": 202470001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: Se ha compartido la ubicación actual de Aventurino.",
          "next": [
            202470002
          ]
        },
        "202470002": {
          "id": 202470002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: La frecuencia cardíaca actual de Aventurino se acerca a 20. ¡Pide ayuda de inmediato!",
          "next": [
            202470003,
            202470004,
            202470005
          ]
        },
        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Este ritmo cardíaco no es normal! ¡No me asustes, Aventurino! ¡Aguanta, ya voy!",
          "next": [
            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Este ritmo cardíaco no es normal! ¡Aventurino! ¡Ya voy a salvarte!",
          "next": [
            202470006
          ]
        },
        "202470005": {
          "id": 202470005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Este ritmo cardíaco no es normal! ¡¿Dónde está la Corporación?! ¡¿Y la Conservación?! ¡Señor del Ámbar! ¡¿Y Gaiathra?! ¡Ayuda!",
          "next": [
            202470006
          ]
        },
        "202470006": {
          "id": 202470006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: La ubicación actual de Aventurino ha cambiado.",
          "next": [
            202470007
          ]
        },
        "202470007": {
          "id": 202470007,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: Se ha detectado que Aventurino está experimentando una caída brusca de altitud y una presión de agua extrema.",
          "next": [
            202470008
          ]
        },
        "202470008": {
          "id": 202470008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: La frecuencia cardíaca actual de Aventurino es de 180. ¡Pide ayuda de inmediato!",
          "next": [
            202470009
          ]
        },
        "202470009": {
          "id": 202470009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: La ubicación actual de Aventurino ha cambiado.",
          "next": [
            202470010
          ]
        },
        "202470010": {
          "id": 202470010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergencia SOS: La frecuencia cardíaca actual de Aventurino es de 20. ¡Pide ayuda de inmediato!",
          "next": [
            202470011,
            202470013
          ]
        },
        "202470011": {
          "id": 202470011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Aún quieres que te salve? ¿Te salvo? ¿O no? ¿Te salvo?",
          "next": [
            202470012
          ]
        },
        "202470012": {
          "id": 202470012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¡Aventurino! ¡Di algo si sigues vivo!",
          "next": [
            202470015
          ]
        },
        "202470013": {
          "id": 202470013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "De 20 a 180. ¿Por qué siento que se parece a mi ritmo cardíaco?",
          "next": [
            202470014
          ]
        },
        "202470014": {
          "id": 202470014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Estás en una montaña rusa? ¡Da señales de vida!",
          "next": [
            202470015
          ]
        },
        "202470015": {
          "id": 202470015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202470016
          ]
        },
        "202470016": {
          "id": 202470016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¡Pío, pío, pío! ¡Calma! Es un malentendido, estoy bien. Estaba surfeando, deja que llegue a la orilla y te cuento.",
          "next": [
            202470017
          ]
        },
        "202470017": {
          "id": 202470017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202470018
          ]
        },
        "202470018": {
          "id": 202470018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202470019
          ]
        },
        "202470019": {
          "id": 202470019,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La ubicación aproximada de Aventurino ha cambiado.",
          "next": [
            202470020
          ]
        },
        "202470020": {
          "id": 202470020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "En camino.",
          "next": [
            202470021
          ]
        },
        "202470021": {
          "id": 202470021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¿Desde cuándo este reloj se preocupa tanto? No es más que una ola gigante de cincuenta metros.",
          "next": [
            202470022,
            202470023
          ]
        },
        "202470022": {
          "id": 202470022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Cincuenta metros ya es nivel de alerta por desastre marítimo! ¡Tu ritmo cardíaco ha pasado de 20 a 180 en un momento!",
          "next": [
            202470024
          ]
        },
        "202470023": {
          "id": 202470023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡¿El ritmo cardíaco al surfear puede pasar de 20 a 180?!",
          "next": [
            202470024
          ]
        },
        "202470024": {
          "id": 202470024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¿Todo esto me delató?",
          "next": [
            202470025
          ]
        },
        "202470025": {
          "id": 202470025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "No pasa nada. Cuando llegó a 20 seguramente estaba tocando el fondo de la ola, aguantando la respiración.",
          "next": [
            202470026
          ]
        },
        "202470026": {
          "id": 202470026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Incluso si se dispara a 180, no será tan alto como en aquella noche en vela en la que me enfrenté a ti en Colonipenal.",
          "next": [
            202470027
          ]
        },
        "202470027": {
          "id": 202470027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ja, ja, fuera de bromas, siento mucho haberte preocupado hace un momento.",
          "next": [
            202470028
          ]
        },
        "202470028": {
          "id": 202470028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Estoy probando un ala de surf flotante de última generación.",
          "next": [
            202470029
          ]
        },
        "202470029": {
          "id": 202470029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "La sensación de ingravidez al caer en picada desde la cresta de una ola gigante es realmente adictiva.",
          "next": [
            202470030
          ]
        },
        "202470030": {
          "id": 202470030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La otra persona está escribiendo...",
          "next": [
            202470031
          ]
        },
        "202470031": {
          "id": 202470031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¡Qué suerte! ¡Ahí viene otra ola!",
          "next": [
            202470032
          ]
        },
        "202470032": {
          "id": 202470032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Voy por ella.",
          "next": [
            202470033
          ]
        },
        "202470033": {
          "id": 202470033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "¡La próxima vez te llevaré conmigo para que lo pruebes!",
          "next": [
            202470034
          ]
        },
