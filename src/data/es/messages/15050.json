  "sections": [
    {
      "id": 1505001,
      "startingMessageId": [
        150500101
      ],
      "messages": {
        "150500101": {
          "id": 150500101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Mi viej{F#a}{M#o} amig{F#a}{M#o}, ¿todavía tienes suficiente dinero?",
          "next": [
            150500102
          ]
        },
        "150500102": {
          "id": 150500102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Si no te alcanza, tendrás que gastar tu propio dinero.",
          "next": [
            150500103
          ]
        },
        "150500103": {
          "id": 150500103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Empecemos por la primera buena noticia.",
          "next": [
            150500104
          ]
        },
        "150500104": {
          "id": 150500104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Ayer, tras finalizar el desafío del gran despilfarro, llamamos a Tacañín y revisamos todos los ingresos y gastos.",
          "next": [
            150500105
          ]
        },
        "150500105": {
          "id": 150500105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Aunque algunos gastos son bastante extraños, creemos que no ha infringido las reglas.",
          "next": [
            150500106,
            150500108
          ]
        },
        "150500106": {
          "id": 150500106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Qué clase de buena noticia es esa? Yo siempre sigo las reglas básicas cuando gasto dinero.",
          "next": [
            150500107
          ]
        },
        "150500107": {
          "id": 150500107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Es que no quiero que rompas las reglas y pierdas el desafío.",
          "next": [
            150500110
          ]
        },
        "150500108": {
          "id": 150500108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"La primera buena noticia\", ¿significa que hay una segunda?",
          "next": [
            150500109
          ]
        },
        "150500109": {
          "id": 150500109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Lo siento. Queremos la reacción más auténtica, así que por ahora solo podemos revelar esto.",
          "next": [
            150500110
          ]
        },
        "150500110": {
          "id": 150500110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Ya te envié la dirección. Ven a buscarme a la Torre Guía y terminemos de grabar el recuento final del desafío del gran despilfarro.",
          "next": [
            150500111,
            150500112
          ]
        },
        "150500111": {
          "id": 150500111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ya voy. Acabo de salir, estoy en camino.",
          "next": [
            150500113
          ]
        },
        "150500112": {
          "id": 150500112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Espérame, todavía voy a tardar un buen rato.",
          "next": [
            150500113
          ]
        },
        "150500113": {
          "id": 150500113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "No hay prisa. Por cierto, Aventurino también está en camino.",
          "next": [
            150500114
          ]
        },
        "150500114": {
          "id": 150500114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Esperaré a que lleguen para finalizar el desafío juntos.",
          "next": []
        }
      },
      "participatingContactsIds": [
        224,
        8001
      ]
    }
  ]
}