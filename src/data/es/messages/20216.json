            202160012
          ]
        },
        "202160012": {
          "id": 202160012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Vaya, el ambiente se ha puesto un poco triste...",
          "next": [
            202160013
          ]
        },
        "202160013": {
          "id": 202160013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "¡Entonces mira al cielo y sonríe!",
          "next": [
            202160014
          ]
        },
        "202160014": {
          "id": 202160014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Dondequiera que vayas, las estrellas de Amphoreus brillarán para ti, ¡como si yo te estuviera guiñando el ojo!",
