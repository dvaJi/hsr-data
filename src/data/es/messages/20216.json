            202160005
          ]
        },
        "202160005": {
          "id": 202160005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Je, je, \"Cirene, Caballera de la Belleza\", ¿no te parece genial?",
