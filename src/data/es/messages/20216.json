            202160006
          ]
        },
        "202160006": {
          "id": 202160006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Pensándolo bien, ¿no sería perfecta como \"Cazadora de Corazones\"? O tal vez... ¿una Anónima?",
          "next": [
            202160007
          ]
        },
        "202160007": {
          "id": 202160007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Pero, esos deseos son demasiado extravagantes.",
          "next": [
            202160008
          ]
        },
        "202160008": {
          "id": 202160008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "♪ Tengo una estrella que nadie ha tenido jamás, ¿verdad? ♪",
          "next": [
            202160009
          ]
        },
        "202160009": {
          "id": 202160009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Mientras la mire con ternura, la luz iluminará mis ojos.",
          "next": [
            202160010
          ]
        },
        "202160010": {
          "id": 202160010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Quizás este sea mi mayor deseo.",
