            202160011
          ]
        },
        "202160011": {
          "id": 202160011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, debes seguir brillando en el largo camino que tienes por delante, ¿de acuerdo?",
