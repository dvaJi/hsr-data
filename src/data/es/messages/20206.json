            202060009
          ]
        },
        "202060009": {
          "id": 202060009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aglaea y Tribbie tienen sus propias áreas de especialización.",
          "next": [
            202060010
          ]
        },
        "202060010": {
          "id": 202060010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "¡Me dieron ganas de experimentar diferentes profesiones, aprender nuevas habilidades y descubrir otros pasatiempos!",
          "next": [
            202060011
          ]
        },
        "202060011": {
          "id": 202060011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Así que he trabajado como cocinero, cerrajero, actor de casa embrujada, modelo de atuendos, jinete de dromas, subastador...",
          "next": [
            202060012
          ]
        },
        "202060012": {
          "id": 202060012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Pero siento que ninguno es de mi agrado...",
          "next": [
            202060013
          ]
        },
        "202060013": {
          "id": 202060013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "¿Tienes alguna otra recomendación?",
