        },
        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Humm... por fin tengo algo de tiempo libre, pero no puedo quedarme de brazos cruzados, así que estoy buscando qué hacer.",
