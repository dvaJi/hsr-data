        "202240002": {
          "id": 202240002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Así que tú también...",
          "next": [
            202240004
          ]
        },
        "202240003": {
          "id": 202240003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡¿Cuántas cuentas alternativas tienes?!",
          "next": [
            202240004
          ]
        },
        "202240004": {
          "id": 202240004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "Cuando vi que la diferencia de popularidad entre Chispa y el segundo clasificado era de solo 9 999 700 puntos, lo entendí...",
          "next": [
            202240005
          ]
        },
        "202240005": {
          "id": 202240005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "Hay que tener un negocio honesto y estable.",
          "next": [
            202240006
          ]
        },
        "202240006": {
          "id": 202240006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "Así que permíteme presentarte mi nueva identidad: ¡encargada de Hongos Asados Chispa!",
          "next": [
            202240007
          ]
        },
        "202240007": {
          "id": 202240007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "¡Ven a probar nuestras brochetas! Utilizamos un sistema de reservas limitadas con directos semanales y una estrategia de marketing interactivo con preparación en vivo.",
          "next": [
            202240008,
            202240010
          ]
        },
        "202240008": {
          "id": 202240008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dado que ya tienes antecedentes... ¿Qué tipo de hongos son? ¿No tendrán virus?",
          "next": [
            202240009
          ]
        },
        "202240009": {
          "id": 202240009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "¡No te preocupes! ¡Es un hongo superdelicioso que a los chispiñones les encanta!",
          "next": [
            202240012
          ]
        },
        "202240010": {
          "id": 202240010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Suena a un negocio lucrativo y legítimo, déjame ser {F#socia}{M#socio}.",
          "next": [
            202240011
          ]
        },
        "202240011": {
          "id": 202240011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 216,
          "text": "¡Por supuesto! ¡Es una fuente de suministro super-superrentable, las ganancias están garantizadas!",
          "next": [
            202240012
          ]
        },
        "202240012": {
          "id": 202240012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
