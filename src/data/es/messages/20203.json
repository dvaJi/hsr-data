        },
        "202030008": {
          "id": 202030008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¡Fue Ica! ¡Corrió frente a la piedra fotográfica! Ya la estoy sujetando.",
          "next": [
            202030009
          ]
        },
        "202030009": {
          "id": 202030009,
          "type": "Image",
