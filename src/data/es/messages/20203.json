        },
        "202030021": {
          "id": 202030021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Y puedes registrarlo con tus propios ojos, así no te perderás de ningún pájaro o paisaje.",
