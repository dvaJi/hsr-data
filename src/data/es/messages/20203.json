          ]
        },
        "202030010": {
          "id": 202030010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "¡Ay, el pajarito se fue volando! ¡Casi logro capturarlo en una foto!",
          "next": [
            202030011
          ]
        },
        "202030011": {
          "id": 202030011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Sus plumas son de un azul intenso, ¡de lejos parece que brillara! Es realmente hermoso.",
          "next": [
            202030012
          ]
        },
        "202030012": {
          "id": 202030012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Cuando pasó rozando la superficie del agua, fue como un relámpago suave. Las gotas de agua que levantó parecían estrellas.",
          "next": [
            202030013
          ]
        },
        "202030013": {
          "id": 202030013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Qué lástima que no pueda enseñártelo.",
          "next": [
            202030014,
            202030016,
            202030018
          ]
        },
        "202030014": {
          "id": 202030014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pero vi el cielo. También es hermoso.",
          "next": [
            202030015
          ]
        },
        "202030015": {
          "id": 202030015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Tan amable como siempre, Cenici.",
          "next": [
            202030020
          ]
        },
        "202030016": {
          "id": 202030016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Puedo verlo. Tu descripción es bastante gráfica.",
          "next": [
            202030017
