        "150840102": {
          "id": 150840102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "¿Aún recuerdas las entradas para el torneo que te dejé antes?",
          "next": [
            150840103
          ]
        },
        "150840103": {
          "id": 150840103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Al principio esperaba que pudieras disfrutar de la actuación, pero nunca imaginé que te convertirías en parte de ella.",
          "next": [
            150840104,
            150840105
          ]
        },
        "150840104": {
          "id": 150840104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es una pena no haber podido ver la actuación. ¿Podré conseguir entradas para la próxima?",
          "next": [
            150840106
          ]
        },
        "150840105": {
          "id": 150840105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A decir verdad, desde que volví he estado buscando el video de la presentación de apertura.",
          "next": [
            150840106
          ]
        },
        "150840106": {
          "id": 150840106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Después de todo, estabas dentro de un auto de carreras y escuchaste la nueva canción con esa pésima calidad de audio del equipo.",
          "next": [
            150840107
          ]
        },
        "150840107": {
          "id": 150840107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Me da un poco de vergüenza.",
          "next": [
            150840108
          ]
        },
        "150840108": {
          "id": 150840108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Así que...",
          "next": [
            150840109
          ]
        },
        "150840109": {
          "id": 150840109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Te reservé un lugar muy especial para que puedas disfrutar de mi actuación en vivo, ¿qué te parece?",
          "next": [
            150840110
          ]
        },
        "150840110": {
          "id": 150840110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Genial! ¿Y dónde se podrá ver?",
          "next": [
            150840111
          ]
        },
        "150840111": {
          "id": 150840111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tengo un proyecto de colaboración con Espectáculos para la Paz Interastral, cuyo objetivo es recrear la emoción de las presentaciones en vivo.",
          "next": [
            150840112
          ]
        },
        "150840112": {
          "id": 150840112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ahora cualquiera puede ver una y otra vez mi actuación en vivo en el escenario de la playa de Astrópolis.",
          "next": [
            150840113
          ]
        },
        "150840113": {
          "id": 150840113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Si te interesa, ve al quiosco de la playa de Astrópolis y busca a una cantinera llamada Rocca.",
          "next": [
            150840114
          ]
        },
        "150840114": {
          "id": 150840114,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1309,
          "image": "PhoneMessagePic_15501",
          "next": [
            150840115
          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ya les avisé con antelación.",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Serás {F#la primera espectadora}{M#el primer espectador} de esta presentación especial.",
          "next": [
            150840117,
            150840118
          ]
        },
        "150840117": {
          "id": 150840117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ya no puedo esperar.",
          "next": [
            150840119
          ]
        },
        "150840118": {
          "id": 150840118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Iré en cuanto termine.",
