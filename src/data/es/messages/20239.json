  ],
  "sections": [
    {
      "id": 2023900,
      "startingMessageId": [
        202390000
      ],
      "messages": {
        "202390000": {
          "id": 202390000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Mi tesoro...",
          "next": [
            202390001
          ]
        },
        "202390001": {
          "id": 202390001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "He tomado una decisión, ¡hoy será el día de la destrucción de Planarcadia!",
          "next": [
            202390002
          ]
        },
        "202390002": {
          "id": 202390002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡Si quieren regresar a Uruk conmigo, vayan de inmediato a la plaza de Bidimensia!",
          "next": [
            202390003
          ]
        },
        "202390003": {
          "id": 202390003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Vimana, mi nave, solo estará detenida cinco minutos, ¡no esperaré a quien llegue tarde!",
          "next": [
            202390004,
            202390006,
            202390007
          ]
        },
        "202390004": {
          "id": 202390004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿¿¿Acaso me han preguntado mi opinión???",
          "next": [
            202390005
          ]
        },
        "202390005": {
          "id": 202390005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡Por supuesto que no! ¿Acaso no te estoy preguntando ahora mismo?",
          "next": [
            202390009
          ]
        },
        "202390006": {
          "id": 202390006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿¿¿Qué???",
          "next": [
            202390009
          ]
        },
        "202390007": {
          "id": 202390007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿¿¿??? Tantos signos de exclamación me molestan.",
          "next": [
            202390008
          ]
        },
        "202390008": {
          "id": 202390008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡Por supuesto! ¡La voz de un rey debe resonar como una campana!",
          "next": [
            202390009
          ]
        },
        "202390009": {
          "id": 202390009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Permíteme hacerte saber la razón de mi ira: la calle culinaria Gil ha estado desierta desde su inauguración.",
          "next": [
            202390010
          ]
        },
        "202390010": {
          "id": 202390010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡Helado de pan de oro! ¡Ensalada de atún con pan de oro! ¡Filete de serpiente de Vonwacq con pan de oro! ¡Bestia del Juicio Final entera a la parrilla con pan de oro!",
          "next": [
            202390011
          ]
        },
        "202390011": {
          "id": 202390011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Todos son platos de primera categoría que yo mismo seleccioné con mi exquisito gusto... ¡Pero esos locales ni siquiera se han dignado a mirarlos!",
          "next": [
            202390012
          ]
        },
        "202390012": {
          "id": 202390012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Basta, no hace falta esperar cinco minutos más. ¡Voy a dictar mi sentencia ahora mismo!",
          "next": [
            202390013,
            202390015
          ]
        },
        "202390013": {
          "id": 202390013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Calma tu ira, majestad. Son ellos los que no saben apreciarlo.",
          "next": [
            202390014
          ]
        },
        "202390014": {
          "id": 202390014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Hum, es inconcebible que en estas tierras solo tú reconozcas el honor que me corresponde.",
          "next": [
            202390017
          ]
        },
        "202390015": {
          "id": 202390015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "El helado con pan de oro puedo entenderlo, pero ¿qué son los otros platos?",
          "next": [
            202390016
          ]
        },
        "202390016": {
          "id": 202390016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¿Tú tampoco sabes apreciarlos? Este cosmos no tiene remedio.",
          "next": [
            202390017
          ]
        },
        "202390017": {
          "id": 202390017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Hum, a estas alturas, hasta destruir estas tierras con mis propias manos parece innecesario.",
          "next": [
            202390018
          ]
        },
        "202390018": {
          "id": 202390018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Supongo que no me queda más que perdonarlos. Si solo comen sobras a diario, es comprensible que no puedan apreciar el refinado gusto de un rey.",
          "next": [
            202390019
          ]
        },
        "202390019": {
          "id": 202390019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡Ya puedes retirarte! Seguiré trabajando en desarrollar una FelizAlma de pan de oro.",
          "next": [
            202390020
          ]
        },
        "202390020": {
          "id": 202390020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "¡En menos de tres días, haré que esta arcadia se postre ante mí por voluntad propia!",
          "next": [
            202390021
          ]
        },
        "202390021": {
          "id": 202390021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "El usuario no se encuentra en el área de servicio. Inténtalo más tarde.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1509,
        8001
      ]
    }
  ]
}