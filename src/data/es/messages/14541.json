        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "¿Qué te pareció la observación?",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un escenario impredecible para las creaciones. Es muy interesante.",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ahí radica la magia de la selección natural.",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "En un entorno en constante cambio, no existe una \"solución óptima para la vida\".",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No son más que bichejos corriendo de un lado a otro. Los tengo más que vistos.",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ya veo.",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Al menos, fuiste testigo de cómo la vida explora y toma decisiones en un entorno desconocido.",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Quizás el destino final no tenga sentido, pero es evidente que no se conforman con eso.",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Lo hiciste muy bien.",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Te he guardado algunas recompensas, puedes recogerlas cuando quieras.",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "El trabajo merece ser recompensado, es mi derecho legítimo.",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gracias, me lo llevaré todo.",
