      "messages": {
        "202070000": {
          "id": 202070000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "¡Compañer{F#a}{M#o}! ¿Recuerdas nuestra promesa?",
          "next": [
            202070001
          ]
        },
        "202070001": {
          "id": 202070001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Sobre el final de «La leyenda de las estrellas».",
          "next": [
            202070002,
            202070004,
            202070005
          ]
        },
        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Claro que sí, pero te sugiero que lo leas tú mismo.",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Es muy interesante, no quiero arruinarte la sorpresa.",
          "next": [
            202070006
          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Por qué no lo lees tú mismo? Es muy interesante, no quiero arruinarte la sorpresa.",
          "next": [
            202070006
          ]
        },
        "202070005": {
          "id": 202070005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aún no lo he leído.",
          "next": [
            202070006
          ]
        },
        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je, je, la verdad es que no pude resistirme y hace poco lo leí a escondidas.",
          "next": [
            202070007
          ]
        },
        "202070007": {
          "id": 202070007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Los héroes atraviesan el espacio-tiempo y se unen para derrotar al último monstruo, pero su poder los teletransporta a un mundo diferente, donde tienen que empezar de cero.",
          "next": [
            202070008
          ]
        },
        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "¡Me encantaría saber qué pasó después, pero ahí termina la historia!",
          "next": [
            202070009
          ]
        },
        "202070009": {
          "id": 202070009,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070010,
            202070012,
            202070014
          ]
        },
        "202070010": {
          "id": 202070010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡No puede ser!",
          "next": [
            202070011
          ]
        },
        "202070011": {
          "id": 202070011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Increíble, ¿cierto?",
          "next": [
            202070016
          ]
        },
        "202070012": {
          "id": 202070012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bien, ¡entonces tú escribe el resto!",
          "next": [
            202070013
          ]
        },
        "202070013": {
          "id": 202070013,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070016
          ]
        },
        "202070014": {
          "id": 202070014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dejar espacio para la imaginación del lector es una técnica literaria.",
          "next": [
            202070015
          ]
        },
        "202070015": {
          "id": 202070015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "¡Bueno, realmente lo logró!",
          "next": [
            202070016
          ]
        },
        "202070016": {
          "id": 202070016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Pero también es una motivación para abrir el siguiente libro.",
          "next": [
            202070017
          ]
        },
        "202070017": {
          "id": 202070017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Compañer{F#a}{M#o}, ¿has visto algo interesante últimamente? Me he quedado sin libros para leer.",
          "next": [
            202070018,
            202070021,
            202070023
          ]
        },
        "202070018": {
          "id": 202070018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Te recomiendo las novelas de misterio que Marzo escribió hace un tiempo.",
          "next": [
            202070019
          ]
        },
        "202070019": {
          "id": 202070019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nunca adivinarás quién es el asesino, ni cuántos son.",
          "next": [
            202070020
          ]
        },
        "202070020": {
          "id": 202070020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Después te envío el enlace.",
          "next": [
            202070025
          ]
        },
        "202070021": {
          "id": 202070021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Te recomiendo los fanfics de Castorice.",
          "next": [
            202070022
          ]
        },
        "202070022": {
          "id": 202070022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Cada uno tiene un estilo único. Siempre habrá uno que te sorprenda.",
          "next": [
            202070025
          ]
        },
        "202070023": {
          "id": 202070023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hay muchas obras extraordinarias en la literatura de Amphoreus.",
          "next": [
            202070024
          ]
        },
        "202070024": {
          "id": 202070024,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Voy a repasar mi colección para hacerte una lista.",
