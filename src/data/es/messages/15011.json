  "sections": [
    {
      "id": 1501101,
      "startingMessageId": [
        150110100
      ],
      "messages": {
        "150110100": {
          "id": 150110100,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Estás ocupada? Necesito pedirte un favor.",
          "next": [
            150110101
          ]
        },
        "150110101": {
          "id": 150110101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡Espera un momentito! No te muevas de ahí, llegaré enseguida.",
          "next": [
            150110102,
            150110104
          ]
        },
        "150110102": {
          "id": 150110102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Pero si aún no he dicho qué necesito! ¿Siempre eres tan impulsiva?",
          "next": [
            150110103
          ]
        },
        "150110103": {
          "id": 150110103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Ji, ji, ¡ser la número uno en esta industria tan cruel solo se consigue con mucha iniciativa!",
          "next": [
            150110106
          ]
        },
        "150110104": {
          "id": 150110104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Por qué quieres que nos veamos en persona sin más? ¿Qué pretendes? ¿Acaso quieres vengarte de mí?",
          "next": [
            150110105
          ]
        },
        "150110105": {
          "id": 150110105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡¿Pero quién te crees que soy?! ¡Solo quiero ayudarte!",
          "next": [
            150110106
          ]
        },
        "150110106": {
          "id": 150110106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡Mis fans te vieron husmeando por la escena del crimen del que se encarga el Departamento de Defensa contra Aberrantes! Siempre metiéndote donde no te llaman, ¿eh?",
          "next": [
            150110107
          ]
        },
        "150110107": {
          "id": 150110107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¿Es el caso del Asesino del Milenio? A mí también me interesa mucho ese tipo.",
          "next": [
            150110108
          ]
        },
        "150110108": {
          "id": 150110108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡Ya hablaremos de los detalles cuando nos veamos! Ya casi estoy allí.",
          "next": [
            150110109
          ]
        },
        "150110109": {
          "id": 150110109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Está bien, te esperamos.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1501
      ]
    }
  ]
}