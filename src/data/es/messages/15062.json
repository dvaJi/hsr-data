            150620105
          ]
        },
        "150620105": {
          "id": 150620105,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Ahora qué estás tramando?",
          "next": [
            150620106
          ]
        },
        "150620106": {
          "id": 150620106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡No tengo nada que ver, lo juro!",
          "next": [
            150620107
          ]
        },
        "150620107": {
          "id": 150620107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Miren a la Corporación y a ustedes, los Anónimos, corriendo de un lado para otro a mil por hora, con esas caritas de tragedia intentando salvar el mundo.",
          "next": [
            150620108
          ]
        },
        "150620108": {
          "id": 150620108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Sampo y yo también queremos echar una mano.",
          "next": [
            150620109
          ]
        },
        "150620109": {
          "id": 150620109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¿Cómo iba la ídolo de todos, Chispita, a abandonar a sus fans?",
          "next": [
            150620110
          ]
        },
        "150620110": {
          "id": 150620110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡Justo porque es el fin del mundo, con más razón tenemos que ser superpositivos y optimistas!",
          "next": [
            150620111
          ]
        },
        "150620111": {
          "id": 150620111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "¡Fíjate bien, pelo gris, deja que te enseñe lo que es refugiarse de forma eficiente!",
          "next": []
        }
