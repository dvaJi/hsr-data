      "messages": {
        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "¡President{F#a}{M#e}! ¿Cómo has estado últimamente?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ah, lo siento, usé el teléfono del trabajo por costumbre.",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "¡Soy yo, Tranquipachi! Gigapachi es mi nombre artístico.",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Tengo buenas noticias, president{F#a}{M#e}.",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "¡Se ha aprobado el proyecto de mi película, una superproducción de superhéroes titulada «La melancolía de Gigapachi»!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Guau, felicidades! ¡Qué bueno que tus sueños se hagan realidad!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Aún es muy pronto para celebrar, recién ha empezado el rodaje.",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Genial!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Por cierto, ¿vas a volver a trabajar?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Tendremos que esperar a que termine la grabación de la película. Recién ha empezado el rodaje.",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Oh, el buabuabó me ha pedido que vaya a ayudar.",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "President{F#a}{M#e}, si tienes tiempo libre, ¡puedes venir al set cuando quieras!",
          "next": []
        }
      },
