        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "La Bestia del Juicio Final, Phantylia, Ferrotumba...",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Me pregunto cómo te sentiste durante esos \"amables\" encuentros con ellos.",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Fue divertido. Ni siquiera tuve que mover un dedo, solo tuve que mirarlos fijamente.",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Humm, una mirada que puede matar, sí.",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lamentablemente, no siento nada, no tengo emociones.",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Sí, eres imparcial e incorruptible.",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lo tomé un paso a la vez.",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Golpe tras golpe, y listo.",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Humm, por turnos...",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "La Destrucción no es un momento glorioso... pero su belleza es indiscutible.",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Seguirás por este camino, continuando trazando caminos.",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Hasta... acabar con la Destrucción, ¿verdad?",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Quieres unirte a nosotros? De todos modos, ya has traicionado a la Destrucción.",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Espero con ansias que llegue ese día.",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Sin embargo, si te sitúas en el lado opuesto a trazar caminos...",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Volverás a la Destrucción? ¿Cómo no se considera una traición cuando traicionas por segunda vez?",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Es una buena idea, me gusta...",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Si te opones a los trazacaminos...",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Podré caminar hacia los fuegos artificiales que encendiste.",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Entonces, como dice su guion.",
