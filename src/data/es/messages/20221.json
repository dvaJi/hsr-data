            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Convertirse en el Devastador que destruye la Reminiscencia tampoco es una mala elección.",
