      "messages": {
        "150720100": {
          "id": 150720100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Ya terminamos de ver la película.",
          "next": [
            150720101
          ]
        },
        "150720101": {
          "id": 150720101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Aprovechen para ir al baño o tomar fotos. Nos vemos en la entrada del cine.",
          "next": [
            150720102
          ]
        },
        "150720102": {
          "id": 150720102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "¡Esta película cuenta con un presupuesto enorme! ¡La calidad de la producción es impresionante!",
          "next": [
            150720103
          ]
        },
        "150720103": {
          "id": 150720103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Las historias emocionantes son las mejores.",
          "next": [
            150720104
          ]
        },
        "150720104": {
          "id": 150720104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Y tiene a un actor veterano como protagonista, Sacrobuabó.",
          "next": [
            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "¡Sí! Su interpretación de los problemas cotidianos de los superhéroes realmente me llega al corazón.",
          "next": [
            150720106
          ]
        },
        "150720106": {
          "id": 150720106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Por cierto, ¿alguien ha visto a Tranquipachi?",
          "next": [
            150720107
          ]
        },
        "150720107": {
          "id": 150720107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "¿Cómo puede desaparecer viendo una película?",
          "next": [
            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "Vi a Tranquipachi salir de la sala de proyección con lágrimas en los ojos y luego se fue corriendo hacia la agencia.",
          "next": [
            150720109
          ]
        },
        "150720109": {
          "id": 150720109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 229,
          "text": "Con las patitas a toda velocidad.",
          "next": [
            150720110
          ]
        },
        "150720110": {
          "id": 150720110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "¿Por qué tiene tanta prisa por volver al trabajo? ¡Tanto trabajo va a matarlo!",
          "next": []
        }
      },
