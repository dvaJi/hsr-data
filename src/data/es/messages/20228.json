  ],
  "sections": [
    {
      "id": 2022800,
      "startingMessageId": [
        202280000
      ],
      "messages": {
        "202280000": {
          "id": 202280000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hola, {NICKNAME}. Soy Narrador.",
          "next": [
            202280001
          ]
        },
        "202280001": {
          "id": 202280001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Quería preguntarte qué te gusta comer. ¿Podrías recomendarme algo?",
          "next": [
            202280002
          ]
        },
        "202280002": {
          "id": 202280002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Preferiblemente, alimentos nutritivos a un precio accesible.",
          "next": [
            202280003,
            202280006,
            202280009
          ]
        },
        "202280003": {
          "id": 202280003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "El arroz inflado saludable no tiene grasa ni aditivos. Es saludable, pero algo insípido.",
          "next": [
            202280004
          ]
        },
        "202280004": {
          "id": 202280004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Puedes probar aperitivos de otros mundos, como la salchicha de Belobog o las brochetas de Xianzhou... ¡Con entrega exprés interestelar al día siguiente!",
          "next": [
            202280005
          ]
        },
        "202280005": {
          "id": 202280005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Pero escuché que el envío no es gratis. Calcularé el coste de compra. Gracias por la recomendación.",
          "next": [
            202280011
          ]
        },
        "202280006": {
          "id": 202280006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No sé qué recomendarte... Lo que me gusta comer no es muy nutritivo.",
          "next": [
            202280007
          ]
        },
        "202280007": {
          "id": 202280007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Brochetas, estofados, Delicia Inmortal, hamburguesas aladas, pasteles...",
          "next": [
            202280008
          ]
        },
        "202280008": {
          "id": 202280008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Comparado con la dieta del Detective Inmortal, eso podría considerarse una dieta equilibrada.",
          "next": [
            202280011
          ]
        },
        "202280009": {
          "id": 202280009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Creía que solo te gustaban los plátanos.",
          "next": [
            202280010
          ]
        },
        "202280010": {
          "id": 202280010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "No es para mí, es para Ashveil.",
          "next": [
            202280011
          ]
        },
        "202280011": {
          "id": 202280011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Es un problema... Últimamente, Ashveil come plátanos conmigo en cada comida, probablemente para ahorrarse líos o dinero.",
          "next": [
            202280012
          ]
        },
        "202280012": {
          "id": 202280012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Pero si le faltan los nutrientes complejos que necesita un ser humano, su cerebro acabará aún más ralentizado.",
          "next": [
            202280013
          ]
        },
        "202280013": {
          "id": 202280013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Y olvidarse el teléfono varias veces es uno de los síntomas clínicos típicos de la desnutrición.",
          "next": [
            202280014
          ]
        },
        "202280014": {
          "id": 202280014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Así que tengo que reeducar sus hábitos alimenticios.",
          "next": [
            202280015,
            202280016
          ]
        },
        "202280015": {
          "id": 202280015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Cómo se hace eso? ¡Yo también quiero cuidar de mi salud!",
          "next": [
            202280018
          ]
        },
        "202280016": {
          "id": 202280016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Qué buen asistente!",
          "next": [
            202280017
          ]
        },
        "202280017": {
          "id": 202280017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Dado lo despreocupado que es, era de esperar que me encargara yo.",
          "next": [
            202280018
          ]
        },
        "202280018": {
          "id": 202280018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Los primeros días, machaqué sus plátanos hasta hacerlos puré y añadí otras frutas a escondidas.",
          "next": [
            202280019
          ]
        },
        "202280019": {
          "id": 202280019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Dio buen resultado. Su apetito es normal y no muestra rechazo evidente ni reacción de estrés.",
          "next": [
            202280020
          ]
        },
        "202280020": {
          "id": 202280020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "A continuación, planeo aumentar progresivamente la proporción de alimentos nuevos e incorporar comida caliente que guste a los humanos, mezclándolo todo de forma gradual.",
          "next": [
            202280021
          ]
        },
        "202280021": {
          "id": 202280021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Así protejo su estómago y reavivo su interés en otras comidas desde el punto de vista gustativo.",
          "next": [
            202280022
          ]
        },
        "202280022": {
          "id": 202280022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Un tratamiento dura como mínimo siete días. En resumen: un plan de transición en 7 días. ¡Muy científico!",
          "next": [
            202280023,
            202280024
          ]
        },
        "202280023": {
          "id": 202280023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡El plan de los 7 días, me lo apunto!",
          "next": [
            202280026
          ]
        },
        "202280024": {
          "id": 202280024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Parece que fueras su amo.",
          "next": [
            202280025
          ]
        },
        "202280025": {
          "id": 202280025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "La relación de detective y asistente entre nosotros no cambiará.",
          "next": [
            202280026
          ]
        },
        "202280026": {
          "id": 202280026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Veamos, ayer fueron dos manzanas, un huevo, un cuenco de arroz glutinoso, una cucharada de plátano y tres latas de sal.",
          "next": [
            202280027
          ]
        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, ya está a punto de volver. Voy a preparar la torre de sal con manzana y plátano de hoy.",
          "next": [
            202280028
          ]
        },
        "202280028": {
          "id": 202280028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Adiós.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1504,
        8001
      ]
    }
  ]
}