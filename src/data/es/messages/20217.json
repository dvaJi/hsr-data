        },
        "202170003": {
          "id": 202170003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "♪ Otro hermoso día. Por supuesto, necesita estar adornado con flores. ♪",
          "next": [
            202170004
          ]
        },
        "202170004": {
          "id": 202170004,
