        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Por supuesto. Con esas caritas tan hermosas, ¿quién podría resistirse a comprarles ropa?",
