            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Las recomendaciones de Ruan Mei son siempre las mismas. Así que ponlas ahí también.",
