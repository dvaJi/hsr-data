        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Los que se ven de buen gusto obviamente son míos. Eso es fácil de reconocer. Hay que ordenarlos primero.",
