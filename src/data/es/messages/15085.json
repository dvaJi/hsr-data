  "sections": [
    {
      "id": 1508501,
      "startingMessageId": [
        150850100
      ],
      "messages": {
        "150850100": {
          "id": 150850100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¡Buenos días, buenas tardes o buenas noches! Otro día más con vida.",
          "next": [
            150850101
          ]
        },
        "150850101": {
          "id": 150850101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Nunca imaginé que también habría páginas arrancadas de las «Crónicas de la Grasa Flotante» en Astrópolis.",
          "next": [
            150850102,
            150850106,
            150850109
          ]
        },
        "150850102": {
          "id": 150850102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sí, no me lo esperaba.",
          "next": [
            150850103
          ]
        },
        "150850103": {
          "id": 150850103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Parece que cada vez hay más cosas para recolectar.",
          "next": [
            150850104
          ]
        },
        "150850104": {
          "id": 150850104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¡Ja, ja, ja, ja! ¡Eso también es algo bueno!",
          "next": [
            150850105
          ]
        },
        "150850105": {
          "id": 150850105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Gracias a Arita y a los demás, también tenemos cosas que hacer por aquí.",
          "next": [
            150850114
          ]
        },
        "150850106": {
          "id": 150850106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿No es un texto antiguo de Planarcadia?",
          "next": [
            150850107
          ]
        },
        "150850107": {
          "id": 150850107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Por qué apareció en Astrópolis?",
          "next": [
            150850108
          ]
        },
        "150850108": {
          "id": 150850108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¡Ja, ja, ja, ja! En realidad, habría que agradecerle a Arita y a los suyos.",
          "next": [
            150850114
          ]
        },
        "150850109": {
          "id": 150850109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "... ¿Me estás espiando?",
          "next": [
            150850110
          ]
        },
        "150850110": {
          "id": 150850110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Cómo es que este mensaje llegó en el momento perfecto?",
          "next": [
            150850111
          ]
        },
        "150850111": {
          "id": 150850111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¡Ay, eso es porque tengo el equipo de monitoreo de las «Crónicas de la Grasa Flotante»!",
          "next": [
            150850112
          ]
        },
        "150850112": {
          "id": 150850112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Supongo que eres la única persona que me ayudaría a recolectarlo.",
          "next": [
            150850113
          ]
        },
        "150850113": {
          "id": 150850113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "No puedo ir a preguntarle directamente a Arita, ¿o sí?",
          "next": [
            150850114
          ]
        },
        "150850114": {
          "id": 150850114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿A Arita?",
          "next": [
            150850115
          ]
        },
        "150850115": {
          "id": 150850115,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Qué tiene que ver esto con él?",
          "next": [
            150850116
          ]
        },
        "150850116": {
          "id": 150850116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "¿No dicen que un alto cargo creó un entorno en Astrópolis en el que los fabulae pueden sobrevivir?",
          "next": [
            150850117
          ]
        },
        "150850117": {
          "id": 150850117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Poco después empezaron a aparecer todo tipo de fabulae vinculados a Astrópolis.",
          "next": [
            150850118
          ]
        },
        "150850118": {
          "id": 150850118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Entre ellos también hay un libro que nos interesa.",
          "next": [
            150850119
          ]
        },
        "150850119": {
          "id": 150850119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Además, escuché que Arita también se ha interesado por este libro.",
          "next": [
            150850120
          ]
        },
        "150850120": {
          "id": 150850120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "En fin, busquemos un momento para vernos.",
          "next": [
            150850121
          ]
        },
        "150850121": {
          "id": 150850121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ya que no es fácil venir a Astrópolis, nunca está de más aprovechar para ver a los conocidos.",
          "next": []
        }
      },
      "participatingContactsIds": [
        205,
        8001
      ]
    }
  ]
}