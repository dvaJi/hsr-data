      "messages": {
        "150700100": {
          "id": 150700100,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Cómo van las cosas por Astrópolis últimamente? Quería pedirte un favor.",
          "next": [
            150700101
          ]
        },
        "150700101": {
          "id": 150700101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ya casi terminé mi trabajo, así que estoy disfrutando de unas tranquilas vacaciones.",
          "next": [
            150700102
          ]
        },
        "150700102": {
          "id": 150700102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "¿Qué necesitas?",
          "next": [
            150700103
          ]
        },
        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "En Astrópolis hay una estrella de cine llamada Sacrobuabó, ¿te suena familiar?",
          "next": [
            150700104
          ]
        },
        "150700104": {
          "id": 150700104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Si no es molestia, me gustaría pedirte que nos presentes.",
          "next": [
            150700105
          ]
        },
        "150700105": {
          "id": 150700105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "¿Sacrobuabó? ¡Claro que sí!",
          "next": [
            150700106
          ]
        },
        "150700106": {
          "id": 150700106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mi representante estuvo negociando una colaboración comercial con la Productora Barajas, que consistía en prestar mi voz para su nuevo proyecto.",
          "next": [
            150700107
          ]
        },
        "150700107": {
          "id": 150700107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "¡Cuenta con mi ayuda! Espera un momento.",
          "next": [
            150700108
          ]
        },
        "150700108": {
          "id": 150700108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Qué buena suerte, Sacrobuabó está descansando en la Torre Guía esta tarde.",
          "next": [
            150700109
          ]
        },
        "150700109": {
          "id": 150700109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ya te agendé una cita, solo tienes que ir directamente a buscarlo.",
          "next": [
            150700110,
            150700111
          ]
        },
        "150700110": {
          "id": 150700110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Muchas gracias, me has ayudado un montón!",
          "next": []
        },
        "150700111": {
