        },
        "202490024": {
          "id": 202490024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Me descubriste.",
          "next": [
            202490025
          ]
        },
        "202490025": {
          "id": 202490025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
