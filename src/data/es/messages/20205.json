        },
        "202050004": {
          "id": 202050004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Necesitas ayuda para encontrar a tu gata?",
          "next": [
            202050009
          ]
        },
        "202050005": {
          "id": 202050005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Perdón, no la he visto.",
          "next": [
            202050006
          ]
        },
        "202050006": {
          "id": 202050006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Te ayudaré a encontrar a esa gata.",
          "next": [
            202050009
          ]
        },
        "202050007": {
          "id": 202050007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Tal vez en los baños?",
          "next": [
            202050008
          ]
        },
        "202050008": {
          "id": 202050008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "¿Necesitas ayuda para encontrar a tu gata?",
          "next": [
            202050009
          ]
        },
        "202050009": {
          "id": 202050009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Gracias, pero no te preocupes. Sé que no será nada fácil encontrarla.",
          "next": [
            202050010
          ]
        },
        "202050010": {
          "id": 202050010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Así que tenemos que encontrar una manera de hacer que regrese por su cuenta.",
          "next": [
            202050011
          ]
        },
        "202050011": {
          "id": 202050011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "¿Quieres venir a comer a mi casa más tarde, Grisit{F#a}{M#o}?",
          "next": [
            202050012
          ]
        },
        "202050012": {
          "id": 202050012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ejem, usaré la función de transcribir los mensajes de voz. Desde hace algún tiempo, Ciferia suele traer amigos a comer a casa. Una noche desapareció justo antes de la cena. Supuse que había ido a buscar a alguno de sus amigos, pero no sabía dónde encontrarla, ya que le gusta andar por todos lados. Así que se me ocurrió esta idea.",
          "next": [
            202050013
          ]
        },
        "202050013": {
          "id": 202050013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202050014
          ]
        },
        "202050014": {
          "id": 202050014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ya contacté a todos los amigos que figuran en su telelosa. Agli... Espera, déjame ver... Agli, Tribbie, el profesor Anaxa, el principito inmortal, la princesa ermitaña, el pastelito rosa, el salvador retirado, la emperatriz, el proveedor de pescaditos secos, Zag... y Grisit{F#a}{M#o}. Eres tú, ¿verdad? Qué buen nombre. Es fácil de recordar y tiene mucha personalidad.",
          "next": [
            202050015
          ]
        },
        "202050015": {
          "id": 202050015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202050016,
            202050017,
            202050019
          ]
        },
        "202050016": {
          "id": 202050016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Esos no son nuestros nombres reales.",
          "next": [
            202050020
          ]
        },
        "202050017": {
          "id": 202050017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Hay suficiente espacio en la mesa? Puedo llevar una mesa más larga.",
          "next": [
            202050018
          ]
        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hay espacio suficiente. La mesa es grande y hay bastante comida.",
          "next": [
            202050020
          ]
        },
        "202050019": {
          "id": 202050019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¡Una gran comida! ¡Preparemos bollos!",
          "next": [
            202050020
          ]
        },
        "202050020": {
          "id": 202050020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "¡Ay, los niños ya están aquí! ¡No corran! Ya llegaron, iré a acomodarlos. Ay. Te esperamos. Ciferia estará muy feliz.",
          "next": [
            202050021
          ]
        },
        "202050021": {
          "id": 202050021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Mensaje de voz convertido en texto.",
          "next": [
            202050022
          ]
        },
        "202050022": {
          "id": 202050022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "¡Je, je! ¡Ya volví!",
          "next": [
            202050023
          ]
        },
        "202050023": {
          "id": 202050023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Grisit{F#a}{M#o}, ven a comer.",
          "next": [
            202050024
          ]
        },
        "202050024": {
          "id": 202050024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "O mi abuela volverá a usar mi telelosa para enviar mensajes a todo el mundo.",
          "next": [
            202050025
          ]
        },
        "202050025": {
          "id": 202050025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "¡Te espero!",
