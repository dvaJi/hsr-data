          "text": "@{NICKNAME} @Siete de Marzo, ¿están bien?",
          "next": [
            150040103
          ]
        },
        "150040103": {
          "id": 150040103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Me informaron de que tuvieron algún problema.",
          "next": [
            150040104
          ]
        },
        "150040104": {
          "id": 150040104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "¿Qué ocurre?",
          "next": [
            150040105
          ]
        },
        "150040105": {
          "id": 150040105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Estamos bien, pero mientras estábamos de compras nos encontramos con una tal Chispa.",
          "next": [
            150040106
          ]
        },
        "150040106": {
          "id": 150040106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Dijo que iba a acabar con {NICKNAME} y conmigo, y que excluiría a la tripulación del Expreso Astral de los Juegos Fabuluna.",
          "next": [
            150040107
          ]
        },
        "150040107": {
          "id": 150040107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "¡Tenemos que actuar rápido!",
          "next": [
            150040108
          ]
        },
        "150040108": {
          "id": 150040108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Entonces, ¿han tomado una decisión?",
          "next": [
            150040109
          ]
        },
        "150040109": {
          "id": 150040109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tengo algunas ideas, aunque no sé qué pensará {NICKNAME}.",
          "next": [
            150040110
          ]
        },
        "150040110": {
          "id": 150040110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Pues yo quiero participar en los Juegos Fabuluna.",
          "next": [
            150040111
          ]
        },
        "150040111": {
          "id": 150040111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "He esta pensando qué podría hacer con ese poder si ganara, o qué podría pedirle a Aha que hiciera por mí.",
          "next": [
            150040112
          ]
        },
        "150040112": {
          "id": 150040112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Cuando tenga tiempo, les contaré todo con más detalle.",
          "next": [
            150040113
          ]
        },
        "150040113": {
          "id": 150040113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "¿Cómo va todo por tu lado? @Dan Heng",
          "next": [
            150040114
          ]
        },
        "150040114": {
          "id": 150040114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Me comuniqué con la emisaria de Xianzhou, pero ellos también tienen problemas y necesitan ayuda.",
          "next": [
            150040115
          ]
        },
        "150040115": {
          "id": 150040115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sunday y yo estamos en camino.",
          "next": [
            150040116
          ]
        },
        "150040116": {
          "id": 150040116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Contacten conmigo si necesitan algo.",
          "next": [
            150040117
          ]
        },
        "150040117": {
          "id": 150040117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bien, Himeko, ¿qué hacemos ahora?",
          "next": [
            150040118
          ]
        },
        "150040118": {
          "id": 150040118,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Quiero pedirles que vayan a la Escuela Grafía, mi alma máter.",
          "next": [
            150040119
          ]
        },
        "150040119": {
          "id": 150040119,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Ubicación de la Escuela Grafía]",
          "next": [
            150040120
          ]
        },
        "150040120": {
          "id": 150040120,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "En esa escuela hay una profesora llamada Nina.",
          "next": [
            150040121
          ]
        },
        "150040121": {
          "id": 150040121,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Es amiga mía y se encarga de custodiar la máscara necesaria para participar en los Juegos Fabuluna.",
          "next": [
            150040122
          ]
        },
        "150040122": {
          "id": 150040122,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Para evitar complicaciones, encuéntrenla y recuperen la máscara primero.",
          "next": [
            150040123
          ]
        },
        "150040123": {
          "id": 150040123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bien, ¡en marcha!",
          "next": [
            150040124
          ]
        },
        "150040124": {
          "id": 150040124,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Welt y yo nos reuniremos luego con ustedes.",
          "next": []
        }
