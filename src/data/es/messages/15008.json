      "messages": {
        "150080101": {
          "id": 150080101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} @Siete de Marzo, ¿Están bien?",
          "next": [
            150080102
          ]
        },
        "150080102": {
          "id": 150080102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Me informaron de que tuvieron algún problema.",
          "next": [
            150080103
          ]
        },
        "150080103": {
          "id": 150080103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "¿Qué ocurre?",
          "next": [
            150080104
          ]
        },
        "150080104": {
          "id": 150080104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Estamos bien, pero mientras estábamos de compras nos encontramos con una tal Chispa.",
          "next": [
            150080105
          ]
        },
        "150080105": {
          "id": 150080105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Dijo que iba a acabar con {NICKNAME} y conmigo, y que excluiría a la tripulación del Expreso Astral de los Juegos Fabuluna.",
          "next": [
            150080106
          ]
        },
        "150080106": {
          "id": 150080106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "¡Tenemos que actuar rápido!",
          "next": [
            150080107
          ]
        },
        "150080107": {
          "id": 150080107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Entonces, ¿han tomado una decisión?",
          "next": [
            150080108
          ]
        },
        "150080108": {
          "id": 150080108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tengo algunas ideas, aunque no sé qué pensará {NICKNAME}.",
          "next": [
            150080109
          ]
        },
        "150080109": {
          "id": 150080109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Pues yo quiero participar en los Juegos Fabuluna.",
          "next": [
            150080110
          ]
        },
        "150080110": {
          "id": 150080110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Me preguntaba qué podría hacer con este poder si ganara, o qué podría pedirle a Aha que hiciera por mí.",
          "next": [
            150080111
          ]
        },
        "150080111": {
          "id": 150080111,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Cuando tenga tiempo, les contaré todo con más detalle.",
          "next": [
            150080112
          ]
        },
        "150080112": {
          "id": 150080112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "¿Cómo va todo por tu lado? @Dan Heng",
          "next": [
            150080113
          ]
        },
        "150080113": {
          "id": 150080113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Me comuniqué con el emisario de Xianzhou, pero ellos también tienen problemas y necesitan ayuda.",
          "next": [
            150080114
          ]
        },
        "150080114": {
          "id": 150080114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sunday y yo estamos en camino.",
          "next": [
            150080115
          ]
        },
        "150080115": {
          "id": 150080115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "No dudes en contactarme si necesitan algo.",
          "next": [
            150080116
          ]
        },
        "150080116": {
          "id": 150080116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bien, Himeko, ¿qué hacemos ahora?",
          "next": [
            150080117
          ]
        },
        "150080117": {
          "id": 150080117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Quiero pedirles que vayan a la Escuela Grafía, mi alma máter.",
          "next": [
            150080118
          ]
        },
        "150080118": {
          "id": 150080118,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Ubicación de la Escuela Grafía]",
          "next": [
            150080119
          ]
        },
        "150080119": {
          "id": 150080119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "En esa escuela hay una profesora llamada Nina.",
          "next": [
            150080120
          ]
        },
        "150080120": {
          "id": 150080120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Es amiga mía y se encarga de custodiar las máscaras necesarias para participar en los Juegos Fabuluna.",
          "next": [
            150080121
          ]
        },
        "150080121": {
          "id": 150080121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Para evitar complicaciones, encuéntrenla y recuperen la máscara primero.",
          "next": [
            150080122
          ]
        },
        "150080122": {
          "id": 150080122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bien, ¡en marcha!",
          "next": [
            150080123
          ]
        },
        "150080123": {
          "id": 150080123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Welt y yo nos reuniremos luego con ustedes.",
          "next": []
        }
      },
