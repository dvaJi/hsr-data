          ]
        },
        "145440105": {
          "id": 145440105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "¡Sí! Especialmente Experto en causar problemas. Creo que quiere que me lo lleve a casa.",
