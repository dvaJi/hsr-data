            145440110
          ]
        },
        "145440110": {
          "id": 145440110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "¡Basta, deja de hacerte más fuerte a escondidas!",
          "next": [
            145440111
          ]
        },
        "145440111": {
          "id": 145440111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Ojalá pudiera convertirme en un Pastelito de la suerte...",
          "next": [
            145440112
          ]
        },
        "145440112": {
          "id": 145440112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "El ábaco de jade falla en cuanto me acerco y no puedo recibir mensajes de trabajo.",
