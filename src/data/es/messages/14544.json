          ]
        },
        "145440108": {
          "id": 145440108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Debo declarar que Pastel de glicinia definitivamente podrá aprender más magia si sigue entrenando.",
