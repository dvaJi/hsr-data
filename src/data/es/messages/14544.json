            145440113
          ]
        },
        "145440113": {
          "id": 145440113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Puedo ayudarte a cumplir tu deseo de antes, ¿quieres intentarlo?",
