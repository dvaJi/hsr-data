        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Umm ... akhirnya aku punya waktu luang, tapi aku malah tidak terbiasa, jadi aku cari-cari kesibukan.",
