      "messages": {
        "150500101": {
          "id": 150500101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Kawan lamaku, dananya masih cukup?",
          "next": [
            150500102
          ]
        },
        "150500102": {
          "id": 150500102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Kalau enggak cukup, kamu terpaksa pake uang pribadi.",
          "next": [
            150500103
          ]
        },
        "150500103": {
          "id": 150500103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Sekarang, aku mau kasih kabar baik yang pertama.",
          "next": [
            150500104
          ]
        },
        "150500104": {
          "id": 150500104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Kemarin setelah \"Tantangan Hambur Uang\" berakhir, kami panggil Si Rajin buat konfirmasi semua pemasukan dan pengeluaran.",
          "next": [
            150500105
          ]
        },
        "150500105": {
          "id": 150500105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Walau ada beberapa pengeluaran yang agak aneh ... tapi menurut kami itu enggak melanggar aturan.",
          "next": [
            150500106,
            150500108
          ]
        },
        "150500106": {
          "id": 150500106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ini yang namanya kabar baik? Semua pengeluaran aku selalu taat aturan.",
          "next": [
            150500107
          ]
        },
        "150500107": {
          "id": 150500107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Aku cuma takut kamu gagal karena melanggar aturan.",
          "next": [
            150500110
          ]
        },
        "150500108": {
          "id": 150500108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kalau ini kabar baik yang pertama ... berarti masih ada yang kedua?",
          "next": [
            150500109
          ]
        },
        "150500109": {
          "id": 150500109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Maaf, kami mau reaksi yang paling otentik, jadi cuma ini yang bisa kami kasih tahu untuk sekarang.",
          "next": [
            150500110
          ]
        },
        "150500110": {
          "id": 150500110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Temui aku di Menara Penunjuk, alamatnya sudah aku kirim. Kita selesaikan dulu syuting finalisasi \"Tantangan Hambur Uang\".",
          "next": [
            150500111,
            150500112
          ]
        },
        "150500111": {
          "id": 150500111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sabar, baru berangkat, udah di jalan.",
          "next": [
            150500113
          ]
        },
        "150500112": {
          "id": 150500112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tunggu sebentar, aku masih harus siap-siap.",
          "next": [
            150500113
          ]
        },
        "150500113": {
          "id": 150500113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Nggak usah buru-buru. Oh iya, Tuan Aventurine juga lagi di jalan.",
          "next": [
            150500114
          ]
        },
        "150500114": {
          "id": 150500114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Setelah kalian sampe, baru kita mulai finalisasi tantangannya.",
          "next": []
        }
      },
      "participatingContactsIds": [
        224,
        8001
      ]
    }
  ]
}