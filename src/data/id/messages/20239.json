        "202390000": {
          "id": 202390000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Oh hartaku!",
          "next": [
            202390001
          ]
        },
        "202390001": {
          "id": 202390001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Aku sudah memutuskan: Hari ini adalah hari kehancuran Planarcadia!",
          "next": [
            202390002
          ]
        },
        "202390002": {
          "id": 202390002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Kalau mau ikut aku kembali ke Uruk, segera datang ke alun-alun Kota Dua Dimensi!",
          "next": [
            202390003
          ]
        },
        "202390003": {
          "id": 202390003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Pesawat Vimana milikku hanya akan berhenti selama lima menit, lewat dari waktu itu akan ditinggal!",
          "next": [
            202390004,
            202390006,
            202390007
          ]
        },
        "202390004": {
          "id": 202390004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sudah tanya pendapatku belum?",
          "next": [
            202390005
          ]
        },
        "202390005": {
          "id": 202390005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Tentu tidak! Aku sedang menginterogasimu loh?!",
          "next": [
            202390009
          ]
        },
        "202390006": {
          "id": 202390006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Apa sih???",
          "next": [
            202390009
          ]
        },
        "202390007": {
          "id": 202390007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tanda serunya banyak amat, mataku jadi sakit nih.",
          "next": [
            202390008
          ]
        },
        "202390008": {
          "id": 202390008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Tentu saja, raja memang sudah seharusnya punya suara yang menggelegar!",
          "next": [
            202390009
          ]
        },
        "202390009": {
          "id": 202390009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Biar kuberi tahu alasan kemarahanku: Jalanan Kuliner Gil milikku ternyata sangat sepi pengunjung sejak pembukaannya.",
          "next": [
            202390010
          ]
        },
        "202390010": {
          "id": 202390010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Es krim lapis emas! Salad tuna lapis emas! Bistik ular Vonwacq lapis emas! BBQ Doomsday Beast utuh lapis emas!",
          "next": [
            202390011
          ]
        },
        "202390011": {
          "id": 202390011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Semua ini adalah barang pilihan premium yang kupilih sendiri berdasarkan seleraku yang luar biasa, tapi makhluk-makhluk rendahan itu malah memandangnya sebelah mata ....",
          "next": [
            202390012
          ]
        },
        "202390012": {
          "id": 202390012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Sudahlah, tidak perlu tunggu lima menit lagi, sekarang aku akan menjatuhkan hukuman!",
          "next": [
            202390013,
            202390015
          ]
        },
        "202390013": {
          "id": 202390013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Baginda, mohon jangan marah. Merekalah yang seleranya jelek.",
          "next": [
            202390014
          ]
        },
        "202390014": {
          "id": 202390014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Huh, di tanah ini ternyata cuma kamu yang menghargai kemurahan hatiku ... luar biasa.",
          "next": [
            202390017
          ]
        },
        "202390015": {
          "id": 202390015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es krim lapis emas sih ya sudahlah, tapi beberapa menu setelahnya itu apa?",
          "next": [
            202390016
          ]
        },
        "202390016": {
          "id": 202390016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Bahkan kamu pun tidak tahu diuntung? Galaksi ini benar-benar sudah tidak tertolong lagi.",
          "next": [
            202390017
          ]
        },
        "202390017": {
          "id": 202390017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Heh, kalau sudah begini, bahkan menghancurkan tanah ini pun terasa berlebihan.",
          "next": [
            202390018
          ]
        },
        "202390018": {
          "id": 202390018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Aku dengan berat hati memaafkan makhluk-makhluk rendahan ini. Mengingat mereka hanya bisa makan ampas setiap hari, wajar saja kalau mereka tidak mampu mengapresiasi seleraku.",
          "next": [
            202390019
          ]
        },
        "202390019": {
          "id": 202390019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Mundurlah, hartaku! Aku akan lanjut meneliti SoulGlad lapis emas.",
          "next": [
            202390020
          ]
        },
        "202390020": {
          "id": 202390020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Dalam tiga hari, aku pasti akan membuat utopia ini tunduk dan patuh padaku dengan sukarela!",
          "next": [
            202390021
          ]
        },
        "202390021": {
          "id": 202390021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pengguna berada di luar jangkauan, silakan coba lagi nanti",
          "next": []
        }
