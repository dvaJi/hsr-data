        "202250006": {
          "id": 202250006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Kamu harus lebih berani! Metode tambah hoki ini juga bisa diterapkan di macam-macam permainan kok.",
