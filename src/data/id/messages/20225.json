        "202250012": {
          "id": 202250012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Selain itu, perhatikan angka hoki, jam hoki, dan barang hoki. Tidak ada ruginya kok.",
          "next": [
            202250013
          ]
        },
        "202250013": {
          "id": 202250013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Oh, ada satu yang sering kelewat. Perhatikan barang-barang di sekitar yang bunyi atau namanya mirip sama \"kalah\", kayak \"kara\", \"bara\" dan sebagainya.",
