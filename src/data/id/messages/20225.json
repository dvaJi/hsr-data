        },
        "202250008": {
          "id": 202250008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ayo, harus lebih berani! Metode tambah hoki ini juga bisa diterapkan di macam-macam permainan kok.",
          "next": [
            202250009
