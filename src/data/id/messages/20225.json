        },
        "202250001": {
          "id": 202250001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Memanfaatkan gelombang keberuntungan ini, sekaligus timbun hoki biar bisa tembus seribu kemenangan beruntun, aku harus sekalian promosikan \"Jurus Hoki\"-ku.",
          "next": [
            202250002
          ]
        },
        "202250002": {
          "id": 202250002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Tentu saja, manusia yang rencanakan, manusia pula yang jalankan. Teknik ini tidak wajib, yang penting mainnya seru.",
          "next": [
            202250003
          ]
        },
        "202250003": {
          "id": 202250003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Kalau bingung kenapa kalah terus, boleh dicoba.",
