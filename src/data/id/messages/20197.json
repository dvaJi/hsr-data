          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Seekstrim itu?",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Sepertinya kamu salah paham tentang kami.",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Itu cuma kebiasaan buruk orang Kremnos zaman dulu buat tes nyali para pejuang. Sudah kuhapus tradisi itu sejak lama.",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Makanan Kremnos yang sekarang empat sehat lima sempurna.",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Juga dimodifikasi dan ditingkatkan dengan menyerap keunggulan dari jenis masakan lain.",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Apa preferensi rasa?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sukanya yang unik dan medok.",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Kalau gitu, Iga Domba Semur saja. Hidangan ini bagus untuk tambah asupan garam dan nafsu makan. Paling enak dipadankan dengan jus delima.",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Yang normal-normal saja plis.",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Pasta kacang asam dengan kue madu delima, selalu enak dimakan kapan saja.",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pokoknya harus yang aneh-aneh deh.",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ikan kaleng dari Lautan Jiwa mungkin cocok buat kamu.",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Aku jarang masak pakai itu.",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Atau mau coba daging yang sudah disimpan selama lebih dari sepuluh tahun?",
