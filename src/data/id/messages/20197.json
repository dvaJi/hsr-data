        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Sudah kucoba semua resep dan gaya masakan di atas, tapi keahlianku tetap masakan Kremnos.",
