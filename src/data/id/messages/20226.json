      "messages": {
        "202260000": {
          "id": 202260000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ramalan hari ini: Pandanglah matahari, jangan khawatir. Bernyanyilah sebelum tidur, dan makan yang teratur.",
          "next": [
            202260001
          ]
        },
        "202260001": {
          "id": 202260001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Intinya, ramalan hari ini hasilnya \"beruntung\". Selamat ya.",
          "next": [
            202260002,
            202260005
          ]
        },
        "202260002": {
          "id": 202260002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gimana tuh ramalnya?",
          "next": [
            202260003
          ]
        },
        "202260003": {
          "id": 202260003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Tadi kebetulan ada sehelai daun hijau jatuh di depanku.",
          "next": [
            202260004
          ]
        },
        "202260004": {
          "id": 202260004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Daun yang gugur kembali ke akar, sebab dan akibat saling berhubungan, hati tahu nasib baik dan buruk.",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260005": {
          "id": 202260005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kalau besok gimana? Nyonya Yao tolong bantu ramal juga dong.",
          "next": [
            202260006
          ]
        },
        "202260006": {
          "id": 202260006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Tadi cuma kebetulan ada sehelai daun hijau jatuh di depanku.",
          "next": [
            202260007
          ]
        },
        "202260007": {
          "id": 202260007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Tapi aku pun tidak tahu daun mana yang akan kembali ke akar besok.",
          "next": [
            202260008
          ]
        },
        "202260008": {
          "id": 202260008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Urusan besok, pikirkan besok saja~",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260009": {
          "id": 202260009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nyonya Yao jago ramal-ramal ya.",
          "next": [
            202260010
          ]
        },
        "202260010": {
          "id": 202260010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tapi kok aku agak ragu ya.",
          "next": [
            202260013
          ]
        },
        "202260011": {
          "id": 202260011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Unik banget cara meramalnya.",
          "next": [
            202260012
          ]
        },
        "202260012": {
          "id": 202260012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tapi kok aku jadi agak ragu ya.",
          "next": [
            202260013
          ]
        },
        "202260013": {
          "id": 202260013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Tidak ada yang luput dari omniscia. Pergerakan segalanya memiliki sebab dan dasar yang jelas.",
          "next": [
            202260014
          ]
        },
        "202260014": {
          "id": 202260014,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1502,
          "next": [
            202260015
          ]
        },
        "202260015": {
          "id": 202260015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Selain pakai alat khusus, metode meramal yang lebih fleksibel, yah yang kayak gini.",
          "next": [
            202260016
          ]
        },
        "202260016": {
          "id": 202260016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Misalnya, tekstur permukaan daun, sidik jari di dinding cangkir ... Oh, kebetulan nih lagi rebus telur teh.",
          "next": [
            202260017
          ]
        },
        "202260017": {
          "id": 202260017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202260018
          ]
        },
        "202260018": {
          "id": 202260018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Aku asal pilih satu. Retakan pada cangkang telur bersilangan seperti brokat, melambangkan peluang tersembunyi. Putih telurnya mengental di dalam cangkang, menandakan berkumpulnya rezeki!",
          "next": [
            202260019
          ]
        },
        "202260019": {
          "id": 202260019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Bagus, bagus. Tampaknya kita berdua beruntung dalam hal keuangan akhir-akhir ini.",
          "next": [
            202260020,
            202260022
          ]
        },
        "202260020": {
          "id": 202260020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku lihat karakter namamu ... ada delapan huruf!",
          "next": [
            202260021
          ]
        },
        "202260021": {
          "id": 202260021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sukses datang dari delapan arah ... Nyonya Yao besok pasti beruntung juga!",
          "next": [
            202260024
          ]
        },
        "202260022": {
          "id": 202260022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku lihat matahari terbit di timur dan terbenam di barat ....",
          "next": [
            202260023
          ]
        },
        "202260023": {
          "id": 202260023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nyonya Yao besok ... pasti beruntung juga!",
          "next": [
            202260024
          ]
        },
        "202260024": {
          "id": 202260024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Kamu memang bakat!",
          "next": [
            202260025
          ]
        },
        "202260025": {
          "id": 202260025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
