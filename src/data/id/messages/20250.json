  "sections": [
    {
      "id": 2025000,
      "startingMessageId": [
        202500000
      ],
      "messages": {
        "202500000": {
          "id": 202500000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Alamat: Studio Pribadi Pearl, Lantai 3 Departemen Investasi Strategis IPC, Pier Point.",
          "next": [
            202500001
          ]
        },
        "202500001": {
          "id": 202500001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "{NICKNAME}, kalau ke depannya Astral Express punya barang rusak atau rongsokan yang ingin dibuang, kirim saja ke aku, akan aku daur ulang.",
          "next": [
            202500002,
            202500005
          ]
        },
        "202500002": {
          "id": 202500002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ini pekerjaan sampingan kamu?",
          "next": [
            202500003
          ]
        },
        "202500003": {
          "id": 202500003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Definisi pekerjaan sampingan adalah pekerjaan kedua di luar pekerjaan utama yang dilakukan pada waktu luang dan menghasilkan pendapatan ekonomi.",
          "next": [
            202500004
          ]
        },
        "202500004": {
          "id": 202500004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tapi secara teknis, aku justru membayar kalian untuk \"Rencana Daur Ulang Sampah\" ini.",
          "next": [
            202500009
          ]
        },
        "202500005": {
          "id": 202500005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sampah? Mana sampah? Apa manusia bisa didaur ulang?",
          "next": [
            202500006
          ]
        },
        "202500006": {
          "id": 202500006,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500007
          ]
        },
        "202500007": {
          "id": 202500007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Secara teknis, kehidupan organik juga bisa \"dialihfungsikan.\" Tapi biaya untuk layanan itu di luar anggaranku.",
          "next": [
            202500008
          ]
        },
        "202500008": {
          "id": 202500008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Sedangkan untuk barang lainnya, anggaran daur ulangku cukup.",
          "next": [
            202500009
          ]
        },
        "202500009": {
          "id": 202500009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Kamu mau daur ulang sampah, lalu mengoleksinya?",
          "next": [
            202500010
          ]
        },
        "202500010": {
          "id": 202500010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ini adalah langkah sebelum dikoleksi. Bagiku, merestorasi barang lawas lebih seperti sebuah \"perjalanan mental yang spontan\".",
          "next": [
            202500011
          ]
        },
        "202500011": {
          "id": 202500011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Dulu waktu mengerjakan \"Prakarsa Kelahiran Kembali Dunia\", aku berhasil memulihkan banyak peninggalan tanpa pemilik.",
          "next": [
            202500012
          ]
        },
        "202500012": {
          "id": 202500012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Waktu aku satukan teksturnya sedikit demi sedikit, informasi tentang sebuah planet yang asing akan membanjiri benakku — lonceng angin, perairan dangkal, gletser, dan banyak lagi peradaban dan pemandangan yang tak terlukiskan.",
          "next": [
            202500013
          ]
        },
        "202500013": {
          "id": 202500013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Biasanya setelah itu, aku akan tenggelam dalam pekerjaan untuk waktu yang lama.",
          "next": [
            202500014,
            202500016,
            202500019
          ]
        },
        "202500014": {
          "id": 202500014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku benar-benar iri sama hobimu ....",
          "next": [
            202500015
          ]
        },
        "202500015": {
          "id": 202500015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ternyata cuma pekerjaan.",
          "next": [
            202500020
          ]
        },
        "202500016": {
          "id": 202500016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Majulah, kalian para gila kerja!",
          "next": [
            202500017
          ]
        },
        "202500017": {
          "id": 202500017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "\"Maju\" buat apa? Bikin manik setrika?",
          "next": [
            202500018
          ]
        },
        "202500018": {
          "id": 202500018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Bercanda ....",
          "next": [
            202500020
          ]
        },
        "202500019": {
          "id": 202500019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Memperbaiki benda tidak seasyik menjelajahi dunia. Ayo, istirahat! Kita jalan-jalan!",
          "next": [
            202500020
          ]
        },
        "202500020": {
          "id": 202500020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aku jadi teringat dengan sebuah pertanyaan yang pernah diajukan media padaku: Bagaimana kamu menyeimbangkan pekerjaan dan kehidupan?",
          "next": [
            202500021
          ]
        },
        "202500021": {
          "id": 202500021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Pertama, aku sarankan agar dia bertanya pada Louis Fleming. Kedua, aku tanya balik: Bagaimana caramu menyeimbangkan napas dan hidup? Dia tidak bertanya lebih lanjut.",
          "next": [
            202500022
          ]
        },
        "202500022": {
          "id": 202500022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Selain itu, memperbaiki barang-barang yang terbengkalai dari Astral Express maupun yang dipungut di jalan juga merupakan sebuah perjalanan artistik yang menyelami semangat perintisan.",
          "next": [
            202500023
          ]
        },
        "202500023": {
          "id": 202500023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Oh ya, ada sebuah fakta menarik: mutiara di lautan juga semacam \"alih fungsi sampah\".",
          "next": [
            202500024
          ]
        },
        "202500024": {
          "id": 202500024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500025
          ]
        },
        "202500025": {
          "id": 202500025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Transaksi pribadi ini berlaku untuk jangka panjang. Aku tunggu \"barang bagus dari perjalanan\" Astral Express.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1503,
        8001
      ]
    }
  ]
}