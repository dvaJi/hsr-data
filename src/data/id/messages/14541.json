          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Sepertinya kamu sudah buka semua arena.",
          "next": [
            145410102
          ]
        },
        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Bagaimana pengalaman observasimu?",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pertunjukan para ciptaan yang tak terduga ini cukup menarik.",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Inilah pesona dari seleksi alam.",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Di lingkungan yang terus berubah, tidak ada yang namanya \"solusi terbaik bagi kehidupan\".",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bukannya cuma hewan-hewan kecil yang berlarian ke sana kemari, apanya yang spesial?",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Begitu ya.",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Paling tidak, kamu bisa lihat bagaimana makhluk hidup mengeksplorasi dan membuat keputusan di lingkungan yang asing.",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Mungkin titik akhirnya tidak berarti, tapi mereka jelas tidak puas.",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Kamu sudah melakukannya dengan sangat baik.",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Sudah kusiapkan beberapa hadiah, kamu bisa ambil kapan saja.",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kerja keras harus dihargai. Ini sudah menjadi hakku.",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Terima kasih, pasti kuambil semuanya.",
          "next": [
            145410114
          ]
        },
        "145410114": {
          "id": 145410114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ya. Biayanya dari dana penelitian Stasiun Luar Angkasa.",
