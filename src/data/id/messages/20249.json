          ]
        },
        "202490011": {
          "id": 202490011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Bahkan sudah ada anggota grup yang minta pola manik setrika \"Ikan Mutiara\".",
