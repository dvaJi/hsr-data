          ]
        },
        "202490013": {
          "id": 202490013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Beberapa waktu yang lalu, manik setrika pernah populer di Planarcadia, aku sempat mencoba beberapa kali.",
