        },
        "202490016": {
          "id": 202490016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Selain manik setrika, di grup itu juga ada pecinta kerajinan tangan lainnya, seperti balok piksel, sulam kristik, tembikar, lilin mainan, kolase mosaik, dan banyak lagi.",
