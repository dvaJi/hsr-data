        },
        "202490017": {
          "id": 202490017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tapi, spesifikasi referensi desain yang dibutuhkan untuk setiap kerajinan tangan berbeda-beda.",
