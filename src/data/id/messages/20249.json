        },
        "202490010": {
          "id": 202490010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Teman-teman sehobiku di grup \"Tanpa Juang Tiada Menang\" juga bilang mereka sangat menyukai Ikan Mutiara.",
