            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Detak jantung kamu tidak normal! Aventurine, aku datang tuk menyelamatkanmu!",
