        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Detak jantungnya nggak beres! Jangan nakutin aku, Aventurine! Bertahanlah, aku segera datang!",
