            202470006
          ]
        },
        "202470005": {
          "id": 202470005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Detak jantungnya nggak beres. Mana IPC?! Mana Preservation?! Amber Lord?! Mana Dewi Ibu?! Tolong!!!",
