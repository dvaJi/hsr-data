        },
        "202470014": {
          "id": 202470014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Jangan main roller coaster lagi! Ngomong sesuatu kalau masih hidup!",
          "next": [
            202470015
          ]
        },
        "202470015": {
          "id": 202470015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202470016
          ]
        },
        "202470016": {
          "id": 202470016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hehe, santai, santai! Jangan panik, jangan panik! Ini salah paham, aku nggak apa-apa. Tadi aku lagi berselancar. Tunggu aku naik ke darat dulu, nanti aku jelasin.",
          "next": [
            202470017
          ]
        },
        "202470017": {
          "id": 202470017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi",
          "next": [
            202470018
          ]
        },
        "202470018": {
          "id": 202470018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202470019
