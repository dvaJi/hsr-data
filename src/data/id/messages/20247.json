        },
        "202470019": {
          "id": 202470019,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Perkiraan lokasi Aventurine saat ini telah berubah.",
          "next": [
            202470020
          ]
        },
        "202470020": {
          "id": 202470020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hai.",
          "next": [
            202470021
          ]
        },
        "202470021": {
          "id": 202470021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Jam tangan ini perhatian banget ya? Cuma ombak raksasa 50 meter aja kok.",
          "next": [
            202470022,
            202470023
          ]
        },
        "202470022": {
          "id": 202470022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "50 meter itu sudah masuk peringatan bencana laut, tau! Detak jantungmu aja sebentar 20, sebentar 180!",
          "next": [
            202470024
          ]
        },
        "202470023": {
          "id": 202470023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Memangnya waktu berselancar, detak jantung bisa sebentar 20, sebentar 180?!",
          "next": [
            202470024
          ]
        },
        "202470024": {
          "id": 202470024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Langsung kebongkar semua, nih?",
          "next": [
            202470025
          ]
        },
        "202470025": {
          "id": 202470025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Tenang, waktu 20 itu pasti aku lagi nahan napas di bawah ombak.",
