            202470012
          ]
        },
        "202470012": {
          "id": 202470012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aventurine! Kalau kamu masih hidup, ngomong sesuatu!",
          "next": [
            202470015
          ]
        },
        "202470013": {
          "id": 202470013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sebentar 20, sebentar 180, kenapa rasanya lebih mirip detak jantungku, ya?",
