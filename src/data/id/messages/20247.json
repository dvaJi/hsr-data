            202470026
          ]
        },
        "202470026": {
          "id": 202470026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Kalaupun naik sampe 180, tetep nggak setinggi waktu aku bertarung sama kamu di malam Penacony yang panjang itu.",
          "next": [
            202470027
          ]
        },
        "202470027": {
          "id": 202470027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hahaha, oke aku nggak becanda lagi. Sori, tadi udah bikin kamu kuatir.",
          "next": [
            202470028
          ]
        },
        "202470028": {
          "id": 202470028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Aku lagi cobain sayap selancar melayang terbaru.",
          "next": [
            202470029
          ]
        },
        "202470029": {
          "id": 202470029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Waktu nukik turun dari puncak ombak raksasa, sensasi nggak berbobotnya benar-benar bikin aku ketagihan.",
          "next": [
            202470030
          ]
        },
        "202470030": {
          "id": 202470030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202470031
          ]
        },
        "202470031": {
          "id": 202470031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Aku beruntung sekali, ombaknya datang lagi!",
          "next": [
            202470032
