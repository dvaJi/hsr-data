          ]
        },
        "202410031": {
          "id": 202410031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Sekarang aku punya alasan untuk membagikannya dengan kalian semua~ Aku ingin tahu gaya rambut dan warna rambut apa yang kalian sukai!",
          "next": [
            202410032
