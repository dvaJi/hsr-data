      "messages": {
        "202410000": {
          "id": 202410000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku membereskan koper dan menemukan kartu anggota seumur hidup yang berlaku di semua salon di seluruh Planarcadia.",
          "next": [
            202410001
          ]
        },
        "202410001": {
          "id": 202410001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Kasih ke siapa ya ...?",
          "next": [
            202410002,
            202410004,
            202410007
          ]
        },
        "202410002": {
          "id": 202410002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku satu-satunya yang masih di bawah umur di Express ini, buat aku saja!",
          "next": [
            202410003
          ]
        },
        "202410003": {
          "id": 202410003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku tahu kamu pasti suka~ Ini untukmu, nanti kamu bisa ajak semua orang pergi ke salon~",
          "next": [
            202410009
          ]
        },
        "202410004": {
          "id": 202410004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku pikir ... March pasti suka, Dan Heng harusnya tidak akan menolak, Sunny juga sangat elegan, dan Tuan Yang juga punya rambut ....",
          "next": [
            202410005
          ]
        },
        "202410005": {
          "id": 202410005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Buat aku saja Aku akan ajak semua orang pergi ke salon~",
          "next": [
            202410006
          ]
        },
        "202410006": {
          "id": 202410006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tentu saja, aku juga berpikir begitu~",
          "next": [
            202410009
          ]
        },
        "202410007": {
          "id": 202410007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keluarga kita bisa bergantian menikmati layanan desainer utama dan merias rambut bersama-sama!",
          "next": [
            202410008
          ]
        },
        "202410008": {
          "id": 202410008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku juga berpikir begitu~",
          "next": [
            202410009
          ]
        },
        "202410009": {
          "id": 202410009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Dulu waktu sekolah di Planarcadia, aku juga suka mencoba gaya rambut yang berbeda-beda.",
          "next": [
            202410010
          ]
        },
        "202410010": {
          "id": 202410010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Kalau tidak salah ingat, aku pernah mewarnai rambutku dengan warna yang mirip dengan March. Potongan rambut pendek ala Dan Heng juga pernah ingin aku coba, tapi penata rambutku mencegahku mati-matian.",
          "next": [
            202410011
          ]
        },
        "202410011": {
          "id": 202410011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Gaya rambutku akhirnya mungkin lebih mirip gaya \"mullet\", agak mirip dengan rambut Sunday.",
          "next": [
            202410012
          ]
        },
        "202410012": {
          "id": 202410012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Kalau dipikir-pikir, waktu mereka pilih kartu ini sebagai uang perlindungan rambut, mereka benar-benar sudah memikirkannya matang-matang.",
          "next": [
            202410013,
            202410019,
            202410024
          ]
        },
        "202410013": {
          "id": 202410013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku mau lihat album gaya rambut Himeko deh! Ada fotonya gak?",
          "next": [
            202410014
          ]
        },
        "202410014": {
          "id": 202410014,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202410015
          ]
        },
        "202410015": {
          "id": 202410015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tunggu, biaya apa itu??",
          "next": [
            202410016
          ]
        },
        "202410016": {
          "id": 202410016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Hm? Oh, ini suvenir persahabatan yang kudapat semasa sekolah dulu.",
          "next": [
            202410017
          ]
        },
        "202410017": {
          "id": 202410017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ternyata begini caramu bersahabat ya!",
          "next": [
            202410018
          ]
        },
        "202410018": {
          "id": 202410018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Kalau soal foto, aku lupa waktu itu kubawa ke Express atau tidak. Biar kucari dulu.",
          "next": [
            202410029
          ]
        },
        "202410019": {
          "id": 202410019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kak Himeko punya rekomendasi gaya rambut tidak? Aku juga mau coba ganti gaya rambut.",
          "next": [
            202410020
          ]
        },
        "202410020": {
          "id": 202410020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tunggu, uang perlindungan apa??",
