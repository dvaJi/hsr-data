            150110106
          ]
        },
        "150110106": {
          "id": 150110106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Para penggemarku sudah melihat semuanya, mereka bilang kamu memeriksa TKP yang ditangani Departemen Pertahanan Anomali .... Huh, lagi-lagi ikut campur urusan orang.",
          "next": [
            150110107
          ]
        },
        "150110107": {
          "id": 150110107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Ini kasus \"Pembunuh Milenium\" kan? Aku juga cukup tertarik dengannya.",
