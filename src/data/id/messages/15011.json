        "150110100": {
          "id": 150110100,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu sedang sibuk sekarang? Aku ada urusan, mau minta tolong.",
          "next": [
            150110101
