          ]
        },
        "150110104": {
          "id": 150110104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kenapa tiba-tiba mau ketemu langsung? Mau ngapain? Mau balas dendam sama aku?",
