        },
        "150110103": {
          "id": 150110103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Bisa jadi nomor satu di industri yang begitu kejam ini, ya harus \"proaktif\", hehe.",
