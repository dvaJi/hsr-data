          ]
        },
        "150110105": {
          "id": 150110105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Kamu ini berpikirnya aneh-aneh saja! Tentu saja aku datang untuk membantu!",
