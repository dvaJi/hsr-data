        "150840102": {
          "id": 150840102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Kamu masih ingat soal tiket menonton pertandingan yang kutinggalkan untukmu sebelumnya?",
          "next": [
            150840103
          ]
        },
        "150840103": {
          "id": 150840103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Awalnya aku harap kamu bisa nikmati pertunjukannya. Tak disangka, kamu malah jadi bagian dari pertunjukan.",
          "next": [
            150840104,
            150840105
          ]
        },
        "150840104": {
          "id": 150840104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sayang sekali tidak bisa tonton pertunjukannya, apakah ada tiket untuk pertunjukan selanjutnya?",
          "next": [
            150840106
          ]
        },
        "150840105": {
          "id": 150840105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sejujurnya, setelah kembali aku terus mencari video rekaman pertunjukan pembukaan.",
          "next": [
            150840106
          ]
        },
        "150840106": {
          "id": 150840106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Lagipula, waktu itu kamu sedang duduk di dalam mobil balap, dan mendengarkan lagu baru itu dengan kualitas audio TR yang buruk.",
          "next": [
            150840107
          ]
        },
        "150840107": {
          "id": 150840107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Agak malu rasanya.",
          "next": [
            150840108
          ]
        },
        "150840108": {
          "id": 150840108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Jadi ....",
          "next": [
            150840109
          ]
        },
        "150840109": {
          "id": 150840109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aku sudah siapkan tempat khusus untukmu agar bisa nikmati pertunjukan langsungku, bagaimana?",
          "next": [
            150840110
          ]
        },
        "150840110": {
          "id": 150840110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bagus sekali, jadi di mana aku bisa melihatnya?",
          "next": [
            150840111
          ]
        },
        "150840111": {
          "id": 150840111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aku memiliki proyek kerja sama dengan Interastral Peace Entertainment, tujuannya adalah \"menghadirkan kembali perasaan haru di lokasi\".",
          "next": [
            150840112
          ]
        },
        "150840112": {
          "id": 150840112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Siapa pun dapat menyaksikan pertunjukan langsung Robin berulang kali di panggung Taman Tepi Laut Pantai Astropolis.",
          "next": [
            150840113
          ]
        },
        "150840113": {
          "id": 150840113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Jika kamu tertarik, pergilah ke konter bar di Taman Tepi Laut dan cari seorang Bartender bernama \"Rocca\".",
          "next": [
            150840114
          ]
        },
        "150840114": {
          "id": 150840114,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1309,
          "image": "PhoneMessagePic_15501",
          "next": [
            150840115
          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aku sudah mengabari mereka sebelumnya.",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Kamu akan jadi penonton pertama \"Pertunjukan Spesial\" ini.",
          "next": [
            150840117,
            150840118
          ]
        },
        "150840117": {
          "id": 150840117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sudah tidak sabar.",
          "next": [
            150840119
          ]
        },
        "150840118": {
          "id": 150840118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku akan melihatnya setelah urusanku selesai.",
