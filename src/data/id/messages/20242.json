      "messages": {
        "202420000": {
          "id": 202420000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Kalian semua sudah bekerja keras akhir-akhir ini. Setelah urusan ini selesai, aku akan adakan acara makan-makan untuk seluruh kru.",
          "next": [
            202420001
          ]
        },
        "202420001": {
          "id": 202420001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku juga akan unjuk keahlianku, mau ikut aku bantu-bantu menyiapkan makanan?",
          "next": [
            202420002,
            202420005,
            202420008
          ]
        },
        "202420002": {
          "id": 202420002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oke, siapa yang masak? Aku? Atau Kak Himeko?",
          "next": [
            202420003
          ]
        },
        "202420003": {
          "id": 202420003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Meskipun kedengarannya agak mengkhawatirkan ya ....",
          "next": [
            202420004
          ]
        },
        "202420004": {
          "id": 202420004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tenang saja, aku tidak akan masak.",
          "next": [
            202420010
          ]
        },
        "202420005": {
          "id": 202420005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oke! Kak Himeko yang masak, aku yang bantu icip-icip!",
          "next": [
            202420006
          ]
        },
        "202420006": {
          "id": 202420006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tunggu, Kak Himeko yang memasak ....",
          "next": [
            202420007
          ]
        },
        "202420007": {
          "id": 202420007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tenang saja, aku tidak akan masak.",
          "next": [
            202420010
          ]
        },
        "202420008": {
          "id": 202420008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Setelah Kak Himeko unjuk kebolehan kemarin, kita jadi sering bolak-balik ke kamar mandi ... lumayan buat olahraga!",
          "next": [
            202420009
          ]
        },
        "202420009": {
          "id": 202420009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tenang saja, itu tidak akan terjadi lagi.",
          "next": [
            202420010
          ]
        },
        "202420010": {
          "id": 202420010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ada mesin masak yang kubuat sendiri di ruang penyimpanan, aku rasa sudah saatnya ia beraksi.",
          "next": [
            202420011
          ]
        },
        "202420011": {
          "id": 202420011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Meskipun beberapa bagiannya sudah berkarat ... tapi sudah waktunya untuk diperbaiki.",
          "next": [
            202420012
          ]
        },
        "202420012": {
          "id": 202420012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Waktu itu aku bilang akan mengajakmu saat memeriksa Astral Express, dan kebetulan sekarang ada mesin masak yang perlu diperbaiki ... prinsipnya sama, jadi aku pikir bisa mengajakmu sekalian.",
          "next": [
            202420013,
            202420014,
            202420016
          ]
        },
        "202420013": {
          "id": 202420013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Memangnya apa kesamaan antara memperbaiki kereta dan memperbaiki mesin masak ...?",
          "next": [
            202420017
          ]
        },
        "202420014": {
          "id": 202420014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jadi ini yang dimaksud \"unjuk kebolehan\" ya ... Kak Himeko memang hebat!",
          "next": [
            202420015
          ]
        },
        "202420015": {
          "id": 202420015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tapi ... kesamaannya di mana?",
          "next": [
            202420017
          ]
        },
        "202420016": {
          "id": 202420016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku juga harus memperbaiki Astral Express ... bukan, aku juga harus memperbaiki mesin masak ... tapi kesamaannya di mana?",
          "next": [
            202420017
          ]
        },
        "202420017": {
          "id": 202420017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Prinsip transmisi energi, sirkulasi panas, dan rotasi mekanis sangat mirip ... satu menggerakkan bintang-bintang, satu lagi menggerakkan spatula.",
          "next": [
            202420018
          ]
        },
        "202420018": {
          "id": 202420018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Selain itu, dibutuhkan juga sistem memasak cerdas untuk menyesuaikan tingkat panas dan keasinan sesuai selera yang berbeda-beda.",
          "next": [
            202420019
          ]
        },
        "202420019": {
          "id": 202420019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ini juga sejalan dengan kebiasaan mengemudi navigator dan kondektur.",
          "next": [
            202420020,
            202420027
          ]
        },
        "202420020": {
          "id": 202420020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Artinya, selama aku bisa memperbaiki mesin masak, aku pasti bisa memperbaiki Astral Express ....",
          "next": [
            202420021
          ]
        },
        "202420021": {
          "id": 202420021,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202420022
          ]
        },
        "202420022": {
          "id": 202420022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Iya, begitu prinsipnya.",
          "next": [
            202420023
          ]
        },
        "202420023": {
          "id": 202420023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku cuma asal bicara loh!",
          "next": [
            202420024
          ]
        },
        "202420024": {
          "id": 202420024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tidak apa-apa, aku tidak asal bicara.",
          "next": [
            202420025
          ]
        },
        "202420025": {
          "id": 202420025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
