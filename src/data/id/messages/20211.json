      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Dux Primarius, aku lagi menyiapkan rencana \"Ekspedisi Ekstrem\" pertamaku.",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Kamu yang sudah menjelajahi bintang-bintang pasti bisa kasih saran yang lebih menyeluruh padaku.",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sendirian saja? Rencananya ke mana?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Kalau ada yang mau ikut, aku tidak akan keberatan.",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rencananya ke mana?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Silakan naik ke Astral Express.",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Mungkin bisa jadi salah satu persinggahan dalam perjalananku, tapi lihat saja nanti.",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tujuan: Amphoreus di masa depan.",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Dalam penaklukan-penaklukan sebelumnya, negeri-negeri dalam ingatanku hanyalah kobaran api pertikaian atau gelombang hitam kematian.",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Saat benih memori tumbuh, Amphoreus akan dipenuhi dengan berbagai kemungkinan. Aku juga bisa menjelajahinya.",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Aku mau berlayar melintasi perairan Skiana, tempat awan gelap dan ombak besar bertarung tanpa henti.",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Pernah dengar tentang Ladon? Di sana ada ketinggian tempat kita bisa menyentuh awan.",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Aku lagi pertimbangkan baiknya terjun sayap atau terjun payung.",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Dux Primarius ada saran?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Yang mana saja oke. Aku sudah biasa berputar dan melompat, lalu mendarat di sebuah dunia dari ketinggian.",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Menarik.",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ceritanya panjang. Biasanya aku terjun dari ketinggian untuk masuk ke dunia baru.",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Kamu coba saja.",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Menarik.",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sayangi nyawamu! Cuma satu loh!",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tenang, Kaisar tidak semanja itu.",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Aku baru selesai menjalani pelatihan bertahan hidup di alam liar sama si kucing kecil, dan pelatihan mengikat simpul sama Dux Goldweaver.",
          "next": [
            202110022
          ]
        },
        "202110022": {
          "id": 202110022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Sekarang waktunya latihan renang sama Dux Gladiorum.",
