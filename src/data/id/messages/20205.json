          ]
        },
        "202050005": {
          "id": 202050005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Maaf, aku tidak lihat dia.",
          "next": [
            202050006
          ]
        },
        "202050006": {
          "id": 202050006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Kucarikan kucing itu sekarang juga.",
          "next": [
            202050009
          ]
        },
        "202050007": {
          "id": 202050007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mungkin di kolam pemandian?",
          "next": [
            202050008
          ]
        },
        "202050008": {
          "id": 202050008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Mau kubantu carikan kucingmu?",
          "next": [
            202050009
          ]
        },
        "202050009": {
          "id": 202050009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Tidak apa-apa, terima kasih. Aku tahu cari dia tidak mudah.",
          "next": [
            202050010
          ]
        },
        "202050010": {
          "id": 202050010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Jadi aku perlu cari cara supaya dia pulang sendiri.",
          "next": [
            202050011
          ]
        },
        "202050011": {
          "id": 202050011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Mau makan bareng di rumahku, Buabu?",
          "next": [
            202050012
          ]
        },
        "202050012": {
          "id": 202050012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ehem. Aku ngomong pakai pesan suara saja deh. Beberapa waktu lalu, Cifera sering bawa teman yang beda-beda untuk makan di rumah. Dia tiba-tiba menghilang waktu jam makan malam, pasti kumpul sama temannya lagi. Tapi aku tidak tahu dia di mana. Maklum, dia suka keliaran ke mana-mana. Jadi aku kepikiran cara ini.",
          "next": [
            202050013
          ]
        },
        "202050013": {
          "id": 202050013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi",
          "next": [
            202050014
          ]
        },
        "202050014": {
          "id": 202050014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Teman-teman yang pernah dia hubungi di tablet sudah kuhubungi semua. Ada siapa tuh namanya ... Agy. Tunggu, aku cek bentar. Aku sebut satu-satu ya, ada Agy, Kak Tribbie, Profesor Nax, Pangeran Kecil Abadi, Putri Rumahan, Kue Kecil Pink, Pensiunan Bocah Penyelamat, Kaisar, Penyuplai Ikan Kering, Zaggy ... dan Buabu. Oh, kamu kan ya. Nama yang bagus. Gampang diingat dan keren.",
          "next": [
            202050015
          ]
        },
        "202050015": {
          "id": 202050015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi",
          "next": [
            202050016,
            202050017,
            202050019
          ]
        },
        "202050016": {
          "id": 202050016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nek, jangan ambil serius nama-nama itu.",
          "next": [
            202050020
          ]
        },
        "202050017": {
          "id": 202050017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Meja makannya cukup besar? Aku bisa bawa meja panjang kalau perlu.",
          "next": [
            202050018
          ]
        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Tenang, cukup kok. Makanannya juga berlimpah.",
          "next": [
            202050020
          ]
        },
        "202050019": {
          "id": 202050019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asyik! Nasi berbakul-bakul! Lipat pangsit!",
          "next": [
            202050020
          ]
        },
        "202050020": {
          "id": 202050020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Astaga, anak-anak kecil sudah ... Jangan lari-lari! Sudah datang duluan, aku urus mereka dulu ya. Ya ampun. Kami tunggu kedatangan kalian ya. Cifera pasti senang banget.",
          "next": [
            202050021
          ]
        },
        "202050021": {
          "id": 202050021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi",
          "next": [
            202050022
          ]
        },
        "202050022": {
          "id": 202050022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hehe, aku pulang!",
          "next": [
            202050023
          ]
        },
        "202050023": {
          "id": 202050023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Buabu, cepat sini makan!",
          "next": [
