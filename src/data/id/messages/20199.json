      "messages": {
        "201990000": {
          "id": 201990000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "{NICKNAME}, maaf ganggu.",
          "next": [
            201990001
          ]
        },
        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Masih ingat kedua Chimera cilik peliharaanku? Ternyata suka tidur sambil dengar dongeng.",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Belakangan ini aku mau menjelajah ide-ide baru, jadi aku rencana mau coba mulai menulis.",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kisah baru apa nih kali ini?",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ada bagianku tidak?",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tenang, bisa diatur.",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sebenarnya, aku baru mau minta pendapatmu. Rencana sementara adalah:",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sang tokoh utama tidak sengaja memasuki sebuah kota kecil yang dihuni oleh para kucing dan tikus, burung gagak yang bisa bernyanyi, babi kecil warna pink, dan keluarga semut yang bergotong-royong.",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Mereka tidak takut pada manusia dan suka bermain bersama tokoh utama, juga suka sekali dengar cerita.",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tidak, mereka sangat suka dengar cerita.",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Saat larut malam, Kota Dongeng menjadi sunyi ... tetapi para hewan kecil malah tidak bisa tidur ....",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "\"Di sini tidak boleh hening\", \"tidak boleh hening\", kata mereka ....",
          "next": [
            201990012
          ]
        },
        "201990012": {
          "id": 201990012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Lalu, mereka pun mendekati tempat tidur sang tokoh utama.",
          "next": [
            201990013
          ]
        },
        "201990013": {
          "id": 201990013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tamat.",
          "next": [
            201990014
          ]
        },
        "201990014": {
          "id": 201990014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "●_●",
          "next": [
            201990015
          ]
        },
        "201990015": {
          "id": 201990015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◕_◕",
          "next": [
            201990016
          ]
        },
        "201990016": {
          "id": 201990016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◐‿◑",
          "next": [
            201990017
          ]
        },
        "201990017": {
          "id": 201990017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Liatin kamu.",
          "next": [
            201990018,
            201990021,
            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hiiii seram! \"Dongeng\" dari mananya?!",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ah, seseram itu kah?",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Jujur, makin aku tulis, makin aku sadar kalau tema ini mungkin lebih cocok untuk novel horor.",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Menurutku cukup gemas.",
          "next": [
            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Jujur, makin aku tulis, makin aku sadar kalau tema ini mungkin lebih cocok untuk novel horor.",
          "next": [
            201990023
          ]
        },
        "201990023": {
          "id": 201990023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tapi dari reaksimu, sepertinya unsur horornya masih kurang.",
          "next": [
            201990027
          ]
        },
        "201990024": {
          "id": 201990024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jadi kalau mau hening harus di mana dong?",
          "next": [
            201990025
          ]
        },
        "201990025": {
          "id": 201990025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sudah kuduga, fokusmu memang selalu beda dari yang lain.",
          "next": [
            201990026
          ]
        },
        "201990026": {
          "id": 201990026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Jujur, makin aku tulis, makin aku sadar kalau tema ini mungkin lebih cocok untuk novel horor.",
          "next": [
            201990027
          ]
        },
        "201990027": {
          "id": 201990027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": [
            201990028
          ]
        },
        "201990028": {
          "id": 201990028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tapi aku tidak terlalu mendalami novel horor. Supaya lebih menghayati, aku cari beberapa referensi, misal \"20 Kasus Misteri yang Belum Terpecahkan\" dan \"Berbagai Penyebab Orang Hilang\" ....",
          "next": [
            201990029
          ]
        },
        "201990029": {
          "id": 201990029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Aku baru selesai baca \"Makan Enak\", dapat beberapa ide bagus.",
          "next": [
            201990030
          ]
        },
        "201990030": {
          "id": 201990030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Nanti minta pendapatmu lagi ya setelah ada kemajuan.",
          "next": [
            201990031
          ]
        },
        "201990031": {
          "id": 201990031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tenang, para Chimera cilik juga tiap hari tagih-tagih terus. Mereka sudah tidak sabar mau dengar cerita!",
          "next": [
            201990032
          ]
        },
