            202130006
          ]
        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Katanya sih diadaptasi dari kisah nyata, dari seseorang yang punya lebih dari dua puluh kepribadian ....",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Karakter utamanya juga bolong-bolong ingatannya. Dia kira cuma amnesia biasa, padahal nyatanya, hidupnya diambil alih kepribadian lainnya.",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Menurutmu, apa aku juga begitu?",
          "next": [
            202130009
          ]
        },
        "202130009": {
          "id": 202130009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202130010,
            202130013
          ]
        },
        "202130010": {
          "id": 202130010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sebenarnya ... tebakanmu benar ....",
          "next": [
            202130011
          ]
        },
        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sebenarnya ... kamu yang kemarin bukan kamu yang hari ini. Kamu yang kemarin ... lebih imut.",
          "next": [
            202130012
          ]
        },
        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ngomong yang benar! Hari ini aku imut, besok lebih imut lagi!",
          "next": [
            202130014
          ]
        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tenang, dengan sudut pandang maha melihat, kamu adalah dirimu yang utuh.",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Walau kamu cuma bercanda, aku tetap sedikit khawatir.",
          "next": [
            202130015
          ]
        },
        "202130015": {
          "id": 202130015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Jangan-jangan, ada March 7th yang lain!",
          "next": [
            202130016
          ]
        },
        "202130016": {
          "id": 202130016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Mungkin ada seniman March 7th yang eksentrik? Atau pembunuh bayaran March 7th yang elegan dan supel? Ugh, menakutkan.",
          "next": [
            202130017
          ]
        },
        "202130017": {
          "id": 202130017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bisa jadi, ada jenius March 7th yang luar biasa cerdas ....",
          "next": [
            202130018,
            202130020,
            202130022
          ]
        },
        "202130018": {
          "id": 202130018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oooh, waktunya berkhayal ya? Tidur sana.",
          "next": [
            202130019
          ]
        },
        "202130019": {
          "id": 202130019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nanti pas bangun, kamu bakal tetap March 7th yang manis, lembut, baik hati, dan polos itu kok.",
          "next": [
            202130024
          ]
        },
        "202130020": {
          "id": 202130020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jangan lupa, kamu juga March 7th, sang Juara Pedang dari Astral Express.",
          "next": [
            202130021
          ]
        },
        "202130021": {
          "id": 202130021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tenang, kamu tetap March 7th yang manis, lembut, baik hati, dan polos itu kok.",
          "next": [
            202130024
          ]
        },
        "202130022": {
          "id": 202130022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
