        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Filmku sudah disetujui, sebuah film superhero berjudul \"Kemuraman Gigafurb\"!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wah, selamat! Selamat ya, impianmu jadi kenyataan!",
