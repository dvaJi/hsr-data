      "messages": {
        "150220100": {
          "id": 150220100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "{NICKNAME}, lama tak jumpa.",
          "next": [
            150220101,
            150220103
          ]
        },
        "150220101": {
          "id": 150220101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nyonya Xueyi! Aku tidak menyangka akan menerima pesan dari kamu!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Kamu masih seperti biasa ya, sangat bersemangat.",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kita memang sudah lama tidak berkomunikasi.",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Maaf, ini kelalaianku.",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Kalau ada waktu nanti, aku akan sering mengobrol denganmu.",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Kudengar kamu sedang melancong di Planarcadia.",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Aku ingin minta bantuanmu.",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tidak masalah, silakan katakan, Yang Mulia Hakim!",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Apa kamu pernah mendengar tentang \"Permainan Misteri\"?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Aku sangat tertarik dengan komik ini.",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Daripada karya debutnya, \"Raja Tumis\", mengejar penjahat dan mencari musuh lebih sesuai dengan seleraku.",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Aku dengar sekarang lagi ada \"Pameran Khusus Permainan Misteri\" di Kota Dua Dimensi dan ada banyak Karya Penggemar yang dijual di sana.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Sayang sekali, aku tidak bisa pergi ke pameran komik di Planarcadia karena identitasku.",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Aku harap kamu bisa membelikan aku beberapa karya penggemar, untuk menghilangkan penyesalan ini.",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku kebetulan lagi jalan-jalan di sekitar pameran komik ini, lalu dapat pesanmu ... Kamu tidak mengikuti aku kan?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "*Bip-bip*, drone pelacak \"Xueyi 9527\", telah terdeteksi, sedang menjalankan program penghancuran diri.",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Huhuhu, ampun! Jangan bom aku! Aku akan bantu belikan kamu karya penggemar!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Jangan takut, aku cuma bercanda.",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Tidak ada drone yang akan meledak, jadi kamu bisa tenang.",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Sangat sudah tidak sabar ingin membaca karya penggemar baru, terima kasih.",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kebetulan sekali, aku sedang di pameran komik.",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Kamu juga sudah baca? Bagus sekali, terima kasih.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ini hal kecil, serahkan saja padaku.",
          "next": [
            150220124
          ]
        },
