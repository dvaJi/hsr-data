      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, tadi waktu di pantai, aku ngumpulin beberapa sampel suara lagi.",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Suara kelapa yang jatuh menggelinding di tanah, minuman soda yang bergelembung dan meluap, cumi-cumi yang mendesis di atas piring panas ....",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Duh, aku jadi laper, nih. Pengin makan dua tusuk sate cumi.",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sebenarnya aku juga ....",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Musiknya harum banget ... eh maksudku, cuminya merdu.",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, daripada pikiran kosong waktu nggak dapat inspirasi, ngerasain sensasi rasa emang lebih seger.",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Masih ada beberapa suara yang lebih bernuansa tepi pantai, coba dengerin.",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ini suara waktu ombak surut: Syuuuss — blub blub blub blub ....",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi (suara gelembung terdeteksi)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Angin laut berembus melewati jangkar kapal yang berkarat: Syuu — weng — syuu — weng —",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi (suara berat terdeteksi)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Burung camar terbang melewati: Syuu — wush — kruk — Aah!",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi (suara burung terdeteksi)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Maaf, suara \"Aah\" tadi itu aku ... camilan di tanganku direbut burung camar ....",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sekarang jumlah sampelnya sudah cukup, tapi rasanya masih ada yang kurang ... kurang suara yang \"menyentuh hati\".",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, mungkin kamu punya inspirasi suara yang bisa bikin orang langsung bersemangat?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dengarkan gemuruh Express saat melakukan Warp.",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Penerima telah menerima lampiran \"Warp Bellow.mp3\"",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Suara \"perintisan\" memang langsung menyentuh sanubari.",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dengarkan suara alarm bangun tidur.",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Penerima telah menerima lampiran \"Wake-Up Alarm.mp3\"",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Duh, bikin serangan jantung ... tapi ini juga termasuk langsung kena ke jiwa, ya kan?",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tapi demi kesehatan fisik dan mental para pendengar, nanti aku turunin satu oktaf.",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dengarkan nyanyian jiwaku.",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Penerima telah menerima lampiran \"Nyanyi di Kamar Mandi.mp3\"",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ini suara nyanyian kamu? Memang ... sangat ... sangat ... menyentuh jiwa.",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hmm ... kayaknya kita bisa coba bikin remix!",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wing it now! Cast aside the unchanging score. Swing now! We aren't bolted parts anymore ....",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi (vokal asli terdeteksi)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "\"Only by Catching the Wind\" versi remix. Setelah dikasih sampel yang \"menyentuh hati\" dan iringan angin laut, suasana pesta musim panasnya makin terasa, kan?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tiba-tiba aku dapat inspirasi. Aku balik ke studio rekaman dulu, ya.",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Terima kasih atas ide kreatifmu!",
          "next": [
            202430033
          ]
