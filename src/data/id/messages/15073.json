      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt Kalian baik-baik saja?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Kalau pesannya masuk, tolong dibalas ya!",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Peringatan: Sinyal komunikasi saat ini lemah, silakan periksa status koneksi]",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@March 7th @{NICKNAME} @Sunday Oke, kami baik-baik saja.",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Kami baik-baik saja. @Dan Heng laporkan keadaanmu.",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Jangan khawatirkan kami, tadi kami mengalahkan gelombang monster bertentakel yang muncul dari bawah tanah.",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Huh ....",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ngomong-ngomong, kita harus cepat-cepat ke Astropolis gak ya? Bukan apa-apa, tapi ... aku gak percaya sama IPC.",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bisa nggak ya kita coba minta tolong ke Xianzhou atau Stasiun Luar Angkasa Nyonya Herta?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku bukannya tidak pernah memikirkan masalah ini.",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Dilihat dari segi jarak, Xianzhou maupun Stasiun Luar Angkasa Herta terlalu jauh. Mengingat situasinya mendesak, rencana penyelamatan yang paling memungkinkan saat ini tetap adalah pergi ke Astropolis.",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Daripada jarak, yang lebih merepotkan adalah Planarcadia merupakan bagian dari sistem perdagangan IPC.",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Berdasarkan Perjanjian Perdagangan Antarbintang, IPC memiliki hak prioritas untuk menanganinya. Intervensi dari pihak luar yang gegabah dapat memicu sengketa hukum dan diplomatik yang lebih rumit.",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Kalau gitu sih ... beneran udah gak ada cara lagi!",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} Tugas navigasinya kuserahkan padamu ya.",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tenang saja, aku akan bertanggung jawab.",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku tahu, aku percaya padamu.",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A-aku tidak tahu harus berbuat apa ....",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Jangan khawatir, aku percaya padamu. Sebagai navigator sementara, kamu pasti punya pemikiran sendiri.",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Situasinya kritis, kami akan mendukung segala keputusan yang kamu ambil.",
          "next": [
            150730120
          ]
        },
        "150730120": {
          "id": 150730120,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Peringatan: Sinyal komunikasi saat ini lemah, silakan periksa status koneksi]",
          "next": []
        }
