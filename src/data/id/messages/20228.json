      ],
      "messages": {
        "202280000": {
          "id": 202280000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Halo {NICKNAME}, ini aku, \"Narator\".",
          "next": [
            202280001
          ]
        },
        "202280001": {
          "id": 202280001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tanya dong. Biasa suka makan apa? Boleh kasih rekomendasi?",
          "next": [
            202280002
          ]
        },
        "202280002": {
          "id": 202280002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Sebaiknya makanan bergizi dengan harga terjangkau.",
          "next": [
            202280003,
            202280006,
            202280009
          ]
        },
        "202280003": {
          "id": 202280003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"Nasgor Diet\" gimana? Bebas asap, tanpa minyak, tanpa MSG, bergizi tapi hambar.",
          "next": [
            202280004
          ]
        },
        "202280004": {
          "id": 202280004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Atau beberapa camilan eksotis kayak sosis Belobog sama sate Xianzhou! Pakai pengiriman ekspres antarbintang, dijamin besok sampai~",
          "next": [
            202280005
          ]
        },
        "202280005": {
          "id": 202280005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tapi katanya tidak gratis ongkir. Nanti aku hitung dulu total biayanya, trims.",
          "next": [
            202280011
          ]
        },
        "202280006": {
          "id": 202280006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wah, sulit ... Makanan favoritku kayaknya kurang bergizi deh.",
          "next": [
            202280007
          ]
        },
        "202280007": {
          "id": 202280007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sate, Combo Stew, Immortal's Delight, Winged Burger, kue ....",
          "next": [
            202280008
          ]
        },
        "202280008": {
          "id": 202280008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Makananmu sudah cukup seimbang gizinya dibandingkan pola makan Detektif Abu itu.",
          "next": [
            202280011
          ]
        },
        "202280009": {
          "id": 202280009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku kira kamu cuma suka pisang.",
          "next": [
            202280010
          ]
        },
        "202280010": {
          "id": 202280010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Bukan buat aku, tapi buat Pak Ashveil.",
          "next": [
            202280011
          ]
        },
        "202280011": {
          "id": 202280011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Aku pusing. Belakangan ini Pak Ashveil selalu ikut aku makan pisang. Mungkin karena enggak mau repot, atau mau hemat.",
          "next": [
            202280012
          ]
        },
        "202280012": {
          "id": 202280012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tapi kalau kurang nutrisi kompleks yang dibutuhkan tubuh manusia, otaknya bakal jadi makin bebal.",
          "next": [
            202280013
          ]
        },
        "202280013": {
          "id": 202280013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Sudah beberapa kali dia lupa bawa ponsel. Salah satu gejala klinis kekurangan gizi tuh.",
          "next": [
            202280014
          ]
        },
        "202280014": {
          "id": 202280014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Jadi aku perlu latih ulang kebiasaan makannya.",
          "next": [
            202280015,
            202280016
          ]
        },
        "202280015": {
          "id": 202280015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eh, gimana tuh? Aku juga mau jaga kesehatan!",
          "next": [
            202280018
          ]
        },
        "202280016": {
          "id": 202280016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gokil. Kamu asisten top banget!",
          "next": [
            202280017
          ]
        },
        "202280017": {
          "id": 202280017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Dia orangnya tidak telaten, jadi aku yang harus pikirkan solusinya.",
          "next": [
            202280018
          ]
        },
        "202280018": {
          "id": 202280018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Beberapa hari pertama, aku tumbuk pisangnya sampai halus, terus diam-diam tambah buah-buahan lain.",
          "next": [
            202280019
          ]
        },
        "202280019": {
          "id": 202280019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Efeknya bagus, nafsu makan normal, tidak ada penolakan yang kentara, dan tidak ada respons stres.",
          "next": [
            202280020
          ]
        },
        "202280020": {
          "id": 202280020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Selanjutnya, aku rencana mau naikkan proporsi makanan baru secara bertahap, kayak makanan hangat yang disukai manusia, dicampur dikit-dikit.",
          "next": [
            202280021
          ]
        },
        "202280021": {
          "id": 202280021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Selain melindungi lambung dan pencernaan, juga buat indra pengecapnya minat kembali terhadap makanan manusia lainnya.",
          "next": [
            202280022
          ]
        },
        "202280022": {
          "id": 202280022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Satu rangkaian program diet minimal tujuh hari, namanya \"Metode Ganti Pakan 7 Hari\". Ilmiah banget kan!",
          "next": [
            202280023,
            202280024
          ]
        },
        "202280023": {
          "id": 202280023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Metode Ganti Pakan 7 Hari, noted Pak!",
          "next": [
            202280026
          ]
        },
        "202280024": {
          "id": 202280024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu lebih kayak majikannya.",
          "next": [
            202280025
          ]
        },
        "202280025": {
          "id": 202280025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hubungan kami masih detektif dan asisten.",
          "next": [
            202280026
          ]
        },
        "202280026": {
          "id": 202280026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Coba kulihat, kemarin 2 apel, 1 telur, 1 mangkuk beras ketan, 1 sendok pisang, dan 3 stoples garam.",
          "next": [
            202280027
          ]
        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, dia bentar lagi balik. Aku mau siapkan Tart Garam Apel Pisang dulu buat hari ini.",
          "next": [
            202280028
          ]
        },
        "202280028": {
          "id": 202280028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Sampai jumpa.",
          "next": []
        }
      },
