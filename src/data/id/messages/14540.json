          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Biarlah kekuatan yang bicara di Kejuaraan Chimera ini.",
          "next": [
