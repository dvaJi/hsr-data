          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku baru selesaikan pertandingan penentu peringkat, masih newbie.",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Jangan terlalu serius ya sama aku.",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hai rekan, jarang-jarang nih bisa adu sama kamu. Mari buktikan siapa yang lebih unggul dengan Chimera masing-masing!",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hmph, jangan malu-maluin ya, Penyelamat.",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Mau menghalangiku? Hmph, mari lihat kamu mampu atau tidak.",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Tidak masalah. Akan kusingkirkan semua rintangan di depan Kaisar.",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hai, Buabu, gimana kalau kita bikin kesepakatan? Kucuri Chimera lawan buat kamu, terus kamu pura-pura kalah lawan aku.",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Cifera, buang jauh-jauh niatmu itu. Kamu tahu, kamu tidak akan pernah bisa mengelabui benang emas.",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Gak boleh kongkalikong! \"Kami\" bakal jadi juri dan awasi semua orang!",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Jadi juri sekaligus peserta. Di mana asas keadilan?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Hmm ... Tribbie jadi peserta, Trinnon jadi juri, dan Trianne tangkap penjahat. Sempurna!",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, aku juga bakal berusaha sekuat tenaga di Kejuaraan Chimera ini.",
          "next": [
            145400018,
