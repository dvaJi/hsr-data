          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku akan kalahkan kalian dan membuktikan akulah pelatih terbaik di Amphoreus.",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
