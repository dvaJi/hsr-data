          ]
        },
        "150040104": {
          "id": 150040104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Apa yang terjadi?",
          "next": [
            150040105
          ]
        },
        "150040105": {
          "id": 150040105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tenang, aman kok. Cuma tadi pas jalan-jalan ketemu orang yang ngaku-ngaku \"Sparxie\".",
          "next": [
            150040106
          ]
        },
        "150040106": {
          "id": 150040106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Dia bilang mau singkirin aku sama {NICKNAME}, biar Kru Express gak ikutan Permainan Bulan Imajinasi.",
          "next": [
            150040107
          ]
        },
        "150040107": {
          "id": 150040107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Jadi kita harus gercep nih!",
          "next": [
            150040108
          ]
        },
        "150040108": {
          "id": 150040108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Jadi, kalian sudah putuskan?",
          "next": [
            150040109
          ]
        },
        "150040109": {
          "id": 150040109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Aku punya ide, tapi entah menurut {NICKNAME} gimana.",
          "next": [
            150040110
          ]
        },
        "150040110": {
          "id": 150040110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Aku tertarik sih ikut Permainan Bulan Imajinasi.",
          "next": [
            150040111
          ]
        },
        "150040111": {
          "id": 150040111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Aku dari tadi mikir. Kalau menang, kuasanya mau diapain? Bisa suruh Aha ngapain?",
          "next": [
            150040112
          ]
        },
        "150040112": {
          "id": 150040112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Nanti aku ngomongin lebih lanjut deh pas sempat.",
          "next": [
            150040113
          ]
        },
        "150040113": {
          "id": 150040113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "@Dan Heng, gimana situasimu?",
          "next": [
            150040114
          ]
        },
        "150040114": {
          "id": 150040114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Aku sudah hubungi utusan Xianzhou, tapi mereka juga sedang ada masalah dan mau minta bantuan.",
          "next": [
            150040115
          ]
        },
        "150040115": {
          "id": 150040115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Aku dan Sunday sedang di jalan.",
          "next": [
            150040116
          ]
        },
        "150040116": {
          "id": 150040116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Kalau butuh sesuatu, hubungi aku saja.",
          "next": [
            150040117
          ]
        },
        "150040117": {
          "id": 150040117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Oke. Himeko, selanjutnya gimana?",
          "next": [
            150040118
          ]
        },
        "150040118": {
          "id": 150040118,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku mau minta tolong kalian untuk ke sekolah lamaku, \"Akademi Graphia\".",
          "next": [
            150040119
          ]
        },
        "150040119": {
          "id": 150040119,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Lokasi Akademi Graphia]",
          "next": [
            150040120
          ]
        },
        "150040120": {
          "id": 150040120,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Di sekolah ada seorang guru bernama Bu Dollie.",
          "next": [
            150040121
          ]
        },
        "150040121": {
          "id": 150040121,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Temanku. Dia bantu simpan topeng yang diperlukan untuk mengikuti Permainan Bulan Imajinasi.",
          "next": [
            150040122
          ]
        },
        "150040122": {
          "id": 150040122,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Untuk mencegah hal-hal yang tidak diinginkan, kalian perlu temukan dia dan terima topengnya.",
          "next": [
            150040123
          ]
        },
        "150040123": {
          "id": 150040123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Oke. Kami berangkat sekarang!",
          "next": [
            150040124
          ]
        },
