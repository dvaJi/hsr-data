      ],
      "messages": {
        "150570101": {
          "id": 150570101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Hei, {F#sis}{M#bro} {NICKNAME}!",
          "next": [
            150570102
          ]
        },
        "150570102": {
          "id": 150570102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku baru mau cari kamu, kamu malah kirim pesan.",
          "next": [
            150570103
          ]
        },
        "150570103": {
          "id": 150570103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Ikatan batin kita memang kuat ya.",
          "next": [
            150570104
          ]
        },
        "150570104": {
          "id": 150570104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Ada kabar baik buat kamu.",
          "next": [
            150570105
          ]
        },
        "150570105": {
          "id": 150570105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Buku bergambar kolaborasi kita laku keras! Begitu duitnya masuk, anak-anak itu bakal selangkah lebih dekat untuk mewujudkan impian mereka~",
          "next": [
            150570106,
            150570107
          ]
        },
        "150570106": {
          "id": 150570106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mantap, semoga semuanya lancar ya.",
          "next": [
            150570108
          ]
        },
        "150570107": {
          "id": 150570107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu sudah bekerja keras, terima kasih ya.",
          "next": [
            150570108
          ]
        },
        "150570108": {
          "id": 150570108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tapi aku masih agak penasaran, sebenarnya apa tujuanmu melakukan semua ini?",
          "next": [
            150570109
          ]
        },
        "150570109": {
          "id": 150570109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku tahu kamu suka anak-anak, tapi aku tidak menyangka kamu sampai niat membuat kapal bintang yang cuma ada di dalam imajinasi.",
          "next": [
            150570110
          ]
        },
        "150570110": {
          "id": 150570110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Haha, aku tetep merasa Swooshy lebih susah dimengerti.",
          "next": [
            150570111
          ]
        },
        "150570111": {
          "id": 150570111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Meskipun ini aku yang bikin, jujur saja, aku tidak mengerti kenapa dia mau bantu aku mengurus hal-hal ribet begini.",
          "next": [
            150570112
          ]
        },
        "150570112": {
          "id": 150570112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Wishpower yang membentuknya berasal dari planet yang jauh, tapi ia belum pernah datang ke planet itu, dan imagenae juga tidak mungkin bisa menjangkau tempat sejauh itu.",
          "next": [
            150570113
          ]
        },
        "150570113": {
          "id": 150570113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Yang namanya \"Interstellar\" itu, kalaupun benaran selesai dibangun puluhan tahun lagi, ia juga tidak mungkin bisa mengendarainya ke luar angkasa.",
          "next": [
            150570114
          ]
        },
        "150570114": {
          "id": 150570114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Kalau soal ini, ia yang paling mengerti.",
          "next": [
            150570115
          ]
        },
        "150570115": {
          "id": 150570115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Tapi, ia tetap menyebut dirinya \"Kapten\", tetap berjuang keras demi masa depan yang tidak akan pernah bisa ia raih.",
          "next": [
            150570116
          ]
        },
        "150570116": {
          "id": 150570116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Sampai hari ini, aku lihat gambar terbaru yang dibagikan anak-anak, dan akhirnya aku bisa mengerti tentang Swooshy.",
          "next": [
            150570117
          ]
        },
        "150570117": {
          "id": 150570117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Masa depan yang diimpikan anak-anak ternyata keren dan mengharukan banget.",
          "next": [
            150570118
          ]
        },
        "150570118": {
          "id": 150570118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Kapten Swooshy pasti mau ini jadi masa depan yang sudah ditetapkan.",
          "next": [
            150570119,
            150570120
          ]
        },
        "150570119": {
          "id": 150570119,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku akhirnya benar-benar paham bahwa melakukan semua ini memang sepadan.",
          "next": [
            150570121
          ]
        },
        "150570120": {
          "id": 150570120,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku masih tidak paham.",
          "next": [
            150570121
          ]
        },
        "150570121": {
          "id": 150570121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Meskipun di galaksi ini cuma ada beberapa tempat yang bisa mewujudkan Wishpower secara nyata, tapi sebenarnya di tempat lain pun, Wishpower tetap sesuatu yang keren banget!",
          "next": [
            150570122
          ]
        },
        "150570122": {
          "id": 150570122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "\"Harapan\" adalah sumber energi terhebat yang bisa diciptakan manusia, lebih dahsyat dari energi nuklir, lebih dahsyat dari Imaginary.",
          "next": [
            150570123
          ]
        },
        "150570123": {
          "id": 150570123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Ia bisa membuat percikan api yang terikat nasib di jurang kegelapan, menjelma menjadi kembang api yang terbang menuju langit, bisa membuat anak-anak yang tersesat menatap lautan bintang yang jauh, dan percaya bahwa suatu hari nanti mereka bisa meraih masa depan yang belum pernah ada.",
          "next": [
            150570124
          ]
        },
        "150570124": {
          "id": 150570124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Mungkin, kilatan cahaya sesaat yang dilihat anak-anak di tengah lautan bintang yang luas itu adalah sisa cahaya dari keberangkatan Nona Himeko dan para The Nameless.",
          "next": [
            150570125,
            150570127
          ]
        },
        "150570125": {
          "id": 150570125,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kata-katamu sangat bagus, kamu punya jiwa sastra ya.",
          "next": [
            150570126
          ]
        },
        "150570126": {
          "id": 150570126,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Duh, {F#sis}{M#bro}, aku jadi salting nih.",
          "next": [
            150570129
          ]
        },
        "150570127": {
          "id": 150570127,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kenapa tiba-tiba jadi emosional begini?",
          "next": [
            150570128
          ]
        },
        "150570128": {
          "id": 150570128,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Duh, namanya juga sudah mulai tua.",
          "next": [
            150570129
          ]
        },
        "150570129": {
          "id": 150570129,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "Oke deh, sudah dulu, aku mau lanjut kerja dulu.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1108,
        8001
      ]
    }
  ]
}