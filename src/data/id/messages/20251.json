        },
        "202510006": {
          "id": 202510006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ada apa? Ragu-ragu bukan gaya kamu.",
          "next": [
            202510008
          ]
        },
        "202510007": {
          "id": 202510007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lagi berpikir keras?",
          "next": [
            202510008
          ]
        },
        "202510008": {
          "id": 202510008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aku menerima sebuah lukisan.",
          "next": [
            202510009
          ]
        },
        "202510009": {
          "id": 202510009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Lukisan \"Pearl\" yang sebelumnya dilukis di tempat oleh seorang pelukis jalanan yang memintaku menjadi model.",
          "next": [
            202510010
          ]
        },
        "202510010": {
          "id": 202510010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ruang kosong di lukisan ini sangat menegangkan ....",
          "next": [
            202510011
          ]
        },
        "202510011": {
          "id": 202510011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Karena hanya ada sebuah sayatan menggunakan pisau di atas lukisan ini.",
          "next": [
            202510012
          ]
        },
        "202510012": {
          "id": 202510012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aku sedang berpikir ... apa hubungan antara lukisan ini dan diriku ....",
          "next": [
            202510013,
            202510016
          ]
        },
        "202510013": {
          "id": 202510013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Seni memang sulit dipahami.",
          "next": [
            202510014
          ]
        },
        "202510014": {
          "id": 202510014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sebuah sayatan ... sepertinya cocok kalau taruh tisu di bawahnya — mungkin maksud pelukis itu ....",
          "next": [
            202510015
          ]
        },
        "202510015": {
          "id": 202510015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "\"Pearl, tarik aku?\"",
          "next": [
            202510019
          ]
        },
        "202510016": {
          "id": 202510016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Seni ternyata gampang dipahami.",
          "next": [
            202510017
          ]
        },
        "202510017": {
          "id": 202510017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sebuah sayatan yang merobek ruang, bukankah terlihat seperti dompet yang terbuka?",
          "next": [
            202510018
          ]
        },
        "202510018": {
          "id": 202510018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Saat kamu memasukkan tanganmu ke dalamnya, selalu ada sesuatu yang ditarik keluar ....",
          "next": [
            202510019
          ]
        },
        "202510019": {
          "id": 202510019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510020
          ]
        },
        "202510020": {
          "id": 202510020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Dugaanku dia adalah penjual kotak misteri yang menyamar, pantas dia mencegatku di tengah jalan.",
          "next": [
            202510021
          ]
        },
        "202510021": {
          "id": 202510021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tapi dekonstruksimu sangat menarik.",
          "next": [
            202510022
          ]
        },
        "202510022": {
          "id": 202510022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Seni berarti mendekonstruksi kehidupan.",
          "next": [
            202510023
          ]
        },
        "202510023": {
          "id": 202510023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Menganalisis seni juga termasuk mendekonstruksi seni.",
          "next": [
            202510024
          ]
        },
        "202510024": {
          "id": 202510024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tapi ... apakah mendekonstruksi seni bisa memberikan jawaban?",
          "next": [
            202510025
          ]
        },
        "202510025": {
          "id": 202510025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mungkin tidak. Jadi, kita harus mendekonstruksi dekonstruksi seni.",
          "next": [
            202510026,
            202510027
          ]
        },
        "202510026": {
          "id": 202510026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Apa aku memicu sesuatu? Berhenti berpikir, berhenti berpikir!",
          "next": [
            202510028
          ]
        },
        "202510027": {
          "id": 202510027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gawat, gawat. Habislah sudah, Pearl rusak.",
          "next": [
            202510028
          ]
        },
        "202510028": {
          "id": 202510028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510029
          ]
        },
        "202510029": {
          "id": 202510029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Jangan khawatir. Aku cuma terinspirasi sama kamu dan berpikir agak abstrak.",
          "next": [
            202510030
          ]
        },
        "202510030": {
          "id": 202510030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tapi aku memang punya pemahaman yang benar-benar baru tentang lukisan itu ....",
          "next": [
            202510031
          ]
        },
        "202510031": {
          "id": 202510031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mungkin ia sedang berkata ....",
          "next": [
            202510032
          ]
        },
        "202510032": {
          "id": 202510032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "\"Buka kerangnya, aku adalah mutiara.\"",
          "next": [
            202510033
          ]
        },
