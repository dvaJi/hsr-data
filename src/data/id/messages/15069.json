      ],
      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Halo, Karakter Utama",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Kalau kamu menerima pesan terjadwal ini, berarti rencanaku sudah pasti terganggu lagi dan lagi.",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Tentu saja, tidak menutup kemungkinan kamu sudah diledakkan ke angkasa oleh Stellaron, dan saat ini, yang melihat pesan ini adalah diriku di masa depan",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Tapi kurasa, ponselmu seharusnya tidak punya kualitas sebaik ini.",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asat Pramad? Kok kamu lagi?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rencanamu gagal, kami sudah mengalahkanmu!",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Nomor yang kamu hubungi tidak terdaftar, pesan gagal terkirim]",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Sejujurnya, aku tidak keberatan dengan perkembangan alur cerita ini.",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Sebaliknya, aku sangat menantikan kemenangan kalian",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ini mungkin bisa membuktikan bahwa aku salah",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Syaratnya, kalian bisa menyelesaikan permainan ini",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Siapa pun yang menang, \"Dia\" akan terbangun dan menelan kita bulat-bulat.",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Meskipun kamu tidak bisa menerima pesannya, tapi ... kenapa kamu berbuat seperti ini?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu pasti tahu apa yang mau kutanyakan.",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Nomor yang kamu hubungi tidak terdaftar, pesan gagal terkirim]",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Aduh ... kenapa begitu?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Karena Aha bersembunyi di balik layar dan mengabaikan kebusukan dunia, maka biar aku yang menggantikannya, menantang alam semesta.",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Dan sekarang, tantangan baru menanti: Kalahkan \"Voracity\" yang bangkit kembali.",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Adalah seorang pahlawan yang lahir dari Destruction, melewati berbagai tantangan, dan membawa Elation sejati kembali ke dunia",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Atau sang buas menyelesaikan balas dendamnya, membiarkan Elation menemui kebinasaan yang bermartabat sebelum terjerumus ke dalam kegilaan",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Tokoh utama, bisakah kamu menulis akhir yang lebih baik untuk lelucon ini?",
          "next": []
        }
      },
      "participatingContactsIds": [
        232,
        8001
      ]
    }
  ]
}