            202520004
          ]
        },
        "202520004": {
          "id": 202520004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Ada, ada! Katanya sih, Master Kuda QR sendiri sudah kasih otorisasi ....\" Sekarang, kita mengandalkan para ahli kreasi penggemar untuk melanjutkan Bululu!\"",
          "next": [
            202520005
          ]
        },
        "202520005": {
          "id": 202520005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Selama \"Bululu\" hiatus, biarkan aku menikmati asupan pengganti untuk memuaskan idamku!",
          "next": [
            202520006
          ]
        },
        "202520006": {
          "id": 202520006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Sayangnya, aku agak kekenyangan \"makannya\" ... terlalu banyak beli merchandise, sekarang pusing tidak tahu mau ditaruh di mana.",
          "next": [
            202520007
          ]
        },
        "202520007": {
          "id": 202520007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Eh, tepat waktu aku lagi kebingungan ....",
