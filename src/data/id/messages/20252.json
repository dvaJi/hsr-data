            202520001
          ]
        },
        "202520001": {
          "id": 202520001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Pin, Stand, figurin, tabir surya, power bank, robot pembersih vakum .... Aku! Beli! Semuanya!",
          "next": [
            202520002,
            202520003
          ]
        },
        "202520002": {
          "id": 202520002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku polisi Bululu. Evanefox, ada apa denganmu? Kamu tidak suka \"Bululu\" lagi?",
