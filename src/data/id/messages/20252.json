            202520008
          ]
        },
        "202520008": {
          "id": 202520008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Kapten \"The Foxy\", Chillfox, kasih aku inspirasi!",
          "next": [
            202520009
          ]
        },
        "202520009": {
          "id": 202520009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Di volume kedua, Chillfox menggunakan \"Lemari ESinting\" untuk menyembunyikan para rubah dan berhasil menyusup ke Bululu dengan menyusuri rantai makanan!",
          "next": [
            202520010
