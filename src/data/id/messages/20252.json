        "202520000": {
          "id": 202520000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Dalam perjalanan menuju Xianzhou, aku kunjungi semua toko kolaborasi \"The Foxy vs Bululu\".",
