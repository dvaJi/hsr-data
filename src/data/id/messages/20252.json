        },
        "202520011": {
          "id": 202520011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Jadi, aku langsung pesan 10 kulkas kolaborasi The Foxy dan 10 kulkas kolaborasi Bululu.",
