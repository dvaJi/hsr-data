      ],
      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Versi plug-in \"Alat Pencari Blade\" telah diperbarui untukmu",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Update kali ini: Memperbaiki masalah yang diketahui, meningkatkan performa peredam getaran, menonton lebih banyak video Camilan Kucing.",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Kamu menepuk ponsel Blade dan membuatnya bergetar.",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu Blade sedang online",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kebetulan, tadi aku baru kepikiran kamu.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wah, aku gak nyangka loh! Coba kasih tahu aku, kamu kepikiran tentang apa?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Akhirnya kamu mau nostalgia sama aku ya?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bukan.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tadi aku lihat beberapa benda yang sudah rusak parah di Gudang Senjata, tapi materialnya masih lumayan bagus ... Tidak ada yang mengakuinya, jadi itu pasti peninggalanmu.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kebetulan kamu mengirim pesan, jadi aku sekalian tanya kamu mau apa? Nanti waktu pulang, aku bisa modifikasi dan tempa ulang.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Peninggalanku? Senjata?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Beberapa benda yang sudah hancur dan tidak berbentuk. Melihat strukturnya, sepertinya semuanya peralatan rumah tangga sehari-hari.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Manfaatkan yang ada dengan semaksimal mungkin. Katakan saja, aku bisa membuat apa pun.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Perjalanan Antarbintang berenergi tinggi membutuhkan sebuah \"mesin pengantar tidur\" yang bisa langsung membuatku tidur kapan pun dan di mana pun.",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dulu di Xianzhou, kami menyebutnya \"ranjang ayun\".",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku mau sesuatu yang tidak biasa.",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tidurmu nyenyak tidak?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Beberapa waktu lalu di kapal, aku menempa beberapa alat bantu tidur. Bagaimana menurutmu?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku mau yang lebih hebat! Aku butuh sesuatu yang bisa langsung membuatku tidur kapan pun dan di mana pun.",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Boleh.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku tidak pilih-pilih kok, berkreasi saja sesukamu!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Beberapa waktu lalu di kapal, aku menempa beberapa alat bantu tidur. Bagaimana menurutmu?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Hore! Aku mau mesin pengantar tidur yang bisa langsung membuatku tidur kapan pun dan di mana pun.",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Boleh.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kalau cuma supaya tidur sih tidak sulit ... tapi kalau butuh efek tidur paksa, butuh desain tambahan.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bisa tambah sedikit derau putih, supaya bisa tidur lebih cepat.",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sangat sederhana. Tambahkan beberapa potongan besi untuk meniru suara tempaan pedang.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dulu suara seperti ini membuatku tetap terjaga. Tapi ini mungkin bisa membuatmu tidur.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bisa tambah fitur bantuan tidur fisik? Misalnya pijatan, bantal tepuk, atau apa gitu?",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Oke.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ada komponen persendian lengan mekanis yang sudah tidak terpakai di ruang peralatan, bisa meniru gerakan ini.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tapi agak berisik ... aggap saja derau putih.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bisa tambah lagu pengantar tidur yang ada vokalnya?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Oke.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Di dalamnya ada pemutar suara, bisa merekam satu lagu.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tapi suara nyanyianku jelek, kalau mau aku bisa bacakan untukmu ... lirik lagunya.",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Oke deh, begitu juga boleh ....",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kalau sudah dimodifikasi, terserah kamu mau diantar atau ambil sendiri.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Nanti kita mengobrol lagi.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sampai jumpa.",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu Blade sedang offline",
          "next": []
        }
      },
