      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Menu makan siang Birdie hari ini: Jagung, kinoa, dan kacang polong tumbuk (jangan lupa air minum!).",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Makanannya sayur semua ... nggak ada daging sama sekali?",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ternyata jaga tenggorokan harus makan ini, ya? Profesional banget! Pantes jadi diva!",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sori! Sebenarnya aku mau kirim ke diri sendiri, salah pencet.",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Masih inget, nggak? Aku pernah bilang aku nemu seekor anak burung yang sayapnya patah.",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Resep di atas bukan makan siangku, tapi buat burung kecil itu.",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sekarang ia udah pulih, bulu baru di sayapnya juga udah tumbuh.",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sebentar lagi aku sampe di rumah, nanti aku kasih liat bentuknya yang sekarang.",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Burung kecil melihara burung kecil. Duuh ... mengharukan banget.",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Burung kecil peliharaan burung kecil pasti udah jadi burung gembul yang gede, ya!",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Teman baikmu, Robin sudah offline",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Teman baikmu, Robin sudah online",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Temanmu sedang mengetik ....",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aku udah sampe di rumah, tapi burung kecilnya ilang.",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Kayaknya dia terbang lewat jendela yang kebuka.",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ah ... jangan sedih, mungkin ia udah dambain bisa terbang bebas.",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Terima kasih udah ngehibur, perasaan aku sama kayak kamu~",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aku memang selalu nantiin ia bisa terbang bebas ke angkasa lagi.",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Walau agak tiba-tiba ... tapi kamu juga nantiin ia bisa terbang bebas ke langit lagi, kan?",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mm, kamu benar.",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mulai sekarang, burung kecil itu udah mulai kehidupan dan petualangan barunya! Ia pasti nggak bakal ngelupain kamu.",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ya! Sebenarnya, aku memang selalu nantiin ia bisa terbang bebas ke angkasa lagi.",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Biasanya, ia suka terbang ke ambang jendela dan ngeliatin dunia luar. Kali ini, ia pasti udah siap terbang sendiri.",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Walau aku agak sayang karena nggak bisa lihat dia bentangin sayap dan terbang tinggi.",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "*Cit-cit! Kur-kur! Cuit-cuit-cuit!*",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Pesan suara sudah selesai dikonversi (nada tinggi dan bebas terdeteksi)",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, ini tiga musisi kecil di sebelahku.",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mereka bilang, burung kecil itu pasti cantik banget waktu terbang.",
          "next": [
            202450029
          ]
        },
