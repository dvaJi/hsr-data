          ]
        },
        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Baguslah kalau begitu!",
          "next": [
            202020018
          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku suka tidur, suka makan, tapi tidak suka gerak ... Aku masih ada harapan tidak, Dok?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Kalau badanmu pengin tidur, tidurlah~ Kamu pasti kelelahan. Jangan memaksakan diri ya.",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Kalau mau makan sehat dan enak, ada caranya kok!",
          "next": [
