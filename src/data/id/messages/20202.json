            202020007
          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Tapi aku memang mau cari Rambut Abu~ Soalnya pertarungan terakhir bukan hal sepele.",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Lukamu sudah sembuh? Tidurmu nyenyak tidak? Nafsu makanmu bagus? Apa kamu merasa capek waktu kerja? Ada yang tidak nyaman?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aman! Aku baik-baik saja kok!",
          "next": [
