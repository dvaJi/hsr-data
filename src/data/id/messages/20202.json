        "202020006": {
          "id": 202020006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Ah, tidak apa-apa! Tadi Little Ica lewat di atas kakiku dan tidak sengaja pencet auto-text.",
