      "messages": {
        "201770000": {
          "id": 201770000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ayo, ada imbalannya.",
          "next": [
            201770001,
            201770002
          ]
        },
        "201770001": {
          "id": 201770001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Berapa? Aku tidak asal terima kerjaan.",
          "next": [
            201770003
          ]
        },
        "201770002": {
          "id": 201770002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mau uji apa lagi? Sekarang harga jasaku sudah naik.",
          "next": [
            201770003
          ]
        },
        "201770003": {
          "id": 201770003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sedang menerima lampiran \"Daftar Pembelian Pakaian Baru dan Panduan Penyimpanan\"",
          "next": [
            201770004
          ]
        },
        "201770004": {
          "id": 201770004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "File terlalu besar, tidak dapat diunduh",
          "next": [
            201770005
          ]
        },
        "201770005": {
          "id": 201770005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Cepat tingkatkan sistem pesan.",
          "next": [
            201770006
          ]
        },
        "201770006": {
          "id": 201770006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Begini, aku baru saja beli beberapa baju, tapi para puppet saja sudah kewalahan membereskannya.",
          "next": [
            201770007,
            201770008
          ]
        },
        "201770007": {
          "id": 201770007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Beli berapa banyak? Bagi satu dong.",
          "next": [
            201770009
          ]
        },
        "201770008": {
          "id": 201770008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aku {NICKNAME}, bagi dong.",
          "next": [
            201770009
          ]
        },
        "201770009": {
          "id": 201770009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Kamu mana bisa pakai.",
          "next": [
            201770010
          ]
        },
        "201770010": {
          "id": 201770010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Aku beli buat para puppet.",
          "next": [
            201770011,
            201770013
          ]
        },
        "201770011": {
          "id": 201770011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Puppet perlu ganti baju?",
          "next": [
            201770012
          ]
        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Iya dong! Wajah cantik-cantik begitu, mana tahan tidak belikan baju cantik buat mereka?",
          "next": [
            201770015
          ]
        },
        "201770013": {
          "id": 201770013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sial, puppet saja punya lebih banyak baju dariku.",
          "next": [
            201770014
          ]
        },
        "201770014": {
          "id": 201770014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Baru sadar?",
          "next": [
            201770015
          ]
        },
        "201770015": {
          "id": 201770015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Kali ini ada macam-macam gaya. Pas dibereskan wajib sesuai kategori ya.",
          "next": [
            201770016
          ]
        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Kelihatan berkelas dalam pandangan pertama, jelas itu pakaian andalanku. Mudah dikenali. Rapikan yang ini dulu.",
          "next": [
            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Yang direkomendasikan Ruan Mei itu-itu doang. Taruh saja sama yang di atas.",
          "next": [
            201770018
          ]
        },
        "201770018": {
          "id": 201770018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Makin mencolok warnanya, makin cocok di bagian retro.",
          "next": [
            201770019
          ]
        },
        "201770019": {
          "id": 201770019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Yang polanya sulit digambarkan dan membingungkan, taruh di bagian haute couture.",
          "next": [
            201770020
          ]
        },
        "201770020": {
          "id": 201770020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Sisanya, tinggal ikuti panduan.",
          "next": [
            201770021
          ]
        },
        "201770021": {
          "id": 201770021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Lawan bicara sudah mengirimkan lokasinya",
          "next": [
            201770022
          ]
        },
        "201770022": {
          "id": 201770022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Alamat lemari bajunya sudah kukirim, seharusnya tidak jauh dari koordinatmu.",
          "next": [
            201770023
          ]
        },
        "201770023": {
          "id": 201770023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Kalau kamu lihat sebuah stasiun luar angkasa kecil, itulah tempatnya.",
          "next": [
            201770024
          ]
        },
        "201770024": {
          "id": 201770024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Tidak usah pusing, pasti muat.",
          "next": [
            201770025,
            201770027
          ]
        },
        "201770025": {
          "id": 201770025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hah? Stasiun luar angkasa? Asta tahu tentang ini tidak?",
          "next": [
            201770026
          ]
        },
        "201770026": {
          "id": 201770026,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bayar dulu. Baru aku kerja.",
          "next": [
            201770029
          ]
        },
        "201770027": {
          "id": 201770027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu beli satu lemari baju stasiun luar angkasa khusus buat puppet? Asta tahu tidak nih?",
          "next": [
            201770028
          ]
        },
        "201770028": {
          "id": 201770028,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bayar dulu. Baru aku kerja.",
          "next": [
            201770029
          ]
        },
        "201770029": {
          "id": 201770029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Sisanya, cari Asta saja.",
          "next": [
            201770030
          ]
        },
        "201770030": {
          "id": 201770030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sedang menghubungkan dengan temanmu Asta",
