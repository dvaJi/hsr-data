      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Yo~ Katanya, kamu baru saja menelan pil pahit, ya? Akhirnya kamu merasakan apa yang aku rasakan selama ini?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kok kamu tahu saja sih? Kejadiannya kurang dari satu menit yang lalu, tapi kamu sudah tahu?",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Senang, ya? Akhirnya kamu punya bahan buat menertawakan aku?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Begini-begini aku punya beberapa anak buah hantu di Pusat Ketenagakerjaan Pascakematian. Mereka sudah siap-siap di sekitar sana sejak awal dan menyiarkan seluruh kejadiannya buat aku.",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Yah, aku juga bukan datang khusus buat mencemooh, aku tahu cara yang bisa membantu kamu.",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Kita bicarakan detailnya waktu bertemu saja. Aku ada di dekat sini, temui aku.",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Skott membagikan lokasi",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kamu mau bantu aku? Kok tiba-tiba baik banget?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Kamu ini masih saja curigaan.",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Ayo, datang dan mengobrol dulu sama aku. Aku kan tidak mungkin menang lawan kamu, apa sih yang kamu takutkan?",
          "next": [
            150930110
          ]
        },
        "150930110": {
          "id": 150930110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Cepat ya, aku masih punya banyak pekerjaan.",
          "next": []
        }
      },
