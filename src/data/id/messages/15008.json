      "messages": {
        "150080101": {
          "id": 150080101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME}, @March 7th, kalian baik-baik saja?",
          "next": [
            150080102
          ]
        },
        "150080102": {
          "id": 150080102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Katanya kalian berdua ketemu masalah.",
          "next": [
            150080103
          ]
        },
        "150080103": {
          "id": 150080103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Apa yang terjadi?",
          "next": [
            150080104
          ]
        },
        "150080104": {
          "id": 150080104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tenang, aman kok. Cuma tadi pas jalan-jalan ketemu orang yang ngaku-ngaku \"Sparxie\".",
          "next": [
            150080105
          ]
        },
        "150080105": {
          "id": 150080105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Dia bilang mau singkirin aku sama {NICKNAME}, biar Kru Express gak ikutan Permainan Bulan Imajinasi.",
          "next": [
            150080106
          ]
        },
        "150080106": {
          "id": 150080106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Jadi kita harus gercep nih!",
          "next": [
            150080107
          ]
        },
        "150080107": {
          "id": 150080107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Jadi, kalian sudah putuskan?",
          "next": [
            150080108
          ]
        },
        "150080108": {
          "id": 150080108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Aku punya ide, tapi entah menurut {NICKNAME} gimana.",
          "next": [
            150080109
          ]
        },
        "150080109": {
          "id": 150080109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku tertarik sih ikut Permainan Bulan Imajinasi.",
          "next": [
            150080110
          ]
        },
        "150080110": {
          "id": 150080110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aku dari tadi mikir. Kalau menang, kuasanya mau diapain? Bisa suruh Aha ngapain?",
          "next": [
            150080111
          ]
        },
        "150080111": {
          "id": 150080111,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nanti aku ngomongin lebih lanjut deh pas sempat.",
          "next": [
            150080112
          ]
        },
        "150080112": {
          "id": 150080112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@Dan Heng, gimana situasimu?",
          "next": [
            150080113
          ]
        },
        "150080113": {
          "id": 150080113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Aku sudah hubungi utusan Xianzhou, tapi mereka juga sedang ada masalah dan mau minta bantuan.",
          "next": [
            150080114
          ]
        },
        "150080114": {
          "id": 150080114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Aku dan Sunday sedang di jalan.",
          "next": [
            150080115
          ]
        },
        "150080115": {
          "id": 150080115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Kalau butuh sesuatu, hubungi aku saja.",
          "next": [
            150080116
          ]
        },
        "150080116": {
          "id": 150080116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Oke. Himeko, selanjutnya gimana?",
          "next": [
            150080117
          ]
        },
        "150080117": {
          "id": 150080117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Aku mau minta tolong kalian untuk ke sekolah lamaku, \"Akademi Graphia\".",
          "next": [
            150080118
          ]
        },
        "150080118": {
          "id": 150080118,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Lokasi Akademi Graphia]",
          "next": [
            150080119
          ]
        },
        "150080119": {
          "id": 150080119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Di sekolah ada seorang guru bernama Bu Dollie.",
          "next": [
            150080120
          ]
        },
        "150080120": {
          "id": 150080120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Temanku. Dia bantu simpan topeng yang diperlukan untuk mengikuti Permainan Bulan Imajinasi.",
          "next": [
            150080121
          ]
        },
        "150080121": {
          "id": 150080121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Untuk mencegah hal-hal yang tidak diinginkan, kalian perlu temukan dia dan terima topengnya.",
          "next": [
            150080122
          ]
        },
        "150080122": {
          "id": 150080122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Oke. Kami berangkat sekarang!",
          "next": [
            150080123
          ]
        },
        "150080123": {
          "id": 150080123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Nanti aku dan Welt susul.",
          "next": []
        }
