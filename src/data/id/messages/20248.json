          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Anak kecil itu bilang, orang dewasa nggak butuh sekop plastik dan camilan. Terus, kalau taruhannya nggak setara, nggak adil.",
