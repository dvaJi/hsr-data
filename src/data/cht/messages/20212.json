        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "你尾隨失戀的大地獸，又趁它不注意，與它合影，留下一張智者不入愛河的自拍",
