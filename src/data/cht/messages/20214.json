            202140001
          ]
        },
        "202140001": {
          "id": 202140001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我也憑此研究，學習，收錄宇宙間不同生物的語種和語言，相較之前已有更多累積。",
          "next": [
            202140002
          ]
        },
        "202140002": {
          "id": 202140002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "如果遇見無法溝通的生物，隨時找我。",
          "next": [
            202140003,
            202140008
          ]
        },
        "202140003": {
          "id": 202140003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "丹恆老師，小貓開心的時候怎麼說話？",
          "next": [
            202140004
          ]
        },
        "202140004": {
          "id": 202140004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "…稍等。",
          "next": [
            202140005
          ]
        },
        "202140005": {
          "id": 202140005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "喵——咕嚕嚕。轟隆隆，隆隆隆隆。",
          "next": [
            202140006
          ]
        },
        "202140006": {
          "id": 202140006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成",
          "next": [
            202140007
          ]
        },
        "202140007": {
          "id": 202140007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我模仿了一段。這時，它們普遍會表達：喜歡，還要，繼續。",
          "next": [
            202140014
          ]
        },
        "202140008": {
          "id": 202140008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "丹恆老師，小狗無聊的時候怎麼說話？",
          "next": [
            202140009
          ]
        },
        "202140009": {
          "id": 202140009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "…稍等。",
          "next": [
            202140010
          ]
        },
        "202140010": {
          "id": 202140010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "叮鈴咣噹。啪嗒啪嗒。汪汪汪。嗝嗝。唉。",
          "next": [
            202140011
          ]
        },
        "202140011": {
          "id": 202140011,
          "type": "Text",
