          ]
        },
        "202140012": {
          "id": 202140012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我模仿了一段。它們無聊時，通常還會走來走去，不只在說話。",
          "next": [
            202140013
          ]
        },
        "202140013": {
          "id": 202140013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "通常表達的是：一起玩，出去玩。",
          "next": [
            202140014
          ]
        },
        "202140014": {
          "id": 202140014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
