      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "小鳥今日午餐：玉米、藜麥、豌豆泥（一定要記得喝水！）",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "好像都是素食，怎麼沒有肉！",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "原來保護喉嚨要吃這些嗎，好講究！不愧是大明星！",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "抱歉！原本想存起來，結果點錯了",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "你還記不記得，之前我和你說撿到了一隻翅膀折斷的小雛鳥",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "上面的食譜不是我的午餐，是那隻小鳥的",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "現在牠已經康復了，翅膀也長出了新的羽毛",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我等下就到家了，可以給你看看牠現在的樣子",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鳥養小鳥，心暖暖的",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鳥養的小鳥，一定已經圓滾滾了吧！",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 知更鳥 已離線",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 知更鳥 已上線",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "對方正在輸入中",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我到家了，但小鳥不見了",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "窗戶開著，應該是飛走了",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "啊…不要難過，說不定是因為牠開始嚮往自由飛翔的生活",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "謝謝你的安慰，我也這麼覺得～",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我一直在期待牠再次飛向天空的一天",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "雖然好突然…但你也在期待著牠再次飛向天空的這一天吧？",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "嗯，你果然明白",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鳥開始牠新的鳥生和冒險了！牠也一定不會忘記你",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "嗯！其實我一直期待牠再次飛向天空的一天",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "往常牠也會飛到窗簷上看看外面的世界。這一次，牠一定是做好準備了",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "雖然很可惜，沒看到牠展翅高飛的樣子",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "嘰嘰！咕咕！啾啾啾！",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成（檢測到自由的高音）",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "哈哈，是我身邊的三位小樂手",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "說小鳥飛起來的樣子，一定很美",
          "next": [
            202450029
          ]
        },
