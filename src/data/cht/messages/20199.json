  "sections": [
    {
      "id": 2019900,
      "startingMessageId": [
        201990000
      ],
      "messages": {
        "201990000": {
          "id": 201990000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "{NICKNAME}閣下，打擾了",
          "next": [
            201990001
          ]
        },
        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "閣下還記得我養的兩隻小奇美拉嗎？我發現它們很喜歡聽著童話故事入眠",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "最近想開拓一些寫作的新思路，因此我正打算試寫一篇",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "這次是什麼樣的新故事？",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "有我的戲份嗎？",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "可以有",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "其實正打算問問閣下的意見，目前的構思是：",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "主人公意外進入了一座小鎮，鎮裡住著貓咪和小鼠，會唱歌的烏鴉，粉粉的小豬，和齊心協力的螞蟻家族",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "它們很通人性，喜歡和主人公一起玩耍，也很喜歡聽故事",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "不，是非常，非常喜歡…",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "當童話鎮進入深夜，一切都安靜下來…小動物們卻睡不著…",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "「這裡不能安靜」、「這裡不能安靜」，它們說…",
          "next": [
            201990012
          ]
        },
        "201990012": {
          "id": 201990012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "於是，它們來到主人公的床邊",
          "next": [
            201990013
          ]
        },
        "201990013": {
          "id": 201990013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "就這樣",
          "next": [
            201990014
          ]
        },
        "201990014": {
          "id": 201990014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "●_●",
          "next": [
            201990015
          ]
        },
        "201990015": {
          "id": 201990015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◕_◕",
          "next": [
            201990016
          ]
        },
        "201990016": {
          "id": 201990016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◐‿◑",
          "next": [
            201990017
          ]
        },
        "201990017": {
          "id": 201990017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "看著你",
          "next": [
            201990018,
            201990021,
            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "是這樣的「童話」故事？那麼恐怖？",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "啊，果然很恐怖嗎？",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "不瞞你說，我寫到一半才發現，可能這個題材更適合寫進恐怖小說",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "不過，還滿可愛的",
          "next": [
            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "不瞞你說，我寫到一半才發現，可能這個題材更適合寫進恐怖小說",
          "next": [
            201990023
          ]
        },
        "201990023": {
          "id": 201990023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "但從閣下的反應來看，恐怖元素恐怕還不夠",
          "next": [
            201990027
          ]
        },
        "201990024": {
          "id": 201990024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "那麼哪裡可以安靜？",
          "next": [
            201990025
          ]
        },
        "201990025": {
          "id": 201990025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "果然，閣下的關注點總是如此與眾不同",
          "next": [
            201990026
          ]
        },
        "201990026": {
          "id": 201990026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "不瞞你說，我寫到一半才發現，可能這個題材更適合寫進恐怖小說",
          "next": [
            201990027
          ]
        },
        "201990027": {
          "id": 201990027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": [
            201990028
          ]
        },
        "201990028": {
          "id": 201990028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "但我對恐怖小說涉獵不深，為了更有代入感，也找了一些參考書，比如《未解謎案20件》、《消失的諸因》……",
          "next": [
            201990029
          ]
        },
        "201990029": {
          "id": 201990029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "今天剛讀完《好好吃飯》，感覺有一些不錯的點子",
          "next": [
            201990030
          ]
        },
        "201990030": {
          "id": 201990030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "等我有進度之後，再來和閣下交流",
          "next": [
            201990031
          ]
        },
        "201990031": {
          "id": 201990031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "放心，小奇美拉們也會天天催稿，它們最愛聽故事了",
          "next": [
            201990032
          ]
        },
        "201990032": {
          "id": 201990032,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": []
        }
      },
