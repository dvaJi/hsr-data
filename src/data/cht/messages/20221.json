        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "末日獸、幻朧、鐵墓……",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我很好奇，在與它們親切會面時，你是什麼心情",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "爽。甚至不用動手，看著他們就好",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯～光眼神就可以殺人～",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "很遺憾，我心無波瀾，沒有感情",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯，鐵面無私～",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "絕對按部就班",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "你一拳我一拳，就解決了",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯～回合制～",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "毀滅絕非壯烈的一瞬…但它的美麗一定毋庸置疑",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "你會堅持這條道路，一直「開拓」下去",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "直至…毀滅「毀滅」對嗎？",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "要加入我們嗎？反正你也背叛「毀滅」了",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我期待那一天的到來",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "不過，如果跟「開拓」對立",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "你還會回到「毀滅」嗎？二度背叛怎麼不算是一種背叛",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "這個主意不錯，我喜歡",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "若跟「開拓」對立",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "則能步入你點燃的焰火",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "那就如他們「劇本」所說",
          "next": [
            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "成為毀滅「記憶」的絕滅大君，也是一個不錯的選擇",
          "next": [
            202210024
          ]
        },
