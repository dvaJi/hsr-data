          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "我重新整理了一下手提箱，翻找到一張二相樂園全境理髮沙龍通用的終身會員卡",
          "next": [
            202410001
          ]
        },
        "202410001": {
          "id": 202410001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "送給誰好呢？",
          "next": [
            202410002,
            202410004,
            202410007
          ]
        },
        "202410002": {
          "id": 202410002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我乃全車唯一未成年，送我！",
          "next": [
            202410003
