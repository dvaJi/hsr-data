            202270003
          ]
        },
        "202270003": {
          "id": 202270003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "忙完這陣子我也有個假期，提前和你求教一下有什麼抒壓放鬆的好辦法",
