          ]
        },
        "202270006": {
          "id": 202270006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "出門閒逛，花錢消費，對自己好點",
          "next": [
            202270007
          ]
        },
        "202270007": {
          "id": 202270007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "除了打牌，爻老闆還會怎麼做呢？",
          "next": [
            202270011
          ]
        },
        "202270008": {
          "id": 202270008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "活絡筋骨——強身健體，出門旅遊，或者",
          "next": [
            202270009
          ]
        },
        "202270009": {
          "id": 202270009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "換個地方打電動",
          "next": [
            202270010
          ]
        },
        "202270010": {
          "id": 202270010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "除了打牌，爻老闆還會怎麼做呢？",
          "next": [
            202270011
