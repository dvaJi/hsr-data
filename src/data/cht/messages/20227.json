          ]
        },
        "202270012": {
          "id": 202270012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "趁著休假，要來加速刷新各地兆算玉璃和枘鑿六合的速通紀錄",
          "next": [
            202270013
          ]
        },
        "202270013": {
          "id": 202270013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "還有解解仙舟五財三算謎題，推演諦聽一大家子的天干地支",
