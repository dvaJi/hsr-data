          ]
        },
        "202530012": {
          "id": 202530012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "在仙舟試鏡呢！",
          "next": [
            202530013
          ]
        },
        "202530013": {
          "id": 202530013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "路上碰到一位幻戲導演，說我耳朵尖尖，骨骼驚奇",
          "next": [
            202530014
          ]
        },
        "202530014": {
          "id": 202530014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "直接把我拉到劇團裡，要我演一個心狠手辣的狐人妖姬",
          "next": [
            202530015
          ]
        },
        "202530015": {
          "id": 202530015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "可惜我好像不太適合這類角色",
          "next": [
            202530016
          ]
        },
        "202530016": {
          "id": 202530016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "試鏡的台詞唸了好幾遍，都沒有導演要的什麼……殺人不眨眼、曼麗又繾綣的氛圍",
          "next": [
            202530017
          ]
        },
        "202530017": {
          "id": 202530017,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1505,
          "next": [
            202530018,
            202530019
          ]
        },
        "202530018": {
          "id": 202530018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "緋英，我從隨便什麼幻戲……第一季第一集開始就是你的粉絲了！",
          "next": [
            202530020
          ]
        },
        "202530019": {
          "id": 202530019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "非得是狐妖嗎？要不我們嘗試其他角色看看，比如仙舟……「英」豪？",
          "next": [
            202530021
          ]
        },
        "202530020": {
          "id": 202530020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "謝謝！我也是你的粉絲",
          "next": [
            202530022
          ]
        },
        "202530021": {
          "id": 202530021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "知我心，莫如你！",
          "next": [
            202530022
          ]
        },
        "202530022": {
          "id": 202530022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "導演還有部《臥狐藏朧》在招武打演員，就讓我試了另一個角色——",
          "next": [
            202530023
          ]
        },
        "202530023": {
          "id": 202530023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "不以規矩，不成方圓，我以三尺長劍，裁定廟堂——幻月盟執法緋英，請閣下賜教！",
          "next": [
            202530024
          ]
        },
        "202530024": {
          "id": 202530024,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成",
          "next": [
