          ]
        },
        "202530025": {
          "id": 202530025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "主要是片場的鱗淵境大戰太震撼了，看得我水靈根都要覺醒了",
          "next": [
            202530026
          ]
        },
        "202530026": {
          "id": 202530026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "於是文戲打戲一氣呵成！導演也誇我是天賦型演員！",
          "next": [
            202530027
          ]
        },
