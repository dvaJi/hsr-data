      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}，剛才我在海邊，又蒐集到一些聲音取樣",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "比如椰子滾落在地的聲音，汽水滿盈冒泡，鐵板上滋滋作響的魷魚……",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "對方正在輸入中",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "看得我都餓了，想要吃個兩串魷魚",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "其實我也……",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "音樂真香……不是，魷魚真好聽",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "哈哈，跟沒有靈感時的大腦空空相比，被味道刺激一下更有精神了",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "其實還有一些更有海邊氛圍的聲音，你聽",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "這是海浪回退時：刷啦啦——咕嚕咕嚕咕嚕咕嚕——",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成（檢測到氣泡音）",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "海風穿過生鏽的船錨：咻——嗡——咻——嗡——",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成（檢測到低音炮）",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "海鷗飛過：沙沙——呼呼——咕咕——啊！",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "語音訊息轉換完成（檢測到鳥叫聲）",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "抱歉，那聲「啊」是我…剛剛手上的零食被海鷗搶走了…",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "現在取樣數量已經夠了，但總覺得缺少「直擊心靈」的聲音",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}有靈感嗎？要能瞬間提振精神的聲音喔",
