          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "但我確實要來找灰寶～畢竟，大決戰可不是件輕鬆的事",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "受傷有好轉嗎？覺睡得好嗎？吃飯有胃口嗎？工作會感到疲乏嗎？有什麼其他不舒服嗎？",
          "next": [
