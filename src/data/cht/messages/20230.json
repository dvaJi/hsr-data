            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "欸！！！要是買得起狗糧我就自己養了",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "委託人說了，小狗又稱吞金獸…我可不能讓小狗跟著我吃苦",
          "next": [
            202300019
