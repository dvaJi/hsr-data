        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "世界上怎麼會有這麼可愛的生物",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "爪子軟軟的，聞起來還像米飯一樣香",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "可惜我的鏡頭壞了，不能幫天使小狗拍照",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "同意！小狗拯救世界！",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "你養狗了？送我摸摸",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "很可惜，是委託人的小狗",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "不好意思，我是貓派",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "噢，這樣啊",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "有位不能透露身分的重要人物，今早收到了一封來路不明的威脅信",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "只寫了四個字：「要你狗命」",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "我一刻也沒猶豫，立刻接了這份委託",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "現在，沒人敢動小狗一根狗毛",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "有沒有可能，狗不是名詞？",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "哦，你是說委託人？我當然知道，放心，老白去保護他了",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "比起金主，小狗更需要我",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我看明明是你更需要牠",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我看你乾脆養隻狗吧，省得整天吸別人家的",
