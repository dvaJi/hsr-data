      ],
      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "已為你更新「找刃神器」擴充功能版本",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "本次更新：修正了已知問題、提升了緩震效能、看了更多貓糕影片",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "你拍了拍 刃 的手機並震了一下",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 刃 已上線",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "正好，剛想到你。",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "受寵若驚啊！分享一下怎麼想的？",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "終於要和我敘舊了嗎？",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "不是。",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "對方正在輸入中",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "先前在軍火庫看到幾件磨損嚴重，但材質尚可的器物…無人認領，應是你過去留下的。",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "正巧你傳訊息，便問問，你想要什麼？之後回去，我可以改造重鑄。",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "我留下了什麼？武器嗎？",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "幾件已面目全非的物什，看構造應該都是日常家用。",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "物盡其用，你說，我都可以造。",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "高精力星際旅行，需要一個可以隨時隨地，能立刻哄我入睡的「哄睡機」",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "過去在仙舟，我們叫它「搖籃床」。",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "想要點不太日常的東西",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "你睡得好嗎？",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "前段時間在飛船上鑄造了幾件有助睡眠的器具。你意向如何？",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "那我要升級！想要一個可以隨時隨地，能立刻哄我入睡的東西",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "可以。",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我不挑，你隨便造！",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "前段時間在飛船上鑄造了幾件有助睡眠的器具。你意向如何？",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "好耶，我想要一個可以隨時隨地，能立刻哄我入睡的哄睡機",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "可以。",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "哄睡不難，但達到強制入睡效果，需要額外設計。",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "可以加點白噪音，入睡更快",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "很簡單。加幾個鐵片，可以模擬鑄劍時的嗡鳴。",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "雖然這種聲音過去會令我更有精神。不過對你來說，或許能催眠。",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "可以加點物理助眠功能？按摩、拍拍枕頭什麼的？",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "……好。",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "工具間有廢棄的機械臂關節部件，可以模擬這些動作。",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "只是噪音有些大，就當是白噪音吧。",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "可以加點帶人聲的搖籃曲？",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "……好。",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "內嵌一個播音機，可以錄一首進去。",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "但我唱歌不好聽，頂多念一些…歌詞給你。",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "好好好，此番美景這種也可以……",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "改造好後，寄送或上門自取，看你。",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "之後聯絡。",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "再見。",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 刃 已下線",
          "next": []
        }
      },
