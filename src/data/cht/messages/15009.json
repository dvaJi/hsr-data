      "messages": {
        "150090101": {
          "id": 150090101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "你好，我是查令舊書店的店長，冒昧打擾了",
          "next": [
            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "請問你剛剛是否找到了一份屬於《浮脂記事》的文字？",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "有是有",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "不過你怎麼知道？",
          "next": [
            150090105
          ]
        },
        "150090105": {
          "id": 150090105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "是廣場上的《浮脂記事》告訴我的",
          "next": [
            150090106
          ]
        },
        "150090106": {
          "id": 150090106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "剛才書頁上浮現出了你拯救它的英勇模樣",
          "next": [
            150090115
          ]
        },
        "150090107": {
          "id": 150090107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "《浮脂記事》是什麼？",
          "next": [
            150090108
          ]
        },
        "150090108": {
          "id": 150090108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "有點印象，又沒有印象",
          "next": [
            150090109
          ]
        },
        "150090109": {
          "id": 150090109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "是一本書，也是一個幻造種",
          "next": [
            150090110
          ]
        },
        "150090110": {
          "id": 150090110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "還記得嗎，你之前路過廣場的時候有看過",
          "next": [
            150090115
          ]
        },
        "150090111": {
          "id": 150090111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "啊？你找錯人了吧？",
          "next": [
            150090112
          ]
        },
        "150090112": {
          "id": 150090112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "不會錯的，《浮脂記事》上浮現出了你拯救它的英勇模樣",
          "next": [
            150090113
          ]
        },
        "150090113": {
          "id": 150090113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "這不是電信詐騙，你可以自己來廣場這邊看看",
          "next": [
            150090114
          ]
        },
        "150090114": {
          "id": 150090114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "《浮脂記事》是一本書，也是一個幻造種",
          "next": [
            150090115
          ]
        },
        "150090115": {
          "id": 150090115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "它就躺在廣場中間的草坪上，你隨時可以過來",
          "next": [
            150090116
          ]
        },
        "150090116": {
          "id": 150090116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "就像你剛剛獲得的那份文字一樣",
          "next": [
            150090117
          ]
        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "失落的《浮脂記事》包含著關於古弁才天國文明起源的珍貴傳說",
          "next": [
            150090118
          ]
        },
        "150090118": {
          "id": 150090118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "那麼，不見不散",
          "next": []
        }
      },
