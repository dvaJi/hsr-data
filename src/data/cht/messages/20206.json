            202060009
          ]
        },
        "202060009": {
          "id": 202060009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "阿格萊雅，緹寶老師他們都有自己深耕的專業",
          "next": [
            202060010
          ]
        },
        "202060010": {
          "id": 202060010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "我心血來潮，想體驗不同的職業，學習新技能，也挖掘自己的更多愛好！",
          "next": [
            202060011
          ]
        },
        "202060011": {
          "id": 202060011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "所以我還應聘了廚師、鎖匠、鬼屋演員、服裝模特兒、大地獸騎師，拍賣師……",
          "next": [
            202060012
          ]
        },
        "202060012": {
          "id": 202060012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "總感覺不是很對胃……",
