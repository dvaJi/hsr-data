      "messages": {
        "202000000": {
          "id": 202000000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "好久不見，{NICKNAME}",
          "next": [
            202000001
          ]
        },
        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "如今，天外的資訊傳入翁法羅斯，樹庭的學生間興起了新的知識潮流。",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "剛剛學生傳了一份測試題給我",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "附件《測測你是哪個星神》已傳送",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "你有試過嗎？",
          "next": [
            202000005,
            202000006,
            202000007
          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "那還用說，我必須是阿基維利",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我是納努克，封你做絕滅大君",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我是阿哈，哈哈哈！",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "簡單看了看，它依賴於命途的概念維度，試圖通過歸類解明個體的自我認知與行為預測",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 那刻夏 已下線",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 那刻夏 已上線",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "我是奧博洛斯",
          "next": [
            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "它的評語是：",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「你和奧博洛斯不無關聯——就像大地獸咀嚼紅土，對真理，你不吝渴望、吞嚥、佔奪，慾望是你行動的本能。」",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「屬於你的人生格言是：永不饜足！」",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "不應該是機器頭嗎？",
          "next": [
            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "莫名很貼切",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "是一隻很好的貪饕",
          "next": [
            202000018
          ]
        },
        "202000018": {
          "id": 202000018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "有幾分意思，但不多",
          "next": [
            202000019
          ]
        },
        "202000019": {
          "id": 202000019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "總而言之",
          "next": [
            202000020
          ]
        },
        "202000020": {
          "id": 202000020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "作業，還是佈置得少了",
          "next": []
        }
      },
