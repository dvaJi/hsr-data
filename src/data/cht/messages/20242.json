        "202420000": {
          "id": 202420000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "這段時間你們都辛苦了，等眼下的事情結束，我來籌備列車組的大聚餐吧",
          "next": [
            202420001
          ]
        },
        "202420001": {
          "id": 202420001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "順便再為大家露一手，有興趣和我一起備餐嗎？",
          "next": [
            202420002,
            202420005,
            202420008
          ]
        },
        "202420002": {
          "id": 202420002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "好呀，誰來掌勺！我嗎？還是姬子姐？",
          "next": [
            202420003
          ]
        },
        "202420003": {
          "id": 202420003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "雖然聽起來都不太可靠……",
