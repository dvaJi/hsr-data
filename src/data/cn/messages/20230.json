          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "乖，别咬我的钱包，没钱。小狗不许乱吃东西。汪汪汪汪！",
          "next": [
