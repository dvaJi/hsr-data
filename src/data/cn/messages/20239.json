      "messages": {
        "202390000": {
          "id": 202390000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "我的财宝哟",
          "next": [
            202390001
          ]
        },
        "202390001": {
          "id": 202390001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "本王决定了：今日便是二相乐园毁灭之日！",
          "next": [
            202390002
          ]
        },
        "202390002": {
          "id": 202390002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "要是想随本王返回乌鲁克，那立刻到二维市广场！",
          "next": [
            202390003
          ]
        },
        "202390003": {
          "id": 202390003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "本王的飞船维摩那只停五分钟，过时不候！",
          "next": [
            202390004,
            202390006,
            202390007
          ]
        },
        "202390004": {
          "id": 202390004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "？？？问过我的意见了吗",
          "next": [
            202390005
          ]
        },
        "202390005": {
          "id": 202390005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "当然没有！本王这不是正在质问你吗！",
          "next": [
            202390009
          ]
        },
        "202390006": {
          "id": 202390006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "？？？干嘛",
          "next": [
            202390009
          ]
        },
        "202390007": {
          "id": 202390007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "？？？感叹号好多，吵到我眼睛了",
          "next": [
            202390008
          ]
        },
        "202390008": {
          "id": 202390008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "那是自然，为王者自当声如洪钟！",
          "next": [
            202390009
          ]
        },
        "202390009": {
          "id": 202390009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "姑且让你了解本王愤怒的理由吧：本王的吉尔美食街，开业至今竟然门可罗雀",
          "next": [
            202390010
          ]
        },
        "202390010": {
          "id": 202390010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "金箔冰淇淋！金箔金枪鱼沙拉！金箔翁瓦克异蛇排！金箔烧烤全末日兽！",
          "next": [
            202390011
          ]
        },
        "202390011": {
          "id": 202390011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "这些可都是本王亲自基于超一流的品味，挑选出的超一流选品，可当地的杂种们竟不屑一顾……",
          "next": [
            202390012
          ]
        },
        "202390012": {
          "id": 202390012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "罢了，不必再等五分钟，现在本王就要下达裁决！",
          "next": [
            202390013,
            202390015
          ]
        },
        "202390013": {
          "id": 202390013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "王请息怒，是他们没眼光",
          "next": [
            202390014
          ]
        },
        "202390014": {
          "id": 202390014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "哼，这片土地竟只有你一人识本王抬举，不可思议",
          "next": [
            202390017
          ]
        },
        "202390015": {
          "id": 202390015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "金箔冰淇淋就算了，后面那几个是什么我请问了",
          "next": [
            202390016
          ]
        },
        "202390016": {
          "id": 202390016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "连你也不识抬举么？这片银河还真是没救了啊",
          "next": [
            202390017
          ]
        },
        "202390017": {
          "id": 202390017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "呵，事到如今，就连亲自毁灭这片土地都显得多此一举",
          "next": [
            202390018
          ]
        },
        "202390018": {
          "id": 202390018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "本王就勉为其难原谅这些杂种吧，每日只能食些糟糠，欣赏不了本王的品味也情有可原",
          "next": [
            202390019
          ]
        },
        "202390019": {
          "id": 202390019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "退下吧，我的财宝！本王要继续研发金箔苏乐达了",
          "next": [
            202390020
          ]
        },
        "202390020": {
          "id": 202390020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "不出三日，定要让这片乐园心甘情愿俯首称臣！",
          "next": [
            202390021
          ]
        },
