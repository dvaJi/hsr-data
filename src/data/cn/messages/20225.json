        },
        "202250006": {
          "id": 202250006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "大胆一点，这添运之法还可活用于各类博弈",
          "next": [
            202250010
          ]
        },
        "202250007": {
          "id": 202250007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "可是我本来就不擅长打牌",
          "next": [
            202250008
          ]
        },
        "202250008": {
          "id": 202250008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "大胆一点，这添运之法还可活用于各类博弈",
          "next": [
            202250009
          ]
        },
        "202250009": {
          "id": 202250009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "我接！",
          "next": [
            202250010
          ]
        },
        "202250010": {
          "id": 202250010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "无论对弈、抽奖，注意下有没有背靠锐物与门窗，那可是聚煞漏财之位",
          "next": [
            202250011
          ]
        },
        "202250011": {
          "id": 202250011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "什么九宫格火锅，大紫茄子，大黄梨子，大红番茄，多吃点也可以增光添运",
          "next": [
            202250012
          ]
        },
        "202250012": {
          "id": 202250012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "还有逢八必发，逢钟必中，逢新必行，多瞧瞧肯定不坏",
          "next": [
            202250013
          ]
        },
        "202250013": {
          "id": 202250013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "噢，还有很容易疏漏的一点，手边那些带有「酥」「梳」「书」等字音的物品可以格外注意",
          "next": [
            202250014
          ]
        },
        "202250014": {
          "id": 202250014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "有一次牌友连输五局后口渴至极，又喝上一杯「苏打梅粉茶」，最终是把连败五十局烙印在自己牌史里了~",
          "next": [
            202250015,
            202250018
          ]
        },
        "202250015": {
          "id": 202250015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我必将活用",
