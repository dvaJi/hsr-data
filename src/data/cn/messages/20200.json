      "messages": {
        "202000000": {
          "id": 202000000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "好久不见，{NICKNAME}",
          "next": [
            202000001
          ]
        },
        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "如今，天外的信息传入翁法罗斯，树庭的学生间兴起了新的知识潮流。",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "刚刚学生发了一份测试题给我",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "附件《测测你是哪个星神》已发送",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "你有试过吗？",
          "next": [
            202000005,
            202000006,
            202000007
          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "那还用说，我必须是阿基维利",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我是纳努克，封你做绝灭大君",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我是阿哈，哈门！",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "简单看了下，它依赖于命途的概念维度，试图通过归类解明个体的自我认知与行为预测",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 那刻夏 已下线",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 那刻夏 已上线",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "我是奥博洛斯",
          "next": [
            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "它的评语是：",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「你和奥博洛斯不无关联——就像大地兽咀嚼红土，对真理，你不吝渴望、吞咽、占夺，欲望是你行动的本能。」",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「属于你的人生格言是：永不餍足！」",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "不该是机器头吗？",
          "next": [
            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "莫名很合适",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "是只很好的贪饕",
          "next": [
            202000018
          ]
        },
        "202000018": {
          "id": 202000018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "有几分意思，但不多",
          "next": [
            202000019
          ]
        },
        "202000019": {
          "id": 202000019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "总而言之",
          "next": [
            202000020
          ]
        },
        "202000020": {
          "id": 202000020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "作业，还是布置得少了",
          "next": []
        }
      },
