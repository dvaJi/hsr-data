        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "毁灭绝非壮烈的一瞬…但它的美丽一定毋庸置疑",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "你会坚持这条道路，一直「开拓」下去",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "直至…毁灭「毁灭」，对么",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "要加入我们吗？反正你也背叛「毁灭」了",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我期待那一天的到来",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "不过，若站在「开拓」的对立面",
