        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "末日兽，幻胧，铁墓……",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我很好奇，在与它们亲切会面时，你是什么心情",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "爽。甚至无需动手，盯着他们就好",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯，光眼神就可以杀人~",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "很遗憾，我心无波澜，没有感情",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯，铁面无私~",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "按部就班地来",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "你一拳我一拳，就解决了",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "嗯，回合制~",
          "next": [
            202210012
