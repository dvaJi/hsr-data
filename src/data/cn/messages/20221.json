        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "你还会回到「毁灭」吗？二度背叛怎么不算是一种背叛呢",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "这个主意不错，我喜欢",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "若站在「开拓」的对立面",
          "next": [
            202210021
