      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "小鸟今日午餐：玉米、藜麦、豌豆泥（一定要记得喝水！）",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "吃得好素，怎么没有一点肉！",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "原来保护嗓子要吃这些吗，好讲究！不愧是大明星！",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "抱歉！原本想发给自己，结果点错了",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "你还记不记得，之前我和你说捡到了一只翅膀折断的小雏鸟",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "上面的食谱不是我的午餐，是那只小鸟的",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "现在它已经康复了，翅膀也长出了新的羽毛",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我马上到家，待会给你看看它现在的样子",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鸟养小鸟，心暖暖的",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鸟养的小鸟，一定长成大肥啾了吧！",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 知更鸟 已下线",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "您的好友 知更鸟 已上线",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "对方正在输入中",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我到家了，但小鸟不见了",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "应该是穿过敞开的窗户飞走了",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "啊…不要难过，说不定是因为它开始向往自由飞翔的生活",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "谢谢你的安慰，我也这么觉得～",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "我一直在期待着，它再次飞向天空的这一天",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "虽然是有些突然…但你也在期待着它再次飞向天空的这一天吧？",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "嗯，你果然明白",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鸟开始了它新的鸟生和冒险！它也一定不会忘记你",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "嗯！其实我一直在期待着，它再次飞向天空的这一天",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "往常它也会飞到窗檐上看看外面的世界。这一次，它一定是做好了准备",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "虽然有些可惜，没能看见它展翅高飞的样子",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "叽叽！咕咕！啾啾啾！",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "语音消息转换完成（识别到自由的高音）",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "哈哈，是我身边的三只小乐手",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "它们说小鸟飞起来的样子，一定很美",
          "next": [
            202450029
          ]
        },
        "202450029": {
          "id": 202450029,
