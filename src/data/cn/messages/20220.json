      ],
      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}，你知道匹诺康尼还有更多未被发掘的记忆么",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "人们从未将它看透，包括刚取回那段记忆的你",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "那些你熟悉的人们，那些更不为人知的秘密，你不好奇么",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "在永火一夜，以刀鞘挽起火光的女人",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "或者…心系你的猎手们？",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "当然，还有我，我非常愿意对你敞开心扉",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "在我将一些记忆烧掉前，可以先同你分享~",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "倒要听听黄泉有什么可能她自己都不知道的秘密",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "在那夜最后一粒火星泯灭时",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我看见",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "她取走了一张图纸，可惜那并非地图，而是",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "一份「菜单」",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "但可能她至今也还未发现吧～",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "她可能只是饿了，你不知道她会做饭吧",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "谁知道呢",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "也许…我吃过哦",
          "next": [
            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "你当时真的混进星核猎手了吗？我表示怀疑",
          "next": [
            202200017
          ]
        },
        "202200017": {
          "id": 202200017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "说个他们的秘密听听？",
          "next": [
            202200018
          ]
        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "星核的猎手，命运的奴隶…呵呵，这些都不足以描绘你们之间的牵绊",
          "next": [
            202200019
          ]
        },
        "202200019": {
          "id": 202200019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "他们怎么会有42个「剧本」群聊呢？好好奇呀",
          "next": [
            202200020
          ]
        },
        "202200020": {
          "id": 202200020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "你数学不好，不是有56个吗？",
          "next": [
            202200021
          ]
        },
        "202200021": {
          "id": 202200021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "你猜，我在其中哪一个群里？",
          "next": [
            202200028
          ]
        },
        "202200022": {
          "id": 202200022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "我想知道你不为人知的秘密",
          "next": [
            202200023
          ]
        },
        "202200023": {
          "id": 202200023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "我曾经与「星湖醋鱼神教」同行过半个琥珀纪",
          "next": [
            202200024
          ]
        },
        "202200024": {
          "id": 202200024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "它的标语是：「下有天堂，上有星湖，一口记住，再不吃醋」",
          "next": [
            202200025
          ]
        },
        "202200025": {
          "id": 202200025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "可惜没人记得了呢。记忆总是这样经不住考验",
          "next": [
            202200026
          ]
        },
        "202200026": {
          "id": 202200026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "现在大家都知道了，想听你喊一下这个口号",
          "next": [
            202200027
          ]
        },
        "202200027": {
          "id": 202200027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "你需要支付另外的代价",
          "next": [
            202200028
          ]
        },
        "202200028": {
          "id": 202200028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "真是知道了一个好小众的秘密！",
          "next": [
            202200029
          ]
        },
        "202200029": {
          "id": 202200029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "为了报答你的好意，我也告诉你一个秘密吧！",
          "next": [
            202200030
          ]
        },
        "202200030": {
          "id": 202200030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "其实……",
          "next": [
            202200031
          ]
        },
        "202200031": {
          "id": 202200031,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "其实米哈伊尔曾经当过演员",
          "next": [
            202200032
          ]
        },
        "202200032": {
          "id": 202200032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "你说的话，我真的会信哦",
          "next": [
            202200033
          ]
        },
