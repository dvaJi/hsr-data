        "202520030": {
          "id": 202520030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "已填好邮寄单，小浣熊记得查收哦！",
          "next": [
            202520031
          ]
        },
        "202520031": {
          "id": 202520031,
          "type": "Text",
          "sender": "NPC",
