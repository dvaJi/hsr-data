            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "受的伤有好转吗？觉睡得好吗？吃饭有胃口吗？工作会感到疲乏吗？有什么其他不舒服吗？",
          "next": [
