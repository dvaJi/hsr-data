        },
        "150080102": {
          "id": 150080102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "听说你俩出了点状况",
          "next": [
            150080103
          ]
        },
        "150080103": {
          "id": 150080103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "什么情况？",
          "next": [
            150080104
          ]
        },
        "150080104": {
          "id": 150080104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "我俩没事，但逛街时遇上一个自称「火花」的家伙",
          "next": [
            150080105
          ]
        },
        "150080105": {
          "id": 150080105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "她宣称要干掉我和{NICKNAME}，把列车组排除在幻月游戏外",
          "next": [
            150080106
          ]
        },
        "150080106": {
          "id": 150080106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "那咱们可得加快行动啦",
          "next": [
            150080107
          ]
        },
        "150080107": {
          "id": 150080107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "所以，你们做好决定了？",
          "next": [
            150080108
          ]
        },
        "150080108": {
          "id": 150080108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "我是有点想法，虽然不知道{NICKNAME}怎么想",
          "next": [
            150080109
          ]
        },
        "150080109": {
          "id": 150080109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "我对参与幻月游戏有兴趣",
          "next": [
            150080110
          ]
        },
        "150080110": {
          "id": 150080110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "我一直在想，如果赢了的话，我该用这权能做些什么，又或者我可以要求阿哈为我做些什么",
          "next": [
            150080111
          ]
        },
        "150080111": {
          "id": 150080111,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "有空我和大家详细聊聊",
          "next": [
            150080112
          ]
        },
        "150080112": {
          "id": 150080112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "丹恒那边怎么样？@丹恒",
          "next": [
            150080113
          ]
        },
        "150080113": {
          "id": 150080113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我联络上了仙舟特使，但他们也遇到了一些问题，想寻求帮助。",
          "next": [
            150080114
          ]
        },
        "150080114": {
          "id": 150080114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我和星期日正在路上。",
          "next": [
            150080115
          ]
        },
        "150080115": {
          "id": 150080115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "如果有需要，记得联系我。",
          "next": [
            150080116
          ]
        },
        "150080116": {
          "id": 150080116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "好，姬子，接下来我们要做什么？",
          "next": [
            150080117
          ]
        },
        "150080117": {
          "id": 150080117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "我想拜托你们去「绘世学院」，我的母校",
          "next": [
            150080118
          ]
        },
        "150080118": {
          "id": 150080118,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "【绘世学院的位置】",
          "next": [
            150080119
          ]
        },
        "150080119": {
          "id": 150080119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "这所学校里，有一位名叫啵啵娃的老师",
          "next": [
            150080120
          ]
        },
        "150080120": {
          "id": 150080120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "她是我的朋友，保管着加入「幻月游戏」所需的面具",
          "next": [
            150080121
          ]
        },
        "150080121": {
          "id": 150080121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "为避免夜长梦多，你们先找到她，接过面具",
          "next": [
            150080122
          ]
        },
        "150080122": {
          "id": 150080122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "咱们这就走",
          "next": [
            150080123
          ]
        },
        "150080123": {
          "id": 150080123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "我和瓦尔特会去和你们会合",
          "next": []
        }
