        "202140012": {
          "id": 202140012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我模仿了一段。它们无聊时，通常还会走来走去，不只在说话。",
          "next": [
            202140013
          ]
        },
        "202140013": {
          "id": 202140013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "一般表达的是：一起玩，出去玩。",
          "next": [
            202140014
          ]
        },
        "202140014": {
