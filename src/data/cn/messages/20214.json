          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "翁法罗斯的旅行已经告一段落。",
          "next": [
            202140001
          ]
        },
        "202140001": {
          "id": 202140001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我也凭此研究，学习，收录宇宙间不同生物的语种和语言，相较之前已有更多积累。",
          "next": [
            202140002
          ]
        },
        "202140002": {
          "id": 202140002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "如果遇见无法沟通的生物，随时找我。",
          "next": [
            202140003,
            202140008
          ]
        },
        "202140003": {
          "id": 202140003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "丹恒老师，小猫开心的时候怎么说话？",
          "next": [
            202140004
          ]
        },
        "202140004": {
          "id": 202140004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "…稍等。",
          "next": [
            202140005
          ]
        },
        "202140005": {
          "id": 202140005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "喵——咕噜噜。轰隆隆，隆隆隆隆。",
          "next": [
            202140006
          ]
        },
        "202140006": {
          "id": 202140006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "语音消息转换完成",
          "next": [
            202140007
          ]
        },
        "202140007": {
          "id": 202140007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "我模仿了一段。这时，它们普遍会表达：喜欢，还要，继续。",
          "next": [
            202140014
          ]
        },
        "202140008": {
          "id": 202140008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "丹恒老师，小狗无聊的时候怎么说话？",
          "next": [
            202140009
          ]
        },
        "202140009": {
          "id": 202140009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "…稍等。",
          "next": [
            202140010
          ]
        },
        "202140010": {
          "id": 202140010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "叮铃咣当。啪嗒啪嗒。汪汪汪。嗝嗝。唉。",
          "next": [
            202140011
          ]
        },
        "202140011": {
          "id": 202140011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "语音消息转换完成",
