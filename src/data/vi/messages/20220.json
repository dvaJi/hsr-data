            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cô thực sự đã trà trộn vào Thợ Săn Stellaron sao? Tôi thấy khó tin lắm",
