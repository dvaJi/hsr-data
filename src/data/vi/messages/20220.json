        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Thợ Săn Stellaron, Nô Lệ Của Số Phận... hừm, những danh xưng đó vẫn chưa đủ để miêu tả mối dây liên kết giữa các người",
          "next": [
            202200019
