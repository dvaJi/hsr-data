      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, {F#cô}{M#anh} có biết Penacony vẫn còn nhiều ký ức chưa được khám phá không",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Chưa ai thực sự hiểu rõ về nó, kể cả {F#cô}{M#anh} - người vừa lấy lại được ký ức đó",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Những người thân quen đó, những bí mật chưa từng được biết đến, {F#cô}{M#anh} không tò mò sao",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Đêm của ngọn lửa vĩnh hằng, người phụ nữ dùng vỏ kiếm khơi lên ánh lửa",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Hoặc... những thợ săn đang để mắt đến {F#cô}{M#anh}?",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Tất nhiên, còn có tôi nữa, tôi rất sẵn lòng chia sẻ tâm tư với {F#cô}{M#anh}",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Trước khi đốt đi một số ký ức, tôi có thể chia sẻ với {F#cô}{M#anh}~",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi muốn nghe bí mật của Acheron, bí mật mà ngay cả bản thân cô ấy cũng không biết",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Khi tia lửa cuối cùng của đêm ấy tắt lịm",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Tôi nhìn thấy",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Cô ấy lấy đi một tấm bản vẽ, đáng tiếc đó không phải là bản đồ, mà là",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Một tấm \"thực đơn\"",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Nhưng có lẽ cho đến giờ cô ấy vẫn chưa phát hiện ra điều đó đâu nhỉ~",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Có lẽ cô ấy chỉ đang đói bụng thôi, cô không biết cô ấy biết nấu ăn à",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ai mà biết được chứ?",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Có lẽ... tôi đã từng ăn rồi nhỉ",
