        },
        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ừm... Dạo này cuối cùng cũng có thời gian rảnh rỗi, nhưng lại không quen ngồi yên, thế là tự tìm việc gì đó để làm",
          "next": [
            202060009
          ]
        },
        "202060009": {
          "id": 202060009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aglaea và các cô Tribbie đều có chuyên môn sâu trong lĩnh vực của mình",
          "next": [
            202060010
          ]
        },
        "202060010": {
          "id": 202060010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Tôi bỗng dưng nổi hứng, muốn trải nghiệm những nghề nghiệp khác nhau, học thêm kỹ năng mới, và cũng để khám phá thêm nhiều sở thích của bản thân!",
          "next": [
            202060011
          ]
        },
        "202060011": {
          "id": 202060011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Vì vậy tôi còn ứng tuyển làm đầu bếp, thợ khóa, diễn viên nhà ma, người mẫu trang phục, người cưỡi Thú Đại Địa, người xướng giá...",
          "next": [
            202060012
          ]
        },
        "202060012": {
          "id": 202060012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Nhưng cứ cảm thấy không hợp gu lắm...",
          "next": [
            202060013
          ]
        },
        "202060013": {
          "id": 202060013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Cộng sự, {F#cô}{M#anh} còn gợi ý gì nữa không!",
          "next": [
            202060014,
            202060016,
            202060018
          ]
        },
        "202060014": {
          "id": 202060014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mặt trời rực lửa cuối cùng sẽ trỗi dậy...",
