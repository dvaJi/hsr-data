      "messages": {
        "202280000": {
          "id": 202280000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Chào {NICKNAME}, là tôi, \"Người Dẫn Chuyện\" đây.",
          "next": [
            202280001
          ]
        },
        "202280001": {
          "id": 202280001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tôi muốn hỏi bình thường {F#cô}{M#anh} thích ăn gì, có thể giới thiệu cho tôi một vài món không?",
          "next": [
            202280002
          ]
        },
        "202280002": {
          "id": 202280002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tốt nhất là thực phẩm dinh dưỡng có mức giá tương đối bình dân.",
          "next": [
            202280003,
            202280006,
            202280009
          ]
        },
        "202280003": {
          "id": 202280003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"Cơm Rang Tốt Cho Sức Khỏe\" không khói, không dầu, không chất phụ gia, bổ dưỡng nhưng nhạt nhẽo",
          "next": [
            202280004
          ]
        },
        "202280004": {
          "id": 202280004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Có thể thử các món ăn vặt từ nơi khác như Xúc Xích Belobog, Thịt Chim Xiên Xianzhou v.v, chuyển phát nhan hành tinh hôm sau là đến~",
          "next": [
            202280005
          ]
        },
        "202280005": {
          "id": 202280005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Nhưng nghe nói không freeship, tôi sẽ tính toán lại chi phí mua sắm một chút, cảm ơn đã đề xuất.",
          "next": [
            202280011
          ]
        },
        "202280006": {
          "id": 202280006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Khó giới thiệu quá... Mấy món tôi thích ăn hình như đều chẳng có dinh dưỡng gì",
          "next": [
            202280007
          ]
        },
        "202280007": {
          "id": 202280007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Xiên nướng, hầm thập cẩm, Trà Vui Vẻ, burger cánh, bánh kem...",
          "next": [
            202280008
          ]
        },
        "202280008": {
          "id": 202280008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "So với tình hình ăn uống của vị Thám Tử Tro Tàn kia, {F#cô}{M#anh} như vậy cũng được xem là khá cân bằng dinh dưỡng rồi.",
          "next": [
            202280011
          ]
        },
        "202280009": {
          "id": 202280009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi tưởng anh chỉ thích chuối",
          "next": [
            202280010
          ]
        },
        "202280010": {
          "id": 202280010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Không phải tôi ăn, là anh Ashveil.",
          "next": [
            202280011
          ]
        },
        "202280011": {
          "id": 202280011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Đúng là đau đầu thật, dạo này anh Ashveil bữa nào cũng ăn chuối cùng tôi. Có lẽ là để cho đỡ phiền, hoặc là để tiết kiệm tiền chăng.",
          "next": [
            202280012
          ]
        },
        "202280012": {
          "id": 202280012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Nhưng nếu thiếu đi các dưỡng chất tổng hợp cần thiết cho con người, thì cái đầu của anh ấy sẽ chỉ càng thêm mụ mẫm hơn thôi.",
          "next": [
            202280013
          ]
        },
        "202280013": {
          "id": 202280013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Nhiều lần quên mang điện thoại, chính là một trong những biểu hiện lâm sàng của suy dinh dưỡng.",
          "next": [
            202280014
          ]
        },
        "202280014": {
          "id": 202280014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Cho nên, tôi phải rèn lại thói quen ăn uống của anh ấy thôi.",
          "next": [
            202280015,
            202280016
          ]
        },
        "202280015": {
          "id": 202280015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rèn kiểu gì vậy? Tôi cũng muốn quản lý sức khỏe nữa!",
          "next": [
            202280018
          ]
        },
        "202280016": {
          "id": 202280016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đúng là một trợ lý kiểu \"bảo mẫu\" tuyệt vời quá mà!",
          "next": [
            202280017
          ]
        },
        "202280017": {
          "id": 202280017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Với mức độ lơ là của anh ấy, việc tôi đứng ra lo liệu cũng là điều nằm trong dự đoán thôi.",
          "next": [
            202280018
          ]
        },
        "202280018": {
          "id": 202280018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Mấy ngày đầu, tôi nghiền nhuyễn chuối, rồi lén trộn thêm các loại trái cây khác vào cho anh ấy.",
          "next": [
            202280019
          ]
        },
        "202280019": {
          "id": 202280019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hiệu quả khá tốt, ăn uống bình thường, không có biểu hiện chống đối rõ rệt, cũng không có phản ứng căng thẳng.",
          "next": [
            202280020
          ]
        },
        "202280020": {
          "id": 202280020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tiếp theo tôi định tăng dần tỷ lệ thức ăn mới, thêm vào các món nóng mà con người ưa thích, trộn lẫn dần dần.",
          "next": [
            202280021
          ]
        },
        "202280021": {
          "id": 202280021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Vừa bảo vệ dạ dày, vừa có thể khơi dậy lại hứng thú của anh ấy đối với các món ăn khác của loài người thông qua vị giác.",
          "next": [
            202280022
          ]
        },
        "202280022": {
          "id": 202280022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Một liệu trình tối thiểu 7 ngày, gọi tắt là... Phương Pháp Đổi Thức Ăn 7 Ngày, vô cùng khoa học!",
          "next": [
            202280023,
            202280024
          ]
        },
        "202280023": {
          "id": 202280023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Phương Pháp Đổi Thức Ăn 7 Ngày, đã tiếp thu!",
          "next": [
            202280026
          ]
        },
        "202280024": {
          "id": 202280024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Anh còn giống chủ nhân của anh ấy hơn",
          "next": [
            202280025
          ]
        },
        "202280025": {
          "id": 202280025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Mối quan hệ thám tử và trợ lý giữa chúng tôi sẽ không thay đổi.",
          "next": [
            202280026
          ]
        },
        "202280026": {
          "id": 202280026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Để xem nào, hôm qua là hai quả táo, một quả trứng, một bát nếp, một thìa chuối, ba hũ muối.",
          "next": [
            202280027
          ]
        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ồ, giờ này chắc anh ấy sắp về rồi, tôi đi chuẩn bị món \"Tháp Muối Táo Chuối\" hôm nay đây.",
          "next": [
            202280028
          ]
        },
        "202280028": {
          "id": 202280028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tạm biệt.",
          "next": []
        }
      },
