        },
        "202510023": {
          "id": 202510023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Phân tích nghệ thuật: Cũng có nghĩa là diễn giải nghệ thuật.",
          "next": [
            202510024
          ]
        },
        "202510024": {
          "id": 202510024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Nhưng: Diễn giải nghệ thuật, là sẽ có đáp án sao?",
