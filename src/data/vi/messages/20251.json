          ]
        },
        "202510008": {
          "id": 202510008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tôi nhận được một bức tranh.",
          "next": [
            202510009
          ]
        },
        "202510009": {
          "id": 202510009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Đó là bức \"Pearl\" do một họa sĩ chân dung đường phố trước đây mời tôi làm người mẫu vẽ ngay tại chỗ.",
          "next": [
            202510010
          ]
        },
        "202510010": {
          "id": 202510010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Bức tranh này để mảng trắng cực kỳ có dụng ý...",
          "next": [
            202510011
          ]
        },
        "202510011": {
          "id": 202510011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Bởi vì, nó chỉ dùng dao rạch một đường trên giấy vẽ.",
          "next": [
            202510012
          ]
        },
        "202510012": {
          "id": 202510012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Suy nghĩ: Mối liên hệ giữa tác phẩm và tôi là...",
          "next": [
            202510013,
            202510016
          ]
        },
        "202510013": {
          "id": 202510013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nghệ thuật đúng là quá khó hiểu",
          "next": [
            202510014
          ]
        },
        "202510014": {
          "id": 202510014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Một đường rạch... thực ra rất thích hợp để đặt giấy rút ở dưới, có lẽ ý anh ta là...",
          "next": [
            202510015
          ]
        },
        "202510015": {
          "id": 202510015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "\"Pearl, đến rút không?\"",
          "next": [
            202510019
          ]
        },
        "202510016": {
          "id": 202510016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nghệ thuật vẫn quá dễ hiểu",
          "next": [
            202510017
          ]
        },
        "202510017": {
          "id": 202510017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Một vết cắt xé toạc không gian, trông có giống chiếc ví đang mở ra không nhỉ?",
          "next": [
            202510018
          ]
        },
        "202510018": {
          "id": 202510018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Khi cô đặt tay vào, luôn rút ra được thứ gì đó...",
          "next": [
            202510019
          ]
        },
        "202510019": {
          "id": 202510019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510020
          ]
        },
        "202510020": {
          "id": 202510020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Suy đoán: Hóa ra là thương nhân bán túi mù trá hình dưới lớp vỏ tranh vẽ, bảo sao lại chặn đường tôi giữa chừng.",
          "next": [
            202510021
          ]
        },
        "202510021": {
          "id": 202510021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Nhưng cách diễn giải của {F#cô}{M#anh} rất thú vị.",
          "next": [
            202510022
          ]
        },
        "202510022": {
          "id": 202510022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Nghệ thuật: Nghĩa là diễn giải cuộc sống",
