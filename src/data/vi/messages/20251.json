            202510025
          ]
        },
        "202510025": {
          "id": 202510025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Có lẽ là không. Vì vậy: Cần phải diễn giải cả sự diễn giải của nghệ thuật.",
