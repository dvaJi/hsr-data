            202510026,
            202510027
          ]
        },
        "202510026": {
          "id": 202510026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi vừa kích hoạt cái gì thế này? Đừng nghĩ nữa, đừng nghĩ nữa!",
          "next": [
            202510028
