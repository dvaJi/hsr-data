            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Báo cho ngài giám đốc một tin tốt",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Phim điện ảnh cá nhân của furbo tôi đã được lập dự án, đây là một bom tấn siêu anh hùng mang tên \"Nỗi Sầu Muộn Của Gigafurb\"!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Woa, chúc mừng! Chúc mừng giấc mơ của cậu đã thành hiện thực!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Vẫn chưa thể vui mừng quá sớm đâu, dù sao thì cũng vừa mới bấm máy chưa được bao lâu.",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Giỏi quá!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nhân tiện hỏi một câu, cậu còn quay lại làm việc không?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Chắc phải đợi phim quay xong đã, giờ mới vừa bấm máy thôi",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ồ, tiền bối Wubbaboo gọi tôi giúp đỡ rồi",
