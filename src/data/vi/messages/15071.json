          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "A, xin lỗi, quen tay dùng điện thoại công việc mất rồi",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Là tôi đây, Furli! Gigafurb là nghệ danh của tôi.",
