      "messages": {
        "202290000": {
          "id": 202290000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "<u>Sự thật chỉ có một, không phải cái này thì là cái kia. Cuốn \"21 Câu Hỏi Tạm Biệt Suy Luận Kém Hiệu Quả\" này, tôi chỉ mất 0,99 giây là học xong hết, vượt qua 99,99% người ở Planarcadia, {F#cô}{M#anh} cũng thử xem nhé</u>",
          "next": [
            202290001,
            202290003
          ]
        },
        "202290001": {
          "id": 202290001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thì ra muốn quảng cáo bán sách còn phải biết đọc nhanh lượng tử à?",
          "next": [
            202290002
          ]
        },
        "202290002": {
          "id": 202290002,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tới luôn đi, tôi có thể nhanh hơn",
          "next": [
            202290005
          ]
        },
        "202290003": {
          "id": 202290003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đây là ủy thác quảng cáo bán sách à?",
          "next": [
            202290004
          ]
        },
        "202290004": {
          "id": 202290004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tới đi, tôi có thể thắng anh",
          "next": [
            202290005
          ]
        },
        "202290005": {
          "id": 202290005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Phiên Bản Trải Nghiệm Câu 1:",
          "next": [
            202290006
          ]
        },
        "202290006": {
          "id": 202290006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "\"Đêm khuya, nạn nhân vào bếp tìm đồ ăn, chỉ nghe 'bịch' một tiếng, anh ta chết.\" Hãy tái hiện lại vụ án...",
          "next": [
            202290007,
            202290012,
            202290017
          ]
        },
        "202290007": {
          "id": 202290007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nạn nhân đang đói cồn cào đã lẻn vào bếp nhà người khác để kiếm một bữa no nê, không may chạm mặt chủ nhà đã phát hiện tiếng động lạ, bị chủ nhà đánh gục.",
          "next": [
            202290008
          ]
        },
        "202290008": {
          "id": 202290008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ừm, vụ đột nhập trộm cắp rất hợp lý. Nhưng {F#cô}{M#anh} có vẻ đã bỏ sót manh mối then chốt là tiếng \"bịch\" này.",
          "next": [
            202290009
          ]
        },
        "202290009": {
          "id": 202290009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tại sao lại là một tiếng \"bịch\", chứ không phải một tiếng \"á\"?",
          "next": [
            202290010
          ]
        },
        "202290010": {
          "id": 202290010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tuyên bố đáp án...",
          "next": [
            202290011
          ]
        },
        "202290011": {
          "id": 202290011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Nạn nhân là một con gián",
          "next": [
            202290021
          ]
        },
        "202290012": {
          "id": 202290012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chủ nhà đói đến không chịu nổi, vì quá vội vàng đã ăn phải thức ăn bị biến chất rồi tử vong, ngã \"bịch\" xuống đất.",
          "next": [
            202290013
          ]
        },
        "202290013": {
          "id": 202290013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Thoạt nhìn thì như một vụ án mạng, nhưng thực chất là tai nạn, tư duy ngược khá đấy, tiếc là vẫn không đúng.",
          "next": [
            202290014
          ]
        },
        "202290014": {
          "id": 202290014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Con người, lúc nào cũng biết đói, lúc nào cũng có thể ăn, nhưng mấu chốt của câu hỏi lại nhấn mạnh vào \"ban đêm\"",
          "next": [
            202290015
          ]
        },
        "202290015": {
          "id": 202290015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Tuyên bố đáp án...",
          "next": [
            202290016
          ]
        },
        "202290016": {
          "id": 202290016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Nạn nhân là một con gián",
          "next": [
            202290021
          ]
        },
        "202290017": {
          "id": 202290017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ban đêm... Nhà bếp... Ăn cơm... \"Bịch\" một tiếng...",
          "next": [
            202290018
          ]
        },
        "202290018": {
          "id": 202290018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nạn nhân là một con gián",
          "next": [
            202290019
          ]
        },
        "202290019": {
          "id": 202290019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tôi đoán bừa thôi",
          "next": [
            202290020
          ]
        },
        "202290020": {
          "id": 202290020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Đúng là thám tử tài ba!",
          "next": [
            202290021
          ]
        },
        "202290021": {
          "id": 202290021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Những vụ án tôi phá được phần lớn cũng như vậy, hợp tình hợp lý, nhưng lại nằm ngoài dự đoán",
          "next": [
            202290022
          ]
        },
        "202290022": {
          "id": 202290022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Vậy nên, một cuốn cẩm nang suy luận chuẩn sách giáo khoa này, {F#cô}{M#anh} có chắc là không muốn lấy một cuốn không?",
          "next": [
            202290023
          ]
        },
        "202290023": {
          "id": 202290023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Thêm một câu nữa để cảm nhận nhé: \"Nạn nhân ra ngoài đi dạo đụng phải thứ dài dài xanh xanh, rồi bất ngờ tử vong.\" Hãy tái hiện lại vụ án...",
          "next": [
            202290024
          ]
        },
        "202290024": {
          "id": 202290024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ơ... Khoan đã",
          "next": [
            202290025
          ]
        },
        "202290025": {
          "id": 202290025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Cầm nhầm quyển \"Đố Vui Xoắn Não\" mất rồi",
          "next": [
            202290026
          ]
        },
        "202290026": {
          "id": 202290026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cũng là một dạng sách suy luận thôi, còn có học được thứ gì thật sự không thì tính sau",
          "next": [
            202290027
