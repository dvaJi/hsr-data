        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Vậy nên, xin mời {F#cô}{M#anh} tới đặt cược",
          "next": [
            202470054
          ]
        },
        "202470054": {
