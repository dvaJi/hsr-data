          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Tôi đoán ngay là {F#cô}{M#anh} sẽ không ra bài theo lẽ thường mà, nhưng ván này chỉ có hai lựa chọn",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Để tôi chọn đại một cái thay {F#cô}{M#anh} nhé, tin là chúng ta tâm linh tương thông",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Anh lại đang đánh cược gì thế?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Có một đứa bé cứ lượn lờ quanh dù che nắng của tôi mấy vòng rồi",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Tôi tưởng cậu bé đi lạc, không ngờ lại để mắt tới chỗ cát dưới chân tôi",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Nói rằng cát chỗ tôi là mịn nhất trên toàn bãi biển, chỉ có loại cát này mới xây được lâu đài cát kiên cố nhất",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Nhưng bạn nhỏ này khá thú vị, không yêu cầu tôi trực tiếp nhường chỗ",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Cậu bé đề nghị đánh cược: Hai con ốc mượn hồn một đỏ một xanh trước mặt, cược xem con nào về đích trước",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Nếu cậu bé thắng, thì vùng cát hoàn mỹ sẽ thuộc về cậu ấy",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chẳng phải anh là người cứ có kèo là tham gia sao, không sợ bắt nạt trẻ con à?",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thảo nào anh lại đến hỏi tôi, anh mà cá cược thì còn gì là gay cấn nữa chứ",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Vậy nếu chúng ta thắng thì sao?",
