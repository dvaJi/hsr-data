      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Thưa Cứu Thế Tước, tôi đang chuẩn bị cho kế hoạch \"Thám Hiểm Cực Hạn\" đầu tiên của mình",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Các vị đã du hành qua các vì sao, chắc chắn có thể thẳng thắn góp ý cho tôi những lời khuyên toàn diện hơn",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cô đi một mình à? Chuẩn bị đi chơi đâu vậy?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Nếu có ai muốn đi cùng, Hoàng Đế tất nhiên sẽ không phản đối.",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chuẩn bị đi chơi đâu vậy?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hãy bước lên Đội Tàu Astral",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Có lẽ đây sẽ là một điểm dừng chân trong hành trình của tôi, nhưng cứ để sau này hẵng nói",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Điểm đến: Amphoreus trong tương lai",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Ngày xưa trên hành trình viễn chinh, vạn thành bang trong ký ức nếu không phải là khói lửa chiến tranh, thì cũng là thủy triều đen chết chóc",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Khi hạt giống ký ức nở rộ, Amphoreus sẽ bừng lên sức sống, đó cũng chính là lúc tôi có thể khám phá",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tôi muốn lái thuyền buồm vượt qua vùng biển Skiana, nơi những đám mây đen và những con sóng khổng lồ không ngừng vật lộn với nhau",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Đã từng nghe về Ladon chưa? Nơi đó có một vùng đất rất cao, chạm tới tận những tầng mây",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tôi đang nghĩ nên bay bằng bộ cánh hay là nhảy dù trên cao",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Cứu Thế Tước có đề xuất gì không?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi thì sao cũng được, dù sao trước đây tôi cũng thường xoay người bật nhảy, rồi từ trên cao hạ cánh xuống một thế giới khác",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Nghe có vẻ rất tuyệt.",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nói ra thì dài dòng lắm... Tôi thường xuyên đi vào một thế giới bằng cách hạ cánh từ trên cao",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Hay là cô thử xem",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
