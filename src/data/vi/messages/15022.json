        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Huhuhu, xin tha mạng! Đừng cho nổ chết tôi! Tôi sẽ mua truyện fanfic giúp cô mà!",
          "next": [
