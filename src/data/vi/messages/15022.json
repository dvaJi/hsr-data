            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Tôi nghe nói {F#cô}{M#anh} đang du ngoạn tại Planarcadia",
