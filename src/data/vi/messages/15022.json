        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Sau này rảnh rỗi, tôi sẽ thường xuyên trò chuyện với {F#cô}{M#anh}",
