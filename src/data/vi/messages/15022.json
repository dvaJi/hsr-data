        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Không biết {F#cô}{M#anh} có từng nghe nói về \"Trò Chơi Đánh Đố\" chưa?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Tôi rất quan tâm đến bộ truyện tranh này",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "So với tác phẩm đầu tay \"Vua Xào Nấu\" của tác giả, việc bắt hung thủ và truy lùng kẻ địch này hợp với tôi hơn",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Nghe nói gần đây Thành Phố Duomension đang tổ chức \"Triển Lãm Trò Chơi Đánh Đố Only\", tại đây sẽ bán rất nhiều tác phẩm fanfic.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Đáng tiếc vì vị thế của mình, tôi không thể đích thân đến tham dự triển lãm truyện tranh ở Planarcadia được",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Mong {F#cô}{M#anh} có thể mua giúp tôi vài cuốn truyện fanfic để lấp đầy nỗi tiếc nuối này",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đúng lúc tôi đi dạo gần triển lãm truyện tranh này thì nhận được tin nhắn của cô... Cô không theo dõi tôi đấy chứ?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Tít tít, máy bay theo dõi không người lái \"Xueyi 9527\" đã bị phát hiện, đang thực hiện chương trình tự hủy",
          "next": [
            150220117
