            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Tôi có một việc nhỏ muốn nhờ {F#cô}{M#anh}",
