      "messages": {
        "202420000": {
          "id": 202420000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Thời gian qua mọi người đã vất vả rồi, đợi chuyện trước mắt kết thúc, tôi sẽ chuẩn bị một bữa tiệc lớn cho Đội Tàu Astral nhé",
          "next": [
            202420001
          ]
        },
        "202420001": {
          "id": 202420001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Nhân tiện trổ tài cho mọi người xem, {F#cô}{M#anh} có hứng thú cùng tôi chuẩn bị bữa ăn không?",
          "next": [
            202420002,
            202420005,
            202420008
          ]
        },
        "202420002": {
          "id": 202420002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Được nha, ai đứng bếp đây! Tôi hả? Hay là chị Himeko?",
          "next": [
            202420003
          ]
        },
        "202420003": {
          "id": 202420003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Mặc dù nghe đều có vẻ không đáng tin lắm...",
          "next": [
            202420004
          ]
        },
        "202420004": {
          "id": 202420004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Yên tâm đi, tôi không đứng bếp đâu",
          "next": [
            202420010
          ]
        },
        "202420005": {
          "id": 202420005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Được thôi! Chị Himeko đứng bếp, tôi sẽ giúp nếm thử",
          "next": [
            202420006
          ]
        },
        "202420006": {
          "id": 202420006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Khoan đã, chị Himeko đứng bếp...",
          "next": [
            202420007
          ]
        },
        "202420007": {
          "id": 202420007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Yên tâm đi, tôi không đứng bếp đâu",
          "next": [
            202420010
          ]
        },
        "202420008": {
          "id": 202420008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lần trước sau khi chị Himeko trổ tài, chúng tôi đã phải chạy vào nhà vệ sinh không ít lần đâu, coi như tập thể dục vậy!",
          "next": [
            202420009
          ]
        },
        "202420009": {
          "id": 202420009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Yên tâm, chuyện này sẽ không xảy ra nữa đâu",
          "next": [
            202420010
          ]
        },
        "202420010": {
          "id": 202420010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Trong kho có một chiếc máy nấu ăn do tôi tự tay chế tạo trước đây, tôi định nhờ nó ra tay",
          "next": [
            202420011
          ]
        },
        "202420011": {
          "id": 202420011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tuy vài linh kiện đã rỉ sét, nhưng cũng đến lúc tân trang lại rồi",
          "next": [
            202420012
          ]
        },
        "202420012": {
          "id": 202420012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Lần trước có nói khi bảo trì Đội Tàu sẽ đưa {F#cô}{M#anh} đi cùng, lần này đúng lúc cần sửa máy nấu ăn, nguyên lý của chúng giống nhau, nên nghĩ có thể rủ {F#cô}{M#anh} theo",
          "next": [
            202420013,
            202420014,
            202420016
          ]
        },
        "202420013": {
          "id": 202420013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nguyên lý sửa chữa Đội Tàu và sửa máy nấu ăn có điểm chung là...?",
          "next": [
            202420017
          ]
        },
        "202420014": {
          "id": 202420014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hóa ra \"trổ tài\" là thế này, không hổ danh là chuyên gia sửa chữa của chúng ta, cô Himeko!",
          "next": [
            202420015
          ]
        },
        "202420015": {
          "id": 202420015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nhưng... nguyên lý của chúng có điểm chung là...?",
          "next": [
            202420017
          ]
        },
        "202420016": {
          "id": 202420016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi cũng phải sửa Đội Tàu... không, tôi cũng phải sửa máy nấu ăn sao... không, nguyên lý của chúng có điểm chung là...?",
          "next": [
            202420017
          ]
        },
        "202420017": {
          "id": 202420017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Các nguyên lý như truyền dẫn năng lượng, chu trình nhiệt, chuyển động cơ học về cơ bản không khác nhau là mấy, chỉ là một thứ dùng để vận hành các vì sao, còn một thứ dùng để vận hành chiếc xẻng nấu ăn",
          "next": [
            202420018
          ]
        },
        "202420018": {
          "id": 202420018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ngoài ra, nó còn cần một hệ thống xào nấu thông minh, để điều chỉnh mức lửa và độ mặn nhạt phù hợp với các khẩu vị khác nhau",
          "next": [
            202420019
          ]
        },
        "202420019": {
          "id": 202420019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Điều này cũng tương tự như việc nghiên cứu thói quen lái tàu của hoa tiêu và tàu trưởng",
          "next": [
            202420020,
            202420027
          ]
        },
        "202420020": {
          "id": 202420020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tức là, chỉ cần tôi học được cách sửa máy nấu ăn, là sẽ biết sửa Đội Tàu Astral rồi...",
          "next": [
            202420021
          ]
        },
        "202420021": {
          "id": 202420021,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202420022
          ]
        },
        "202420022": {
          "id": 202420022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Không sai, đúng là như vậy",
          "next": [
            202420023
          ]
        },
        "202420023": {
          "id": 202420023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tôi nói bừa đấy!",
          "next": [
            202420024
          ]
        },
        "202420024": {
          "id": 202420024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Không sao, tôi đâu có nói lung tung",
          "next": [
            202420025
          ]
        },
        "202420025": {
          "id": 202420025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tin tôi đi, đến lúc bắt tay vào làm thì {F#cô}{M#anh} sẽ biết ngay thôi~",
          "next": [
            202420026
          ]
        },
