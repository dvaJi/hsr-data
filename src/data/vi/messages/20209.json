          ]
        },
        "202090003": {
          "id": 202090003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi sẽ uống tẹt ga luôn!",
          "next": [
            202090007
          ]
        },
        "202090004": {
          "id": 202090004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi có thể uống được không?",
          "next": [
            202090005
          ]
        },
        "202090005": {
          "id": 202090005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Theo kinh nghiệm trước đây, tôi đã giảm bớt nồng độ để phù hợp với khẩu vị của con người.",
          "next": [
            202090006
          ]
        },
        "202090006": {
          "id": 202090006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090007
          ]
        },
        "202090007": {
          "id": 202090007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Chai nước này lấy mật ong từ Thung Lũng Rift làm cốt, kết hợp với nước ép từ quả mặt trăng tươi, có vị chua ngọt, chắc chắn sứa hồng nhỏ sẽ thích.",
          "next": [
            202090008
          ]
        },
        "202090008": {
          "id": 202090008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090009
          ]
        },
        "202090009": {
          "id": 202090009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Cá rồng xanh luôn khiến tôi nhớ về những tảng băng cổ xưa dưới đáy biển sâu - có lẽ thêm chút rượu mật pha hương bạc hà và gừng sẽ giúp anh ấy suy nghĩ tốt hơn.",
          "next": [
            202090010
          ]
        },
        "202090010": {
          "id": 202090010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090011
          ]
        },
        "202090011": {
          "id": 202090011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Còn vài chai tuy không ghi tên người tặng, nhưng {F#cô}{M#anh} chắc chắn biết chúng phù hợp với ai hơn.",
          "next": [
            202090012
          ]
        },
        "202090012": {
          "id": 202090012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090013
          ]
        },
        "202090013": {
          "id": 202090013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Có một chai, vừa uống vào cổ họng đã ấm áp như ánh mặt trời rực lửa, nhưng lại được làm từ hải sâm mũ đỏ chỉ xuất hiện về đêm, uống xong còn khiến người ta không nỡ đi ngủ.",
          "next": [
            202090014
          ]
        },
        "202090014": {
          "id": 202090014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090015
          ]
        },
        "202090015": {
          "id": 202090015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Rượu mật màu nâu được pha với các khoáng chất dinh dưỡng từ núi dưới biển, có thể bảo quản được rất lâu mà vẫn giữ nguyên hương vị ban đầu.",
          "next": [
            202090016
          ]
        },
        "202090016": {
          "id": 202090016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090017
          ]
        },
        "202090017": {
          "id": 202090017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Chai cuối cùng có thêm dịch chiết từ đàn cá bạc tung tăng quẫy đuôi, tạo nên vị mát lạnh hài hòa, với dư vị đặc biệt bất ngờ.",
          "next": [
            202090018
          ]
        },
        "202090018": {
          "id": 202090018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
