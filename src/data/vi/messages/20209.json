          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vậy còn tôi thì sao?",
          "next": [
            202090023
          ]
        },
        "202090020": {
          "id": 202090020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Với những công thức kỳ lạ này, chắc chắn cô sẽ có nhiều chuyện để nói với chị Himeko của chúng tôi",
          "next": [
            202090021
