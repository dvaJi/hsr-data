        "202090000": {
          "id": 202090000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Cá Xám Nhỏ à, chuẩn bị lên đường rồi sao? Tôi đã chuẩn bị một chút rượu mật để tiễn biệt. Vì đây là loại đặc chế nên tôi cũng muốn hỏi ý kiến của {F#cô}{M#anh}.",
          "next": [
            202090001
          ]
        },
        "202090001": {
          "id": 202090001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202090002,
            202090003,
            202090004
          ]
        },
        "202090002": {
          "id": 202090002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cảm ơn nhé, có tâm quá!",
          "next": [
