          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Evanescia! Cô vẫn ở đây à! Cô đang ở đâu vậy",
          "next": [
            202310010
          ]
        },
        "202310008": {
          "id": 202310008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
