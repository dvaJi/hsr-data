        "202310003": {
          "id": 202310003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "\"Nhân vật chính\" đại thắng trong Trò Chơi Ảo Nguyệt, ước nguyện với Aha...",
          "next": [
            202310004
          ]
        },
        "202310004": {
          "id": 202310004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Trở về trường học năm 17 tuổi (Ghi chú: Thiết lập độ tuổi chờ xác định, bé Gấu Mèo có vẻ vẫn còn khá trẻ)",
          "next": [
            202310005
          ]
        },
        "202310005": {
          "id": 202310005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "\"Trường học\" lại không phải là một ngôi trường bình thường, nơi đó đâu đâu cũng là những chuyện kỳ lạ về quy tắc",
          "next": [
            202310006
          ]
        },
        "202310006": {
          "id": 202310006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Trọng tài \"Evanescia\" là thử thách đầu tiên mà nhân vật chính gặp phải sau khi đến trường (cũng là trợ thủ đầu tiên sau khi chinh phục!)",
          "next": [
            202310007,
            202310008,
            202310009
