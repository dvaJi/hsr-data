        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ở Astropolis có một ngôi sao điện ảnh tên là Wubbaboo Thần Thánh, không biết cô có biết không",
