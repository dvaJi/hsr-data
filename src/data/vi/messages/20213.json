        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cứ yên tâm, tôi có góc nhìn của Thượng Đế, cô chính là một bản thể hoàn hảo",
