        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Thật ra... cô của ngày hôm qua... không phải là cô của ngày hôm nay... cô của ngày hôm qua... dễ thương hơn...",
          "next": [
            202130012
