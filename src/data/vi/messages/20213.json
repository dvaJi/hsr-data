        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Nói chuyện cho đàng hoàng đi! Hôm nay tôi đã rất dễ thương rồi, ngày mai còn dễ thương hơn nữa!",
          "next": [
            202130014
