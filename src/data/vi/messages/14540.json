      "messages": {
        "145400000": {
          "id": 145400000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Đây là nhóm thảo luận giải đấu, tất cả các tuyển thủ tham gia Giải Vô Địch đều có mặt ở đây",
          "next": [
            145400001
          ]
        },
        "145400001": {
          "id": 145400001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Xám Cưng, hãy chào hỏi mọi người nào!",
          "next": [
            145400002,
            145400005
          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chimera đối chiến, để thực lực lên tiếng",
          "next": [
            145400003
          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tôi sẽ đánh bại các người và chứng minh rằng tôi là huấn luyện viên số một của Amphoreus",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi vừa mới đánh xong trận đấu phân hạng, vẫn còn là tân binh thôi",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Các vị, xin nhẹ tay một chút",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Đồng đội thân mến, hiếm có dịp gặp được {F#cô}{M#anh} thế này, lần này chúng ta hãy để Chimera của mình quyết đấu một trận nhé!",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hừm, đừng có thua thảm quá đấy, Đấng Cứu Thế",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Muốn cản bước tiến của ta sao? Hừ, xem ngươi có đủ sức không đã",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Không sao cả, tôi sẽ quét sạch mọi chướng ngại vật trước mặt Hoàng Đế",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Này Lông Xám, chúng ta làm một phi vụ nhé? Tôi sẽ đánh cắp con Chimera bên kia cho {F#cô}{M#anh}, còn {F#cô}{M#anh} thì cố tình thua tôi",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Thôi cất đi những suy tính nhỏ nhặt đó đi, Cifera, cô biết đấy, những trò đó không qua mắt được tơ vàng đâu",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Không được phép gian lận! *Chúng tôi* sẽ làm trọng tài, giám sát tất cả mọi người!",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Vừa là trọng tài, vừa là tuyển thủ, sắp xếp như vậy thì làm sao công bằng được chứ?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Ừm... Tribbie sẽ tham gia chiến đấu, Trinnon làm trọng tài, Trianne bắt kẻ xấu. Ừm, vậy là ổn rồi!",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, tôi cũng sẽ dốc toàn lực trong giải đấu Chimera này.",
          "next": [
            145400018,
            145400019
          ]
        },
        "145400018": {
          "id": 145400018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dan Heng lúc nghiêm túc lên, chỉ nghĩ thôi cũng thấy đáng sợ rồi",
          "next": [
            145400020
          ]
        },
        "145400019": {
          "id": 145400019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Được thôi, tôi cũng sẽ dốc hết sức để ứng chiến!",
          "next": [
            145400020
          ]
        },
