      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt Mọi người vẫn ổn chứ?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Nhận được tin nhắn xin trả lời, nhận được tin nhắn xin trả lời!",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "\"Nhắc nhở: Tín hiệu liên lạc hiện tại yếu, vui lòng kiểm tra trạng thái kết nối\"",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@March 7th @{NICKNAME} @Sunday Đã nhận, chúng tôi đều ổn",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Chúng tôi không sao, @Dan Heng báo bình an nhé.",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Đừng lo cho chúng tôi, vừa mới đánh lùi một đợt quái vật xúc tu chui lên từ dưới lòng đất.",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Phù",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Nói mới nhớ, chúng ta nhất định phải đến Astropolis sao? Không có ý gì khác đâu, chỉ là... hơi không yên tâm về Công Ty thôi.",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Chúng ta có thể đến Xianzhou hoặc Trạm Không Gian của cô Herta để nhờ giúp đỡ thử không?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Vấn đề này, cũng không phải tôi chưa từng nghĩ đến.",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Xét về khoảng cách, Xianzhou và Trạm Không Gian Herta đều quá xa xôi. Tình thế cấp bách đành phải tùy cơ ứng biến, phương án giải cứu mang lại nhiều hy vọng nhất trước mắt, vẫn là đề xuất đến Astropolis.",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "So với khoảng cách, điều rắc rối hơn là, Planarcadia là một phần trong mạng lưới thương mại của Công Ty.",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Theo hiệp định thương mại liên hành tinh, Công Ty có quyền ưu tiên xử lý nó, thế lực bên ngoài tùy tiện can thiệp có thể gây ra những tranh chấp pháp lý và ngoại giao phức tạp hơn.",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Thế thì đúng là... bó tay rồi!",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME}, nhiệm vụ dẫn đường phải trông cậy vào {F#cô}{M#anh} rồi.",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Yên tâm đi, tôi sẽ chịu trách nhiệm.",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tôi biết, tôi tin {F#cô}{M#anh}.",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi... tôi không biết phải làm những gì...",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Đừng lo, tôi tin {F#cô}{M#anh}, với tư cách là hoa tiêu đại diện, {F#cô}{M#anh} sẽ có chủ ý của riêng mình.",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tình hình nguy cấp, chúng tôi sẽ ủng hộ mọi quyết định của {F#cô}{M#anh}.",
          "next": [
            150730120
          ]
        },
