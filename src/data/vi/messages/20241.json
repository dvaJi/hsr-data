        "202410029": {
          "id": 202410029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Thật ra tôi vẫn còn mười mấy bộ tóc giả cất dưới đáy rương... Hồi đại học, mỗi khi cùng Motoko vẽ bản thiết kế, chế tạo, những lúc mệt mỏi chúng tôi cũng làm và cắt tỉa các loại tóc giả rồi cho nhau đội thử",
          "next": [
            202410030
          ]
        },
        "202410030": {
          "id": 202410030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nói sang chuyện khác rồi!",
          "next": [
