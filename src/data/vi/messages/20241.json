        },
        "202410032": {
          "id": 202410032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Cho dù không hợp, tay nghề tạo kiểu của tôi chắc vẫn còn, có thể sửa ngay tại chỗ",
          "next": [
