        },
        "202410031": {
          "id": 202410031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Giờ thì có lý do đem ra chia sẻ với mọi người rồi~ Thật muốn xem mọi người thích những kiểu tóc và màu sắc nào",
          "next": [
