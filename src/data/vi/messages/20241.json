      "messages": {
        "202410000": {
          "id": 202410000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tôi đã sắp xếp lại vali một chút, tìm thấy một tấm thẻ thành viên trọn đời áp dụng cho tất cả các salon tóc trên toàn Planarcadia",
          "next": [
            202410001
          ]
        },
        "202410001": {
          "id": 202410001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tặng cho ai được nhỉ?",
          "next": [
            202410002,
            202410004,
            202410007
          ]
        },
        "202410002": {
          "id": 202410002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi là trẻ vị thành niên duy nhất của cả đội tàu, tặng tôi đi!",
          "next": [
            202410003
          ]
        },
        "202410003": {
          "id": 202410003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Biết ngay là {F#cô}{M#anh} sẽ thích mà~ Tặng {F#cô}{M#anh} này, sau này {F#cô}{M#anh} còn có thể dẫn mọi người cùng đi làm tóc nữa",
          "next": [
            202410009
          ]
        },
        "202410004": {
          "id": 202410004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Để tôi nghĩ xem... March chắc chắn sẽ thích, Dan Heng chắc sẽ không từ chối, anh Sunny cũng rất tinh tế, chú Yang cũng có tóc...",
          "next": [
            202410005
          ]
        },
        "202410005": {
          "id": 202410005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Hay là tặng tôi đi! Tôi dẫn mọi người cùng đi làm tóc",
          "next": [
            202410006
          ]
        },
        "202410006": {
          "id": 202410006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Được đó, tôi cũng nghĩ như vậy~",
          "next": [
            202410009
          ]
        },
        "202410007": {
          "id": 202410007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Người nhà chúng ta có thể thay phiên nhau tận hưởng dịch vụ của nhà thiết kế trưởng, cùng nhau làm tóc!",
          "next": [
            202410008
          ]
        },
        "202410008": {
          "id": 202410008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tôi cũng nghĩ như vậy~",
          "next": [
            202410009
          ]
        },
        "202410009": {
          "id": 202410009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Trước đây khi còn học ở Planarcadia, tôi cũng rất thích làm các kiểu tóc mang phong cách khác nhau",
          "next": [
            202410010
          ]
        },
        "202410010": {
          "id": 202410010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tôi nhớ mình từng nhuộm màu tóc rất giống với March, kiểu tóc ngắn như của Dan Heng tôi cũng từng muốn thử, nhưng thợ làm tóc đã liều mạng ngăn cản tôi",
          "next": [
            202410011
          ]
        },
        "202410011": {
          "id": 202410011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tạo hình cuối cùng có thể giống kiểu \"tóc đuôi lượn sóng\" hơn, hơi giống với của Sunday",
          "next": [
            202410012
          ]
        },
        "202410012": {
          "id": 202410012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Nghĩ lại thì, lúc đó họ chọn chiếc thẻ cắt tóc này làm tiền bảo kê, quả thực rất có tâm",
          "next": [
            202410013,
            202410019,
            202410024
          ]
        },
        "202410013": {
          "id": 202410013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Muốn xem vũ trụ kiểu tóc của Himeko quá! Có ảnh không!",
          "next": [
            202410014
          ]
        },
        "202410014": {
          "id": 202410014,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202410015
          ]
        },
        "202410015": {
          "id": 202410015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Khoan đã, phí gì cơ??",
          "next": [
            202410016
          ]
        },
        "202410016": {
          "id": 202410016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Hửm? À, là món quà lưu niệm láng giềng thân thiện nhận được từ thời học sinh",
          "next": [
            202410017
          ]
        },
        "202410017": {
          "id": 202410017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Hóa ra là kiểu láng giềng thân thiện này!",
          "next": [
            202410018
          ]
        },
        "202410018": {
          "id": 202410018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Về ảnh chụp thì, tôi không nhớ rõ lúc đó có mang lên tàu hay không nữa, tôi có thể tìm thử xem",
          "next": [
            202410029
          ]
        },
        "202410019": {
          "id": 202410019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Himeko có gợi ý kiểu tóc nào không? Tôi cũng muốn thay đổi mớ trên đầu này một chút",
          "next": [
            202410020
          ]
        },
        "202410020": {
          "id": 202410020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Khoan đã, phí bảo kê gì cơ??",
