        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Cũng đúng, để bù lại cho những đánh giá tệ 1 sao từ chủ nợ",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Không, nhưng tôi sẽ cố gắng để không phụ sự kỳ vọng của họ",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Thì ra đó là sự mong đợi sao?",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Gay gắt quá đó, người đại diện",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Giờ hãy xem giá trị của bản ghi nhớ này đi, ngang với thành quả của mười năm qua đấy",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Đoạn ghi âm Hành Giả Vận Mệnh đánh giá sắc bén về Aeon của nhà mình, hình ảnh hóng hớt tiện tay lưu lại, đều là tư liệu độc quyền cả đấy",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Năm xưa sao tôi lại để mất tài khoản này cơ chứ...",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đừng nói suông chứ! Chuyển tiếp nhanh cho tôi đi",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lại muốn vẽ dã sử của riêng cô sao?",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cô Colt ơi, đói quá, măm măm",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Đừng vội~ Chia sẻ cho một cái trước nhé",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Không hoang dã đến vậy đâu",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ý tôi là, tầm nhìn đâu có nhỏ như vậy! Dã sử đương nhiên là xem của người khác mới thú vị, ví dụ như...",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Bây giờ có thể nấu rất nhiều món. Cảm giác \"Gió Quyện Hương Thuốc\" cũng có thêm tư liệu mới rồi...",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Cứ chia sẻ đại một cái trước đã",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Hàng trăm Hổ Phách Kỷ trước, một Nhà Sử Học Hư Cấu đã để lại bút tích cuối cùng...",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Tayzzyronth rục rịch chuyển động, ngày đi ngàn dặm, chỉ vì một hành tinh vô danh...\"",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Trong lúc đó, Ena và Xipe cũng đang mai phục trong góc khuất gần hành tinh...\"",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Họ và Oroboros không hẹn mà gặp, các vị thần đụng độ nơi ngõ hẹp, giương cung rút kiếm, Sparxie bắn tứ tung, nhưng lại chỉ vì một người...\"",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Aha, ở ngay đó.\"",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đừng tự luyến quá, Aha!",
