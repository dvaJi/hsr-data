          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hihi... Có thu hoạch gì không? Phát hiện tài khoản này có số dư để trả nợ à?",
