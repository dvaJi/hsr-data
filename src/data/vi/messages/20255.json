            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Đây chẳng phải là dã sử của cô sao! Sao còn giở trò này ra nữa!",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nói thật thì tôi xem hơi chán rồi, có gì mới mẻ hơn không?",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Chưa nói xong mà... Sự thật mà các nhà sử học chưa kịp biết: \"Các vị thần thèm khát hành tinh vô danh, là bởi vì...\"",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Kịch bản, sách tranh, truyện fanfic mà Aha dùng để luyện tay những năm đầu đều được giấu ở đó.\"",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "\"Ngài ấy, muốn đục khoét ở đó. Ngài ấy, muốn nuốt trọn. Ngài ấy, và Ngài ấy, thì lại muốn có được...\"",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Hihi, dù sao thì tôi cũng từng vẽ thật",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Trong ghi chú còn vài bài có sẵn, gửi ngay cho {F#cô}{M#anh} thưởng thức đây",
          "next": [
            202550036
