        "150120100": {
          "id": 150120100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Đáng ghét, ngươi đang làm gì vậy?",
          "next": [
            150120101
          ]
        },
        "150120101": {
          "id": 150120101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ai đấy?",
          "next": [
            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Đừng giả ngốc nữa! Ngươi là người phụ trách Thời Sự Furbobocom, chuyện này là do ngươi lên kế hoạch phải không?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Tay ta bắt đầu không còn nghe theo ý ta nữa",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Cái mũi cũng đang cử động lung tung",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Mau dừng lại!",
          "next": [
            150120106,
            150120109
          ]
        },
        "150120106": {
          "id": 150120106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ngươi chính là \"Sát Thủ Thiên Niên Kỷ\" phải không?",
          "next": [
            150120107
          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Làm sao biết được số điện thoại của ta vậy?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ngươi thậm chí còn không biết ta là ai sao? Thật nực cười, ngươi còn không biết ta là ai, vậy mà lại dám làm đến mức này",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ngươi chính là tên bác sĩ đó, Izol, phải không?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Làm sao biết được số điện thoại của ta vậy?",
          "next": [
            150120111
          ]
        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ta không phải! Thật nực cười, ngươi thậm chí còn không biết ta là ai, vậy mà lại dám làm đến mức này",
          "next": [
            150120112
          ]
        },
        "150120112": {
          "id": 150120112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Về phương thức liên lạc của ngươi",
          "next": [
            150120113
          ]
        },
        "150120113": {
          "id": 150120113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Thông tin liên lạc của người phụ trách doanh nghiệp truyền thông đều có thể tra cứu công khai, ngay cả điều này mà ngươi cũng không biết sao?",
          "next": [
            150120114
          ]
        },
        "150120114": {
          "id": 150120114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Dừng lại đi, ngươi có thể đưa ra điều kiện, ta đều có thể đáp ứng, không cần phải làm chuyện tàn độc như vậy",
          "next": [
            150120115
          ]
        },
        "150120115": {
          "id": 150120115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Hướng chân của ta rất kỳ lạ",
          "next": [
            150120116
          ]
        },
        "150120116": {
