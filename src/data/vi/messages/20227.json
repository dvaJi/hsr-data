        "202270004": {
          "id": 202270004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ngủ một giấc thật dài, tuy đầu óc trống rỗng nhưng trong giấc mơ lại có đủ mọi thứ",
          "next": [
