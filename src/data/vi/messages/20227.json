        "202270001": {
          "id": 202270001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Vào ngày đáng lẽ nên thư giãn này, {F#cô}{M#anh} còn biết nghỉ ngơi hơn cả tôi",
          "next": [
