      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, lúc nãy tôi ở bờ biển, lại thu thập được một vài mẫu âm thanh",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ví dụ như tiếng dừa lăn trên mặt đất, tiếng soda sủi bọt tràn ly, tiếng mực xèo xèo trên vỉ sắt...",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đối phương đang nhập...",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nhìn mà đói luôn, muốn làm hai xiên mực",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Thật ra tôi cũng...",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bản nhạc này thơm quá... à nhầm, con mực này nghe hay thật",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, so với lúc đầu óc trống rỗng vì không có cảm hứng, cảm nhận sự kích thích của hương vị đúng là giúp tinh thần tỉnh táo hơn",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Thật ra còn vài âm thanh mang đậm không khí vùng biển hơn nữa, {F#cô}{M#anh} nghe thử nè",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Đây là lúc sóng biển rút đi: Sa la la... ùng ục ùng ục ùng ục ùng ục...",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất (Nhận diện được tiếng bọt khí)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Gió biển luồn qua mỏ neo rỉ sét: Vù... u... vù... u...",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất (Nhận diện loa âm trầm)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hải âu bay qua: Xoạt xoạt... vù vù... gu gu... á!",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất (Nhận diện tiếng chim kêu)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Xin lỗi, tiếng \"á\" đó là tôi... đồ ăn vặt trên tay vừa bị hải âu cướp mất...",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hiện tại số lượng mẫu đã đủ rồi, nhưng cứ có cảm giác vẫn thiếu một chút... âm thanh \"chạm đến tâm hồn\"",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, không biết {F#cô}{M#anh} có cảm hứng âm thanh nào có thể khiến người ta lập tức phấn chấn không?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lắng nghe tiếng gầm vang khi Đội Tàu thực hiện Bước Nhảy",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đối phương đã nhận tệp đính kèm \"Tiếng Gầm Của Bước Nhảy.mp3\"",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Âm thanh đại diện cho \"Khai Phá\" quả thật chạm đến tâm hồn",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nghe tiếng chuông báo thức nhé",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đối phương đã nhận tệp đính kèm \"Tiếng Chuông Báo Thức Sáng Sớm.mp3\"",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tim ngừng đập... cũng là một kiểu chạm đến tâm hồn nhỉ",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Nhưng vì sức khỏe thể chất và tinh thần của khán giả, tôi có thể hạ xuống một quãng tám",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nghe giọng ca linh hồn của tôi nhé!",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đối phương đã nhận tệp đính kèm \"Hát Vang Trong Phòng Tắm.mp3\"",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Đây là tiếng hát của {F#cô}{M#anh} sao? Đúng là rất... chạm đến tâm hồn.",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ừm... có vẻ có thể thử ghép lại một cách đơn giản xem sao!",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wing it now! Cast aside the unchanging score. Swing now! We aren't bolted parts anymore...",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất (Nhận diện được giọng hát gốc)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bản remix \"Chỉ Có Đuổi Theo Hướng Gió\", có thêm đoạn sample \"chạm đến tâm hồn\" và nhạc đệm của gió biển, nghe có mang đậm không khí cuồng nhiệt của mùa hè hơn không?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Đột nhiên có cảm hứng rồi, tôi về phòng thu âm một chuyến.",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Cảm ơn ý tưởng tuyệt vời của {F#cô}{M#anh}!",
