      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Hello, nhân vật chính",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Nếu ngươi nhận được tin nhắn hẹn giờ này, chứng tỏ kế hoạch của ta chắc chắn lại lại lại xảy ra sự cố.",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Đương nhiên, cũng không loại trừ khả năng, ngươi đã bị Stellaron nổ tung lên trời, lúc này đây, người đọc tin nhắn này chính là ta của tương lai",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Nhưng ta đoán, điện thoại của ngươi chắc không có chất lượng tốt như vậy đâu",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asat Pramad? Sao lại là ngươi nữa?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kế hoạch của ngươi đã thất bại, chúng ta đã đánh bại ngươi!",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "\"Số máy bạn liên lạc không tồn tại, gửi tin nhắn thất bại\"",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Thành thật mà nói, ta không hề phản đối diễn biến cốt truyện này.",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ngược lại, ta rất mong đợi chiến thắng của các ngươi",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Điều này có thể chứng minh ta đã sai",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Với điều kiện là, các ngươi có thể vượt qua trò chơi này",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Bất kể ai thắng, Ngài ấy cũng sẽ thức tỉnh và nuốt chửng chúng ta.",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dù ngươi không nhận được tin nhắn, nhưng... tại sao lại làm vậy?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ngươi chắc hẳn đoán được ta muốn hỏi gì",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "\"Số máy bạn liên lạc không tồn tại, gửi tin nhắn thất bại\"",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ây da... tại sao phải làm như vậy chứ?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Nếu Aha đã trốn sau hậu trường, bỏ mặc sự mục nát của thế giới, vậy thì để ta làm thay, tuyên bố khiêu chiến với vũ trụ.",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Và bây giờ, thử thách mới mang tên: Đánh bại \"Tham Ăn\" đã hồi sinh",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Là một vị anh hùng sinh ra từ Hủy Diệt, trải qua thử thách, mang Vui Vẻ đích thực trở lại thế gian",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Hay là dã thú hoàn thành việc trả thù, để vui vẻ đón nhận sự diệt vong đầy tôn nghiêm trước khi chìm vào điên loạn",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Nhân vật chính, ngươi có thể viết một cái kết hay hơn cho câu chuyện cười này không?",
          "next": []
        }
