          ]
        },
        "150970104": {
          "id": 150970104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"Ngoài ra! Tôi cũng có để lại một món quà cho {F#cô}{M#anh} ở Thành Phố Duomension, còn vị trí cụ thể thì...\"",
          "next": [
            150970106
