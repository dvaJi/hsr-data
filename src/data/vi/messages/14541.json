        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Trong môi trường luôn biến đổi không ngừng, không tồn tại \"giải pháp tối ưu cho sự sống\"",
