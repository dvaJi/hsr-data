      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Ồ~ Nghe nói {F#cô}{M#anh} vừa chịu một vố tức tưởi chưa từng có? Thế nào, đã nếm trải được cảm giác thường ngày của tôi chưa?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sao tin tức của anh nhanh nhạy thế? Chuyện này vừa kết thúc chưa đầy một phút mà anh đã biết rồi sao?",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vui chưa? Cuối cùng cũng được xem trò cười của tôi rồi đúng không?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Dù sao ở Trung Tâm Việc Làm Sau Khi Chết tôi cũng có vài tên đàn em hồn ma, đã sớm nấp ở gần đây để livestream toàn bộ quá trình cho tôi rồi.",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Đương nhiên rồi, tôi cũng không chỉ đơn giản là buông lời châm chọc đâu, tôi có cách có thể giúp {F#cô}{M#anh}.",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Cụ thể gặp mặt rồi nói sau nhé, tôi đang ở ngay gần đây, {F#cô}{M#anh} qua tìm tôi đi.",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Skott đã chia sẻ vị trí",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Giúp tôi sao? Sao đột nhiên lại tốt bụng thế?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "{F#Cô}{M#Anh} vẫn cảnh giác như vậy nhỉ",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Qua đây nói chuyện với tôi trước đi mà, tôi đâu có đánh lại {F#cô}{M#anh}, sợ gì chứ?",
          "next": [
