        },
        "202520005": {
          "id": 202520005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Trong thời gian \"Tàu Bông\" tạm ngừng phát hành, cứ để người ta ăn tạm chút đồ thay thế cho no bụng đi!",
