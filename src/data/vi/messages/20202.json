        "202020006": {
          "id": 202020006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Không sao không sao, Nhóc Ica vừa bò qua chân tôi, chạm phải phím từ gợi ý của tôi",
          "next": [
            202020007
          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Nhưng tôi thực sự phải đến tìm Xám Cưng đây~ Dù sao thì, trận chiến lớn đâu phải chuyện dễ dàng",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Vết thương đã đỡ hơn chưa? {F#Cô}{M#Anh} ngủ có ngon không? Ăn uống có ngon miệng không? Làm việc có thấy mệt mỏi không? Còn có chỗ nào khác không khỏe không?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi vẫn ổn!",
          "next": [
            202020010
          ]
        },
        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Vậy thì tôi yên tâm rồi!",
