        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tham ăn, ham ngủ, lười vận động... Thầy thuốc ơi, tôi còn cứu được không?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Nếu cơ thể muốn ngủ thì cứ để nó ngủ thôi~ {F#Cô}{M#Anh} chắc là mệt lắm rồi, đừng gắng gượng quá nhé",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Muốn vừa ngon miệng lại vừa khỏe mạnh thì tất nhiên, còn có một cách khác",
          "next": [
            202020014
          ]
