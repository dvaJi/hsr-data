        },
        "202050009": {
          "id": 202050009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Cảm ơn {F#cô}{M#cậu}, không sao đâu. Tôi biết việc tìm kiếm con bé sẽ tốn không ít công sức",
          "next": [
            202050010
          ]
        },
        "202050010": {
          "id": 202050010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Vậy nên phải nghĩ cách để con bé tự về.",
          "next": [
            202050011
          ]
        },
        "202050011": {
          "id": 202050011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Lát nữa lên nhà chúng tôi ăn cơm không? Xám.",
          "next": [
            202050012
          ]
        },
        "202050012": {
          "id": 202050012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "À. Để tôi nói bằng tin nhắn thoại nhé. Dạo gần đây Cifera hay dẫn mấy người bạn khác nhau về nhà ăn cơm lắm. Con bé thường biến mất vào giờ ăn tối. Tôi đoán chắc lại đi tìm bạn rồi. Nhưng tôi không biết phải đến chỗ ai để tìm được nó nữa, nó cứ thích chạy lung tung. Nên tôi mới nghĩ ra cách này.",
          "next": [
            202050013
          ]
        },
        "202050013": {
          "id": 202050013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202050014
          ]
        },
        "202050014": {
          "id": 202050014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Mấy người bạn mà con bé có lưu liên lạc trong Phiến Đá, tôi đều đã gọi hết rồi, có những ai nhỉ... Agy. Khoan đã, để tôi xem nào. Để tôi đếm nhé, Agy, chị Tribbie, thầy Anaxa, Hoàng Tử Bất Tử, Công Chúa Ốc Sên, Bánh Kem Hồng, Cậu Nhóc Cứu Thế đã nghỉ hưu, Hoàng Đế Đại Vương, Nhà Cung Ứng Cá Khô, Zaggy... và cả Lông Xám nữa. Chính là {F#cô}{M#cậu} nhỉ. Tên hay quá đi mất. Vừa thông dụng dễ hiểu lại có cá tính.",
          "next": [
            202050015
          ]
        },
        "202050015": {
          "id": 202050015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Chuyển đổi tin nhắn thoại hoàn tất",
          "next": [
            202050016,
            202050017,
            202050019
          ]
        },
        "202050016": {
          "id": 202050016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bà ơi, đừng quá để tâm đến những cái tên này",
          "next": [
            202050020
          ]
        },
        "202050017": {
          "id": 202050017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bàn ăn có đủ chỗ không? Cháu có thể vác một cái bàn dài đến đấy",
          "next": [
            202050018
          ]
        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Đủ chứ, bàn ghế đảm bảo đủ, cơm nước cũng vô tư.",
          "next": [
            202050020
          ]
        },
        "202050019": {
          "id": 202050019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Một nồi lẩu đầy đồ ăn! Gói sủi cảo!",
          "next": [
            202050020
          ]
        },
        "202050020": {
          "id": 202050020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ôi chao, mấy đứa trẻ... Đừng chạy lung tung... đã đến trước rồi, tôi đi sắp xếp một chút đây. Ôi chà. Vậy thì đợi {F#cô}{M#cậu} đến nhé. Chắc chắn Cifera sẽ rất vui đấy.",
          "next": [
            202050021
          ]
        },
        "202050021": {
