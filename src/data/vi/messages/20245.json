        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Chắc là đã bay đi qua khung cửa sổ đang mở rồi",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A... đừng buồn, biết đâu là vì nó bắt đầu khao khát cuộc sống tự do bay lượn",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Cảm ơn {F#cô}{M#anh} đã an ủi, tôi cũng nghĩ vậy~",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tôi vẫn luôn mong đợi ngày nó bay lên bầu trời một lần nữa",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tuy có hơi đột ngột... nhưng cô cũng đang mong chờ ngày nó bay lên bầu trời một lần nữa có phải không?",
