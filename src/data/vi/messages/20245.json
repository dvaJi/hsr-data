        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bữa trưa hôm nay của chim nhỏ: Ngô, hạt diêm mạch, đậu Hà Lan nghiền (nhất định phải nhớ uống nước!)",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ăn toàn đồ chay vậy, sao chẳng có chút thịt nào!",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hóa ra bảo vệ cổ họng phải ăn những thứ này sao, cầu kỳ thật! Không hổ danh là đại minh tinh!",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Xin lỗi! Tôi vốn định gửi cho chính mình, kết quả lại bấm nhầm",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Còn nhớ không, trước đây tôi từng kể với {F#cô}{M#anh} là đã nhặt được một chú chim non bị gãy cánh",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Thực đơn bên trên không phải bữa trưa của tôi, là của chú chim nhỏ đó",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bây giờ nó đã bình phục rồi, đôi cánh cũng mọc ra những chiếc lông vũ mới",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tôi sắp về đến nhà rồi, lát nữa sẽ cho {F#cô}{M#anh} xem dáng vẻ hiện tại của nó.",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chim nhỏ nuôi chim nhỏ, thật ấm áp",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chim nhỏ do chim nhỏ nuôi, chắc chắn đã lớn thành một bé chim mập ú rồi nhỉ!",
          "next": [
            202450011
          ]
