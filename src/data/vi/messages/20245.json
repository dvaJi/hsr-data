        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ừm! Thật ra tôi vẫn luôn mong đợi, ngày mà nó bay lên bầu trời một lần nữa",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bình thường nó cũng sẽ bay lên bậu cửa sổ ngắm nhìn thế giới bên ngoài. Lần này, chắc chắn nó đã chuẩn bị sẵn sàng",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Dù hơi tiếc, không thể nhìn thấy dáng vẻ nó dang cánh bay cao",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Chíp chíp! Cúc cu! Líu lo!",
