        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ừm, quả nhiên {F#cô}{M#anh} hiểu",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chú chim nhỏ đã bắt đầu cuộc đời loài chim và chuyến phiêu lưu mới của nó! Chắc chắn nó cũng sẽ không quên cô",
          "next": [
            202450022
