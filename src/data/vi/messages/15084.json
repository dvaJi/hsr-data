          ]
        },
        "150840102": {
          "id": 150840102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{F#Cô}{M#Anh} còn nhớ chuyện lúc trước tôi để lại vé xem thi đấu cho {F#cô}{M#anh} không?",
          "next": [
            150840103
          ]
        },
        "150840103": {
          "id": 150840103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Vốn dĩ mong {F#cô}{M#anh} có thể thưởng thức buổi biểu diễn, không ngờ, {F#cô}{M#anh} lại trở thành một phần của buổi biểu diễn.",
          "next": [
            150840104,
            150840105
          ]
        },
        "150840104": {
          "id": 150840104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Không xem được buổi biểu diễn thật đáng tiếc, có thể có vé cho buổi biểu diễn lần sau không?",
          "next": [
            150840106
          ]
        },
        "150840105": {
          "id": 150840105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Không giấu gì, sau khi về tôi vẫn luôn tìm kiếm video ghi hình buổi biểu diễn khai mạc.",
          "next": [
            150840106
          ]
        },
        "150840106": {
          "id": 150840106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Dù sao thì lúc đó {F#cô}{M#anh} đang ngồi trong xe đua, lại còn nghe bài hát mới với chất lượng âm thanh tệ hại của Team Radio.",
          "next": [
            150840107
          ]
        },
        "150840107": {
          "id": 150840107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tôi cũng thấy ngại quá",
          "next": [
            150840108
          ]
        },
        "150840108": {
          "id": 150840108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Cho nên",
          "next": [
            150840109
          ]
        },
        "150840109": {
          "id": 150840109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tôi đã chuẩn bị cho {F#cô}{M#anh} một vị trí đặc biệt, có thể cảm nhận buổi biểu diễn trực tiếp của tôi, {F#cô}{M#anh} thấy thế nào?",
          "next": [
            150840110
          ]
        },
        "150840110": {
          "id": 150840110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tuyệt quá, vậy có thể xem ở đâu?",
          "next": [
            150840111
          ]
        },
        "150840111": {
          "id": 150840111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tôi và Giải Trí Hành Tinh Hòa Bình có một dự án hợp tác, mục tiêu là \"tái hiện cảm xúc tại hiện trường\"",
          "next": [
            150840112
          ]
        },
        "150840112": {
          "id": 150840112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bất cứ ai cũng có thể xem đi xem lại buổi biểu diễn trực tiếp của Robin trên sân khấu Công Viên Bờ Biển Astropolis",
          "next": [
            150840113
          ]
        },
        "150840113": {
          "id": 150840113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Nếu {F#cô}{M#anh} có hứng thú, hãy đến quầy bar ở Công Viên Bờ Biển tìm một nhân viên pha chế tên là \"Rocca\"",
          "next": [
            150840114
          ]
        },
