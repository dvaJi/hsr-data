      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đã cập nhật phiên bản trình cắm \"Thần Khí Tìm Blade\" cho {F#cô}{M#anh}",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Bản cập nhật này: Sửa các lỗi đã biết, cải thiện hiệu suất giảm rung, xem thêm nhiều video Bánh Kem Mèo",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "{F#Cô}{M#Anh} đã vỗ điện thoại của Blade và khiến nó rung một cái",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Bạn của bạn Blade đã online",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Đúng lúc lắm, tôi vừa nghĩ đến {F#cô}{M#anh}.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thật vinh hạnh quá! Kể chi tiết xem anh nghĩ gì nào?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cuối cùng cũng muốn ôn lại chuyện cũ với tôi rồi sao?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Không phải.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Đối phương đang nhập...",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Trước đây tôi có thấy vài món đồ tại Kho Quân Dược tuy bị hao mòn nghiêm trọng, nhưng chất liệu vẫn còn tốt... Chẳng thấy ai nhận cả, chắc là của {F#cô}{M#anh} để lại ngày xưa.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Đúng lúc {F#cô}{M#anh} gửi tin nhắn, tiện thể hỏi luôn, {F#cô}{M#anh} muốn gì? Sau khi trở về, tôi có thể cải tạo và đúc lại.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tôi đã để lại gì? Vũ khí sao?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Vài món đồ đã biến dạng hoàn toàn, nhìn cấu tạo chắc đều là đồ gia dụng.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tận dụng tối đa mọi vật, {F#cô}{M#anh} nói đi, tôi đều có thể chế tạo.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du hành giữa các vì sao tốn nhiều sức lực, cần một \"máy ru ngủ\" có thể lập tức ru tôi ngủ mọi lúc mọi nơi",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Trước đây ở Xianzhou, chúng tôi gọi nó là \"giường nôi\".",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Muốn thứ gì đó không quá phổ thông",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "{F#Cô}{M#Anh} ngủ có ngon không?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dạo trước tôi có đúc được mấy món đồ hỗ trợ giấc ngủ trên phi thuyền. Ý {F#cô}{M#anh} thế nào?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Vậy tôi muốn nâng cấp! Tôi muốn một thứ có thể ru tôi ngủ ngay lập tức, mọi lúc mọi nơi",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Được.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi không kén đâu, anh cứ thoải mái mà làm!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dạo trước tôi có đúc được mấy món đồ hỗ trợ giấc ngủ trên phi thuyền. Ý {F#cô}{M#anh} thế nào?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Được đấy, tôi muốn một chiếc máy ru ngủ có thể ru tôi ngủ ngay lập tức, mọi lúc mọi nơi",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Được.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ru ngủ không khó, nhưng để đạt được hiệu quả cưỡng chế chìm vào giấc ngủ, cần phải thiết kế thêm.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Có thể thêm chút tiếng ồn trắng, sẽ chìm vào giấc ngủ nhanh hơn",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Rất đơn giản. Thêm vài miếng sắt vào là có thể mô phỏng âm thanh khi đúc kiếm.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mặc dù trước đây âm thanh này từng khiến tôi tỉnh táo hơn. Nhưng đối với {F#cô}{M#anh}, có lẽ nó có tác dụng ru ngủ.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Có thể thêm vài tính năng hỗ trợ giấc ngủ bằng vật lý không? Mát-xa, vỗ gối hay đại loại vậy?",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "...Được.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Trong phòng dụng cụ có mấy bộ phận khớp cánh tay robot bỏ đi, có thể mô phỏng những động tác này.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Chỉ là tiếng ồn hơi lớn, cứ coi như là tiếng ồn trắng đi.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Có thể thêm chút bài hát ru giọng người không?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "...Được.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Gắn thêm một cái máy phát nhạc bên trong, có thể ghi âm một bài vào đó.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Nhưng tôi hát không hay, cùng lắm là đọc cho {F#cô}{M#anh} nghe vài... lời bài hát.",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Được được được, kiểu thiên đường thế này cũng được đấy...",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sau khi cải tạo xong, có thể gửi đi hoặc tự đến lấy, tùy {F#cô}{M#anh}.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tôi sẽ liên lạc sau.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tạm biệt.",
          "next": [
            202370041
          ]
        },
