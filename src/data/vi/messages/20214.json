            202140002
          ]
        },
        "202140002": {
          "id": 202140002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Nếu gặp sinh vật không thể giao tiếp được, cứ tìm tôi bất cứ lúc nào.",
