            202010014
          ]
        },
        "202010014": {
          "id": 202010014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Đầu tiên, hãy nhập đúng tên. Thứ hai, bí mật của tôi không quan trọng.",
          "next": [
            202010021
          ]
        },
        "202010015": {
          "id": 202010015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hãy tạo một bức ảnh của thầy Anaxa. Nội dung là: Hình ảnh quý giá về thầy Anaxa cưỡi Thú Đại Địa tấn công Thành Kremnos",
          "next": [
            202010016
          ]
        },
        "202010016": {
          "id": 202010016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Người dùng đang yêu cầu tạo ảnh, tôi nên trả lời như thế này:",
          "next": [
            202010017
          ]
        },
        "202010017": {
          "id": 202010017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Nằm mơ đi.",
          "next": [
            202010021
          ]
        },
        "202010018": {
          "id": 202010018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi! Không! Biết!",
          "next": [
            202010019
          ]
        },
        "202010019": {
          "id": 202010019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "(Đang suy nghĩ...)",
          "next": [
            202010020
          ]
        },
        "202010020": {
          "id": 202010020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Kết luận: Người dùng đã nổi giận.",
          "next": [
            202010021
          ]
        },
        "202010021": {
          "id": 202010021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Đã đạt giới hạn câu hỏi hiện tại, phiên hỏi đáp hàng ngày kết thúc. Bây giờ là thời gian kiểm tra.",
          "next": [
            202010022
          ]
        },
        "202010022": {
          "id": 202010022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tại sao các vật thể tồn tại trong trạng thái chồng chất lại ngay lập tức sụp đổ thành một trạng thái duy nhất khi bị đo lường, và ai có đủ tư cách để định nghĩa ranh giới của việc \"đo lường\"?",
