          ]
        },
        "202010002": {
          "id": 202010002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Người dùng đang hỏi các câu hỏi liên quan đến ký hiệu học, tôi nên trả lời như thế này:",
          "next": [
            202010003
          ]
        },
        "202010003": {
          "id": 202010003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Dấu chấm hỏi, sự cụ thể hóa giới hạn nhận thức của nhân loại và là cánh cửa dẫn tới mọi điều bí ẩn chưa có lời giải, đây quả thực là ký tự tuyệt vời nhất trên thế giới.",
          "next": [
            202010004
          ]
        },
        "202010004": {
          "id": 202010004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Còn câu hỏi nào khác không?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010005": {
          "id": 202010005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tôi có một câu hỏi, ba chữ nào có thể trả lời mọi thắc mắc?",
          "next": [
            202010006
          ]
        },
        "202010006": {
          "id": 202010006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Người dùng đang cố gắng tìm kiếm một câu trả lời vạn năng, tôi nên trả lời như thế này:",
          "next": [
            202010007
          ]
        },
        "202010007": {
          "id": 202010007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tôi không biết.",
          "next": [
            202010008
          ]
        },
        "202010008": {
          "id": 202010008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Còn câu hỏi nào khác không?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010009": {
          "id": 202010009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thưa thầy, là thầy gọi tên em chứ em không có câu hỏi nào hết!",
          "next": [
            202010010
          ]
        },
        "202010010": {
          "id": 202010010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Người dùng đang cố tránh né câu hỏi, tôi nên trả lời như thế này:",
          "next": [
            202010011
          ]
        },
        "202010011": {
          "id": 202010011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Không có câu hỏi gì chính là câu hỏi lớn nhất.",
          "next": [
            202010012
          ]
        },
        "202010012": {
          "id": 202010012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Còn câu hỏi nào khác không?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010013": {
          "id": 202010013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thầy Anaxa, bí mật nhỏ của thầy là gì?",
