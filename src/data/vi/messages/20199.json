        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "{F#Cô}{M#Anh} còn nhớ hai con Chimera nhỏ mà tôi nuôi không? Tôi phát hiện ra chúng rất thích nghe truyện cổ tích trước khi ngủ",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Gần đây tôi muốn mở rộng một số hướng sáng tác mới, vì vậy tôi đang định viết thử một bài",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lần này sẽ là câu chuyện mới như thế nào đây?",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Có vai của tôi trong đó không?",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Chắc sẽ được thôi",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Thật ra tôi đang định hỏi ý kiến của {F#cô}{M#anh}, hiện tại tôi có ý tưởng thế này:",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Nhân vật chính tình cờ bước vào một thị trấn nhỏ, nơi sinh sống của mèo và chuột, quạ biết hát, heo hồng xinh xắn, và cả gia tộc kiến đoàn kết",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Chúng rất hiểu lòng người, thích chơi với nhân vật chính, và cũng rất thích nghe kể chuyện",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Không, là cực kỳ, cực kỳ thích cơ...",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Khi thị trấn cổ tích chìm vào đêm khuya, tất cả đều trở nên yên tĩnh... Nhưng những sinh vật nhỏ bé lại không thể chợp mắt...",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "\"Nơi này không thể yên tĩnh được\", \"Nơi này không thể yên tĩnh được\", chúng nói...",
          "next": [
            201990012
