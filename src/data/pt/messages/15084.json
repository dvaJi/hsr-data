          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Eu já avisei o pessoal",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "E você vai ser o primeiro público dessa performance especial",
