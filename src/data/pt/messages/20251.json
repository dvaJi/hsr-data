          ]
        },
        "202510006": {
          "id": 202510006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "E aí? Ficar hesitando não é bem o seu estilo",
          "next": [
            202510008
          ]
        },
        "202510007": {
          "id": 202510007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tá pensando muito?",
          "next": [
            202510008
          ]
        },
        "202510008": {
          "id": 202510008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Eu recebi uma obra de arte.",
          "next": [
            202510009
          ]
        },
        "202510009": {
          "id": 202510009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Há algum tempo, um artista de retratos de rua me pediu para ser modelo e pintou uma obra intitulada \"Pearl\".",
          "next": [
            202510010
          ]
        },
        "202510010": {
          "id": 202510010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "O espaço negativo nesta peça é incrivelmente marcante.",
          "next": [
            202510011
          ]
        },
        "202510011": {
          "id": 202510011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Porque tudo que fizeram foi dar um único corte no papel com uma faca.",
          "next": [
            202510012
          ]
        },
        "202510012": {
          "id": 202510012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Reflexão: qual é a conexão entre a obra de arte e eu?",
          "next": [
            202510013,
            202510016
          ]
        },
        "202510013": {
          "id": 202510013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Arte ainda é muito difícil de entender",
          "next": [
            202510014
          ]
        },
        "202510014": {
          "id": 202510014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Um único corte... Ah, sei lá, é pra botar lencinho no meio? Talvez o significado seja tipo...",
          "next": [
            202510015
          ]
        },
        "202510015": {
          "id": 202510015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "\"Pearl, me puxa?\"",
          "next": [
            202510019
          ]
        },
        "202510016": {
          "id": 202510016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ah eu já manjo tudo de arte",
          "next": [
            202510017
          ]
        },
        "202510017": {
          "id": 202510017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Um corte que rasga o espaço... não parece tipo uma carteira aberta?",
          "next": [
            202510018
          ]
        },
        "202510018": {
          "id": 202510018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Enfia a mão aí dentro e você com certeza vai tirar alguma coisa...",
          "next": [
            202510019
          ]
        },
        "202510019": {
          "id": 202510019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510020
          ]
        },
        "202510020": {
          "id": 202510020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Conjectura: era um comerciante de caixas surpresa disfarçado. Não me surpreende que tenham me abordado na rua.",
          "next": [
            202510021
          ]
        },
        "202510021": {
          "id": 202510021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mas sua interpretação é realmente interessante.",
          "next": [
            202510022
          ]
        },
        "202510022": {
          "id": 202510022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Arte: a desconstrução da vida.",
          "next": [
            202510023
          ]
        },
        "202510023": {
          "id": 202510023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Interpretar a arte: também significa desconstruí-la.",
          "next": [
            202510024
          ]
        },
        "202510024": {
          "id": 202510024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mas: desconstruir a arte te dá uma resposta?",
          "next": [
            202510025
          ]
        },
        "202510025": {
          "id": 202510025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Talvez não. Portanto: você precisa desconstruir a desconstrução da arte.",
          "next": [
            202510026,
            202510027
          ]
        },
        "202510026": {
          "id": 202510026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Que isso gente, ela pifou! Aleksa, tocar trombeta!",
          "next": [
            202510028
          ]
        },
        "202510027": {
          "id": 202510027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ai caraca. O que foi que eu fiz, a Pearl bugou",
          "next": [
            202510028
          ]
        },
        "202510028": {
          "id": 202510028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510029
          ]
        },
        "202510029": {
          "id": 202510029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Não se preocupe. Você apenas me inspirou a fazer uma pequena digressão abstrata.",
          "next": [
            202510030
          ]
        },
        "202510030": {
          "id": 202510030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mas agora eu realmente tenho uma compreensão completamente nova dessa obra...",
          "next": [
            202510031
          ]
        },
        "202510031": {
          "id": 202510031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ela pode estar dizendo:",
          "next": [
            202510032
          ]
        },
        "202510032": {
          "id": 202510032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "\"Abra a concha, eu sou a pérola.\"",
          "next": [
            202510033
          ]
        },
