  "sections": [
    {
      "id": 2024800,
      "startingMessageId": [
        202470035
      ],
      "messages": {
        "202470035": {
          "id": 202470035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "{F#Amiga}{M#Amigo}, rápido! Me dá sua resposta em três segundos!",
          "next": [
            202470036
          ]
        },
        "202470036": {
          "id": 202470036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Vermelho ou azul?",
          "next": [
            202470037,
            202470038,
            202470039
          ]
        },
        "202470037": {
          "id": 202470037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vermelho!",
          "next": [
            202470040
          ]
        },
        "202470038": {
          "id": 202470038,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Azul!",
          "next": [
            202470040
          ]
        },
        "202470039": {
          "id": 202470039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tanto faz. Tesoura!",
          "next": [
            202470041
          ]
        },
        "202470040": {
          "id": 202470040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Eu sabia.",
          "next": [
            202470043
          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Eu sabia que você não ia seguir as regras, mas nessa rodada só tem duas opções",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Deixa eu escolher pra você. Tenho certeza que a gente tá na mesma sintonia",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "No que você tá apostando dessa vez?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Tem um garoto que tá circulando em volta do meu guarda-sol faz um tempão",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Eu achei que ele tava perdido, mas na verdade ele tava de olho na areia embaixo dos meus pés",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ele me disse que eu tenho a melhor areia da praia inteira, e que só uma areia assim consegue construir os castelos de areia mais resistentes",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Mas o garoto é bem interessante. Ele não me pediu pra simplesmente ceder terreno",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ele propôs uma aposta: entre os caranguejos eremitas vermelho e azul na nossa frente, apostar em qual deles cruzaria a linha de chegada primeiro",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Se ele ganhar, ele fica com a areia perfeita",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu sei que você nunca perderia uma aposta, mas não é um pouco injusto com essa criança?",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Não é à toa que você me pediu pra escolher. Qualquer aposta que você entra pessoalmente é sempre certeza absoluta",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "E se a gente ganhar a aposta?",
          "next": [
            202470054
          ]
        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Então, eu quero que você faça a aposta",
          "next": [
            202470054
          ]
        },
        "202470054": {
          "id": 202470054,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "O contato está digitando...",
          "next": [
            202470055
          ]
        },
        "202470055": {
          "id": 202470055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Espera, esse caranguejo tá quase cruzando a linha de chegada",
          "next": [
            202470056
          ]
        },
        "202470056": {
          "id": 202470056,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "A gente ganhou",
          "next": [
            202470057
          ]
        },
        "202470057": {
          "id": 202470057,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "O contato está digitando...",
          "next": [
            202470068
          ]
        },
        "202470058": {
          "id": 202470058,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Os petiscos dele?",
          "next": [
            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Uma pazinha de plástico pra fazer castelos de areia?",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Um anel",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "O garoto disse que adultos não precisam de pazinhas de plástico e lanchinhos, mas se os riscos não forem iguais, o jogo não é justo",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Aí ele me deu um anel mágico que devora pesadelos",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Que fofinho. É um tesouro fora de linha, exatamente o que eu precisava",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "É, vou comprar um sorvete super chique de 9 sabores pra ele",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Depois convidar ele pra comprar ações legalmente na construção do Estado Castelo de Areia",
          "next": [
            202470066
          ]
        },
        "202470066": {
          "id": 202470066,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202470067
          ]
        },
        "202470067": {
          "id": 202470067,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Até mais, {M#amigo}{F#amiga}. A gente vai mexer areia",
          "next": []
        },
        "202470068": {
          "id": 202470068,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Quer tentar adivinhar o que ele perdeu pra mim?",
          "next": [
            202470058,
            202470059
          ]
        }
      },
      "participatingContactsIds": [
        1304,
        8001
      ]
    }
  ]
}