      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "A versão do plug-in \"Rastreador de Blade\" foi atualizada para você",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Novidades: alguns problemas conhecidos foram corrigidos, a funcionalidade de amortecimento de vibração foi aprimorada e assistiu mais vídeos do Bolo de Gatinho",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Você deu um toque no celular de Blade e fez ele vibrar uma vez",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo Blade ficou online",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Timing perfeito. Eu estava pensando em você.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Assim eu fico sem jeito! O que você tava pensando de mim, especificamente?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Você finalmente tá pronto pra botar o assunto em dia comigo?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Não.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo está digitando...",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mais cedo, eu notei diversos itens no arsenal, gastos pelo uso, mas ainda úteis em termos de material... Não reivindicados. Devem ser relíquias do passado.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Como você me enviou uma mensagem, eu vou te perguntar: o que você quer? Eu posso modificar e refinar quando eu voltar.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "O que eu deixei pra trás? Alguma arma?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Alguns itens que são irreconhecíveis em seu estado atual. A julgar pela construção deles, eles foram feitos para o uso cotidiano.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Aproveite ao máximo o que você tem. Me diga o que você precisa e eu criarei.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pra minha viagem interestelar de alta energia, eu preciso de algum tipo de máquina que pode me fazer dormir a qualquer hora, em qualquer lugar, sempre que eu quiser",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "No Xianzhou, nós chamamos isso de \"berço\".",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Talvez algo que não seja tão cotidiano",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Você dormiu bem?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu fiz alguns apetrechos a bordo da nave recentemente que ajudam no sono. Você está {F#interessada}{M#interessado}?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Então eu quero uma melhoria! Que tal algo que pode me fazer dormir a qualquer hora, em qualquer lugar, sempre que eu quiser",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Claro.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu não sou exigente, eu aceito qualquer coisa!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu fiz alguns apetrechos a bordo da nave recentemente que ajudam no sono. Você está {F#interessada}{M#interessado}?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Boaaa! Eu quero uma máquina de dormir que pode me fazer dormir a qualquer hora, em qualquer lugar, sempre que eu quiser",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Claro.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Fazer alguém dormir é bastante simples. Mas forçar um sono... para isso é preciso um design especial.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Você pode adicionar um pouco de ruído branco. Isso vai me ajudar a dormir mais rápido",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Simples. Adicione algumas placas de ferro, e elas devem imitar o som da forja de uma lâmina.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ainda que esse som costumasse me revigorar... pode ser que ele te faça dormir.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Que tal adicionar alguns recursos de auxílio ao sono? Tipo uma massagem, afofamento de almofadas e esse tipo de coisa?",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "...Tudo bem.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Há algumas juntas de braços mecânicos descartadas na lavanderia que podem simular esses movimentos.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Talvez seja um pouco barulhento, mas você pode interpretar como ruído branco.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tem como adicionar algumas canções de ninar com vocal?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "...Tudo bem.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Um tocador de música foi integrado. Você pode gravar uma música nele.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mas eu não sei cantar. No máximo, eu posso te... recitar algumas letras.",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Belezinha! Acho que isso é o suficiente...",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Depois que as modificações estiverem concluídas, eu posso mandar entregar para você, ou você pode pegar pessoalmente. Você escolhe.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Nós nos falaremos logo.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Até a próxima.",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo Blade ficou offline",
          "next": []
        }
