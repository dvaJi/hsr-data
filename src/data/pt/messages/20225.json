        },
        "202250011": {
          "id": 202250011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Come um cozidão de grade de nove quadrados, com berinjelas, peras e tomates. Quanto mais você comer, mais sorte você vai ter",
