        },
        "202260004": {
          "id": 202260004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Assim como as folhas retornam às suas raízes, causa e efeito se entrelaçam, e eu conheço a felicidade e o infortúnio",
