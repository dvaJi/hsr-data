          ]
        },
        "202490007": {
          "id": 202490007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Você veio só pra me falar isso. Você deve tá bem animada!",
          "next": [
            202490008
          ]
        },
        "202490008": {
          "id": 202490008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Está tão óbvio assim?",
