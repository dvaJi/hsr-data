            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Eu desejo navegar pelos mares de Skiana, onde as nuvens de tempestade e as ondas gigantes travam um combate eterno",
