            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Eu estou tentando decidir entre voar de wingsuit ou fazer paraquedismo",
