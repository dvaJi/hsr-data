            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Em minhas conquistas passadas, eu me lembro dos estados apenas como incêndios furiosos de conflito ou a maré negra e estagnada da morte",
