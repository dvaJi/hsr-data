        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ele disse que era baseado em uma história real, sobre alguém que tinha mais de vinte personalidades...",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "O protagonista dava uns brancos. Ele pensava que era só uma amnésia comum, mas na verdade eram outras personalidades vivendo a vida dele",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Será que... eu também sou assim...?",
