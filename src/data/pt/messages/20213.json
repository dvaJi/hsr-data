        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Relaxaaaa. Com a minha visão de águia, eu consigo ver que você tá completa",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Mesmo que você teja brincando, eu ainda fico meio pá",
