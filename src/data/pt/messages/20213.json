        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Eeeei, parou! Eu tô fofa hoje, e amanhã eu vou tá ainda mais!",
          "next": [
            202130014
