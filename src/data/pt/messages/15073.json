      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt, todo mundo tá bem?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Alô, alô? Tá me ouvindo?",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "\"Aviso: Sinal de comunicação fraco. Verifique sua conexão.\"",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@7 de Março @{NICKNAME} @Sunday, Entendido, tá todo mundo bem",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Tudo certo aqui. Dan Heng, você pode avisar também?",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Não se preocupe com a gente. Acabamos de enfrentar uma horda de monstros com tentáculos que surgiram do subterrâneo.",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ufaaa, já tava com o coração na boca aqui",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Mas tipo, a gente tem mesmo que ir pra Astrópolis? Sem querer ofender nem nada, mas é que eu tô meio virada com a CPI, sabe?",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "A gente não podia tentar pedir ajuda pro Xianzhou ou pra Estação Espacial da madame Herta?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Eu também pensei nisso",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Em termos de distância, o Xianzhou e a Estação Espacial Herta tão longe demais. Situações desesperadas pedem medidas desesperadas. Ir pra Astrópolis ainda é nossa melhor aposta",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Mas o problema maior do que a distância é que a Planarcadia está sob a rede comercial da CPI.",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Pelas regras do comércio interestelar, eles têm prioridade para lidar com esse assunto. Se forasteiros intervirem sem autorização, podemos estar diante de uma bagunça diplomática e jurídica.",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Então... é só isso. Não tem jeito. Acabou. Boa sorte",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "{NICKNAME}, a navegação agora é com você",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pode deixar. Eu cuido disso",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Eu sei que você vai dar conta, eu acredito em você",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu... Eu não sei o que fazer",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Relaxa. Eu acredito em você. Como {F#navegadora interina}{M#navegador interino}, você vai dar um jeito",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "A situação é urgente, então a gente vai apoiar qualquer decisão que você tomar",
          "next": [
            150730120
          ]
        },
