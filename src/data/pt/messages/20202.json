          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Meu negócio é comer e dormir porque dormir dá fome e comer dá sono, exercício é um saco... eu tenho esperança na vida, Cinny?",
