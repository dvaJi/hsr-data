            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Se seu corpo está pedindo pra dormir, deixe-o descansar~ Você deve estar só o pó, então não se force a ficar {M#acordado}{F#acordada}",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Se você quer algo que seja saudável e também satisfatório, bom... tem uma outra maneira",
