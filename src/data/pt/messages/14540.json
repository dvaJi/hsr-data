          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Pare com esses seus planos, Cífera. Você sabe que não pode esconder nada dos fios dourados.",
