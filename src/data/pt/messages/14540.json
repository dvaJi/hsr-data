            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Nada de conspirar ou trapacear! Nós vamos ser as juízas e vamos ficar de olho em todo mundo!",
