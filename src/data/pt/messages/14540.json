        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ei, Mistério Cinzento, quer fazer um acordo? Eu vou roubar a quimera do seu oponente e você entrega uma partida pra mim",
