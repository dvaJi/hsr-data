        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Tem bastante espaço, {F#querida}{M#querido}. A mesa é grande o suficiente, e a panela também.",
