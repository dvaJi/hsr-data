        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Uma figura importante cuja identidade permanece confidencial recebeu uma carta ameaçadora de uma fonte desconhecida essa manhã",
