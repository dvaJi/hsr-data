          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Madame Xueyi! Eu não tava esperando receber uma mensagem sua!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Você parece tão {F#enérgica}{M#enérgico} quanto sempre.",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Faz um baita tempo desde a última vez que a gente conversou",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Perdão, isso foi um descuido meu.",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Quando eu tiver um tempo no futuro, eu conversarei com você com mais frequência.",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Eu soube que você estava viajando por Planarcadia.",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Eu tenho um pequeno favor pra lhe pedir.",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tranquilo, excelência, manda ver",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Por acaso você já ouviu falar em \"O Jogo do Labirinto\"?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "É uma história em quadrinhos que me interessa muito.",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Caçar criminosos e inimigos combina mais comigo do que o primeiro trabalho da autora, \"Estrela Wok\".",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Eu ouvi dizer que a Cidade Duomensão está sediando a <i>OnlyCon</i> de \"O Jogo da Labirinto\" recentemente, onde muitas obras de fãs estarão à venda.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Infelizmente, devido à minha posição, não posso comparecer pessoalmente à convenção de quadrinhos em Planarcadia.",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Eu espero que você possa comprar algumas fanfics para mim para que eu cumpra meus arrependimentos.",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu tava passando perto dessa convenção quando eu recebi sua mensagem... Você não tá me stalkeando, não... né?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Bip bip, drone de rastreamento \"Xueyi Modelo 9527\" exposto, iniciando protocolo de autodestruição!",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aaaah piedade! Não me explode, eu tenho {F#marido}{M#mulher} e filhos! Eu compro a fanfic pra você, eu prometo!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Não tema, eu estava apenas brincando com você.",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Não há nenhum drone explosivo, fique {F#tranquila}{M#tranquilo}.",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Mal posso esperar para ver algumas fanfics novas. Obrigada.",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Que coincidência, eu também tô na convenção!",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Você também viu? Isso é incrível, obrigada.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sem problema, deixa comigo",
          "next": [
            150220124
          ]
        },
