        "202230007": {
          "id": 202230007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Pode deixar! Me disseram que eu vou receber pessoalmente {F#a}{M#o} Cabelo Cinza",
