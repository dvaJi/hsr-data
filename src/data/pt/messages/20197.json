            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Aqueles eram apenas costumes ultrapassados que os Kremnoanos usavam para testar guerreiros, os quais eu já aboli há muito tempo",
