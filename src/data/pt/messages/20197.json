            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hoje em dia, a culinária Kremnoana é toda voltada para uma alimentação balanceada e saudável",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ela também absorveu e incorporou os melhores elementos de outras culinárias para criar algo novo e aprimorado",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Você tem alguma preferência de sabor?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu adoro uns negócios diferentões",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Então vamos com costelas de ovelha-nuvem braseadas no molho de soja. Esse prato é ótimo para repor o sal e estimular o apetite. Combina perfeitamente com suco de romã",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu quero uma comidinha normal",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Pasta de feijão azedo com bolo de mel de romã. Essa é uma combinação imbatível a qualquer hora",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eu não sou {F#fresca}{M#fresco} pra comer, vem com a sua maior esquisitice",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Nesse caso, peixe enlatado do Mar das Almas pode ser o que você está procurando",
