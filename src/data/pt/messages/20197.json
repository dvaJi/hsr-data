            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Eu raramente uso isso para cozinhar",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
