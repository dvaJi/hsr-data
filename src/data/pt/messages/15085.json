      "messages": {
        "150850100": {
          "id": 150850100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bom dia, boa tarde, boa noite! Mais um dia cheio de vida e energia!",
          "next": [
            150850101
          ]
        },
        "150850101": {
          "id": 150850101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Eu nunca esperava encontrar páginas soltas das \"Crônicas da Gordura Flutuante\" aqui em Astrópolis",
          "next": [
            150850102,
            150850106,
            150850109
          ]
        },
        "150850102": {
          "id": 150850102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "É verdade né, quem diria!",
          "next": [
            150850103
          ]
        },
        "150850103": {
          "id": 150850103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Parece que tem ainda mais coisas pra coletar agora",
          "next": [
            150850104
          ]
        },
        "150850104": {
          "id": 150850104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, ei, isso não é uma coisa ruim, né?",
          "next": [
            150850105
          ]
        },
        "150850105": {
          "id": 150850105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Graças ao Sr. Arita e à equipe dele, agora a gente tem trabalho a fazer",
          "next": [
            150850114
          ]
        },
        "150850106": {
          "id": 150850106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Isso aí não é um tomo antigo de Planarcadia?",
          "next": [
            150850107
          ]
        },
        "150850107": {
          "id": 150850107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Como isso aí foi parar em Astrópolis?",
          "next": [
            150850108
          ]
        },
        "150850108": {
          "id": 150850108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, eu diria que podemos agradecer o Sr. Arita e sua equipe por isso!",
          "next": [
            150850114
          ]
        },
        "150850109": {
          "id": 150850109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "...Você tá me espionando?",
          "next": [
            150850110
          ]
        },
        "150850110": {
          "id": 150850110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "O timing dessa mensagem tá meio suspeito...",
          "next": [
            150850111
          ]
        },
        "150850111": {
          "id": 150850111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bom, sabe, é porque eu tenho o equipamento de monitoramento das \"Crônicas da Gordura Flutuante\"!",
          "next": [
            150850112
          ]
        },
        "150850112": {
          "id": 150850112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Você provavelmente é {M#o único}{F#a única} que se daria ao trabalho de coletar isso pra mim",
          "next": [
            150850113
          ]
        },
        "150850113": {
          "id": 150850113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Eu não posso simplesmente ir perguntar diretamente pro Sr. Arita, né?",
          "next": [
            150850114
          ]
        },
        "150850114": {
          "id": 150850114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sr. Arita?",
          "next": [
            150850115
          ]
        },
        "150850115": {
          "id": 150850115,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "O que isso tem a ver com ele?",
          "next": [
            150850116
          ]
        },
        "150850116": {
          "id": 150850116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Não foi algum executivo que criou um habitat em Astrópolis onde os Imagenae conseguem sobreviver?",
          "next": [
            150850117
          ]
        },
        "150850117": {
          "id": 150850117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Logo depois, todo tipo de Imagenae com vínculos com Astrópolis começaram a aparecer",
          "next": [
            150850118
          ]
        },
        "150850118": {
          "id": 150850118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "E entre eles tem um livro que nos importa",
          "next": [
            150850119
          ]
        },
        "150850119": {
          "id": 150850119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Dizem que o Sr. Arita também se interessou por esse livro",
          "next": [
            150850120
          ]
        },
        "150850120": {
          "id": 150850120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "De qualquer forma, a gente deveria se encontrar quando tiver tempo",
          "next": [
            150850121
          ]
        },
        "150850121": {
          "id": 150850121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Você não vem a Astrópolis com frequência. Aproveite para rever alguns velhos amigos enquanto está aqui",
          "next": []
        }
