            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Isso é o que você chama de \"conto de fadas\"? Credo, eu não vou dormir de noite!",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ah, é realmente assustador?",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Para ser sincera, enquanto eu escrevia, eu percebi que esse tema seria mais adequado para um livro de terror",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Olha, você tocou meu coração, isso é uma gracinha",
