            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Para ser sincera, enquanto eu escrevia, eu percebi que esse tema seria mais adequado para um livro de terror",
