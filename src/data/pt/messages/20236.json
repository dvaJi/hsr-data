          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo está digitando...",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu estou revisando a filmagem de segurança do Bolo de Gatinho.",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Você tá dando uma olhada no Bolo de Gergelim?",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Aham.",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Há quanto tempo você tá espiando o Bolo de Gatinho?",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu não me atinei ao tempo.",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ah, Bolo de Gatinho! Você podia ter falado mais cedo!",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Da próxima vez, eu te levo direto",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Certo, da próxima vez com certeza.",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "O que você viu nos monitores? O Bolo de Gergelim tá bem?",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ele fez dois novos amigos.",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Um é branco. Parece que esse não consegue sentar direito, é bem temperamental e ama falar.",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "O outro é vermelho. Não fala muito, mas também é bem temperamental.",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "É bom. O Bolo de Gergelim costumava se embolar muito com os outros.",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Você deu algum nome pra eles?",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu?",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Então vamos chamá-los de Floquinho Crocante e Pudim de Tâmara Vermelha.",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Na real, eles meio que parecem você. Tipo, esse negócio do temperamento",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Mas e aí, nossos amigos novos já têm nome?",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eu não sei. Me dê um minuto.",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "O que você acha de Pudim de Tâmara Vermelha e Floquinho Crocante?",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo está digitando...",
          "next": [
            202360038
          ]
        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bom, agora eles estão lutando entre si.",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Parece que o relacionamento deles é meio... tenso.",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Seu amigo está digitando...",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Quem poderia imaginar? Agora eles estão se lambendo.",
