        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "บุคคลสำคัญที่ไม่อาจเปิดเผยตัวตน ได้รับจดหมายขู่ที่ไม่ทราบที่มาเมื่อเช้านี้",
