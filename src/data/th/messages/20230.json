        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "อุ้งเท้านิ่มนุ่ม และยังมีกลิ่นหอมเหมือนข้าวสวยอีกด้วย",
          "next": [
