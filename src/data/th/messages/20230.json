          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "น่าเสียดายที่กล้องฉันเสีย ถ่ายรูปน้องหมาเทวดาไว้ไม่ได้",
          "next": [
