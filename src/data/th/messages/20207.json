        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "ฮ่าๆ จริงๆ แล้วเมื่อไม่นานมานี้ ฉันก็อดใจไม่ไหวไปแอบอ่านเข้าแล้วน่ะ",
