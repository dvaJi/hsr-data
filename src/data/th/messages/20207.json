        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "อยากรู้จังว่าจะเกิดอะไรขึ้นต่อ แต่เรื่องก็ดันจบลงแค่นี้ซะงั้น!",
