        },
        "202220009": {
          "id": 202220009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "เสียงแตรดังสนั่น... นั่นคือเพลงโฟล์กอิเล็กทรอนิกส์ ที่เคยโด่งดังทั่ว Planarcadia!",
          "next": [
            202220010
