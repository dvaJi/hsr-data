      "messages": {
        "150090101": {
          "id": 150090101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "สวัสดี ฉันคือเจ้าของร้านหนังสือเก่า Charing ขออภัยที่รบกวนนะ",
          "next": [
            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "เมื่อสักครู่คุณได้บทความที่เป็นของ \"บันทึกคราบไขลอยล่อง\" รึเปล่า?",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ได้รับอยู่นะ",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ว่าแต่คุณรู้ได้ยังไง",
          "next": [
            150090105
          ]
        },
        "150090105": {
          "id": 150090105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "\"บันทึกคราบไขลอยล่อง\" ที่จัตุรัสบอกฉันมาน่ะสิ",
          "next": [
            150090106
          ]
        },
        "150090106": {
          "id": 150090106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "เมื่อครู่นี้ภาพของคุณที่ช่วยเหลือมันอย่างกล้าหาญ ปรากฏขึ้นบนหน้ากระดาษ",
          "next": [
            150090115
          ]
        },
        "150090107": {
          "id": 150090107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"บันทึกคราบไขลอยล่อง\" คืออะไร",
          "next": [
            150090108
          ]
        },
        "150090108": {
          "id": 150090108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "รู้สึกคุ้นๆ แต่ก็จำไม่ได้แฮะ",
          "next": [
            150090109
          ]
        },
        "150090109": {
          "id": 150090109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "มันเป็นหนังสือเล่มหนึ่ง และเป็นจินตชนด้วย",
          "next": [
            150090110
          ]
        },
        "150090110": {
          "id": 150090110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "จำได้มั้ย ตอนที่คุณเดินผ่านจัตุรัสก่อนหน้านี้",
          "next": [
            150090115
          ]
        },
        "150090111": {
          "id": 150090111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "หา? คุณมาหาผิดคนแล้วมั้ง",
          "next": [
            150090112
          ]
        },
        "150090112": {
          "id": 150090112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "ไม่ผิดแน่ \"บันทึกคราบไขลอยล่อง\" ได้บันทึกภาพอันกล้าหาญของคุณ ที่ได้ช่วยมันเอาไว้",
          "next": [
            150090113
          ]
        },
        "150090113": {
          "id": 150090113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "นี่ไม่ใช่การหลอกลวงหรอกนะ คุณลองมาดูที่จัตุรัสด้วยตัวเองเลยสิ",
          "next": [
            150090114
          ]
        },
        "150090114": {
          "id": 150090114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "\"บันทึกคราบไขลอยล่อง\" เป็นทั้งหนังสือและจินตชน",
          "next": [
            150090115
          ]
        },
        "150090115": {
          "id": 150090115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "มันนอนอยู่บนสนามหญ้า ตรงกลางลานนั่นแหละ คุณมาได้ทุกเมื่อเลยนะ",
          "next": [
            150090116
          ]
        },
        "150090116": {
          "id": 150090116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "เหมือนกับข้อความที่คุณเพิ่งได้รับมา",
          "next": [
            150090117
          ]
        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "\"บันทึกคราบไขลอยล่อง\" ที่หายไป มีตำนานอันล้ำค่าเกี่ยวกับต้นกำเนิดของอารยธรรมโลก Benzaitengoku โบราณอยู่",
          "next": [
            150090118
          ]
        },
        "150090118": {
          "id": 150090118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "ถ้าอย่างนั้น ไว้เจอกันนะ",
          "next": []
        }
      },
