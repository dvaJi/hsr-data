      "messages": {
        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "ท่านประธาน! ไม่ทราบว่าช่วงนี้สบายดีมั้ย?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "อ่า ขอโทษที เผลอใช้โทรศัพท์ของที่ทำงานซะแล้ว",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "นี่ฉันเอง ทำโมโบ้! โบ้บู๊เป็นชื่อในวงการของฉันน่ะ",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "พอดีมีข่าวดีจะมาบอกท่านประธาน",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "โปรเจกต์ภาพยนตร์เดี่ยวของฉัน ได้รับอนุมัติให้สร้างแล้ว มันเป็นหนังซูเปอร์ฮีโร่ฟอร์มยักษ์ชื่อ \"เรียกเขาว่าพระเจ้า โบ้บู๊\"!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ว้าว ยินดีด้วยๆ! ขอแสดงความยินดีด้วยนะ ฝันของนายเป็นจริงแล้ว!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "ยังดีใจเร็วเกินไปไม่ได้หรอก เพิ่งจะเปิดกล้องได้ไม่นานเอง",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "สุดยอดไปเลย!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ว่าแต่ถามหน่อยสิ นายจะยังกลับมาทำงานอยู่มั้ย?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "คงต้องรอให้หนังถ่ายเสร็จก่อนนะ ตอนนี้เพิ่งจะเปิดกล้องเอง",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "โอ๊ะ รุ่นพี่ Wubbaboo เรียกให้ฉันไปช่วยแล้ว",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "ถ้าท่านประธานมีเวลาว่าง ก็มาเที่ยวที่กองถ่ายได้ทุกเมื่อ!",
          "next": []
        }
      },
