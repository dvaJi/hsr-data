        },
        "150920105": {
          "id": 150920105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "เดี๋ยวนะ นี่ใครเนี่ย? ฉันรู้จักเหรอ?",
          "next": [
            150920106
          ]
        },
        "150920106": {
          "id": 150920106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "ฮ่าๆๆๆ ล้อกันเล่นรึเปล่า... พวกเราตามหาหนังสือเก่าด้วยกันมาตั้งนาน เราเป็นเพื่อนร่วมเป็นร่วมตายกันมานานแล้วนะ",
          "next": [
