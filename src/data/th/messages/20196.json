            201960005
          ]
        },
        "201960002": {
          "id": 201960002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "แผนการออกกำลังกายวันที่สาม (เสร็จแล้วให้ทำเครื่องหมายถูก)\nเสริมสารอาหาร (√)\nอบอุ่นร่างกายให้พร้อม ( )\nฝึกไหล่+แขน ( )\nฝึกช่วงขา ( )\nอย่าลืมดื่มน้ำ (√)",
          "next": [
            201960003
          ]
        },
        "201960003": {
          "id": 201960003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "เป็นการเริ่มต้นที่ดี",
          "next": [
            201960007
          ]
        },
        "201960004": {
          "id": 201960004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "มาเลย เริ่มฝึกกัน!",
