        },
        "201960013": {
          "id": 201960013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "ฝึกช่วงขา: ยกอสูรธรณีเหนือศีรษะ อย่าลืมเลือกตัวที่โมโหง่ายล่ะ จะได้มีความท้าทายมากขึ้น",
          "next": [
            201960014,
            201960016,
            201960019
          ]
        },
        "201960014": {
          "id": 201960014,
          "type": "Text",
          "sender": "Player",
