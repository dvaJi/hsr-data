            202470005
          ]
        },
        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "หัวใจเต้นแบบนี้มันไม่ปกติแล้วนะ! อย่าทำฉันตกใจสิ Aventurine! อดทนไว้ ฉันมาแล้ว!",
          "next": [
            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
