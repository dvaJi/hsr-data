        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "โอ้ เวลานี้เขาคงกลับมาแล้ว ฉันไปเตรียม \"ทาร์ตกล้วยแอปเปิลรสเกลือ\" ของวันนี้ก่อนนะ",
