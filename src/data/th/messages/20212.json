            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "{F#เธอ}{M#นาย}แอบสะกดรอยตามอสูรธรณีอกหัก และฉวยโอกาสตอนที่มันไม่สังเกต มาถ่ายเซลฟี่คู่กับมัน เพื่อเก็บเป็นภาพที่แสดงว่า \"คนฉลาดเขาไม่ตกหลุมรักกันหรอก\"",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "{F#เธอ}{M#นาย}ไปดูดวงกับนักบวชข้างทาง และถ่ายเซลฟี่สื่อว่า \"ชีวิตฉัน ฉันเป็นคนกำหนดเอง ไม่ใช่ฟ้าลิขิต\" ที่หน้าแผงดูดวง",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "ตอน{F#เธอ}{M#นาย}ออกไปเดินเล่น บังเอิญได้พบกับกวีที่กำลังร้องเพลง... {F#เธอ}{M#นาย}เลยแรปสดๆ ณ ตรงนั้นแล้วถ่ายเซลฟี่เก็บไว้",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "ตอนตื่นมาผมยุ่งเหยิง {F#เธอ}{M#นาย}ก็เซลฟี่เก็บไว้เหมือนกัน",
          "next": [
            202120016
