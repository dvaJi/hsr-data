        },
        "202270013": {
          "id": 202270013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "แล้วก็แก้ปริศนาห้าทรัพย์สามคำนวณของ Xianzhou กับทำนายแผนภูมิสวรรค์ของตระกูล Diting ให้หมดด้วย",
          "next": [
            202270014,
            202270016,
            202270018
