        },
        "202270014": {
          "id": 202270014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "แบบนี้เรียกว่าพักผ่อนจริงๆ เหรอ?",
          "next": [
            202270015
          ]
        },
        "202270015": {
          "id": 202270015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "จริงๆ แล้วถ้าไม่มีอะไรทำ ก็ไม่จำเป็นต้องทำอะไรเลยก็ได้",
          "next": [
            202270020
