        },
        "202270017": {
          "id": 202270017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ปล่อยวางหน่อยก็ได้นะ",
          "next": [
            202270020
          ]
        },
        "202270018": {
          "id": 202270018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "แผนภูมิสวรรค์ของ Diting? พวกมันยังสบายดีอยู่ใช่มั้ยน่ะ?",
