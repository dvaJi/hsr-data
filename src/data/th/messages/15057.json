      ],
      "messages": {
        "150570101": {
          "id": 150570101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "เฮ้ {NICKNAME}!",
          "next": [
            150570102
          ]
        },
        "150570102": {
          "id": 150570102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉันกำลังหานายอยู่ แล้วนายก็ทักมาพอดีเลย",
          "next": [
            150570103
          ]
        },
        "150570103": {
          "id": 150570103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "เราสองคนใจตรงกันตลอดเลยนะเนี่ย",
          "next": [
            150570104
          ]
        },
        "150570104": {
          "id": 150570104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "จะมาบอกข่าวดีน่ะ",
          "next": [
            150570105
          ]
        },
        "150570105": {
          "id": 150570105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "หนังสือภาพคอลแลบของเราขายดีมาก พอโอนเงินก้อนนี้ไป ก็จะทำให้เด็กๆ เข้าใกล้ความฝันไปอีกก้าวใหญ่ๆ แล้ว",
          "next": [
            150570106,
            150570107
          ]
        },
        "150570106": {
          "id": 150570106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "เยี่ยมเลยสิ หวังว่าทุกอย่างจะราบรื่นนะ",
          "next": [
            150570108
          ]
        },
        "150570107": {
          "id": 150570107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ลำบากนายแย่เลยนะ ที่ต้องมาวิ่งวุ่นจัดการเรื่องนี้",
          "next": [
            150570108
          ]
        },
        "150570108": {
          "id": 150570108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "แต่ฉันยังอยากรู้อยู่นะว่า นายทำเรื่องพวกนี้เพื่ออะไร?",
          "next": [
            150570109
          ]
        },
        "150570109": {
          "id": 150570109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ฉันรู้นะว่านายชอบเด็กๆ แต่ไม่นึกเลยว่า นายจะยอมให้ตัวเองลำบาก เพื่อยานอวกาศในจินตนาการลำหนึ่ง",
          "next": [
            150570110
          ]
        },
        "150570110": {
          "id": 150570110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "ฮ่าๆ แต่ฉันว่าฟิ้วฟิ้วเข้าใจยากกว่าอีกนะ",
          "next": [
            150570111
          ]
        },
        "150570111": {
          "id": 150570111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "ถึงฉันจะเป็นคนสร้างเจ้านั่นขึ้นมา แต่ฉันก็คิดไม่ออกจริงๆ ว่าทำไมเขา ถึงยอมมาทำเรื่องยุ่งยากพวกนี้กับฉัน",
          "next": [
            150570112
          ]
        },
        "150570112": {
          "id": 150570112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "พลังปรารถนาที่ประกอบขึ้นเป็นตัวเขา มาจากดวงดาวอันไกลโพ้น แต่เขาก็ไม่เคยไปที่ดาวดวงนั้น แถมจินตชนก็ไม่มีทาง ไปถึงที่ที่ไกลขนาดนั้นได้ด้วย",
          "next": [
            150570113
          ]
        },
        "150570113": {
          "id": 150570113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "\"ยานข้ามดวงดาว\" นี่น่ะ ต่อให้สร้างเสร็จจริงๆ ในอีกหลายสิบปีข้างหน้า เขาก็ไม่มีทางขับยานอวกาศลำนั้น แล้วออกเดินทางได้หรอก",
          "next": [
            150570114
          ]
        },
        "150570114": {
          "id": 150570114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "เรื่องนี้ ตัวเขาเองนั่นแหละที่รู้ดีที่สุด",
          "next": [
            150570115
          ]
        },
        "150570115": {
          "id": 150570115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "แต่เขาก็ยังเรียกตัวเองว่า \"กัปตัน\" และยังตรากตรำเพื่ออนาคต ที่ไม่มีวันไปถึงได้ด้วยตัวเองอยู่ดี",
          "next": [
            150570116
          ]
        },
        "150570116": {
          "id": 150570116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "จนมาวันนี้ พอฉันเห็นภาพวาดล่าสุดที่เด็กๆ แชร์มาให้ดู Sampo คนนี้ก็เข้าใจฟิ้วฟิ้วอย่างหมดใจแล้ว",
          "next": [
            150570117
          ]
        },
        "150570117": {
          "id": 150570117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "อนาคตในอุดมคติของเด็กๆ ช่างเจิดจรัส และน่าประทับใจจริงๆ",
          "next": [
            150570118
          ]
        },
        "150570118": {
          "id": 150570118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "กัปตันฟิ้วฟิ้วต้องอยากให้สิ่งนี้ กลายเป็นอนาคตที่ถูกกำหนดไว้แน่ๆ",
          "next": [
            150570119,
            150570120
          ]
        },
        "150570119": {
          "id": 150570119,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉันก็เข้าใจแล้วเหมือนกัน การทำเรื่องพวกนี้ มันคุ้มค่าจริงๆ นั่นแหละ",
          "next": [
            150570121
          ]
        },
        "150570120": {
          "id": 150570120,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉันก็ยังไม่เข้าใจอยู่ดี",
          "next": [
            150570121
          ]
        },
        "150570121": {
          "id": 150570121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "ถึงจะมีแค่ไม่กี่แห่งในกาแล็กซี ที่ทำให้พลังปรารถนาจับต้องได้ แต่อันที่จริง พลังปรารถนาในที่อื่นๆ ก็ทรงพลังมากเหมือนกัน",
          "next": [
            150570122
          ]
        },
        "150570122": {
          "id": 150570122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "\"ความปรารถนา\" คือแหล่งพลังงานที่ยิ่งใหญ่ที่สุด ที่มนุษย์สร้างขึ้นได้ มันทรงพลังยิ่งกว่าพลังงานนิวเคลียร์ หรือพลังงานจินตภาพซะอีก",
          "next": [
            150570123
          ]
        },
        "150570123": {
          "id": 150570123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "มันทำให้ประกายไฟเล็กๆ ที่ถูกโชคชะตาผูกมัดไว้ในห้วงลึก กลายเป็นพลุสุดตระการตา ที่โบยบินขึ้นสู่ท้องฟ้า ทำให้เด็กที่กำลังสับสน ทอดมองไปยังทะเลหมู่ดาวอันห่างไกล และเชื่อมั่นว่า สักวันตนจะก้าวไปสู่อนาคตอันยิ่งใหญ่ ที่ไม่เคยมีมาก่อนได้",
          "next": [
            150570124
          ]
        },
        "150570124": {
          "id": 150570124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "บางทีแสงสว่างชั่ววูบที่เด็กๆ มองเห็นในทะเลหมู่ดาวอันกว้างใหญ่ ก็คือแสงเรืองรอง ในตอนที่คุณ Himeko และเหล่าผู้มาเยือนนิรนาม ออกเดินทางอีกครั้งนี่แหละ",
          "next": [
            150570125,
            150570127
          ]
        },
        "150570125": {
          "id": 150570125,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "พูดดีมาก สละสลวยสุดๆ",
          "next": [
            150570126
          ]
        },
        "150570126": {
          "id": 150570126,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "แหม {F#เธอ}{M#นาย}ทำฉันเขินไปหมดแล้วเนี่ย",
          "next": [
            150570129
          ]
        },
        "150570127": {
          "id": 150570127,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ทำไมจู่ๆ ก็รำพึงรำพันขึ้นมาซะงั้น",
          "next": [
            150570128
          ]
        },
        "150570128": {
          "id": 150570128,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "แหม ก็อายุเยอะขึ้นแล้วนี่นา",
          "next": [
            150570129
          ]
        },
        "150570129": {
          "id": 150570129,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1108,
          "text": "เอาล่ะ คุยกันแค่นี้แหละ Sampo ขอตัวไปทำงานต่อก่อนล่ะ",
          "next": []
        }
      },
      "participatingContactsIds": [
        1108,
        8001
      ]
    }
  ]
}