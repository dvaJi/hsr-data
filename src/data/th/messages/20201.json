      "messages": {
        "202010000": {
          "id": 202010000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "คุณมีคำถามอะไรมั้ย?",
          "next": [
            202010001,
            202010005,
            202010009
          ]
        },
        "202010001": {
          "id": 202010001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "?",
          "next": [
            202010002
          ]
        },
        "202010002": {
          "id": 202010002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ผู้ใช้กำลังถามคำถามเกี่ยวกับสัญลักษณ์ ฉันควรให้คำตอบแบบนี้:",
          "next": [
            202010003
          ]
        },
        "202010003": {
          "id": 202010003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "เครื่องหมายคำถาม สัญลักษณ์แห่งข้อจำกัดในการรับรู้ของมนุษย์ และทางเข้าสู่ปริศนาที่ยังไม่ถูกไขทั้งปวง ถือเป็นอักขระที่งดงามที่สุดในโลกใบนี้",
          "next": [
            202010004
          ]
        },
        "202010004": {
          "id": 202010004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ยังมีคำถามอื่นอีกมั้ย?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010005": {
          "id": 202010005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉันมีคำถาม มีสามคำไหน ที่สามารถตอบคำถามได้ทุกอย่าง?",
          "next": [
            202010006
          ]
        },
        "202010006": {
          "id": 202010006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ผู้ใช้กำลังพยายามหาคำตอบสำหรับทุกสิ่ง ฉันควรให้คำตอบแบบนี้:",
          "next": [
            202010007
          ]
        },
        "202010007": {
          "id": 202010007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ฉันไม่รู้",
          "next": [
            202010008
          ]
        },
        "202010008": {
          "id": 202010008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ยังมีคำถามอื่นอีกมั้ย?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010009": {
          "id": 202010009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "อาจารย์... อาจารย์เรียกถามฉันเองนะ ฉันไม่มีคำถามอะไรสักหน่อย!",
          "next": [
            202010010
          ]
        },
        "202010010": {
          "id": 202010010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ผู้ใช้กำลังพยายามหลบเลี่ยงปัญหา ฉันควรให้คำตอบแบบนี้:",
          "next": [
            202010011
          ]
        },
        "202010011": {
          "id": 202010011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ไม่มีคำถาม นั่นแหละคือปัญหาที่ใหญ่ที่สุด",
          "next": [
            202010012
          ]
        },
        "202010012": {
          "id": 202010012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ยังมีคำถามอื่นอีกมั้ย?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010013": {
          "id": 202010013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "อาจารย์ Anaxa ความลับเล็กๆ ของคุณคืออะไรเหรอ?",
          "next": [
            202010014
          ]
        },
        "202010014": {
          "id": 202010014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "อย่างแรก กรุณาป้อนชื่อให้ถูกต้อง อย่างที่สอง ความลับของฉันไม่สำคัญ",
          "next": [
            202010021
          ]
        },
        "202010015": {
          "id": 202010015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "สร้างรูปภาพของอาจารย์ Anaxa เนื้อหาคือ: ภาพสุดเลอค่าของอาจารย์ Anaxa ที่ขี่อสูรธรณีไปบุกโจมตีเมืองปราการ Kremnos",
          "next": [
            202010016
          ]
        },
        "202010016": {
          "id": 202010016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ผู้ใช้กำลังร้องขอให้สร้างรูปภาพ ฉันควรให้คำตอบแบบนี้:",
          "next": [
            202010017
          ]
        },
        "202010017": {
          "id": 202010017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ฝันไปเถอะ",
          "next": [
            202010021
          ]
        },
        "202010018": {
          "id": 202010018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉัน! ไม่! รู้!",
          "next": [
            202010019
          ]
        },
        "202010019": {
          "id": 202010019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "(กำลังครุ่นคิดอย่างหนัก...)",
          "next": [
            202010020
          ]
        },
        "202010020": {
          "id": 202010020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ข้อสรุป: ผู้ใช้โกรธแล้ว",
          "next": [
            202010021
          ]
        },
        "202010021": {
          "id": 202010021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ถึงขีดจำกัดการถามคำถามในขณะนี้แล้ว ช่วงถามตอบประจำวันสิ้นสุด ตอนนี้ คือช่วงทดสอบ",
          "next": [
            202010022
          ]
        },
        "202010022": {
          "id": 202010022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ทำไมสิ่งที่ดำรงอยู่ในสถานะซ้อนทับกัน ถึงยุบตัวลงเป็นสถานะเดียวทันทีที่ถูกตรวจวัด และใครกันที่มีสิทธิ์กำหนดขอบเขตของ \"การตรวจวัด\"?",
          "next": [
            202010023,
            202010024
          ]
        },
        "202010023": {
          "id": 202010023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "นี่มันใช่เรอะ?",
          "next": [
            202010025
          ]
        },
        "202010024": {
          "id": 202010024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "จารย์ช่วยด้วย รีบเอาพลังวิเศษนี่ไปเก็บที!",
          "next": [
            202010025
          ]
        },
        "202010025": {
          "id": 202010025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "เปิดใช้งานคีย์เวิร์ดของระบบอัจฉริยะ \"Anaxagoras\"",
          "next": [
            202010026
          ]
        },
        "202010026": {
          "id": 202010026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anaxa เพื่อนของคุณ ออนไลน์แล้ว",
          "next": [
            202010027
          ]
        },
        "202010027": {
          "id": 202010027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1405,
          "next": [
            202010028
          ]
        },
        "202010028": {
          "id": 202010028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "คุณนี่เอง",
          "next": [
            202010029
          ]
        },
        "202010029": {
          "id": 202010029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ไม่ต้องตกใจไป ข้างบนนั่นก็แค่ระบบอัจฉริยะ สำหรับเรียนรู้เป็นเพื่อนเท่านั้น",
          "next": [
            202010030
          ]
        },
        "202010030": {
          "id": 202010030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "เพื่อให้นักเรียนได้รับคำตอบ สำหรับคำถามได้อย่างทันท่วงที",
          "next": [
            202010031
          ]
        },
        "202010031": {
          "id": 202010031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ลักษณะการพูดก็คล้ายกับฉันมาก เลยได้รับผลตอบรับไม่เลว",
          "next": [
            202010032
          ]
        },
        "202010032": {
          "id": 202010032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ถ้าคุณมีคำถามอะไร ก็ปรึกษาตัวฉันอีกคนได้ทุกที่ทุกเวลา",
          "next": []
        }
