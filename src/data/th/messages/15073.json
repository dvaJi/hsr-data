      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt ทุกคนยังอยู่ดีมั้ย?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "เห็นแล้วตอบด้วย... เห็นแล้วตอบด้วยสิ!",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[แจ้งเตือน: ขณะนี้สัญญาณการสื่อสารค่อนข้างอ่อน โปรดตรวจสอบสถานะการเชื่อมต่อ]",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@March 7th @{NICKNAME} @Sunday เห็นแล้วล่ะ พวกเราทุกคนโอเคดี",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "พวกเราไม่เป็นไร @Dan Heng ปลอดภัยดีมั้ย",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "ไม่ต้องห่วงพวกเรานะ เพิ่งขับไล่มอนสเตอร์หนวดที่มุดขึ้นมา จากใต้ดินไประลอกหนึ่งน่ะ",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "โล่งอกไปที",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "จะว่าไป พวกเราต้องรีบไปนครพันดารากันจริงๆ เหรอ? ไม่ได้มีเจตนาอื่นนะ แค่... รู้สึกไม่ค่อยวางใจองค์กรสักเท่าไหร่น่ะ",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "ลองไปขอความช่วยเหลือจาก Xianzhou หรือสถานีอวกาศของคุณ Herta ดูได้มั้ย?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "ปัญหานี้ ฉันเองก็ไม่ใช่ว่าจะไม่เคยคิดมาก่อน",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "ถ้าดูจากระยะทางแล้ว Xianzhou กับสถานีอวกาศ Herta อยู่ไกลเกินไปน่ะ พอสถานการณ์จวนตัว ก็ต้องพลิกแพลง แผนกู้ภัยที่มีหวังมากสุดในตอนนี้ เลยยังคงเป็นนครพันดาราอยู่ดี",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "สิ่งที่ยุ่งยากกว่าเรื่องระยะทางก็คือ Planarcadia เป็นส่วนหนึ่ง ในเครือข่ายการค้าขององค์กร",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "ตามข้อตกลงการค้าระหว่างดวงดาว องค์กรมีสิทธิ์จัดการเป็นอันดับแรก ถ้าภายนอกเข้าแทรกแซงโดยพลการ อาจก่อให้เกิดข้อพิพาททางกฎหมาย และการทูตที่ซับซ้อนยิ่งขึ้นได้น่ะสิ",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "งั้นก็คง... หมดหนทางแล้วจริงๆ สินะ!",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} ฝากภารกิจการนำทาง ไว้กับ{F#เธอ}{M#นาย}ด้วยนะ",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "วางใจเถอะ ฉันจะดูแลเอง",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "ฉันรู้ ฉันเชื่อในตัว{F#เธอ}{M#นาย}",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ฉัน... ฉันไม่รู้ว่าควรทำอะไรบ้าง...",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "ไม่ต้องห่วงนะ ฉันเชื่อใจ{F#เธอ}{M#นาย} ในฐานะรักษาการผู้บังคับขบวนรถไฟ {F#เธอ}{M#นาย}ต้องหาทางออกได้แน่",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "สถานการณ์กำลังคับขัน พวกเราจะสนับสนุน ทุกการตัดสินใจของ{F#เธอ}{M#นาย}เอง",
          "next": [
