          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "อย่าแกล้งโง่หน่อยเลย! {F#เธอ}{M#นาย}เป็นผู้รับผิดชอบของเฟอร์โบโบ้นิวส์ เรื่องนี้{F#เธอ}{M#นาย}เป็นคนวางแผนใช่มั้ย?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "มือของฉันเริ่มไม่ฟังคำสั่งแล้ว",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "จมูกก็กระดุกกระดิก",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "รีบหยุดให้ไวเลย",
