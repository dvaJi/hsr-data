            150120106,
            150120109
          ]
        },
        "150120106": {
          "id": 150120106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"มือสังหารแห่งสหัสวรรษ\" สินะ?",
          "next": [
            150120107
          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "รู้เบอร์โทรศัพท์ฉันได้ยังไง?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "{F#เธอ}{M#นาย}ไม่รู้ว่าฉันเป็นใครงั้นเหรอ? น่าขำชะมัด {F#เธอ}{M#นาย}ไม่รู้ด้วยซ้ำว่าฉันเป็นใคร แต่กลับทำกันถึงขนาดนี้",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "นี่คือหมอ \"Izol\" คนนั้นสินะ?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "รู้เบอร์โทรศัพท์ฉันได้ยังไง?",
          "next": [
            150120111
