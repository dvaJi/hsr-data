        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "ไม่ใช่สักหน่อย! น่าขำชะมัด {F#เธอ}{M#นาย}ไม่รู้ด้วยซ้ำว่าฉันเป็นใคร แต่กลับทำกันถึงขนาดนี้",
          "next": [
            150120112
