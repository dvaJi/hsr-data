            150700104
          ]
        },
        "150700104": {
          "id": 150700104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ถ้าสะดวก อยากให้เธอช่วยแนะนำให้หน่อยน่ะ",
          "next": [
            150700105
          ]
        },
        "150700105": {
          "id": 150700105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wubbaboo ศักดิ์สิทธิ์เหรอ ฉันรู้จักอยู่จริงๆ นั่นแหละ",
          "next": [
            150700106
          ]
        },
        "150700106": {
          "id": 150700106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ก่อนหน้านี้ผู้จัดการของฉัน เคยคุยเรื่องคอลแลบธุรกิจ กับค่ายหนังชมรมเซียนการ์ดด้วย ก็คือจะให้ไปเป็น Vocal ในผลงานใหม่ของเขาน่ะ",
          "next": [
            150700107
          ]
        },
        "150700107": {
          "id": 150700107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "เรื่องนี้ฉันช่วยเอง! รอเดี๋ยวนะ",
          "next": [
            150700108
          ]
        },
        "150700108": {
          "id": 150700108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "โชคดีจัง บ่ายวันนี้ Wubbaboo ศักดิ์สิทธิ์จะพักผ่อนอยู่ที่ หอเข็มนาฬิกาพอดีเลย",
          "next": [
            150700109
          ]
        },
        "150700109": {
          "id": 150700109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ฉันนัดเวลาให้แล้ว ตรงไปหาเขาได้เลยนะ",
