        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "ช่วงนี้ฉันก็เลยอยากหาแนวทางใหม่ๆ ในการเขียน เลยกำลังวางแผนจะลองเขียนดูสักเรื่องน่ะ",
