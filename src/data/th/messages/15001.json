        },
        "150010103": {
          "id": 150010103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "แย่แล้ว! นักเรียนทั้งโรงเรียน เริ่มมีการเปลี่ยนแปลงที่ผิดวิสัย!",
