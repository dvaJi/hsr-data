        },
        "150010104": {
          "id": 150010104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "เฟอร์โบ้คิดว่า! ตัวเองก็ใกล้จะติดเชื้อแล้วล่ะโบ้! หายใจไม่ออกเลย!",
          "next": [
            150010105
          ]
        },
        "150010105": {
          "id": 150010105,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 204,
          "image": "PhoneMessagePic_15001_02",
          "text": "[รูป]",
          "next": [
