            150010107,
            150010109
          ]
        },
        "150010106": {
          "id": 150010106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "มีเหตุการณ์ผิดปกติอะไรเหรอ?",
          "next": [
            150010111
          ]
        },
        "150010107": {
          "id": 150010107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "เห็นนักเรียนผมสีชมพูบ้างมั้ย?",
          "next": [
            150010108
          ]
        },
        "150010108": {
          "id": 150010108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "นักเรียนชาวมนุษย์ มีสีผมเยอะจะตายไป แยกไม่ออกหรอกว่า คนที่คุณตามหาเป็นคนไหน แต่เฟอร์โบ้ก็จะพยายามต่อไปนะ!",
          "next": [
            150010111
          ]
        },
        "150010109": {
          "id": 150010109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "เห็นอาจารย์ผู้ชายที่ใส่แว่นรึเปล่า?",
          "next": [
            150010110
          ]
        },
        "150010110": {
          "id": 150010110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "ไม่เห็นเลยโบ้!",
          "next": [
            150010111
          ]
        },
        "150010111": {
          "id": 150010111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "มีบางอย่างไม่ชอบมาพากล! พวกเขากำลังรื้อ ภาพคลื่นทะเลในโรงเรียนโบ้!",
          "next": [
            150010112
          ]
        },
        "150010112": {
          "id": 150010112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "ปิ๊บปิ๊บ ตรวจพบว่ามีคนกำลังเคลื่อนที่มาทางนี้!",
          "next": [
            150010113
          ]
        },
        "150010113": {
          "id": 150010113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "อย่าลืมความดีความชอบ ที่ฉันทำให้สำนักพิมพ์ด้วยนะ ประธานสำนักพิมพ์!",
