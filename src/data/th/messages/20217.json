        },
        "202170008": {
          "id": 202170008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "ดอกทานตะวันกับดอกกระดิ่งลม มาจากลานแสงสนธยาของ Hyacine เป็นเหมือนแสงอาทิตย์ที่อ่อนโยน~",
