        },
        "202170009": {
          "id": 202170009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "แล้วก็ดอกลิลลี่แสงจันทร์ฟ้า ดอกยิปโซ ดอกระฆังขาว...",
          "next": [
            202170010
