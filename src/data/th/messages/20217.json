        },
        "202170010": {
          "id": 202170010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "คิก ลองทายสิ... ว่าการจับคู่แบบไหน คือแบบที่ฉันชอบมากที่สุด?",
          "next": [
            202170011
