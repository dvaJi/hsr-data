          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ฉันบอกพวกเขาล่วงหน้าไว้แล้ว",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{F#เธอ}{M#นาย}จะเป็นผู้ชมคนแรกของ \"การแสดงพิเศษ\" นี้เลย",
          "next": [
            150840117,
