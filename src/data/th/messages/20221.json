            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{F#เธอ}{M#นาย}จะยึดมั่นในเส้นทางนี้ และจะ \"บุกเบิก\" ต่อไปจนกว่า...",
