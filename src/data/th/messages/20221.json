        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "สะใจ ไม่ต้องลงมือทำอะไรด้วยซ้ำ แค่จ้องเฉยๆ ก็พอ",
