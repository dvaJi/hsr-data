            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "พลั่วพลาสติกก่อปราสาททราย?",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "แหวนวงหนึ่ง",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "เด็กน้อยบอกว่า ผู้ใหญ่ไม่ต้องการพลั่วพลาสติกกับขนมหรอก แต่ถ้าเดิมพันไม่เท่าเทียมกัน มันก็จะไม่ยุติธรรม",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "เขาก็เลยมอบแหวนเวทมนตร์ ที่กลืนกินฝันร้ายได้ให้กับฉัน",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "น่ารักจริงๆ นี่เป็นของแรร์ที่ไม่มีผลิตเลยนะ ฉันกำลังต้องการอยู่พอดี",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "อืม ฉันตัดสินใจแล้วว่า จะซื้อไอศกรีมซูเปอร์ดีลักซ์เก้าลูกให้เขาสักถ้วย",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "แล้วก็เชิญเขามาร่วมลงทุน ก่อสร้างอาณาจักรปราสาททราย อย่างถูกกฎหมายซะเลย",
          "next": [
