        "202160002": {
          "id": 202160002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "ก่อนจะหันหลัง ฉันได้มองดูดวงดาวเป็นครั้งสุดท้าย ดูสิ~",
          "next": [
