        "202160001": {
          "id": 202160001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "คู่หู ตอนที่{F#เธอ}{M#นาย}ได้รับข้อความนี้ ริ้วคลื่นคงจะออกเดินทางไปแล้วล่ะ",
