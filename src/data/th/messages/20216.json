        },
        "202160013": {
          "id": 202160013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "ถ้าอย่างนั้นก็มองขึ้นไปบนท้องฟ้า แล้วยิ้มเข้าไว้นะ!",
