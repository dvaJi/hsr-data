        "202490013": {
          "id": 202490013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "ช่วงก่อนหน้านี้ ตอนที่เม็ดบีดส์กำลังฮิตใน Planarcadia ฉันเองก็เคยทำอยู่สองสามครั้ง",
