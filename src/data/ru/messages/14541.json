      "messages": {
        "145410101": {
          "id": 145410101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Похоже, уже все среды активированы.",
          "next": [
            145410102
          ]
        },
        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "И как тебе наблюдение?",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Сцена созданий непредсказуема. Было очень интересно.",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "В этом всё очарование естественного отбора.",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "В непрерывно изменяющейся среде не бывает оптимального решения для живых существ.",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Просто зверушки вокруг бегают. Я такого уже {F#навидалась}{M# навидался}.",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Вот как.",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Во всяком случае ты увидел{F#а} исследование и выбор жизни в незнакомой среде.",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Возможно, в месте назначения нет никакого смысла, но их это явно не устраивает.",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "У тебя хорошо получилось.",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Я оставила для тебя награды, забери, как будет удобно.",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Труд должен вознаграждаться. Это моё законное право.",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Спасибо. Я всё зачищу.",
          "next": [
            145410114
          ]
        },
        "145410114": {
          "id": 145410114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ага. Я использовала средства космической станции на финансирование исследований.",
          "next": [
            145410115
          ]
        },
        "145410115": {
          "id": 145410115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ни в чём себе не отказывай.",
          "next": [
            145410116
          ]
        },
