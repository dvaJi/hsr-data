  "sections": [
    {
      "id": 2021300,
      "startingMessageId": [
        202130000
      ],
      "messages": {
        "202130000": {
          "id": 202130000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "{NICKNAME}, спишь?",
          "next": [
            202130001
          ]
        },
        "202130001": {
          "id": 202130001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Я не могу уснуть.",
          "next": [
            202130002,
            202130004
          ]
        },
        "202130002": {
          "id": 202130002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Сплю.",
          "next": [
            202130003
          ]
        },
        "202130003": {
          "id": 202130003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Вообще не смешно.",
          "next": [
            202130005
          ]
        },
        "202130004": {
          "id": 202130004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Мне тоже не спится.",
          "next": [
            202130005
          ]
        },
        "202130005": {
          "id": 202130005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ах, вообще я только что посмотрела фильм.",
          "next": [
            202130006
          ]
        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Написано, что он основан на реальной истории человека с более чем двадцатью личностями...",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "У главного героя были провалы в памяти. Он думал, что это обычная амнезия, но оказалось, что его жизнью живут другие личности.",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Скажи, может, и я...",
          "next": [
            202130009
          ]
        },
        "202130009": {
          "id": 202130009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202130010,
            202130013
          ]
        },
        "202130010": {
          "id": 202130010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Вообще-то... ты права...",
          "next": [
            202130011
          ]
        },
        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Вообще-то... вчерашняя ты... вовсе не такая, как ты сегодняшняя... Вчера ты была... гораздо милее...",
          "next": [
            202130012
          ]
        },
        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Думай, что говоришь! Я сегодня крайне мила! А завтра буду ещё очаровательнее!",
          "next": [
            202130014
          ]
        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не переживай, мне всё же виднее. Ты - целостная личность.",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Вот ты всё шутишь, а я волнуюсь.",
          "next": [
            202130015
          ]
        },
        "202130015": {
          "id": 202130015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "А вдруг... есть и другая Март 7?",
          "next": [
            202130016
          ]
        },
        "202130016": {
          "id": 202130016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Возможно... где-то есть художница Март 7 с эксцентричным нравом? Или элегантная убийца Март 7, в совершенстве овладевшая искусством общения? Жуть...",
          "next": [
            202130017
          ]
        },
        "202130017": {
          "id": 202130017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Или вообще мудрейшая и гениальная Март 7...",
          "next": [
            202130018,
            202130020,
            202130022
          ]
        },
        "202130018": {
          "id": 202130018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ага, мечтай... Спать пора.",
          "next": [
            202130019
          ]
        },
        "202130019": {
          "id": 202130019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Когда проснёшься, то снова будешь милой, ласковой, доброй и наивной девушкой Март 7.",
          "next": [
            202130024
          ]
        },
        "202130020": {
          "id": 202130020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не забывай, что ты Март 7 - мастер меча со Звёздного экспресса.",
          "next": [
            202130021
          ]
        },
        "202130021": {
          "id": 202130021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Не переживай, ты всё ещё та самая милая, ласковая, добрая и наивная девушка Март 7.",
          "next": [
            202130024
          ]
        },
        "202130022": {
          "id": 202130022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не переживай, всё в порядке.",
          "next": [
            202130023
          ]
        },
        "202130023": {
          "id": 202130023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ты всё ещё та самая милая, ласковая, добрая и наивная девушка Март 7.",
          "next": [
            202130024
          ]
        },
        "202130024": {
          "id": 202130024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            202130025
          ]
        },
        "202130025": {
          "id": 202130025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "И что бы я без тебя делала, умеешь подбодрить...",
          "next": [
            202130026
          ]
        },
        "202130026": {
          "id": 202130026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ладно, признаю - похоже, это меня уже так не беспокоит.",
          "next": [
            202130027
          ]
        },
        "202130027": {
          "id": 202130027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "В конце концов, я и есть мастер добрых дел, мудрая, обворожительная, хитрая, самая милая, ласковая, добрая и наивная девушка Март 7!",
          "next": [
            202130028
          ]
        },
        "202130028": {
          "id": 202130028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Давай спать, {NICKNAME}.",
          "next": [
            202130029
          ]
        },
        "202130029": {
          "id": 202130029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Завтра я помою за тобой посуду.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1001,
        8001
      ]
    }
  ]
}