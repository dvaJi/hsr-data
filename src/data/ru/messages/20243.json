  "sections": [
    {
      "id": 2024300,
      "startingMessageId": [
        202430000
      ],
      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, я только что была на берегу моря и собрала ещё кое-какие звуковые сэмплы.",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Например, звук кокоса, падающего на землю, шипение газировки с пузырьками, скворчащий на раскалённой сковороде кальмар...",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Даже слюнки потекли... Вот бы сейчас пару шашлычков из кальмара...",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Если честно, мне тоже...",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Эта музыка - неимоверная вкуснота... То есть, я хочу сказать, годнота!",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ха-ха, бывает, что голова совсем пустая и нет вдохновения - а тут запахи сразу пробуждают творческую энергию",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Я записала и другие звуки, где ещё больше морского колорита. Вот, послушай.",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Это звук отступающей волны: ш-ш-ш, шур-шур... Буль-буль-буль-буль...",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено] (обнаружен вокал в технике штробас)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Морской ветер пронизывает ржавый якорь: фью... вжух... фью...",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено] (обнаружен низкий звук)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Чайка пролетает: ш-ш-ш... фр-р-р.. ой!",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено] (обнаружено пение птиц)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Извини, это «ой» - моё. Чайка стащила у меня вкусняшку...",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Образцов достаточно, но всё равно чего-то не хватает... Звука, который берёт за душу.",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, может, у тебя есть какое-нибудь вдохновение, способное мгновенно взбодрить?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Послушай рёв Экспресса во время гиперпрыжка!",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Файл «Рёв_гиперпрыжка.mp3» получен",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Звук, олицетворяющий Освоение, и правда берёт за душу.",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Послушай звонок будильника!",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Файл «Будильник.mp3» получен",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Остановка сердца... тоже берёт за душу, полагаю.",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Но ради здоровья слушателей лучше бы этот звук был октавой ниже.",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Послушай моё душевное пение!",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Файл «Пение_в_душе.mp3» получен",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Это ты поёшь? И правда... берёт за душу.",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Хм... кажется, можно попробовать просто замиксовать!",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Импровизируй! Отбрось партитуру. Раскачайся! Мы больше не скованные части...",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено] (обнаружен оригинальный вокал)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ремикс Only by Chasing the Wind. С сэмплом «Прямо в душу» и аккомпанементом морского бриза атмосфера летней эйфории чувствуется ещё острее, правда?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Меня вдруг накрыло вдохновение, я ненадолго вернусь в студию звукозаписи.",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Спасибо за твою блестящую идею!",
          "next": [
            202430033
          ]
        },
        "202430033": {
          "id": 202430033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
      "participatingContactsIds": [
        1309,
