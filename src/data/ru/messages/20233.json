            202330054
          ]
        },
        "202330054": {
          "id": 202330054,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Твой сценарий",
          "next": [
            202330055
          ]
        },
        "202330055": {
          "id": 202330055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Пиши как хочешь",
          "next": [
            202330056
          ]
        },
        "202330056": {
          "id": 202330056,
          "type": "Text",
          "sender": "NPC",
