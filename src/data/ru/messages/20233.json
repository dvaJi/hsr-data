      "messages": {
        "202330000": {
          "id": 202330000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Придумала мини-программу для генерации сценариев",
          "next": [
            202330001
          ]
        },
        "202330001": {
          "id": 202330001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Поиграем?",
          "next": [
            202330002
          ]
        },
        "202330002": {
          "id": 202330002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Давай, что делать?",
          "next": [
            202330003
          ]
        },
        "202330003": {
          "id": 202330003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Симулятор жизни «Сценарий нужно писать самому» (версия с блокировкой Элио) импортирован в чат",
          "next": [
            202330004
          ]
        },
        "202330004": {
          "id": 202330004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Выберите режим перезапуска жизни:",
          "next": [
            202330005,
            202330027
          ]
        },
        "202330005": {
          "id": 202330005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Классический режим",
          "next": [
            202330006
          ]
        },
        "202330006": {
          "id": 202330006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "[Классическое начало] Происхождение -10, Интеллект -10, Телосложение -10, Сила -10, Выносливость -10",
          "next": [
            202330007
          ]
        },
        "202330007": {
          "id": 202330007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Жизненный сценарий игрока {NICKNAME}: «Я {F#возродилась}{M#возродился}: мама, люди - дикие»",
          "next": [
            202330008
          ]
        },
        "202330008": {
          "id": 202330008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "А теперь сделайте ваш первый шаг в этой жизни",
          "next": [
            202330009,
            202330016
          ]
        },
        "202330009": {
          "id": 202330009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я {F#первой}{M#первым} взойду на Звёздный экспресс! Стану проводником!",
          "next": [
            202330010
          ]
        },
        "202330010": {
          "id": 202330010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В детстве {NICKNAME} {F#поднялась}{M#поднялся} на борт Звёздного экспресса и {F#отказалась}{M#отказался} покидать его",
          "next": [
            202330011
          ]
        },
        "202330011": {
          "id": 202330011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В юности, когда вселенной грозило бедствие, {NICKNAME} за штурвалом экспресса прекрасно {F#справилась}{M#справился} с опасностями и чудом выжил{F#а}",
          "next": [
            202330012
          ]
        },
        "202330012": {
          "id": 202330012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В молодости, угодив в ловушку Эона, {NICKNAME} не смог{F#ла} дать отпор",
          "next": [
            202330013
          ]
        },
        "202330013": {
          "id": 202330013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В зрелом возрасте {F#её}{M#его} способности пробудились, и он{F#а} {F#поклялась}{M#поклялся} спасти мир",
          "next": [
            202330014
          ]
        },
        "202330014": {
          "id": 202330014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Нанук, конец",
          "next": [
            202330015
          ]
        },
        "202330015": {
          "id": 202330015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Настоящая сетевая литература",
          "next": [
            202330046
          ]
        },
        "202330016": {
          "id": 202330016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "«Не хватает отваги сделать первый шаг»",
          "next": [
            202330017
          ]
        },
        "202330017": {
          "id": 202330017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Конец",
          "next": [
            202330018
          ]
        },
        "202330018": {
          "id": 202330018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "?",
          "next": [
            202330019
          ]
        },
        "202330019": {
          "id": 202330019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Как-то это неправильно...",
          "next": [
            202330020
          ]
        },
        "202330020": {
          "id": 202330020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Погоди, я забыла импортировать культовую фразу Кафки",
          "next": [
            202330021
          ]
        },
        "202330021": {
          "id": 202330021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "«Когда наступит момент сделать выбор, сделай тот, о котором ты точно не будешь жалеть...»",
          "next": [
            202330022
          ]
        },
        "202330022": {
          "id": 202330022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Ладно, запускаю карусель твоей жизни...",
          "next": [
            202330023
          ]
        },
        "202330023": {
          "id": 202330023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В детстве, когда во вселенной царил мир, {NICKNAME} прекрасно проводил{F#а} время на Пегане",
          "next": [
            202330024
          ]
        },
        "202330024": {
          "id": 202330024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В юности, когда вселенную постигло бедствие, {NICKNAME} чудом выжил{F#а} благодаря своему происхождению",
          "next": [
            202330025
          ]
        },
        "202330025": {
          "id": 202330025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В молодости, угодив в ловушку Эона, {NICKNAME} не смог{F#ла} дать отпор",
          "next": [
            202330026
          ]
        },
        "202330026": {
          "id": 202330026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Конец",
          "next": [
            202330046
          ]
        },
        "202330027": {
          "id": 202330027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Режим сюрпризов",
          "next": [
            202330028
          ]
        },
        "202330028": {
          "id": 202330028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "[Неожиданное начало] Вытяните жребий 10 раз - характеристики распределятся произвольно... Происхождение -0, Интеллект -0, Телосложение -0, Сила -0, Выносливость -50",
          "next": [
            202330029
          ]
        },
        "202330029": {
          "id": 202330029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Жизненный сценарий игрока {NICKNAME}: «Я {F#возродилась}{M#возродился}: эй, мама, я у тебя {F#безумна}{M#безумен}»",
          "next": [
            202330030
          ]
        },
        "202330030": {
          "id": 202330030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "А теперь сделайте ваш первый шаг в этой жизни:",
          "next": [
            202330031,
            202330037
          ]
        },
        "202330031": {
          "id": 202330031,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Спасибо за приглашение. Только {F#родилась}{M#родился}, а мне уже предстоит сражаться с Нануком...",
          "next": [
            202330032
          ]
        },
        "202330032": {
          "id": 202330032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В прошлой жизни он{F#а} был{F#а} совсем {F#заурядной}{M#заурядным} и {F#безоружной}{M#безоружным}",
          "next": [
            202330033
          ]
        },
        "202330033": {
          "id": 202330033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "В этой жизни он{F#а} {F#наделена}{M#наделён} божественной силой и выложится по полной",
          "next": [
            202330034
          ]
        },
        "202330034": {
          "id": 202330034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Происхождение - безлимитно, Интеллект - безлимитно, Телосложение - безлимитно, Сила - безлимитно, Выносливость - безлимитно",
          "next": [
            202330035
          ]
        },
        "202330035": {
          "id": 202330035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{NICKNAME} одним ударом побеждает Нанука",
          "next": [
            202330036
          ]
        },
        "202330036": {
          "id": 202330036,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Вот так легко? Ни одной неудачи?",
          "next": [
            202330046
          ]
        },
        "202330037": {
          "id": 202330037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "«Не хватает отваги сделать первый шаг»",
          "next": [
            202330038
          ]
        },
        "202330038": {
          "id": 202330038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Конец",
          "next": [
            202330039
          ]
        },
        "202330039": {
          "id": 202330039,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Это как-то... неправильно? Разве я не лежал{F#а} на спине?",
          "next": [
            202330040
          ]
        },
        "202330040": {
          "id": 202330040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Погоди, я забыла импортировать культовую фразу Кафки",
          "next": [
            202330041
          ]
        },
        "202330041": {
          "id": 202330041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "«Когда наступит момент сделать выбор, сделай тот, о котором ты точно не будешь жалеть...»",
          "next": [
            202330042
          ]
        },
        "202330042": {
          "id": 202330042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Ладно, запускаю карусель твоей жизни...",
          "next": [
            202330043
          ]
        },
        "202330043": {
          "id": 202330043,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{F#Безумица}{M#Безумец} от рождения, {F#бросающая}{M#бросающий} вызов Нануку с одной лишь битой",
          "next": [
            202330044
          ]
        },
        "202330044": {
          "id": 202330044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Нанук, конец",
          "next": [
            202330045
          ]
        },
        "202330045": {
          "id": 202330045,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "А, так это ему конец",
          "next": [
            202330046
          ]
        },
        "202330046": {
          "id": 202330046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Ну как? Весело?",
          "next": [
            202330047,
            202330049
          ]
        },
        "202330047": {
          "id": 202330047,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Давай по новой!",
          "next": [
            202330048
          ]
        },
        "202330048": {
          "id": 202330048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Не спеши, это бета-тест",
          "next": [
            202330053
          ]
        },
        "202330049": {
          "id": 202330049,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А у тебя какой сценарий?",
          "next": [
            202330050
          ]
        },
        "202330050": {
          "id": 202330050,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Ты о чём?",
          "next": [
            202330051
          ]
        },
        "202330051": {
          "id": 202330051,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Я во всех побеждаю",
          "next": [
            202330052
          ]
        },
        "202330052": {
          "id": 202330052,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Не завидуй",
          "next": [
