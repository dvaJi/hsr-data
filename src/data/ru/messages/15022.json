      "messages": {
        "150220100": {
          "id": 150220100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "{NICKNAME}, давно не виделись.",
          "next": [
            150220101,
            150220103
          ]
        },
        "150220101": {
          "id": 150220101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Госпожа Сюэи! Вот уж не ожидал{F#а} от тебя сообщений!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "А ты всё {F#такая же энергичная}{M#такой же энергичный}.",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Мы так давно не общались.",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Прости, это моя оплошность.",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Как будет время, постараюсь болтать с тобой почаще.",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Слышала, что ты путешествуешь по Двумернии.",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "У меня есть небольшая просьба к тебе.",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Без проблем, ваша честь, говорите!",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Слышал{F#а} ли ты об «Игре в лабиринте»?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Я давно интересуюсь этим комиксом.",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Поиск преступников и врагов больше по мне, чем дебютная работа автора «Звезда вока».",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Слышала, что в городе Плоском проходит фестиваль по «Игре в лабиринте», на которой будет продаваться много фан-арта.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Жаль, что моя личность не позволяет мне самой посетить фестиваль комиксов.",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Купи, пожалуйста, несколько фанфиков для меня.",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А я тут как раз неподалёку... Ты ведь не следишь за мной?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Бип-бип, дрон слежения «Сюэи-9527» обнаружен, выполняется программа самоуничтожения.",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "А-а-а, пощади! Не взрывай меня! Я куплю тебе фанфики! Честное слово!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Не бойся, я просто шучу.",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Здесь нет взрывающихся дронов, не беспокойся.",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "С нетерпением жду новых фанфиков, спасибо.",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Какое совпадение, я как раз на фестивале!",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ты тоже читал{F#а}? Это прекрасно, спасибо.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Пустяки. Я всё сделаю.",
          "next": [
            150220124
          ]
        },
        "150220124": {
          "id": 150220124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "С нетерпением жду новых фанфиков, спасибо.",
          "next": []
