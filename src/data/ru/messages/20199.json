  "sections": [
    {
      "id": 2019900,
      "startingMessageId": [
        201990000
      ],
      "messages": {
        "201990000": {
          "id": 201990000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "{NICKNAME}, прошу прощения.",
          "next": [
            201990001
          ]
        },
        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Помните моих домашних химер? Оказывается, им нравятся сказки на ночь.",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "В последнее время я пробую новые идеи, думаю написать историю.",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А что за история?",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А для меня роль найдётся?",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Хорошо.",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Я как раз хотела спросить, что вы думаете. Общий замысел такой:",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Главный герой случайно попадает в городок, населённый котиками и мышатами, поющими воронами, розовощёкими поросятами и семейством трудолюбивых муравьёв.",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Они ведут себя совсем как люди, играют с героем и любят слушать истории.",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Нет, не просто любят. Обожают...",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Когда в сказочном городке наступает ночь и всё затихает, малыши никак не могут заснуть...",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Они всё повторяют: «слишком тихо», «здесь слишком тихо»...",
          "next": [
            201990012
          ]
        },
        "201990012": {
          "id": 201990012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "И тогда они идут к кровати героя...",
          "next": [
            201990013
          ]
        },
        "201990013": {
          "id": 201990013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Вот так.",
          "next": [
            201990014
          ]
        },
        "201990014": {
          "id": 201990014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "●_●",
          "next": [
            201990015
          ]
        },
        "201990015": {
          "id": 201990015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◕_◕",
          "next": [
            201990016
          ]
        },
        "201990016": {
          "id": 201990016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◐‿◑",
          "next": [
            201990017
          ]
        },
        "201990017": {
          "id": 201990017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "И смотрят на вас.",
          "next": [
            201990018,
            201990021,
            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А это точно детская сказка? Как-то страшновато...",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "О, правда?",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Честно говоря, только приступив к написанию, я поняла, что этот сюжет больше подходит для ужасов.",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Милота какая.",
          "next": [
            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Честно говоря, только приступив к написанию, я поняла, что этот сюжет больше подходит для ужасов.",
          "next": [
            201990023
          ]
        },
        "201990023": {
          "id": 201990023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Однако ваша реакция заставляет задуматься, что история выходит недостаточно жуткой.",
          "next": [
            201990027
          ]
        },
        "201990024": {
          "id": 201990024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А где же это тихое место?",
          "next": [
            201990025
          ]
        },
        "201990025": {
          "id": 201990025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ход ваших мыслей всегда отличается от других.",
          "next": [
            201990026
          ]
        },
        "201990026": {
          "id": 201990026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Честно говоря, только приступив к написанию, я поняла, что этот сюжет больше подходит для ужасов.",
          "next": [
            201990027
          ]
        },
        "201990027": {
          "id": 201990027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": [
            201990028
          ]
        },
        "201990028": {
          "id": 201990028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Но я плохо знакома с этим жанром. Чтобы погрузиться в атмосферу, я обратилась к таким справочным материалам, как «20 нераскрытых тайн» и «Объяснения исчезновений».",
          "next": [
            201990029
          ]
        },
        "201990029": {
          "id": 201990029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Сегодня я дочитала «Питайтесь правильно» и почерпнула оттуда несколько неплохих идей.",
          "next": [
            201990030
          ]
        },
        "201990030": {
          "id": 201990030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Когда будут новости, я обязательно вам сообщу.",
          "next": [
            201990031
          ]
        },
        "201990031": {
          "id": 201990031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Будьте уверены, подталкивать меня к завершению истории будут каждый день - химеры их обожают.",
          "next": [
            201990032
          ]
        },
        "201990032": {
          "id": 201990032,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": []
        }
      },
