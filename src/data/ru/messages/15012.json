      "messages": {
        "150120100": {
          "id": 150120100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ты что творишь, сволочь?",
          "next": [
            150120101
          ]
        },
        "150120101": {
          "id": 150120101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты кто?",
          "next": [
            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Не прикидывайся {F#дурочкой}{M#дурачком}! Ты ведь глава «Шерстяки Телеком»! Это ты всё устроил{F#а}!",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Мои руки стали двигаться сами по себе.",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "И нос дёргается.",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Прекрати это! Немедленно!",
          "next": [
            150120106,
            150120109
          ]
        },
        "150120106": {
          "id": 150120106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Так ты и есть Убийца тысячелетия?",
          "next": [
            150120107
          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Откуда у тебя мой номер?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ты что, даже не знаешь, кто я? Смешно. Ты меня не знаешь, а такое творишь.",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Так ты тот доктор Изол?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Откуда у тебя мой номер?",
          "next": [
            150120111
          ]
        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Нет! Смешно. Ты меня не знаешь, а такое творишь.",
          "next": [
            150120112
          ]
        },
        "150120112": {
          "id": 150120112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "А что до твоего номера...",
          "next": [
            150120113
          ]
        },
        "150120113": {
          "id": 150120113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Вся контактная информация медиа-компаний находится в открытом доступе. Ты что, не знаешь?",
          "next": [
            150120114
          ]
        },
        "150120114": {
          "id": 150120114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Прекрати! Я выполню любые твои условия. Эта жестокость ни к чему.",
          "next": [
            150120115
          ]
        },
        "150120115": {
          "id": 150120115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Мои ноги странно повернулись.",
          "next": [
            150120116
          ]
        },
        "150120116": {
          "id": 150120116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Не надо.",
          "next": []
        }
