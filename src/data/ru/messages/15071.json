        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "{F#Госпожа}{M#Господин} главред, как поживаете?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ой, простите, по привычке воспользовался рабочим смартфоном.",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Это я, Шерстила! Гигашерст - мой сценический псевдоним.",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "У меня хорошая новость, {F#госпожа}{M#господин} главред.",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Мой кинопроект запущен в производство! Это будет супергеройский блокбастер под названием «Гигашерст в унынии»!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ух ты! Поздравляю со сбычей мечты!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Праздновать пока рано - съёмки только начались.",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Вот это да!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Так ты всё-таки вернёшься на работу или нет?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Придётся подождать, пока фильм доснимут - а съёмки только-только начались.",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "О, Вуббабу зовёт меня.",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "{F#Госпожа}{M#Господин} главред, будет свободное время - заглядывайте к нам на съёмочную площадку!",
          "next": []
        }
      },
