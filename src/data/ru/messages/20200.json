      ],
      "messages": {
        "202000000": {
          "id": 202000000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Давно не виделись, {NICKNAME}.",
          "next": [
            202000001
          ]
        },
        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Новости из-за пределов неба заполонили Амфореус, и среди студентов Рощи распространились новые интеллектуальные тенденции.",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Недавно студент прислал мне один тест.",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Файл «Какой ты Эон?» отправлен",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Хочешь попробовать?",
          "next": [
            202000005,
            202000006,
            202000007
          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Тут и тест не нужен, я точно Акивили.",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я - Нанук, присваиваю тебе титул Лорда Опустошителя.",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я - Аха, ха-минь!",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Бегло просмотрев тест, могу сказать, что он, основываясь на общих концепциях Путей, пытается раскрыть индивидуальное самовосприятие и предсказать поведение с помощью классификации.",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Анакса не в сети",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Анакса в сети",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Я - Ороборос.",
          "next": [
            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "В комментарии написано:",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "«Вы чем-то похожи на Ороборос: так же, как геозавры поглощают краснозём, вы жадно набрасываетесь на истину, поглощая её без остатка. Желание - это врождённый импульс, что движет вашими действиями».",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "«Ваш жизненный девиз: ненасытность!».",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А почему не Дроидоголовая?",
          "next": [
            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Странно, но тебе подходит.",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ненасытность в хорошем смысле.",
          "next": [
            202000018
          ]
        },
        "202000018": {
          "id": 202000018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Любопытно. Но не стоит внимания.",
          "next": [
            202000019
          ]
        },
        "202000019": {
          "id": 202000019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "В общем",
          "next": [
            202000020
          ]
        },
        "202000020": {
          "id": 202000020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "домашних заданий им явно недостаточно.",
          "next": []
        }
      },
