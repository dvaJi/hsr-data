        },
        "145440102": {
          "id": 145440102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Роднульки",
          "next": [
            145440103
          ]
        },
        "145440103": {
          "id": 145440103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Хочу сказать, что",
          "next": [
            145440104
          ]
        },
        "145440104": {
          "id": 145440104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Какая милота!",
          "next": [
            145440105
          ]
        },
        "145440105": {
          "id": 145440105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Да! Особенно Главный Суетолог... Думаю, она хочет ко мне.",
          "next": [
            145440106
          ]
        },
        "145440106": {
          "id": 145440106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Аста добавляет пользователя Герта в групповой чат",
          "next": [
            145440107
          ]
        },
        "145440107": {
          "id": 145440107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Кхм.",
          "next": [
            145440108
          ]
        },
        "145440108": {
          "id": 145440108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Должна заявить, что с постоянной практикой Булочка С Глицинией лучше освоит волшебство.",
          "next": [
            145440109
          ]
        },
        "145440109": {
          "id": 145440109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Что до красоты, то тут уже некуда развиваться.",
          "next": [
            145440110
          ]
        },
        "145440110": {
          "id": 145440110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Хватит, хватит! Не надо тайно от нас прокачиваться!",
          "next": [
            145440111
          ]
        },
        "145440111": {
          "id": 145440111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Ох, как бы превратиться в Печенюшку Удачи...",
          "next": [
            145440112
          ]
        },
        "145440112": {
          "id": 145440112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Чтобы нефритовые счёты переставали работать, как только я подхожу. И я не получала сообщений по работе.",
          "next": [
            145440113
          ]
        },
        "145440113": {
          "id": 145440113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Могу помочь тебе осуществить первое желание. Попробуем?",
          "next": [
            145440114
          ]
        },
        "145440114": {
          "id": 145440114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Пожалуй, откажусь!",
          "next": [
            145440115,
            145440118
          ]
        },
        "145440115": {
          "id": 145440115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "И кто бы мог подумать, что это состязание с созданиями вскроет столько скрытых талантов.",
          "next": [
            145440116
          ]
        },
        "145440116": {
          "id": 145440116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Это всё же был стрим с комментариями.",
          "next": [
            145440117
          ]
        },
        "145440117": {
          "id": 145440117,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1210,
          "next": [
            145440121
          ]
        },
        "145440118": {
          "id": 145440118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Пусть рейтинги не обесценивают усилия участников.",
          "next": [
            145440119
          ]
        },
        "145440119": {
          "id": 145440119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Угадайте, кто легко победит?",
          "next": [
            145440120
          ]
        },
        "145440120": {
          "id": 145440120,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1201,
          "next": [
            145440121
          ]
        },
        "145440121": {
          "id": 145440121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "{NICKNAME}, поддержишь как-то своего участника?",
          "next": [
            145440122,
            145440123
          ]
        },
        "145440122": {
          "id": 145440122,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Честно скажу, мне очень любопытно, каковы эти вкусняшки на вкус.",
          "next": [
            145440124
          ]
        },
        "145440123": {
