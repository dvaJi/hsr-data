  "sections": [
    {
      "id": 2017700,
      "startingMessageId": [
        201770000
      ],
      "messages": {
        "201770000": {
          "id": 201770000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Глянь, награда будет.",
          "next": [
            201770001,
            201770002
          ]
        },
        "201770001": {
          "id": 201770001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Сколько? Я подумаю, хочу ли браться.",
          "next": [
            201770003
          ]
        },
        "201770002": {
          "id": 201770002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Что-то протестировать? Мои расценки выросли.",
          "next": [
            201770003
          ]
        },
        "201770003": {
          "id": 201770003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Загрузка файла «Список покупок одежды и руководство по хранению»",
          "next": [
            201770004
          ]
        },
        "201770004": {
          "id": 201770004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ошибка загрузки, слишком большой файл",
          "next": [
            201770005
          ]
        },
        "201770005": {
          "id": 201770005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Срочно обнови систему сообщений.",
          "next": [
            201770006
          ]
        },
        "201770006": {
          "id": 201770006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "В общем, я накупила новой одежды, и куклы не успевают её рассортировывать.",
          "next": [
            201770007,
            201770008
          ]
        },
        "201770007": {
          "id": 201770007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Это сколько же ты купила?",
          "next": [
            201770009
          ]
        },
        "201770008": {
          "id": 201770008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я {NICKNAME}, подари и мне.",
          "next": [
            201770009
          ]
        },
        "201770009": {
          "id": 201770009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "На тебя не сядет.",
          "next": [
            201770010
          ]
        },
        "201770010": {
          "id": 201770010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Это куклам.",
          "next": [
            201770011,
            201770013
          ]
        },
        "201770011": {
          "id": 201770011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Куклы тоже переодеваются?",
          "next": [
            201770012
          ]
        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Конечно. Они же такие милашки, как тут не покупать им красивую одежду?",
          "next": [
            201770015
          ]
        },
        "201770013": {
          "id": 201770013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Кошмар. Даже у кукол одежды больше, чем у меня.",
          "next": [
            201770014
          ]
        },
        "201770014": {
          "id": 201770014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Только сейчас понял{F#а}?",
          "next": [
            201770015
          ]
        },
        "201770015": {
          "id": 201770015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "На этот раз стилевое разнообразие зашкаливает, поэтому раскладывай всё по категориям.",
          "next": [
            201770016
          ]
        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "В первую очередь отложи то, по чему сразу видно - подобрано со вкусом, такое, что я бы надела.",
          "next": [
            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Повторяющиеся рекомендации от Жуань Мэй клади туда же.",
          "next": [
            201770018
          ]
        },
        "201770018": {
          "id": 201770018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Броские цвета идут в категорию ретро.",
          "next": [
            201770019
          ]
        },
        "201770019": {
          "id": 201770019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Если крой сложный и вводит в тупик, клади к высокой моде.",
          "next": [
            201770020
          ]
        },
        "201770020": {
          "id": 201770020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Всё остальное прописано в руководстве.",
          "next": [
            201770021
          ]
        },
        "201770021": {
          "id": 201770021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Собеседник отправляет местоположение",
          "next": [
            201770022
          ]
        },
        "201770022": {
          "id": 201770022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Я отправила тебе адрес гардеробной. Это недалеко от тебя.",
          "next": [
            201770023
          ]
        },
        "201770023": {
          "id": 201770023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ищи маленькую космическую станцию.",
          "next": [
            201770024
          ]
        },
        "201770024": {
          "id": 201770024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "И не переживай, поместишься.",
          "next": [
            201770025,
            201770027
          ]
        },
        "201770025": {
          "id": 201770025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Что? Космическая станция? А Аста в курсе?",
          "next": [
            201770026
          ]
        },
        "201770026": {
          "id": 201770026,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Без предоплаты не работаю.",
          "next": [
            201770029
          ]
        },
        "201770027": {
          "id": 201770027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты купила куклам станцию-гардероб? А Аста в курсе?",
          "next": [
            201770028
          ]
        },
        "201770028": {
          "id": 201770028,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Без предоплаты не работаю.",
          "next": [
            201770029
          ]
        },
        "201770029": {
          "id": 201770029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Вот у неё и спроси.",
          "next": [
            201770030
          ]
        },
        "201770030": {
          "id": 201770030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Соединение с контактом «Аста».",
          "next": []
        }
      },
