        },
        "150150101": {
          "id": 150150101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Аста! Скорее ко @Входу в Двумернию! С Пеппи случилась беда!",
          "next": [
            150150102
          ]
        },
        "150150102": {
          "id": 150150102,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Кажется, он немного того... умер!",
