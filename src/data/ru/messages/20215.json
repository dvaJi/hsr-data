            202150017
          ]
        },
        "202150017": {
          "id": 202150017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Насколько я тебя знаю, наверняка тебе снова пришли в голову неожиданные ассоциации.",
          "next": [
            202150018
