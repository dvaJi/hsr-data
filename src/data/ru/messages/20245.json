      ],
      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Обед пташки на сегодня: кукуруза, киноа, пюре из гороха (не забудь пить воду!)",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Питаешься одними овощами, а мяса - ни кусочка!",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Значит, вот что нужно есть, чтобы беречь голос? Как изысканно! Ничего не скажешь - настоящая звезда!",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Извини! Хотела отправить себе, но случайно нажала не то.",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ты помнишь, я рассказывала тебе, что нашла маленького птенца со сломанным крылом?",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Рецепт выше - не для меня, а для той пташки.",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Теперь она выздоровела, и на крыльях выросли новые перья.",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Я уже почти дома. Хочешь её увидеть?",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Зарянка заботится о пташке. Какая милота.",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Пташка, выкормленная тобою, наверняка пухленькая!",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Зарянка не в сети",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Зарянка в сети",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Я зашла домой, а птички тут нет.",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Наверное, улетела через открытое окно.",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А... не грусти. Возможно, она готова к свободному полёту.",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Спасибо за поддержку, я тоже так думаю~",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Я ждала дня, когда она снова взлетит.",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Пусть это немного неожиданно... но ты ждала того дня, когда она снова взлетит, ведь так?",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Да, я знала, что ты меня поймёшь.",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Пташка начала новую птичью жизнь и приключения! Она никогда тебя не забудет.",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ага! Если честно, я ждала дня, когда она снова взлетит.",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Обычно она взлетала на подоконник и смотрела на мир снаружи. Я думаю, она готова.",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Жаль, конечно, что не удалось увидеть, как она расправляет крылья и улетает.",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Чик-чирик! Чирик-чирик-чирик!",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено] (обнаружена свободная высокая нота)",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ха-ха, это три моих маленьких музыканта.",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Они говорят, что птичка прекрасна в полёте.",
          "next": [
            202450029
          ]
        },
        "202450029": {
          "id": 202450029,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
