  "sections": [
    {
      "id": 1454000,
      "startingMessageId": [
        145400023
      ],
      "messages": {
        "145400000": {
          "id": 145400000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Это групповой чат для обсуждения состязаний. Здесь собраны все участники.",
          "next": [
            145400001
          ]
        },
        "145400001": {
          "id": 145400001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Серебряшка, поздоровайся со всеми.",
          "next": [
            145400002,
            145400005
          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "В битве химер навыки говорят сами за себя.",
          "next": [
            145400003
          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Я вас всех одолею и стану лучшим тренером Амфореуса.",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я только {F#прошла}{M#прошёл} отборочный матч, я ещё новичок.",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ребята, давайте полегче.",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Напарник, нечасто тебя так встретишь. Давай устроим поединок наших химер!",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ха, постарайся не проиграть в самом начале, Спаситель.",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Стоишь у меня на пути? Ха, посмотрим, на что ты {F#способна}{M#способен}.",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Ничего, я разберусь со всеми препятствиями на пути цезаря.",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Серая Тайна, заключим сделку? Я помогу тебе украсть химеру соперника, а взамен ты мне поддашься.",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Даже не думай об этом, Цифера. Ты же знаешь, что от золотых нитей никуда не скрыться.",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Никакого жульничества! *Мы* будем судьями и будем следить за каждым!",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Разве честно быть и судьёй, и участником?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Хм... Трибби будет сражаться, Триннона будет судьёй, а Трианна будет ловить жуликов. Да, отлично!",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, я тоже выложусь на полную в состязании химер.",
          "next": [
            145400018,
            145400019
          ]
        },
        "145400018": {
          "id": 145400018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Меня приводит в ужас сама мысль о том, что Дань Хэн подходит к состязанию серьёзно.",
          "next": [
            145400020
          ]
        },
        "145400019": {
          "id": 145400019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Отлично, я буду сражаться изо всех сил!",
          "next": [
            145400020
          ]
        },
        "145400020": {
          "id": 145400020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Хи-хи, жду не дождусь, когда {NICKNAME} покажет себя!",
          "next": [
            145400021
          ]
        },
        "145400021": {
          "id": 145400021,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1415,
          "next": []
        },
        "145400022": {
