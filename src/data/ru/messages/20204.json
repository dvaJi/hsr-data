        "202040012": {
          "id": 202040012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Дарю. Хорошая вещица, так тебя никто не обманет.",
          "next": [
            202040013,
            202040014,
            202040016
          ]
        },
        "202040013": {
          "id": 202040013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А, спамишь, получается.",
