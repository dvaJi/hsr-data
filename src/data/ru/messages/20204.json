        },
        "202040024": {
          "id": 202040024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Дарю тебе Изящный бездонный мешок. Давно говорю, что тебе нужна сумка побольше.",
