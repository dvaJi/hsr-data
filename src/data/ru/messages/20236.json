      ],
      "messages": {
        "202360000": {
          "id": 202360000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Версия плагина для поиска святого оружия Блэйда обновлена.",
          "next": [
            202360001
          ]
        },
        "202360001": {
          "id": 202360001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "В этом обновлении: исправлены некоторые известные проблемы, добавлена функция снижения силы вибрации.",
          "next": [
            202360002,
            202360003
          ]
        },
        "202360002": {
          "id": 202360002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Какое быстрое обновление, даже быстрее, чем в моей игре!",
          "next": [
            202360004
          ]
        },
        "202360003": {
          "id": 202360003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Посмотрим, уменьшится ли вибрация.",
          "next": [
            202360004
          ]
        },
        "202360004": {
          "id": 202360004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Вы отправляете сообщение, и смартфон Блэйда слегка вибрирует.",
          "next": [
            202360005
          ]
        },
        "202360005": {
          "id": 202360005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Смартфон Блэйда получает ваш сигнал и слегка вибрирует.",
          "next": [
            202360006
          ]
        },
        "202360006": {
          "id": 202360006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Блэйд в сети",
          "next": [
            202360007
          ]
        },
        "202360007": {
          "id": 202360007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Тсс. Хватит.",
          "next": [
            202360008
          ]
        },
        "202360008": {
          "id": 202360008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Я смотрю запись с камеры наблюдения. В чём дело?",
          "next": [
            202360009,
            202360010,
            202360011
          ]
        },
        "202360009": {
          "id": 202360009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Это тот самый захватывающий этап выслеживания врага?",
          "next": [
            202360013
          ]
        },
        "202360010": {
          "id": 202360010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты занят очередной миссией? Это тот самый захватывающий этап выслеживания врага?",
          "next": [
            202360013
          ]
        },
        "202360011": {
          "id": 202360011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не переживай, я не буду отправлять голосовые сообщения.",
          "next": [
            202360012
          ]
        },
        "202360012": {
          "id": 202360012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Какую запись ты смотришь? Это тот самый захватывающий этап выслеживания врага?",
          "next": [
            202360013
          ]
        },
        "202360013": {
          "id": 202360013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Нет.",
          "next": [
            202360014
          ]
        },
        "202360014": {
          "id": 202360014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360015
          ]
        },
        "202360015": {
          "id": 202360015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360016
          ]
        },
        "202360016": {
          "id": 202360016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Я смотрю запись с котопирожком.",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты следишь за Кунжутным Печеньем?",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Угу.",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Давно ты следишь за котопирожком?",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Не следил за временем.",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Котопирожок! Так бы и сказал.",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "В следующий раз я проведу тебя туда.",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ладно, в другой раз обязательно.",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Что там на записи с камеры? С Кунжутным Печеньем всё в порядке?",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "У него появилось два новых друга.",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Белый, похоже, не может усидеть на месте, с характером и любит поболтать.",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Красный - не очень разговорчивый, но тоже с характером.",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Отлично, Кунжутное Печенье всегда был один.",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты придумал им имена?",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Я?",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Назовём их Снежок и Финиковый Кекс.",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Они немного похожи на тебя, я имею в виду характером.",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "У новых друзей есть имена?",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Не знаю, дай подумать.",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Назовём их Финиковый Кекс и Снежок.",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360038
          ]
        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Они дерутся.",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Похоже, отношения у них не очень хорошие.",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Вылизывают друг друга.",
          "next": [
            202360042
          ]
        },
        "202360042": {
          "id": 202360042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Это было просто недоразумение, они неплохо ладят.",
          "next": [
            202360043
          ]
        },
        "202360043": {
          "id": 202360043,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202360044
          ]
        },
        "202360044": {
          "id": 202360044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Никого не видно.",
          "next": [
            202360045
          ]
        },
        "202360045": {
          "id": 202360045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Возможно, они заметили, что я слежу за ними, и спрятались.",
          "next": [
            202360046
          ]
        },
        "202360046": {
          "id": 202360046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Проверю другие камеры наблюдения.",
          "next": [
            202360047
          ]
        },
        "202360047": {
          "id": 202360047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Если у тебя ничего срочного, поговорим в другой раз.",
          "next": [
            202360048
          ]
        },
        "202360048": {
          "id": 202360048,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ваш друг Блэйд не в сети",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}