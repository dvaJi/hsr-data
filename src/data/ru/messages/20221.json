      "messages": {
        "202210000": {
          "id": 202210000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, кстати о Разрушении.",
          "next": [
            202210001
          ]
        },
        "202210001": {
          "id": 202210001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Тебе наверняка оно хорошо знакомо.",
          "next": [
            202210002
          ]
        },
        "202210002": {
          "id": 202210002,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210003
          ]
        },
        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Зверь Судного дня, Фантилия, Сталесклеп...",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Интересно, каково было встретить их вблизи?",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Весело. Одного пристального взгляда хватает, и пальцем не нужно шевелить.",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ага, взгляд может убить~",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "К сожалению, я ничего не чувствую. Я пуст{F#а} внутри.",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Хм, сурово.",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Нужно всё делать шаг за шагом.",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Всего-то нужно наносить удар за ударом.",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ага, пошаговый бой~",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "В Разрушении нет ничего славного... но в его красоте нет никаких сомнений.",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ты будешь и дальше идти по Пути Освоения.",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Пока... не уничтожишь Разрушение, верно?",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Хочешь присоединиться к нам? Ты ведь уже предала Разрушение.",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Жду этого дня с нетерпением.",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Однако, если ты выступаешь против Освоения",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты всё равно вернёшься к Разрушению? Второе предательство предательством не считается?",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Отличная идея, мне нравится.",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Если кто-то выступает против Освоения",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Он может попасть в зажжённый тобой фейерверк...",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Как говорится в их сценарии,",
          "next": [
            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "стать Лордом Опустошителем, уничтожающим Память, - не такой уж плохой выбор.",
          "next": [
            202210024
          ]
        },
        "202210024": {
          "id": 202210024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210025
          ]
        },
        "202210025": {
          "id": 202210025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Очнись!",
          "next": [
            202210026
          ]
        },
        "202210026": {
          "id": 202210026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Любовь, вера, ожидание.",
          "next": [
            202210027
          ]
        },
