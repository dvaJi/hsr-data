  "sections": [
    {
      "id": 2021200,
      "startingMessageId": [
        202120000
      ],
      "messages": {
        "202120000": {
          "id": 202120000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Вот мы и встретились снова, серая птичка Освоения ♭",
          "next": [
            202120001
          ]
        },
        "202120001": {
          "id": 202120001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ты опять меня разбудил{F#а}.",
          "next": [
            202120002,
            202120004,
            202120005
          ]
        },
        "202120002": {
          "id": 202120002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Просыпайся~",
          "next": [
            202120003
          ]
        },
        "202120003": {
          "id": 202120003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Новые наряды уже прибыли. Охотник за талантами ждёт за дверью. А твой любимый сок теперь сотрудничает с Зарянкой...",
          "next": [
            202120007
          ]
        },
        "202120004": {
          "id": 202120004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А который сейчас час, что ты уже начала лунатить?",
          "next": [
            202120007
          ]
        },
        "202120005": {
          "id": 202120005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Подруга, смени аккаунт.",
          "next": [
            202120006
          ]
        },
        "202120006": {
          "id": 202120006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Сейчас уже тёмная ночь.",
          "next": [
            202120007
          ]
        },
        "202120007": {
          "id": 202120007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1413,
          "next": [
            202120008
          ]
        },
        "202120008": {
          "id": 202120008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Я всего лишь хотела заключить с тобой небольшую сделку.",
          "next": [
            202120009
          ]
        },
        "202120009": {
          "id": 202120009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "При мне остались кое-какие воспоминания... Ты ведь не хочешь, чтобы они стали достоянием общественности?",
          "next": [
            202120010,
            202120011
          ]
        },
        "202120010": {
          "id": 202120010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Расскажи подробнее.",
          "next": [
            202120012
          ]
        },
        "202120011": {
          "id": 202120011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Мне нечего скрывать.",
          "next": [
            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ты по пятам ходил{F#а} за геозавром с разбитым сердцем, а потом сделал{F#а} с ним селфи и опубликовал{F#а} с подписью «Мудрецы не влюбляются».",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "А ещё в лавке придорожного жреца, что предсказывает судьбы, осталось селфи с подписью «Наши судьбы вершим мы сами, небеса тут ни при чём».",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ты {F#вышла}{M#вышел} прогуляться, встретил{F#а} рапсода... и тут же устроил{F#а} с ним рэп-баттл, а потом сделал{F#а} селфи.",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ты сделал{F#а} селфи утром, с растрёпанными волосами.",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ты почувствовал{F#а}, что в последнее время {F#поправилась}{M#поправился}, и поэтому сделал{F#а} селфи.",
          "next": [
            202120017
          ]
        },
        "202120017": {
          "id": 202120017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202120018,
            202120019,
            202120020
          ]
        },
        "202120018": {
          "id": 202120018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ясно, похоже, нам понадобится сила Забвения.",
          "next": [
            202120023
          ]
        },
        "202120019": {
          "id": 202120019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Круто же, да?",
          "next": [
            202120023
          ]
        },
        "202120020": {
          "id": 202120020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ой, мне бы хотелось остаться за кулисами, но похоже, что ты меня раскрыла.",
          "next": [
            202120021
          ]
        },
        "202120021": {
          "id": 202120021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Все эти фото предназначались Март 7.",
          "next": [
            202120022
          ]
        },
        "202120022": {
          "id": 202120022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Скажи, что мне сделать, чтобы ты вернула мне все эти воспоминания.",
          "next": [
            202120023
          ]
        },
        "202120023": {
          "id": 202120023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Хи, теперь она знает ♭",
          "next": [
            202120024
          ]
        },
        "202120024": {
          "id": 202120024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Если ты не хочешь увидеть все эти фото на фотостене... Всё просто, серая птичка ♭",
          "next": [
            202120025
          ]
        },
        "202120025": {
          "id": 202120025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Когда она проснётся завтра в полдень, то перед ней должны быть свежеприготовленные лакомства.",
          "next": [
            202120026,
            202120027
          ]
        },
        "202120026": {
          "id": 202120026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Спи, Март 7. Хотеть не вредно.",
          "next": [
            202120028
          ]
        },
        "202120027": {
          "id": 202120027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Хорошо, Темень.",
          "next": [
            202120028
          ]
        },
        "202120028": {
          "id": 202120028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            202120029
          ]
        },
        "202120029": {
          "id": 202120029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ну и ладно, не буду с тобой играть.",
          "next": [
            202120030
          ]
        },
        "202120030": {
          "id": 202120030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Я проголодалась. Пора подумать, чем бы нам подкрепиться.",
          "next": []
        }
      },
