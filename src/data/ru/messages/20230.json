      ],
      "messages": {
        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Откуда в мире взялась такая милота?!",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Лапки такие мягкие, и пахнет от него свежим рисом!",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Эх, камера накрылась, не сфоткать мне ангелочка. Т_Т",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Поддерживаю! Щеночки спасут мир!",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ты завёл пёсика? Можно погладить?",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "К сожалению, это собачка клиента.",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Прости, я {F#кошатница}{M#кошатник}.",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "О, вот как.",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Один очень важный человек, чьё имя я не могу назвать, получил сегодня утром записку с угрозами.",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Там было всего три слова: «Конец тебе, собака».",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ни секунды не колеблясь, я сразу взял это поручение.",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Теперь никто даже пальцем не тронет этого пушистика.",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "А есть вероятность, что слово «собака» относилось не к животному, а к...",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "А, ты про клиента? Да я знаю, не волнуйся. Господин Рассказчик уже пошёл его охранять.",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Собачке я сейчас нужен больше, чем клиенту.",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Кажется, это тебе она нужнее.",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Может, сам заведёшь собаку? Чтобы не донимать чужих целыми днями.",
          "next": [
            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ой, да я бы с радостью! Если б на корм хватало...",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Клиент сказал, что собаки - это чёрная дыра для кошелька. Не могу я обрекать малыша на такие страдания вместе со мной.",
          "next": [
            202300019
          ]
        },
        "202300019": {
          "id": 202300019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1504,
          "next": [
            202300020
          ]
        },
        "202300020": {
          "id": 202300020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ой-ой... что-то не так.",
          "next": [
            202300021
          ]
        },
        "202300021": {
          "id": 202300021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202300022
          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Хороший мальчик, не грызи кошелёк, там пусто. Собачкам нельзя есть что попало. Гав-гав-гав-гав!",
          "next": [
            202300023
          ]
        },
        "202300023": {
          "id": 202300023,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено]",
          "next": [
            202300024
          ]
        },
        "202300024": {
          "id": 202300024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Эй, ну зачем так ругаться? Гав-гав-гав! Слышишь? Щеночкам нельзя так выражаться. Гав-гав-гав-гав!",
          "next": [
            202300025
          ]
