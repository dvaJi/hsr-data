  "sections": [
    {
      "id": 2021100,
      "startingMessageId": [
        202110000
      ],
      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Дукс Первый, я готовлю программу своей первой экстремальной экспедиции.",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Ты ведь путешествовал{F#а} среди звёзд. Наверняка сможешь дать мне исчерпывающие рекомендации.",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Одна собираешься? И куда отправишься?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Если кто-то пожелает присоединиться, я не буду возражать.",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Куда отправишься?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Заглядывай на Звёздный экспресс.",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Возможно, он мог бы стать одной из остановок в моём путешествии, но пока отложим это на потом.",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Пункт назначения: Амфореус в будущем.",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "В былые дни на дорогах войны весь мир, что я помню, был погружён в бушующее пламя раздора и мёртвые воды чёрного течения.",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Когда семя Памяти взойдёт, Амфореус вернётся к жизни, и я смогу заняться исследованиями.",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Я хочу пройти на паруснике через воды Скианы, где без конца сражаются чёрные тучи и огромные волны.",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Слышал{F#а} о Ладоне? Там есть одна возвышенность, чьи горы достают до облаков.",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Я как раз стою перед выбором: полёт в костюме-крыле или прыжок с парашютом.",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Что посоветуешь?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "И так и так хорошо. Мне уже привычно прыгать, кружиться, и падать с небес в разные миры.",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Звучит неплохо.",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "В двух словах и не расскажешь... Но мне частенько приходилось падать с небес в разные миры.",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Попробуй.",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Звучит неплохо.",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Жизнь бесценна, так что будь осторожна!",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Не переживай, я не такая уж и хрупкая.",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Совсем недавно я прошла у кисы курс по выживанию в дикой природе, а ещё курс по плетению канатов у дукса Золотой Ткач.",
          "next": [
            202110022
          ]
        },
        "202110022": {
          "id": 202110022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Теперь меня ждёт курс по плаванию у дукса Знамя Клинков.",
          "next": [
            202110023
          ]
        },
        "202110023": {
          "id": 202110023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "До встречи, дукс Первый.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1412,
        8001
      ]
    }
  ]
}