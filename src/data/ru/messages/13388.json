          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Она очнулась.",
          "next": [
            133880101,
            133880105
          ]
        },
        "133880101": {
          "id": 133880101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "...Она в порядке?",
          "next": [
            133880102
          ]
        },
        "133880102": {
          "id": 133880102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            133880103
          ]
        },
        "133880103": {
          "id": 133880103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Она тоже первым делом задала этот вопрос.",
          "next": [
            133880104
          ]
        },
        "133880104": {
          "id": 133880104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "В порядке ли ты.",
          "next": [
            133880107
          ]
        },
        "133880105": {
          "id": 133880105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Кто?",
          "next": [
            133880106
          ]
        },
        "133880106": {
          "id": 133880106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Светлячок.",
          "next": [
            133880107
          ]
        },
        "133880107": {
          "id": 133880107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "С ней всё хорошо.",
          "next": [
            133880108
          ]
        },
        "133880108": {
          "id": 133880108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "С ней было то же самое, когда Кафка привела её.",
          "next": [
            133880109
          ]
        },
        "133880109": {
          "id": 133880109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Она постоянно теряет сознание, даже мехом управлять не может.",
          "next": [
            133880110
          ]
        },
        "133880110": {
          "id": 133880110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Прям проблема.",
          "next": [
            133880111
          ]
        },
        "133880111": {
          "id": 133880111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Но лечение помогает, не переживай.",
          "next": [
            133880112,
            133880115,
            133880120
          ]
        },
        "133880112": {
          "id": 133880112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Могу я с ней поговорить?",
          "next": [
            133880113
          ]
        },
        "133880113": {
          "id": 133880113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Подожди, пока она не сможет управлять мехом.",
          "next": [
            133880114
          ]
        },
        "133880114": {
          "id": 133880114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "На восстановление понадобится время.",
          "next": []
        },
        "133880115": {
          "id": 133880115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Когда мы сможем встретиться?",
          "next": [
            133880116
          ]
        },
        "133880116": {
          "id": 133880116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Не знаю. В сценарии нет подробностей.",
          "next": [
            133880117
          ]
        },
        "133880117": {
          "id": 133880117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "А не, погодь",
          "next": [
            133880118
          ]
        },
        "133880118": {
          "id": 133880118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Они есть, я их просто не понимаю",
          "next": [
            133880119
          ]
        },
        "133880119": {
          "id": 133880119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Говорится, что нужно подождать, пока не встретишься с собой лицом к лицу.",
          "next": []
        },
        "133880120": {
          "id": 133880120,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Поздравляю",
          "next": [
            133880121
          ]
        },
        "133880121": {
          "id": 133880121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            133880122
          ]
        },
        "133880122": {
          "id": 133880122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Лады",
          "next": [
            133880123
          ]
        },
        "133880123": {
          "id": 133880123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Я ей передам.",
          "next": []
        }
