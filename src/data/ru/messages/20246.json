{
  "id": 20246,
  "contacts": {
    "id": 1304,
    "name": "Авантюрин",
    "icon": "1304",
    "signature": "Делаю Прыжки за вас. Надёжно.",
    "typeId": 1,
    "type": "Персонаж"
  },
  "relatedMessages": [
    20133,
    20134,
