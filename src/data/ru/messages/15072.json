            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "Я видел, как Шерстила весь в слезах выбежал из кинозала и помчался в редакцию.",
