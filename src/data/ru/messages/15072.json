            150720103
          ]
        },
        "150720103": {
          "id": 150720103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Люблю, когда сюжет пронимает!",
          "next": [
            150720104
          ]
        },
        "150720104": {
          "id": 150720104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Да ещё Божественный Вуббабу в главной роли. Актёрище!",
          "next": [
            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "Верно! Да и насущные заботы супергероев отлично показаны. Тронули сердце шерстяки!",
          "next": [
            150720106
          ]
        },
        "150720106": {
          "id": 150720106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Кстати, кто-нибудь видел Шерстилу?",
