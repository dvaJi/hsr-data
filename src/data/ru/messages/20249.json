          "sender": "NPC",
          "senderContactId": 1503,
          "text": "В специальном выпуске «Пушистого скитальца» появляется новый персонаж.",
          "next": [
            202490002
          ]
        },
        "202490002": {
          "id": 202490002,
          "type": "Image",
