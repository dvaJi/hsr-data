  ],
  "sections": [
    {
      "id": 2025500,
      "startingMessageId": [
        202550000
      ],
      "messages": {
        "202550000": {
          "id": 202550000,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 241,
          "next": [
            202550001
          ]
        },
        "202550001": {
          "id": 202550001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Я снова здесь!",
          "next": [
            202550002
          ]
        },
        "202550002": {
          "id": 202550002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Пришлось попотеть, чтобы восстановить мой старый аккаунт, но это было не зря.",
          "next": [
            202550003
          ]
        },
        "202550003": {
          "id": 202550003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Хе-хе!",
          "next": [
            202550004,
            202550005,
            202550006
          ]
        },
        "202550004": {
          "id": 202550004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Стоп, а почему это звёзд уже пять?",
          "next": [
            202550007
          ]
        },
        "202550005": {
          "id": 202550005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Удалось отделаться от толпы кредиторов?",
          "next": [
            202550009
          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Хе-хе... Как успехи? Выяснилось, что на этом счёте есть средства для погашения долга?",
          "next": [
            202550011
          ]
        },
        "202550007": {
          "id": 202550007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Чем больше, тем лучше. А пять звёзд - отличная оценка!",
          "next": [
            202550008
          ]
        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "И то верно. Это сгладит отдельные негативные отзывы от кредиторов.",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Нет, но я постараюсь оправдать их ожидания.",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Так это были ожидания?",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "В точку, протеже.",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ценность архива этого аккаунта сопоставима с результатами работы за последние десять лет.",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Едкие комментарии Идущих по Пути о своих Эонах, случайно сохранённые сплетни и изображения - настоящий эксклюзив!",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Как же меня угораздило потерять этот аккаунт...",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Хватит болтовни! Пересылай скорее.",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Опять будешь рисовать свои небылицы?",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Госпожа Штрих-кошка, нам нужен новый контент!",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Не спеши. Вот, лови.",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Не такая уж небылица.",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Я хочу сказать, что мыслю не так узко! Небылицы, конечно, интереснее, когда они про других. Например...",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "В этот раз столько материалов накопилось! Кажется, я откопала свежие сведения для «Аромата целебных благовоний»...",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Вот, лови пока это.",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Сотни янтарных эр назад один Фикциолог истории оставил предсмертное послание...",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«Тайззиронт ползал, преодолевая тысячи километров в день, и всё ради одной безымянной планеты...»",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«А между тем неподалёку от того небесного тела в укромном уголке притаились Эна и Шипе...»",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«Вдруг они столкнулись с Ороборос. Боги схлестнулись: напряжение росло, искры летели во все стороны - и всё из-за одной персоны...»",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«Аха - вот кто это был».",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не льсти себе, Аха!",
          "next": [
            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Да это же просто твои выдумки! Опять ты за старое!",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Честно говоря, всё это немного надоело. Есть что-нибудь посвежее?",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Всё-таки договорю. Вот что Фикциолог не успел узнать: «Боги нацелились на безымянную планету, потому что...»",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«Там хранились ранние сценарии, иллюстрации и фанфики Ахи - плоды его ранних упражнений».",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "«Он хотел пустить там корни. Попировать как следует. А Эоны желали лишь завладеть...»",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Хи-хи, это ведь и правда мои эскизики.",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "В заметках есть ещё несколько готовых, сейчас пришлю тебе на оценку.",
          "next": [
            202550036
          ]
        },
        "202550036": {
          "id": 202550036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Не буду томить, а то вдруг на балансе ничего не останется.",
          "next": [
            202550037
          ]
        },
        "202550037": {
          "id": 202550037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202550038
          ]
        },
        "202550038": {
          "id": 202550038,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Заблокировано системой.",
          "next": [
            202550039,
            202550040
          ]
        },
        "202550039": {
          "id": 202550039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Контент слишком крутой? Или деньги на смартфоне закончились?!",
          "next": [
            202550041
          ]
        },
        "202550040": {
          "id": 202550040,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Контент слишком крутой? Или деньги на смартфоне закончились?!",
          "next": [
            202550041
          ]
        },
        "202550041": {
          "id": 202550041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Ошибка отправки сообщения.",
          "next": [
            202550042
          ]
        },
        "202550042": {
          "id": 202550042,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "На этом аккаунте обнаружена аномальная активность. Выявлены мошеннические действия. Аккаунт заблокирован.",
          "next": []
        }
      },
      "participatingContactsIds": [
        241,
        8001
      ]
    }
  ]
}