      "messages": {
        "150670100": {
          "id": 150670100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Много говорить не буду.",
          "next": [
            150670101
          ]
        },
        "150670101": {
          "id": 150670101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Спасибо, что {M#справился}{F#справилась} с делом. Блэйд тоже передаёт «спасибо».",
          "next": [
            150670102,
            150670103
          ]
        },
        "150670102": {
          "id": 150670102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Вам тоже спасибо, ребят.",
          "next": [
            150670104
          ]
        },
        "150670103": {
          "id": 150670103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Всегда пожалуйста! Всё ради вселенной!",
          "next": [
            150670104
          ]
        },
        "150670104": {
          "id": 150670104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Тебе не говорили, что ты каждый день становишься всё пафоснее?",
          "next": [
            150670105
          ]
        },
        "150670105": {
          "id": 150670105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "@Блэйд, ты тоже скажи пару слов.",
          "next": [
            150670106
          ]
        },
        "150670106": {
          "id": 150670106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Спасибо.",
          "next": [
            150670107
          ]
        },
        "150670107": {
          "id": 150670107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Скажи ещё что-нибудь, не стесняйся.",
          "next": [
            150670108
          ]
        },
        "150670108": {
          "id": 150670108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ещё что-нибудь.",
          "next": [
            150670109
          ]
        },
        "150670109": {
          "id": 150670109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            150670110
          ]
        },
        "150670110": {
          "id": 150670110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Так перенервничал, что даже шутить начал.",
          "next": [
            150670111
          ]
        },
        "150670111": {
          "id": 150670111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Кстати, {NICKNAME}... Подарок, который я вручила тебе при отправлении, уже весь израсходован.",
          "next": [
            150670112,
            150670113
          ]
        },
        "150670112": {
          "id": 150670112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Стелларон?",
          "next": [
            150670114
          ]
        },
        "150670113": {
          "id": 150670113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Что случилось?",
          "next": [
            150670114
          ]
        },
        "150670114": {
          "id": 150670114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Элио думал, что сможет его растянуть ещё на какое-то время. И вот, прямо на этой самой остановке...",
          "next": [
            150670115
          ]
        },
        "150670115": {
          "id": 150670115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Но какую цену придётся заплатить?",
          "next": [
            150670117,
            150670116
          ]
        },
        "150670116": {
          "id": 150670116,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Не волнуйся, всё будет в порядке.",
          "next": [
            150670118
          ]
        },
        "150670117": {
          "id": 150670117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я разберусь по ходу дела, не волнуйся.",
          "next": [
            150670118
          ]
        },
        "150670118": {
          "id": 150670118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Ладно, как знаешь. Если что, Альфа всегда готова помочь.",
          "next": []
        }
      },
