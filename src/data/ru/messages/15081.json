        "150810101": {
          "id": 150810101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "«{F#Великой Безымянной}{M#Великому Безымянному}, {F#вершительнице}{M#вершителю}судеб эфемеров...»",
          "next": [
