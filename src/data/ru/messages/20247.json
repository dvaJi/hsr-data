      "messages": {
        "202470000": {
          "id": 202470000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Обнаружен предполагаемый сигнал SOS: после обнаружения опасности Авантюрин вызвал экстренные службы из этого приблизительного местоположения. Вы получили это сообщение потому, что являетесь ближайшим к Авантюрину экстренным контактом в списке контактов.",
          "next": [
            202470001
          ]
        },
        "202470001": {
          "id": 202470001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: текущее местоположение Авантюрина передано",
          "next": [
            202470002
          ]
        },
        "202470002": {
          "id": 202470002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: пульс Авантюрина приближается к 20, немедленно вызовите помощь!",
          "next": [
            202470003,
            202470004,
            202470005
          ]
        },
        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Этот пульс ненормальный! Не пугай меня, Авантюрин! Держись, я уже иду!",
          "next": [
            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Этот пульс ненормальный! Авантюрин!!! Я спасу тебя!",
          "next": [
            202470006
          ]
        },
        "202470005": {
          "id": 202470005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Это же ненормальный пульс?! Корпорация! Сохранение! Повелитель Янтаря! Мать-богиня! Помогите же!",
          "next": [
            202470006
          ]
        },
        "202470006": {
          "id": 202470006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: текущее местоположение Авантюрина изменилось",
          "next": [
            202470007
          ]
        },
        "202470007": {
          "id": 202470007,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: обнаружено, что Авантюрин испытывает резкий перепад высот и сверхвысокое давление воды",
          "next": [
            202470008
          ]
        },
        "202470008": {
          "id": 202470008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: пульс Авантюрина достиг 180 ударов в минуту. Немедленно вызовите помощь!",
          "next": [
            202470009
          ]
        },
        "202470009": {
          "id": 202470009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: текущее местоположение Авантюрина изменилось",
          "next": [
            202470010
          ]
        },
        "202470010": {
          "id": 202470010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Экстренный сигнал SOS: пульс Авантюрина составляет 20 ударов в минуту, немедленно вызовите помощь!",
          "next": [
            202470011,
            202470013
          ]
        },
        "202470011": {
          "id": 202470011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Так его надо спасать или нет? Мне спасать? Или?..",
          "next": [
            202470012
          ]
        },
        "202470012": {
          "id": 202470012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Авантюрин! Скажи что-нибудь, если жив!",
          "next": [
            202470015
          ]
        },
        "202470013": {
          "id": 202470013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "То 20, то 180 - это больше похоже на мой пульс, честное слово.",
          "next": [
            202470014
          ]
        },
        "202470014": {
          "id": 202470014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ты что, на американских горках катаешься! Скажи что-нибудь, если жив!",
          "next": [
            202470015
          ]
        },
        "202470015": {
          "id": 202470015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202470016
          ]
        },
        "202470016": {
          "id": 202470016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Что-нибудь, что-нибудь, что-нибудь! Успокойся, со мной всё в порядке. Я просто сёрфил. Подожди, выйду на берег и всё объясню.",
          "next": [
            202470017
          ]
        },
        "202470017": {
          "id": 202470017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Преобразование голосового сообщения завершено]",
          "next": [
            202470018
          ]
        },
        "202470018": {
          "id": 202470018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202470019
          ]
        },
        "202470019": {
          "id": 202470019,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Приблизительное местоположение Авантюрина изменено",
          "next": [
            202470020
          ]
        },
        "202470020": {
          "id": 202470020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Сейчас",
          "next": [
            202470021
          ]
        },
        "202470021": {
          "id": 202470021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Надо же, часы такие заботливые! Подумаешь, волна всего-то в 50 метров высотой.",
          "next": [
            202470022,
            202470023
          ]
        },
        "202470022": {
          "id": 202470022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "50 метров - это уже уровень аварийной тревоги! У тебя пульс то 20, то 180!",
          "next": [
            202470024
          ]
        },
        "202470023": {
          "id": 202470023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Разве пульс при сёрфинге может скакать от 20 до 180?!",
          "next": [
            202470024
          ]
        },
        "202470024": {
          "id": 202470024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Меня это выдало?",
          "next": [
            202470025
          ]
        },
        "202470025": {
          "id": 202470025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Не волнуйся, пульс 20 был, когда я был под волной и задерживал дыхание.",
          "next": [
            202470026
          ]
        },
        "202470026": {
          "id": 202470026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Даже если он подскочит до 180, это всё равно не так высоко, как было во время нашей ночной битвы в Пенаконии.",
          "next": [
            202470027
          ]
        },
        "202470027": {
          "id": 202470027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ха-ха, шучу. Прости, что тебе пришлось поволноваться.",
          "next": [
            202470028
          ]
        },
        "202470028": {
          "id": 202470028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Я испытываю новейшую парящую доску.",
          "next": [
            202470029
          ]
        },
        "202470029": {
          "id": 202470029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ощущение невесомости при падении с гребня огромной волны - настоящий азарт, от которого невозможно отказаться.",
          "next": [
            202470030
          ]
        },
        "202470030": {
          "id": 202470030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Печатает...",
          "next": [
            202470031
          ]
        },
        "202470031": {
          "id": 202470031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Какая удача, волна снова пришла!",
          "next": [
            202470032
          ]
        },
        "202470032": {
          "id": 202470032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Я пошёл.",
          "next": [
            202470033
          ]
        },
        "202470033": {
          "id": 202470033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "В следующий раз возьму тебя с собой!",
          "next": [
            202470034
          ]
        },
        "202470034": {
          "id": 202470034,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Текущее местоположение Авантюрина изменено",
          "next": []
        }
      },
