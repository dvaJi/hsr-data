            202030014,
            202030016,
            202030018
          ]
        },
        "202030014": {
          "id": 202030014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Но я увидел{F#а} небо, оно тоже красивое.",
          "next": [
            202030015
          ]
        },
        "202030015": {
          "id": 202030015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Серебряшка, ты {F#такая добрая}{M#такой добрый}.",
          "next": [
            202030020
          ]
        },
        "202030016": {
          "id": 202030016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я всё увидел{F#а}, описание у тебя вышло очень выразительное.",
          "next": [
            202030017
          ]
        },
        "202030017": {
          "id": 202030017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Серебряшка, ты {F#такая добрая}{M#такой добрый}.",
