          ]
        },
        "202050007": {
          "id": 202050007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Может, она в купальне?",
          "next": [
            202050008
          ]
        },
        "202050008": {
          "id": 202050008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Нужно найти кису?",
          "next": [
