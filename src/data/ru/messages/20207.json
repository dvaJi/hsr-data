      "messages": {
        "202070000": {
          "id": 202070000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "{F#Напарница}{M#Напарник}! Помнишь наше обещание?",
          "next": [
            202070001
          ]
        },
        "202070001": {
          "id": 202070001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Насчёт концовки «Легенды о звёздном море».",
          "next": [
            202070002,
            202070004,
            202070005
          ]
        },
        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Конечно, помню. Но я всё же рекомендую тебе прочитать самому.",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Очень интересно. Не хочу спойлерить.",
          "next": [
            202070006
          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Может, ты сам прочитаешь? Очень интересно. Не хочу спойлерить.",
          "next": [
            202070006
          ]
        },
        "202070005": {
          "id": 202070005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Я ещё не дочитал{F#а}.",
          "next": [
            202070006
          ]
        },
        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Вообще-то я и сам не удержался и подсмотрел концовку.",
          "next": [
            202070007
          ]
        },
        "202070007": {
          "id": 202070007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Путешествуя во времени, герои плечом к плечу победили последнего монстра, но монстр использовал силу и перенёс их в другой мир, где им пришлось начать новую жизнь.",
          "next": [
            202070008
          ]
        },
        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Мне так хочется узнать, что же произошло дальше, но на этом история заканчивается!",
          "next": [
            202070009
          ]
        },
        "202070009": {
          "id": 202070009,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070010,
            202070012,
            202070014
          ]
        },
        "202070010": {
          "id": 202070010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Это никуда не годится!",
          "next": [
            202070011
          ]
        },
        "202070011": {
          "id": 202070011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Вот и ты тоже так думаешь!",
          "next": [
            202070016
          ]
        },
        "202070012": {
          "id": 202070012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Хм, может, ты допишешь?",
          "next": [
            202070013
          ]
        },
        "202070013": {
          "id": 202070013,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070016
          ]
        },
        "202070014": {
          "id": 202070014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Оставить читателю простор для воображения - один из литературных приёмов.",
          "next": [
            202070015
          ]
        },
        "202070015": {
          "id": 202070015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Да уж, и он сработал!",
          "next": [
            202070016
          ]
        },
        "202070016": {
          "id": 202070016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Впрочем, это так же и стимул прочесть следующую книгу.",
          "next": [
            202070017
          ]
        },
        "202070017": {
          "id": 202070017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "{F#Напарница}{M#Напарник}, может, в последнее время тебе встречалось что-нибудь интересное? У меня книжный голод.",
          "next": [
            202070018,
            202070021,
            202070023
          ]
        },
        "202070018": {
          "id": 202070018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Настоятельно рекомендую детективный роман, написанный Март 7.",
          "next": [
            202070019
          ]
        },
        "202070019": {
          "id": 202070019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ты в жизни не догадаешься, кто убийца. Ты даже не догадаешься, сколько их.",
          "next": [
            202070020
          ]
        },
        "202070020": {
          "id": 202070020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Отправлю тебе ссылку чуть позже.",
          "next": [
            202070025
          ]
        },
        "202070021": {
          "id": 202070021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Настоятельно рекомендую фанфики госпожи Кастории.",
          "next": [
            202070022
          ]
        },
        "202070022": {
          "id": 202070022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "У неё совершенно особенный стиль, некоторые главы просто потрясают.",
          "next": [
            202070025
          ]
        },
        "202070023": {
          "id": 202070023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Среди книг Амфореуса тоже встречается немало удивительных произведений.",
          "next": [
            202070024
          ]
        },
        "202070024": {
          "id": 202070024,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Мне нужно немного освежить память, чуть позже я отправлю тебе список.",
          "next": [
            202070025
          ]
        },
        "202070025": {
          "id": 202070025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ладно! Жду не дождусь.",
          "next": [
            202070026
          ]
        },
        "202070026": {
          "id": 202070026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Если найду что-нибудь интересное, я с тобой поделюсь.",
          "next": [
            202070027
          ]
        },
