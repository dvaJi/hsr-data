        },
        "202540005": {
          "id": 202540005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Нигилюкса? Разве ты не изображала собственное таинственное исчезновение?",
          "next": [
            202540008
          ]
        },
        "202540006": {
          "id": 202540006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "И денег нет, чтоб долги оплатить, да?",
