  "sections": [
    {
      "id": 2024300,
      "startingMessageId": [
        202430000
      ],
      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, je revenais de la plage à l'instant et j'ai enregistré de nouveaux samples sonores !",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Comme des noix de coco qui roulent sur le sol, le soda qui pétille et bouillonne, les calamars qui grésillent sur la plaque chauffante...",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie est en train d'écrire...",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu m'as donné faim du coup. Je mangerais bien deux brochettes de calamars",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Honnêtement, moi aussi...",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cette musique sent tellement bon... je veux dire, ce calamar est incroyable",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, comparé au néant que je ressens quand je manque d'inspiration, ce coup de fouet de saveur me réveille vraiment !",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "En fait, j'ai d'autres extraits musicaux avec une ambiance bord de mer plus marquée. Tiens écoute",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Celui-là, c'est quand la marée se retire : shhhh-shhhh — glou-glou-glou...",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte (son de bulle détecté)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Quand la brise marine souffle à travers un ancrage rouillé : whoosh — humm — whoosh — humm...",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte (voix grave détectée)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Les mouettes qui passent : flap - flap — ah — ah — AHH !",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte (cris d'oiseaux détectés)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Pardon, ce « AHH ! » c'était moi... Une mouette vient de me voler mon sandwich...",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "J'ai assez d'échantillons maintenant, mais j'ai l'impression qu'il manque encore quelque chose... quelque chose qui touche le cœur...",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, tu aurais des idées de sons capables de remonter le moral en un instant ?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Écoute un peu le vrombissement de l'Astral Express pendant le saut !",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le destinataire a reçu la pièce jointe « Vrombissement_de_saut.mp3 »",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ce son, si symbolique de l'exploration, me touche au plus profond",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Écoutez un peu l'alarme que j'ai mise comme réveil !",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le destinataire a reçu la pièce jointe « Réveil.mp3 »",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "J'ai eu une petite crise cardiaque... oui, c'est une façon de toucher l'âme, je suppose",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mais pour le bien de nos auditeurs, mieux vaut descendre d'une octave",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Écoute un peu le chant de mon âme !",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le destinataire a reçu la pièce jointe « Chant_sous_la_douche.mp3 »",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "C'est toi qui chantes ? C'est... assez touchant",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hmm... Je pense que je peux essayer de mixer ça !",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Improvise maintenant ! Prends la partition, mets-la de côté. Laisse-toi aller ! Nous ne sommes plus de simples rouages figés...",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte (voix originale détectée)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Le remix de <i>Only by Chasing the Wind</i>. Avec cet extrait qui « touche l'âme » et la piste de fond avec la brise marine, tu ne trouves pas que ça donne vraiment une ambiance estivale ?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Oh ! L'inspiration vient de me frapper. Je retourne en studio d'enregistrement.",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Merci pour toutes tes merveilleuses idées !",
          "next": [
            202430033
          ]
        },
        "202430033": {
          "id": 202430033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
