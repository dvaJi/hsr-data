  "sections": [
    {
      "id": 2023000,
      "startingMessageId": [
        202300000
      ],
      "messages": {
        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Je ne savais pas qu'une créature aussi adorable pouvait exister dans ce monde !",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ses pattes sont super douces, et il sent le riz frais !",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Dommage que mon appareil photo soit cassé, j'aurais pu prendre ce petit ange en photo.",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "N'est-ce pas ! Les chiots rendent le monde meilleur !",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu as un chien ? Je peux venir le caresser ?",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Malheureusement, c'est le chien de mon client.",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{M#Désolé}{F#Désolée}, je préfère les chats.",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, je vois.",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Une personnalité importante, dont l'identité reste confidentielle, a reçu une lettre de menace anonyme ce matin.",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ça ne contenait que quatre mots : « Tes jours sont comptés. »",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Je n'ai pas hésité une seconde et j'ai accepté la mission sur-le-champ.",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Maintenant, plus personne n'ose toucher à ce chiot.",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "La lettre n'était peut-être pas destinée au chien...?",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, tu fais référence au client ? Bien sûr que je suis au courant. Pas de stress, N est en route pour le protéger.",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Le chiot a plus besoin de moi que mon client.",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "On dirait que c'est plutôt toi qui en as besoin.",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pourquoi ne pas adopter ton propre chien ? Ça t'éviterait de profiter de ceux des autres tout le temps.",
          "next": [
            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hé !!! Je le ferais si j'avais les moyens d'acheter de la nourriture pour chien.",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Mon client dit que les chiens coûtent une fortune... Je ne peux pas laisser ce petit souffrir avec moi.",
          "next": [
            202300019
          ]
        },
        "202300019": {
          "id": 202300019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1504,
          "next": [
            202300020
          ]
        },
        "202300020": {
          "id": 202300020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ah, attends une seconde.",
          "next": [
            202300021
          ]
        },
        "202300021": {
          "id": 202300021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202300022
          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Allez, le chien, lâche mon portefeuille. Il n'y a rien dedans de toute façon. Tu n'es pas censé manger n'importe quoi. Ouaf ouaf ouaf ouaf !",
          "next": [
            202300023
          ]
        },
        "202300023": {
          "id": 202300023,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
            202300024
          ]
        },
        "202300024": {
          "id": 202300024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hé, oh ! C'est quoi ce langage ? Ouaf ouaf ouaf ! Tu m'entends ? Les chiots ne disent pas de gros mots. Ouaf ouaf ouaf ouaf !",
          "next": [
            202300025
          ]
        },
        "202300025": {
          "id": 202300025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
            202300026
          ]
        },
        "202300026": {
          "id": 202300026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ouaf ouaf ouaf, mon argent ouaf ouaf ouaf ! Ouaf ouaf ouaf ouaf !",
          "next": [
            202300027
          ]
        },
        "202300027": {
          "id": 202300027,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
            202300028
          ]
        },
        "202300028": {
          "id": 202300028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Pas d'aboiements, toutou ! Ouaf ouaf ouaf ouaf ouaf !",
          "next": [
            202300029
          ]
        },
        "202300029": {
          "id": 202300029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
            202300030
          ]
        },
        "202300030": {
          "id": 202300030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "N, ouaf ouaf ouaf ouaf ouaf ouaf ouaf ouaf ouaf !",
          "next": [
            202300031
          ]
        },
        "202300031": {
          "id": 202300031,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
            202300032
          ]
        },
        "202300032": {
          "id": 202300032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ouaf ouaf ouaf ouaf ouaf ouaf ouaf ouaf ouaf !",
          "next": [
            202300033
          ]
        },
        "202300033": {
          "id": 202300033,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte",
          "next": [
