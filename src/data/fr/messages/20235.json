        "202350012": {
          "id": 202350012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Désolé{F#e} pour ta cuisse, mais c'est auprès de Louve d'argent qu'il faut se plaindre.",
