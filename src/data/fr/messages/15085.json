      ],
      "messages": {
        "150850100": {
          "id": 150850100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bonjour, bon après-midi et bonsoir ! Une nouvelle journée à être en vie...",
          "next": [
            150850101
          ]
        },
        "150850101": {
          "id": 150850101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Je ne m'attendais vraiment pas à trouver des pages arrachées des <i>Chroniques des graisses flottantes</i> ici, à Astropolis",
          "next": [
            150850102,
            150850106,
            150850109
          ]
        },
        "150850102": {
          "id": 150850102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est vrai, qui l'eût cru !",
          "next": [
            150850103
          ]
        },
        "150850103": {
          "id": 150850103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ça nous fait encore plus de choses à collectionner.",
          "next": [
            150850104
          ]
        },
        "150850104": {
          "id": 150850104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, mais c'est une bonne chose, non ?",
          "next": [
            150850105
          ]
        },
        "150850105": {
          "id": 150850105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Grâce à monsieur Arita et aux autres, on a de quoi s'occuper par ici",
          "next": [
            150850114
          ]
        },
        "150850106": {
          "id": 150850106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je croyais que c'était un ancien ouvrage de Planarcadia ?",
          "next": [
            150850107
          ]
        },
        "150850107": {
          "id": 150850107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Qu'est-ce qu'il fait à Astropolis ?",
          "next": [
            150850108
          ]
        },
        "150850108": {
          "id": 150850108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, on peut dire que c'est grâce à monsieur Arita et sa bande !",
          "next": [
            150850114
          ]
        },
        "150850109": {
          "id": 150850109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "... Vous m'espionnez ?",
          "next": [
            150850110
          ]
        },
        "150850110": {
          "id": 150850110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ce message arrive vraiment pile au bon moment",
          "next": [
            150850111
          ]
        },
        "150850111": {
          "id": 150850111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ah ça, c'est tout simplement parce que j'ai l'appareil de détection des <i>Chroniques des graisses flottantes</i> !",
          "next": [
            150850112
          ]
        },
        "150850112": {
          "id": 150850112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Vous êtes probablement {M#le seul}{F#la seule} à prendre la peine de les rassembler pour moi",
          "next": [
            150850113
          ]
        },
        "150850113": {
          "id": 150850113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Je ne vais tout de même pas aller demander directement à monsieur Arita, si ?",
          "next": [
            150850114
          ]
        },
        "150850114": {
          "id": 150850114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Monsieur Arita ?",
          "next": [
            150850115
          ]
        },
        "150850115": {
          "id": 150850115,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Quel est le rapport avec lui ?",
          "next": [
            150850116
          ]
        },
        "150850116": {
          "id": 150850116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Vous ne saviez pas qu'un cadre dirigeant, on ne sait pas trop lequel d'ailleurs, a créé un environnement où les Imagenae peuvent survivre à Astropolis ?",
          "next": [
            150850117
          ]
        },
        "150850117": {
          "id": 150850117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Toutes sortes d'Imagenae liés à Astropolis ont commencé à apparaître par la suite",
          "next": [
            150850118
          ]
        },
        "150850118": {
          "id": 150850118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Et parmi eux, il y a justement ce livre qui nous intéresse",
          "next": [
            150850119
          ]
        },
        "150850119": {
          "id": 150850119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "D'ailleurs, il paraît que monsieur Arita s'intéresse lui aussi de très près à cet ouvrage",
          "next": [
            150850120
          ]
        },
        "150850120": {
          "id": 150850120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bref, il faudrait qu'on se voie à l'occasion.",
          "next": [
            150850121
          ]
        },
        "150850121": {
          "id": 150850121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ce n'est pas tous les jours que vous venez à Astropolis, autant en profiter pour retrouver de vieilles connaissances",
          "next": []
        }
      },
      "participatingContactsIds": [
        205,
