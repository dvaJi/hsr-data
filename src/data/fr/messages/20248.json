  "sections": [
    {
      "id": 2024800,
      "startingMessageId": [
        202470035
      ],
      "messages": {
        "202470035": {
          "id": 202470035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Vite ! Réponds-moi en trois secondes !",
          "next": [
            202470036
          ]
        },
        "202470036": {
          "id": 202470036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Rouge ou bleu ?",
          "next": [
            202470037,
            202470038,
            202470039
          ]
        },
        "202470037": {
          "id": 202470037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rouge !",
          "next": [
            202470040
          ]
        },
        "202470038": {
          "id": 202470038,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bleu !",
          "next": [
            202470040
          ]
        },
        "202470039": {
          "id": 202470039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ciseaux !",
          "next": [
            202470041
          ]
        },
        "202470040": {
          "id": 202470040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Je le savais.",
          "next": [
            202470043
          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Je savais que tu ne jouerais pas selon les règles, mais cette manche ne laisse que deux options",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Je vais en choisir une pour toi. Je suis sûr qu'on est sur la même longueur d'onde",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sur quoi tu paries cette fois ?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Il y a un gamin qui tourne autour de mon parasol depuis un moment",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Je le croyais perdu, mais en réalité, il avait les yeux rivés sur le sable sous mes pieds",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Il m'a dit que j'avais le sable le plus fin de toute la plage, et que seul un sable comme celui-là pouvait servir à bâtir les châteaux de sable les plus solides",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Mais le gamin est assez intéressant. Il ne m'a pas demandé de simplement céder ma place",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Il a proposé un pari : il y a deux crabes devant nous, un rouge et un bleu, on parie sur celui qui franchira la ligne d'arrivée en premier",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "S'il gagne, il a son sable parfait",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je sais que tu aimes les paris, mais bon c'est juste un enfant...",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pas étonnant que tu m'aies demandé de choisir. Chaque pari que tu fais toi-même est toujours gagné d'avance",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Et si on gagne le pari ?",
          "next": [
            202470054
          ]
        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Eh bien, je t'invite à parier",
          "next": [
            202470054
          ]
        },
        "202470054": {
          "id": 202470054,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202470055
          ]
        },
        "202470055": {
          "id": 202470055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Attends, ce crabe est sur le point de franchir la ligne d'arrivée",
          "next": [
            202470056
          ]
        },
        "202470056": {
          "id": 202470056,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "On a gagné",
          "next": [
            202470057
          ]
        },
        "202470057": {
          "id": 202470057,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202470068
          ]
        },
        "202470058": {
          "id": 202470058,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Récupère son goûter",
          "next": [
            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Prends-lui une pelle pour faire des châteaux",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Une bague",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Le gamin a dit que les adultes n'ont pas besoin de pelles en plastique ou de goûters, mais si la mise n'est pas équitable, le jeu ne l'est pas non plus",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Alors, il m'a offert une bague magique capable de dévorer les cauchemars",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Trop mignon. Un trésor en édition limitée, exactement ce qu'il me faut",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Je vais lui offrir une glace super deluxe à 9 boules",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ensuite, je vais lui proposer d'investir dans la construction de châteaux de sable",
          "next": [
            202470066
          ]
        },
        "202470066": {
          "id": 202470066,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202470067
          ]
        },
        "202470067": {
          "id": 202470067,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Allez à plus. On va remuer du sable",
          "next": []
        },
        "202470068": {
          "id": 202470068,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Devine ce qu'il a perdu contre moi ?",
          "next": [
            202470058,
            202470059
          ]
        }
      },
      "participatingContactsIds": [
        1304,
        8001
      ]
    }
  ]
}