          ]
        },
        "201970003": {
          "id": 201970003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La pièce jointe <i>Livre de cuisine d'Aidonia : Comment redonner vie aux morts</i> a été envoyée",
          "next": [
            201970004
          ]
        },
        "201970004": {
          "id": 201970004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La pièce jointe <i>Les papilles inaccessibles de Janus</i> a été envoyée",
          "next": [
            201970005
          ]
        },
        "201970005": {
          "id": 201970005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "J'ai envie de me lancer un petit défi",
          "next": [
            201970006
          ]
        },
        "201970006": {
          "id": 201970006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Tu veux aller manger un bout ?",
          "next": [
            201970007,
            201970008,
            201970010
          ]
        },
        "201970007": {
          "id": 201970007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oui, chef. Je mangerai n'importe quoi",
          "next": [
            201970012
          ]
        },
        "201970008": {
          "id": 201970008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je peux manger tous les plats que tu as envoyés, chef ?",
          "next": [
            201970009
          ]
        },
        "201970009": {
          "id": 201970009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Si tu peux tout manger, fais-toi plaisir",
          "next": [
            201970012
          ]
        },
        "201970010": {
          "id": 201970010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alors je laisse le chef Mydei s'occuper de tout !",
          "next": [
            201970011
          ]
        },
        "201970011": {
          "id": 201970011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Très bien",
          "next": [
            201970012
          ]
        },
        "201970012": {
          "id": 201970012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Commençons par <i>Dîner nocturne d'Acrokopis</i>",
          "next": [
            201970013
          ]
        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Même si j'ai essayé toutes les recettes et tous les styles du menu, la cuisine acrokopienne est définitivement ma spécialité",
          "next": [
            201970014,
            201970015,
            201970016
          ]
        },
        "201970014": {
          "id": 201970014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comme le tartare de cœur de cerf ?",
          "next": [
            201970017
          ]
        },
        "201970015": {
          "id": 201970015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comme les cuisses de lézard grillées ?",
          "next": [
            201970017
          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'imagine qu'à la longue, on finit par apprécier ça ?",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "On dirait que tu te trompes complètement sur nous, les Acrokopiens",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ce n'étaient que des coutumes dépassées, utilisées par les Acrokopiens pour tester les guerriers. J'ai aboli ça il y a bien longtemps",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "De nos jours, la cuisine acrokopienne met l'accent sur une alimentation saine et équilibrée",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Elle a également intégré les meilleurs éléments provenant d'autres cultures culinaires, afin de créer quelque chose de neuf et de perfectionné",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Quels sont tes goûts ?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'adore les choses qui ne s'apprécient qu'avec le temps",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Alors, optons pour les côtes d'agneau des nuages braisées à la sauce soja. C'est parfait pour faire le plein de sel et stimuler l'appétit. Idéalement, ça s'accompagne d'un bon jus de grenade",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'aimerais de la nourriture normale",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "De la pâte de haricots aigre-douce, accompagnée d'un gâteau au miel à la grenade. C'est un combo gagnant, ça ne rate jamais",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Si ça n'a pas un goût bizarre, je n'y touche pas",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Dans ce cas, le poisson en conserve de la Rivière des âmes pourrait te plaire",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Je l'utilise rarement pour cuisiner",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ou alors, je pourrais aller chercher de la viande qui a été conservée pendant plus de dix ans",
          "next": [
            201970030
          ]
        },
        "201970030": {
          "id": 201970030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Cette odeur te hantera pour toujours, c'est certain",
          "next": [
            201970031
          ]
        },
        "201970031": {
          "id": 201970031,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1404,
          "next": [
            201970032
          ]
        },
        "201970032": {
          "id": 201970032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Il y a un dicton populaire à Acrokopis : « Un soldat qui souhaite devenir général doit d'abord être un excellent cuisinier »",
          "next": [
            201970033
          ]
        },
        "201970033": {
          "id": 201970033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Alors, fais confiance à mes talents de cuisinier et de mariage des saveurs",
          "next": [
            201970034
          ]
        },
        "201970034": {
          "id": 201970034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Bon appétit !",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1404
      ]
    }
  ]
}