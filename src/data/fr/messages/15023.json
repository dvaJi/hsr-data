        },
        "150230108": {
          "id": 150230108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Comment osent-ils ajouter une si piètre imitation qui dépeint aussi arbitrairement la défaite de Mercator",
