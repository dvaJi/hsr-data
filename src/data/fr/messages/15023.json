        },
        "150230106": {
          "id": 150230106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Parmi elles se trouvait une copie piratée de <i>Jeu du labyrinthe</i> qui ressemblait fortement à l'original",
