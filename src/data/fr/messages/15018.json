        "150180100": {
          "id": 150180100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Oh, bonté divine ! Je te remercie pour cette misérable vie que tu m'as accordée, juste assez longue pour terrasser ma dernière proie.",
          "next": [
            150180101
          ]
        },
        "150180101": {
          "id": 150180101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Accorde-moi encore un instant dans ce monde... Moi, Kendor, j'ai déjà passé toute une vie à sommeiller...",
          "next": [
            150180102
          ]
        },
        "150180102": {
          "id": 150180102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Merci de m'avoir réveillé, {NICKNAME}.",
          "next": [
            150180103
          ]
        },
        "150180103": {
          "id": 150180103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Sans ton arrivée, j'aurais sûrement sombré dans le sommeil sans fin pour de bon.",
          "next": [
            150180104
          ]
        },
        "150180104": {
          "id": 150180104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "{NICKNAME}, je suis celui qu'on appelle « l'Ancien ». Et je vais te montrer le véritable visage funeste.",
          "next": [
            150180105
          ]
        },
        "150180105": {
          "id": 150180105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Viens. Trouve-moi. Tu es l'exquise proie finale que j'attendais.",
