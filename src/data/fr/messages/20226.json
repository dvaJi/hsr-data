        },
        "202260021": {
          "id": 202260021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Huit chemins mènent au succès... Madame Yao, la fortune va forcément vous sourire demain !",
          "next": [
            202260024
