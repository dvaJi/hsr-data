      "messages": {
        "145410101": {
          "id": 145410101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "On dirait que tu as activé l'ensemble des environnements",
          "next": [
            145410102
          ]
        },
        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Comment s'est passée ton expérience en tant que {M#spectateur}{F#spectatrice} ?",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "L'arène ne manquait pas de surprise. Amusant est le mot",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "C'est précisément là que réside tout l'attrait de la sélection naturelle",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Dans un environnement en perpétuelle mutation, il n'existe pas de « solution de vie optimale »",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ce ne sont que des petites bêtes qui courent partout, j'en ai déjà vu plein",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "D'accord",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Au moins, tu as été témoin de l'exploration et des choix de la vie au sein d'un environnement qui leur était étranger",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "L'objectif est peut-être dénué de sens, mais ça ne suffit pas on dirait",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Tu t'en es très bien sorti{F#e}",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "J'ai mis de côté quelques récompenses que tu peux récupérer à tout moment",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Toute peine mérite salaire. C'est mon dû",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Merci. Je vais tout chiper",
          "next": [
            145410114
          ]
        },
        "145410114": {
          "id": 145410114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "De rien. Ce sont les fonds de recherche de la Station spatiale",
          "next": [
            145410115
          ]
        },
        "145410115": {
          "id": 145410115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Sers-toi",
