        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Alors que les informations venues d'au-delà du ciel parviennent à Amphoreus, une nouvelle vague de connaissances déferle sur les étudiants du Bosquet.",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Un étudiant vient de m'envoyer un test",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La pièce jointe <i>Quel Aiôn êtes-vous ?</i> a été envoyée",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tu as essayé ?",
          "next": [
            202000005,
            202000006,
