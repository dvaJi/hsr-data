            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est étrangement approprié",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est du genre « glouton »",
