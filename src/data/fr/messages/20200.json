          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je dois forcément être Akivili",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je suis Nanook, et par la présente je vous sacre Seigneur ravageur",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je suis Aha, haha !",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "J'ai pu constater que ça s'appuyait sur les dimensions conceptuelles des Voies, en essayant de comprendre l'auto-cognition et la prédiction comportementale via la classification",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Anaxa n'est plus en ligne",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Anaxa est en ligne",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Je suis Ouroboros",
          "next": [
            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Le commentaire indique :",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "« Tu n'es pas sans lien avec Ouroboros. Ton désir et ta consommation de la vérité sont insatiables, à l'instar des drakas qui mastiquent de l'argile rouge. Le désir est l'instinct qui te pousse à agir. »",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "« Ta philosophie est : il en faut toujours plus ! »",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ça ne devrait pas être Tête de droïde ?",
