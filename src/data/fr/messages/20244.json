        "202440004": {
          "id": 202440004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin, c'est qui cet influenceur musical, Nibor ?",
          "next": [
            202440011
          ]
        },
        "202440005": {
          "id": 202440005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Félicitations à moi pour avoir découvert cette pépite !",
          "next": [
            202440006
          ]
        },
        "202440006": {
          "id": 202440006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Suis dès maintenant et deviens {M#un vrai}{F#une vraie} fan",
          "next": [
            202440011
          ]
        },
        "202440007": {
          "id": 202440007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nibor Flying Raven ? Sunday a de sacrées compétences musicales !",
          "next": [
            202440008
          ]
        },
        "202440008": {
          "id": 202440008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "N'est-ce pas !?",
          "next": [
            202440009
          ]
        },
        "202440009": {
          "id": 202440009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Arrête ? C'est vraiment lui...?",
          "next": [
            202440010
          ]
        },
        "202440010": {
          "id": 202440010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Bon, j'arrête de te faire marcher",
          "next": [
            202440011
          ]
        },
        "202440011": {
          "id": 202440011,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202440012
          ]
        },
        "202440012": {
          "id": 202440012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "C'est un nouveau compte que j'ai créé récemment. J'ai choisi ce nom pour ne pas être reconnue",
          "next": [
            202440013
          ]
        },
        "202440013": {
          "id": 202440013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "J'aimerais essayer des styles musicaux un peu différents de ce que je fais d'habitude",
          "next": [
            202440014
          ]
        },
        "202440014": {
          "id": 202440014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Voyons voir, ça fait environ une semaine depuis ma dernière mise à jour maintenant",
          "next": [
            202440015
          ]
        },
        "202440015": {
          "id": 202440015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Il faut que je trouve une idée pour la prochaine vidéo. Tu aurais des suggestions ?",
          "next": [
            202440016,
            202440020,
            202440023
          ]
        },
        "202440016": {
          "id": 202440016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Essaie peut-être une collab inter-genres avec d'autres influenceurs",
          "next": [
            202440017
          ]
        },
        "202440017": {
          "id": 202440017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Comme Sparxie dans la section streaming, ou Guigui et Sushang dans la section chasse aux fantômes de Xianzhou",
          "next": [
            202440018
          ]
        },
        "202440018": {
          "id": 202440018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "C'est une bonne idée !",
          "next": [
            202440019
          ]
        },
        "202440019": {
          "id": 202440019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Peut-être que la musique pourra nous inspirer quelques idées d'histoires inattendues",
          "next": [
            202440026
          ]
        },
        "202440020": {
          "id": 202440020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu pourrais tester et faire des critiques sur certains instruments de musique insolites. Genre... ceux qui utilisent des ballons comme percussions ?",
          "next": [
            202440021
          ]
        },
        "202440021": {
          "id": 202440021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Quelle idée amusante ! En fait, j'ai découvert un jour que si on évide une carotte et qu'on y perce quelques trous, on peut en tirer des sons vraiment sympas !",
          "next": [
            202440022
          ]
        },
        "202440022": {
          "id": 202440022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Je pourrais essayer d'explorer davantage les objets du quotidien comme instruments !",
          "next": [
            202440026
          ]
        },
        "202440023": {
          "id": 202440023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu pourrais faire une vidéo de reprises de tes chansons mais en changeant les instruments",
          "next": [
            202440024
          ]
        },
        "202440024": {
          "id": 202440024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Revisiter mes chansons ?",
          "next": [
            202440025
          ]
        },
        "202440025": {
          "id": 202440025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ça se tient. Ça fait aussi partie du processus créatif",
          "next": [
            202440026
          ]
        },
        "202440026": {
          "id": 202440026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Merci pour cette suggestion !",
          "next": [
            202440027
          ]
        },
