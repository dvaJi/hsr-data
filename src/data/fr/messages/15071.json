      "messages": {
        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Patron{F#ne} ! J'espère que vous vous portez bien ces derniers temps ?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Oh, désolé, c'est mon vieux réflexe d'utiliser mon téléphone de fonction.",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "C'est moi, Pandali ! Gigaroo, c'est que mon nom de scène.",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "J'ai une excellente nouvelle à vous annoncer, patron{F#ne}.",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Mon film solo a enfin été validé, c'est un énorme blockbuster de super-héros intitulé <i>La Mélancolie de Gigaroo</i> !",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ouah, félicitations ! Je suis ravi{F#e} de voir ton rêve se réaliser !",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Il ne faut pas crier victoire trop vite, le tournage vient à peine de commencer.",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est génial !",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Dis-moi, est-ce que tu as prévu de revenir travailler avec nous ?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Pas avant la fin des prises de vue, pour l'instant on est encore au tout début du tournage.",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Oh, Saint Wubbabou me fait signe, je dois filer lui donner un coup de main.",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Passez faire un tour sur le lieu de tournage dès que vous avez le temps, patron{F#ne} !",
          "next": []
        }
