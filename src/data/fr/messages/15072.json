      "messages": {
        "150720100": {
          "id": 150720100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Voilà, la séance de cinéma est terminée.",
          "next": [
            150720101
          ]
        },
        "150720101": {
          "id": 150720101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Que chacun s'organise pour sa pause toilettes ou ses photos, et on se retrouve devant l'entrée du cinéma !",
          "next": [
            150720102
          ]
        },
        "150720102": {
          "id": 150720102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "Ce film en jette un max, on sent que le budget était colossal !",
          "next": [
            150720103
          ]
        },
        "150720103": {
          "id": 150720103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Il n'y a rien de mieux qu'une bonne histoire pleine d'action !",
          "next": [
            150720104
          ]
        },
        "150720104": {
          "id": 150720104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Et le rôle principal est incarné par un vétéran du cinéma, le Saint Wubbabou.",
          "next": [
            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "C'est clair ! Les petits tracas quotidiens d'un super-héros, ça me parle tellement.",
          "next": [
            150720106
          ]
        },
        "150720106": {
          "id": 150720106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Au fait, quelqu'un a vu Pandali ?",
          "next": [
            150720107
          ]
        },
        "150720107": {
          "id": 150720107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Comment on peut disparaître comme ça, en pleine séance ?",
          "next": [
            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "J'ai vu Pandali sortir du cinéma les larmes aux yeux, puis courir à toute vitesse vers les bureaux de la rédac",
          "next": [
            150720109
          ]
        },
        "150720109": {
          "id": 150720109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 229,
          "text": "Il allait à une allure folle avec ses petites pattes",
          "next": [
            150720110
          ]
        },
        "150720110": {
          "id": 150720110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Il est si pressé que ça de retourner bosser ? Il va nous faire un burn-out à ce rythme !",
          "next": []
        }
      },
