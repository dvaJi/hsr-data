        "202180004": {
          "id": 202180004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Durant ce bref moment passé ensemble, tout le monde parlait souvent de toi",
          "next": [
            202180005
          ]
        },
        "202180005": {
          "id": 202180005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, {M#futé}{F#futée} comme tu es, tu as déjà dû deviner que j'étais l'administratrice du groupe !",
          "next": [
            202180006
          ]
        },
        "202180006": {
          "id": 202180006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "(Entre nous : j'ai la permission de tout le monde pour le reposter)",
