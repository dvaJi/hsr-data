        },
        "202180015": {
          "id": 202180015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Héhé, ça te ressemble bien, non ?",
          "next": [
            202180016
          ]
        },
        "202180016": {
          "id": 202180016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ah oui, et voici mon passage préféré",
          "next": [
            202180017
          ]
        },
        "202180017": {
          "id": 202180017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Castorice [dans la discussion] : <i>Renaissance : Je suis un Petit raton laveur</i>, celle-là est vraiment bonne\nPhaénon [dans la discussion] : <i>Renaissance : Je suis un Petit raton laveur</i>, regardez ce que j'ai trouvé !\nCipher [dans la discussion] : ? J'allais justement partager ça aussi\nMydei [dans la discussion] : ?\nCérydra [dans la discussion] : Déjà recommandé\nAnaxa [dans la discussion] : Je l'ai lu, c'était pas mal\nCyrène [dans la discussion] : Trop bien, je veux la suite !",
          "next": [
            202180018
          ]
        },
        "202180018": {
          "id": 202180018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Il reste encore tellement à découvrir, tu verras par toi-même...",
          "next": [
            202180019
