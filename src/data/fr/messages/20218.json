        },
        "202180019": {
          "id": 202180019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Quand je ne serai pas là, n'oublie pas de parler davantage avec tout le monde !",
          "next": [
            202180020
          ]
        },
