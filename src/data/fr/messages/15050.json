      "messages": {
        "150500101": {
          "id": 150500101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Hé {M#vieux}{F#l'amie}, t'as encore assez d'argent ?",
          "next": [
            150500102
          ]
        },
        "150500102": {
          "id": 150500102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Si ça ne suffit pas, tu devras dépenser tes sous à toi",
          "next": [
            150500103
          ]
        },
        "150500103": {
          "id": 150500103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Commençons par la première bonne nouvelle",
          "next": [
            150500104
          ]
        },
        "150500104": {
          "id": 150500104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Maintenant que le défi Qui veut perdre des milliards est terminé, on a rappelé Robosseuse et comptabilisé toutes les recettes et les dépenses",
          "next": [
            150500105
          ]
        },
        "150500105": {
          "id": 150500105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Bien que certaines dépenses aient été... discutables, on ne pense pas qu'elles aient réellement enfreint les règles",
          "next": [
            150500106,
            150500108
          ]
        },
        "150500106": {
          "id": 150500106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "En quoi c'est une bonne nouvelle ? Je dépense toujours mon argent dans les règles de l'art",
          "next": [
            150500107
          ]
        },
        "150500107": {
          "id": 150500107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Je m'inquiète juste que tu échoues au défi pour avoir enfreint les règles, c'est tout !",
          "next": [
            150500110
          ]
        },
        "150500108": {
          "id": 150500108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Annoncer d'abord la bonne nouvelle... ça veut dire qu'il y en a une deuxième ?",
          "next": [
            150500109
          ]
        },
        "150500109": {
          "id": 150500109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Pardon, on veut des réactions aussi authentiques que possible, donc c'est tout ce qu'on peut révéler pour l'instant",
          "next": [
            150500110
          ]
        },
        "150500110": {
          "id": 150500110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Je t'ai envoyé l'adresse. Retrouve-moi à la Tour de l'aiguille, et on finalisera l'enregistrement du final du défi Qui veut perdre des milliards",
          "next": [
            150500111,
            150500112
          ]
        },
        "150500111": {
          "id": 150500111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'arrive ! À peine sorti{F#e}, et déjà en route",
          "next": [
            150500113
          ]
        },
        "150500112": {
          "id": 150500112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Attends-moi, j'ai encore besoin d'un peu de temps",
          "next": [
            150500113
          ]
        },
        "150500113": {
          "id": 150500113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "On a le temps. Au fait, Aventurine est en chemin lui aussi",
          "next": [
            150500114
          ]
        },
        "150500114": {
          "id": 150500114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "On finalisera les résultats du défi une fois que tu seras là",
          "next": []
        }
      },
