        150730100
      ],
      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt, tout le monde va bien ?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Allô, allô ! Quelqu'un me reçoit ?",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "« Avertissement : signal faible. Veuillez vérifier votre connexion. »",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@March 7th @{NICKNAME} @Sunday, bien reçu, tout roule",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Tout est bon de notre côté. @Dan Heng, tu peux les prévenir aussi ?",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Ne vous inquiétez pas pour nous. On vient juste de repousser une vague de monstres tentaculaires qui ont surgi des souterrains",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Pfiou",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Cela dit, on est vraiment obligés d'aller à Astropolis ? Rien de personnel, mais je suis un peu méfiante vis-à-vis de la CPI",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "On pourrait peut-être essayer de demander de l'aide à Xianzhou ou à la Station spatiale Herta à la place ?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "J'y ai pensé aussi",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "En termes de distance, Xianzhou et la Station spatiale Herta sont relativement hors d'atteinte. À situations exceptionnelles, mesures exceptionnelles. Le meilleur plan reste de se diriger vers Astropolis",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Mais le plus gros casse-tête, plus encore que la distance, c'est que Planarcadia fait partie du réseau commercial de la CPI",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Selon les règles du commerce interstellaire, ils ont la priorité pour s'en occuper. Si des personnes extérieures interviennent sans autorisation, ça pourrait se terminer en véritable chaos diplomatique et juridique",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Donc... on n'a pas le choix quoi.",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "{NICKNAME}, c'est à toi de prendre en charge la navigation",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Compris, je m'en occupe",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Tu vas y arriver. J'ai confiance en toi",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je... Je sais pas quoi faire",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ne t'inquiète pas. J'ai confiance en toi. En tant que {M#navigateur}{F#navigatrice} par intérim, tu trouveras bien une solution",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "La situation est urgente, on te soutiendra quelle que soit la décision que tu prendras",
          "next": [
            150730120
          ]
        },
        "150730120": {
          "id": 150730120,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "« Avertissement : signal faible. Veuillez vérifier votre connexion. »",
          "next": []
        }
