          ]
        },
        "150970101": {
          "id": 150970101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "I—Il y a quelqu'un ? Bon, je vais supposer que oui.",
          "next": [
            150970102
          ]
        },
        "150970102": {
          "id": 150970102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Tu as reçu un message !",
          "next": [
            150970103
          ]
        },
        "150970103": {
          "id": 150970103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "« Merci d'avoir ramené les petits ! Ils t'ont préparé un cadeau de remerciement rien que pour toi. Viens visiter la \"Base secrète des BFF\" quand tu as un moment pour le récupérer ! »",
          "next": [
            150970104
          ]
        },
        "150970104": {
          "id": 150970104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "« Oh, et encore une chose ! J'ai aussi laissé un petit cadeau pour toi à Duopolis. Quant à l'endroit exact... »",
          "next": [
            150970106
          ]
        },
        "150970105": {
          "id": 150970105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Voilà, c'est tout ! Je t'attends là-bas !",
          "next": []
        },
        "150970106": {
          "id": 150970106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "1. Un endroit d'où on peut voir la Fabulune !",
          "next": [
            150970107
          ]
        },
        "150970107": {
          "id": 150970107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "2. Un endroit vraiment très haut !",
          "next": [
            150970108
          ]
        },
        "150970108": {
          "id": 150970108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "3. Un endroit où une boîte en métal se déplace sous vos pieds !",
          "next": [
            150970109
          ]
        },
        "150970109": {
          "id": 150970109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "« Voilà tous les indices. Allez, trouvez ! »",
          "next": [
            150970105
          ]
        }
