          ]
        },
        "202530007": {
          "id": 202530007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un peu plus de couleur ? Alors, montrons leurs vraies couleurs.",
          "next": [
            202530010
          ]
        },
        "202530008": {
          "id": 202530008,
          "type": "Text",
