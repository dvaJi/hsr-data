  "sections": [
    {
      "id": 2023700,
      "startingMessageId": [
        202370000
      ],
      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le plug-in « Détecteur de Blade » a été mis à jour.",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nouveautés : Correction de certains problèmes connus, fonction d'amortissement des vibrations améliorée, davantage de vidéos de pât'patoune visionnées.",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Vous envoyez un petit wizz à Blade, son téléphone vibre une fois.",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Blade est en ligne.",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ça tombe bien. Je pensais justement à toi.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je suis flatté{F#e} ! Qu'est-ce qui t'a fait penser à moi ?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "T'es enfin prêt à rattraper le bon vieux temps ?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Non.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tout à l'heure, j'ai remarqué plusieurs objets dans l'arsenal. Ils ont été abîmés par un usage intensif, mais encore utilisables... Mais personne n'est venu les chercher. Ce sont sûrement des reliques de ton passé.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Puisque tu m'as envoyé un message, j'en profite pour te poser la question : il y a quelque chose qui te fait envie ? Je pourrai l'améliorer et le reforger quand j'y retournerai.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Qu'est-ce que j'ai laissé là-bas ? Une arme ?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Quelques objets méconnaissables dans leur état actuel. À en juger par leur structure, ils étaient destinés à un usage quotidien.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Rien ne se perd. Il suffit de demander, je peux tout fabriquer.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pour mes voyages interstellaires ultra-dynamiques, j'ai besoin d'une sorte de machine à dormir capable de m'endormir n'importe quand, n'importe où, en un clin d'œil.",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "À Xianzhou, on appelait ça un « berceau ».",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Peut-être quelque chose de moins ordinaire.",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bien dormi ?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "J'ai fabriqué quelques gadgets à bord du vaisseau récemment pour améliorer le sommeil. Ça t'intéresse ?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Alors je veux une amélioration ! Je veux quelque chose qui puisse m'endormir immédiatement, n'importe quand et n'importe où !",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Pas de problème.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je ne suis pas difficile, je prends ce qu'il y a !",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "J'ai fabriqué quelques gadgets à bord du vaisseau récemment pour améliorer le sommeil. Ça t'intéresse ?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Super ! Je veux une machine qui puisse m'endormir n'importe quand, n'importe où, en un instant.",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Pas de problème.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Endormir quelqu'un n'est pas difficile, mais pour obtenir un effet de sommeil forcé, il faudra prévoir des ajustements supplémentaires.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu peux ajouter un bruit blanc. Ça m'aidera à m'endormir encore plus vite.",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Rien de plus simple. Quelques plaques de fer suffisent pour reproduire le bourdonnement du forgeage d'une lame.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ce genre de bruit avait tendance à me tenir en éveil autrefois... Pour toi, il pourrait s'avérer hypnotique.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et si on ajoutait des fonctions de relaxation pour aider à dormir ? Comme des massages, un oreiller vibrant, ce genre de choses ?",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Très bien.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Il y a des articulations de bras mécaniques abandonnées dans la salle technique qui peuvent simuler ces mouvements.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ça risque d'être un peu bruyant, mais ça pourrait aussi faire office de bruit blanc.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu peux ajouter des berceuses ?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Très bien.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Un lecteur de musique est intégré. Tu peux y enregistrer une chanson.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Moi, je ne sais pas chanter. Au mieux, je peux te réciter quelques paroles...",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "D'accord ! Je suppose que ça fera l'affaire...",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Une fois les modifications terminées, je peux te le faire livrer ou tu peux venir le récupérer en personne. À toi de voir.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je te tiens au courant.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "À bientôt.",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Blade est hors ligne.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}