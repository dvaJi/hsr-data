          ]
        },
        "202060004": {
          "id": 202060004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Phaénon ? C'est bon de te revoir !",
          "next": [
            202060008
          ]
        },
        "202060005": {
          "id": 202060005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Quoi de neuf ?",
          "next": [
            202060008
          ]
        },
        "202060006": {
          "id": 202060006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ne me fais pas attendre comme ça. Qu'est-ce qui se passe ?",
          "next": [
            202060007
          ]
        },
        "202060007": {
          "id": 202060007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Qu'est-ce qui se passe ?",
          "next": [
            202060008
          ]
        },
        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Eh bien... J'ai enfin du temps libre, mais je n'arrive pas à rester en place. Alors j'essaie de m'occuper comme je peux",
          "next": [
            202060009
          ]
        },
        "202060009": {
          "id": 202060009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aglaé, Tribbie... elles ont toutes un domaine de prédilection",
          "next": [
            202060010
          ]
        },
        "202060010": {
          "id": 202060010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "J'ai voulu essayer différents métiers sur un coup de tête, apprendre de nouvelles capacités et peut-être découvrir d'autres passe-temps !",
          "next": [
            202060011
          ]
        },
        "202060011": {
          "id": 202060011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "J'ai essayé d'être chef cuisinier, serrurier, acteur dans un manoir hanté, mannequin, dresseur de draka, commissaire-priseur...",
          "next": [
            202060012
          ]
        },
        "202060012": {
          "id": 202060012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Mais aucun d'entre eux ne me convenait vraiment, tu vois ?",
          "next": [
            202060013
          ]
        },
        "202060013": {
          "id": 202060013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Tu as d'autres suggestions pour moi, partenaire ?",
          "next": [
            202060014,
            202060016,
            202060018
          ]
        },
        "202060014": {
          "id": 202060014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tel le soleil ardent destiné à se lever...",
          "next": [
            202060015
          ]
        },
        "202060015": {
          "id": 202060015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tu devrais fendre les cieux !",
          "next": [
            202060019
          ]
        },
        "202060016": {
          "id": 202060016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et pourquoi pas de l'aquarelle ? Ça t'aiderait à développer ton sens des couleurs",
          "next": [
            202060017
          ]
        },
        "202060017": {
          "id": 202060017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ça a l'air d'être un beau défi, non ?",
          "next": [
            202060019
          ]
        },
        "202060018": {
          "id": 202060018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dresseur de chiens. Je pense que tu as un véritable talent pour ça",
          "next": [
            202060019
          ]
        },
        "202060019": {
          "id": 202060019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202060020
          ]
        },
        "202060020": {
          "id": 202060020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Tu m'as vraiment donné de l'inspiration !",
          "next": [
            202060021
          ]
        },
        "202060021": {
          "id": 202060021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je devrais sortir des sentiers battus et relever plus de défis qui me feront décrocher la lune !",
          "next": [
            202060022
          ]
        },
        "202060022": {
          "id": 202060022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Comme le parachutisme, par exemple. Je n'ai pas le vertige. Je pourrais même monter encore plus haut",
          "next": [
            202060023
          ]
        },
        "202060023": {
          "id": 202060023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Et sinon... que dirais-tu de devenir athlète professionnel ?",
          "next": [
            202060024
          ]
        },
        "202060024": {
          "id": 202060024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Avec mes résultats, je pense avoir un certain talent pour ça",
          "next": [
            202060025
          ]
        },
        "202060025": {
          "id": 202060025,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202060026
          ]
        },
        "202060026": {
          "id": 202060026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ça a l'air génial !",
          "next": [
            202060027
          ]
        },
        "202060027": {
          "id": 202060027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Plus j'y pense et plus j'ai hâte !",
          "next": [
            202060028
          ]
        },
        "202060028": {
          "id": 202060028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je vais essayer tout de suite !",
          "next": [
            202060029
          ]
        },
        "202060029": {
          "id": 202060029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "À bientôt !",
          "next": []
        }
