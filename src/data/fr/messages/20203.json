        "202030011": {
          "id": 202030011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Ses plumes sont d'un bleu profond. De loin, on dirait presque qu'il brille ! C'est magnifique",
