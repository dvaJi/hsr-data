            202030012
          ]
        },
        "202030012": {
          "id": 202030012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Quand il a effleuré l'eau, c'était comme un petit éclair. Les éclaboussures s'élevaient comme des étoiles.",
