  ],
  "sections": [
    {
      "id": 2022000,
      "startingMessageId": [
        202200000
      ],
      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, tu savais qu'il y a encore plein de souvenirs à découvrir à Penacony ?",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Personne ne l'a jamais vraiment compris, pas même toi qui viens de récupérer ce souvenir",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ces personnes que tu connais, ces secrets encore plus enfouis... ça te rend pas {M#curieux}{F#curieuse} ?",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "La femme qui a brandi un fourreau enflammé lors de cette Nuit de la flamme éternelle",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ou alors... les chasseurs qui te suivent à la trace ?",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Et bien sûr, il y a moi aussi, je serais ravie de t'ouvrir mon cœur",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Avant que je brûle certains souvenirs, je peux en partager quelques-uns avec toi",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'aimerais connaître le secret d'Achéron, qu'elle-même ignore.",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Cette nuit où la dernière étincelle s'est éteinte",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Je l'ai vue",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Elle a pris un plan, mais malheureusement ce n'était pas une carte. C'était...",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Un « menu »",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Mais à ce jour, elle ne l'a probablement pas encore compris",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Peut-être qu'elle avait juste faim, tu sais qu'elle sait cuisiner ?",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Qui sait ?",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Peut-être... que j'ai déjà goûté à ses plats",
          "next": [
            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu t'es vraiment infiltrée chez les Chasseurs de Stellaron ? J'ai des doutes",
          "next": [
            202200017
          ]
        },
        "202200017": {
          "id": 202200017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Dis-moi un secret les concernant, pour voir ?",
          "next": [
            202200018
          ]
        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Les Chasseurs de Stellaron, les Esclaves du destin... héhé, même ces titres n'arrivent pas à décrire le lien qui vous unit",
          "next": [
            202200019
          ]
        },
        "202200019": {
          "id": 202200019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Pourquoi ils ont 42 groupes de discussion nommés « script » ? C'est vraiment intrigant !",
          "next": [
            202200020
          ]
        },
        "202200020": {
          "id": 202200020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu es nulle en maths, il y en a pas 56 ?",
          "next": [
            202200021
          ]
        },
        "202200021": {
          "id": 202200021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Devine dans lequel je suis ?",
          "next": [
            202200028
          ]
        },
        "202200022": {
          "id": 202200022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je veux connaître ton secret inavoué",
          "next": [
            202200023
          ]
        },
        "202200023": {
          "id": 202200023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "J'ai autrefois voyagé pendant une demi-ère de l'Ambre avec la « Secte du poisson au vinaigre du lac stellaire »",
          "next": [
            202200024
          ]
        },
        "202200024": {
          "id": 202200024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Leur slogan, c'était : « Le paradis en bas, le lac stellaire en haut, une bouchée suffit pour ne plus jamais être aigri »",
          "next": [
            202200025
          ]
        },
        "202200025": {
          "id": 202200025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Dommage que personne ne s'en souvienne. Les souvenirs sont de nature si fragile",
          "next": [
            202200026
          ]
        },
        "202200026": {
          "id": 202200026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Maintenant tout le monde le sait, on veut t'entendre crier ce slogan",
          "next": [
            202200027
          ]
        },
        "202200027": {
          "id": 202200027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Il te faudra payer un coût supplémentaire",
          "next": [
            202200028
          ]
        },
        "202200028": {
          "id": 202200028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'ai découvert un secret connu de très peu de monde !",
          "next": [
            202200029
          ]
        },
        "202200029": {
          "id": 202200029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Pour te remercier, je vais te révéler un secret moi aussi !",
          "next": [
            202200030
          ]
        },
        "202200030": {
          "id": 202200030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "En fait...",
          "next": [
            202200031
          ]
        },
        "202200031": {
          "id": 202200031,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "En fait, Mikhail a été acteur autrefois",
          "next": [
            202200032
          ]
        },
        "202200032": {
          "id": 202200032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Venant de toi, je pourrais bien y croire",
          "next": [
            202200033
          ]
        },
        "202200033": {
          "id": 202200033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": []
        }
      },
      "participatingContactsIds": [
        1321,
        8001
      ]
    }
  ]
}