{
  "id": 20220,
  "contacts": {
    "id": 1321,
    "name": "Le Dahlia",
    "icon": "1321",
    "signature": "Pourquoi tu ne dis plus rien ?",
    "typeId": 1,
    "type": "Personnages"
  },
  "relatedMessages": [
    20219,
