      "messages": {
        "150110100": {
          "id": 150110100,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu es dispo ? J'ai besoin de ton aide pour un truc",
          "next": [
            150110101
          ]
        },
        "150110101": {
          "id": 150110101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Attends, ne bouge pas d'un poil. J'arrive dans deux secondes",
          "next": [
            150110102,
            150110104
          ]
        },
        "150110102": {
          "id": 150110102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je n'ai même pas dit ce dont j'avais besoin ! Tu es toujours aussi énergique ?",
          "next": [
            150110103
          ]
        },
        "150110103": {
          "id": 150110103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Pour réussir dans une industrie aussi impitoyable, il faut savoir être proactive, héhé",
          "next": [
            150110106
          ]
        },
        "150110104": {
          "id": 150110104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pourquoi tu es aussi pressée de me voir ? Tu cherches à te venger ?",
          "next": [
            150110105
          ]
        },
        "150110105": {
          "id": 150110105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Pour qui tu me prends ? Je suis là pour aider, évidemment",
          "next": [
            150110106
          ]
        },
        "150110106": {
          "id": 150110106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "Mes fans ont tout vu ! Ils disent que tu es allé{F#e} farfouiller sur la scène de crime avec le Département de Défense contre les Aberrations. Alors, on aime encore mettre son nez dans les affaires des autres ?",
          "next": [
            150110107
          ]
        },
        "150110107": {
          "id": 150110107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "C'est l'affaire du Tueur du millénaire, non ? Moi aussi, ce type m'intéresse pas mal",
          "next": [
            150110108
          ]
        },
        "150110108": {
          "id": 150110108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1501,
          "text": "On discutera des détails quand on se verra, j'arrive dans deux secondes",
          "next": [
            150110109
          ]
        },
        "150110109": {
          "id": 150110109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "D'accord, on t'attend",
