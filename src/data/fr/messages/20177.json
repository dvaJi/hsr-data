  "sections": [
    {
      "id": 2017700,
      "startingMessageId": [
        201770000
      ],
      "messages": {
        "201770000": {
          "id": 201770000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Voici ta récompense",
          "next": [
            201770001,
            201770002
          ]
        },
        "201770001": {
          "id": 201770001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ça paye combien ? Je n'accepte pas n'importe quel boulot",
          "next": [
            201770003
          ]
        },
        "201770002": {
          "id": 201770002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Qu'est-ce qu'on teste maintenant ? Mes tarifs ont augmenté, je préfère vous prévenir",
          "next": [
            201770003
          ]
        },
        "201770003": {
          "id": 201770003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Réception de la pièce jointe <i>Guide d'achat et de rangement des vêtements neufs</i>",
          "next": [
            201770004
          ]
        },
        "201770004": {
          "id": 201770004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Fichier trop volumineux, téléchargement impossible",
          "next": [
            201770005
          ]
        },
        "201770005": {
          "id": 201770005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Mets vite le système de messagerie à niveau",
          "next": [
            201770006
          ]
        },
        "201770006": {
          "id": 201770006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Disons simplement que j'ai acheté de nouveaux vêtements et que mes marionnettes n'arrivent pas à tenir la cadence pour les ranger.",
          "next": [
            201770007,
            201770008
          ]
        },
        "201770007": {
          "id": 201770007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Combien de nouveaux de vêtements ? J'en veux aussi !",
          "next": [
            201770009
          ]
        },
        "201770008": {
          "id": 201770008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est moi, {NICKNAME}. Je les veux.",
          "next": [
            201770009
          ]
        },
        "201770009": {
          "id": 201770009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Tu ne peux pas porter ça",
          "next": [
            201770010
          ]
        },
        "201770010": {
          "id": 201770010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Je les ai achetés pour les marionnettes",
          "next": [
            201770011,
            201770013
          ]
        },
        "201770011": {
          "id": 201770011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Elles ont aussi besoin de changer de vêtements ?",
          "next": [
            201770012
          ]
        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Évidemment. Avec un si joli minois, qui résisterait à l'envie de leur acheter de beaux vêtements",
          "next": [
            201770015
          ]
        },
        "201770013": {
          "id": 201770013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Zut alors, même les marionnettes sont mieux habillées que moi",
          "next": [
            201770014
          ]
        },
        "201770014": {
          "id": 201770014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ah, tu as enfin compris",
          "next": [
            201770015
          ]
        },
        "201770015": {
          "id": 201770015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Il y a tellement de styles, il faut penser à les classer par catégorie au moment de les trier.",
          "next": [
            201770016
          ]
        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "À première vue, c'est plutôt élégant. Ça saute aux yeux, je porterais ça volontiers. Commençons par trier ceux-là.",
          "next": [
            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ruan Mei recommande toujours les mêmes choses en boucle, il suffit de les mettre avec ceux d'en haut",
          "next": [
            201770018
          ]
        },
        "201770018": {
          "id": 201770018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Plus les couleurs sont agressives pour les yeux, plus ça mérite sa place dans la section rétro",
          "next": [
            201770019
          ]
        },
        "201770019": {
          "id": 201770019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Plus un motif est difficile à décrire et à comprendre, plus ça mérite sa place dans la haute couture",
          "next": [
            201770020
          ]
        },
        "201770020": {
          "id": 201770020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Pour le reste, tu n'as qu'à te référer au guide directement",
          "next": [
            201770021
          ]
        },
        "201770021": {
          "id": 201770021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre contact a partagé sa position",
          "next": [
            201770022
          ]
        },
        "201770022": {
          "id": 201770022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Je t'ai envoyé l'emplacement de la garde-robe. Ça devrait être proche de tes coordonnées",
          "next": [
            201770023
          ]
        },
        "201770023": {
          "id": 201770023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Il y a une petite station spatiale juste là",
          "next": [
            201770024
          ]
        },
        "201770024": {
          "id": 201770024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ne t'inquiète pas pour le manque d'espace",
          "next": [
            201770025,
            201770027
          ]
        },
        "201770025": {
          "id": 201770025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Une station spatiale ? Où ça ? Asta est au courant ?",
          "next": [
            201770026
          ]
        },
        "201770026": {
          "id": 201770026,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je m'y mets dès que j'ai reçu le paiement",
          "next": [
            201770029
          ]
        },
        "201770027": {
          "id": 201770027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vous avez acheté une station spatiale en guise de garde-robe pour les marionnettes ? Asta est au courant ?",
          "next": [
            201770028
          ]
        },
        "201770028": {
          "id": 201770028,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je m'y mets dès que j'ai reçu le paiement",
          "next": [
            201770029
          ]
        },
        "201770029": {
          "id": 201770029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Pour les détails, c'est son problème",
          "next": [
            201770030
          ]
        },
        "201770030": {
          "id": 201770030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre appel est en cours de transfert vers votre amie Asta",
          "next": []
        }
      },
      "participatingContactsIds": [
        1401,
