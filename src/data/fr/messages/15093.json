      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Hé, j'ai entendu dire que tu venais de te prendre la plus grosse humiliation de ta vie ? Alors, ça fait quel effet d'être enfin à ma place pour une fois ?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comment tu fais pour être au courant aussi vite ? Ça s'est passé il y a même pas une minute !",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "T'es content ? Tu peux enfin rire de moi !",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "J'ai quelques larbins fantômes au Centre d'emploi post-mortem, tu sais. Ils se planquaient dans le coin et filmaient tout en direct depuis le début",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Mais bon, je suis pas venu juste pour remuer le couteau dans la plaie. En fait, j'ai un moyen de t'aider",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "On parlera des détails en personne. Je suis dans le coin, viens me voir",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Skott a commencé un partage de position.",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "M'aider ? Qu'est-ce qui te rend si aimable tout à coup ?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Toujours aussi méfiant{F#e}, à ce que je vois",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Viens juste discuter, d'accord ? C'est pas comme si je pouvais te battre, donc pourquoi avoir peur ?",
          "next": [
            150930110
          ]
        },
        "150930110": {
          "id": 150930110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Dépêche-toi, je suis occupé",
          "next": []
        }
      },
