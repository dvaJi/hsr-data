      "messages": {
        "202150000": {
          "id": 202150000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, j'ai enregistré la qualité de mon sommeil après avoir dormi trois fois sur l'herbe.",
          "next": [
            202150001
          ]
        },
        "202150001": {
          "id": 202150001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "J'ai constaté que cette position était bien plus reposante que les autres positions de sommeil.",
          "next": [
            202150002
          ]
        },
        "202150002": {
          "id": 202150002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Les drakas l'ont recommandé.",
          "next": [
            202150003
          ]
        },
        "202150003": {
          "id": 202150003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "J'ai mis à jour cette méthode de sommeil dans la banque de données. Tu peux la consulter quand tu veux.",
          "next": [
            202150004
          ]
        },
        "202150004": {
          "id": 202150004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu as dit qu'on allait dormir où ?",
          "next": [
            202150005
          ]
        },
        "202150005": {
          "id": 202150005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Dans les champs, sur l'herbe, partout près du sol.",
          "next": [
            202150006
          ]
        },
        "202150006": {
          "id": 202150006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Au début, c'était étrange. Mais une fois endormi, je ne ressentais plus rien et c'était très paisible.",
          "next": [
            202150007
          ]
        },
        "202150007": {
          "id": 202150007,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202150008
          ]
        },
        "202150008": {
          "id": 202150008,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1002,
          "next": [
            202150009
          ]
        },
        "202150009": {
          "id": 202150009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Je crois que je comprends ta confusion.",
          "next": [
            202150010
          ]
        },
        "202150010": {
          "id": 202150010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "La capacité à s'adapter rapidement à cette vie est sûrement liée au pouvoir de la flamme divine de la Terre.",
          "next": [
            202150011,
            202150016
          ]
        },
        "202150011": {
          "id": 202150011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Il y aura différents pouvoirs à l'avenir ?",
          "next": [
            202150012
          ]
        },
        "202150012": {
          "id": 202150012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "On pourrait aussi apprendre de nouvelles capacités avec toi, comme...",
          "next": [
            202150013,
            202150014,
            202150015
          ]
        },
        "202150013": {
          "id": 202150013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Se baigner dans les flammes. Un sauna ultime",
          "next": [
            202150022
          ]
        },
        "202150014": {
          "id": 202150014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un soin à la glace. La technique ultime pour affiner son visage",
          "next": [
            202150022
          ]
        },
        "202150015": {
          "id": 202150015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Produire de l'énergie par la foudre. L'Express serait perpétuellement en mouvement",
          "next": [
            202150022
          ]
        },
        "202150016": {
          "id": 202150016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Il y a d'autres habitudes que tu possèdes et qu'on ne connaît pas ?",
          "next": [
            202150017
          ]
        },
        "202150017": {
          "id": 202150017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Te connaissant, tu as encore fait des associations surprenantes.",
          "next": [
            202150018
          ]
        },
        "202150018": {
          "id": 202150018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je me disais que si tu pouvais maîtriser d'autres pouvoirs, peut-être que ce serait possible de...",
          "next": [
            202150019,
            202150020,
            202150021
          ]
        },
        "202150019": {
          "id": 202150019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Te baigner dans les flammes. Le sauna ultime",
          "next": [
            202150022
          ]
        },
        "202150020": {
          "id": 202150020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un traitement facial à la glace. La technique ultime pour affiner son visage",
          "next": [
            202150022
          ]
        },
        "202150021": {
          "id": 202150021,
          "type": "Text",
          "sender": "Player",
