        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Tu as suivi un draka amoureux et tu as pris un selfie en douce. Tu l'as posté avec le commentaire « Les sages ne tombent pas amoureux »",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Tu es allé{F#e} voir une voyante de rue et tu as posté un selfie avec la légende « Je forge mon propre destin »",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "En marchant dans la rue, tu as vu un poète... et tu as commencé une battle de rap sur place, selfie à l'appui",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Tu as laissé un selfie de ta tête au réveil ce matin",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
