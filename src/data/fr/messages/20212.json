        "202120009": {
          "id": 202120009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "J'ai encore quelques-uns de tes... « souvenirs ». Ce serait dommage qu'ils deviennent publics, n'est-ce pas ?",
