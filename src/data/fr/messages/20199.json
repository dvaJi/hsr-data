  "sections": [
    {
      "id": 2019900,
      "startingMessageId": [
        201990000
      ],
      "messages": {
        "201990000": {
          "id": 201990000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Excuse-moi, {NICKNAME}",
          "next": [
            201990001
          ]
        },
        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tu te souviens des deux petites chimères que j'ai adoptées ? J'ai découvert qu'elles adoraient s'endormir en écoutant des contes de fées",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "J'ai eu envie d'explorer de nouvelles voies ces derniers temps, alors je compte me lancer dans l'écriture...",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alors, c'est quel genre d'histoire cette fois ?",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'ai un rôle à jouer là-dedans ?",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ça ne devrait pas poser problème",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "En fait, j'allais justement te demander ton avis. Voilà ce que j'ai en tête :",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Le protagoniste arrive par hasard dans une petite ville. Elle est habitée par des chats, des souris, des corbeaux qui chantent, des cochons roses et une famille de fourmis solidaires",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tout le monde est très sociable et adore jouer avec le protagoniste. Ils prennent aussi beaucoup de plaisir à écouter ses histoires",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "À vrai dire... ils adorent ses histoires. Vraiment beaucoup...",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Lorsque la ville féerique plonge dans la nuit profonde et que tout devient silencieux... les petits animaux n'arrivent tout simplement pas à trouver le sommeil...",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ils se disent : « on ne peut pas rester silencieux ici », « on ne peut pas rester silencieux ici »...",
          "next": [
            201990012
          ]
        },
        "201990012": {
          "id": 201990012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ils se rendirent alors au chevet du protagoniste",
          "next": [
            201990013
          ]
        },
        "201990013": {
          "id": 201990013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Et ainsi...",
          "next": [
            201990014
          ]
        },
        "201990014": {
          "id": 201990014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "●_●",
          "next": [
            201990015
          ]
        },
        "201990015": {
          "id": 201990015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◕_◕",
          "next": [
            201990016
          ]
        },
        "201990016": {
          "id": 201990016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◐‿◑",
          "next": [
            201990017
          ]
        },
        "201990017": {
          "id": 201990017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ils te regardent",
          "next": [
            201990018,
            201990021,
            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est ça que tu appelles un « conte de fées » ? C'est terrifiant !",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ah, ça fait si peur que ça ?",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "À vrai dire, en écrivant, je me suis rendu compte que ce sujet conviendrait mieux à un roman d'horreur",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je dois avouer que c'est plutôt mignon",
          "next": [
            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "À vrai dire, en écrivant, je me suis rendu compte que ce sujet conviendrait mieux à un roman d'horreur",
          "next": [
            201990023
          ]
        },
        "201990023": {
          "id": 201990023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Mais à en juger par ta réaction, j'ai peur que les éléments d'horreur ne soient pas assez présents",
          "next": [
            201990027
          ]
        },
        "201990024": {
          "id": 201990024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alors, où est cet endroit tranquille ?",
          "next": [
            201990025
          ]
        },
        "201990025": {
          "id": 201990025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sans surprise, tu te focalises toujours sur des détails aussi... particuliers",
          "next": [
            201990026
          ]
        },
        "201990026": {
          "id": 201990026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "À vrai dire, en écrivant, je me suis rendu compte que ce sujet conviendrait mieux à un roman d'horreur",
          "next": [
            201990027
          ]
        },
        "201990027": {
          "id": 201990027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": [
            201990028
          ]
        },
        "201990028": {
          "id": 201990028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Je ne suis pas très calée en romans horrifiques. Alors pour mieux m'imprégner du genre, j'ai consulté quelques œuvres de référence, comme <i>20 mystères non élucidés</i> et <i>Les multiples causes de disparition</i>...",
          "next": [
            201990029
          ]
        },
        "201990029": {
          "id": 201990029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Je viens de terminer <i>Bien manger</i> aujourd'hui et j'y ai trouvé quelques bonnes idées",
          "next": [
            201990030
          ]
        },
        "201990030": {
          "id": 201990030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Je reviendrai discuter avec toi quand j'aurai fait quelques progrès",
          "next": [
            201990031
          ]
        },
        "201990031": {
          "id": 201990031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ne t'inquiète pas, les petites chimères viendront te harceler chaque jour pour avoir des nouvelles. Elles ne peuvent pas vivre sans histoires !",
          "next": [
            201990032
          ]
        },
        "201990032": {
          "id": 201990032,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": []
        }
      },
      "participatingContactsIds": [
        1407,
        8001
      ]
    }
  ]
}