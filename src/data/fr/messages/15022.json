          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ça faisait longtemps",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Pardon, c'est de ma faute",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "À partir de maintenant, quand j'aurai un moment, je t'enverrai un message",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "J'ai entendu dire que tu voyageais à Planarcadia",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "J'ai une petite faveur à te demander",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je vous en prie, votre honneur !",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Est-ce que par hasard tu as entendu parler de <i>Jeu du labyrinthe</i> ?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Cette bande dessinée m'intéresse beaucoup",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Traquer les criminels et les ennemis me convient mieux que de lire <i>Wok Star</i>, les débuts de l'autrice",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "J'ai entendu dire que Duopolis organisait une convention exclusive de Jeu du labyrinthe, où de nombreuses œuvres de fans seraient en vente",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Hélas, avec ma fonction, je ne peux pas assister personnellement à cette convention à Planarcadia",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "J'espère que tu pourras m'acheter quelques fanarts amateurs pour me consoler",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je traînais juste dans le coin près de cette convention quand j'ai reçu votre message... Vous n'étiez pas en train de m'espionner ?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Bip, bip, drone de surveillance « Modèle Xueyi 9527 » détecté. Activation du protocole d'auto-destruction.",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aaah, pitié ! Ne me faites pas exploser ! Je vous en achèterai, c'est promis !",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ne t'en fais pas, ce n'était qu'une plaisanterie",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Il n'y a pas de drones explosifs, tu peux être tranquille",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "J'ai hâte de découvrir les nouvelles créations des fans, merci",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Quelle coïncidence, je suis aussi à la convention",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Vraiment ? C'est merveilleux, je te remercie.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
