        },
        "202130002": {
          "id": 202130002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je dors",
          "next": [
            202130003
          ]
        },
        "202130003": {
          "id": 202130003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "C'est pas drôle",
          "next": [
            202130005
          ]
        },
        "202130004": {
          "id": 202130004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je n'arrive pas à dormir non plus",
          "next": [
            202130005
          ]
        },
        "202130005": {
          "id": 202130005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ah là là, je viens de finir de regarder un film",
          "next": [
            202130006
          ]
        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Il paraît que c'est basé sur une histoire vraie, à propos d'une personne avec une vingtaine de personnalités...",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Le protagoniste souffrait de pertes de mémoire. Il pensait qu'il s'agissait d'une simple amnésie, mais en fait, c'étaient d'autres personnalités qui vivaient sa vie à sa place",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tu crois... que je pourrais être pareille... ?",
          "next": [
            202130009
          ]
        },
        "202130009": {
          "id": 202130009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "La personne est en train d'écrire...",
          "next": [
            202130010,
            202130013
          ]
        },
        "202130010": {
          "id": 202130010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "En fait... C'est bien ça...",
          "next": [
            202130011
          ]
        },
        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "En fait... la toi d'hier... n'était pas la même toi qu'aujourd'hui. Tu étais plus mignonne hier...",
          "next": [
            202130012
          ]
        },
        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Sois sympa ! Je suis mignonne aujourd'hui, et je serai encore plus mignonne demain !",
          "next": [
            202130014
          ]
        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ne t'inquiète pas. Avec ma vision divine, je peux voir que tu es complète",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Même si tu plaisantes, je ne me sens pas très à l'aise",
          "next": [
            202130015
          ]
        },
        "202130015": {
          "id": 202130015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Il y a peut-être... d'autres March 7th quelque part !?",
          "next": [
            202130016
          ]
        },
        "202130016": {
          "id": 202130016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Peut-être... que l'une des March 7th est une artiste excentrique ? Ou même une femme fatale ? Ça fait peur...",
          "next": [
            202130017
          ]
        },
        "202130017": {
          "id": 202130017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ne me dis pas qu'il existe aussi une March 7th particulièrement intelligente...",
          "next": [
            202130018,
            202130020,
            202130022
          ]
        },
        "202130018": {
          "id": 202130018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ouiii, bien sûr. C'est l'heure de dormir, arrête de rêver",
          "next": [
            202130019
          ]
        },
        "202130019": {
          "id": 202130019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Quand tu te réveilleras, tu seras toujours la gentille, douce et innocente March 7th",
          "next": [
            202130024
          ]
        },
        "202130020": {
          "id": 202130020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et n'oublie pas, tu es aussi March 7th, la Championne de l'épée de l'Astral Express",
          "next": [
            202130021
          ]
        },
        "202130021": {
          "id": 202130021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ne t'inquiète pas, tu seras toujours la gentille, douce et innocente March 7th",
          "next": [
            202130024
          ]
        },
        "202130022": {
          "id": 202130022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ne t'inquiète pas, tout va bien",
          "next": [
            202130023
          ]
        },
        "202130023": {
          "id": 202130023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tu seras toujours la gentille, douce et innocente March 7th",
          "next": [
            202130024
          ]
        },
        "202130024": {
