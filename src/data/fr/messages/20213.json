          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            202130025
          ]
        },
        "202130025": {
          "id": 202130025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Tu sais vraiment trouver les mots justes...",
          "next": [
            202130026
          ]
        },
        "202130026": {
          "id": 202130026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bon, j'avoue que je m'en fiche un peu maintenant",
          "next": [
            202130027
          ]
        },
        "202130027": {
          "id": 202130027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Après tout, je suis March 7th. La fille sociable, généreuse, sage, charmante, intelligente, adorable, douce, gentille et innocente !",
          "next": [
            202130028
          ]
        },
        "202130028": {
