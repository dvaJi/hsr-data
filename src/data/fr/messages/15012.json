            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Ne fais pas l'innocent{F#e} ! Tu es {M#le patron}{F#la patronne} de Pandaroo News, la seule personne qui a pu orchestrer tout ça. Est-ce que j'ai tort ?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Mes mains commencent à ne plus m'obéir",
