          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Comment tu as eu mon numéro ?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Tu ne connais même pas mon nom ! Hilarant, tu ignores qui je suis et pourtant tu es prêt{F#e} à aller jusque-là",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu es ce fameux médecin... Izol, c'est ça ?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Comment tu as eu mon numéro ?",
