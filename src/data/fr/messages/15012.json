            150120111
          ]
        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Pas du tout ! C'est ridicule ! Tu ne sais même pas qui je suis, et pourtant tu es prêt à aller jusque-là",
