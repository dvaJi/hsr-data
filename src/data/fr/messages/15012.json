        },
        "150120114": {
          "id": 150120114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Arrête ça ! Dis-moi tes conditions, je te donnerai tout ce que tu veux. Pas la peine d'être si cruel{F#le} avec moi",
