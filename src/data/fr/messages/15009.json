        150090101
      ],
      "messages": {
        "150090101": {
          "id": 150090101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bonjour, je suis la propriétaire de la librairie d'occasion Charing. Excusez-moi de vous déranger.",
          "next": [
            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Avez-vous trouvé un texte appartenant aux <i>Chroniques des graisses flottantes</i> ?",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'en ai un, oui.",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Mais comment le savez-vous ?",
          "next": [
            150090105
          ]
        },
        "150090105": {
          "id": 150090105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ce sont les <i>Chroniques des graisses flottantes</i> de la place qui me l'ont dit.",
          "next": [
            150090106
          ]
        },
        "150090106": {
          "id": 150090106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Tout à l'heure, votre silhouette héroïque en train de les sauver est apparue sur les pages du livre.",
          "next": [
            150090115
          ]
        },
        "150090107": {
          "id": 150090107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est quoi, les <i>Chroniques des graisses flottantes</i> ?",
          "next": [
            150090108
          ]
        },
        "150090108": {
          "id": 150090108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ça me dit vaguement quelque chose, mais sans conviction.",
          "next": [
            150090109
          ]
        },
        "150090109": {
          "id": 150090109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "C'est un livre, mais aussi un Imagenae.",
          "next": [
            150090110
          ]
        },
        "150090110": {
          "id": 150090110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Vous vous souvenez ? Vous êtes tombé{F#e} dessus quand vous êtes passé{F#e} sur la place.",
          "next": [
            150090115
          ]
        },
        "150090111": {
          "id": 150090111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comment ça ? Vous vous trompez de personne.",
          "next": [
            150090112
          ]
        },
        "150090112": {
          "id": 150090112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Impossible de se tromper, votre silhouette héroïque en train de sauver les <i>Chroniques des graisses flottantes</i> est apparue sur le livre.",
          "next": [
            150090113
          ]
        },
        "150090113": {
          "id": 150090113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ce n'est pas une blague, vous pouvez venir voir par vous-même sur la place.",
          "next": [
            150090114
          ]
        },
        "150090114": {
          "id": 150090114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Les <i>Chroniques des graisses flottantes</i> sont un livre, mais aussi un Imagenae.",
          "next": [
            150090115
          ]
        },
        "150090115": {
          "id": 150090115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Il se trouve au milieu de la pelouse sur la place, vous pouvez venir quand vous voulez.",
          "next": [
            150090116
          ]
        },
        "150090116": {
          "id": 150090116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Tout comme le texte que vous venez d'obtenir.",
          "next": [
            150090117
          ]
        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "L'ouvrage perdu des <i>Chroniques des graisses flottantes</i> recèle de précieux mythes concernant les prémices de l'ancienne civilisation Benzaitengoku.",
          "next": [
            150090118
          ]
        },
        "150090118": {
          "id": 150090118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Alors, on se voit là-bas.",
          "next": []
        }
      },
      "participatingContactsIds": [
        205,
        8001
      ]
    }
  ]
}