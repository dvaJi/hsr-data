        "202510005": {
          "id": 202510005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie est en train d'écrire...",
          "next": [
            202510006,
            202510007
          ]
        },
        "202510006": {
          "id": 202510006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alors ? Ça ne vous ressemble pas d'hésiter",
          "next": [
            202510008
          ]
        },
        "202510007": {
          "id": 202510007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vous êtes en pleine réflexion ?",
          "next": [
            202510008
          ]
        },
        "202510008": {
          "id": 202510008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "J'ai reçu un tableau",
          "next": [
            202510009
          ]
        },
        "202510009": {
          "id": 202510009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Il y a quelque temps, un portraitiste de rue m'a demandé de poser pour lui et a réalisé une œuvre intitulée « Perle »",
          "next": [
            202510010
          ]
        },
        "202510010": {
          "id": 202510010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "L'usage des espaces vides dans cette œuvre est empreint d'une incroyable tension...",
          "next": [
            202510011
          ]
        },
        "202510011": {
          "id": 202510011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Tout simplement parce que l'artiste s'est contenté d'inciser la toile d'un coup de lame",
          "next": [
            202510012
          ]
        },
        "202510012": {
          "id": 202510012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Réflexion : le lien entre cette œuvre et moi serait...",
          "next": [
            202510013,
            202510016
          ]
        },
        "202510013": {
          "id": 202510013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "L'art, c'est vraiment trop difficile à comprendre",
          "next": [
            202510014
          ]
        },
        "202510014": {
          "id": 202510014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Une seule entaille... remarquez, ce serait idéal pour y placer une boîte de mouchoirs. Il a peut-être voulu faire passer un message...",
          "next": [
            202510015
          ]
        },
        "202510015": {
          "id": 202510015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du genre : « Perle, vous pouvez m'en tirer un ? »",
          "next": [
            202510019
          ]
        },
        "202510016": {
          "id": 202510016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "L'art, c'est vraiment trop facile à comprendre, en fait",
          "next": [
            202510017
          ]
        },
        "202510017": {
          "id": 202510017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Une entaille qui déchire l'espace... ça ne ressemblerait pas un peu à un portefeuille ouvert ?",
          "next": [
            202510018
          ]
        },
        "202510018": {
          "id": 202510018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Il suffit d'y plonger la main pour toujours en tirer quelque chose...",
          "next": [
            202510019
          ]
        },
        "202510019": {
          "id": 202510019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510020
          ]
        },
        "202510020": {
          "id": 202510020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Hypothèse : c'était donc un marchand de boîtes mystères déguisé en peintre. Pas étonnant qu'il m'ait arrêtée en pleine rue",
          "next": [
            202510021
          ]
        },
        "202510021": {
          "id": 202510021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mais ton interprétation est intéressante",
          "next": [
            202510022
          ]
        },
        "202510022": {
          "id": 202510022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Art : la déconstruction de la vie",
          "next": [
            202510023
          ]
        },
        "202510023": {
          "id": 202510023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Interpréter l'art : désigne également la déconstruction de l'art",
          "next": [
            202510024
          ]
        },
        "202510024": {
          "id": 202510024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Objection : déconstruire l'art donne-t-il des réponses ?",
          "next": [
            202510025
          ]
        },
        "202510025": {
          "id": 202510025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Peut-être pas. Verdict : il faut déconstruire la déconstruction de l'art",
          "next": [
            202510026,
            202510027
          ]
        },
        "202510026": {
          "id": 202510026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Qu'est-ce que je viens de déclencher ? Dites à votre cerveau de s'arrêter !",
          "next": [
            202510028
          ]
        },
        "202510027": {
          "id": 202510027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh non. Qu'est-ce que j'ai fait, vous avez buggé",
          "next": [
            202510028
          ]
        },
        "202510028": {
          "id": 202510028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510029
          ]
        },
        "202510029": {
          "id": 202510029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ne t'inquiète pas. Tu m'as simplement inspirée, et je me suis laissé emporter dans une petite digression abstraite",
          "next": [
            202510030
          ]
        },
        "202510030": {
          "id": 202510030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Mais j'ai bel et bien une toute nouvelle compréhension de cette œuvre, désormais...",
          "next": [
            202510031
          ]
        },
        "202510031": {
          "id": 202510031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Peut-être qu'elle veut dire la chose suivante :",
          "next": [
            202510032
          ]
        },
        "202510032": {
          "id": 202510032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "« Ouvre-toi, coquillage, je suis ta perle. »",
          "next": [
            202510033
          ]
        },
        "202510033": {
          "id": 202510033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510034
          ]
        },
        "202510034": {
          "id": 202510034,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie est hors ligne",
          "next": []
        }
