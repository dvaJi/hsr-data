  "sections": [
    {
      "id": 2024500,
      "startingMessageId": [
        202450000
      ],
      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Déjeuner d'oisillon du jour : maïs, quinoa et purée de petits pois (ne pas oublier de boire de l'eau !)",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est beaucoup de légumes. J'ai pas vu une seule trace de viande là-dedans",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alors c'est ce que tu manges pour protéger ta voix ? Tu es exigeante avec toi-même, pas étonnant que tu sois une si grande star !",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Désolée ! Je voulais me l'envoyer à moi-même, mais je me suis trompée de conversation",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tu te souviens quand je t'ai dit que j'avais trouvé un petit oisillon avec une aile cassée ?",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Cette recette n'est pas pour moi. Je l'ai préparée pour le petit oiseau",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tout va mieux maintenant, et ses plumes ont repoussé",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Je suis presque chez moi. Tu veux voir comment ça se passe ?",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin et l'oisillon. Oh, c'est trop mignon",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Il doit être bien dodu maintenant !",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie Robin est hors ligne",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie Robin est en ligne",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie est en train d'écrire...",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Je suis rentrée, mais le petit oiseau est parti",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Il a dû s'envoler par la fenêtre ouverte",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ah... ne sois pas triste. Peut-être qu'il est prêt à voler de ses propres ailes maintenant",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Merci pour le réconfort. Je pensais comme toi",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "J'attendais avec impatience le jour où il volerait à nouveau librement",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Même si c'est arrivé un peu soudainement... toi aussi, tu attendais de le voir s'élancer à nouveau dans les cieux, n'est-ce pas ?",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Je savais que tu comprendrais",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Le petit oiseau commence sa nouvelle vie ! Il ne t'oubliera jamais",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tout à fait ! En fait, j'attendais avec impatience le jour où il s'envolerait à nouveau librement",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Avant, il volait jusqu'au rebord de la fenêtre et regardait le monde. Cette fois, je crois qu'il était enfin prêt",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "C'est dommage que je n'aie pas pu le voir déployer ses ailes et prendre son envol...",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Cui, cui ! Hou, hou ! Cui ! Cui !",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Message vocal converti en texte (notes aiguës détectées)",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, ce sont les trois petits musiciens à mes côtés",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ils disent que l'oiseau devait être magnifique lorsqu'il s'est envolé",
          "next": [
            202450029
          ]
        },
        "202450029": {
          "id": 202450029,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
