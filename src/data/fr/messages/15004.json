        "150040102": {
          "id": 150040102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "@{NICKNAME} @March 7th Tout va bien ?",
          "next": [
            150040103
          ]
        },
        "150040103": {
          "id": 150040103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "J'ai entendu dire que vous aviez eu quelques ennuis",
          "next": [
            150040104
          ]
        },
        "150040104": {
          "id": 150040104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Quel est le problème ?",
          "next": [
            150040105
          ]
        },
        "150040105": {
          "id": 150040105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "On va bien {F#toutes}{M#tous} les deux, mais on a croisé une certaine Sparxie",
          "next": [
            150040106
          ]
        },
        "150040106": {
          "id": 150040106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Elle a dit qu'elle en finirait avec {NICKNAME} et moi, et qu'elle ferait en sorte que l'équipage de l'Express ne participe pas aux Jeux Fabulunaires",
          "next": [
            150040107
          ]
        },
        "150040107": {
          "id": 150040107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Alors on ferait mieux de se dépêcher, et vite !",
          "next": [
            150040108
          ]
        },
        "150040108": {
          "id": 150040108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Donc, vous avez pris votre décision ?",
          "next": [
            150040109
          ]
        },
        "150040109": {
          "id": 150040109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "J'ai quelques idées, mais je ne sais pas ce qu'en pense {NICKNAME}",
          "next": [
            150040110
          ]
        },
        "150040110": {
          "id": 150040110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Je veux participer aux Jeux Fabulunaires",
          "next": [
            150040111
          ]
        },
        "150040111": {
          "id": 150040111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Je me demande ce que je pourrais faire avec ce pouvoir si je gagnais, ou ce que je pourrais demander à Aha de faire pour moi",
          "next": [
            150040112
          ]
        },
        "150040112": {
          "id": 150040112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "On en rediscutera quand on aura le temps",
          "next": [
            150040113
          ]
        },
        "150040113": {
          "id": 150040113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comment ça va de ton côté, @Dan Heng ?",
          "next": [
            150040114
          ]
        },
        "150040114": {
          "id": 150040114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "J'ai contacté l'émissaire de Xianzhou, mais ils ont eux aussi rencontré quelques problèmes et cherchent de l'aide.",
          "next": [
            150040115
          ]
        },
        "150040115": {
          "id": 150040115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sunday et moi sommes en route.",
          "next": [
            150040116
          ]
        },
        "150040116": {
          "id": 150040116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Si besoin, n'hésitez pas à me contacter.",
          "next": [
            150040117
          ]
        },
        "150040117": {
          "id": 150040117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Alors, Himeko, qu'est-ce qu'on fait maintenant ?",
          "next": [
            150040118
          ]
        },
        "150040118": {
          "id": 150040118,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "J'aimerais que vous alliez à l'Académie Graphia. C'est mon ancienne école.",
          "next": [
            150040119
          ]
        },
        "150040119": {
          "id": 150040119,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Adresse de l'Académie Graphia]",
          "next": [
            150040120
          ]
        },
        "150040120": {
          "id": 150040120,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Une professeure du nom de madame Poupette travaillait dans cette école.",
          "next": [
            150040121
          ]
        },
        "150040121": {
          "id": 150040121,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "C'est mon amie, celle qui garde le masque requis pour les Jeux Fabulunaires.",
          "next": [
            150040122
          ]
        },
        "150040122": {
          "id": 150040122,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Afin de ne pas laisser le temps jouer contre nous, vous devez la trouver et récupérer le masque immédiatement.",
          "next": [
            150040123
          ]
        },
        "150040123": {
          "id": 150040123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Allons-y !",
          "next": [
            150040124
          ]
        },
        "150040124": {
          "id": 150040124,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Welt et moi, on vous rejoindra.",
          "next": []
        }
