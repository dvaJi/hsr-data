          ]
        },
        "202410029": {
          "id": 202410029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "J'ai encore une douzaine de perruques en réserve... À la fac, quand Motoko et moi étions fatiguées de nos plans et réparations, on fabriquait et coiffait toutes sortes de perruques pour les essayer à tour de rôle",
          "next": [
            202410030
          ]
        },
        "202410030": {
          "id": 202410030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Vous changez de sujet !",
          "next": [
            202410031
          ]
        },
        "202410031": {
          "id": 202410031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "J'ai enfin une bonne excuse pour les sortir et vous les montrer à tous. J'adorerais savoir quels styles et couleurs de cheveux vous plaisent",
          "next": [
            202410032
          ]
        },
        "202410032": {
          "id": 202410032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Même si ce n'est pas un ajustement parfait, j'ai quand même mon sens du style. Je peux faire des retouches sur le moment",
          "next": [
            202410033
          ]
        },
        "202410033": {
          "id": 202410033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Une fois que tout le monde sera de retour à bord de l'Astral Express, je prendrai les choses en main",
          "next": [
            202410034
          ]
        },
