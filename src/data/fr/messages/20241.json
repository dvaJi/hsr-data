      "messages": {
        "202410000": {
          "id": 202410000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Je rangeais ma valise quand je suis tombée sur une carte de membre à vie valable dans tous les salons de coiffure de Planarcadia",
          "next": [
            202410001
          ]
        },
        "202410001": {
          "id": 202410001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "À qui devrais-je la donner ?",
          "next": [
            202410002,
            202410004,
            202410007
          ]
        },
        "202410002": {
          "id": 202410002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "À moi ! Je suis {M#le seul mineur}{F#la seule mineure} du train !",
          "next": [
            202410003
          ]
        },
        "202410003": {
          "id": 202410003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Je savais que ça te plairait ! Tiens, c'est à toi. Tu pourrais même emmener tout le monde se faire coiffer plus tard",
          "next": [
            202410009
          ]
        },
        "202410004": {
          "id": 202410004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Voyons voir... March va forcément adorer, Dan Heng ne dira sûrement pas non, Sunny est assez soigné, et puis monsieur Yang a des cheveux aussi...",
          "next": [
            202410005
          ]
        },
        "202410005": {
          "id": 202410005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Vous devriez simplement me la donner ! J'emmènerai tout le monde se faire relooker",
          "next": [
            202410006
          ]
        },
        "202410006": {
          "id": 202410006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Parfait ! Je pensais exactement la même chose !",
          "next": [
            202410009
          ]
        },
        "202410007": {
          "id": 202410007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Toute la famille de l'Astral Express pourra s'asseoir à tour de rôle dans le fauteuil du styliste en chef. Relooking général !",
          "next": [
            202410008
          ]
        },
        "202410008": {
          "id": 202410008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "C'est exactement ce que je me disais",
          "next": [
            202410009
          ]
        },
        "202410009": {
          "id": 202410009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "À l'époque où j'étudiais à Planarcadia, j'adorais expérimenter différentes coiffures",
          "next": [
            202410010
          ]
        },
        "202410010": {
          "id": 202410010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Je me souviens m'être teint les cheveux d'une couleur très similaire à celle de March. J'avais même envie d'essayer une coupe courte comme celle de Dan Heng, mais mon coiffeur s'y est opposé bec et ongles",
          "next": [
            202410011
          ]
        },
        "202410011": {
          "id": 202410011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Le résultat final ressemblait davantage à une coupe mulet, un peu comme celle de Sunday",
          "next": [
            202410012
          ]
        },
        "202410012": {
          "id": 202410012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "En y repensant... C'était vraiment attentionné de leur part d'avoir remis cette carte en guise de frais de protection",
          "next": [
            202410013,
            202410019,
            202410024
          ]
        },
        "202410013": {
          "id": 202410013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je veux voir le catalogue complet de vos coiffures ! Vous avez des photos ?",
          "next": [
            202410014
          ]
        },
        "202410014": {
          "id": 202410014,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202410015
          ]
        },
        "202410015": {
          "id": 202410015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Comment ça, des frais ???",
          "next": [
            202410016
          ]
        },
        "202410016": {
          "id": 202410016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Hmm ? Oh, c'est juste un souvenir amical que j'ai reçu quand j'étais étudiante",
          "next": [
            202410017
          ]
        },
        "202410017": {
          "id": 202410017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ça, c'est de l'amitié de qualité !",
          "next": [
            202410018
          ]
        },
        "202410018": {
          "id": 202410018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Quant aux photos, je ne me souviens plus si j'en ai apporté à bord de l'Astral Express, mais je peux jeter un œil",
          "next": [
            202410029
          ]
        },
        "202410019": {
          "id": 202410019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vous avez des conseils coiffure, Himeko ? J'ai envie de changer un peu ma tignasse",
          "next": [
            202410020
          ]
        },
        "202410020": {
