        "202170001": {
          "id": 202170001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Tadaaam !",
          "next": [
            202170002
          ]
        },
        "202170002": {
          "id": 202170002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "On se débarrasse pas d'une fille comme moi si facilement",
          "next": [
            202170003
          ]
        },
        "202170003": {
          "id": 202170003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Encore une belle journée. Il ne manque que des fleurs pour qu'elle soit parfaite ♪",
          "next": [
            202170004
          ]
        },
        "202170004": {
          "id": 202170004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1415,
          "next": [
            202170005
          ]
        },
        "202170005": {
          "id": 202170005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ah, j'ai vraiment beaucoup réfléchi au choix de ce bouquet",
          "next": [
            202170006
          ]
        },
        "202170006": {
          "id": 202170006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Il y a une rose de cristal prismatique, née d'une seule graine et soigneusement cultivée de mes propres mains",
          "next": [
            202170007
          ]
        },
        "202170007": {
          "id": 202170007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Héhé, et des fleurs d'anthéline du jardin de Castorice. Chaque pétale scintille de gouttes de rosée",
          "next": [
            202170008
          ]
        },
        "202170008": {
          "id": 202170008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Des tournesols et des cloches de canterbury du jardin de Hyacine. C'est comme un doux rayon de soleil",
          "next": [
            202170009
          ]
        },
        "202170009": {
          "id": 202170009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Et il y a des lys bleus, des gypsophiles paniculées, des campanules blanches...",
          "next": [
            202170010
          ]
        },
        "202170010": {
          "id": 202170010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Héhé, et essaye de deviner ce que je préfère avec ça...?",
          "next": [
            202170011
          ]
        },
        "202170011": {
          "id": 202170011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Tadaaa ! Une gerbe de blé de l'Élysée mystérieuse !",
          "next": [
            202170012
          ]
        },
        "202170012": {
          "id": 202170012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, n'oublie pas de fermer les yeux quand tu la recevras. L'odeur du blé te transportera directement dans ce petit village",
          "next": [
            202170013
          ]
        },
        "202170013": {
          "id": 202170013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Comme lorsqu'on faisait de la balançoire, que les vagues s'écrasaient sur le rivage lointain et que les champs de blé s'étendaient sous nos pieds...",
          "next": [
            202170014
          ]
        },
        "202170014": {
          "id": 202170014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "À toi de découvrir le reste des surprises !",
          "next": [
            202170015
          ]
        },
        "202170015": {
          "id": 202170015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Même si je ne peux pas être là avec toi, assure-toi de bien lire le message sur la carte, d'accord ?",
          "next": [
            202170016
          ]
        },
        "202170016": {
          "id": 202170016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Que les fleurs t'accompagnent chaque jour, {NICKNAME} ♪",
          "next": [
            202170017,
            202170018,
            202170019
          ]
        },
        "202170017": {
          "id": 202170017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Merci, Cyrène",
          "next": [
            202170020
          ]
        },
        "202170018": {
          "id": 202170018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'ai bien reçu ton geste touchant",
          "next": [
            202170020
          ]
        },
        "202170019": {
          "id": 202170019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je le garderai précieusement !",
          "next": [
            202170020
          ]
        },
        "202170020": {
          "id": 202170020,
          "type": "Text",
