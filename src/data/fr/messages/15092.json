          ]
        },
        "150920102": {
          "id": 150920102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bref, revenons à nos moutons, j'ai reçu une lettre anonyme d'un inconnu.",
          "next": [
            150920103
          ]
        },
        "150920103": {
          "id": 150920103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ce n'est ni une menace ni une arnaque.",
          "next": [
            150920104
          ]
        },
        "150920104": {
          "id": 150920104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Mais on dirait que ça a un lien avec les <i>Chroniques des graisses flottantes</i> ?",
