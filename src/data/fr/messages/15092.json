            150920105,
            150920108,
            150920111
          ]
        },
        "150920105": {
          "id": 150920105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Attends, t'es qui toi ? Je te connais ?",
