  "sections": [
    {
      "id": 2025500,
      "startingMessageId": [
        202550000
      ],
      "messages": {
        "202550000": {
          "id": 202550000,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 241,
          "next": [
            202550001
          ]
        },
        "202550001": {
          "id": 202550001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Me revoilà !",
          "next": [
            202550002
          ]
        },
        "202550002": {
          "id": 202550002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Récupérer ce vieux compte m'a demandé quelques efforts, mais ça en valait vraiment la peine.",
          "next": [
            202550003
          ]
        },
        "202550003": {
          "id": 202550003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Héhé",
          "next": [
            202550004,
            202550005,
            202550006
          ]
        },
        "202550004": {
          "id": 202550004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et pourquoi il y a cinq étoiles, maintenant ?",
          "next": [
            202550007
          ]
        },
        "202550005": {
          "id": 202550005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "T'as réussi à semer ces créanciers qui te couraient après ?",
          "next": [
            202550009
          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hé hé... tu as trouvé quelque chose d'intéressant ? Peut-être qu'il reste assez d'argent sur ce compte pour rembourser tes dettes ?",
          "next": [
            202550011
          ]
        },
        "202550007": {
          "id": 202550007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Plus il y en a, mieux c'est ! Cinq étoiles, c'est une bonne note !",
          "next": [
            202550008
          ]
        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "C'est juste. Faut bien compenser les avis à une seule étoile des créanciers d'une façon ou d'une autre.",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Non, mais je ferai de mon mieux pour être à la hauteur de leurs attentes.",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Oh, c'est ça que tu appelles une attente ?",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Oulà, tu as la langue bien acérée, représentant{F#e}.",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Regarde juste ce mémo. Il vaut plus que dix ans de travail réunis.",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Des archives exclusives d'Éclaireurs en train de critiquer ouvertement leurs propres Aiôns, des images compromettantes prises sur le vif... c'est du contenu de premier choix.",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Comment j'ai pu perdre ce compte à l'époque...",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Arrête d'en parler, envoie-moi ça tout de suite !",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu dessines un nouveau chapitre de tes légendes farfelues ?",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Allez, Ana, on a besoin d'une petite mise à jour s'il te plaîîît !",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Pas si vite, je vais d'abord te partager quelque chose.",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "En fait, c'est pas si dingue que ça.",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "J'ai des projets bien plus ambitieux ! Les histoires des autres sont toujours bien plus divertissantes que les miennes. Par exemple...",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Oh, j'ai tellement de matière maintenant. J'ai l'impression d'avoir aussi de nouvelles idées pour <i>Parfum du remède au vent</i>...",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Laisse-moi d'abord te partager ça.",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Il y a des centaines d'ères de l'Ambre, un Fictionniste de l'histoire a laissé ses dernières paroles derrière lui...",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Tayzzyronth se tordait et rampait, parcourant des milliers de kilomètres chaque jour, et tout ça pour une planète sans nom... »",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Entre-temps, Ena et Xipe s'étaient mis en embuscade, tapis quelque part dans l'ombre aux abords de la planète... »",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Leur chemin croisa celui d'Ouroboros de façon inattendue. Quand les dieux se firent face, la tension monta d'un cran. Des étincelles jaillirent, tout ça à cause d'une seule personne... »",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Aha était juste là. »",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Arrête de te jeter des fleurs, Aha !",
          "next": [
            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est encore une de tes légendes à dormir debout ? Pourquoi tu refais le même coup ?!",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Honnêtement, ça commence à me lasser. T'as quelque chose de nouveau ?",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Je n'ai pas encore terminé... La vérité qu'aucun historien n'a jamais pu découvrir : « Les dieux convoitaient la planète sans nom car... »",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Tous les premiers scripts d'entraînement, carnets de croquis et fan arts d'Aha étaient planqués là-dedans. »",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "« Lui, souhaitait y prendre racine. Lui, souhaitait festoyer seul. Lui, ne cherchait qu'à obtenir... »",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Héhé, après tout, c'est moi qui ai dessiné tout ça à l'époque.",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "J'en ai quelques-uns de prêts dans mon mémo. Attends une seconde, je te les envoie.",
          "next": [
            202550036
          ]
        },
        "202550036": {
          "id": 202550036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Je vais aller droit au but. Je ne veux pas épuiser mon forfait téléphonique.",
          "next": [
            202550037
          ]
        },
        "202550037": {
          "id": 202550037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre amie est en train d'écrire...",
          "next": [
            202550038
          ]
        },
        "202550038": {
          "id": 202550038,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le système a bloqué ce contenu.",
          "next": [
            202550039,
            202550040
          ]
        },
        "202550039": {
          "id": 202550039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Le contenu est trop osé, ou t'as vraiment plus de forfait ?",
          "next": [
            202550041
          ]
        },
        "202550040": {
          "id": 202550040,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Le contenu est trop osé, ou t'as vraiment plus de forfait ?",
          "next": [
            202550041
          ]
        },
        "202550041": {
          "id": 202550041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Échec de l'envoi du message.",
          "next": [
            202550042
          ]
        },
        "202550042": {
          "id": 202550042,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Activité anormale détectée sur ce compte. Comportement frauduleux identifié. L'accès a été suspendu.",
          "next": []
        }
      },
      "participatingContactsIds": [
        241,
