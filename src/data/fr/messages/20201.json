            202010015,
            202010018
          ]
        },
        "202010005": {
          "id": 202010005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'ai une question : quels sont les trois mots qui peuvent répondre à toutes les questions ?",
