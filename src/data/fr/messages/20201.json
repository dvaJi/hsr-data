          ]
        },
        "202010003": {
          "id": 202010003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Le point d'interrogation est vraiment le symbole le plus merveilleux au monde. Il matérialise les limites cognitives des humains et constitue la porte d'entrée de tous les mystères non élucidés.",
          "next": [
            202010004
          ]
        },
        "202010004": {
          "id": 202010004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tu as d'autres questions ?",
          "next": [
