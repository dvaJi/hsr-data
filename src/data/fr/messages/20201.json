            202010006
          ]
        },
        "202010006": {
          "id": 202010006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "L'utilisateur cherche la réponse universelle, je dois donc répondre ainsi :",
          "next": [
            202010007
          ]
        },
        "202010007": {
          "id": 202010007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Je ne sais pas",
          "next": [
            202010008
          ]
        },
        "202010008": {
          "id": 202010008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tu as d'autres questions ?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010009": {
          "id": 202010009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Professeur, c'est vous qui m'interrogez, je n'ai aucune question !",
          "next": [
            202010010
          ]
        },
        "202010010": {
          "id": 202010010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "L'utilisateur essaie d'éviter la question, je devrais donc répondre comme ceci :",
          "next": [
            202010011
          ]
        },
        "202010011": {
          "id": 202010011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Aucune question ? C'est justement LA question.",
          "next": [
            202010012
          ]
        },
        "202010012": {
          "id": 202010012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Tu as d'autres questions ?",
          "next": [
            202010013,
