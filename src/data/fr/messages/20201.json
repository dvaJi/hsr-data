            202010021
          ]
        },
        "202010015": {
          "id": 202010015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Veuillez générer une photo du Professeur Anaxa. Contenu : Une précieuse image du Professeur Anaxa chevauchant un draka, attaquant Acrokopis",
