            202010016
          ]
        },
        "202010016": {
          "id": 202010016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "L'utilisateur demande de générer des photos, donc je devrais répondre comme ceci :",
          "next": [
            202010017
