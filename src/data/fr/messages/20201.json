        "202010021": {
          "id": 202010021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Vous avez atteint la limite de questions. La séance de questions quotidienne est terminée, place à l'évaluation à présent.",
