      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Bonjour, protagoniste.",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Si tu lis ce message programmé, c'est que mon plan est tombé sur un os... encore une fois",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Bien sûr, on ne peut pas non plus exclure que le Stellaron t'ait déjà fait exploser et que, en ce moment même, celui qui lit ce message soit mon moi du futur",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Mais ton téléphone n'est pas de si bonne qualité",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asat Pramad ? Pourquoi c'est encore toi ?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ton plan est fichu, et on t'a battu !",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "« Le compte que vous avez contacté n'existe pas. Échec de l'envoi du message. »",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Pour être honnête, ce rebondissement me va",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Au contraire, j'ai hâte de te voir gagner",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ça prouvera peut-être que j'ai tort",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Enfin, si tu arrives à terminer ce jeu",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Qu'importe le vainqueur, il se réveillera et nous dévorera tous tout crus",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je sais que tu ne reçois pas les messages, mais j'ai quand même envie de savoir... pourquoi faire tout ça ?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je suis sûr{F#e} que tu devines ce que je veux te demander.",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "« Le compte que vous avez contacté n'existe pas. Échec de l'envoi du message. »",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Heh... pourquoi est-ce que je fais tout ça ?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Puisqu'Aha se cache dans les coulisses et ignore la pourriture du monde, j'agirai à sa place et je défierai le cosmos.",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Et maintenant, le nouveau défi s'intitule : vaincre la Voracité ressuscitée",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Est-ce qu'{M#un héros né}{F#une héroïne née} de la Destruction, quelqu'un qui affronterait d'innombrables épreuves et ramènerait la véritable Allégresse dans ce monde.",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ou la bête mènera-t-elle sa vengeance à bien pour que l'Allégresse connaisse une fin digne avant de sombrer dans la folie ?",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Protagoniste, peux-tu écrire une meilleure chute à cette blague ?",
          "next": []
        }
      },
