            150670102,
            150670103
          ]
        },
        "150670102": {
          "id": 150670102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Merci à vous aussi",
          "next": [
            150670104
          ]
        },
        "150670103": {
          "id": 150670103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'était pas grand-chose. Tout ça, c'est pour le cosmos !",
          "next": [
            150670104
          ]
        },
        "150670104": {
          "id": 150670104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "On t'a déjà dit que tu parlais comme une vraie bureaucrate ces derniers temps ?",
          "next": [
            150670105
          ]
        },
        "150670105": {
          "id": 150670105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "@Blade, dis quelque chose toi aussi",
          "next": [
            150670106
          ]
        },
        "150670106": {
          "id": 150670106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Merci",
          "next": [
            150670107
          ]
        },
        "150670107": {
          "id": 150670107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Pourquoi tu es si timide ? Dis-en un peu plus",
          "next": [
            150670108
          ]
        },
        "150670108": {
          "id": 150670108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "En un peu plus",
          "next": [
            150670109
          ]
        },
        "150670109": {
          "id": 150670109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            150670110
          ]
        },
        "150670110": {
          "id": 150670110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Il est tellement stressé qu'il essaie même de faire des blagues.",
          "next": [
            150670111
          ]
        },
        "150670111": {
          "id": 150670111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Ah, au fait, {NICKNAME}, ce cadeau que je t'avais donné au début de ton voyage ? Il n'en reste plus rien",
          "next": [
            150670112,
            150670113
          ]
        },
        "150670112": {
          "id": 150670112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un Stellaron ?",
          "next": [
            150670114
          ]
        },
        "150670113": {
          "id": 150670113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Quel est le problème ?",
          "next": [
            150670114
          ]
        },
        "150670114": {
          "id": 150670114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Elio pensait pouvoir retarder l'échéance encore un peu, mais il ne s'attendait pas à ce que ce soit à cet arrêt...",
          "next": [
            150670115
          ]
        },
        "150670115": {
          "id": 150670115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Mais, à quel prix ?",
          "next": [
            150670117,
            150670116
          ]
        },
        "150670116": {
          "id": 150670116,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ne t'inquiète pas, tout va bien se passer",
          "next": [
            150670118
          ]
        },
        "150670117": {
          "id": 150670117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je vais avancer pas à pas, ne t'inquiète pas pour moi",
          "next": [
            150670118
          ]
        },
        "150670118": {
          "id": 150670118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "J'abandonne. Contacte-moi si t'as besoin de quoi que ce soit, Louve αlpha est toujours là",
