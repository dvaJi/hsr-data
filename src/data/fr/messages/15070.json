  "sections": [
    {
      "id": 1507001,
      "startingMessageId": [
        150700100
      ],
      "messages": {
        "150700100": {
          "id": 150700100,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tout va bien à Astropolis ces derniers temps ? En fait, je voulais te demander un service.",
          "next": [
            150700101
          ]
        },
        "150700101": {
          "id": 150700101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Le travail se calme enfin, alors je profite de mes vacances pour souffler un peu.",
          "next": [
            150700102
          ]
        },
        "150700102": {
          "id": 150700102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Qu'est-ce que je peux faire pour toi ?",
          "next": [
            150700103
          ]
        },
        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Il y a une star de cinéma à Astropolis qui se fait appeler le Saint Wubbabou. Ça te dit quelque chose ?",
          "next": [
            150700104
          ]
        },
        "150700104": {
          "id": 150700104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Si ce n'est pas trop te demander, j'espérais que tu puisses me le présenter.",
          "next": [
            150700105
          ]
        },
        "150700105": {
          "id": 150700105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Le Saint Wubbabou ? Oui, je le connais.",
          "next": [
            150700106
          ]
        },
        "150700106": {
          "id": 150700106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mon manager avait déjà discuté d'un partenariat commercial avec les Studios Cartelles, il s'agissait d'interpréter un morceau de la bande originale pour leur nouvelle production.",
          "next": [
            150700107
          ]
        },
        "150700107": {
          "id": 150700107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Compte sur moi ! Attends un instant !",
          "next": [
            150700108
          ]
        },
        "150700108": {
          "id": 150700108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "On a de la chance, le Saint Wubbabou se détend à la Tour de l'aiguille cet après-midi.",
          "next": [
            150700109
          ]
        },
        "150700109": {
          "id": 150700109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Je t'ai organisé un rendez-vous, tu as juste à aller le voir directement.",
          "next": [
            150700110,
            150700111
          ]
        },
        "150700110": {
          "id": 150700110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu me sauves la vie, merci mille fois pour ton aide !",
          "next": []
        },
        "150700111": {
          "id": 150700111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu es tout simplement formidable, Robin !",
          "next": []
        }
      },
