            202020006
          ]
        },
        "202020006": {
          "id": 202020006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Tout va bien ! Ica vient juste de grimper sur ma jambe et d'appuyer sur mes raccourcis clavier",
          "next": [
            202020007
          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Mais je compte bien te retrouver ! Après tout, la bataille décisive ne sera pas une promenade de santé",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Tes blessures guérissent bien ? Tu dors assez ? Comment va ton appétit ? Tu ressens de la fatigue au travail ? D'autres gênes à signaler ?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je vais super bien !",
          "next": [
            202020010
          ]
        },
        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Me voilà rassurée !",
          "next": [
            202020018
          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'adore dormir et manger, mais pas vraiment faire de l'exercice... Il y a encore de l'espoir pour moi ?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Si ton corps a besoin de dormir, laisse-le se reposer ! {M#Tu dois être épuisé, ne te force pas à rester éveillé}{F#Tu dois être épuisée, ne te force pas à rester éveillée}",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Si tu veux quelque chose de sain et délicieux, il y a bien une autre solution",
          "next": [
            202020014
          ]
        },
        "202020014": {
          "id": 202020014,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020015": {
          "id": 202020015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Comment remédier à un manque de motivation au travail ?",
          "next": [
            202020016
          ]
        },
        "202020016": {
          "id": 202020016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Trop de pression ? C'est du gâteau !",
          "next": [
            202020017
          ]
        },
        "202020017": {
          "id": 202020017,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020018": {
          "id": 202020018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Viens à la Cour du crépuscule ! Je te préparerai quelques gourmandises !",
          "next": [
            202020019
          ]
        },
        "202020019": {
          "id": 202020019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "On peut encore profiter des rayons du soleil, sentir la brise et compter les tintements des carillons dans le vent",
          "next": [
            202020020
          ]
        },
        "202020020": {
          "id": 202020020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Allume un autre de mes encens aux herbes du crépuscule",
          "next": [
            202020021
          ]
        },
        "202020021": {
          "id": 202020021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Installe-toi dans le fauteuil à bascule douillet et profite des berceuses d'Ica",
          "next": [
            202020022,
            202020025
          ]
        },
        "202020022": {
          "id": 202020022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'arrive tout de suite !",
          "next": [
            202020023
          ]
        },
        "202020023": {
          "id": 202020023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Très bien, on t'attendra avec Ica",
          "next": [
            202020024
          ]
        },
