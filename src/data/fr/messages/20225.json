            202250001
          ]
        },
        "202250001": {
          "id": 202250001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Je vais profiter de cette chance, et pour célébrer cette série de mille victoires consécutives, je vais promouvoir mon « coup chanceux »",
          "next": [
            202250002
          ]
        },
        "202250002": {
          "id": 202250002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Bien sûr, nous faisons nos propres plans et nous les menons à bien. Cette décision n'est pas gravée dans le marbre. Le plus important, c'est de s'amuser !",
          "next": [
            202250003
          ]
        },
        "202250003": {
          "id": 202250003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Si tu es complètement perdu{F#e}, autant tenter le coup !",
          "next": [
