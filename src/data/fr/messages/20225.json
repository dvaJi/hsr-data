        },
        "202250016": {
          "id": 202250016,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Souhaitez-moi bonne chance pour obtenir des cartes 5 étoiles, décrocher des produits dérivés en édition limitée et remporter des coffrets mystères en édition collector !",
          "next": [
            202250017
