            202040010
          ]
        },
        "202040009": {
          "id": 202040009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu te lances dans le hacking ?",
          "next": [
            202040010
          ]
        },
        "202040010": {
