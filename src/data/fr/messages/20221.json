          ]
        },
        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "La Bête du jugement dernier, Phantylie, Tombeau de fer...",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Je suis curieuse, qu'est-ce que tu as ressenti lors de ta « charmante » rencontre avec eux ?",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du fun. Même pas besoin de lever le petit doigt, juste à les fixer du regard",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Hmm, il existe bien des regards foudroyants, après tout",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rien du tout, malheureusement. mon cœur est imperturbable",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Hmm, quelle impartialité",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'y suis allé{F#e} étape par étape",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "L'autre me tape, puis je le tape, et voilà",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Je vois, au tour par tour",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "La destruction n'est pas un moment glorieux... mais sa beauté est indéniablement incontestable",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Tu vas persévérer sur cette voie et continuer ton exploration pionnière ?",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Jusqu'à... détruire la Destruction, c'est ça ?",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu veux nous rejoindre ? De toute façon, t'as déjà trahi la Destruction",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "J'attends ce jour avec impatience",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Cependant, si tu t'opposes à l'exploration pionnière",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu retourneras vers la Destruction ? Trahir deux fois, c'est pas une trahison, peut-être ?",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "C'est une super idée, j'adore",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Si tu te retrouves face à l'exploration pionnière",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Alors avance dans les feux d'artifice que tu as allumés",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Donc, comme le dit leur « script »",
          "next": [
            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
