        "202330009": {
          "id": 202330009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je suis {F#la conductrice}{M#le conducteur} : {F#la première}{M#le premier} à monter à bord de l'Astral Express !",
          "next": [
            202330010
          ]
        },
        "202330010": {
          "id": 202330010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Enfant, {NICKNAME} a embarqué à bord de l'Astral Express et a refusé d'en descendre.",
          "next": [
            202330011
          ]
        },
        "202330011": {
          "id": 202330011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Adolescent{F#e}, {NICKNAME} a su tirer l'Astral Express d'affaire d'une main de maître alors que l'univers était en crise.",
