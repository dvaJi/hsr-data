        "202330012": {
          "id": 202330012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Jeune adulte, {NICKNAME} est tombé{F#e} dans le piège d'un Aiôn et n'a pas pu s'en échapper.",
          "next": [
            202330013
          ]
        },
        "202330013": {
          "id": 202330013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "L'âge adulte a éveillé ses capacités, et {M#il}{F#elle} a juré de sauver le monde.",
