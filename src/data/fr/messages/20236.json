  "sections": [
    {
      "id": 2023600,
      "startingMessageId": [
        202360000
      ],
      "messages": {
        "202360000": {
          "id": 202360000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Le plug-in « Détecteur de Blade » a été mis à jour.",
          "next": [
            202360001
          ]
        },
        "202360001": {
          "id": 202360001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nouveautés : Résolution de certains problèmes connus et ajout d'une fonctionnalité de réduction des vibrations.",
          "next": [
            202360002,
            202360003
          ]
        },
        "202360002": {
          "id": 202360002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eh bah, c'était rapide ! Encore plus que celle de ma version de jeu.",
          "next": [
            202360004
          ]
        },
        "202360003": {
          "id": 202360003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et au niveau de l'amortissement des vibrations ? Je vais essayer.",
          "next": [
            202360004
          ]
        },
        "202360004": {
          "id": 202360004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Vous avez envoyé un message et un wizz sur le téléphone de Blade, il a vibré une fois.",
          "next": [
            202360005
          ]
        },
        "202360005": {
          "id": 202360005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Vous envoyez un petit wizz à Blade, son téléphone vibre une fois.",
          "next": [
            202360006
          ]
        },
        "202360006": {
          "id": 202360006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Blade est en ligne.",
          "next": [
            202360007
          ]
        },
        "202360007": {
          "id": 202360007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Chut. Silence.",
          "next": [
            202360008
          ]
        },
        "202360008": {
          "id": 202360008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je surveille les écrans. Qu'est-ce qu'il y a encore ?",
          "next": [
            202360009,
            202360010,
            202360011
          ]
        },
        "202360009": {
          "id": 202360009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est le moment palpitant où tu repères les méchants sur les caméras de surveillance ?",
          "next": [
            202360013
          ]
        },
        "202360010": {
          "id": 202360010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Encore en mission ? T'es en mode traque intensive sur les caméras de surveillance ?",
          "next": [
            202360013
          ]
        },
        "202360011": {
          "id": 202360011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je te rassure, je ne t'enverrai pas de vocaux.",
          "next": [
            202360012
          ]
        },
        "202360012": {
          "id": 202360012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Qu'est-ce que tu regardes sur les écrans ? C'est le moment palpitant où tu regardes les gens sur les caméras de surveillance ?",
          "next": [
            202360013
          ]
        },
        "202360013": {
          "id": 202360013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Non.",
          "next": [
            202360014
          ]
        },
        "202360014": {
          "id": 202360014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360015
          ]
        },
        "202360015": {
          "id": 202360015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360016
          ]
        },
        "202360016": {
          "id": 202360016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je suis en train d'inspecter les images de surveillance de pât'patoune.",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu surveilles Gâteau au sésame ?",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ouaip.",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Et ça fait combien de temps que tu l'espionnes comme ça ?",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je n'ai pas regardé l'heure.",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh, c'est pât'patoune ! T'aurais dû le dire plus tôt !",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je te ferai entrer directement la prochaine fois.",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Très bien. Je te prends au mot.",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Qu'est-ce que tu as vu sur les vidéos ? Est-ce que Gâteau au sésame va bien ?",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Il s'est fait deux nouveaux amis.",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Il y en a un tout blanc. Apparemment, il est infatigable, avec un caractère bien trempé. Il adore s'écouter parler.",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "L'autre est rouge. Il ne parle pas beaucoup, mais a un sacré caractère aussi.",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ce n'est pas plus mal. D'ordinaire, Gâteau au sésame vient toujours tout seul.",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu leur as donné des noms ?",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Moi ?",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bon, appelons-les Flocon croustillant et Pudding aux dattes rouges.",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "En fait, ils te ressemblent un peu. Je veux dire, cette façon de parler en étant agacé.",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bon, nos nouveaux amis ont un nom ?",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je ne sais pas. Laisse-moi une minute.",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Que dirais-tu de Pudding aux dattes rouges et Flocon croustillant...",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360038
          ]
        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Eh bien, voilà qu'ils se battent entre eux.",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "On dirait que leur relation est un peu... tendue.",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tiens donc. Maintenant, ils se lèchent.",
          "next": [
            202360042
          ]
        },
        "202360042": {
          "id": 202360042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bon, c'était un malentendu. Ils sont en bons termes.",
          "next": [
            202360043
          ]
        },
        "202360043": {
          "id": 202360043,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami est en train d'écrire...",
          "next": [
            202360044
          ]
        },
        "202360044": {
          "id": 202360044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ils ont disparu.",
          "next": [
            202360045
          ]
        },
        "202360045": {
          "id": 202360045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ils ont peut-être remarqué que je les observais et se sont cachés.",
          "next": [
            202360046
          ]
        },
        "202360046": {
          "id": 202360046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Je vais vérifier les autres caméras.",
          "next": [
            202360047
          ]
        },
        "202360047": {
          "id": 202360047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "S'il n'y a rien d'urgent, alors à la prochaine.",
          "next": [
            202360048
          ]
        },
        "202360048": {
          "id": 202360048,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Votre ami Blade est hors ligne.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}