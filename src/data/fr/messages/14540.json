            145400001
          ]
        },
        "145400001": {
          "id": 145400001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "{M#Grisounet}{F#Grisounette}, dis bonjour à tout le monde",
          "next": [
            145400002,
            145400005
          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dans les combats de chimères, il faut laisser les compétences parler d'elles-mêmes",
          "next": [
            145400003
          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je vais vous battre tous et prouver que je suis {M#le meilleur dresseur}{F#la meilleure dresseuse} d'Amphoreus",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je viens juste de finir mes matchs de classement, je suis encore débutant{F#e}",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Soyez sympas avec moi",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hé partenaire, c'est rare de te croiser comme ça. Et si on réglait ça avec nos chimères ?",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hmpf, tâche de ne pas perdre trop lamentablement, {M#Libérateur}{F#Libératrice}",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Tu veux te mettre en travers de mon chemin ? Ah, on va voir si t'as le niveau",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Peu importe. Je vais éliminer tous les obstacles sur le chemin de l'Imperator",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hé Mystère-gris, ça te dit de conclure un marché ? Je vole la chimère de l'adversaire, et en échange tu perds volontairement le match",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Laisse tomber ces petites manigances, Ciphéra. Tu sais bien que tu ne peux rien cacher au fil d'or.",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Interdiction de tricher ou de magouiller ! <b>On</b> sera les arbitres et on vous surveille tous !",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Comment peut-on être à la fois arbitre et participant ?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Hmm... Tribbie va se battre, Trinnon sera l'arbitre, et Trianne attrapera les méchants. Voilà, c'est parfait !",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, moi aussi, je donnerai tout ce que j'ai dans ce tournoi de chimères.",
          "next": [
            145400018,
            145400019
          ]
        },
        "145400018": {
          "id": 145400018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Rien que d'imaginer Dan Heng sérieux, ça fait peur",
          "next": [
            145400020
          ]
        },
        "145400019": {
          "id": 145400019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Viens te battre, je vais donner tout ce que j'ai !",
          "next": [
            145400020
          ]
        },
        "145400020": {
          "id": 145400020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Héhé, j'ai hâte de voir {NICKNAME} en action !",
          "next": [
            145400021
          ]
        },
