            150370113
          ]
        },
        "150370113": {
          "id": 150370113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Statut actuel : Levée du bannissement prévue le 25 mars 2099 à 10 h 00 (calendrier arcadien).",
