            150370118
          ]
        },
        "150370118": {
          "id": 150370118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Ahah, je plaisante ! Je t'ai fait peur ?",
          "next": [
            150370119
          ]
        },
        "150370119": {
          "id": 150370119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Un avertissement s'impose : les choses vont devenir risquées.",
          "next": [
            150370120
          ]
        },
        "150370120": {
          "id": 150370120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Parce que la Chasseuse de Stellaron Louve d'argent...",
          "next": [
            150370121
          ]
        },
        "150370121": {
          "id": 150370121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Rejoindra bientôt les Jeux Fabulunaires.",
