        "150370124": {
          "id": 150370124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Ahah, ne te fie pas à mon arrivée tardive. Je vais te battre en un rien de temps !",
          "next": [
            150370127
          ]
        },
        "150370125": {
          "id": 150370125,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Arrête ton cinéma, Louve d'argent. C'est toi qui as piraté le compte du Département de Défense contre les Aberrations ?",
