        "150370116": {
          "id": 150370116,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "J'ai pas le temps pour ça. J'ai besoin d'un opérateur, MAINTENANT !",
          "next": [
            150370117
          ]
        },
        "150370117": {
          "id": 150370117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Nous ne regrettons pas de vous informer que nos opérateurs sont actuellement occupés. Veuillez patienter...",
