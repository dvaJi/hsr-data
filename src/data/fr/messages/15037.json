            150370114,
            150370116
          ]
        },
        "150370114": {
          "id": 150370114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Un bannissement de 100 ans ? On sera à quelle saison à ce moment-là ? Tu me dois des explications !",
