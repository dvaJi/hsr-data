            202230003
          ]
        },
        "202230003": {
          "id": 202230003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Salut chaton, t'es occupé{F#e} ? Je t'invite boire un bubble tea. Tu veux quel parfum ?",
