        },
        "202230009": {
          "id": 202230009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Tu as de super contacts ! Faisons équipe avec tes amis pour un live avec une équipe de stars ! Qu'en dis-tu ?",
