            202230007
          ]
        },
        "202230006": {
          "id": 202230006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Va me chercher ton responsable. Je suis {M#un client}{F#une cliente} VVVIP",
