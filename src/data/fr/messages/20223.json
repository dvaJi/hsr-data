            202230007
          ]
        },
        "202230007": {
          "id": 202230007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Laisse-moi faire. On m'a spécifiquement dit que je recevrai personnellement Cheveux d'argent",
