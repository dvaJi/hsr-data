      ],
      "messages": {
        "202070000": {
          "id": 202070000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Partenaire ! Tu te souviens de cette promesse qu'on s'était faite ?",
          "next": [
            202070001
          ]
        },
        "202070001": {
          "id": 202070001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "À propos de la fin de « La légende des cieux »",
          "next": [
            202070002,
            202070004,
            202070005
          ]
        },
        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bien sûr, mais je te suggère de lire ça par toi-même maintenant",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "C'est tellement bien que je ne voudrais pas te gâcher la surprise",
          "next": [
            202070006
          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pourquoi ne pas lire par toi-même ? C'est tellement bien, je ne voudrais pas te gâcher la surprise",
          "next": [
            202070006
          ]
        },
        "202070005": {
          "id": 202070005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je ne l'ai pas encore lue",
          "next": [
            202070006
          ]
        },
        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Héhé. En fait, je n'ai pas pu résister et je l'ai lue en cachette il y a un moment",
          "next": [
            202070007
          ]
        },
        "202070007": {
          "id": 202070007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Les héros ont voyagé à travers le temps et l'espace et se sont unis pour vaincre le boss final. Mais son pouvoir les a téléportés dans un autre monde où ils ont dû recommencer leur vie à zéro",
          "next": [
            202070008
          ]
        },
        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je meurs d'envie de connaître la suite, mais l'histoire s'arrête net !",
          "next": [
            202070009
          ]
        },
        "202070009": {
          "id": 202070009,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070010,
            202070012,
            202070014
          ]
        },
        "202070010": {
          "id": 202070010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est inacceptable !",
          "next": [
            202070011
          ]
        },
        "202070011": {
          "id": 202070011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je sais, pas vrai !?",
          "next": [
            202070016
          ]
        },
        "202070012": {
          "id": 202070012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eh bien, écris la suite toi-même !",
          "next": [
            202070013
          ]
        },
        "202070013": {
          "id": 202070013,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070016
          ]
        },
        "202070014": {
          "id": 202070014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "C'est une technique d'écriture. Tu sais, pour laisser libre cours à l'imagination du lecteur...",
          "next": [
            202070015
          ]
        },
        "202070015": {
          "id": 202070015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "C'est exactement ce qui s'est passé !",
          "next": [
            202070016
          ]
        },
        "202070016": {
          "id": 202070016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "C'est pour ça qu'on veut lire la suite à ce point",
          "next": [
            202070017
          ]
        },
        "202070017": {
          "id": 202070017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Alors partenaire, tu as lu quelque chose d'intéressant ces derniers temps ? Je suis en panne d'inspiration côté lecture",
          "next": [
            202070018,
            202070021,
            202070023
          ]
        },
        "202070018": {
          "id": 202070018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Tu devrais vraiment jeter un œil aux nouvelles policières que March a écrites il y a quelque temps",
          "next": [
            202070019
          ]
        },
        "202070019": {
          "id": 202070019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Tu ne devineras jamais qui est le tueur, ni même combien ils sont",
          "next": [
            202070020
          ]
        },
        "202070020": {
          "id": 202070020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je vais t'envoyer le lien",
          "next": [
            202070025
          ]
        },
        "202070021": {
          "id": 202070021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Je recommande vivement les fanfictions de Castorice",
          "next": [
            202070022
          ]
        },
        "202070022": {
          "id": 202070022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Son style d'écriture est vraiment polyvalent. Il y en a toujours une qui te laisse bouche bée",
          "next": [
            202070025
          ]
        },
        "202070023": {
          "id": 202070023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Il y a aussi beaucoup de magnifiques ouvrages amphoréens",
          "next": [
            202070024
          ]
        },
        "202070024": {
          "id": 202070024,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Je vais repasser en revue ma collection et te faire une liste plus tard",
          "next": [
            202070025
          ]
        },
        "202070025": {
          "id": 202070025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Génial ! J'ai trop hâte !",
          "next": [
            202070026
          ]
        },
        "202070026": {
          "id": 202070026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Et si je trouve quelque chose d'intéressant, je ne manquerai pas de te le faire savoir",
          "next": [
            202070027
          ]
        },
        "202070027": {
          "id": 202070027,
          "type": "Sticker",
