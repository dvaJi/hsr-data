      "messages": {
        "202140000": {
          "id": 202140000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "The journey in Amphoreus has come to an end.",
          "next": [
            202140001
          ]
        },
        "202140001": {
          "id": 202140001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Through this research, I study and record the tongues and languages of different species across the universe, and I have gained more knowledge than before.",
          "next": [
            202140002
          ]
        },
        "202140002": {
          "id": 202140002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "If you meet a being you cannot communicate with, just come to me.",
          "next": [
            202140003,
            202140008
          ]
        },
        "202140003": {
          "id": 202140003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Teacher Dan Heng, how does a cat sound when it is happy?",
          "next": [
            202140004
          ]
        },
        "202140004": {
          "id": 202140004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "...Hold on.",
          "next": [
            202140005
          ]
        },
        "202140005": {
          "id": 202140005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Meow, purr. Rumble rumble, rumble rumble rumble.",
          "next": [
            202140006
          ]
        },
        "202140006": {
          "id": 202140006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202140007
          ]
        },
        "202140007": {
          "id": 202140007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "I mimicked a segment. At that point, they generally express: I like it, more, and continue.",
          "next": [
            202140014
          ]
        },
        "202140008": {
          "id": 202140008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Teacher Dan Heng, how does a dog sound when it is bored?",
          "next": [
            202140009
          ]
        },
        "202140009": {
          "id": 202140009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "...Hold on.",
          "next": [
            202140010
          ]
        },
        "202140010": {
          "id": 202140010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Cling-clang. Pitter-patter. Woof woof woof. Hic-hic. Awoo.",
          "next": [
            202140011
          ]
        },
        "202140011": {
          "id": 202140011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202140012
          ]
        },
        "202140012": {
          "id": 202140012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "I mimicked a segment. When they are bored, they usually pace around, not just make sounds.",
          "next": [
            202140013
          ]
        },
        "202140013": {
          "id": 202140013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "It generally means: play together, play outside.",
          "next": [
            202140014
          ]
        },
        "202140014": {
          "id": 202140014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Flibberty-gibbety goo",
          "next": [
            202140015
          ]
        },
        "202140015": {
          "id": 202140015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
