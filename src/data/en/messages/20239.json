  ],
  "sections": [
    {
      "id": 2023900,
      "startingMessageId": [
        202390000
      ],
      "messages": {
        "202390000": {
          "id": 202390000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "My treasures",
          "next": [
            202390001
          ]
        },
        "202390001": {
          "id": 202390001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "I have decided: This day shall be known as the destruction of Planarcadia!",
          "next": [
            202390002
          ]
        },
        "202390002": {
          "id": 202390002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "If you wish to follow me back to Uruk, then report to Duomension City Plaza at once!",
          "next": [
            202390003
          ]
        },
        "202390003": {
          "id": 202390003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "My vessel, Vimana, remains for a mere five minutes. No later than that!",
          "next": [
            202390004,
            202390006,
            202390007
          ]
        },
        "202390004": {
          "id": 202390004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "??? Did you even ask me",
          "next": [
            202390005
          ]
        },
        "202390005": {
          "id": 202390005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Of course not! This is the consultation!",
          "next": [
            202390009
          ]
        },
        "202390006": {
          "id": 202390006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "??? What do you want",
          "next": [
            202390009
          ]
        },
        "202390007": {
          "id": 202390007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "??? Too many exclamation points, my eyes hurt",
          "next": [
            202390008
          ]
        },
        "202390008": {
          "id": 202390008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Naturally! A king's voice should ring out like a great bronze bell!",
          "next": [
            202390009
          ]
        },
        "202390009": {
          "id": 202390009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "I shall deign to let you understand the source of my fury: My Gil Gourmet Street has been open for an age, and yet it remains utterly deserted!",
          "next": [
            202390010
          ]
        },
        "202390010": {
          "id": 202390010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Gold-leaf ice cream! Gold-leaf tuna salad! Gold-leaf Vonwacq serpent steak! Even whole-roasted Doomsday Beast covered in gold leaf!",
          "next": [
            202390011
          ]
        },
        "202390011": {
          "id": 202390011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "These are premium selections hand-picked by my own superlative taste. And yet, the local mongrels dare to turn up their noses at them...",
          "next": [
            202390012
          ]
        },
        "202390012": {
          "id": 202390012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Enough! I shall not wait another five minutes. I hand down my judgment now!",
          "next": [
            202390013,
            202390015
          ]
        },
        "202390013": {
          "id": 202390013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Your Majesty, please cool your temper. They simply have no taste",
          "next": [
            202390014
          ]
        },
        "202390014": {
          "id": 202390014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Hmph, it is inconceivable that in this land, you are the only one with the sense to show me proper respect",
          "next": [
            202390017
          ]
        },
        "202390015": {
          "id": 202390015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gold-leaf ice cream is one thing, but what in the world are those other items, if I may ask",
          "next": [
            202390016
          ]
        },
        "202390016": {
          "id": 202390016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Are even you so lacking in discernment? This cosmos truly is beyond salvation",
          "next": [
            202390017
          ]
        },
        "202390017": {
          "id": 202390017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Heh... At this stage, even personally razing this land feels like a redundant effort.",
          "next": [
            202390018
          ]
        },
        "202390018": {
          "id": 202390018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "I shall deign to forgive these mongrels. It is only natural that those who consume nothing but husks and chaff every day would be incapable of appreciating my tastes",
          "next": [
            202390019
          ]
        },
        "202390019": {
          "id": 202390019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Withdraw, my treasures! I shall return to the development of Gold-Leaf SoulGlad",
          "next": [
            202390020
          ]
        },
        "202390020": {
          "id": 202390020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "Within three days, this arcadia shall willingly bow its head in submission!",
          "next": [
            202390021
          ]
        },
        "202390021": {
          "id": 202390021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "The user you're trying to reach is currently out of the service area. Please try again later.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1509,
        8001
      ]
    }
  ]
}