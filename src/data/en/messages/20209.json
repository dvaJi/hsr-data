  ],
  "sections": [
    {
      "id": 2020900,
      "startingMessageId": [
        202090000
      ],
      "messages": {
        "202090000": {
          "id": 202090000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Leaving already, Little Gray Fry? I made a batch of honey brew for the road. Since it's a special blend, I was hoping you'd give me your thoughts.",
          "next": [
            202090001
          ]
        },
        "202090001": {
          "id": 202090001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090002,
            202090003,
            202090004
          ]
        },
        "202090002": {
          "id": 202090002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Thanks, that's so thoughtful of you!",
          "next": [
            202090007
          ]
        },
        "202090003": {
          "id": 202090003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I'll drink it all up!",
          "next": [
            202090007
          ]
        },
        "202090004": {
          "id": 202090004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Can I have some?",
          "next": [
            202090005
          ]
        },
        "202090005": {
          "id": 202090005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "I've learned my lesson, so I've diluted this batch to be more human-friendly.",
          "next": [
            202090006
          ]
        },
        "202090006": {
          "id": 202090006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090007
          ]
        },
        "202090007": {
          "id": 202090007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "For this one, a Rift Valley nectar base with freshly squeezed moon fruit. It's got a sweet-yet-tart kick that's perfect for the little pink jellyfish.",
          "next": [
            202090008
          ]
        },
        "202090008": {
          "id": 202090008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090009
          ]
        },
        "202090009": {
          "id": 202090009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "The green dragonfish always reminds me of the ancient ice of the deep seas. I thought a honey brew with mint and ginger might help clear his thoughts.",
          "next": [
            202090010
          ]
        },
        "202090010": {
          "id": 202090010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090011
          ]
        },
        "202090011": {
          "id": 202090011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "I left the last few bottles unlabeled. I have a feeling you'll know who needs them most.",
          "next": [
            202090012
          ]
        },
        "202090012": {
          "id": 202090012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090013
          ]
        },
        "202090013": {
          "id": 202090013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "There is one that warms you like the blazing sun, yet it's made from red-crowned sea cucumbers that only emerge at night. One sip, and you won't want the day to end.",
          "next": [
            202090014
          ]
        },
        "202090014": {
          "id": 202090014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090015
          ]
        },
        "202090015": {
          "id": 202090015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Another is a brown brew blended with nutritious minerals from the underwater mountains. It keeps for ages without losing a hint of its initial taste.",
          "next": [
            202090016
          ]
        },
        "202090016": {
          "id": 202090016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090017
          ]
        },
        "202090017": {
          "id": 202090017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "For the last one, I've used the liquid stirred up by a school of silverfish dancing together. It's refreshingly balanced, and the aftertaste is a real treat.",
          "next": [
            202090018
          ]
        },
        "202090018": {
          "id": 202090018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090019,
            202090020
          ]
        },
        "202090019": {
          "id": 202090019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "So which brew is for me?",
          "next": [
            202090023
          ]
        },
        "202090020": {
          "id": 202090020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I bet Himeko would love to compare notes on these wild recipes of yours",
          "next": [
            202090021
          ]
        },
        "202090021": {
          "id": 202090021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "That would be great. I do hope she likes them.",
          "next": [
            202090022
          ]
        },
        "202090022": {
          "id": 202090022,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090023
          ]
        },
        "202090023": {
          "id": 202090023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "For you, Little Gray Fry, this one holds a mix of blue stardust, shimmering gold flakes, and a sweet pink brew...",
          "next": [
            202090024
          ]
        },
        "202090024": {
          "id": 202090024,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090025
          ]
        },
        "202090025": {
          "id": 202090025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "I call it \"Memory of Amphoreus.\" Pour it into a glass, and it will dance with the glimmer of countless stars. Go on, give it a try.",
          "next": [
            202090026
          ]
        },
        "202090026": {
          "id": 202090026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090027
          ]
        },
        "202090027": {
          "id": 202090027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "To our memories. May they forever shine as brightly as this drink, and may their sweetness be everlasting.",
          "next": [
            202090028
          ]
        },
        "202090028": {
          "id": 202090028,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202090029
          ]
        },
