      "messages": {
        "150700100": {
          "id": 150700100,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "How's life in Astropolis been lately? I actually wanted to ask you for a favor.",
          "next": [
            150700101
          ]
        },
        "150700101": {
          "id": 150700101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Work's finally winding down, so I'm taking it easy on vacation.",
          "next": [
            150700102
          ]
        },
        "150700102": {
          "id": 150700102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "How can I help?",
          "next": [
            150700103
          ]
        },
        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "There's a film star in Astropolis who goes by the name Holy Wubbaboo. Ring any bells?",
          "next": [
            150700104
          ]
        },
        "150700104": {
          "id": 150700104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "If it's not too much trouble, I was hoping you could help out with an introduction.",
          "next": [
            150700105
          ]
        },
        "150700105": {
          "id": 150700105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "The Holy Wubbaboo? Yes, I'm familiar with it.",
          "next": [
            150700106
          ]
        },
        "150700106": {
          "id": 150700106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "My manager and agent was in talks with Cardway Films about a commercial deal, lending my vocals to one of their new projects.",
          "next": [
            150700107
          ]
        },
        "150700107": {
          "id": 150700107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Leave it to me! Just a moment!",
          "next": [
            150700108
          ]
        },
        "150700108": {
          "id": 150700108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Lucky us, Holy Wubbaboo is resting in Lodestar Tower this afternoon.",
          "next": [
            150700109
          ]
        },
        "150700109": {
          "id": 150700109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "I've set up a meeting for you. Just head over and find it directly.",
          "next": [
            150700110,
            150700111
          ]
        },
        "150700110": {
          "id": 150700110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "You're a lifesaver, seriously! Thank you so much!",
          "next": []
        },
        "150700111": {
          "id": 150700111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin, you're absolutely incredible!",
          "next": []
        }
      },
