  "sections": [
    {
      "id": 2022300,
      "startingMessageId": [
        202230000
      ],
      "messages": {
        "202230000": {
          "id": 202230000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Attachment <i>Sparxie Live Stream Business Collaboration Agreement.pdf</i> Sent",
          "next": [
            202230001
          ]
        },
        "202230001": {
          "id": 202230001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Hey sweetie, which type of collaboration suits you best? Let me break it down for you",
          "next": [
            202230002
          ]
        },
        "202230002": {
          "id": 202230002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "All the resources we provide are top-notch in the industry~",
          "next": [
            202230003
          ]
        },
        "202230003": {
          "id": 202230003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Hey sweetie, you busy? Let me treat you to some bubble tea. What would you like?",
          "next": [
            202230004,
            202230005,
            202230006
          ]
        },
        "202230004": {
          "id": 202230004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "What collaboration? I don't come cheap",
          "next": [
            202230007
          ]
        },
        "202230005": {
          "id": 202230005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Go find my boss, Pom-Pom",
          "next": [
            202230007
          ]
        },
        "202230006": {
          "id": 202230006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Get your boss over here. I'm a VVVIP customer",
          "next": [
            202230007
          ]
        },
        "202230007": {
          "id": 202230007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Leave it to me~ I was specifically told that I'll personally receive Gray Hair",
          "next": [
            202230008
          ]
        },
        "202230008": {
          "id": 202230008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Let's get down to business. I've got a brilliant idea",
          "next": [
            202230009
          ]
        },
        "202230009": {
          "id": 202230009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "You've got great connections! Let's team up with your friends and do an all-star lineup livestream! How about it?",
          "next": [
            202230010
          ]
        },
        "202230010": {
          "id": 202230010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Let's just call it <i>Sparxicle and Friends</i>",
          "next": [
            202230011,
            202230013
          ]
        },
        "202230011": {
          "id": 202230011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Whose connections? Whose friends? Yours or mine?",
          "next": [
            202230012
          ]
        },
        "202230012": {
          "id": 202230012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Your friends are my friends. Our friends~",
          "next": [
            202230015
          ]
        },
        "202230013": {
          "id": 202230013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "What's in it for me if I work with you?",
          "next": [
            202230014
          ]
        },
        "202230014": {
          "id": 202230014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "We'll share the naming rights, so the full title will be <i>Sparxicle, Gray Hair, and Friends</i>",
          "next": [
            202230015
          ]
        },
        "202230015": {
          "id": 202230015,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 215,
          "next": [
            202230016
          ]
        },
        "202230016": {
          "id": 202230016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "But more importantly, let's go ahead with choosing our first guest~",
          "next": [
            202230017
          ]
        },
        "202230017": {
          "id": 202230017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "So, I'll hear you out. What sort of connections do you have~",
          "next": [
            202230018,
            202230022,
            202230026
          ]
        },
        "202230018": {
          "id": 202230018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I've got connections in Planarcadia, all big shots",
          "next": [
            202230019
          ]
        },
        "202230019": {
          "id": 202230019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I can even have small talks with Xianzhou Generals and a former representative of The Family in Penacony",
          "next": [
            202230020
          ]
        },
        "202230020": {
          "id": 202230020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Chicken Wing Boy is already a familiar face to our online audience, so we could consider him~",
          "next": [
            202230021
          ]
        },
        "202230021": {
          "id": 202230021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "But I prefer the headline \"Monster Rookie Group: the Yao-Spark Hands!\" Yep! I'll leave you to convince General Yao Guang!",
          "next": [
            202230031
          ]
        },
        "202230022": {
          "id": 202230022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I have a black hole of a game to recommend. It'll make for great content on the show",
          "next": [
            202230023
          ]
        },
        "202230023": {
          "id": 202230023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aeon IX, The Nihility",
          "next": [
            202230024
          ]
        },
        "202230024": {
          "id": 202230024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Yeah, it's a black hole alright... but notoriously terrible at controlling THEIR facial expressions",
          "next": [
            202230025
          ]
        },
        "202230025": {
          "id": 202230025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "If you can really get THEM to come, I might consider it~",
          "next": [
            202230031
          ]
        },
        "202230026": {
          "id": 202230026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I don't have any connections. Why don't you call Goldxie, Twigxie, Aquaxie, and Terraxie yourself",
          "next": [
            202230027
          ]
        },
        "202230027": {
          "id": 202230027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Gray Hair, I didn't know...",
          "next": [
            202230028
          ]
        },
        "202230028": {
          "id": 202230028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "...YOU ARE MY EARLIEST FAN! How did you know I haven't deleted any of them!?",
          "next": [
            202230029
          ]
        },
        "202230029": {
          "id": 202230029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I was just talking drivel",
          "next": [
            202230030
          ]
        },
        "202230030": {
          "id": 202230030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Hehe, I should consider getting them all together~",
          "next": [
            202230031
          ]
        },
        "202230031": {
          "id": 202230031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Well, I'll draft up an invitation with my assistant first!",
          "next": [
            202230032
          ]
        },
        "202230032": {
          "id": 202230032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Oh, it's in the collaboration agreement: You'll need to be on camera too~",
          "next": [
            202230033
          ]
        },
        "202230033": {
          "id": 202230033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 215,
          "text": "Hurry up and figure out a special trick to show off~",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        215
      ]
    }
  ]
}