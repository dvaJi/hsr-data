          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Are your injuries getting better? Have you been sleeping well? How's your appetite? Do you feel tired at work? Any other discomfort?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I'm doing great!",
