        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "That puts my mind at ease!",
          "next": [
            202020018
          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I love sleeping and eating, but not so much exercising... Is there any hope for me, Miss Hyacine?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "If your body wants to sleep, let it get some rest~ You must be exhausted, so don't force yourself to stay up",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "If you want something both healthy and delicious, well, there's another way",
          "next": [
            202020014
