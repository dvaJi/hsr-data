            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "I saw Furli head out of the movie theater with tears streaming down its face, then bolt straight for the newspaper agency.",
