            150720102
          ]
        },
        "150720102": {
          "id": 150720102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "This movie's got some serious budget behind it, furb! The production value is off the charts!",
          "next": [
            150720103
          ]
        },
        "150720103": {
          "id": 150720103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Nothing beats a good action-packed story!",
          "next": [
            150720104
          ]
        },
        "150720104": {
          "id": 150720104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "And starring the Holy Wubbaboo, a true veteran of the screens.",
          "next": [
            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "Totally! The way it portrays a superhero's everyday struggles really hits home for this furb.",
