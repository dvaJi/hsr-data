            202560014
          ]
        },
        "202560013": {
          "id": 202560013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "\"Ace ★★★★★ Handyman\" just put the ball in \"Aeon ★ Aha\"'s court.",
          "next": [
            202560015
          ]
        },
        "202560014": {
          "id": 202560014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Yeah, there's no such thing as a free breakfast, lunch, or dinner.",
