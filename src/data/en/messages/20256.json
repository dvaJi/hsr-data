          ]
        },
        "202560005": {
          "id": 202560005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "My last account got permanently banned... Never thought the carrier would dig that deep, but after all these years, they finally caught me topping up my phone balance with crypto.",
          "next": [
            202560006
          ]
        },
        "202560006": {
          "id": 202560006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "But I hadn't finished copying my precious old files, and I ended up losing more than half of them!",
          "next": [
            202560007
          ]
        },
        "202560007": {
          "id": 202560007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 243,
          "next": [
            202560008
          ]
        },
        "202560008": {
          "id": 202560008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "After much soul-searching, I've decided to let go of my old accounts and snag a premium one with the perfect handle.",
          "next": [
            202560009
          ]
        },
        "202560009": {
          "id": 202560009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "You'd never believe how many identities the previous owner had going on. This Handyman registered on every gig platform out there and somehow rocked five-star reviews across the board.",
          "next": [
            202560010
          ]
        },
        "202560010": {
          "id": 202560010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Now THIS is the real Aha!",
          "next": [
            202560011
          ]
        },
        "202560011": {
          "id": 202560011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Luckily, I'm no stranger to odd jobs. Time to get serious about this. I'm gonna learn from Handyman and become the Ace AHAuler~",
          "next": [
            202560012,
            202560013
          ]
        },
        "202560012": {
          "id": 202560012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Yeah, you should probably buckle down and get to work.",
