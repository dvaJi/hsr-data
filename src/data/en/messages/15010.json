      "messages": {
        "150100000": {
          "id": 150100000,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mr. Yang, where are you? Have you seen Himeko?",
          "next": [
            150100001
          ]
        },
        "150100001": {
          "id": 150100001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "I just finished the memetic infection screening. Himeko is still here, but I don't know where she went after.",
          "next": [
            150100002
          ]
        },
        "150100002": {
          "id": 150100002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "{NICKNAME}, I heard Himeko reunited with her father.",
          "next": [
            150100003
          ]
        },
        "150100003": {
          "id": 150100003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "She seemed rather out of it. I didn't press her for details. Could you fill me in on what happened back there?",
          "next": [
            150100004,
            150100008
          ]
        },
        "150100004": {
          "id": 150100004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Being stuck between them both was so awkward and nerve-wracking, I could've excavated the entirety of a second Graphia Campus the way my toes curled in such intense cringe",
          "next": [
            150100005
          ]
        },
        "150100005": {
          "id": 150100005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "You guys really wanna hear the whole story?",
          "next": [
            150100006
          ]
        },
        "150100006": {
          "id": 150100006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "We're all one big family on the Express. It's important to understand what our companions are going through.",
          "next": [
            150100007
          ]
        },
        "150100007": {
          "id": 150100007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "I'll be waiting for you in that classroom with that ghost you mentioned earlier. Come quickly.",
          "next": []
        },
