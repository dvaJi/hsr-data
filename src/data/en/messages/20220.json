  "sections": [
    {
      "id": 2022000,
      "startingMessageId": [
        202200000
      ],
      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, did you know there are more undiscovered memories in Penacony",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "No one has ever truly understood them, not even you who just recovered that memory",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Those familiar faces, those untold secrets... Aren't you curious?",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "The lady who wielded a sheath of flame in that Night of Ever-Flame",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Or... the hunters who have their eyes on you?",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "And of course, there's me. I'm more than happy to open my heart to you",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Let me share some memories with you before I burn them away~",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I want to hear what secret Acheron has that even she doesn't know about",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "That night when the last spark extinguished",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "I saw",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "She took a blueprint, but unfortunately it wasn't a map, it was...",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "A \"menu\"",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "But she probably hasn't figured it out till this day~",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Maybe she's just hungry. You don't know she can cook, do you?",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Who knows?",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Maybe... I've eaten her cooking before~",
          "next": [
            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Did you really infiltrate the Stellaron Hunters? I have my doubts",
          "next": [
            202200017
          ]
        },
        "202200017": {
          "id": 202200017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wanna hear a secret about them?",
          "next": [
            202200018
          ]
        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Stellaron Hunters, Destiny's Slave... heh, even these titles fail to capture the bond between you",
          "next": [
            202200019
          ]
        },
        "202200019": {
          "id": 202200019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Why do they have 42 \"script\" group chats? I'm so curious!",
          "next": [
            202200020
          ]
        },
        "202200020": {
          "id": 202200020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Your math sucks. There are 56 of them, aren't there?",
          "next": [
            202200021
          ]
        },
        "202200021": {
          "id": 202200021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Guess which group I'm in?",
          "next": [
            202200028
          ]
        },
        "202200022": {
          "id": 202200022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I want to know your untold secrets",
          "next": [
            202200023
          ]
        },
        "202200023": {
          "id": 202200023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "I once traveled half the Amber Era with the \"Star Lake Vinegar Fish Cult\"",
          "next": [
            202200024
          ]
        },
        "202200024": {
          "id": 202200024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Their slogan goes: \"With the heavens above and the star lake below, just one bite and you'll never feel sour again.\"",
          "next": [
            202200025
          ]
        },
        "202200025": {
          "id": 202200025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Too bad no one remembers. Memories has always been so fragile",
          "next": [
            202200026
          ]
        },
        "202200026": {
          "id": 202200026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Now that everyone knows, we want to hear you shout that slogan",
          "next": [
            202200027
          ]
        },
        "202200027": {
          "id": 202200027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "You'll need to pay an additional cost",
          "next": [
            202200028
          ]
        },
        "202200028": {
          "id": 202200028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "What a niche secret I've discovered!",
          "next": [
            202200029
          ]
        },
        "202200029": {
          "id": 202200029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "To return your kindness, let me also tell you a secret!",
          "next": [
            202200030
          ]
        },
        "202200030": {
          "id": 202200030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Actually...",
          "next": [
            202200031
          ]
        },
        "202200031": {
          "id": 202200031,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Actually, Mikhail used to be an actor",
          "next": [
            202200032
          ]
        },
        "202200032": {
          "id": 202200032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Since it's you, I might really believe that",
          "next": [
            202200033
          ]
        },
        "202200033": {
          "id": 202200033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": []
        }
