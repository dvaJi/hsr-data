        "150370100": {
          "id": 150370100,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "This is an automated message. No reply is necessary.",
          "next": [
            150370101
          ]
        },
        "150370101": {
          "id": 150370101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Greetings! The \"Daybreak Squadron vs. Astral Express\" battle has concluded. The Department of Aberration Defense will now release the current Wishpower rankings of the Eight Masked Supplicants to all \"Phantasmoon Games\" participants.",
          "next": [
            150370102
          ]
        },
        "150370102": {
          "id": 150370102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Note: Information on uncalled Supplicants and their corresponding masks is currently restricted.",
          "next": [
            150370103
          ]
        },
        "150370103": {
          "id": 150370103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Current Ranking: 5th. Supplicant: Sparxie. Called.",
          "next": [
            150370104
          ]
        },
        "150370104": {
          "id": 150370104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Current Ranking: 4th. Supplicant: Daybreak Squadron. Called.",
          "next": [
            150370105
          ]
        },
        "150370105": {
          "id": 150370105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Current Ranking: 3rd. Supplicant: Pearl. Yet to be called.",
          "next": [
            150370106
          ]
        },
        "150370106": {
          "id": 150370106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Note: After the SparxiCon incident, Sparxie's mask was temporarily taken away.",
          "next": [
            150370107,
            150370108
          ]
        },
        "150370107": {
          "id": 150370107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wait, you get publicly shamed after losing?",
          "next": [
            150370109
          ]
        },
        "150370108": {
          "id": 150370108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I am getting nervous! What is my current rank?",
          "next": [
            150370109
          ]
        },
        "150370109": {
          "id": 150370109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Supplicant ▀▄█: ▄▀█▄ ▄█▄. Current Ranking: ▀█▄.",
          "next": [
            150370110
          ]
        },
        "150370110": {
          "id": 150370110,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Disconnected from Department of Aberration Defense",
          "next": [
            150370111
          ]
        },
        "150370111": {
          "id": 150370111,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Reconnected with Department of Aberration Defense",
          "next": [
            150370112
          ]
        },
        "150370112": {
          "id": 150370112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "[WARNING] After further review, you have been found ineligible for the \"Phantasmoon Games.\" Your Raccoon Mask has been banned.",
          "next": [
            150370113
          ]
        },
        "150370113": {
          "id": 150370113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Current Status: Ban to be lifted on March 25, 2099, 10:00 (Arcadian Calendar).",
          "next": [
            150370114,
            150370116
          ]
        },
        "150370114": {
          "id": 150370114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A 100 year ban? Which season will it even be by then? You owe me an explanation!",
          "next": [
            150370115
          ]
        },
        "150370115": {
          "id": 150370115,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "[Image]",
          "next": [
            150370118
          ]
        },
        "150370116": {
          "id": 150370116,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I don't have time for this. I need live support, NOW!",
          "next": [
            150370117
          ]
        },
        "150370117": {
          "id": 150370117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "We're not sorry to inform you that our customer service is unavailable right now. Please hold...",
          "next": [
            150370118
          ]
        },
        "150370118": {
          "id": 150370118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Haha, just kidding! Were you startled?",
          "next": [
            150370119
          ]
        },
        "150370119": {
          "id": 150370119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "A fair warning: things are about to get dicey.",
          "next": [
            150370120
          ]
        },
        "150370120": {
          "id": 150370120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Because Stellaron Hunter Silver Wolf...",
          "next": [
            150370121
          ]
        },
        "150370121": {
          "id": 150370121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "She will soon join \"Phantasmoon Games.\"",
          "next": [
            150370122
          ]
        },
        "150370122": {
          "id": 150370122,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "[Image]",
          "next": [
            150370123,
            150370125
          ]
        },
        "150370123": {
          "id": 150370123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "She's only joining now? Isn't that a bit late?",
          "next": [
            150370124
          ]
        },
        "150370124": {
          "id": 150370124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Haha, don't let my late start fool you. I'll beat you in no time!",
          "next": [
            150370127
          ]
        },
        "150370125": {
          "id": 150370125,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cut the act, Silver Wolf. Did you hack the account of the Department of Aberration Defense?",
          "next": [
            150370126
          ]
        },
        "150370126": {
          "id": 150370126,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Transfer me 6.1 billion Wishbae and I'll tell you the answer.",
          "next": [
            150370127
          ]
        },
        "150370127": {
          "id": 150370127,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Disconnected from Department of Aberration Defense",
          "next": [
            150370128,
            150370129
          ]
        },
        "150370128": {
          "id": 150370128,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Silver Wolf?",
          "next": [
            150370130
          ]
        },
        "150370129": {
          "id": 150370129,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Still there? Hello? Helloooo?",
