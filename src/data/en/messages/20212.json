        },
        "202120006": {
          "id": 202120006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "But this is nighttime",
          "next": [
            202120007
          ]
        },
        "202120007": {
          "id": 202120007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1413,
          "next": [
            202120008
          ]
        },
        "202120008": {
          "id": 202120008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "I'm just here to propose a little deal",
          "next": [
            202120009
          ]
        },
        "202120009": {
          "id": 202120009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "I still have some of your... \"memories.\" I'd hate for them to be made public, wouldn't you?",
          "next": [
            202120010,
            202120011
          ]
        },
        "202120010": {
          "id": 202120010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Fine, I'm listening",
          "next": [
            202120012
          ]
        },
        "202120011": {
          "id": 202120011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I have nothing to hide",
          "next": [
            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "You followed a lovesick Dromas, took a sneaky selfie with it, and posted it with \"Wise people don't fall in love\"",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "You went to a street psychic, and left a selfie captioned \"I make my own fate\"",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "You were out walking, saw a bard... and started a rap battle on the spot, complete with a selfie",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "You left behind a selfie of your bedhead this morning",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "You thought you gained some weight lately, so you got a selfie.",
          "next": [
            202120017
          ]
        },
        "202120017": {
          "id": 202120017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202120018,
            202120019,
            202120020
          ]
        },
        "202120018": {
          "id": 202120018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Okay, I see we're going to need the power of the Oblivion",
          "next": [
            202120023
          ]
        },
        "202120019": {
          "id": 202120019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Pretty cool, huh?",
          "next": [
            202120023
          ]
        },
        "202120020": {
          "id": 202120020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "*sigh* I just wanted to help out quietly, but I see I've been found out",
          "next": [
            202120021
          ]
        },
        "202120021": {
          "id": 202120021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I took all those selfies for March 7th",
          "next": [
            202120022
          ]
        },
        "202120022": {
          "id": 202120022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Just say it. What will it take for you to return those \"memories\" to me?",
          "next": [
            202120023
          ]
        },
        "202120023": {
          "id": 202120023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Hehe, she knows all about it now ♭",
          "next": [
            202120024
          ]
        },
        "202120024": {
          "id": 202120024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "If you'd rather these little selfies didn't go on her photo wall... It's easy, Little Graybird ♭",
          "next": [
            202120025
          ]
        },
        "202120025": {
          "id": 202120025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Make sure she wakes up to a delicious, freshly-made meal tomorrow at noon",
