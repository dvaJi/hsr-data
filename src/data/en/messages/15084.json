  "sections": [
    {
      "id": 1508401,
      "startingMessageId": [
        150840101
      ],
      "messages": {
        "150840101": {
          "id": 150840101,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            150840102
          ]
        },
        "150840102": {
          "id": 150840102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Do you still remember when I set aside those race tickets for you?",
          "next": [
            150840103
          ]
        },
        "150840103": {
          "id": 150840103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "I'd hoped you could simply enjoy the show. Who would've thought you'd end up being part of it?",
          "next": [
            150840104,
            150840105
          ]
        },
        "150840104": {
          "id": 150840104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "It's a real shame I missed the show. Any chance I could snag tickets for the next one?",
          "next": [
            150840106
          ]
        },
        "150840105": {
          "id": 150840105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Honestly, I've been searching for recordings of the opening performance ever since I got back.",
          "next": [
            150840106
          ]
        },
        "150840106": {
          "id": 150840106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Then again, the first time you heard the new track, you were strapped into a racecar, listening over the team radio's awful audio.",
          "next": [
            150840107
          ]
        },
        "150840107": {
          "id": 150840107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "To tell the truth, I feel a little bad about it.",
          "next": [
            150840108
          ]
        },
        "150840108": {
          "id": 150840108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "So...",
          "next": [
            150840109
          ]
        },
        "150840109": {
          "id": 150840109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "I've saved a special spot just for you. Front and center for my live performance. What do you say?",
          "next": [
            150840110
          ]
        },
        "150840110": {
          "id": 150840110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "That'd be great! So where is this show being held?",
          "next": [
            150840111
          ]
        },
        "150840111": {
          "id": 150840111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "I have a collaboration with the Interastral Peace Entertainment, and the goal is to bring the magic of the live experience to life.",
          "next": [
            150840112
          ]
        },
        "150840112": {
          "id": 150840112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Now everyone can catch my live performance on repeat at the seaside park stage in Astropolis.",
          "next": [
            150840113
          ]
        },
        "150840113": {
          "id": 150840113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "If you're interested, head to the bar at the seaside park and ask for a drinksmith named Rocca.",
          "next": [
            150840114
          ]
        },
        "150840114": {
          "id": 150840114,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1309,
          "image": "PhoneMessagePic_15501",
          "next": [
            150840115
          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "I already gave them a heads-up.",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "And you'll be the first audience for this \"special performance.\"",
          "next": [
            150840117,
            150840118
          ]
        },
        "150840117": {
          "id": 150840117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Can't wait!",
          "next": [
            150840119
          ]
        },
        "150840118": {
          "id": 150840118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I'll check it out once I'm done here.",
          "next": [
            150840119
          ]
        },
        "150840119": {
          "id": 150840119,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
