          ]
        },
        "202130025": {
          "id": 202130025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "You really know how to say the right thing...",
          "next": [
            202130026
          ]
        },
        "202130026": {
          "id": 202130026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Okay, I admit I probably don't care that much anymore",
          "next": [
            202130027
          ]
        },
        "202130027": {
          "id": 202130027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "After all, I am March 7th, the sociable, generous, wise, charming, clever, adorable, gentle, kind, and innocent girl!",
          "next": [
            202130028
          ]
        },
