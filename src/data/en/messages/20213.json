          "next": [
            202130003
          ]
        },
        "202130003": {
          "id": 202130003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Not funny.",
          "next": [
            202130005
          ]
        },
        "202130004": {
          "id": 202130004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I can't sleep either",
          "next": [
            202130005
          ]
        },
        "202130005": {
          "id": 202130005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Big sigh, I actually just finished watching a movie",
          "next": [
            202130006
          ]
        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "It said it was based on a true story, about someone with more than twenty alters...",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "The protagonist had memory lapses. He thought it was just ordinary amnesia, but in truth, it was other alters living his life for him",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Do you think... I might be the same...?",
          "next": [
            202130009
          ]
        },
        "202130009": {
          "id": 202130009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202130010,
            202130013
          ]
        },
        "202130010": {
          "id": 202130010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Actually... That's right...",
          "next": [
            202130011
          ]
        },
        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Actually... the you from yesterday... wasn't the you today... You were cuter yesterday...",
          "next": [
            202130012
          ]
        },
        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Be nice! I'm cute today, and I'll be even cuter tomorrow!",
          "next": [
            202130014
          ]
        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Don't worry. With my God's-eye view, I can see that you are complete",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Even if you're teasing, I still feel a little uneasy",
          "next": [
            202130015
          ]
        },
        "202130015": {
          "id": 202130015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Could there be... other March 7ths out there!?",
          "next": [
            202130016
          ]
        },
        "202130016": {
          "id": 202130016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Maybe... March 7th, an eccentric artist? Or March 7th, a socialite femme fatale? That's scary...",
          "next": [
            202130017
          ]
        },
        "202130017": {
          "id": 202130017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Don't tell me there's an exceptionally intelligent March 7th too...",
          "next": [
            202130018,
            202130020,
            202130022
          ]
        },
        "202130018": {
          "id": 202130018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Riiight. Fantasy time. You should sleep",
          "next": [
            202130019
          ]
        },
        "202130019": {
          "id": 202130019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "When you wake up, you'll still be that adorable, gentle, kind, and innocent girl March 7th",
          "next": [
            202130024
          ]
        },
        "202130020": {
          "id": 202130020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "And don't forget, you are also March 7th, the Sword Champion of Astral Express",
          "next": [
            202130021
          ]
        },
        "202130021": {
          "id": 202130021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Don't worry, you'll still be that adorable, gentle, kind, and innocent girl March 7th",
          "next": [
            202130024
          ]
        },
        "202130022": {
          "id": 202130022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Don't worry, it's fine",
          "next": [
            202130023
          ]
        },
        "202130023": {
          "id": 202130023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "You'll still be that adorable, gentle, kind, and innocent girl March 7th",
          "next": [
            202130024
          ]
        },
        "202130024": {
          "id": 202130024,
          "type": "Sticker",
