          ]
        },
        "202050001": {
          "id": 202050001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Grandmother. Sorry, my fingers slipped",
          "next": [
            202050002
          ]
        },
        "202050002": {
          "id": 202050002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Have you seen my Cifera?",
          "next": [
            202050003,
            202050005,
            202050007
          ]
        },
        "202050003": {
          "id": 202050003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hello, ma'am",
          "next": [
            202050004
          ]
        },
        "202050004": {
          "id": 202050004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Want me to help look for your kitty?",
          "next": [
            202050009
          ]
        },
        "202050005": {
          "id": 202050005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I haven't seen her, sorry",
          "next": [
            202050006
          ]
        },
        "202050006": {
          "id": 202050006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I'll get right on finding that cat for you",
          "next": [
            202050009
          ]
        },
        "202050007": {
          "id": 202050007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Maybe at the baths?",
          "next": [
            202050008
          ]
        },
        "202050008": {
          "id": 202050008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Want me to help look for your kitty?",
          "next": [
            202050009
          ]
        },
        "202050009": {
          "id": 202050009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Thank you, dear, but it's alright. I know what a handful she is to track down",
          "next": [
            202050010
          ]
        },
        "202050010": {
          "id": 202050010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "That's why I have to find a way to lure her back home herself",
          "next": [
            202050011
          ]
        },
        "202050011": {
          "id": 202050011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Would you like to come over for dinner, Gray Mystery?",
          "next": [
            202050012
          ]
        },
        "202050012": {
          "id": 202050012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ahem. I'll just use the voice-to-text. For a while now, Cifera has been bringing different friends home. For dinner. Since she disappeared right when it's time to eat, I'm guessing she went to find a friend, but I have no idea which friend I could find her with. She just loves to run about, so I came up with this little trick.",
          "next": [
            202050013
          ]
        },
        "202050013": {
          "id": 202050013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202050014
          ]
        },
        "202050014": {
          "id": 202050014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "I invited every friend she has in this slate thingy. There's an Agy, and uh, wait, let's see here. There's Agy, Big Sis Tribbie, Prof Nax, Undying Little Prince, Princess Homebody, Pink Cupcake, Retired Deliverer Boy, Great Imperator, Fish Jerky Supplier, Zaggy, and Gray Mystery. Oh, that's you. What a lovely name. Easy to remember, and full of personality.",
          "next": [
            202050015
          ]
        },
        "202050015": {
          "id": 202050015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202050016,
            202050017,
            202050019
          ]
        },
        "202050016": {
          "id": 202050016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Granny, please don't take these names too seriously",
          "next": [
            202050020
          ]
        },
        "202050017": {
          "id": 202050017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Will the table be big enough? I can bring one over",
          "next": [
            202050018
          ]
        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Plenty of room, dear. The table's big enough, and so is the pot.",
          "next": [
            202050020
          ]
        },
        "202050019": {
          "id": 202050019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A big pot of food! And dumplings!",
          "next": [
            202050020
          ]
        },
        "202050020": {
          "id": 202050020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Oh dear, the kids at home are already. Stop running around! They're already here. Let me get them settled. My goodness. Well, we'll be waiting for you. Cifera will be absolutely thrilled.",
          "next": [
            202050021
          ]
        },
        "202050021": {
          "id": 202050021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202050022
          ]
        },
        "202050022": {
          "id": 202050022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "I'm baaack!",
          "next": [
            202050023
          ]
        },
        "202050023": {
          "id": 202050023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Gray Mystery, come on, let's eat!",
          "next": [
            202050024
          ]
        },
        "202050024": {
          "id": 202050024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Or else Grandma will grab my teleslate and start spamming everyone again",
          "next": [
            202050025
          ]
        },
        "202050025": {
          "id": 202050025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "See you soon!",
          "next": []
        }
