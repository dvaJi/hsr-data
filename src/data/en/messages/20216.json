        },
        "202160002": {
          "id": 202160002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Before turning away, I took one last look at the stars. Look~",
          "next": [
            202160003
          ]
        },
        "202160003": {
          "id": 202160003,
          "type": "Image",
          "sender": "NPC",
