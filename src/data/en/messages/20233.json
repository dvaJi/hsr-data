        "202330005": {
          "id": 202330005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Classic Mode",
          "next": [
            202330006
          ]
        },
        "202330006": {
          "id": 202330006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "\"Start in Classic Mode\" Background -10, Intelligence -10, Stamina -10, Strength -10, Vitality -10",
          "next": [
            202330007
          ]
        },
        "202330007": {
          "id": 202330007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{NICKNAME}'s Life Script: <i>I've Been Reborn: Mom, Life Is a Wilderness</i>",
          "next": [
            202330008
          ]
        },
        "202330008": {
          "id": 202330008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "And now, take the first step of your life",
          "next": [
            202330009,
            202330016
          ]
        },
        "202330009": {
          "id": 202330009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I'm the conductor: first on board the Astral Express!",
          "next": [
            202330010
          ]
        },
        "202330010": {
          "id": 202330010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "As a child, {NICKNAME} boarded the Astral Express and wouldn't get down",
          "next": [
            202330011
          ]
        },
        "202330011": {
          "id": 202330011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "As an adolescent, {NICKNAME} expertly steered the Express out of trouble when the universe was in crisis",
          "next": [
            202330012
          ]
        },
        "202330012": {
          "id": 202330012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "As a young adult, {NICKNAME} fell into an Aeon's trap and couldn't escape",
          "next": [
            202330013
          ]
        },
        "202330013": {
          "id": 202330013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Adulthood awakened their abilities, and they vowed to save the world",
          "next": [
            202330014
          ]
        },
        "202330014": {
          "id": 202330014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Nanook, deceased",
          "next": [
            202330015
          ]
        },
        "202330015": {
          "id": 202330015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "A fantasy tale?",
          "next": [
            202330046
