      "messages": {
        "150500101": {
          "id": 150500101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "My old pal, still got enough money to spend?",
          "next": [
            150500102
          ]
        },
        "150500102": {
          "id": 150500102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "If not, you'll have to dip into your own pocket",
          "next": [
            150500103
          ]
        },
        "150500103": {
          "id": 150500103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "First, here's the first piece of good news",
          "next": [
            150500104
          ]
        },
        "150500104": {
          "id": 150500104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "After the All-You-Can-Lose Challenge wrapped up yesterday, we called Work-Work back and tallied up all the income and expenses",
          "next": [
            150500105
          ]
        },
        "150500105": {
          "id": 150500105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "While some of the expenditures were... questionable, we don't believe it actually broke any rules",
          "next": [
            150500106,
            150500108
          ]
        },
        "150500106": {
          "id": 150500106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "How is that good news? I always spend my money by the book",
          "next": [
            150500107
          ]
        },
        "150500107": {
          "id": 150500107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Just worried you'll fail the challenge for breaking the rules, that's all!",
          "next": [
            150500110
          ]
        },
        "150500108": {
          "id": 150500108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Offering the first piece of good news... does that mean there's a second?",
          "next": [
            150500109
          ]
        },
        "150500109": {
          "id": 150500109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Sorry, we want the most authentic reactions possible, so that's all we can reveal for now",
          "next": [
            150500110
          ]
        },
        "150500110": {
          "id": 150500110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "I've sent you the address. Come find me at the Lodestar Tower, and we'll wrap up the final settlement recording for the All-You-Can-Lose Challenge",
          "next": [
            150500111,
            150500112
          ]
        },
        "150500111": {
          "id": 150500111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "OMW! Just stepped out, already hit the road",
          "next": [
            150500113
          ]
        },
        "150500112": {
          "id": 150500112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wait for me, need a while longer",
          "next": [
            150500113
          ]
        },
        "150500113": {
          "id": 150500113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "Take your time. By the way, Mr. Aventurine is on his way too",
          "next": [
            150500114
          ]
        },
        "150500114": {
          "id": 150500114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "We'll finalize the challenge results once you're here",
