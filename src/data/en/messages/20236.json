          ]
        },
        "202360016": {
          "id": 202360016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "I'm reviewing the surveillance footage of Cake Cat.",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Are you sneaking a peek at Sesame Cake?",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mm-hmm.",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "How long have you been spying on Cake Cat?",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "I didn't pay attention to the time.",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh, Cake Cat! You could've just said so earlier!",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Next time I'll take you straight in",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Alright, next time for sure.",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "What did you see on the monitors? Is Sesame Cake okay?",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "It has made two new friends.",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "One is white. Seems like this one can't sit tight, has quite the temper, and loves to talk.",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "The other is red. Doesn't talk much, but has quite the temper as well.",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "It's good. Sesame Cake used to keep to itself.",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Did you give them names?",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Me?",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Then let's call them Snowflake Crisp and Red Date Pudding.",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Actually, they're kinda like you. You know, their temper",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "So, have our new friends got their names yet?",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "I don't know. Let me think...",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "How about Red Date Pudding and Snowflake Crisp?",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202360038
