          ]
        },
        "202360012": {
          "id": 202360012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "What are you looking at on the monitors? Doing some intense enemy-tracking on the surveillance feed?",
