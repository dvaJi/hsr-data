        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Now they're fighting each other.",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Looks like their relationship is a bit... strained.",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Now they're licking each other.",
          "next": [
            202360042
          ]
        },
        "202360042": {
          "id": 202360042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Turns out it was just a misunderstanding. They're fine with each other.",
          "next": [
            202360043
          ]
        },
        "202360043": {
          "id": 202360043,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202360044
