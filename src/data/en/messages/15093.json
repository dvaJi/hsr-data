          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Happy now? Finally get to laugh at my expense, huh?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "I've got a few ghost lackeys at the Postmortem Employment Center, you know. They've been hiding nearby and live streaming it the whole time.",
