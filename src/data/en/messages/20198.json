        "201980023": {
          "id": 201980023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "I'll prefer... sweet talk",
          "next": [
            201980024
          ]
        },
        "201980024": {
          "id": 201980024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Oh, do you mean to use those as two separate names?",
