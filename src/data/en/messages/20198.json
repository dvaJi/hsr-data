            201980014,
            201980016
          ]
        },
        "201980014": {
          "id": 201980014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Let me touch them!",
          "next": [
            201980015
          ]
        },
        "201980015": {
          "id": 201980015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Be my guest~",
          "next": [
            201980017
          ]
        },
        "201980016": {
          "id": 201980016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Your dream has finally come true!",
          "next": [
            201980017
          ]
        },
        "201980017": {
          "id": 201980017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Though I wonder what names I should give them...",
          "next": [
            201980018
          ]
        },
        "201980018": {
          "id": 201980018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "What are your thoughts on this?",
          "next": [
            201980019,
            201980022,
            201980026
          ]
        },
        "201980019": {
          "id": 201980019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "One is called Cas-cake, the other Cas-fly",
          "next": [
            201980020
          ]
        },
        "201980020": {
          "id": 201980020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Perfect, one is composed while the other is lively",
          "next": [
            201980021
          ]
        },
        "201980021": {
          "id": 201980021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "It suits them perfectly!",
          "next": [
            201980028
