          ]
        },
        "201980008": {
          "id": 201980008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Even now, it still feels like a dream",
          "next": [
            201980009
          ]
        },
        "201980009": {
          "id": 201980009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Thanks to you and everyone else's efforts, things are finally different this time",
