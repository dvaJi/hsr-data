          ]
        },
        "201980011": {
          "id": 201980011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Look, I adopted two stray little chimeras",
          "next": [
            201980012
          ]
        },
        "201980012": {
          "id": 201980012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "They're warm and soft, perfect for cuddling up with when you're trying to sleep",
          "next": [
            201980013
          ]
        },
        "201980013": {
          "id": 201980013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "It feels completely different from a chimera doll",
