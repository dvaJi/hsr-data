      "messages": {
        "150080101": {
          "id": 150080101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} @March 7th, are you alright?",
          "next": [
            150080102
          ]
        },
        "150080102": {
          "id": 150080102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "I heard you two ran into some trouble",
          "next": [
            150080103
          ]
        },
        "150080103": {
          "id": 150080103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "What's going on?",
          "next": [
            150080104
          ]
        },
        "150080104": {
          "id": 150080104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "We're both fine, but we ran into someone calling herself Sparxie while out shopping",
          "next": [
            150080105
          ]
        },
        "150080105": {
          "id": 150080105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "She declared she'd take me and {NICKNAME} down and exclude the Express Crew from the Phantasmoon Games",
          "next": [
            150080106
          ]
        },
        "150080106": {
          "id": 150080106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "So we better get moving, pronto!",
          "next": [
            150080107
          ]
        },
        "150080107": {
          "id": 150080107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "So, have you all made up your minds?",
          "next": [
            150080108
          ]
        },
        "150080108": {
          "id": 150080108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "I have some ideas, though I'm not sure what {NICKNAME} thinks",
          "next": [
            150080109
          ]
        },
        "150080109": {
          "id": 150080109,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I'm interested in participating in the Phantasmoon Games",
          "next": [
            150080110
          ]
        },
        "150080110": {
          "id": 150080110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I've been wondering what I'd do with this power if I win, or what I could ask Aha to do for me",
          "next": [
            150080111
          ]
        },
        "150080111": {
          "id": 150080111,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I'll tell you all about it when I get the chance",
          "next": [
            150080112
          ]
        },
        "150080112": {
          "id": 150080112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "How are you doing over there? @Dan Heng",
          "next": [
            150080113
          ]
        },
        "150080113": {
          "id": 150080113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "I've made contact with the Xianzhou envoy, but they've run into some issues and are seeking assistance.",
          "next": [
            150080114
          ]
        },
        "150080114": {
          "id": 150080114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sunday and I are on our way.",
          "next": [
            150080115
          ]
        },
        "150080115": {
          "id": 150080115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Contact me if you need anything.",
          "next": [
            150080116
          ]
        },
        "150080116": {
          "id": 150080116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Alright, Himeko, what are we gonna do next?",
          "next": [
            150080117
          ]
        },
        "150080117": {
          "id": 150080117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "I'd like to ask you to go to \"Graphia Academy,\" my alma mater",
          "next": [
            150080118
          ]
        },
        "150080118": {
          "id": 150080118,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "\"Location of Graphia Academy\"",
          "next": [
            150080119
          ]
        },
        "150080119": {
          "id": 150080119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "In this school, there was a teacher called Dollie",
          "next": [
            150080120
          ]
        },
        "150080120": {
          "id": 150080120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "She's my friend, who keeps the mask needed for the Phantasmoon Games",
          "next": [
            150080121
          ]
        },
        "150080121": {
          "id": 150080121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "To avoid any complications, find her and get the mask first",
          "next": [
            150080122
          ]
        },
        "150080122": {
          "id": 150080122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Let's get going!",
          "next": [
            150080123
          ]
        },
        "150080123": {
          "id": 150080123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Welt and I will meet up with you",
          "next": []
        }
