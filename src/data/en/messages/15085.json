  "sections": [
    {
      "id": 1508501,
      "startingMessageId": [
        150850100
      ],
      "messages": {
        "150850100": {
          "id": 150850100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Good morning, good afternoon, good evening~! Another day of being alive and kicking~~",
          "next": [
            150850101
          ]
        },
        "150850101": {
          "id": 150850101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "I never expected to find loose pages from <i>Floating Grease Chronicles</i> here in Astropolis.",
          "next": [
            150850102,
            150850106,
            150850109
          ]
        },
        "150850102": {
          "id": 150850102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "True, who would've guessed!",
          "next": [
            150850103
          ]
        },
        "150850103": {
          "id": 150850103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Looks like there's even more stuff to collect now.",
          "next": [
            150850104
          ]
        },
        "150850104": {
          "id": 150850104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, hey, that's not a bad thing after all!",
          "next": [
            150850105
          ]
        },
        "150850105": {
          "id": 150850105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Thanks to Mr. Arita and his crew, now we've got some work to do.",
          "next": [
            150850114
          ]
        },
        "150850106": {
          "id": 150850106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Isn't this an ancient tome from Planarcadia?",
          "next": [
            150850107
          ]
        },
        "150850107": {
          "id": 150850107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "How did it end up in Astropolis?",
          "next": [
            150850108
          ]
        },
        "150850108": {
          "id": 150850108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hahaha, I'd say we have Mr. Arita and his crew to thank for that!",
          "next": [
            150850114
          ]
        },
        "150850109": {
          "id": 150850109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "...You've been spying on me?",
          "next": [
            150850110
          ]
        },
        "150850110": {
          "id": 150850110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "What perfect timing on that message.",
          "next": [
            150850111
          ]
        },
        "150850111": {
          "id": 150850111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Well, you know, that's because I've got the monitoring equipment from the <i>Floating Grease Chronicles</i>!",
          "next": [
            150850112
          ]
        },
        "150850112": {
          "id": 150850112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "And you're probably the only one who'd bother collecting them for me.",
          "next": [
            150850113
          ]
        },
        "150850113": {
          "id": 150850113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "I can't exactly just go ask Mr. Arita directly, can I?",
          "next": [
            150850114
          ]
        },
        "150850114": {
          "id": 150850114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mr. Arita?",
          "next": [
            150850115
          ]
        },
        "150850115": {
          "id": 150850115,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "What does that have to do with him?",
          "next": [
            150850116
          ]
        },
        "150850116": {
          "id": 150850116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Didn't some exec set up a habitat in Astropolis that imagenae could actually survive in?",
          "next": [
            150850117
          ]
        },
        "150850117": {
          "id": 150850117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Soon after, all manner of imagenae with ties to Astropolis began to appear.",
          "next": [
            150850118
          ]
        },
        "150850118": {
          "id": 150850118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "And among them there's a book that we care about.",
          "next": [
            150850119
          ]
        },
        "150850119": {
          "id": 150850119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Word is, Mr. Arita has also taken an interest in this book.",
          "next": [
            150850120
          ]
        },
        "150850120": {
          "id": 150850120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Anyway, we should meet up when we have the time.",
          "next": [
            150850121
          ]
        },
        "150850121": {
          "id": 150850121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "You don't get to come to Astropolis often. Might as well catch up with some old friends while you're here.",
          "next": []
        }
      },
      "participatingContactsIds": [
        205,
        8001
      ]
    }
  ]
}