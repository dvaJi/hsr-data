            202250002
          ]
        },
        "202250002": {
          "id": 202250002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Of course, we make our own plans and see them through. This move isn't set in stone. The most important thing is to have fun!",
