        },
        "202250001": {
          "id": 202250001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Taking advantage of this lucky moment, and to pray for a thousand-game winning streak, I shall promote my \"Fortuitous Moves\"",
