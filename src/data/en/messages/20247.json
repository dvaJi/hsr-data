            202470005
          ]
        },
        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "This heart rate isn't right! You're freaking me out, Aventurine! Hang in there, I'm coming!",
          "next": [
            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "This heart rate isn't right! Aventurine!!! I'm coming to save you!",
          "next": [
            202470006
          ]
        },
        "202470005": {
          "id": 202470005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "This heart rate can't be right! Where's the IPC!? Where's the Preservation!? Amber Lord! Mother Goddess! He needs help!",
          "next": [
            202470006
          ]
        },
        "202470006": {
          "id": 202470006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Emergency SOS: Aventurine's current location has changed.",
