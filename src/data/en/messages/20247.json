        },
        "202470019": {
          "id": 202470019,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Aventurine's approximate location has changed.",
          "next": [
            202470020
          ]
        },
        "202470020": {
          "id": 202470020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I'm back",
          "next": [
            202470021
          ]
        },
        "202470021": {
          "id": 202470021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Since when did this smart watch become so overly protective? Come on, it is just a fifty-meter wave, no big deal.",
          "next": [
            202470022,
            202470023
          ]
        },
        "202470022": {
          "id": 202470022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "50 meters means a shipwreck alarm! And your heart rate was fluctuating between 20 and 180.",
          "next": [
            202470024
          ]
        },
        "202470023": {
          "id": 202470023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Can surfing cause your heart rate to fluctuate between 20 and 180!?",
          "next": [
            202470024
          ]
        },
        "202470024": {
          "id": 202470024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "So all these gave me away?",
          "next": [
            202470025
          ]
        },
        "202470025": {
          "id": 202470025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Relax. A heart rate of 20 was probably because of me hitting the bottom of the wave, holding my breath.",
          "next": [
            202470026
          ]
        },
        "202470026": {
          "id": 202470026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Even if it spikes to 180, it's still not as high as it was during our nighttime battle in Penacony.",
          "next": [
            202470027
          ]
        },
        "202470027": {
          "id": 202470027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Haha, jokes aside. I'm sorry for making you worry just now.",
          "next": [
            202470028
          ]
        },
        "202470028": {
          "id": 202470028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I'm trying out the latest hover surf-wing.",
          "next": [
            202470029
          ]
        },
        "202470029": {
          "id": 202470029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "That feeling of weightlessness as you dive down from the crest of a giant wave is truly addictive.",
          "next": [
            202470030
          ]
        },
        "202470030": {
          "id": 202470030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202470031
          ]
        },
        "202470031": {
          "id": 202470031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "What luck! Here comes another wave!",
          "next": [
            202470032
          ]
        },
        "202470032": {
          "id": 202470032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I'm going in.",
