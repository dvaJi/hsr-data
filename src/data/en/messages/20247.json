        },
        "202470011": {
          "id": 202470011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Does he still need my help? Does he? Should I? Well, I should...",
          "next": [
            202470012
          ]
        },
        "202470012": {
          "id": 202470012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aventurine! Say something if you're still alive!",
          "next": [
            202470015
          ]
        },
        "202470013": {
          "id": 202470013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Fluctuating between 20 and 180. Is that actually my heart rate?",
          "next": [
            202470014
          ]
        },
        "202470014": {
          "id": 202470014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Are you on a rollercoaster!? Say something if you're still alive!",
          "next": [
            202470015
          ]
        },
        "202470015": {
          "id": 202470015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202470016
          ]
        },
        "202470016": {
          "id": 202470016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Something, something, something! Relax, I'm totally fine. I was just surfing. Give me a sec to get ashore and I'll fill you in.",
          "next": [
            202470017
          ]
        },
        "202470017": {
          "id": 202470017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202470018
          ]
        },
        "202470018": {
          "id": 202470018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202470019
