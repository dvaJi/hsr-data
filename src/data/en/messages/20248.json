  "sections": [
    {
      "id": 2024800,
      "startingMessageId": [
        202470035
      ],
      "messages": {
        "202470035": {
          "id": 202470035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Friend, quick! Give me your answer in three seconds!",
          "next": [
            202470036
          ]
        },
        "202470036": {
          "id": 202470036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Red or blue?",
          "next": [
            202470037,
            202470038,
            202470039
          ]
        },
        "202470037": {
          "id": 202470037,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Red!",
          "next": [
            202470040
          ]
        },
        "202470038": {
          "id": 202470038,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Blue!",
          "next": [
            202470040
          ]
        },
        "202470039": {
          "id": 202470039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Whatever. Scissors!",
          "next": [
            202470041
          ]
        },
        "202470040": {
          "id": 202470040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I knew it.",
          "next": [
            202470043
          ]
        },
        "202470041": {
          "id": 202470041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I knew you wouldn't play by the book, but there are only two options this round.",
          "next": [
            202470042
          ]
        },
        "202470042": {
          "id": 202470042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I'll just pick one for you. I'm sure we're on the same wavelength.",
          "next": [
            202470043
          ]
        },
        "202470043": {
          "id": 202470043,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "What are you betting on this time?",
          "next": [
            202470044
          ]
        },
        "202470044": {
          "id": 202470044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "There's a kid who's been circling my parasol for a while now.",
          "next": [
            202470045
          ]
        },
        "202470045": {
          "id": 202470045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "I thought he was lost, but he actually had his eyes on the sand beneath my feet.",
          "next": [
            202470046
          ]
        },
        "202470046": {
          "id": 202470046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "He told me that I've got the finest sand on the whole beach here, and only sand like this can build the sturdiest sandcastles.",
          "next": [
            202470047
          ]
        },
        "202470047": {
          "id": 202470047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "But the child is pretty interesting. He didn't ask me to just yield ground.",
          "next": [
            202470048
          ]
        },
        "202470048": {
          "id": 202470048,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "He proposed a bet: out of the red and blue hermit crabs in front of us, bet on which one crosses the finish line first.",
          "next": [
            202470049
          ]
        },
        "202470049": {
          "id": 202470049,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "If he wins, he gets the perfect sand.",
          "next": [
            202470050,
            202470051
          ]
        },
        "202470050": {
          "id": 202470050,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I know you would never miss a bet but isn't that kind of unfair to this little child?",
          "next": [
            202470053
          ]
        },
        "202470051": {
          "id": 202470051,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "No wonder you asked me to choose. Any gamble you personally get into is always a dead certainty.",
          "next": [
            202470052
          ]
        },
        "202470052": {
          "id": 202470052,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "So what if we win the bet?",
          "next": [
            202470054
          ]
        },
        "202470053": {
          "id": 202470053,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "So, I'd like you to make the bet.",
          "next": [
            202470054
          ]
        },
        "202470054": {
          "id": 202470054,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202470055
          ]
        },
        "202470055": {
          "id": 202470055,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hold on, that crab's about to cross the finish line.",
          "next": [
            202470056
          ]
        },
        "202470056": {
          "id": 202470056,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "We won.",
          "next": [
            202470057
          ]
        },
        "202470057": {
          "id": 202470057,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Your friend is typing...",
          "next": [
            202470068
          ]
        },
        "202470058": {
          "id": 202470058,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "His own snacks?",
          "next": [
            202470060
          ]
        },
        "202470059": {
          "id": 202470059,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A plastic shovel for building sandcastles?",
          "next": [
            202470060
          ]
        },
        "202470060": {
          "id": 202470060,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "A ring.",
          "next": [
            202470061
          ]
        },
        "202470061": {
          "id": 202470061,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "The kid said grown-ups don't need plastic shovels and snacks, but if the stakes aren't equal, the game isn't fair.",
          "next": [
            202470062
          ]
        },
        "202470062": {
          "id": 202470062,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "So, he gave me a magic ring that can eat nightmares.",
          "next": [
            202470063
          ]
        },
        "202470063": {
          "id": 202470063,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "How cute. This is an out-of-print treasure, just what I need.",
          "next": [
            202470064
          ]
        },
        "202470064": {
          "id": 202470064,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Yeah, I'm gonna buy him a super deluxe 9-cone ice cream.",
          "next": [
            202470065
          ]
        },
        "202470065": {
          "id": 202470065,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Then invite him to legally buy shares in the construction of the Sandcastle State.",
          "next": [
            202470066
          ]
        },
        "202470066": {
          "id": 202470066,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202470067
          ]
        },
        "202470067": {
          "id": 202470067,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "See ya, friend. We're off to move sand.",
          "next": []
        },
        "202470068": {
          "id": 202470068,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Care to guess what he lost to me?",
          "next": [
            202470058,
            202470059
          ]
        }
      },
      "participatingContactsIds": [
        1304,
        8001
      ]
    }
  ]
}