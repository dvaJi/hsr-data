        },
        "150070111": {
          "id": 150070111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Each Phantasmoon Games is like flipping a coin left to us by the Elation. No one knows which side it'll land on.",
