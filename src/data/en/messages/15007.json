        "150070107": {
          "id": 150070107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "She's taken control of Graphia Academy, turned all the students and teachers into her fans, and even snatched away the mask you told us to bring back",
