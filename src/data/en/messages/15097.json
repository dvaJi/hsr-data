        },
        "150970103": {
          "id": 150970103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"Thanks for bringing the little ones back! They've prepared a thank-you gift just for you. Come visit the \"Best Friends' Secret Base\" when you get the chance to pick it up!\"",
          "next": [
            150970104
          ]
        },
        "150970104": {
          "id": 150970104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "\"Oh, and one more thing! I also left a little gift for you in Duomension City. As for where it is exactly...\"",
          "next": [
            150970106
          ]
        },
        "150970105": {
          "id": 150970105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Alright, that's all! I'll be waiting for you over there~",
          "next": []
        },
