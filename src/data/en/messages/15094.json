      "messages": {
        "150940100": {
          "id": 150940100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "Posted by on-duty drinksmith Zhongshanshan",
          "next": [
            150940101
          ]
        },
        "150940101": {
          "id": 150940101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "\"Good morning, noon, evening, and midnight. Your old friend Grove is back to say hello.\"",
          "next": [
            150940102
          ]
        },
        "150940102": {
          "id": 150940102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "\"Life under someone else's roof is never easy, and as you can see in the current version: no prizes whatsoever.\"",
          "next": [
            150940103
          ]
        },
        "150940103": {
          "id": 150940103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "\"But please, don't lose heart. The final prize has long been prepared. What truly troubles me now is how to make it mean what it once did.\"",
          "next": [
            150940104
          ]
        },
        "150940104": {
          "id": 150940104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "\"Let me dwell in my worries alone for a while. May we meet again in Planarcadia, redeemed and whole.\"",
          "next": [
            150940105
          ]
        },
        "150940105": {
          "id": 150940105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "—Or so says the umbrella-head.",
          "next": [
            150940106
          ]
        },
        "150940106": {
          "id": 150940106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "He might actually make a pretty good Mourning Actor.",
          "next": []
        }
      },
