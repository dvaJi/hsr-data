  "sections": [
    {
      "id": 2020700,
      "startingMessageId": [
        202070000
      ],
      "messages": {
        "202070000": {
          "id": 202070000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Partner! Do you remember that promise we made?",
          "next": [
            202070001
          ]
        },
        "202070001": {
          "id": 202070001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "About the ending of the \"Legend of Celestial Skies.\"",
          "next": [
            202070002,
            202070004,
            202070005
          ]
        },
        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Of course, but I'd suggest you read it for yourself now.",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "It's so good that I'd hate to spoil it for you",
          "next": [
            202070006
          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Why don't you read it for yourself? It's so good, I'd hate to spoil it",
          "next": [
            202070006
          ]
        },
        "202070005": {
          "id": 202070005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I haven't read it yet",
          "next": [
            202070006
          ]
        },
        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hehe. Actually, I couldn't resist and secretly read it a while back.",
          "next": [
            202070007
          ]
        },
        "202070007": {
          "id": 202070007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "The heroes traveled through time and space, and teamed up to defeat the final boss, but then its power teleported them to another world where they had to start their lives all over again from scratch",
          "next": [
            202070008
          ]
        },
        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "I'm dying to know what happens next, but the story just ends right there!",
          "next": [
            202070009
          ]
        },
        "202070009": {
          "id": 202070009,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070010,
            202070012,
            202070014
          ]
        },
        "202070010": {
          "id": 202070010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "That's unacceptable!",
          "next": [
            202070011
          ]
        },
        "202070011": {
          "id": 202070011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "I know, right!?",
          "next": [
            202070016
          ]
        },
        "202070012": {
          "id": 202070012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alright, I'm counting on you to write the rest!",
          "next": [
            202070013
          ]
        },
        "202070013": {
          "id": 202070013,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070016
          ]
        },
        "202070014": {
          "id": 202070014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "It's a writing technique. You know, to leave something for the reader's imagination",
          "next": [
            202070015
          ]
        },
        "202070015": {
          "id": 202070015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Okay, it definitely did that!",
          "next": [
            202070016
          ]
        },
        "202070016": {
          "id": 202070016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "But I guess that's also what makes one want to pick up the next book",
          "next": [
            202070017
          ]
        },
        "202070017": {
          "id": 202070017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "So partner, have you read anything interesting lately? I'm in a reading slump",
          "next": [
            202070018,
            202070021,
            202070023
          ]
        },
        "202070018": {
          "id": 202070018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "You should totally check out the mystery novellas March wrote a while back",
          "next": [
            202070019
          ]
        },
        "202070019": {
          "id": 202070019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "You'll never guess who the killer is, or even how many of them there are",
          "next": [
            202070020
          ]
        },
        "202070020": {
          "id": 202070020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I'll send you the link in a bit",
          "next": [
            202070025
          ]
        },
        "202070021": {
          "id": 202070021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "I highly recommend Castorice's fanfics",
          "next": [
            202070022
          ]
        },
        "202070022": {
          "id": 202070022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Her writing style is so versatile. There's always one that will just leave you in awe",
          "next": [
            202070025
          ]
        },
        "202070023": {
          "id": 202070023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "There is a lot of amazing Amphorean literature, too",
          "next": [
            202070024
          ]
        },
        "202070024": {
          "id": 202070024,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "I'll go through my collection again and make you a list later",
          "next": [
            202070025
          ]
        },
        "202070025": {
          "id": 202070025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Awesome! I can't wait!",
          "next": [
            202070026
          ]
        },
        "202070026": {
          "id": 202070026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "And if I find anything interesting, I'll be sure to share it with you",
          "next": [
            202070027
          ]
        },
        "202070027": {
          "id": 202070027,
          "type": "Sticker",
