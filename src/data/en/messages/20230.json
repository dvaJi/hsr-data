          ]
        },
        "202300026": {
          "id": 202300026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Woof woof woof my money woof woof woof! Woof woof woof woof!",
          "next": [
            202300027
          ]
        },
        "202300027": {
          "id": 202300027,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202300028
          ]
        },
        "202300028": {
          "id": 202300028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "No barking, doggy! Woof woof woof woof woof!",
