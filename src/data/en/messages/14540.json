        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hey partner, it's rare to run into you like this. Let's settle this with our chimeras, shall we?",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hmph, try not to lose too badly, Deliverer",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Trying to stand in my way? Hah, let's see if you've got what it takes",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "No matter, I'll clear all the obstacles in the Imperator's way",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hey Gray Mystery, wanna make a deal? I'll steal the opponent's chimera, and you throw a match for me",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Drop those little schemes, Cifera. You know you can't hide anything from the golden thread.",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "No conspiring or cheating! <b>We</b> will be the referees and keep an eye on everyone!",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "How is it fair for someone to simultaneously be the referee and a participant?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Hmm... Tribbie will battle, Trinnon will be the referee, and Trianne will catch the bad guys. Yep, that's perfect!",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, I will also give my all in this chimera competition.",
