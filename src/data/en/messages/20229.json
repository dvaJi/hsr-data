        "202290005": {
          "id": 202290005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Early Access Question 1:",
          "next": [
            202290006
          ]
        },
        "202290006": {
          "id": 202290006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "\"Late at night, the victim was looking for food in the kitchen when a sudden loud bang rang out, and he was killed on the spot.\" Now, please reconstruct the crime scene...",
          "next": [
            202290007,
            202290012,
            202290017
          ]
        },
        "202290007": {
          "id": 202290007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "A starving victim sneaked into someone else's kitchen for a quick bite, only to run smack into the homeowner, who heard the noise and knocked him out.",
          "next": [
            202290008
          ]
        },
        "202290008": {
          "id": 202290008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hmm, sounds like a perfectly reasonable break-in. But you seem to have missed a crucial clue: The loud bang.",
          "next": [
            202290009
          ]
        },
        "202290009": {
          "id": 202290009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Why'd it go \"bang\" instead of \"ah\"?",
          "next": [
            202290010
          ]
        },
        "202290010": {
          "id": 202290010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "The answer is...",
          "next": [
            202290011
          ]
        },
        "202290011": {
          "id": 202290011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "That the victim was a cockroach.",
          "next": [
            202290021
          ]
        },
        "202290012": {
          "id": 202290012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "The homeowner was starving. In desperation, they ate some spoiled food and died, hitting the floor with a loud bang.",
          "next": [
            202290013
          ]
        },
        "202290013": {
          "id": 202290013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "It looks like murder, but turns out to be an accident. Nice twist in your thinking. Unfortunately, you're off the mark.",
          "next": [
            202290014
          ]
        },
        "202290014": {
          "id": 202290014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "People get hungry at any time of day, and they can eat whenever they want. The key to this question here is \"late at night.\"",
          "next": [
            202290015
          ]
        },
        "202290015": {
          "id": 202290015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "The answer is...",
          "next": [
            202290016
          ]
        },
        "202290016": {
          "id": 202290016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "The victim was a cockroach.",
          "next": [
            202290021
          ]
        },
        "202290017": {
          "id": 202290017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Late at night... kitchen... food... and a loud bang...",
          "next": [
            202290018
          ]
        },
        "202290018": {
          "id": 202290018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "The victim was a cockroach.",
          "next": [
            202290019
