        "202080013": {
          "id": 202080013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "I've had a few drinks and I'm in quite the mood. Little Gray Fry, anything you'd like to hear? I can play something for you.",
