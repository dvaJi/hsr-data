            202080008
          ]
        },
        "202080008": {
          "id": 202080008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Mmm. I've made a new violin. It's adorned with shimmering pearly shells, the strings were made by the Goldweaver, and was named by the Imperator. Its harmonics are like light on waves. Now, it exists only to be played.",
          "next": [
            202080009
          ]
        },
        "202080009": {
          "id": 202080009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Voice message converted to text",
          "next": [
            202080010
          ]
        },
        "202080010": {
          "id": 202080010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "I haven't played a proper song in ages, so my fingers might be a little stiff.",
          "next": [
            202080011
          ]
        },
        "202080011": {
          "id": 202080011,
          "type": "Text",
