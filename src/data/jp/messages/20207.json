          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "自分で読んでみ{F#な}{M#ろ}よ。すごく面白いから、ネタバレはしたくない{F#の}{M#んだ}",
