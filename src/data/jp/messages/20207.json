        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "もちろん覚えてるけど、今となっては自分で読んだほうがいいんじゃない{F#}{M#か}？",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "とても面白かったから、ネタバレはしたくない{F#よ}{M#な}",
