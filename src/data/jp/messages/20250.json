  "sections": [
    {
      "id": 2025000,
      "startingMessageId": [
        202500000
      ],
      "messages": {
        "202500000": {
          "id": 202500000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "住所：ピアポイント スターピースカンパニー戦略投資部 パールのアトリエ・3F",
          "next": [
            202500001
          ]
        },
        "202500001": {
          "id": 202500001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "{NICKNAME}さん、星穹列車で今後、処分する壊れた品や廃品があればワタシに送ってください。引き取ります。",
          "next": [
            202500002,
            202500005
          ]
        },
        "202500002": {
          "id": 202500002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "それって、パールの副業{F#}{M#か}？",
          "next": [
            202500003
          ]
        },
        "202500003": {
          "id": 202500003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "副業とは、本業とは別に余暇を使って行い、収入を伴う第二の仕事を指します。",
          "next": [
            202500004
          ]
        },
        "202500004": {
          "id": 202500004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "ですが、先ほど言った「廃品回収計画」ではワタシが皆様に代金をお支払いします。",
          "next": [
            202500009
          ]
        },
        "202500005": {
          "id": 202500005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "廃品？どこにあるかな？人間も回収できるの{F#}{M#か}？",
          "next": [
            202500006
          ]
        },
        "202500006": {
          "id": 202500006,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500007
          ]
        },
        "202500007": {
          "id": 202500007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "厳密に言えば、有機生命体も「廃品再生」の対象になりえます。ですが、引き取りにかかる費用が予算を大幅に超えてしまいます",
          "next": [
            202500008
          ]
        },
        "202500008": {
          "id": 202500008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "それ以外の品であれば、予算は十分です",
          "next": [
            202500009
          ]
        },
        "202500009": {
          "id": 202500009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "廃品を回収して、コレクションにするの{F#}{M#か}？",
          "next": [
            202500010
          ]
        },
        "202500010": {
          "id": 202500010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "その前段階です。ワタシにとって、古い品を修復することは、思い立った時にいつでも出発することができる「脳内旅行」のようなものなのです",
          "next": [
            202500011
          ]
        },
        "202500011": {
          "id": 202500011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "ワタシは「諸世界再建計画」の業務で、持ち主のいない遺産を数多く修復してきました",
          "next": [
            202500012
          ]
        },
        "202500012": {
          "id": 202500012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "模様を少しずつ合わせていくと、知らない星の情報が脳内に流れ込んできます…風鈴、浅瀬、氷河、それから言葉では言い表せない文明と景色の数々が",
          "next": [
            202500013
          ]
        },
        "202500013": {
          "id": 202500013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "その後はたいてい、長い間作業に没頭します",
          "next": [
            202500014,
            202500016,
            202500019
          ]
        },
        "202500014": {
          "id": 202500014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "そんな趣味があるなんて、羨ましいな……",
          "next": [
            202500015
          ]
        },
        "202500015": {
          "id": 202500015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "まさか仕事だったなんて{F#}{M#な}",
          "next": [
            202500020
          ]
        },
        "202500016": {
          "id": 202500016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "このワーカホリックめ！{F#私}{M#俺}が相手{F#だよ}{M#だ}！",
          "next": [
            202500017
          ]
        },
        "202500017": {
          "id": 202500017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "アナタが修復のいる品だったとは",
          "next": [
            202500018
          ]
        },
        "202500018": {
          "id": 202500018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "冗談です",
          "next": [
            202500020
          ]
        },
        "202500019": {
          "id": 202500019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いろいろ直すのもいいけど、出かけよう{F#よ}{M#}！仕事はいったんお休み！旅行だ、旅行！",
          "next": [
            202500020
          ]
        },
        "202500020": {
          "id": 202500020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "今ので思い出したことがあります。以前、メディアから「仕事と生活をどのように両立しているのですか？」と聞かれたことがありました",
          "next": [
            202500021
          ]
        },
        "202500021": {
          "id": 202500021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "ワタシはまず、ルイス・フレミングに聞いてみるよう勧めました。次に「アナタは呼吸することと生きることを、どう両立させているのですか？」と質問しました。そうしたらそれ以上、質問されることはありませんでした",
          "next": [
            202500022
          ]
        },
        "202500022": {
          "id": 202500022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "そしてもう1つ。星穹列車で不要になった品や、旅の途中で拾った破損品を修復することも、「開拓」を感じる芸術の旅と言えます",
          "next": [
            202500023
          ]
        },
        "202500023": {
          "id": 202500023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "豆知識の1つ付けましょう。海の真珠もまた、「廃品再生」によって生まれたものです",
          "next": [
            202500024
          ]
        },
        "202500024": {
          "id": 202500024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500025
          ]
        },
        "202500025": {
          "id": 202500025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "この個人的な取引に期限はありません。星穹列車から届く「旅の掘り出し物」を楽しみにしています",
          "next": []
        }
      },
      "participatingContactsIds": [
        1503,
        8001
      ]
    }
  ]
}