        },
        "202160014": {
          "id": 202160014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "あなたがどこにいても、オンパロスの星はあなたのために瞬くわ。あたしがあなたにウインクするみたいにね！",
