            202160009
          ]
        },
        "202160009": {
          "id": 202160009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "それを見つめて、思いを込め続ければ、かならず光はあなたの目に届くはず",
          "next": [
            202160010
          ]
        },
        "202160010": {
          "id": 202160010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "きっと、これがあたしの1番の願いなのよね——",
