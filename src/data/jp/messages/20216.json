            202160006
          ]
        },
        "202160006": {
          "id": 202160006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "もっと大胆に考えれば、あたしだって「性格ハンター」？になれるかもしれないのよね…あるいは、ナナシビトにだってなれるかも？",
          "next": [
            202160007
          ]
