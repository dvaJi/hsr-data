        "202410029": {
          "id": 202410029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "実は、仕舞い込んだままのウィッグが十数個もあるの…大学生の頃、素子と一緒に図面を描いたり、何かを作ったり修理したりって作業の息抜きに、いろいろとウィッグを用意してはカットして、お互いにかぶせあってたの",
          "next": [
            202410030
          ]
        },
        "202410030": {
          "id": 202410030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "話を逸らそうとしてる{F#でしょ}{M#だろ}！",
          "next": [
