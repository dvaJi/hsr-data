          ]
        },
        "202410031": {
          "id": 202410031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "これでようやく、みんなにもこれをかぶせる理由ができたわね。あんたたちがどんな髪型や色を気に入るか、見てみたかったの",
          "next": [
            202410032
