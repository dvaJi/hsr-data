        "150010108": {
          "id": 150010108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "人間の生徒の髪なんて色々すぎてどの子のことかなんてわからないですよ。でも、もっと頑張りますから！",
