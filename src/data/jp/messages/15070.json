        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "千星シティに「神聖ウーウーボ」っていう映画スターがいるらしいんだけど、知ってる{F#}{M#か}？",
          "next": [
            150700104
