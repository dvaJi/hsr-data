        },
        "202140012": {
          "id": 202140012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "少しだが彼らの様子を真似てみた。犬は退屈な時、ただ声を上げるだけでなくあちこち歩き回ったりするものだからな",
          "next": [
            202140013
          ]
        },
        "202140013": {
          "id": 202140013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "意味するところはだいたい、一緒に遊ぼう、どこかへ出かけよう、といったところか",
          "next": [
            202140014
          ]
        },
        "202140014": {
