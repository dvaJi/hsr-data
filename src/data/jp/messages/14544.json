          ]
        },
        "145440108": {
          "id": 145440108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "言っておくけど、きちんと訓練を積んでいけば、藤餅はさらに多くの魔法を修得するはずだから",
          "next": [
            145440109
          ]
        },
        "145440109": {
          "id": 145440109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "けど、美貌については、これ以上改善する余地なんてなさそうだね",
          "next": [
            145440110
          ]
        },
        "145440110": {
          "id": 145440110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "わかったから、こっそり訓練するのはやめてよ",
          "next": [
            145440111
          ]
        },
        "145440111": {
          "id": 145440111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "ああ、ラッキーお菓子になりたい……",
