        },
        "145440112": {
          "id": 145440112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "玉兆に近づいても反応がなくなって、そうすればもう仕事のメッセージも受け取らなくていいよね",
          "next": [
            145440113
          ]
        },
        "145440113": {
          "id": 145440113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "そのくらいの願いなら叶えてあげられるけど、試してみる？",
          "next": [
            145440114
          ]
        },
        "145440114": {
          "id": 145440114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "やめとく！",
