        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "うん…最近はやっと自分の時間が持てるようになったんだけど、なんだかじっとしていられなくてね。何かできることはないか探しているんだ",
          "next": [
            202060009
          ]
