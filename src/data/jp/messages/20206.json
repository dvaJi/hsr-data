        },
        "202060016": {
          "id": 202060016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "水彩画家はどう{F#かな}{M#だ}？色彩感覚が磨ける{F#よ}{M#だろ}",
