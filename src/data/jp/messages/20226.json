      "messages": {
        "202260000": {
          "id": 202260000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "今日は顔を上げて太陽を見上げるべし、うつむき焦るべからず。就寝前には大いに歌うべし、三食を控えることなかれ",
          "next": [
            202260001
          ]
        },
        "202260001": {
          "id": 202260001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "まとめると、本日の卦象は「吉」ね。おめでとう",
          "next": [
            202260002,
            202260005
          ]
        },
        "202260002": {
          "id": 202260002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どうしてそこまでわかった{F#の}{M#んだ}？",
          "next": [
            202260003
          ]
        },
        "202260003": {
          "id": 202260003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "ちょうど緑の葉が1枚、私の前に落ちてきたから",
          "next": [
            202260004
          ]
        },
        "202260004": {
          "id": 202260004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "落ち葉がいずれ根に還るがごとく因果は結び、吉凶は心の中で自ずと明らかになる、そういうものなのよ",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260005": {
          "id": 202260005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "それじゃ明日の卦象は？占ってみて{F#}{M#くれ}、爻光先生",
          "next": [
            202260006
          ]
        },
        "202260006": {
          "id": 202260006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "さっき私の前に落ちてきた緑の葉は1枚だけだったの",
          "next": [
            202260007
          ]
        },
        "202260007": {
          "id": 202260007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "明日はどの葉が根に還りたいと願うのか、それは私にもわからないから",
          "next": [
            202260008
          ]
        },
        "202260008": {
          "id": 202260008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "明日のことは、明日が来てから話せばいいのよ",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260009": {
          "id": 202260009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "さすが爻光だ{F#ね}{M#な}",
