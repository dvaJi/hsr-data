        },
        "202260015": {
          "id": 202260015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "専用の道具を用いた占いを除けば、より柔軟な占いというのは往々にしてこういった方法を取るものなの",
