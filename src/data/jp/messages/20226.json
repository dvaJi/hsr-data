            202260010
          ]
        },
        "202260010": {
          "id": 202260010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "でも、なんとなく煙に巻かれてるような気がするんだけど",
          "next": [
            202260013
          ]
        },
        "202260011": {
          "id": 202260011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ずいぶん変わった方法で占うんだ{F#ね}{M#な}",
          "next": [
            202260012
          ]
        },
        "202260012": {
          "id": 202260012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "でも、なんとなく煙に巻かれてるような気がするんだけど",
