      "messages": {
        "202390000": {
          "id": 202390000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "我が財宝よ",
          "next": [
            202390001
          ]
        },
        "202390001": {
          "id": 202390001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "この我が決めた。今日この日こそ、二相楽園壊滅の日だ！",
          "next": [
            202390002
          ]
        },
        "202390002": {
          "id": 202390002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "我と共にウルクへ帰りたくば、今すぐ二次元シティの広場まで来い！",
          "next": [
            202390003
          ]
        },
        "202390003": {
          "id": 202390003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "5分だ、遅れれば我が{RUBY_B#ヴィマーナ}天翔る王の御座{RUBY_E#}は貴様を残して発つ！",
          "next": [
            202390004,
            202390006,
            202390007
          ]
        },
        "202390004": {
          "id": 202390004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}の意見は？？？",
          "next": [
            202390005
          ]
        },
        "202390005": {
          "id": 202390005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "これが戯れにでも聞こえたか！今まさに、貴様に問うてやったであろう！",
          "next": [
            202390009
          ]
        },
        "202390006": {
          "id": 202390006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "何があった{F#の}{M#んだ}？？？",
          "next": [
            202390009
          ]
        },
        "202390007": {
          "id": 202390007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "「！」が多すぎない{F#}{M#か}？文字だけでもうるさい{F#んだけど}{M#ぞ}",
          "next": [
            202390008
          ]
        },
        "202390008": {
          "id": 202390008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "当然であろう。王の声とは、いかなる時も雷鳴のごとく轟くべきものだ！",
          "next": [
            202390009
          ]
        },
        "202390009": {
          "id": 202390009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "仕方あるまい、我の憤りの理由を教えてやろう。我の「ギルグルメ通り」が、開業から今日まで閑散としたままというではないか！",
          "next": [
            202390010
          ]
        },
        "202390010": {
          "id": 202390010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "金箔アイスクリーム！金箔ツナサラダ！金箔ウェンワークの怪蛇ステーキ！金箔終末獣の丸焼き！",
          "next": [
            202390011
          ]
        },
        "202390011": {
          "id": 202390011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "どれもこれも、この我自ら、超一流のセンスで選び抜いた超一流の品だというのに！この地の雑種どもが見向きもせんとは…",
          "next": [
            202390012
          ]
        },
        "202390012": {
          "id": 202390012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "ええい、もうよい！あと5分も待つものか！今すぐ我が裁きを下してくれる！",
          "next": [
            202390013,
            202390015
          ]
        },
        "202390013": {
          "id": 202390013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "王よ、どうか怒りをお鎮めください。彼らには審美眼が欠けていたのです",
          "next": [
            202390014
          ]
        },
        "202390014": {
          "id": 202390014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "フン、我の施しの価値を理解できるのが貴様だけとは、つくづくおかしな場所よな",
          "next": [
            202390017
          ]
        },
        "202390015": {
          "id": 202390015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "金箔アイスクリームはともかく、それ以外は本当に食べられるの{F#}{M#か}？",
          "next": [
            202390016
          ]
        },
        "202390016": {
          "id": 202390016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "貴様まで王の施しを拒むというのか？まったく、この銀河は本当に救いようがない",
          "next": [
            202390017
          ]
        },
        "202390017": {
          "id": 202390017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "はっ、この有り様では、我自らこの地を壊滅させるほどの価値すらあるまいよ",
          "next": [
            202390018
          ]
        },
        "202390018": {
          "id": 202390018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "雑種どもの無礼は許してやろう。毎日のように粗末なものばかり口にしていたのでは、我の美学を理解できぬのも無理からぬことよ",
          "next": [
            202390019
          ]
        },
        "202390019": {
          "id": 202390019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "よい、下がれ我が財宝よ！我は金箔スラーダの開発に忙しいのでな",
          "next": [
            202390020
          ]
        },
        "202390020": {
          "id": 202390020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1509,
          "text": "3日もあれば、必ずやこの楽園を我が前に跪かせてくれよう！",
          "next": [
            202390021
          ]
        },
        "202390021": {
          "id": 202390021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ユーザーが圏外のため、メッセージを送信できません。しばらくしてから、再度お試しください",
          "next": []
        }
      },
