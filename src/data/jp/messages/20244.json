        "202440003": {
          "id": 202440003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "<u>【シェア】作曲のコツ：毎日デモを必ず1曲書くこと︱Nibor空飛ぶカラス</u>",
