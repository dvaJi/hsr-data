  "sections": [
    {
      "id": 2022800,
      "startingMessageId": [
        202280000
      ],
      "messages": {
        "202280000": {
          "id": 202280000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "{NICKNAME}様、ごきげんよう。「語り部」です。",
          "next": [
            202280001
          ]
        },
        "202280001": {
          "id": 202280001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "突然ですが、貴方が普段どのようなものを好んで召し上がっているかをお聞かせいただけないでしょうか？また、おすすめのものがあれば、ぜひお伺いしたいです。",
          "next": [
            202280002
          ]
        },
        "202280002": {
          "id": 202280002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "手ごろな価格で、栄養が取れるものであればなお望ましいですね。",
          "next": [
            202280003,
            202280006,
            202280009
          ]
        },
        "202280003": {
          "id": 202280003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "「健康チャーハン」、ヘルシーだし、無添加で栄養満点。でも薄味",
          "next": [
            202280004
          ]
        },
        "202280004": {
          "id": 202280004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "ベロブルグソーセージとか仙舟の焼き鳥みたいな違う国の軽食はどう？星間デリバリーで注文した翌日には届く{F#よ}{M#ぞ}！",
          "next": [
            202280005
          ]
        },
        "202280005": {
          "id": 202280005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "それは別途送料がかかるそうですね。コストを計算させていただきます。おすすめしていただき、ありがとうございました。",
          "next": [
            202280011
          ]
        },
        "202280006": {
          "id": 202280006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "おすすめするのは難しい{F#かも}{M#かもな}…{F#私}{M#俺}が好きなのって、あまり栄養は取れないのばっかり{F#なの}{M#なんだ}",
          "next": [
            202280007
          ]
        },
        "202280007": {
          "id": 202280007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "串焼き、なんでも煮込み、爽快茶、手羽バーガー、ケーキとか……",
          "next": [
            202280008
          ]
        },
        "202280008": {
          "id": 202280008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "あの不死の名探偵と比べれば、よほど栄養バランスの取れた食生活を送っておいでですよ。",
          "next": [
            202280011
          ]
        },
        "202280009": {
          "id": 202280009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "バナナしか好きじゃないと思ってた……",
          "next": [
            202280010
          ]
        },
        "202280010": {
          "id": 202280010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "私ではなく、不死途さんの食べ物の話をしています。",
          "next": [
            202280011
          ]
        },
        "202280011": {
          "id": 202280011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "困ったことに不死途さんは最近、毎食私と一緒にバナナを食べています。おおかた、手軽でいいと思っているか、節約のためでしょう。",
          "next": [
            202280012
          ]
        },
        "202280012": {
          "id": 202280012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "しかし、人間に必要な栄養素が不足すれば、彼の頭は今よりさらに鈍くなってしまいます。",
          "next": [
            202280013
          ]
        },
        "202280013": {
          "id": 202280013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "何度もスマホを忘れるのは、栄養が不足している時の症状の1つです。",
          "next": [
            202280014
          ]
        },
        "202280014": {
          "id": 202280014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "そこで彼の食生活を私が見直してさしあげることにしました。",
          "next": [
            202280015,
            202280016
          ]
        },
        "202280015": {
          "id": 202280015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どうやる{F#の}{M#んだ}？{F#私}{M#俺}も健康管理したい！",
          "next": [
            202280018
          ]
        },
        "202280016": {
          "id": 202280016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "なんて素晴らしいシッター型助手なんだ！",
          "next": [
            202280017
          ]
        },
        "202280017": {
          "id": 202280017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "あのいい加減な彼のことですから、私がお世話をすることになるのも想定内です。",
          "next": [
            202280018
          ]
        },
        "202280018": {
          "id": 202280018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "最初の数日は、すりつぶしたバナナにこっそり他のフルーツを混ぜておきました。",
          "next": [
            202280019
          ]
        },
        "202280019": {
          "id": 202280019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "効果は上々で、食欲も正常でしたし、明らかに嫌がっている素振りや、ストレス反応もありませんでした。",
          "next": [
            202280020
          ]
        },
        "202280020": {
          "id": 202280020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "これから、徐々に新しい食料の割合を増やし、人間が好む温かい食べ物を段階的に加えていきます。",
          "next": [
            202280021
          ]
        },
        "202280021": {
          "id": 202280021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "こうすれば胃腸を守りつつ、味覚面から他の人間の食べ物への興味を呼び覚ますこともできるはずです。",
          "next": [
            202280022
          ]
        },
        "202280022": {
          "id": 202280022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "すべての工程を踏むために最低でも7日間かかります。よって——チェンジ7日法と呼ぶことにしました。とても科学的で良い方法だと思います。",
          "next": [
            202280023,
            202280024
          ]
        },
        "202280023": {
          "id": 202280023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "チェンジ7日法だ{F#ね}{M#な}、勉強になった！",
          "next": [
            202280026
          ]
        },
        "202280024": {
          "id": 202280024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}のほうが、よっぽどあの探偵の主人に見える{F#ね}{M#な}",
          "next": [
            202280025
          ]
        },
        "202280025": {
          "id": 202280025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "私たちが探偵とその助手であることは変わりません。",
          "next": [
            202280026
          ]
        },
        "202280026": {
          "id": 202280026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ふむ、昨日はリンゴ2個、卵1個、もち米1杯、バナナ大さじ1杯、塩が3缶ですね。",
          "next": [
            202280027
          ]
        },
        "202280027": {
          "id": 202280027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "おっと、そろそろ彼が戻る時間です。今日の「リンゴとバナナの塩タルト」の準備をして参ります。",
          "next": [
            202280028
          ]
        },
        "202280028": {
          "id": 202280028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "それでは、失礼します。",
          "next": []
        }
      },
      "participatingContactsIds": [
        1504,
        8001
      ]
    }
  ]
}