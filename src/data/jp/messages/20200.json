            202000012
          ]
        },
        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "このようなコメントが添えられていました",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「あなたとウロボロスは決して無関係ではないでしょう——大地獣が赤土を貪るように、あなたは真理を渇望し、呑みくだし、奪い取ることも厭わない。その欲求こそ、あなたの本能なのです」",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "「あなたの人生のモットー：決して満足しない！」",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どうして機械頭じゃない{F#の}{M#んだ}？",
          "next": [
            202000018
          ]
        },
        "202000016": {
          "id": 202000016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "奇妙なほどぴったりだ{F#ね}{M#な}",
          "next": [
            202000018
          ]
        },
        "202000017": {
          "id": 202000017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いい意味で貪欲なんだ{F#ね}{M#な}",
          "next": [
            202000018
          ]
        },
        "202000018": {
          "id": 202000018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "興味深いものではありますね。無論、ほんの少しだけですが",
