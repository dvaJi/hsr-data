        "202000001": {
          "id": 202000001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "天外からの情報がオンパロスにもたらされたことで、現在、樹庭の学生たちの間で新たな知識が流行しています",
          "next": [
            202000002
          ]
        },
        "202000002": {
          "id": 202000002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "先ほど、学生からこのようなテストが送られてきました",
          "next": [
            202000003
          ]
        },
        "202000003": {
          "id": 202000003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "添付ファイル「診断・あなたの星神はどれ？」を送信しました",
          "next": [
            202000004
          ]
        },
        "202000004": {
          "id": 202000004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "試してみたことはありますか？",
          "next": [
            202000005,
            202000006,
            202000007
          ]
        },
        "202000005": {
          "id": 202000005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "診断するまでもなく、アキヴィリに決まってる{F#でしょ}{M#だろ}",
          "next": [
            202000008
          ]
        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}はナヌークだ{F#よ}{M#}。{F#あんた}{M#お前}を絶滅大君に任命する",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}はアッハだ{F#ね}{M#な}！ハーメン！",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "ざっと見たところ、運命という概念的な側面から個人をカテゴライズし、自己の認識と行動予測を解明しようという試みのようですね",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド アナイクス がオフラインになりました",
          "next": [
            202000010
          ]
        },
        "202000010": {
          "id": 202000010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド アナイクス がオンラインになりました",
          "next": [
            202000011
          ]
        },
        "202000011": {
          "id": 202000011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "診断によると、私はウロボロスだそうです",
