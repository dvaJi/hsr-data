      ],
      "messages": {
        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "この世にこんな可愛い生き物がいるなんてな",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "肉球は柔らかいし、ご飯みたいないい匂いがする",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "僕のカメラが壊れてるせいで、天使のように可愛いワンちゃんの写真が撮れないのが残念だ",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "賛成！ワンちゃんは世界を救う！",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "犬を飼ってるの{M#か}？なでさせて",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ああ、残念だがこれは依頼人のワンちゃんだ",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ごめん、{F#私}{M#俺}は猫派なんだ{F#よね}{M#}",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "そうなのか",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ある重要人物——身分は明かせないんだが、その人物に今朝、差出人不明の脅迫状が届いたんだ",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "そこには一言——「殺してやる、この畜生」とあった",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "だから僕はためらうことなく、この依頼を引き受けたんだ",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "このワンちゃんの毛1本に指を触れることも許さない",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いや、「畜生」って犬のことじゃないんじゃ？",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ああ、おたくは依頼人のことを言いたいんだろう。もちろんわかってるさ。安心してくれ、依頼人には語り部くんが付いてる。",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "依頼人より、このワンちゃんのほうがボクを必要としてたものでね。",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}のほうが犬を必要としてるように見えるけど{F#ね}{M#な}。",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いっそ犬を飼ったら？そうすれば、1日中よその家の犬を追いかけ回さなくて済む{F#よ}{M#だろ}。",
          "next": [
            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "はあ…ドッグフード代が払えれば、とっくに飼ってるだろうな。",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "依頼人の話によると、仔犬という生き物は別名「金を食う獣」なんだとか…仔犬に苦しみを味わわせるわけにはいかないだろう。",
          "next": [
            202300019
          ]
        },
        "202300019": {
          "id": 202300019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1504,
          "next": [
            202300020
          ]
        },
        "202300020": {
          "id": 202300020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ん？何か変だな",
          "next": [
            202300021
          ]
        },
        "202300021": {
          "id": 202300021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "不死途が入力中…",
          "next": [
            202300022
          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ほらいい子だから、僕の財布を噛むんじゃない。金は入ってないぞ。変なものを食べたらダメだ——ワンワンワンワン！",
          "next": [
            202300023
          ]
        },
        "202300023": {
          "id": 202300023,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ボイスメッセージを変換しました",
          "next": [
            202300024
          ]
        },
        "202300024": {
          "id": 202300024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "まったくどこでそんな汚い言葉を覚えたんだ。ワンワンワン！僕の言うことが聞こえるかい？子犬がそんな言葉を使ったらダメ——ワンワンワンワン！",
          "next": [
            202300025
          ]
        },
        "202300025": {
          "id": 202300025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ボイスメッセージを変換しました",
          "next": [
            202300026
          ]
        },
        "202300026": {
          "id": 202300026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "ワンワンワン——僕の金——ワンワンワン！ワンワンワンワン！",
          "next": [
            202300027
          ]
        },
        "202300027": {
          "id": 202300027,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ボイスメッセージを変換しました",
          "next": [
            202300028
          ]
        },
        "202300028": {
