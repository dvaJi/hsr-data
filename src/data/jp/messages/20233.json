        "202330000": {
          "id": 202330000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "「脚本」を生成するちょっとしたプログラムを用意したんだけど",
          "next": [
            202330001
          ]
        },
        "202330001": {
          "id": 202330001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "遊んでみない？",
          "next": [
            202330002
          ]
        },
        "202330002": {
          "id": 202330002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いいよ、どうすればいい{F#の}{M#んだ}？",
          "next": [
            202330003
          ]
        },
        "202330003": {
          "id": 202330003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "人生シミュレーター「脚本を自作しよう」（エリオブロック版）がチャットに導入されました",
          "next": [
            202330004
          ]
        },
        "202330004": {
          "id": 202330004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "人生リスタートのモードを選択してください",
          "next": [
            202330005,
            202330027
          ]
        },
        "202330005": {
          "id": 202330005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "通常モードで",
          "next": [
            202330006
          ]
        },
        "202330006": {
          "id": 202330006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "【通常モードスタート】バックグラウンド-10、知力-10、体力-10、パワー-10、HP-10",
          "next": [
            202330007
          ]
        },
        "202330007": {
          "id": 202330007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{NICKNAME}の人生脚本『生まれ変わった：ママ、人って野生的な存在なんだ』",
          "next": [
            202330008
          ]
        },
        "202330008": {
          "id": 202330008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "では、人生の第一歩を踏み出してください",
          "next": [
            202330009,
            202330016
          ]
        },
        "202330009": {
          "id": 202330009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}が最初に星穹列車に乗り込む！車掌になるのはこの{F#私}{M#俺}だ{F#よ}{M#}！",
          "next": [
            202330010
          ]
        },
        "202330010": {
          "id": 202330010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "幼年期、{NICKNAME}は星穹列車に乗り込むと下車を拒み、そのまま居座り続けました",
          "next": [
            202330011
          ]
        },
        "202330011": {
          "id": 202330011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "少年期、宇宙の危機に見舞われた{NICKNAME}は列車を巧みに操ってその危機を回避し、幸運にも生き延びることができました",
          "next": [
            202330012
          ]
        },
        "202330012": {
          "id": 202330012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "青年期、{NICKNAME}は星神の罠にハマり、そこから逃れられませんでした",
          "next": [
            202330013
          ]
        },
        "202330013": {
          "id": 202330013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "壮年期になり能力が覚醒、世界を救うことを誓いました",
          "next": [
            202330014
          ]
        },
        "202330014": {
          "id": 202330014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "ナヌーク、討伐",
          "next": [
            202330015
          ]
        },
        "202330015": {
          "id": 202330015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "え、ただの{F#私}{M#俺}TUEEE？",
          "next": [
            202330046
          ]
        },
        "202330016": {
          "id": 202330016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "『第一歩を踏み出す勇気が出ない』",
          "next": [
            202330017
          ]
        },
        "202330017": {
          "id": 202330017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "死亡",
          "next": [
            202330018
          ]
        },
        "202330018": {
          "id": 202330018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "？",
          "next": [
            202330019
          ]
        },
        "202330019": {
          "id": 202330019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "これ、おかしいんじゃない{F#}{M#か}？",
          "next": [
            202330020
          ]
        },
        "202330020": {
          "id": 202330020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "あ、待った。カフカの決めゼリフを入れるの忘れてた",
          "next": [
            202330021
          ]
        },
        "202330021": {
          "id": 202330021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "『選択の機会がある時に、自分が後悔するようなことはしちゃだめよ』",
          "next": [
            202330022
          ]
        },
        "202330022": {
          "id": 202330022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "承知しました。それではあなたのために、走馬灯を再生します——",
          "next": [
            202330023
          ]
        },
        "202330023": {
          "id": 202330023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "幼年期、世界は平和であり、{NICKNAME}はペガーナで穏やかな日々を過ごしました",
          "next": [
            202330024
          ]
        },
        "202330024": {
          "id": 202330024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "少年期、宇宙に危機が訪れ、{NICKNAME}はそのバックグラウンドのおかげか、幸運にも生き延びることができました",
