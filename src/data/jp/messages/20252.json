  "sections": [
    {
      "id": 2025200,
      "startingMessageId": [
        202520000
      ],
      "messages": {
        "202520000": {
          "id": 202520000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "仙舟への道すがら、『コンコン隊VSもふもふ号』のコラボショップをすべて巡ってきたぞ",
          "next": [
            202520001
          ]
        },
        "202520001": {
          "id": 202520001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "缶バッジにアクスタじゃろ、それからフィギュアに日焼け止め、モバイルバッテリーにお掃除ロボットも——すべて！お買い上げじゃ！",
          "next": [
            202520002,
            202520003
          ]
        },
        "202520002": {
          "id": 202520002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "要するに浮気ってこと？はなこんの『もふもふ号』への愛は冷め{F#ちゃっ}{M#}たの{F#}{M#か}？",
          "next": [
            202520005
          ]
        },
        "202520003": {
          "id": 202520003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "『コンコン隊VSもふもふ号』？それって、許可は取ってるの{F#}{M#か}？",
          "next": [
            202520004
          ]
        },
        "202520004": {
          "id": 202520004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "もちろんじゃ！二次元ホース先生が直々に許可したと聞いておる——「もふもふ号の延命は、二次創作者の諸君に託した！」と言ってな！",
          "next": [
            202520005
          ]
        },
        "202520005": {
          "id": 202520005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "『もふもふ号』は休載中じゃし、今くらいは代わりの作品で飢えをしのいでもよかろう！",
          "next": [
            202520006
          ]
        },
        "202520006": {
          "id": 202520006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "じゃが、少々「食べすぎ」てしまったようでな…グッズを買ったはいいものの、置き場が無くなってしまったのじゃ",
          "next": [
            202520007
          ]
        },
        "202520007": {
          "id": 202520007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "妾が途方に暮れておったその時…",
          "next": [
            202520008
          ]
        },
        "202520008": {
          "id": 202520008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "「コンコン隊」隊長のみずこんが、道を示してくれたのじゃ！",
          "next": [
            202520009
          ]
        },
        "202520009": {
          "id": 202520009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "第2巻の中でみずこんは「冷え冷えクレイジー冷蔵庫」を使い——狐たちを冷蔵庫に潜ませ、食物連鎖をたどってもふもふ号への潜入を果たしてみせたのじゃ！",
          "next": [
            202520010
          ]
        },
        "202520010": {
          "id": 202520010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "いやはや奥が深い…冷蔵庫に食べ物以外を忍ばせるとは",
          "next": [
            202520011
          ]
        },
        "202520011": {
          "id": 202520011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "それを見てすぐに、コンコン隊ともふもふ号のコラボ冷蔵庫を10台ずつ注文したぞ",
          "next": [
            202520012
          ]
        },
        "202520012": {
          "id": 202520012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "行き場をなくした漫画やグッズたちに、ひんやりした住まいを用意してやらねばな",
          "next": [
            202520013,
            202520014
          ]
        },
        "202520013": {
          "id": 202520013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "消費主義の罠には気をつけるんだ{F#よ}{M#ぞ}",
          "next": [
            202520015
          ]
        },
        "202520014": {
          "id": 202520014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "そんなにたくさん入れる物があるの{F#}{M#か}？消費主義の罠には気をつけるんだ{F#よ}{M#ぞ}",
          "next": [
            202520017
          ]
        },
        "202520015": {
          "id": 202520015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "なんと冷淡な大人の物言い！ラクーン殿、汝は変わってしまったんじゃな",
          "next": [
            202520016
          ]
        },
        "202520016": {
          "id": 202520016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "これは断じて衝動買いなどではない",
          "next": [
            202520018
          ]
        },
        "202520017": {
          "id": 202520017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "うむ、たくさんあるぞ！無論、衝動買いなどではない",
          "next": [
            202520018
          ]
        },
        "202520018": {
          "id": 202520018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "まず1台目には漫画の初版本じゃろう？それから次の1台には愛蔵版で…",
          "next": [
            202520019
          ]
        },
        "202520019": {
          "id": 202520019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "それから絶対に外せぬグッズたちに1台、コラボ限定品たちに1台…",
          "next": [
            202520020
          ]
        },
        "202520020": {
          "id": 202520020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "デジタルペットの卵用にも1台必要じゃな。次の1台には、そうじゃな…",
          "next": [
            202520021,
            202520022,
            202520023
          ]
        },
        "202520021": {
          "id": 202520021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "もういいから。買いすぎて余らせてるなら{F#私}{M#俺}にも分けて{F#ちょうだい}{M#くれ}",
          "next": [
            202520024
          ]
        },
        "202520022": {
          "id": 202520022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "食べ物を入れるつもりはないってこと{F#}{M#か}？冷蔵庫にも本来の仕事をさせて{F#あげな}{M#やれ}よ！",
          "next": [
            202520025
          ]
        },
        "202520023": {
          "id": 202520023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "隣の名探偵事務所にいるオオカミが、喉から手が出るほど欲しがりそうだ{F#ね}{M#な}",
          "next": [
            202520026
          ]
        },
        "202520024": {
          "id": 202520024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "名案じゃ！実はみずこんの「冷え冷えクレイジー冷蔵庫」も、最終的にはもふもふ号のものになってしまうんじゃ",
          "next": [
            202520027
          ]
        },
        "202520025": {
          "id": 202520025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "名案じゃ！1台には食べ物を入れるとしよう！",
          "next": [
            202520027
          ]
        },
        "202520026": {
          "id": 202520026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "名案じゃ！1台はシナズルフ探偵に贈るとしよう！",
          "next": [
            202520027
          ]
        },
        "202520027": {
          "id": 202520027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "残りはすべて星穹列車に贈る！これで決まりじゃ！",
          "next": [
            202520028
          ]
        },
        "202520028": {
          "id": 202520028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "どうじゃ、すべてに使い道があったじゃろう？",
          "next": [
            202520029
          ]
        },
        "202520029": {
          "id": 202520029,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1505,
          "next": [
            202520030
          ]
        },
        "202520030": {
          "id": 202520030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "送り状も既に書き終えた。ラクーン殿、受け取りを頼むぞ！",
          "next": [
            202520031
          ]
        },
        "202520031": {
          "id": 202520031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "さて、これで大きな問題がひとつ片付いたことじゃし、買い物の続きじゃ！実は最近、もふもふ号とのコラボがたくさんあってのう…",
          "next": []
        }
      },
      "participatingContactsIds": [
        1505,
        8001
      ]
    }
  ]
}