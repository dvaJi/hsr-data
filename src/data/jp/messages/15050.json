      "messages": {
        "150500101": {
          "id": 150500101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "友よ、お金はまだ足りていますか？",
          "next": [
            150500102
          ]
        },
        "150500102": {
          "id": 150500102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "足りないようでしたら、自腹を切っていただくことになります",
          "next": [
            150500103
          ]
        },
        "150500103": {
          "id": 150500103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "まずは1つ目のいい知らせをお伝えしておきましょう",
          "next": [
            150500104
          ]
        },
        "150500104": {
          "id": 150500104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "昨日、「金を持ってはいけないチャレンジ」が終了した後、私たちはコトリを呼び戻し、すべての収支を確認しました",
          "next": [
            150500105
          ]
        },
        "150500105": {
          "id": 150500105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "かなり奇妙な出費がいくつかありましたが…ルール違反には当たらないと判断しております",
          "next": [
            150500106,
            150500108
          ]
        },
        "150500106": {
          "id": 150500106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "それのどこがいい知らせな{F#の}{M#んだ}。ちゃんとルール通りにお金を使った{F#から}{M#ぞ}",
          "next": [
            150500107
          ]
        },
        "150500107": {
          "id": 150500107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "まあ、ルール違反で失格にならないよう、心配しているのですよ",
          "next": [
            150500110
          ]
        },
        "150500108": {
          "id": 150500108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "1つ目のいい知らせってことは…2つ目もあるの{F#}{M#か}？",
          "next": [
            150500109
          ]
        },
        "150500109": {
          "id": 150500109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "すみません。素のリアクションを求めておりますので、いま教えられるのはここまでです",
          "next": [
            150500110
          ]
        },
        "150500110": {
          "id": 150500110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "住所はお送りしましたので、ノーモンタワーに来てください。「金を持ってはいけないチャレンジ」の最後のシーンを撮りましょう",
          "next": [
            150500111,
            150500112
          ]
        },
        "150500111": {
          "id": 150500111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "はいはい、いま向かってるから",
          "next": [
            150500113
          ]
        },
        "150500112": {
          "id": 150500112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "待ってて、まだしばらくかかるから",
          "next": [
            150500113
          ]
        },
        "150500113": {
          "id": 150500113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "そう焦らなくても大丈夫ですよ。ついでに申し上げますと、アベンチュリンさんもこちらに向かっております",
          "next": [
            150500114
          ]
        },
        "150500114": {
          "id": 150500114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 224,
          "text": "おふたりが来てから、一緒にチャレンジの総決算といきましょう",
          "next": []
        }
      },
      "participatingContactsIds": [
        224,
        8001
      ]
    }
  ]
}