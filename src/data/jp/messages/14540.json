          ]
        },
        "145400001": {
          "id": 145400001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "グレーたん、みんなに挨拶しましょうか",
          "next": [
            145400002,
            145400005
          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "キメラバトルは実力が物を言う",
          "next": [
            145400003
          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}たちを倒して、{F#私}{M#俺}がオンパロスで一番のトレーナーだって証明する",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ランク認定戦を終えたばかりで、まだ新人なんだ",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "みんな、お手柔らかに{F#ね}{M#}",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "相棒、久しぶりだね。今度はお互いのキメラで勝負しよう！",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "ふん、惨めな負け方をするなよ、救世主",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "僕の覇道を阻むつもりか？ふん、かかってくるがいい",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "構わない。カイザーの前に立ちはだかるすべての障害は、ワタシが一掃しよう",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "ねえ、グレっち、取引しない？対戦相手のキメラを盗んであげるから、あたしと当たった時は手を抜いてよ",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "それはやめたほうがいいでしょう、セファリア。金糸には誤魔化しが効きませんから",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "イカサマ禁止！「あたちたち」が審判ちて、みんなをちゃんと見張っておくからね！",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "審判であり、選手でもある…これでは公正な審判を望めないのではありませんか？",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "うっ…トリビーが対戦ちて、トリノンが審判で、トリアンが悪者を捕まえるってことで。うん、これでいいよね！",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}。この大会、俺も全力で臨むつもりだ。",
          "next": [
            145400018,
            145400019
          ]
        },
        "145400018": {
          "id": 145400018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ガチの丹恒…想像しただけで恐ろしく強そう{F#}{M#だな}",
          "next": [
            145400020
          ]
        },
        "145400019": {
          "id": 145400019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "よし、{F#私}{M#俺}も全力で戦う{F#よ}{M#ぞ}！",
          "next": [
            145400020
          ]
        },
        "145400020": {
          "id": 145400020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "ふふっ、じゃあ{NICKNAME}の晴れ姿を楽しみにしてるわ",
