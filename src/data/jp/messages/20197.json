        "201970005": {
          "id": 201970005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "俺は、自分の腕を試してみたい",
          "next": [
            201970006
          ]
        },
        "201970006": {
          "id": 201970006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "食べるか？",
          "next": [
            201970007,
            201970008,
            201970010
          ]
        },
        "201970007": {
          "id": 201970007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "もちろん！なんでも食べる{F#よ}{M#ぞ}、シェフ！",
          "next": [
            201970012
          ]
        },
        "201970008": {
          "id": 201970008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "シェフ、送ってくれたやつを全部食べさせてくれるの{F#}{M#か}？",
          "next": [
            201970009
          ]
        },
        "201970009": {
          "id": 201970009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "食べきれるなら構わないぞ",
          "next": [
            201970012
          ]
        },
        "201970010": {
          "id": 201970010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#お願い}{M#頼んだ}、シェフ・モーディス！",
          "next": [
            201970011
          ]
        },
        "201970011": {
          "id": 201970011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "いいだろう",
          "next": [
            201970012
          ]
        },
        "201970012": {
          "id": 201970012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "では、手始めに『クレムノスの深夜食堂』から始めるとしよう",
          "next": [
            201970013
          ]
        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "送ったレシピはひと通り試したことがあるが、やはり一番得意なのはクレムノス料理だ",
          "next": [
            201970014,
            201970015,
            201970016
          ]
        },
        "201970014": {
          "id": 201970014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "生の鹿ハツの和え物とか？",
          "next": [
            201970017
          ]
        },
        "201970015": {
          "id": 201970015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "トカゲの足の炭火焼きとか？",
          "next": [
            201970017
          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "見た目グロいのか{F#な}{M#}？",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "どうも俺たちの文化について深刻な誤解がありそうだな",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "あれはかつてクレムノス人が勇者を試すために用いた慣習に過ぎず、それさえも俺がとっくに廃止した",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "現在のクレムノス料理は、栄養バランスの取れた健康的なものばかりだ",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "他の地域の料理からも良いところを取り入れ、融合させて改良を重ねてきたからな",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "味付けの好みはあるか？",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "濃い味が好き{F#かな}{M#だな}",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "なら、クモヒツジ肉のソース煮込みにするか、塩分補給に最適で食欲を掻き立てる。ザクロジュースを添えるとなお良しだな。",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "一般的な料理がいい{F#な}{M#}",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "酢豆のピューレとザクロハニーケーキの組み合わせなら、いつ食べても間違いない",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ありふれた味には飽きたんだよ{F#ね}{M#な}",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "ならばステュクスの魚の缶詰がいいかもしれん",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "料理に使うことはあまりないものなんだが",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "なんなら、10年以上熟成させた獣肉も手に入るぞ",
          "next": [
            201970030
          ]
        },
        "201970030": {
          "id": 201970030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "生涯忘れられない味になることは請け合おう",
          "next": [
            201970031
          ]
        },
        "201970031": {
          "id": 201970031,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1404,
          "next": [
            201970032
          ]
        },
        "201970032": {
          "id": 201970032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "クレムノスにはこんな言葉がある、「将を目指す兵は、まず優れた料理人でなければならない」",
          "next": [
            201970033
          ]
        },
        "201970033": {
          "id": 201970033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "つまり、俺の調理スキルと、食卓のコーディネートに関する手腕は信用してくれていい",
          "next": [
            201970034
          ]
        },
        "201970034": {
          "id": 201970034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "好きなだけ食べてくれ",
          "next": []
        }
