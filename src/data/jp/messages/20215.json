        "202150010": {
          "id": 202150010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "こういった習慣にすぐに馴染めたのは、「大地」の火種が持つ力と関係があるのかもしれない",
