            202150001
          ]
        },
        "202150001": {
          "id": 202150001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "その他の睡眠姿勢と比べると、草の上で眠るほうがよく眠れるという結果になった",
          "next": [
            202150002
          ]
        },
        "202150002": {
          "id": 202150002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "この方法は大地獣から勧められたものだ",
          "next": [
            202150003
          ]
        },
        "202150003": {
          "id": 202150003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "詳しい方法についてアーカイブに記録しておいた。いつでも好きな時に確認するといい",
          "next": [
            202150004
          ]
        },
        "202150004": {
          "id": 202150004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どこで寝るって？",
          "next": [
            202150005
          ]
        },
        "202150005": {
          "id": 202150005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "草原でも、芝生でも、大地に近いところならどこでもかまわない",
          "next": [
            202150006
          ]
        },
        "202150006": {
          "id": 202150006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "はじめは慣れない感触に戸惑ったが、眠ってしまえば違和感なく、とても安らかな睡眠だった",
          "next": [
            202150007
          ]
        },
        "202150007": {
