            202150012
          ]
        },
        "202150012": {
          "id": 202150012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}たちも一緒にスキルを身につけていけるわけだ{F#ね}{M#な}。たとえば……",
