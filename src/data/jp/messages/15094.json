          ]
        },
        "150940101": {
          "id": 150940101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "「おはようこんにちはこんばんは、それから真夜中もごきげんよう。あんたの友、画の木タケから挨拶を」",
          "next": [
            150940102
          ]
        },
        "150940102": {
          "id": 150940102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "「居候の身はいろいろと苦労が絶えなくてな。コンバージョンは賞品がねえんだ」",
          "next": [
            150940103
          ]
        },
        "150940103": {
          "id": 150940103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "「だが、がっかりしないでくれ。最後の賞品はもう用意してあるから。いま俺を悩ませてるのは、どうやったらこれにかつてと同じ意味をもたせられるかってことだ」",
          "next": [
            150940104
          ]
        },
        "150940104": {
          "id": 150940104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "「しばらく1人で考えさせてくれ。救われた二相楽園で会える日を楽しみにしてるぜ」",
          "next": [
            150940105
          ]
        },
        "150940105": {
          "id": 150940105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 213,
          "text": "——傘男はそう言っていました。",
          "next": [
            150940106
          ]
        },
