  "sections": [
    {
      "id": 2024600,
      "startingMessageId": [
        202460000
      ],
      "messages": {
        "202460000": {
          "id": 202460000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "この頃の千星シティは、特に日差しが強烈だ",
          "next": [
            202460001
          ]
        },
        "202460001": {
          "id": 202460001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "今さっき、絶対役に立つ暑さ対策を思い出したから、君に教えてあげるよ",
          "next": [
            202460002,
            202460003
          ]
        },
        "202460002": {
          "id": 202460002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}がやる暑さ対策って、すごくお金がかかるんじゃないの{F#}{M#か}？",
          "next": [
            202460004
          ]
        },
        "202460003": {
          "id": 202460003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "薄着になるとか？水着なら持ってない{F#よ}{M#ぞ}",
          "next": [
            202460005
          ]
        },
        "202460004": {
          "id": 202460004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "いや、その真逆だ。原点に戻るのさ",
          "next": [
            202460006
          ]
        },
        "202460005": {
          "id": 202460005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "あと水着なら、今度僕とお揃いの特注バカンスウェアをプレゼントしよう。これで解決だろう？",
          "next": [
            202460006
          ]
        },
        "202460006": {
          "id": 202460006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "ツガンニヤには、暑い日にちょうどいい大きさの岩や砂丘の日陰を見つけて、そこで仰向けに寝転がってゆっくり呼吸をするっていう伝統的な過ごし方があるんだ",
          "next": [
            202460007
          ]
        },
        "202460007": {
          "id": 202460007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "それから沸かしたてのお茶を3杯飲む。これは熱々のスパイスティー。その後、身体を砂に埋める",
          "next": [
            202460008
          ]
        },
        "202460008": {
          "id": 202460008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "太陽が蒸発させきれないくらい汗をかけば、すべてを超越した究極の涼しさを感じられるらしい",
          "next": [
            202460009
          ]
        },
        "202460009": {
          "id": 202460009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "残念ながら、子供の時にはちゃんと試す機会がなくてね",
          "next": [
            202460010
          ]
        },
        "202460010": {
          "id": 202460010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "さっき気が向いたから、ビーチであたたかいお茶を飲んで、目を閉じて休んでみた",
          "next": [
            202460011
          ]
        },
        "202460011": {
          "id": 202460011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "そしたら警備員に熱中症じゃないかって何回も確認されたよ。あれがなければ、あと半日は寝そべっていられたんだけどな",
          "next": [
            202460012,
            202460013,
            202460014
          ]
        },
        "202460012": {
          "id": 202460012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "そんなに熱くする必要あるの{F#}{M#か}？その後、キンキンに冷たいソーダを10杯は飲んで身体を冷やさないとダメな気がする{F#}{M#ぞ}",
          "next": [
            202460017
          ]
        },
        "202460013": {
          "id": 202460013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "文字見てるだけで汗がふき出てきた{F#よ}{M#ぞ}。お詫びとして、暑さを和らげてくれるキンキンに冷えたソーダ1杯おごって{F#}{M#くれ}",
          "next": [
            202460017
          ]
        },
        "202460014": {
          "id": 202460014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "子供のころに気になってたことを実行する時が来た！行こう！",
          "next": [
            202460015
          ]
        },
        "202460015": {
          "id": 202460015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}も一緒に砂に埋まる{F#よ}{M#ぞ}！あとで暑さを鎮めるために、最高にキンキンに冷えたソーダを10杯買ってくれれば、それで十分！",
          "next": [
            202460016
          ]
        },
        "202460016": {
          "id": 202460016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "そこまで言われたら、やる気が出てきたよ",
          "next": [
            202460017
          ]
        },
        "202460017": {
          "id": 202460017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "お望みのキンキンに冷えたソーダなら、いくらでもあるから安心して",
          "next": [
            202460018
          ]
        },
        "202460018": {
          "id": 202460018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "ブランド関係者が1200万信用ポイント相当のソーダ券をくれたんだけど、1か月で100万分も飲めないから、1年で使いきれるものじゃない",
          "next": [
            202460019
          ]
        },
        "202460019": {
          "id": 202460019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "君に奢ってほしがってることだし、これから星穹列車の夏の冷たいドリンクは僕がお代を払おう",
          "next": [
            202460020
          ]
        },
        "202460020": {
          "id": 202460020,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1304,
          "next": [
            202460021
          ]
        },
        "202460021": {
          "id": 202460021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "そういえば、千星シティで知る人ぞ知る小さなカフェを見つけたんだ。そこのお茶が故郷で飲んでいたお茶の味にすごく近くてね",
          "next": [
            202460022
          ]
        },
        "202460022": {
          "id": 202460022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "時間がある時に連れて行ってあげるよ。ご馳走させてほしい",
          "next": []
        }
      },
      "participatingContactsIds": [
        1304,
        8001
      ]
    }
  ]
}