      "messages": {
        "150850100": {
          "id": 150850100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "おはよう、こんにちは、こんばんは～。今日も無事に生きてるよ～",
          "next": [
            150850101
          ]
        },
        "150850101": {
          "id": 150850101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "まさか千星シティにも『浮脂紀事』の残されたページがあるなんてね",
          "next": [
            150850102,
            150850106,
            150850109
          ]
        },
        "150850102": {
          "id": 150850102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#うん}{M#ああ}、思ってもなかった{F#ね}{M#}",
          "next": [
            150850103
          ]
        },
        "150850103": {
          "id": 150850103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "また集めるものが増えた{F#ね}{M#な}",
          "next": [
            150850104
          ]
        },
        "150850104": {
          "id": 150850104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "あははは、それもいいことだよ",
          "next": [
            150850105
          ]
        },
        "150850105": {
          "id": 150850105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "在田さんたちのおかげで、わたしたちこっちでもやることができたしね",
          "next": [
            150850114
          ]
        },
        "150850106": {
          "id": 150850106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "二相楽園の古書なんだよ{F#ね}{M#な}？",
          "next": [
            150850107
          ]
        },
        "150850107": {
          "id": 150850107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "どうして千星シティにある{F#の}{M#んだ}？",
          "next": [
            150850108
          ]
        },
        "150850108": {
          "id": 150850108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "あははは、そこは在田さんたちのおかげって言うべきかな",
          "next": [
            150850114
          ]
        },
        "150850109": {
          "id": 150850109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "…{F#あんた}{M#お前}、{F#私}{M#俺}を監視してるの{F#}{M#か}？",
          "next": [
            150850110
          ]
        },
        "150850110": {
          "id": 150850110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "このタイミングでメッセージが来るなんて、出来すぎじゃない{F#}{M#か}？",
          "next": [
            150850111
          ]
        },
        "150850111": {
          "id": 150850111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "ああ、それはわたしが『浮脂紀事』の反応を検知する装置を持ってるからだよ",
          "next": [
            150850112
          ]
        },
        "150850112": {
          "id": 150850112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "それを集めてくれてるのは、あなたしかいないでしょ？",
          "next": [
            150850113
          ]
        },
        "150850113": {
          "id": 150850113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "在田さん本人に直接聞きに行くわけにもいかないし",
          "next": [
            150850114
          ]
        },
        "150850114": {
          "id": 150850114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "在田さん？",
          "next": [
            150850115
          ]
        },
        "150850115": {
          "id": 150850115,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "これとあいつに、なんの関係がある{F#の}{M#んだ}？",
          "next": [
            150850116
          ]
        },
        "150850116": {
          "id": 150850116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "どこかの幹部が、千星シティに幻造種の暮らせる環境を整えたって話、あったでしょ？",
          "next": [
            150850117
          ]
        },
        "150850117": {
          "id": 150850117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "それで、千星シティに縁のあるいろんな幻造種が、次々に姿を現すようになったの",
          "next": [
            150850118
          ]
        },
        "150850118": {
          "id": 150850118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "その中には、わたしたちが気になってる本もあってね",
          "next": [
            150850119
          ]
        },
        "150850119": {
          "id": 150850119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "しかも、在田さんもその本に興味を持ってるらしいの",
          "next": [
            150850120
          ]
        },
        "150850120": {
          "id": 150850120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "とにかく、時間を作って一度会おうよ",
          "next": [
            150850121
          ]
        },
        "150850121": {
          "id": 150850121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "せっかく千星シティまで来たんだし、知り合いにいろいろ会っておくのも悪くないでしょ",
          "next": []
        }
      },
