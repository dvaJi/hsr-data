      ],
      "messages": {
        "202550000": {
          "id": 202550000,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 241,
          "next": [
            202550001
          ]
        },
        "202550001": {
          "id": 202550001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "また来たよ！",
          "next": [
            202550002
          ]
        },
        "202550002": {
          "id": 202550002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "この大昔のアカウントを取り戻すのはなかなか骨が折れたけど、その分収穫もたっぷりだったよ",
          "next": [
            202550003
          ]
        },
        "202550003": {
          "id": 202550003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "へへっ",
          "next": [
            202550004,
            202550005,
            202550006
          ]
        },
        "202550004": {
          "id": 202550004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "いや、なんで星5になってる{F#の}{M#んだ}？",
          "next": [
            202550007
          ]
        },
        "202550005": {
          "id": 202550005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "団結した借金取りたちは振り切ったの{F#}{M#か}？",
          "next": [
            202550009
          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "へへっ…それで、どんな収穫があった{F#の}{M#んだ}？このアカウントに紐づいた資産で借金が返せそうとか？",
          "next": [
            202550011
          ]
        },
        "202550007": {
          "id": 202550007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "多いことはいいことでしょ！星5ってことは高評価だし！",
          "next": [
            202550008
          ]
        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "まあ、借金取りたちに定期的に付けられる星ゼロ評価も、いくらか相殺しておかないと{F#ね}{M#な}",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "それはまだだけど、彼らの期待に応えられるように頑張るよ",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "あれって期待だったの{F#}{M#か}？",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "うう、ちょっと手厳しくない？代理人{F#ちゃん}{M#くん}",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "まあまあ、とにかくこのメモ帳を見てよ、お宝の山だよ山！過去10年分の成果に匹敵するくらい",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "運命の行人が自分の星神をぶった斬る場面の録音とか、なんの気なしに保存したゴシップ動画とか…ここでしか手に入らないネタばっかり",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "当事のあたしってば、なんでこのアカウントを手放しちゃったんだろ…",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "話ばっかりじゃなくて、現物を転送して{F#}{M#くれ}よ！",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "また自分を主役にトンデモ野史物語を描くつもり{F#}{M#か}？",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ホース先生…お腹空いた{F#よ}{M#}、早く新作を{F#ちょうだい}{M#くれ}…",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "焦らない焦らな～い。とりあえず1つ見せてあげるから",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "そんなにトンデモじゃないってば",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "じゃなくて、あたしだけじゃ話のスケールが小さくなっちゃうでしょ！トンデモ野史はやっぱり他人のじゃないと。たとえば…",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "これだけネタがあれば、新作なんていくらでも描けちゃうよ。『薬にまとわりつく風』に使えるネタもありそう…",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "とりあえず、適当に1つ見せてあげるよ",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "数百琥珀紀前、ある虚構歴史学者が最期にこう書き残した——",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「タイズルスはその身を蠢かせ、一日に千里を進んだ。ただ、名もなき星を目指して…」",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「同じ頃、エナとシペもまた、星の近くにひっそりと身を隠していた…」",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「そしてその場所で、思いがけずウロボロスと鉢合わせする。逃げ場のない対峙、一触即発の空気、火花を散らす神々の目的はそう——」",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「アッハただ1人」",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "アッハの自己愛が強すぎる！",
          "next": [
            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "結局{F#あんた}{M#お前}が主役のトンデモ野史だったじゃ{F#ん}{M#ないか}！他のパターンはなかったの{F#}{M#か}！",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "このパターン、ちょっと飽きてきた{F#よ}{M#な}。もっと目新しいやつはないの{F#}{M#か}？",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "待って待って、まだ続きがあるんだってば…その歴史学者が生涯知ることのなかった真相ってやつがね。「神々が、その名もなき星を喉から手が出るほど欲しがった理由はなんと…」",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「アッハが昔、習作として書いた脚本や漫画、同人誌、それらすべてがそこに隠されてたからだった」",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "「ある神は望んだ、そこに巣食うことを。ある神は望んだ、それらを独占することを。そしてある神と神は——」",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "ふふっ、この続きも昔描いたことあるよ",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "メモ帳には完成済みの話もいくつかあるから、すぐに送ってあげるよ",
          "next": [
            202550036
          ]
        },
        "202550036": {
          "id": 202550036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "出し惜しみはこの辺でおしまい。もったいぶってる間に通信料が払えなくなっても困るし",
          "next": [
            202550037
          ]
        },
        "202550037": {
          "id": 202550037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "星神★アッハが入力中…",
          "next": [
            202550038
          ]
        },
        "202550038": {
          "id": 202550038,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "このユーザーは発言を制限されています",
          "next": [
            202550039,
            202550040
          ]
        },
        "202550039": {
          "id": 202550039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "何かヤバいことを言おうとしたの{F#}{M#か}？それとも本当に通信料が足りなくなったとか？？",
          "next": [
            202550041
          ]
        },
        "202550040": {
          "id": 202550040,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "何かヤバいことを言おうとしたの{F#}{M#か}？それとも本当に通信料が足りなくなったとか？？",
          "next": [
            202550041
          ]
        },
        "202550041": {
          "id": 202550041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "メッセージの送信に失敗しました",
          "next": [
            202550042
          ]
        },
        "202550042": {
          "id": 202550042,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "このユーザーのアカウントに異常が検出されました。詐欺行為が確認されたため、利用を停止しました",
          "next": []
        }
      },
