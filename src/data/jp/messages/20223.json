            202230031
          ]
        },
        "202230026": {
          "id": 202230026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "人脈なんてないから、自分で金花、木花、水花、土花でも呼んだらいいんじゃない{F#}{M#か}",
