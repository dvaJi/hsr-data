          ]
        },
        "202350012": {
          "id": 202350012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "太ももを痺れさせ{F#ちゃってごめん}{M#てごめん}。でも全部、銀狼のせいなんだ",
          "next": [
            202350013
          ]
        },
        "202350013": {
          "id": 202350013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "知っている。彼女はカフカとホタルにもこれを入れた。",
          "next": [
