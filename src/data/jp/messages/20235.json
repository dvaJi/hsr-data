        },
        "202350016": {
          "id": 202350016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "用が{F#なきゃ}{M#ないと}連絡しちゃダメ{F#なの}{M#か}？もしかして…秘密の任務中？",
          "next": [
            202350017
