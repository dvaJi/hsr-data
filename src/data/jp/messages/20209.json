        "202090020": {
          "id": 202090020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "こんな奇妙なレシピを思いつくなんて、姫子と話が合いそうだ{F#ね}{M#な}",
          "next": [
            202090021
