            202090005
          ]
        },
        "202090005": {
          "id": 202090005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "これまでの経験を活かして、人間の味覚にも合うよう、少し薄めにしてみた",
          "next": [
            202090006
          ]
        },
        "202090006": {
          "id": 202090006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ボイスメッセージを変換しました",
