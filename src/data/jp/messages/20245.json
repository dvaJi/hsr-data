      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "小鳥の今日のランチは、コーン、キヌア、えんどう豆のペースト。（水分補給も忘れずに！）",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "野菜ばっかりで肉が全然ない！なんで？",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "喉をケアするために食事にこだわってるんだ{F#ね}{M#な}。さすがスーパースター！",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ごめんなさい！メモ用に自分に送ったつもりだったのだけど、間違えてしまったみたい",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "前に、翼の折れた小さな雛鳥を拾った話をしたこと、覚えているかしら？",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "さっきのは私のではなくて、その小鳥用のレシピよ",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "その雛も今はもうすっかり元気になって、翼にも新しい羽が生えてきているの",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "もうすぐ家に着くから、今の様子を見せてあげるわね。少し待っててちょうだい",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ロビンが小鳥を飼ってるって、ほっこりする話だ{F#ね}{M#な}",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ロビンの小鳥はきっと、ふわふわでまん丸になってるんだろう{F#ね}{M#な}！",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド ロビン がオフラインになりました",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド ロビン がオンラインになりました",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ロビンが入力中…",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "家に着いたのだけど、小鳥がいないの",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "窓が開いていたから、きっとそこから飛んでいってしまったのね",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "そっか…もしかしたら自由に飛びたかっただけかもしれない{F#よ}{M#ぞ}。だから、あまり落ち込まなくてもいいんじゃないか{F#な}{M#}？",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "心配してくれてありがとう。そうね、私もそう思うわ",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "私も、あの子が空へ飛び立つ日をずっと楽しみにしていたもの",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ちょっと急だったけど…ロビンも、小鳥がまた空へ飛び立つのを楽しみにしてたん{F#でしょ}{M#だろ}？",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ええ、そうよ。お見通しね",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小鳥は新しい鳥生で新しい冒険を始めたんだ{F#よ}{M#}！{F#あんた}{M#お前}のことを忘れたりなんか、きっとしない{F#}{M#ぞ}",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ええ！私ずっと、あの子がもう一度、空へ飛び立つ日が来るのを楽しみにしていたの",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "いつも窓辺に飛んできては外の世界を眺めているだけだったけれど、ついに準備ができたのね",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "空高く羽ばたいていく姿を見られなかったのは、少し残念だけど",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "チュンチュン！チーッ、ツピッ！チュンチュンチュン！",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "ボイスメッセージを変換しました（自由な高音を検出しました）",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "ふふ、今のは私のそばにいる3羽のバンドメンバーよ",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "この子たちも、小鳥が飛んでいくところはきっとキレイだっただろう、って言っているわ",
          "next": [
            202450029
          ]
        },
        "202450029": {
          "id": 202450029,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
