      ],
      "messages": {
        "202290000": {
          "id": 202290000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "<u>真実は常に1つ、こっちじゃないならそっちで決まり——この『効率の悪い推理とオサラバできる21問』を、僕はたったの0.99秒でマスターした。二相楽園の99.99%の人間を超えたんだ。おたくも試してみるといい</u>",
          "next": [
            202290001,
            202290003
          ]
        },
        "202290001": {
          "id": 202290001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "本の宣伝をするには、量子速読もできなきゃいけないの{F#}{M#か}？",
          "next": [
            202290002
          ]
        },
        "202290002": {
          "id": 202290002,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "かかってこい、{F#私}{M#俺}の方が速い",
          "next": [
            202290005
          ]
        },
        "202290003": {
          "id": 202290003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "本の宣伝をしてって依頼でも受けた{F#の}{M#のか}？",
          "next": [
            202290004
          ]
        },
        "202290004": {
          "id": 202290004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "かかって来い、勝っちゃうから",
          "next": [
            202290005
          ]
        },
        "202290005": {
          "id": 202290005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "肩慣らし問題、第1問",
          "next": [
            202290006
          ]
        },
        "202290006": {
          "id": 202290006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "「ある夜、被害者がキッチンで食べ物を探していたところ、『パタッ』という音がして、被害者は亡くなった」——この事件の全貌を説明せよ",
          "next": [
            202290007,
            202290012,
            202290017
          ]
        },
        "202290007": {
          "id": 202290007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "「被害者」は空腹のあまり他人の家のキッチンに忍び込み、ご飯を食べようとした。しかし、物音に気付いた住人と鉢合わせてしまい、あっけなく撃退された",
          "next": [
            202290008
          ]
        },
        "202290008": {
          "id": 202290008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "うん、部屋への侵入という点は良かった。ただ「パタッ」という重要な手がかりを見落としてるようだな",
          "next": [
            202290009
          ]
        },
        "202290009": {
          "id": 202290009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "なぜ、「あっ」ではなく、「パタッ」という音なんだろうか？",
          "next": [
            202290010
          ]
        },
        "202290010": {
          "id": 202290010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "では答えを——",
          "next": [
            202290011
          ]
        },
        "202290011": {
          "id": 202290011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "被害者は1匹のゴキブリだ",
          "next": [
            202290021
          ]
        },
        "202290012": {
          "id": 202290012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "家の住人は空腹のあまり、腐った食べ物を食べてしまい、死んでしまった。そして「パタッ」と倒れた",
          "next": [
            202290013
          ]
        },
        "202290013": {
          "id": 202290013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "一見、他殺だが実は事故…発想の転換は悪くない。でも残念、不正解だ",
          "next": [
            202290014
          ]
        },
        "202290014": {
          "id": 202290014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "人間はいつだってお腹が減るし、食べようと思えばいつでも食べられるだろう。ここで肝心なのは、なぜあえて「夜」と言ったのか、だ",
          "next": [
            202290015
          ]
        },
        "202290015": {
          "id": 202290015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "では答えを——",
          "next": [
            202290016
          ]
        },
        "202290016": {
          "id": 202290016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "被害者は1匹のゴキブリだ",
          "next": [
            202290021
          ]
        },
        "202290017": {
          "id": 202290017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "夜…台所…ご飯…『パタッ』という音……",
          "next": [
            202290018
          ]
        },
        "202290018": {
          "id": 202290018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "被害者はゴキブリ",
          "next": [
            202290019
          ]
        },
        "202290019": {
          "id": 202290019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "なんちゃって",
          "next": [
            202290020
          ]
        },
        "202290020": {
          "id": 202290020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "名探偵だな！",
          "next": [
            202290021
          ]
        },
        "202290021": {
          "id": 202290021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "僕がこれまで解決した事件も、筋は通ってるが、全貌はだいたいこんな風に予想外なものばかりだ",
          "next": [
            202290022
          ]
        },
        "202290022": {
          "id": 202290022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "だから…推理の参考書（教科書レベル）、本当に欲しくないか？",
          "next": [
            202290023
          ]
        },
        "202290023": {
          "id": 202290023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "感覚を掴むためにもう1問いこう。「被害者は散歩中、緑色の長いものに遭遇し、不慮の死を遂げた」。さあ、真相を推理してみてくれ——",
          "next": [
            202290024
          ]
        },
        "202290024": {
          "id": 202290024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "あっ…ちょっと待った",
          "next": [
            202290025
          ]
        },
        "202290025": {
          "id": 202290025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "『難問なぞなぞクイズ』と間違えた",
          "next": [
            202290026
          ]
        },
        "202290026": {
          "id": 202290026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "まあ、ある意味それも推理の本だ{F#ね}{M#な}、本当に学べるものがあるかは別として",
          "next": [
            202290027
          ]
        },
        "202290027": {
          "id": 202290027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "心配ない",
          "next": [
            202290028
          ]
        },
        "202290028": {
          "id": 202290028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "この本も、依頼リストに入ってる",
          "next": [
            202290029
          ]
        },
        "202290029": {
          "id": 202290029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "<u>9歳から999歳までわかる——この『難問なぞなぞ』、僕はたったの0.99秒でマスターした。二相楽園の99.99%の人間を超えたんだ。おたくも試してみるといい</u>",
          "next": [
            202290030
          ]
        },
