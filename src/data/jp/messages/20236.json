        "202360001": {
          "id": 202360001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "いくつかの既知の問題を修正し、振動軽減機能を追加しました",
          "next": [
            202360002,
            202360003
          ]
        },
        "202360002": {
          "id": 202360002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "アプデが早い{F#ね}{M#な}。{F#私}{M#俺}がやってるゲームよりも早い",
          "next": [
            202360004
          ]
        },
        "202360003": {
          "id": 202360003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どれくらい振動が軽減されるのか、試してみよう",
          "next": [
            202360004
          ]
        },
        "202360004": {
          "id": 202360004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "メッセージを送信しました。刃のスマホが反応し、1回振動しました",
          "next": [
            202360005
          ]
        },
        "202360005": {
          "id": 202360005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃のスマホが反応し、1回振動しました",
          "next": [
            202360006
          ]
        },
        "202360006": {
          "id": 202360006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド 刃 がオンラインになりました",
          "next": [
            202360007
          ]
        },
        "202360007": {
          "id": 202360007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "静かにしろ。",
          "next": [
            202360008
          ]
        },
        "202360008": {
          "id": 202360008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "いま監視モニターを見ているところなんだが、今度はなんの用だ？",
          "next": [
            202360009,
            202360010,
            202360011
          ]
        },
        "202360009": {
          "id": 202360009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "監視モニターで、ハラハラドキドキの索敵パート{F#ってやつ}{M#ってやつか}？",
          "next": [
            202360013
          ]
        },
        "202360010": {
          "id": 202360010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "また任務？監視モニターで、ハラハラドキドキの索敵パート{F#ってやつ}{M#ってやつか}？",
          "next": [
            202360013
          ]
        },
        "202360011": {
          "id": 202360011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "安心して、ボイスメッセージは送らないから",
          "next": [
            202360012
          ]
        },
        "202360012": {
          "id": 202360012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "なんの監視モニターを見てる{F#の}{M#んだ}？監視モニターで、ハラハラドキドキの索敵パート{F#ってやつ}{M#ってやつか}？",
          "next": [
            202360013
          ]
        },
        "202360013": {
          "id": 202360013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "違う。",
          "next": [
            202360014
          ]
        },
        "202360014": {
          "id": 202360014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360015
          ]
        },
        "202360015": {
          "id": 202360015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360016
          ]
        },
        "202360016": {
          "id": 202360016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "にゃんこケーキの監視モニターを見ている。",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "胡麻パイを覗き見してるの{F#}{M#か}？",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "ああ。",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どれくらい、にゃんこケーキを覗き見して{F#るの}{M#るんだ}？",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "時間は確認していない。",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "にゃんこケーキを？早く言って{F#}{M#くれ}よ！",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "今度、直接中で見せてあげる{F#よ}{M#}",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "ああ、いつかな。",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "監視モニターには何が映ってた？胡麻パイはどんな感じ？",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "あいつに新しい友人が2匹できた。",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "1匹は落ち着きのない白いやつ。負けず嫌いで、よく喋る。",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "もう1匹は赤いやつだ。口数は少ないが、なかなか気難しいところがある。",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "悪くない。胡麻パイはいつもひとりぼっちだったからな。",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "名前はつけてあげた{F#}{M#か}？",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "俺がつけるのか？",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "ならば、雪花パイと、なつめケーキにしよう。",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "その子たち、少し{F#あんた}{M#お前}に似てる{F#ね}{M#な}。気が強いところとか",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "新しい友達に名前はあるの{F#}{M#か}？",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "さあな。せっかくだ、名を考えるとしよう。",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "「なつめケーキ」と「雪花パイ」、これがよさそうだ。",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360038
          ]
        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "喧嘩が始まった。",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "少し仲が悪いようだ。",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "毛繕いし合っているな。",
          "next": [
            202360042
          ]
        },
        "202360042": {
          "id": 202360042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "誤解だったか。仲がいいようだ。",
          "next": [
            202360043
          ]
        },
        "202360043": {
          "id": 202360043,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "刃が入力中…",
          "next": [
            202360044
          ]
        },
        "202360044": {
          "id": 202360044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "いなくなった。",
          "next": [
            202360045
          ]
        },
        "202360045": {
          "id": 202360045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "見られているのに気づき、隠れてしまったようだ。",
          "next": [
            202360046
          ]
        },
        "202360046": {
          "id": 202360046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "別の監視モニターを調べてくる。",
          "next": [
            202360047
          ]
        },
        "202360047": {
          "id": 202360047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "急ぎの用がないなら、失礼する。",
          "next": [
            202360048
          ]
        },
        "202360048": {
          "id": 202360048,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "フレンド 刃 がオフラインになりました",
