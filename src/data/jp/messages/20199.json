            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "あっ、やっぱり怖い感じになっていますよね？",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "実は、書きながら気づいてはいたんです…この題材には、ホラー小説のほうが相応しいかもしれない、と",
