  "sections": [
    {
      "id": 2022000,
      "startingMessageId": [
        202200000
      ],
      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "星核さん、ピノコニーにはまだまだ見つかっていない記憶がたくさんあることをご存知でしょうか",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "記憶を取り戻したばかりのあなたを含め、人々はそれを見たことがありません",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "親しい人々の知られざる秘密、気になりませんか",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "永火の一夜に、鞘で炎の花を咲かせた女性のこと",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "もしくは…あなたを気にかけている星核ハンターたちのことを",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "もちろん私も含めて。もっとも、私は喜んであなたにこの心のうちを明かして差し上げますわ",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "燃やしてしまう前に、あなたといくつかの記憶を分かち合いましょう",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "黄泉自身も知らないような秘密なら、聞いてみたいかも",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "あの夜、最後の火花が消えた時",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "私は見ました",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "彼女は1枚の図面を持っていったのです。ただ残念ながら、あれは地図ではなく",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "お料理のメニューでした",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "ですが、彼女はいまだに気づいていないかもしれません",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "もしかしたら{F#お腹が空いた}{M#腹が減った}だけかも。黄泉が料理できるって知らない{F#でしょ}{M#だろ}？",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "ふふっ、どうでしょうね？",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "もしかしたら…私は食べたことがあるかもしれませんわよ",
          "next": [
            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "昔、本当に星核ハンターに紛れ込んでた{F#の}{M#のか}？怪しい{F#んだけど}{M#な}",
          "next": [
            202200017
          ]
        },
        "202200017": {
          "id": 202200017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "あいつらの秘密を教えて{F#よ}{M#くれるか}？",
          "next": [
            202200018
          ]
        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "星核ハンター、運命の奴隷…ふふっ、どれもあなたたちの絆を説明するには不十分ですわ",
          "next": [
            202200019
          ]
        },
        "202200019": {
          "id": 202200019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "どうして「脚本」に関するグループチャットが42個も必要なのかしら？気になります",
          "next": [
            202200020
          ]
        },
        "202200020": {
          "id": 202200020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "算数が苦手なんだ{F#ね}{M#な}。56個{F#でしょ}{M#だろ}？",
          "next": [
            202200021
          ]
        },
        "202200021": {
          "id": 202200021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "では、私はその中のどのグループにいると思いますか？",
          "next": [
            202200028
          ]
        },
        "202200022": {
          "id": 202200022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}の秘密を知りたい",
          "next": [
            202200023
          ]
        },
        "202200023": {
          "id": 202200023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "私はかつて「スターレイク甘酢煮魚教」と共に半琥珀紀を過ごしたことがありますわ",
          "next": [
            202200024
          ]
        },
        "202200024": {
          "id": 202200024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "そのスローガンは「下は天国、上はスターレイク、一口食べれば酢と一生おさらば」でした",
          "next": [
            202200025
          ]
        },
        "202200025": {
          "id": 202200025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "ただ残念ながら、もう誰も覚えていません。記憶というのは試されるとすぐ崩れてしまう脆いものなんです",
          "next": [
            202200026
          ]
        },
        "202200026": {
          "id": 202200026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "でも、これでみんな知っ{F#ちゃったね}{M#たな}。そのスローガン、次に会ったら直接聞かせて{F#よ}{M#くれるか}？",
          "next": [
            202200027
          ]
        },
        "202200027": {
          "id": 202200027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "それにはまた別の対価が必要ですわ",
          "next": [
            202200028
          ]
        },
        "202200028": {
          "id": 202200028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "なんかしょうもない秘密を知ってしまった！",
          "next": [
            202200029
          ]
        },
        "202200029": {
          "id": 202200029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "お礼に{F#私}{M#俺}もある人の秘密を教えて{F#あげよう}{M#やろう}！",
          "next": [
            202200030
          ]
        },
        "202200030": {
          "id": 202200030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "実は……",
          "next": [
            202200031
          ]
        },
        "202200031": {
          "id": 202200031,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "実はミハイルって、役者をやってたことがあるんだって{F#}{M#さ}",
          "next": [
            202200032
          ]
        },
        "202200032": {
          "id": 202200032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "本当に信じてしまいますわよ？",
          "next": [
            202200033
          ]
        },
        "202200033": {
          "id": 202200033,
          "type": "Sticker",
