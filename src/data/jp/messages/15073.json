      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@姫子 @丹恒 @ヴェルト みんな大丈夫？",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "このメッセージを見たら返事して、おねがい！",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "通知：電波が弱いため、接続状況をご確認ください。",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@三月なのか @{NICKNAME} @サンデー 心配してくれてありがとう、こっちはみんな無事よ",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "俺たちは無事だ。@丹恒 無事を報告して、なのかを安心させよう。",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "俺たちのことなら心配はいらない。ちょうど地下から現れた触手モンスターの群れを撃退したところだ。",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "よかった",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "そういえば、ウチらってどうしても千星シティに行かなきゃダメ？深い意味はないんだけど、ただ…カンパニーのことがちょっと信用できないっていうか…",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "仙舟とか、ヘルタの宇宙ステーションに助けを求めるのもありなんじゃない？",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "それについては、私も考えていなかったわけじゃないわ",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "仙舟も宇宙ステーション「ヘルタ」も、距離からして遠すぎる。今は急を要する事態だし、やっぱり千星シティが最善よ",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "距離よりも厄介なのが、二相楽園はカンパニー貿易体制の一部だということだ。",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "星間貿易協定によれば、カンパニーはそれに対する優先的な処置権を持っている。外部の勢力がむやみに介入すれば、さらに複雑な法的、外交的トラブルを引き起こしてしまうかもしれない。",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "それはさすがに…お手上げだね…",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME} ナビゲーターの役目、しっかり果たしてね",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "安心し{F#て}{M#ろ}、{F#私}{M#俺}がしっかり責任を持つから！",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "わかってる、信じてるわ",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "こういう時…何をすればいいかわからない{F#の}{M#んだ}…",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "心配しないで、あんたのことは信じてるわ。代理ナビゲーターとして、あんたは自分の考えがあるはずよ",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "一刻を争う事態だから、あんたの判断をすべて支持するわ",
          "next": [
            150730120
          ]
        },
        "150730120": {
          "id": 150730120,
