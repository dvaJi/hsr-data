  "sections": [
    {
      "id": 2021100,
      "startingMessageId": [
        202110000
      ],
      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "主人卿よ、僕は今初めての「極限の旅」へ向かうために計画を立てているところなのだが",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "お前たちは星々を渡り歩いてきた実績がある。僕に対しても包括的なアドバイスができるのではないか？",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}一人で行くの{F#}{M#か}？目的地は？",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "共に行きたいという者がいれば、無論反対はしないとも",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "どこまで行きたい{F#の}{M#んだ}？",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "星穹列車に乗って行ってもいい{F#よ}{M#ぞ}",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "旅の中で立ち寄ることがあるかもしれないが、それについてはまた今度にしよう",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "旅の行き先は、未来のオンパロスさ",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "かつて僕が歩んだのは征服の道だった。記憶の中にある諸国はどれも、戦火に包まれているか、暗黒の潮に沈んでいるかのどちらかだ",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "記憶の種が芽吹いて、オンパロスも生気を取り戻していくことだろう。ゆっくりと旅をするにはちょうどいい機会だ",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "帆船でスキアナの海域を渡ってみたい。あの一帯はいつも黒雲と大波が争っているのだ",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "ラードーンの名に聞き覚えは？あそこには雲に届かんばかりに高い場所があるのでね",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "ウィングスーツとスカイダイビング、どちらにするか悩んでいるんだ",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "主人卿よ、お前の意見は？",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}としてはどっちでも大丈夫だと思う。これまでも跳んだり転がったりして、空から飛びこむことは多かったから{F#ね}{M#な}",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "なかなか興味深い話だ",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "話すと長いんだ{F#けど}{M#が}…{F#私}{M#俺}はこれまでも跳んだり転がったりして、空から世界に降り立ってきたんだ",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}もやってみる{F#}{M#か}？",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "なかなか興味深い話だ",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "命を大切にし{F#なよ}{M#てくれ}！",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "そう心配しなくていい、このカイザーはそこまで軟弱ではないさ",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "つい先日、かの子猫から野外サバイバルの特訓を受け、金織卿からもロープ編みの特訓を受けたところだしな",
          "next": [
            202110022
          ]
        },
        "202110022": {
          "id": 202110022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "おっと、そろそろ剣旗卿の水泳特訓の時間だ",
          "next": [
            202110023
          ]
        },
        "202110023": {
          "id": 202110023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "また話そう、主人卿",
          "next": []
        }
      },
