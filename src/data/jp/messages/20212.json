        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "今朝、寝癖がヒドかったからとりあえず自撮りを1枚撮っておいたこと",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "最近太ったかな？と気になってひとまず1枚撮っておいたこと",
