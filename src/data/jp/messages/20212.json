        "202120003": {
          "id": 202120003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "新しい服が届いたし、スカウトも訪ねてきたし、それに{F#あんた}{M#お前}のお気に入りのジュースがロビンとコラボもしたし——",
