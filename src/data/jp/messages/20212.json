        },
        "202120011": {
          "id": 202120011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#私}{M#俺}にはやましいことなんてなにもない、脅しには屈しない{F#よ}{M#ぞ}",
          "next": [
            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "恋に破れた大地獣を追いかけて、油断した一瞬を写真に収め「智者は恋に落ちない」と投稿したこと",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "道端の司祭に占いをしてもらって、その目の前で撮った写真に「運命は神ではなく自分で決めるもの」と投稿したこと",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "散歩に出た先で出くわした吟遊詩人と、その場でラップバトルをはじめ、しっかり記念写真まで撮ったこと",
          "next": [
            202120015
