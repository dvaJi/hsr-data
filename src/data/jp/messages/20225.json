        },
        "202250011": {
          "id": 202250011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "九宮格の火鍋、紫色のナス、黄色い梨、それに赤いトマト。こういったものをたくさん食べると運気が上がるの",
          "next": [
            202250012
