          ]
        },
        "202250006": {
          "id": 202250006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "もう少し大胆に考えてみて、運を呼び込むということは、他のゲームにも応用できるってことよ",
          "next": [
            202250010
          ]
        },
        "202250007": {
          "id": 202250007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "でも{F#私}{M#俺}、そもそも美玉牌が苦手{F#なの}{M#なんだ}",
