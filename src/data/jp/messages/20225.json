        "202250005": {
          "id": 202250005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "すぐに教えて{F#}{M#くれ}、{F#私}{M#俺}も勝ちたい！",
