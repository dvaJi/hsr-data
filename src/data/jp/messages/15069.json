      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "よう、主人公",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "予約しておいたこのメッセージがアンタに届いてるってことは、どうやらオレの計画はまたまた、例によって予想外に見舞われたらしいな",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "もちろん、もうアンタは星核に吹っ飛ばされたあとで、今このメッセージを読んでるのが未来のオレ自身だって可能性もあるわけだが",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "ま、そんなことになってたら、アンタのスマホも無事じゃ済まないか",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "帰寂？なんでまた{F#あんた}{M#お前}から連絡がくる{F#の}{M#んだ}？",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}の計画は失敗した！{F#私}{M#俺}たちは{F#あんた}{M#お前}を倒したんだから！",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "このアカウントは現在使われておりません、メッセージの送信に失敗しました",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "本音を言わせてもらえば、オレとしてはこの展開にもそれほど抵抗はないんだ",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "むしろ、アンタらの勝利に期待してるくらいさ",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "そうなってくれれば、オレが間違ってたって証明になるかもしれないしな",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "なんにしろ、すべての前提はアンタらがこのゲームに勝つこと",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "どっちが勝ったところで其の目覚めは止まらず、オレらはひと口で飲み込まれるんだからな",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "これも届かないんだろうけど、でも…なんでこんなことを？",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "{F#あんた}{M#お前}なら、きっと{F#私}{M#俺}が何を聞きたいかもわかってるんだろう{F#ね}{M#な}",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "このアカウントは現在使われておりません、メッセージの送信に失敗しました",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "ああ…どうしてこんなことをしたか、それが気になってるんだろう？",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "アッハが舞台の裏に隠れたまま、世界が腐り落ちていくのを見過ごすつもりなら、代わりにオレがこの宇宙に挑戦しよう",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "そして、今度の新しい挑戦の名は——蘇った「貪慾」を倒せ、だ",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "壊滅の中から生まれた1人の英雄が、幾多の挑戦を乗り越え、この世界に真の愉悦を取り戻すのか",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "それとも、獣が復讐を成し遂げ、愉悦が狂気に沈む前に尊厳ある滅亡を与えてやるのか",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "なあ主人公…アンタなら、このジョークにもっといい結末を書けるのか？",
          "next": []
        }
      },
