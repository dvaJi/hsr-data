      "messages": {
        "145410101": {
          "id": 145410101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "どうやら、すべての環境を開放したようですね",
          "next": [
            145410102
          ]
        },
        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "観測してみて、どう思いましたか？",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "創造物たちのすることは予測不能で、面白かった{F#よ}{M#}",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "そういった姿こそ、自然が選び取るものの魅力ですね",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "変化し続ける環境の中にあっては、「生命の最適解」など存在しません",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "小動物が走り回ってるなって、それだけだ{F#よ}{M#な}。珍しいものじゃない{F#でしょ}{M#だろ}",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "なるほど",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "少なくとも、あなたは生命が未知の環境で探索と選択を行う姿を見届けました",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "たどり着いた場所には、結局意味はなかったかもしれません。彼らは、そのことに満足していないでしょうが",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "ともあれ、よくできました",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "いくらかの報酬を用意しました。いつでも構いませんから、受け取りに行ってください",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "労働には相応の対価があって然るべきだよ{F#ね}{M#な}、正当な報酬だ",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ありがとう、1つ残らず貰っていく{F#ね}{M#}",
          "next": [
            145410114
          ]
        },
        "145410114": {
          "id": 145410114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "はい、ステーションの実験費用で用意したものですから",
          "next": [
            145410115
          ]
        },
        "145410115": {
          "id": 145410115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "どうぞご自由に",
          "next": [
            145410116
          ]
        },
