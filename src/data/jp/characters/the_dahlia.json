      ],
      "extra": [
        {
          "id": 10000006,
          "name": "弱点撃破状態",
          "desc": "敵の靭性が0まで削られた時に入る特殊状態。この状態になった敵は行動順が遅延する。",
          "params": [],
          "type": 2,
          "icon": "SpriteOutput/BuffIcon/Inlevel/IconBuffCommon.png"
        },
        {
          "id": 10000015,
          "name": "超撃破ダメージ",
          "desc": "撃破特効、この回の攻撃の削靭値、またはキャラクターのレベルが高いほど、与える超撃破ダメージがアップする。\n超撃破ダメージは会心が発生せず、ダメージアップ系効果の影響を受けない。\n超撃破ダメージは一種の弱点撃破ダメージ。",
          "params": [],
          "type": 2,
          "icon": "SpriteOutput/BuffIcon/Inlevel/IconBuffCommon.png"
