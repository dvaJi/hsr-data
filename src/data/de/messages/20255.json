      "messages": {
        "202550000": {
          "id": 202550000,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 241,
          "next": [
            202550001
          ]
        },
        "202550001": {
          "id": 202550001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich bin wieder da!",
          "next": [
            202550002
          ]
        },
        "202550002": {
          "id": 202550002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Es hat etwas Mühe gekostet, dieses alte Konto wiederzubekommen, aber es hat sich gelohnt.",
          "next": [
            202550003
          ]
        },
        "202550003": {
          "id": 202550003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Hehe.",
          "next": [
            202550004,
            202550005,
            202550006
          ]
        },
        "202550004": {
          "id": 202550004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Warte, wie hat es fünf Sterne bekommen?",
          "next": [
            202550007
          ]
        },
        "202550005": {
          "id": 202550005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hast du es geschafft, diese Gläubiger abzuschütteln, die sich gegen dich verbündet haben?",
          "next": [
            202550009
          ]
        },
        "202550006": {
          "id": 202550006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hehe ... Hast du irgendwas Gutes gefunden? Vielleicht ist auf diesem Konto noch etwas Geld übrig, um deine Schulden zu begleichen?",
          "next": [
            202550011
          ]
        },
        "202550007": {
          "id": 202550007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Je mehr, desto besser! Fünf Sterne sind für mich eine gute Bewertung!",
          "next": [
            202550008
          ]
        },
        "202550008": {
          "id": 202550008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Stimmt. Irgendwie muss man ja diese Ein-Sterne-Bewertungen der Gläubiger ausgleichen.",
          "next": [
            202550011
          ]
        },
        "202550009": {
          "id": 202550009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Nein, aber ich werde mein Bestes geben, um ihren Erwartungen gerecht zu werden.",
          "next": [
            202550010
          ]
        },
        "202550010": {
          "id": 202550010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Oh, das nennst du also eine Erwartung?",
          "next": [
            202550011
          ]
        },
        "202550011": {
          "id": 202550011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Whoa, harte Worte, {F#Stellvertreterin}{M#Stellvertreter}.",
          "next": [
            202550012
          ]
        },
        "202550012": {
          "id": 202550012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Schau dir doch mal dieses Memo an. Das ist mehr wert als die gesamte Produktion der letzten zehn Jahre zusammen.",
          "next": [
            202550013
          ]
        },
        "202550013": {
          "id": 202550013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Exklusive Aufnahmen von Pfadfindern, die ihre eigenen Äonen in die Pfanne hauen, ungestellte, spontan gespeicherte Tratsch-Clips ... Das nenne ich mal Content vom Feinsten.",
          "next": [
            202550014
          ]
        },
        "202550014": {
          "id": 202550014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Wie habe ich dieses Konto damals überhaupt verloren ...?",
          "next": [
            202550015,
            202550016,
            202550017
          ]
        },
        "202550015": {
          "id": 202550015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Red nicht nur darüber! Schick es schon rüber!",
          "next": [
            202550018
          ]
        },
        "202550016": {
          "id": 202550016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Zeichnest du ein weiteres Kapitel deiner wilden Geschichten?",
          "next": [
            202550019
          ]
        },
        "202550017": {
          "id": 202550017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Fräulein Colt, wir brauchen ein neues Kapitel, biiitteee!",
          "next": [
            202550021
          ]
        },
        "202550018": {
          "id": 202550018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Hetzt mich nicht. Ich habe ein neues Kapitel für euch.",
          "next": [
            202550023
          ]
        },
        "202550019": {
          "id": 202550019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Eigentlich ist es gar nicht so wild.",
          "next": [
            202550020
          ]
        },
        "202550020": {
          "id": 202550020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich meine, ich bin nicht so kleinlich! Die Geschichten anderer Leute sind immer viel unterhaltsamer als meine. Wie zum Beispiel ...",
          "next": [
            202550023
          ]
        },
        "202550021": {
          "id": 202550021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Oh, jetzt gibt es so viel, womit ich arbeiten kann. Ich glaube, ich habe auch neues Material für „Medizinduft im Wind“ ...",
          "next": [
            202550022
          ]
        },
        "202550022": {
          "id": 202550022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich habe ein neues Kapitel für euch.",
          "next": [
            202550023
          ]
        },
        "202550023": {
          "id": 202550023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Vor hunderten Bernsteinzeitaltern hinterließ ein Geschichtsfiktionologe seine letzten Worte ...",
          "next": [
            202550024
          ]
        },
        "202550024": {
          "id": 202550024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„Tayzzyronth wand sich und kroch, legte jeden Tag tausend Meilen zurück, alles für einen namenlosen Planeten ...“",
          "next": [
            202550025
          ]
        },
        "202550025": {
          "id": 202550025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„Währenddessen hatten Ena und Xipe irgendwo in den Schatten in der Nähe des Planeten verborgen auf der Lauer gelegen ...“",
          "next": [
            202550026
          ]
        },
        "202550026": {
          "id": 202550026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„Sie trafen unerwartet auf Oroboros, und als die Götter sich gegenüberstanden, stieg die Spannung und die Funken flogen, alles wegen einer einzigen Person ...“",
          "next": [
            202550027
          ]
        },
        "202550027": {
          "id": 202550027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„Aha war genau da.“",
          "next": [
            202550028,
            202550029,
            202550030
          ]
        },
        "202550028": {
          "id": 202550028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bilde dir bloß nichts ein, Aha!",
          "next": [
            202550031
          ]
        },
        "202550029": {
          "id": 202550029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist das nicht wieder nur eine deiner verrückten Geschichten? Warum ziehst du schon wieder dieselbe Nummer ab!?",
          "next": [
            202550031
          ]
        },
        "202550030": {
          "id": 202550030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ehrlich gesagt bin ich das ein bisschen leid. Hast du nicht was Neues?",
          "next": [
            202550031
          ]
        },
        "202550031": {
          "id": 202550031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich bin noch nicht fertig ... Die Wahrheit, die noch kein Historiker aufdecken konnte: „Die Götter begehrten den namenlosen Planeten, weil ...“",
          "next": [
            202550032
          ]
        },
        "202550032": {
          "id": 202550032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„... dort alle frühen Übungsskripte, Skizzenbücher und Fanwerke von Aha lagerten.“",
          "next": [
            202550033
          ]
        },
        "202550033": {
          "id": 202550033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "„Sie wollte dort Wurzeln schlagen. Sie wollte allein speisen. Sie, und sie, wollten nur etwas erlangen ...“",
          "next": [
            202550034
          ]
        },
        "202550034": {
          "id": 202550034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Hehe, immerhin habe ich sie damals tatsächlich alle gezeichnet.",
          "next": [
            202550035
          ]
        },
        "202550035": {
          "id": 202550035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich habe ein paar vorgefertigte Zeichnungen in meinem Memo. Warte kurz, ich schicke sie dir rüber.",
          "next": [
            202550036
          ]
        },
        "202550036": {
          "id": 202550036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 241,
          "text": "Ich komme direkt zur Sache. Ich will mein Handyguthaben nicht aufbrauchen.",
          "next": [
            202550037
          ]
        },
        "202550037": {
          "id": 202550037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt ...",
          "next": [
            202550038
          ]
        },
        "202550038": {
          "id": 202550038,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Vom System stummgeschaltet.",
          "next": [
            202550039,
            202550040
          ]
        },
        "202550039": {
          "id": 202550039,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist dir der Inhalt zu wild, oder hast du ernsthaft kein Handyguthaben mehr??",
          "next": [
            202550041
          ]
        },
        "202550040": {
          "id": 202550040,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist dir der Inhalt zu wild, oder hast du ernsthaft kein Handyguthaben mehr??",
          "next": [
            202550041
          ]
        },
        "202550041": {
          "id": 202550041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nachricht konnte nicht gesendet werden.",
          "next": [
            202550042
          ]
        },
        "202550042": {
          "id": 202550042,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Abnormale Aktivität auf diesem Konto erkannt. Betrügerisches Verhalten festgestellt. Der Zugriff wurde gesperrt.",
          "next": []
        }
      },
