        },
        "202560018": {
          "id": 202560018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Sich mitten in der Nacht ins Haus eines Kunden zu schleichen und Geschenke unter den Esstisch zu stopfen, ist genau meine Art von Job.",
