        "202560021": {
          "id": 202560021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Wie sich herausgestellt hat, ist sie diejenige, die das Video von einem Furbo gefilmt hat, der nach einer großen Mahlzeit rülpst und direkt umkippt.",
