            202560010
          ]
        },
        "202560010": {
          "id": 202560010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "DAS ist der wahre Aha!",
          "next": [
            202560011
          ]
        },
        "202560011": {
          "id": 202560011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Zum Glück sind mir Gelegenheitsjobs nicht fremd. Zeit, das hier ernst zu nehmen. Ich werde vom Handwerker lernen und zum AHAuler-Ass werden!",
          "next": [
            202560012,
            202560013
          ]
        },
        "202560012": {
          "id": 202560012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ja, du solltest dich wohl besser reinhängen und an die Arbeit machen.",
          "next": [
            202560014
          ]
        },
        "202560013": {
          "id": 202560013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Der Handwerker ★★★★★ hat Äonin ★ Aha gerade den Ball zugespielt.",
