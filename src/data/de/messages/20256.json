        },
        "202560014": {
          "id": 202560014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 243,
          "text": "Ja, so etwas wie ein kostenloses Frühstück, Mittag- oder Abendessen gibt es nicht.",
