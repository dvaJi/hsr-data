      "messages": {
        "202160000": {
          "id": 202160000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du hast eine Nachricht. Wird abgerufen ...",
          "next": [
            202160001
          ]
        },
        "202160001": {
          "id": 202160001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{F#Partnerin}{M#Partner}, wenn du diese Nachricht erhältst, sollten die Wellen sich bereits in Bewegung gesetzt haben.",
          "next": [
            202160002
          ]
        },
        "202160002": {
          "id": 202160002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Bevor ich mich umdrehte, warf ich einen letzten Blick auf die Sterne. Schau!",
          "next": [
            202160003
          ]
        },
        "202160003": {
          "id": 202160003,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1415,
          "image": "PhoneMessagePic_10050",
          "next": [
            202160004
          ]
        },
        "202160004": {
          "id": 202160004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Jedes Mal, wenn ich in den Sternenhimmel blicke, stelle ich mir vor, was ich in der Galaxie tun könnte.",
          "next": [
            202160005
          ]
        },
        "202160005": {
          "id": 202160005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Hihi, Ritterin der Schönheit Cyrene – klingt das nicht toll?",
          "next": [
            202160006
          ]
        },
        "202160006": {
          "id": 202160006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Wenn ich meinen Gedanken noch mehr Freiraum lasse, vielleicht wäre ich auch als Stehl-aron-Jägerin geeignet? Oder ... als eine der Namenlosen?",
          "next": [
            202160007
          ]
        },
        "202160007": {
          "id": 202160007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Aber diese Wünsche sind doch viel zu extravagant.",
          "next": [
            202160008
          ]
        },
        "202160008": {
          "id": 202160008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ich besitze bereits einen Stern, den noch niemand zuvor hatte, oder? ♪",
          "next": [
            202160009
          ]
        },
        "202160009": {
          "id": 202160009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Solange ich ihn mit Sehnsucht anschaue, wird ein Lichtstrahl in meine Augen fallen.",
          "next": [
            202160010
          ]
        },
        "202160010": {
          "id": 202160010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Vielleicht ist das mein größter Wunsch ...",
          "next": [
            202160011
          ]
        },
        "202160011": {
          "id": 202160011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, auf dem langen Weg, der vor uns liegt, musst du für immer strahlen, in Ordnung?",
          "next": [
            202160012
          ]
        },
        "202160012": {
          "id": 202160012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ach, die Stimmung ist wohl etwas melancholisch geworden ...",
          "next": [
            202160013
          ]
        },
        "202160013": {
          "id": 202160013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Dann schau in den Himmel und lächle!",
          "next": [
            202160014
          ]
        },
        "202160014": {
          "id": 202160014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Wohin du auch gehst, die Sterne von Amphoreus werden für dich funkeln, so als würde ich dir zuzwinkern!",
          "next": [
            202160015
          ]
        },
        "202160015": {
          "id": 202160015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Und dann werden wir uns ganz bestimmt unter dem Sternenlicht wiedersehen. ♪",
          "next": [
            202160016
          ]
        },
        "202160016": {
          "id": 202160016,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1415,
          "next": [
            202160017,
            202160018,
            202160019
          ]
        },
        "202160017": {
          "id": 202160017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wir werden uns bestimmt wiedersehen.",
          "next": [
            202160020
          ]
        },
        "202160018": {
          "id": 202160018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wann sehen wir uns wieder?",
          "next": [
            202160020
          ]
        },
        "202160019": {
          "id": 202160019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Abgemacht, lass uns zusammen die Sterne beobachten.",
          "next": [
            202160020
          ]
        },
        "202160020": {
          "id": 202160020,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nachricht konnte nicht gesendet werden.",
          "next": [
            202160021
          ]
        },
