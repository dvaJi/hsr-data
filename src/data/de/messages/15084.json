      ],
      "messages": {
        "150840101": {
          "id": 150840101,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            150840102
          ]
        },
        "150840102": {
          "id": 150840102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Erinnerst du dich noch an die Tickets, die ich für dich beiseite gelegt habe?",
          "next": [
            150840103
          ]
        },
        "150840103": {
          "id": 150840103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ursprünglich hatte ich gehofft, dass du den Auftritt genießen kannst, aber ich hätte nicht gedacht, dass du selbst ein Teil davon wirst.",
          "next": [
            150840104,
            150840105
          ]
        },
        "150840104": {
          "id": 150840104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es ist echt schade, dass ich die Show nicht sehen konnte. Könnte ich vielleicht Tickets für das nächste Mal bekommen?",
          "next": [
            150840106
          ]
        },
        "150840105": {
          "id": 150840105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ehrlich gesagt habe ich seit meiner Rückkehr die ganze Zeit nach Aufnahmen der Eröffnungsshow gesucht.",
          "next": [
            150840106
          ]
        },
        "150840106": {
          "id": 150840106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Schließlich saßt du damals in einem Rennwagen und hast das neue Lied in der miesen Tonqualität durch das TR gehört.",
          "next": [
            150840107
          ]
        },
        "150840107": {
          "id": 150840107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das ist mir schon etwas unangenehm.",
          "next": [
            150840108
          ]
        },
        "150840108": {
          "id": 150840108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Also ...",
          "next": [
            150840109
          ]
        },
        "150840109": {
          "id": 150840109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "... Ich habe einen besonderen Platz für dich vorbereitet, von dem aus du meinen Live-Auftritt hautnah miterleben kannst. Wie wär’s?",
          "next": [
            150840110
          ]
        },
        "150840110": {
          "id": 150840110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Toll! Wo findet das denn statt?",
          "next": [
            150840111
          ]
        },
        "150840111": {
          "id": 150840111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich arbeite zusammen mit dem Interastralen Friedensentertainment an einer Kooperation, deren Ziel es ist, die Emotionen des Live-Erlebnisses wiederaufleben zu lassen.",
          "next": [
            150840112
          ]
        },
        "150840112": {
          "id": 150840112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Dann kann sich jeder meinen Live-Auftritt auf der Bühne im Küstenpark von Astropolis immer wieder ansehen.",
          "next": [
            150840113
          ]
        },
        "150840113": {
          "id": 150840113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wenn du Interesse hast, geh zur Bar im Küstenpark und such nach einer Barkeeperin namens Rocca.",
          "next": [
            150840114
          ]
        },
        "150840114": {
          "id": 150840114,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1309,
          "image": "PhoneMessagePic_15501",
          "next": [
            150840115
          ]
        },
        "150840115": {
          "id": 150840115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich habe ihnen schon vorab Bescheid gegeben.",
          "next": [
            150840116
          ]
        },
        "150840116": {
          "id": 150840116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Du wirst {F#die erste Zuschauerin}{M#der erste Zuschauer} dieses besonderen Auftritts sein.",
          "next": [
            150840117,
            150840118
          ]
        },
        "150840117": {
          "id": 150840117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich kann es kaum erwarten!",
          "next": [
            150840119
          ]
        },
        "150840118": {
          "id": 150840118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich schaue es mir an, sobald ich hier fertig bin.",
          "next": [
            150840119
          ]
        },
