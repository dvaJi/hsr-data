      "messages": {
        "202120000": {
          "id": 202120000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "So sieht man sich wieder, Trailblaze-Grauvögelchen! ♭",
          "next": [
            202120001
          ]
        },
        "202120001": {
          "id": 202120001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du hast mich schon wieder aufgeweckt.",
          "next": [
            202120002,
            202120004,
            202120005
          ]
        },
        "202120002": {
          "id": 202120002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wach auf ...",
          "next": [
            202120003
          ]
        },
        "202120003": {
          "id": 202120003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Die neuen Klamotten sind da! Ein Talentscout steht vor der Tür! Dein Lieblingssaft macht eine Kollaboration mit Robin ...",
          "next": [
            202120007
          ]
        },
        "202120004": {
          "id": 202120004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist es nicht noch ein bisschen zu früh zum Schlafwandeln?",
          "next": [
            202120007
          ]
        },
        "202120005": {
          "id": 202120005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vergiss nicht, das Konto zu wechseln, meine Liebe.",
          "next": [
            202120006
          ]
        },
        "202120006": {
          "id": 202120006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Aber es ist Nacht.",
          "next": [
            202120007
          ]
        },
        "202120007": {
          "id": 202120007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1413,
          "next": [
            202120008
          ]
        },
        "202120008": {
          "id": 202120008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ich bin nur hier, um einen kleinen Deal mit dir zu machen.",
          "next": [
            202120009
          ]
        },
        "202120009": {
          "id": 202120009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ich habe immer noch ein paar ... „Erinnerungen“ von dir. Du willst doch nicht, dass sie an die Öffentlichkeit kommen, oder?",
          "next": [
            202120010,
            202120011
          ]
        },
        "202120010": {
          "id": 202120010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Also gut, erzähl.",
          "next": [
            202120012
          ]
        },
        "202120011": {
          "id": 202120011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wer die Wahrheit auf seiner Seite hat, braucht nichts zu fürchten.",
          "next": [
            202120012
          ]
        },
        "202120012": {
          "id": 202120012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du bist einem liebeskranken Droma gefolgt und hast heimlich ein Selfie mit ihm gemacht, als es nicht aufgepasst hat. Dann hast du das Selfie gepostet, mit der Beschreibung „Wer weise ist, verliebt sich nicht“.",
          "next": [
            202120013
          ]
        },
        "202120013": {
          "id": 202120013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du hast dir von einem Priester am Straßenrand die Zukunft vorhersagen lassen. Dann hast du ein Selfie an seinem Stand mit dem Text „Ich bin der Schmied meines eigenen Schicksals“ gepostet.",
          "next": [
            202120014
          ]
        },
        "202120014": {
          "id": 202120014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du bist spazieren gegangen und hast zufällig einen wandernden Dichter getroffen ... Du hast direkt ein Rap-Battle angezettelt und dabei ein Selfie gepostet.",
          "next": [
            202120015
          ]
        },
        "202120015": {
          "id": 202120015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du hast ein Selfie von deinen zerzausten Haaren am Morgen gepostet.",
          "next": [
            202120016
          ]
        },
        "202120016": {
          "id": 202120016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Du dachtest, du hättest in letzter Zeit zugenommen, also hast du ein Selfie gepostet.",
          "next": [
            202120017
          ]
        },
        "202120017": {
          "id": 202120017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Kontakt tippt gerade ...",
          "next": [
            202120018,
            202120019,
            202120020
          ]
        },
        "202120018": {
          "id": 202120018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Okay, sieht so aus, als bräuchten wir ein wenig Kraft des Vergessens.",
          "next": [
            202120023
          ]
        },
        "202120019": {
          "id": 202120019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ziemlich cool, was?",
          "next": [
            202120023
          ]
        },
        "202120020": {
          "id": 202120020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ach, ich wollte eigentlich nur im Stillen etwas für die Freundschaft tun. Das hat wohl nicht geklappt.",
          "next": [
            202120021
          ]
        },
        "202120021": {
          "id": 202120021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das sind alles Fotos, die ich für 7. März gemacht habe.",
          "next": [
            202120022
          ]
        },
        "202120022": {
          "id": 202120022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sag schon, was muss ich tun, damit du mir diese Erinnerungen zurückgibst?",
          "next": [
            202120023
          ]
        },
        "202120023": {
          "id": 202120023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Hehe, jetzt weiß sie alles. ♭",
          "next": [
            202120024
          ]
        },
        "202120024": {
          "id": 202120024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Wenn du diese Bilder nicht an ihrer Fotowand sehen willst ... Es ist ganz einfach, Grauhaar. ♭",
          "next": [
            202120025
          ]
        },
        "202120025": {
          "id": 202120025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1413,
          "text": "Ich will, dass sie frisch zubereitetes Essen vor sich sieht, wenn sie morgen Mittag aufwacht.",
          "next": [
            202120026,
            202120027
          ]
        },
        "202120026": {
          "id": 202120026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Geh schlafen, 7. März, und träum weiter.",
          "next": [
            202120028
          ]
        },
        "202120027": {
          "id": 202120027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alles klar, Evernight.",
          "next": [
            202120028
          ]
        },
        "202120028": {
          "id": 202120028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            202120029
          ]
        },
        "202120029": {
          "id": 202120029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ach, vergiss es. Ich habe keine Lust mehr, mit dir zu spielen.",
          "next": [
            202120030
          ]
        },
        "202120030": {
          "id": 202120030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ich hab Hunger. Lass uns schnell überlegen, was wir essen sollen!",
          "next": []
        }
