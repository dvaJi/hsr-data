  "sections": [
    {
      "id": 1506901,
      "startingMessageId": [
        150690100
      ],
      "messages": {
        "150690100": {
          "id": 150690100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Hallo, {F#Protagonistin}{M#Protagonist}.",
          "next": [
            150690101
          ]
        },
        "150690101": {
          "id": 150690101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Wenn du diese geplante Nachricht erhältst, bedeutet das, dass bei meinem Plan bestimmt etwas Unvorhergesehenes passiert ist ... schon wieder.",
          "next": [
            150690102
          ]
        },
        "150690102": {
          "id": 150690102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Natürlich ist es auch nicht ausgeschlossen, dass dich das Stellaron bereits in die Luft gejagt hat und die Person, die diese Nachricht in diesem Moment liest, mein zukünftiges Ich ist.",
          "next": [
            150690103
          ]
        },
        "150690103": {
          "id": 150690103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Aber ich schätze, dein Handy ist nicht so robust gebaut.",
          "next": [
            150690104,
            150690105
          ]
        },
        "150690104": {
          "id": 150690104,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asat Pramad? Du schon wieder?",
          "next": [
            150690106
          ]
        },
        "150690105": {
          "id": 150690105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dein Plan ist gescheitert und wir haben dich besiegt!",
          "next": [
            150690106
          ]
        },
        "150690106": {
          "id": 150690106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "„Das von dir kontaktierte Konto existiert nicht. Nachricht konnte nicht gesendet werden.“",
          "next": [
            150690107
          ]
        },
        "150690107": {
          "id": 150690107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ehrlich gesagt habe ich nichts gegen diese Entwicklung der Handlung.",
          "next": [
            150690108
          ]
        },
        "150690108": {
          "id": 150690108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Im Gegenteil, ich freue mich sehr auf euren Sieg.",
          "next": [
            150690109
          ]
        },
        "150690109": {
          "id": 150690109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Das beweist vielleicht, dass ich falsch liege.",
          "next": [
            150690110
          ]
        },
        "150690110": {
          "id": 150690110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Vorausgesetzt, ihr könnt dieses Spiel überstehen.",
          "next": [
            150690111
          ]
        },
        "150690111": {
          "id": 150690111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Egal, wer gewinnt, sie wird aufwachen und uns alle mit einem Bissen verschlingen.",
          "next": [
            150690112,
            150690113
          ]
        },
        "150690112": {
          "id": 150690112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Zwar kannst du keine Nachrichten erhalten, aber ich muss dich trotzdem fragen ... Warum hast du das getan?",
          "next": [
            150690114
          ]
        },
        "150690113": {
          "id": 150690113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du weißt sicher schon, was ich fragen werde.",
          "next": [
            150690114
          ]
        },
        "150690114": {
          "id": 150690114,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "„Das von dir kontaktierte Konto existiert nicht. Nachricht konnte nicht gesendet werden.“",
          "next": [
            150690115
          ]
        },
        "150690115": {
          "id": 150690115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Ha ... Warum ich das getan habe?",
          "next": [
            150690116
          ]
        },
        "150690116": {
          "id": 150690116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Da Aha sich im Hintergrund versteckt und den Verfall der Welt ignoriert, werde ich an seiner Stelle handeln und das Universum herausfordern.",
          "next": [
            150690117
          ]
        },
        "150690117": {
          "id": 150690117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Und nun lautet die neue Herausforderung: Besiege die wiedererwachte „Gier“.",
          "next": [
            150690118
          ]
        },
        "150690118": {
          "id": 150690118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Wird es {F#eine Heldin sein, die}{M#ein Held sein, der} aus der Zerstörung geboren wurde und Herausforderungen meistert, der das wahre Hochgefühl in die Welt zurückbringt?",
          "next": [
            150690119
          ]
        },
        "150690119": {
          "id": 150690119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "Oder wird die Bestie ihre Rache vollenden und das Hochgefühl in einen würdevollen Untergang führen, bevor es dem Wahnsinn verfällt?",
          "next": [
            150690120
          ]
        },
        "150690120": {
          "id": 150690120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 232,
          "text": "{F#Protagonistin}{M#Protagonist}, kannst du diesen Witz besser zu Ende bringen?",
          "next": []
        }
      },
      "participatingContactsIds": [
        232,
        8001
      ]
    }
  ]
}