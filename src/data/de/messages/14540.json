      ],
      "messages": {
        "145400000": {
          "id": 145400000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Das ist die Diskussionsgruppe des Turniers. Hier drin sind alle Teilnehmer der Meisterschaft.",
          "next": [
            145400001
          ]
        },
        "145400001": {
          "id": 145400001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Grey, sag allen hallo!",
          "next": [
            145400002,
            145400005
          ]
        },
        "145400002": {
          "id": 145400002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kampf der Chimären: Lass deine Fähigkeiten für sich sprechen.",
          "next": [
            145400003
          ]
        },
        "145400003": {
          "id": 145400003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich werde euch alle besiegen und beweisen, dass ich {F#die beste Trainerin}{M#der beste Trainer} in Amphoreus bin!",
          "next": [
            145400004
          ]
        },
        "145400004": {
          "id": 145400004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400005": {
          "id": 145400005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich habe gerade meine Qualifizierungskämpfe beendet, ich bin noch ein Neuling.",
          "next": [
            145400006
          ]
        },
        "145400006": {
          "id": 145400006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Leute, seid also bitte nachsichtig mit mir.",
          "next": [
            145400007
          ]
        },
        "145400007": {
          "id": 145400007,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            145400008
          ]
        },
        "145400008": {
          "id": 145400008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hey, {F#Partnerin}{M#Partner}, es ist selten, dich so zu treffen. Lass uns das mit unseren Chimären klären, ja?",
          "next": [
            145400009
          ]
        },
        "145400009": {
          "id": 145400009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hmpf, versuch nicht, zu sehr zu verlieren, {F#Erlöserin}{M#Erlöser}.",
          "next": [
            145400022
          ]
        },
        "145400010": {
          "id": 145400010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Willst du dich mir in den Weg stellen? Hah, mal sehen, ob du das Zeug dazu hast!",
          "next": [
            145400011
          ]
        },
        "145400011": {
          "id": 145400011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Egal, ich werde alle Hindernisse für die Imperatorin beseitigen.",
          "next": [
            145400012
          ]
        },
        "145400012": {
          "id": 145400012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hey, {F#Rätselhafte Grey}{M#Rätselhafter Grey}, wie wäre es mit einem Deal? Ich stehle die Chimären des Gegners und du verlierst absichtlich für mich.",
          "next": [
            145400013
          ]
        },
        "145400013": {
          "id": 145400013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1402,
          "text": "Lass diese kleinen Spielchen sein, Cifera. Du weißt, dass du vor dem goldenen Faden nichts verbergen kannst.",
          "next": [
            145400014
          ]
        },
        "145400014": {
          "id": 145400014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Kein Schummeln oder Betrügen! *Wir* sind die Schiedsrichterinnen und behalten alle im Auge!",
          "next": [
            145400015
          ]
        },
        "145400015": {
          "id": 145400015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Wie soll das fair sein, wenn jemand gleichzeitig Schiedsrichterin und Teilnehmerin ist?",
          "next": [
            145400016
          ]
        },
        "145400016": {
          "id": 145400016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1403,
          "text": "Hmm ... Tribbie wird kämpfen, Trinnon die Schiedsrichterin sein und Trianne die Bösewichte fangen. Jap, das ist perfekt!",
          "next": [
            145400017
          ]
        },
        "145400017": {
          "id": 145400017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "{NICKNAME}, ich werde in diesem Wettkampf der Chimären ebenfalls mein Bestes geben.",
          "next": [
            145400018,
            145400019
          ]
        },
        "145400018": {
          "id": 145400018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Allein der Gedanke an einen ernsthaften Dan Heng lässt mich vor Angst zittern!",
          "next": [
            145400020
          ]
        },
        "145400019": {
          "id": 145400019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Komm doch, ich werde alles geben und mich der Herausforderung stellen!",
          "next": [
            145400020
          ]
        },
        "145400020": {
          "id": 145400020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Hehe, ich kann es kaum erwarten, {NICKNAME} in Aktion zu sehen!",
          "next": [
            145400021
          ]
        },
        "145400021": {
          "id": 145400021,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1415,
          "next": []
        },
