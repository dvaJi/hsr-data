  "sections": [
    {
      "id": 2024200,
      "startingMessageId": [
        202420000
      ],
      "messages": {
        "202420000": {
          "id": 202420000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ihr habt in letzter Zeit alle hart gearbeitet. Sobald die aktuellen Aufgaben erledigt sind, organisiere ich ein großes Festessen für die Express-Besatzung.",
          "next": [
            202420001
          ]
        },
        "202420001": {
          "id": 202420001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Und ich werde euch allen mein Können zeigen. Hat jemand Lust, das Essen mit mir vorzubereiten?",
          "next": [
            202420002,
            202420005,
            202420008
          ]
        },
        "202420002": {
          "id": 202420002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Super! Aber wer kocht denn? Ich? Oder du, Himeko?",
          "next": [
            202420003
          ]
        },
        "202420003": {
          "id": 202420003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Auch wenn beides ziemlich unzuverlässig klingt ...",
          "next": [
            202420004
          ]
        },
        "202420004": {
          "id": 202420004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Keine Sorge, ich koche nicht.",
          "next": [
            202420010
          ]
        },
        "202420005": {
          "id": 202420005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Klingt gut! Du übernimmst das Kochen, Himeko, und ich helfe beim Vorkosten.",
          "next": [
            202420006
          ]
        },
        "202420006": {
          "id": 202420006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Moment mal, Himeko kocht ...",
          "next": [
            202420007
          ]
        },
        "202420007": {
          "id": 202420007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Keine Sorge, ich koche nicht.",
          "next": [
            202420010
          ]
        },
        "202420008": {
          "id": 202420008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Letztes Mal, als du dein Können gezeigt hast, sind wir ganz schön oft auf die Toilette gerannt. Sehen wir es einfach als Sport an!",
          "next": [
            202420009
          ]
        },
        "202420009": {
          "id": 202420009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Keine Sorge, so etwas wird nicht wieder passieren.",
          "next": [
            202420010
          ]
        },
        "202420010": {
          "id": 202420010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Im Lager steht eine Kochmaschine, die ich früher mal selbst zusammengebastelt habe. Ich habe vor, sie zum Einsatz zu bringen.",
          "next": [
            202420011
          ]
        },
        "202420011": {
          "id": 202420011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Einige Teile sind zwar verrostet, aber es wird ohnehin Zeit für eine Überholung.",
          "next": [
            202420012
          ]
        },
        "202420012": {
          "id": 202420012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ich habe letztes Mal gesagt, dass ich dich bei der Wartung des Expresses mitnehme. Da ich die Kochmaschine reparieren muss und die Prinzipien dieselben sind, dachte ich mir, ich hole dich dazu.",
          "next": [
            202420013,
            202420014,
            202420016
          ]
        },
        "202420013": {
          "id": 202420013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was genau haben die Prinzipien bei der Reparatur des Expresses und einer Kochmaschine gemeinsam ...?",
          "next": [
            202420017
          ]
        },
        "202420014": {
          "id": 202420014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das war also mit „Können“ gemeint! Wie man es von unserer Reparaturmeisterin Himeko erwartet!",
          "next": [
            202420015
          ]
        },
        "202420015": {
          "id": 202420015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aber ... was genau haben die Prinzipien gemeinsam ...?",
          "next": [
            202420017
          ]
        },
        "202420016": {
          "id": 202420016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Muss ich auch den Express ... Ah nein, muss ich auch die Kochmaschine reparieren ...? Moment, was genau haben die Prinzipien gemeinsam ...?",
          "next": [
            202420017
          ]
        },
        "202420017": {
          "id": 202420017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Die Prinzipien von Energieübertragung, thermodynamischen Kreisläufen und mechanischer Rotation unterscheiden sich kaum. Der einzige Unterschied ist, dass das eine die Sterne antreibt und das andere einen Pfannenwender.",
          "next": [
            202420018
          ]
        },
        "202420018": {
          "id": 202420018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Darüber hinaus benötigt es ein intelligentes Kochsystem, um Hitze und Würze an verschiedene Geschmäcker anzupassen.",
          "next": [
            202420019
          ]
        },
        "202420019": {
          "id": 202420019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Das ist vergleichbar mit der Untersuchung der Fahrgewohnheiten des Navigators und des Schaffners.",
          "next": [
            202420020,
            202420027
          ]
        },
        "202420020": {
          "id": 202420020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das heißt, wenn ich gelernt habe, eine Kochmaschine zu reparieren, dann weiß ich auch, wie man den Astralexpress repariert ...",
          "next": [
            202420021
          ]
        },
        "202420021": {
          "id": 202420021,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202420022
          ]
        },
        "202420022": {
          "id": 202420022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Genau, das ist die Logik.",
          "next": [
            202420023
          ]
        },
        "202420023": {
          "id": 202420023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das war doch nur ein Scherz!",
          "next": [
            202420024
          ]
        },
        "202420024": {
          "id": 202420024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Schon gut. Ich mache keine Witze.",
          "next": [
            202420025
          ]
        },
        "202420025": {
          "id": 202420025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Glaub mir, du wirst es verstehen, sobald wir es ausprobieren.",
          "next": [
            202420026
          ]
        },
        "202420026": {
          "id": 202420026,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1003,
          "next": []
        },
