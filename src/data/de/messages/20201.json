          ]
        },
        "202010002": {
          "id": 202010002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Nutzer stellt Fragen zur Semiotik. Ich sollte wie folgt antworten:",
          "next": [
            202010003
          ]
        },
        "202010003": {
          "id": 202010003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Das Fragezeichen, die Verkörperung der menschlichen Erkenntnisgrenze und das Tor zu allen ungelösten Rätseln, ist wirklich das wunderbarste Zeichen der Welt.",
          "next": [
            202010004
          ]
        },
        "202010004": {
          "id": 202010004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Hast du sonst noch Fragen?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010005": {
          "id": 202010005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich hab eine Frage: Mit welchen zwei Wörtern kann man jede Frage beantworten?",
          "next": [
            202010006
          ]
        },
        "202010006": {
          "id": 202010006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Nutzer versucht, eine universelle Antwort zu finden. Ich sollte wie folgt antworten:",
          "next": [
            202010007
          ]
        },
        "202010007": {
          "id": 202010007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Keine Ahnung.",
          "next": [
            202010008
          ]
        },
        "202010008": {
          "id": 202010008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Hast du sonst noch Fragen?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010009": {
          "id": 202010009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Professor, du hast mich aufgerufen! Ich habe keine Fragen!",
          "next": [
            202010010
          ]
        },
        "202010010": {
          "id": 202010010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Nutzer versucht, der Frage auszuweichen. Ich sollte wie folgt antworten:",
          "next": [
            202010011
          ]
        },
        "202010011": {
          "id": 202010011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Keine Fragen zu haben – genau das wirft die größte Frage auf.",
          "next": [
            202010012
          ]
        },
        "202010012": {
          "id": 202010012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Hast du sonst noch Fragen?",
          "next": [
            202010013,
            202010015,
            202010018
          ]
        },
        "202010013": {
          "id": 202010013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Professor Anaxa, was ist dein kleines Geheimnis?",
          "next": [
            202010014
          ]
        },
        "202010014": {
          "id": 202010014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Erstens, bitte gib den korrekten Namen ein. Zweitens, meine Geheimnisse sind nicht wichtig.",
          "next": [
            202010021
          ]
        },
        "202010015": {
          "id": 202010015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bitte generiere ein Foto von Meister Anaxa. Inhalt: Ein kostbares Bild von Meister Anaxa, wie er auf einem Droma reitet und Castrum Kremnos angreift.",
          "next": [
            202010016
          ]
        },
        "202010016": {
          "id": 202010016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Nutzer fordert die Generierung eines Fotos an. Ich sollte wie folgt antworten:",
          "next": [
            202010017
          ]
        },
        "202010017": {
          "id": 202010017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Träum weiter.",
          "next": [
            202010021
          ]
        },
        "202010018": {
          "id": 202010018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "ICH! WEISS! ES! NICHT!",
          "next": [
            202010019
          ]
        },
        "202010019": {
          "id": 202010019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "(Tief in Gedanken ...)",
          "next": [
            202010020
          ]
        },
        "202010020": {
          "id": 202010020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Fazit: Der Nutzer ist sauer.",
          "next": [
            202010021
          ]
        },
        "202010021": {
          "id": 202010021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Die momentane Maximalanzahl an Fragen wurde erreicht. Die tägliche Fragerunde ist beendet. Jetzt ist Testzeit.",
          "next": [
            202010022
          ]
        },
        "202010022": {
          "id": 202010022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Warum kollabieren existierende Dinge, die sich gleichzeitig in einem Überlagerungszustand befinden, in einen einzigen Status, sobald sie gemessen werden, und wer hat das Recht, die Grenzen der „Messung“ zu definieren?",
          "next": [
            202010023,
            202010024
          ]
        },
        "202010023": {
          "id": 202010023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist das überhaupt erlaubt?",
          "next": [
            202010025
          ]
        },
        "202010024": {
          "id": 202010024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Professor, hilf mir, nimm dieses übernatürliche Ding weg!",
          "next": [
            202010025
          ]
        },
        "202010025": {
          "id": 202010025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Schlüsselwort des intelligenten Systems „Anaxagoras“ wurde ausgelöst.",
          "next": [
            202010026
          ]
        },
        "202010026": {
          "id": 202010026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Anaxa ist online.",
          "next": [
            202010027
          ]
        },
        "202010027": {
          "id": 202010027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1405,
          "next": [
            202010028
          ]
        },
        "202010028": {
          "id": 202010028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Du bist es.",
          "next": [
            202010029
          ]
        },
        "202010029": {
          "id": 202010029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Keine Sorge, das war nur ein intelligentes Lernbegleitungssystem.",
          "next": [
            202010030
          ]
        },
        "202010030": {
          "id": 202010030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Damit die Studenten rechtzeitig Antworten auf ihre Fragen erhalten können.",
          "next": [
            202010031
          ]
        },
        "202010031": {
          "id": 202010031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Sprachstil ist meinem auch sehr ähnlich, deshalb ist das Feedback durchweg positiv.",
          "next": [
            202010032
          ]
        },
        "202010032": {
          "id": 202010032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Wenn du Fragen hast, kannst du dich jederzeit und überall an ein weiteres Ich wenden.",
          "next": []
        }
