          ]
        },
        "202060004": {
          "id": 202060004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Phainon, schön dich wiederzusehen!",
          "next": [
            202060008
          ]
        },
        "202060005": {
          "id": 202060005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was ist los?",
          "next": [
            202060008
          ]
        },
        "202060006": {
          "id": 202060006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Los, sag schon, ich kann es kaum erwarten!",
          "next": [
            202060007
          ]
        },
        "202060007": {
          "id": 202060007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was ist los?",
          "next": [
            202060008
          ]
        },
        "202060008": {
          "id": 202060008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Nun ... Ich habe endlich mal Zeit zum Entspannen, aber ich kann einfach nicht stillsitzen, also suche ich mir etwas zu tun.",
          "next": [
            202060009
          ]
        },
        "202060009": {
          "id": 202060009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aglaea und Lehrerin Tribbie haben ihre eigenen Fachgebiete, denen sie sich hingeben.",
          "next": [
            202060010
          ]
        },
        "202060010": {
          "id": 202060010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ich hatte plötzlich Lust darauf, verschiedene Berufe auszuprobieren, neue Fähigkeiten zu erlernen und noch mehr Hobbys für mich zu entdecken!",
          "next": [
            202060011
          ]
        },
        "202060011": {
          "id": 202060011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Also habe ich mich als Koch beworben, als Schlosser, als Geisterhaus-Darsteller, als Kleidungsmodel, als Dromentrainer, als Auktionator und so weiter ...",
          "next": [
            202060012
          ]
        },
        "202060012": {
          "id": 202060012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aber das entsprach alles nicht wirklich meinem Geschmack ...",
          "next": [
            202060013
          ]
        },
        "202060013": {
          "id": 202060013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hast du noch weitere Empfehlungen, {F#Partnerin}{M#Partner}?",
          "next": [
            202060014,
            202060016,
            202060018
          ]
        },
        "202060014": {
          "id": 202060014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Die gleißende Sonne, die dazu bestimmt ist, aufzusteigen ...",
          "next": [
            202060015
          ]
        },
        "202060015": {
          "id": 202060015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du solltest durch die Lüfte streifen!",
          "next": [
            202060019
          ]
        },
        "202060016": {
          "id": 202060016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Als Aquarellmaler kannst du die Fähigkeit, Farbkombination zu kreieren, verbessern.",
          "next": [
            202060017
          ]
        },
        "202060017": {
          "id": 202060017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ist das nicht eine echte Herausforderung?",
          "next": [
            202060019
          ]
        },
        "202060018": {
          "id": 202060018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hundetrainer. Ich finde, du hast wirklich Talent dafür.",
          "next": [
            202060019
          ]
        },
        "202060019": {
          "id": 202060019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202060020
          ]
        },
        "202060020": {
          "id": 202060020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Du hast mich inspiriert!",
          "next": [
            202060021
          ]
        },
        "202060021": {
          "id": 202060021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ich sollte meinen Horizont erweitern und mich mehr Herausforderungen stellen, ob im Himmel oder auf der Erde!",
          "next": [
            202060022
          ]
        },
        "202060022": {
          "id": 202060022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Zum Beispiel Fallschirmspringen! Ich habe keine Höhenangst und könnte sogar noch höher steigen.",
          "next": [
            202060023
          ]
        },
        "202060023": {
          "id": 202060023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Und ... wie wäre es mit Profi-Ballsportler?",
          "next": [
            202060024
          ]
        },
        "202060024": {
          "id": 202060024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Nach meiner Punktzahl zu urteilen, habe ich schon ein bisschen Talent.",
          "next": [
            202060025
          ]
        },
        "202060025": {
          "id": 202060025,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202060026
          ]
        },
        "202060026": {
          "id": 202060026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Das klingt doch großartig!",
          "next": [
            202060027
          ]
        },
        "202060027": {
          "id": 202060027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Je mehr ich daran denke, desto aufgeregter werde ich!",
          "next": [
            202060028
          ]
        },
        "202060028": {
          "id": 202060028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ich probiere es jetzt gleich aus!",
          "next": [
            202060029
          ]
        },
        "202060029": {
          "id": 202060029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Bis später!",
          "next": []
        }
