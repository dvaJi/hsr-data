      "messages": {
        "202370000": {
          "id": 202370000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Die Version des Plug-ins „Blade-Aufspürer“ wurde für dich aktualisiert.",
          "next": [
            202370001
          ]
        },
        "202370001": {
          "id": 202370001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Das ist neu: Einige bekannte Probleme wurden behoben, die Vibrationsreduktion verbessert und mehr Videos von Katzenkuchen angesehen.",
          "next": [
            202370002
          ]
        },
        "202370002": {
          "id": 202370002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du hast Blades Handy angestupst und es einmal vibrieren lassen.",
          "next": [
            202370003
          ]
        },
        "202370003": {
          "id": 202370003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Blade ist jetzt online.",
          "next": [
            202370004
          ]
        },
        "202370004": {
          "id": 202370004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Perfektes Timing. Ich habe gerade an dich gedacht.",
          "next": [
            202370005,
            202370006
          ]
        },
        "202370005": {
          "id": 202370005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich fühle mich geschmeichelt! Was genau hat dich auf mich gebracht?",
          "next": [
            202370008
          ]
        },
        "202370006": {
          "id": 202370006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Soll ich dich endlich auf den neuesten Stand bringen?",
          "next": [
            202370007
          ]
        },
        "202370007": {
          "id": 202370007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Nein.",
          "next": [
            202370008
          ]
        },
        "202370008": {
          "id": 202370008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202370009
          ]
        },
        "202370009": {
          "id": 202370009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Vorhin habe ich einige Gegenstände im Arsenal bemerkt, die zwar abgenutzt, aber vom Material her noch brauchbar sind ... Kein Besitzer in der Nähe. Das müssen Relikte aus deiner Vergangenheit sein.",
          "next": [
            202370010
          ]
        },
        "202370010": {
          "id": 202370010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Da du mir eine Nachricht geschickt hast, frage ich einfach mal: Was möchtest du? Ich kann es anpassen und verfeinern, wenn ich zurückkomme.",
          "next": [
            202370011
          ]
        },
        "202370011": {
          "id": 202370011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was habe ich zurückgelassen? Irgendeine Waffe?",
          "next": [
            202370012
          ]
        },
        "202370012": {
          "id": 202370012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ein paar Gegenstände, die in ihrem jetzigen Zustand nicht wiederzuerkennen sind. Ihrer Konstruktion nach zu urteilen, waren sie für den täglichen Gebrauch gedacht.",
          "next": [
            202370013
          ]
        },
        "202370013": {
          "id": 202370013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mach das Beste aus dem, was du hast. Sag mir, was du brauchst, und ich kann es herstellen.",
          "next": [
            202370014,
            202370016,
            202370021
          ]
        },
        "202370014": {
          "id": 202370014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Für meine actionreichen interstellaren Reisen brauche ich so eine Art Schlafmaschine, die mich jederzeit, überall und auf der Stelle in den Schlaf wiegen kann.",
          "next": [
            202370015
          ]
        },
        "202370015": {
          "id": 202370015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Auf der Xianzhou nannten wir es ein Wiegenbett.",
          "next": [
            202370025
          ]
        },
        "202370016": {
          "id": 202370016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vielleicht etwas nicht ganz so Alltägliches.",
          "next": [
            202370017
          ]
        },
        "202370017": {
          "id": 202370017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Hast du gut geschlafen?",
          "next": [
            202370018
          ]
        },
        "202370018": {
          "id": 202370018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich habe kürzlich an Bord des Schiffes ein paar Geräte gebaut, die beim Schlafen helfen. Hättest du Interesse daran?",
          "next": [
            202370019
          ]
        },
        "202370019": {
          "id": 202370019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Dann will ich ein Upgrade! Wie wäre es mit etwas, das mich jederzeit und überall auf der Stelle in den Schlaf wiegen kann?",
          "next": [
            202370020
          ]
        },
        "202370020": {
          "id": 202370020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kein Problem.",
          "next": [
            202370025
          ]
        },
        "202370021": {
          "id": 202370021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin nicht wählerisch, ich nehme alles!",
          "next": [
            202370022
          ]
        },
        "202370022": {
          "id": 202370022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich habe kürzlich an Bord des Schiffes ein paar Geräte gebaut, die beim Schlafen helfen. Hättest du Interesse daran?",
          "next": [
            202370023
          ]
        },
        "202370023": {
          "id": 202370023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Juhu! Ich will eine Schlafmaschine, die mich jederzeit, überall und auf der Stelle in den Schlaf wiegen kann.",
          "next": [
            202370024
          ]
        },
        "202370024": {
          "id": 202370024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kein Problem.",
          "next": [
            202370025
          ]
        },
        "202370025": {
          "id": 202370025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Jemanden in den Schlaf zu wiegen, ist recht einfach. Aber Schlaf zu erzwingen ... Das erfordert ein spezielles Design.",
          "next": [
            202370026,
            202370029,
            202370033
          ]
        },
        "202370026": {
          "id": 202370026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du kannst etwas weißes Rauschen hinzufügen. Das hilft mir, noch schneller einzuschlafen.",
          "next": [
            202370027
          ]
        },
        "202370027": {
          "id": 202370027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Kein Problem. Ich füge ein paar Eisenplatten hinzu. Sie sollten das Summen beim Schmieden einer Klinge nachahmen.",
          "next": [
            202370028
          ]
        },
        "202370028": {
          "id": 202370028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dieses Geräusch hat mich früher zwar belebt ... Dich könnte es aber durchaus in den Schlaf wiegen.",
          "next": [
            202370038
          ]
        },
        "202370029": {
          "id": 202370029,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie wäre es, ein paar physische Einschlafhilfen hinzuzufügen? Wie eine Massage, Kissen aufschütteln, so etwas in der Art?",
          "next": [
            202370030
          ]
        },
        "202370030": {
          "id": 202370030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Okay.",
          "next": [
            202370031
          ]
        },
        "202370031": {
          "id": 202370031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Im Abstellraum befinden sich ausrangierte mechanische Armgelenke, die diese Bewegungen simulieren können.",
          "next": [
            202370032
          ]
        },
        "202370032": {
          "id": 202370032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Es könnte ein bisschen laut werden, aber du könntest es als weißes Rauschen betrachten.",
          "next": [
            202370038
          ]
        },
        "202370033": {
          "id": 202370033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kannst du ein paar Schlaflieder mit Gesang hinzufügen?",
          "next": [
            202370034
          ]
        },
        "202370034": {
          "id": 202370034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "... Okay.",
          "next": [
            202370035
          ]
        },
        "202370035": {
          "id": 202370035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Es ist ein Musikspieler eingebaut. Man kann ein Lied darauf aufnehmen.",
          "next": [
            202370036
          ]
        },
        "202370036": {
          "id": 202370036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Aber ich kann nicht gut singen. Ich kann dir höchstens ein paar Songtexte aufsagen ...",
          "next": [
            202370037
          ]
        },
        "202370037": {
          "id": 202370037,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Alles klar! Ich schätze, das reicht ...",
          "next": [
            202370038
          ]
        },
        "202370038": {
          "id": 202370038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sobald die Modifikationen abgeschlossen sind, kann ich sie liefern lassen, oder du holst sie persönlich ab. Deine Entscheidung.",
          "next": [
            202370039
          ]
        },
        "202370039": {
          "id": 202370039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich melde mich.",
          "next": [
            202370040
          ]
        },
        "202370040": {
          "id": 202370040,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Bis dann.",
          "next": [
            202370041
          ]
        },
        "202370041": {
          "id": 202370041,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Blade ist offline gegangen.",
          "next": []
        }
      },
