        "202170001": {
          "id": 202170001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Tada!",
          "next": [
            202170002
          ]
        },
        "202170002": {
          "id": 202170002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Wie könnte dieses Mädchen namens „Cyrene“ so einfach gehen?",
          "next": [
            202170003
          ]
        },
        "202170003": {
          "id": 202170003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Auch heute ist ein schöner Tag. Natürlich muss er noch mit Blumen geschmückt werden. ♪",
          "next": [
            202170004
          ]
        },
        "202170004": {
          "id": 202170004,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1415,
          "next": [
            202170005
          ]
        },
        "202170005": {
          "id": 202170005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ach, ich habe mir bei der Auswahl des Blumenstraußes wirklich den Kopf zerbrochen.",
          "next": [
            202170006
          ]
        },
        "202170006": {
          "id": 202170006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Eine in allen Farben schillernde Kristallrose, die aus einem einzigen Samen von mir persönlich gepflegt wurde!",
          "next": [
            202170007
          ]
        },
        "202170007": {
          "id": 202170007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Hehe, und dann die Antila-Blumen aus Castorices Garten, jedes Blütenblatt befeuchtet vom Tau.",
          "next": [
            202170008
          ]
        },
        "202170008": {
          "id": 202170008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Sonnenblumen und Glockenblumen aus Hyacines Garten, wie sanfter Sonnenschein ...",
          "next": [
            202170009
          ]
        },
        "202170009": {
          "id": 202170009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Und dann noch die blauen Mondscheinlilien, Gipskräuter, weiße Glockenblumen ...",
          "next": [
            202170010
          ]
        },
        "202170010": {
          "id": 202170010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Hehe, rate mal ... Was ist wohl meine liebste Kombination?",
          "next": [
            202170011
          ]
        },
        "202170011": {
          "id": 202170011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Tada, ein Weizenbündel aus Aedes Elysiae!",
          "next": [
            202170012
          ]
        },
        "202170012": {
          "id": 202170012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "{NICKNAME}, wenn du es erhältst, schließ bitte deine Augen. Der Duft des Weizens wird dich zurück in jenes kleine Dorf bringen.",
          "next": [
            202170013
          ]
        },
        "202170013": {
          "id": 202170013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Wie damals, als wir auf der Schaukel hoch in die Luft flogen, die Wellen in der Ferne gegen das Ufer schlugen und die Weizenfelder unter unseren Füßen wogten ...",
          "next": [
            202170014
          ]
        },
        "202170014": {
          "id": 202170014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Die weiteren Überraschungen solltest du selbst entdecken.",
          "next": [
            202170015
          ]
        },
        "202170015": {
          "id": 202170015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Auch wenn ich nicht bei dir sein kann, solltest du die Karte sorgfältig lesen, ja?",
          "next": [
            202170016
          ]
        },
        "202170016": {
          "id": 202170016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1415,
          "text": "Ich wünsche dir, dass jeder deiner Tage von Blumen begleitet wird, {NICKNAME}. ♪",
          "next": [
            202170017,
            202170018,
            202170019
          ]
        },
        "202170017": {
          "id": 202170017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Danke, Cyrene.",
          "next": [
            202170020
          ]
        },
        "202170018": {
          "id": 202170018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich habe deine Wünsche erhalten.",
          "next": [
            202170020
          ]
        },
        "202170019": {
          "id": 202170019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich werde es gut aufbewahren!",
          "next": [
            202170020
          ]
        },
        "202170020": {
          "id": 202170020,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nachricht konnte nicht gesendet werden.",
