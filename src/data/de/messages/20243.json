      ],
      "messages": {
        "202430000": {
          "id": 202430000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, ich war gerade am Strand und habe noch ein paar Sound-Samples gesammelt.",
          "next": [
            202430001
          ]
        },
        "202430001": {
          "id": 202430001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wie Kokosnüsse, die über den Boden rollen, zischende und blubbernde Limonade, Tintenfisch, der auf einer heißen Platte brutzelt ...",
          "next": [
            202430002
          ]
        },
        "202430002": {
          "id": 202430002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202430003,
            202430005
          ]
        },
        "202430003": {
          "id": 202430003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jetzt habe ich Hunger. Ich könnte zwei Tintenfischspieße vertragen.",
          "next": [
            202430004
          ]
        },
        "202430004": {
          "id": 202430004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ehrlich gesagt, ich auch ...",
          "next": [
            202430006
          ]
        },
        "202430005": {
          "id": 202430005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Diese Musik riecht so gut ... Ich meine, dieser Tintenfisch klingt fantastisch.",
          "next": [
            202430006
          ]
        },
        "202430006": {
          "id": 202430006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, im Vergleich zu der Leere im Kopf, wenn mir die Inspiration fehlt, weckt mich dieser Geschmackskick so richtig auf.",
          "next": [
            202430007
          ]
        },
        "202430007": {
          "id": 202430007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Eigentlich habe ich noch ein paar andere Soundclips mit Strand-Vibe. Hier, bitte.",
          "next": [
            202430008
          ]
        },
        "202430008": {
          "id": 202430008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das hier ist, wenn sich die Flut zurückzieht: schhhh-schalala — gluck-gluck-gluck-gluck.",
          "next": [
            202430009
          ]
        },
        "202430009": {
          "id": 202430009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert (Knarrstimme erkannt)",
          "next": [
            202430010
          ]
        },
        "202430010": {
          "id": 202430010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wenn die Meeresbrise durch einen rostigen Anker weht: wusch – humm – wusch – humm –",
          "next": [
            202430011
          ]
        },
        "202430011": {
          "id": 202430011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert (tiefe Stimme erkannt)",
          "next": [
            202430012
          ]
        },
        "202430012": {
          "id": 202430012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Vorbeifliegende Möwen: Wusch — raschel — krächz — krächz — AH!",
          "next": [
            202430013
          ]
        },
        "202430013": {
          "id": 202430013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert (Vogelrufe erkannt)",
          "next": [
            202430014
          ]
        },
        "202430014": {
          "id": 202430014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sorry, dieses „AH!“ war ich ... Eine Möwe hat mir gerade den Snack direkt aus der Hand geschnappt ...",
          "next": [
            202430015
          ]
        },
        "202430015": {
          "id": 202430015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich habe jetzt genug Proben, aber es fühlt sich immer noch an, als würde etwas fehlen ... etwas, das dich direkt in die Seele trifft.",
          "next": [
            202430016
          ]
        },
        "202430016": {
          "id": 202430016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "{NICKNAME}, hast du zufällig ein paar Klanginspirationen, die jemanden sofort aufheitern könnten?",
          "next": [
            202430017,
            202430020,
            202430024
          ]
        },
        "202430017": {
          "id": 202430017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hör dir das Dröhnen des Expresses beim Warp an!",
          "next": [
            202430018
          ]
        },
        "202430018": {
          "id": 202430018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Der Empfänger hat den Anhang „Dröhnen beim Warp.mp3“ erhalten.",
          "next": [
            202430019
          ]
        },
        "202430019": {
          "id": 202430019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Die Stimme des Trailblaze trifft wirklich etwas tief im Herzen.",
          "next": [
            202430027
          ]
        },
        "202430020": {
          "id": 202430020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hör dir den Weckruf an!",
          "next": [
            202430021
          ]
        },
        "202430021": {
          "id": 202430021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Der Empfänger hat den Anhang „Weckruf.mp3“ erhalten.",
          "next": [
            202430022
          ]
        },
        "202430022": {
          "id": 202430022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mini-Herzinfarkt ... Das ist wohl eine Art, jemanden direkt in der Seele zu treffen, schätze ich.",
          "next": [
            202430023
          ]
        },
        "202430023": {
          "id": 202430023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Aber zum Wohle unserer Zuhörer sollte ich besser eine Oktave tiefer gehen.",
          "next": [
            202430027
          ]
        },
        "202430024": {
          "id": 202430024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hör dir meinen gefühlvollen Gesang an!",
          "next": [
            202430025
          ]
        },
        "202430025": {
          "id": 202430025,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Der Empfänger hat den Anhang „Singen unter der Dusche.mp3“ erhalten.",
          "next": [
            202430026
          ]
        },
        "202430026": {
          "id": 202430026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ist das dein Gesang? Definitiv ... Trifft direkt in die Seele!",
          "next": [
            202430027
          ]
        },
        "202430027": {
          "id": 202430027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hmm ... Ich glaube, ich kann versuchen, das zusammenzumischen!",
          "next": [
            202430028
          ]
        },
        "202430028": {
          "id": 202430028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wing it now! Cast aside the unchanging score. Swing now! We aren't bolted parts anymore ...",
          "next": [
            202430029
          ]
        },
        "202430029": {
          "id": 202430029,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert (Originalstimme erkannt)",
          "next": [
            202430030
          ]
        },
        "202430030": {
          "id": 202430030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Der Remix von „Only by Chasing the Wind“. Fühlt sich das mit diesem „die Seele berührenden“ Sample und dem Backing-Track mit Meeresbrise jetzt nicht nach absoluten Sommervibes an?",
          "next": [
            202430031
          ]
        },
        "202430031": {
          "id": 202430031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Oh! Mich hat gerade die Inspiration gepackt. Ich gehe zurück ins Tonstudio.",
          "next": [
            202430032
          ]
        },
        "202430032": {
          "id": 202430032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Danke für all deine wunderbaren Ideen!",
          "next": [
            202430033
          ]
        },
        "202430033": {
          "id": 202430033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
      },
