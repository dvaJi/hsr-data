          ]
        },
        "201980008": {
          "id": 201980008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Selbst jetzt kommt es mir noch wie ein Traum vor.",
          "next": [
            201980009
          ]
        },
        "201980009": {
          "id": 201980009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Dank eurer Bemühungen ist es dieses Mal endlich anders als sonst.",
