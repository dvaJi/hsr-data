            201980010
          ]
        },
        "201980010": {
          "id": 201980010,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1407,
          "image": "PhoneMessagePic_10051",
          "next": [
            201980011
          ]
        },
        "201980011": {
          "id": 201980011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sieh mal, ich habe zwei streunende kleine Chimären adoptiert.",
          "next": [
            201980012
          ]
        },
        "201980012": {
          "id": 201980012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sie sind warm und weich. Es hilft beim Einschlafen, mit ihnen zu kuscheln",
          "next": [
            201980013
          ]
        },
        "201980013": {
          "id": 201980013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Es fühlt sich komplett anders an als mit einem Chimären-Plüschtier.",
          "next": [
            201980014,
            201980016
          ]
        },
        "201980014": {
          "id": 201980014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lass mich mal streicheln!",
          "next": [
            201980015
          ]
        },
        "201980015": {
          "id": 201980015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Jederzeit!",
          "next": [
            201980017
          ]
        },
        "201980016": {
          "id": 201980016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Endlich ist mein Wunsch in Erfüllung gegangen!",
          "next": [
            201980017
          ]
        },
        "201980017": {
          "id": 201980017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Aber ich weiß nicht, wie ich sie nennen soll ...",
          "next": [
            201980018
          ]
        },
        "201980018": {
          "id": 201980018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Was meinst du?",
          "next": [
            201980019,
            201980022,
            201980026
          ]
        },
        "201980019": {
          "id": 201980019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du solltest den einen Caskuchen und den anderen Casflügel nennen.",
          "next": [
            201980020
          ]
        },
        "201980020": {
          "id": 201980020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ja, der eine ist besonnen, der andere lebhaft ...",
          "next": [
            201980021
          ]
        },
        "201980021": {
          "id": 201980021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Es passt perfekt!",
          "next": [
            201980028
          ]
        },
        "201980022": {
          "id": 201980022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Schmeichelei, Gemeinheit.",
          "next": [
            201980023
          ]
        },
        "201980023": {
          "id": 201980023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Lieber ... etwas Schmeichelndes.",
