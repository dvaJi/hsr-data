            201980028
          ]
        },
        "201980028": {
          "id": 201980028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Es wird windig draußen. Zeit, mit ihnen spazieren zu gehen.",
