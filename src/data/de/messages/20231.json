        "202310000": {
          "id": 202310000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du hast eine historische Nachricht. Wird abgerufen ...",
          "next": [
            202310001
          ]
        },
        "202310001": {
          "id": 202310001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Diese Aktualisierungen dauern ewig! Ich mache Blurry_QR_Colt ausfindig und schlage Spin-off-Ideen vor",
          "next": [
            202310002
          ]
        },
        "202310002": {
          "id": 202310002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Mach du dir Notizen! (Du bist doch schließlich der Protagonist, oder?)",
          "next": [
            202310003
          ]
        },
        "202310003": {
          "id": 202310003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Nach einem überwältigenden Sieg bei den Phantasmond-Spielen richtet der Protagonist einen Wunsch an Aha –",
          "next": [
            202310004
          ]
        },
        "202310004": {
          "id": 202310004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Wieder 17 sein und zurück in der Oberschule (Anmerkung: Alter noch offen – der kleine Waschbär sieht ohnehin schon ziemlich jung aus)",
          "next": [
            202310005
          ]
        },
        "202310005": {
          "id": 202310005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Das hier ist nicht einfach irgendein Campus. Es ist der Schauplatz einer regelbasierten Geistergeschichte.",
          "next": [
            202310006
          ]
        },
        "202310006": {
          "id": 202310006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Schiedsrichterin Evanescia ist die erste große Herausforderung des Protagonisten auf dem Campus (und die erste Hilfe nach dem Abschluss)",
          "next": [
            202310007,
            202310008,
            202310009
          ]
        },
        "202310007": {
          "id": 202310007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Evanescia! Bist du noch da? Wo bist du!?",
          "next": [
            202310010
          ]
        },
        "202310008": {
          "id": 202310008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Evanescia! Wo bist du gerade?",
          "next": [
            202310010
          ]
        },
        "202310009": {
          "id": 202310009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin erst 3! Ich habe noch vierzehn Jahre vor mir, bis ich 17 werde!",
          "next": [
            202310010
          ]
        },
        "202310010": {
          "id": 202310010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Nachricht konnte nicht gesendet werden.",
          "next": [
            202310011
          ]
        },
        "202310011": {
          "id": 202310011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Der Benutzer ist nicht erreichbar. Bitte versuche es später erneut.",
          "next": [
            202310012
          ]
        },
        "202310012": {
          "id": 202310012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Schiedsrichterin Evanescia wird nun Regel Nummer eins der Campus-Überlebensgesetze vorstellen. Halte dich bitte unbedingt an sie, nachdem du sie alle gehört hast.",
          "next": [
            202310013
          ]
        },
        "202310013": {
          "id": 202310013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Regel zwei: Jedes Stück Hardware auf dem Campus ist ein kleines Tier. Bitte geh behutsam damit um.",
          "next": [
            202310014
          ]
        },
        "202310014": {
          "id": 202310014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Regel drei: Ärgere besagte kleine Tiere unbedingt (sie plustern sich zu kleinen Fellkugeln auf – so kuschelig für ein Nickerchen).",
          "next": [
            202310015
          ]
        },
        "202310015": {
          "id": 202310015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Regel vier: Der Schiedsrichter ist unparteiisch, wenn er wach ist – keine krummen Dinger.",
          "next": [
            202310016
          ]
        },
        "202310016": {
          "id": 202310016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Regel fünf: Im Schlaf verwandelt sich der Schiedsrichter in einen Papagei, der nur „Mehr Updates“ wiederholen kann.",
          "next": [
            202310017
          ]
        },
        "202310017": {
          "id": 202310017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Regel sechs: (folgt)",
          "next": [
            202310018
          ]
        },
        "202310018": {
          "id": 202310018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1505,
          "text": "Der wahre Schiedsrichter ist bereit, es geht los! Behalte für mich den Überblick, okay?",
          "next": [
            202310019,
            202310021
          ]
        },
        "202310019": {
          "id": 202310019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keine Sorge, ich mache wegen dieser Updates weiter Druck für dich!",
          "next": [
            202310020
          ]
        },
        "202310020": {
          "id": 202310020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich garantiere dir, dass dich nach dem Aufwachen etwas Erstaunliches erwartet!",
          "next": [
            202310023
          ]
        },
        "202310021": {
          "id": 202310021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keine Sorge, ich helfe dir bei der Vorstellung.",
          "next": [
            202310022
          ]
        },
        "202310022": {
          "id": 202310022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich garantiere dir, dass die Handlung der Campus-Geistergeschichten im Kasten ist, bis du aufstehst!",
          "next": [
            202310023
          ]
        },
