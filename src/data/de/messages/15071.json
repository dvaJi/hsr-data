      "messages": {
        "150710100": {
          "id": 150710100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Boss! Wie ist es dir in letzter Zeit ergangen?",
          "next": [
            150710101
          ]
        },
        "150710101": {
          "id": 150710101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ah, tut mir leid. Macht der Gewohnheit, ich habe mein Diensthandy erwischt.",
          "next": [
            150710102
          ]
        },
        "150710102": {
          "id": 150710102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ich bin’s, Furli! Riesenfurbo ist nur mein Künstlername.",
          "next": [
            150710103
          ]
        },
        "150710103": {
          "id": 150710103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ich habe gute Neuigkeiten für dich.",
          "next": [
            150710104
          ]
        },
        "150710104": {
          "id": 150710104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Mein persönliches Filmprojekt hat offiziell grünes Licht bekommen: ein Superhelden-Blockbuster mit dem Titel „Die Melancholie des Riesenfurbos“!",
          "next": [
            150710105,
            150710107
          ]
        },
        "150710105": {
          "id": 150710105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wow, herzlichen Glückwunsch! Auf dass deine Träume in Erfüllung gehen!",
          "next": [
            150710106
          ]
        },
        "150710106": {
          "id": 150710106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Es ist noch zu früh zum Feiern. Wir haben gerade erst mit dem Dreh begonnen.",
          "next": [
            150710110
          ]
        },
        "150710107": {
          "id": 150710107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist großartig!",
          "next": [
            150710108
          ]
        },
        "150710108": {
          "id": 150710108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Eine Sache noch: Kommst du wieder zur Arbeit?",
          "next": [
            150710109
          ]
        },
        "150710109": {
          "id": 150710109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Ich muss erst warten, bis der Film fertig gedreht ist. Wir haben gerade erst mit dem Dreh begonnen.",
          "next": [
            150710110
          ]
        },
        "150710110": {
          "id": 150710110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Oh, dieses Wubbaboo ruft mich, um zu helfen.",
          "next": [
            150710111
          ]
        },
        "150710111": {
          "id": 150710111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 230,
          "text": "Schau jederzeit gerne am Set vorbei, wenn du Zeit hast, Boss!",
          "next": []
        }
      },
