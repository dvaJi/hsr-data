      "messages": {
        "201970000": {
          "id": 201970000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Kremnos’ Mitternachtsimbiss“ wurde gesendet.",
          "next": [
            201970001
          ]
        },
        "201970001": {
          "id": 201970001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Okhema-Brunch-Vorschlag“ wurde gesendet.",
          "next": [
            201970002
          ]
        },
        "201970002": {
          "id": 201970002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Mnestias und Cerces’ kulinarisches Duett“ wurde gesendet.",
          "next": [
            201970003
          ]
        },
        "201970003": {
          "id": 201970003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Aidonias Kochbuch: Wie man Totes lebendig macht“ wurde gesendet.",
          "next": [
            201970004
          ]
        },
        "201970004": {
          "id": 201970004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Janus’ unerschwingliche Geschmacksknospen“ wurde gesendet.",
          "next": [
            201970005
          ]
        },
        "201970005": {
          "id": 201970005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ich will mich selbst herausfordern.",
          "next": [
            201970006
          ]
        },
        "201970006": {
          "id": 201970006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Möchtest du etwas davon?",
          "next": [
            201970007,
            201970008,
            201970010
          ]
        },
        "201970007": {
          "id": 201970007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ja, Herr Koch, ich esse alles.",
          "next": [
            201970012
          ]
        },
        "201970008": {
          "id": 201970008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hey, Herr Koch, kann ich alle Gerichte probieren, die du geschickt hast?",
          "next": [
            201970009
          ]
        },
        "201970009": {
          "id": 201970009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Wenn du es aufessen kannst, gerne doch.",
          "next": [
            201970012
          ]
        },
        "201970010": {
          "id": 201970010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Chefkoch Mydei, übernimm den Wok!",
          "next": [
            201970011
          ]
        },
        "201970011": {
          "id": 201970011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Alles klar.",
          "next": [
            201970012
          ]
        },
        "201970012": {
          "id": 201970012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Fangen wir mit „Kremnos’ Mitternachtsimbiss“ an.",
          "next": [
            201970013
          ]
        },
        "201970013": {
          "id": 201970013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Obwohl ich alle oben genannten Rezepte und Stile ausprobiert habe, ist die kremnosianische Küche definitiv meine Spezialität.",
          "next": [
            201970014,
            201970015,
            201970016
          ]
        },
        "201970014": {
          "id": 201970014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wildherz Tatar?",
          "next": [
            201970017
          ]
        },
        "201970015": {
          "id": 201970015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gegrillte Echsenbeine?",
          "next": [
            201970017
          ]
        },
        "201970016": {
          "id": 201970016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist das sehr deftig?",
          "next": [
            201970017
          ]
        },
        "201970017": {
          "id": 201970017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Anscheinend hast du uns gründlich missverstanden.",
          "next": [
            201970018
          ]
        },
        "201970018": {
          "id": 201970018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Das waren nur Unsitten der alten Kremnosianer, um Krieger zu testen. Ich habe sie längst abgeschafft.",
          "next": [
            201970019
          ]
        },
        "201970019": {
          "id": 201970019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Heutzutage besteht die Küche aus Kremnos aus ausgewogenen und gesunden Mahlzeiten.",
          "next": [
            201970020
          ]
        },
        "201970020": {
          "id": 201970020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Sie hat auch die Vorzüge anderer Küchen absorbiert und eine verbesserte Fusion kreiert.",
          "next": [
            201970021
          ]
        },
        "201970021": {
          "id": 201970021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Hast du bestimmte Geschmacksvorlieben?",
          "next": [
            201970022,
            201970024,
            201970026
          ]
        },
        "201970022": {
          "id": 201970022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich mag deftiges Essen.",
          "next": [
            201970023
          ]
        },
        "201970023": {
          "id": 201970023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Dann nehmen wir geschmorte Wolkenschaf-Rippchen. Dieses Gericht ist perfekt, um den Salzhaushalt aufzufüllen und den Appetit anzuregen. Am besten passt dazu etwas Granatapfelsaft.",
          "next": [
            201970031
          ]
        },
        "201970024": {
          "id": 201970024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich würde gerne etwas Normales essen.",
          "next": [
            201970025
          ]
        },
        "201970025": {
          "id": 201970025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Püree aus eingelegten Bohnen mit Granatapfel-Honigkuchen ist zu jeder Zeit eine gute Wahl.",
          "next": [
            201970031
          ]
        },
        "201970026": {
          "id": 201970026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich esse nur Dinge, die seltsam schmecken.",
          "next": [
            201970027
          ]
        },
        "201970027": {
          "id": 201970027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Konservenfisch aus dem Meer der Seelen könnte dir zusagen.",
          "next": [
            201970028
          ]
        },
        "201970028": {
          "id": 201970028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Den benutze ich selten zum Kochen.",
          "next": [
            201970029
          ]
        },
        "201970029": {
          "id": 201970029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Oder ich könnte etwas von dem Fleisch holen, das seit über zehn Jahren hier gelagert ist.",
          "next": [
            201970030
          ]
        },
        "201970030": {
          "id": 201970030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Der Geschmack wird dir definitiv in Erinnerung bleiben.",
          "next": [
            201970031
          ]
        },
        "201970031": {
          "id": 201970031,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1404,
          "next": [
            201970032
          ]
        },
        "201970032": {
          "id": 201970032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "In Castrum Kremnos gibt es ein weitverbreitetes Sprichwort: „Ein Soldat, der General werden will, muss zuerst ein ausgezeichneter Koch sein.“",
          "next": [
            201970033
          ]
        },
        "201970033": {
          "id": 201970033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Also, vertrau meinen Koch- und Kombinationskünsten.",
          "next": [
            201970034
          ]
        },
        "201970034": {
          "id": 201970034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1404,
          "text": "Ich wünsche schon einmal einen guten Appetit.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1404
      ]
    }
  ]
}