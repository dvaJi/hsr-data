  "sections": [
    {
      "id": 2025000,
      "startingMessageId": [
        202500000
      ],
      "messages": {
        "202500000": {
          "id": 202500000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Adresse: Pier Point, Interastrale Friedenskorporation, Abteilung für strategische Investitionen, Pearls persönliches Studio, 3. Etage.",
          "next": [
            202500001
          ]
        },
        "202500001": {
          "id": 202500001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "{NICKNAME}, falls der Astralexpress jemals beschädigte oder ausrangierte Gegenstände hat, die ihr als Müll loswerden möchtet, könnt ihr sie gerne an mich schicken. Ich kümmere mich um das Recycling.",
          "next": [
            202500002,
            202500005
          ]
        },
        "202500002": {
          "id": 202500002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist das dein Nebenjob?",
          "next": [
            202500003
          ]
        },
        "202500003": {
          "id": 202500003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ein Nebenjob ist per Definition eine Zweitbeschäftigung mit finanziellem Einkommen, die man in seiner Freizeit außerhalb seines Hauptberufs ausübt.",
          "next": [
            202500004
          ]
        },
        "202500004": {
          "id": 202500004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aber streng genommen besteht mein „Abfall-Recyclingprogramm“ eigentlich darin, dass ich euch bezahle.",
          "next": [
            202500009
          ]
        },
        "202500005": {
          "id": 202500005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Müll? Wo? Kann man Menschen recyceln?",
          "next": [
            202500006
          ]
        },
        "202500006": {
          "id": 202500006,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500007
          ]
        },
        "202500007": {
          "id": 202500007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Technisch gesehen kann auch organisches Leben „umfunktioniert“ werden. Nur liegt der Kostenvoranschlag für diesen Service außerhalb meines Budgets.",
          "next": [
            202500008
          ]
        },
        "202500008": {
          "id": 202500008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aber für alles andere habe ich reichlich Budget fürs Recycling.",
          "next": [
            202500009
          ]
        },
        "202500009": {
          "id": 202500009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du recycelst Müll und sammelst ihn dann?",
          "next": [
            202500010
          ]
        },
        "202500010": {
          "id": 202500010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Es ist ein Schritt vor dem Sammeln. Für mich fühlt sich das Restaurieren alter Gegenstände eher wie eine „spontane mentale Reise“ an.",
          "next": [
            202500011
          ]
        },
        "202500011": {
          "id": 202500011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Während meiner Arbeit an der Welten-Wiederaufbau-Initiative habe ich im Laufe der Jahre so einige herrenlose Relikte restauriert.",
          "next": [
            202500012
          ]
        },
        "202500012": {
          "id": 202500012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Während ich ihre Texturen Stück für Stück zusammensetze, strömen Visionen eines fremden Planeten in meinen Geist: Windspiele, seichte Ufer, Gletscher und unzählige Zivilisationen und Landschaften jenseits jeder Beschreibung.",
          "next": [
            202500013
          ]
        },
        "202500013": {
          "id": 202500013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Danach verliere ich mich meistens für eine ganze Weile in der Arbeit.",
          "next": [
            202500014,
            202500016,
            202500019
          ]
        },
        "202500014": {
          "id": 202500014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie ich dich um dein Hobby beneide ...",
          "next": [
            202500015
          ]
        },
        "202500015": {
          "id": 202500015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das ist praktisch dein Job.",
          "next": [
            202500020
          ]
        },
        "202500016": {
          "id": 202500016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kommt nur her, ihr Workaholics!",
          "next": [
            202500017
          ]
        },
        "202500017": {
          "id": 202500017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Weswegen herkommen? Wegen Bügelperlen?",
          "next": [
            202500018
          ]
        },
        "202500018": {
          "id": 202500018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Nur ein Scherz.",
          "next": [
            202500020
          ]
        },
        "202500019": {
          "id": 202500019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das Leben besteht aus mehr, als nur Dinge zu reparieren. Gönn dir eine Pause. Geh auf Reisen!",
          "next": [
            202500020
          ]
        },
        "202500020": {
          "id": 202500020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Das erinnert mich an eine Frage, die mir die Medien mal gestellt haben: „Wie hältst du die Balance zwischen Arbeit und Privatleben?“",
          "next": [
            202500021
          ]
        },
        "202500021": {
          "id": 202500021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Erstens habe ich vorgeschlagen, stattdessen Louis Fleming zu fragen. Zweitens habe ich geantwortet: „Wie bringt ihr Atmen und Leben in Einklang?“ Da haben sie nicht weiter nachgehakt.",
          "next": [
            202500022
          ]
        },
        "202500022": {
          "id": 202500022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Darüber hinaus ist die Restaurierung beschädigter Gegenstände, die vom Astralexpress ausrangiert oder unterwegs aufgesammelt wurden, an sich schon eine künstlerische Reise in den Geist des Trailblaze.",
          "next": [
            202500023
          ]
        },
        "202500023": {
          "id": 202500023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Oh, und ein Fun-Fact: Perlen im Ozean sind auch eine Form von wiederverwertetem Abfall.",
          "next": [
            202500024
          ]
        },
        "202500024": {
          "id": 202500024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202500025
          ]
        },
        "202500025": {
          "id": 202500025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Diese private Abmachung gilt unbefristet. Ich freue mich darauf, „Reisefunde“ des Astralexpresses zu erhalten.",
          "next": []
        }
      },
      "participatingContactsIds": [
        1503,
        8001
      ]
    }
  ]
}