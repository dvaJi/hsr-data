        "202440004": {
          "id": 202440004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin, wer ist dieser Musik-Influencer Nibor? Ich komme wirklich nicht drauf!",
          "next": [
            202440011
          ]
        },
        "202440005": {
          "id": 202440005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Glückwunsch an mich selbst, dass ich dieses Juwel von einem neuen Influencer entdeckt habe!",
          "next": [
            202440006
          ]
        },
        "202440006": {
          "id": 202440006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Folge jetzt und du bist ein OG-Fan.",
          "next": [
            202440011
          ]
        },
        "202440007": {
          "id": 202440007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nibor Flying Raven? Sonntag hat musikalisch echt was drauf!",
          "next": [
            202440008
          ]
        },
        "202440008": {
          "id": 202440008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Nicht wahr?",
          "next": [
            202440009
          ]
        },
        "202440009": {
          "id": 202440009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Warte, im Ernst? Ist er das wirklich ...?",
          "next": [
            202440010
          ]
        },
        "202440010": {
          "id": 202440010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Also gut, ich höre auf, dich auf den Arm zu nehmen.",
          "next": [
            202440011
          ]
        },
        "202440011": {
          "id": 202440011,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202440012
          ]
        },
        "202440012": {
          "id": 202440012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das ist ein neuer Account, den ich vor Kurzem erstellt habe. Ich habe den Namen gewählt, damit ich nicht erkannt werde.",
          "next": [
            202440013
          ]
        },
        "202440013": {
          "id": 202440013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich will mal ein paar Musikstile ausprobieren, die etwas anders sind als mein üblicher Kram.",
          "next": [
            202440014
          ]
        },
        "202440014": {
          "id": 202440014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mal sehen, seit meinem letzten Update ist jetzt etwa eine Woche vergangen.",
          "next": [
            202440015
          ]
        },
        "202440015": {
          "id": 202440015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich muss mir was fürs nächste Video überlegen. {NICKNAME}, hast du irgendwelche Ideen?",
          "next": [
            202440016,
            202440020,
            202440023
          ]
        },
        "202440016": {
          "id": 202440016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vielleicht eine genreübergreifende Kollaboration mit anderen Influencern?",
          "next": [
            202440017
          ]
        },
        "202440017": {
          "id": 202440017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wie Sparxie aus dem Streaming-Bereich oder die kleine Gui und Sushang aus dem Geisterjagdbereich der Xianzhou.",
          "next": [
            202440018
          ]
        },
        "202440018": {
          "id": 202440018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Hmm ... Das ist eigentlich eine gute Idee!",
          "next": [
            202440019
          ]
        },
        "202440019": {
          "id": 202440019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Vielleicht können wir durch Musik ein paar unerwartete Story-Ideen entfachen.",
          "next": [
            202440026
          ]
        },
        "202440020": {
          "id": 202440020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du könntest Nischen-Musikequipment testen. Zum Beispiel ... Luftballons als Percussion benutzen?",
          "next": [
            202440021
          ]
        },
        "202440021": {
          "id": 202440021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das ist eine witzige Idee! Ich habe tatsächlich mal herausgefunden, dass man einer Karotte ziemlich coole Töne entlocken kann, wenn man sie aushöhlt und ein paar Löcher hineinsticht.",
          "next": [
            202440022
          ]
        },
        "202440022": {
          "id": 202440022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich kann versuchen, mehr „Alltagsgegenstände als Instrumente“ zu entdecken.",
          "next": [
            202440026
          ]
        },
        "202440023": {
          "id": 202440023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du könntest ein Video machen, in dem du Robins Songs auf allen möglichen Instrumenten coverst.",
          "next": [
            202440024
          ]
        },
        "202440024": {
          "id": 202440024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Meine eigene Fankreation erstellen?",
          "next": [
            202440025
          ]
        },
        "202440025": {
          "id": 202440025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das ergibt Sinn. Meinen eigenen Song zu covern, ist auch Teil des kreativen Prozesses.",
          "next": [
            202440026
          ]
        },
        "202440026": {
          "id": 202440026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
