      ],
      "messages": {
        "202290000": {
          "id": 202290000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "<u>Es gibt nur eine Erklärung, und es muss das eine oder das andere sein: Ich hatte „21 Fragen: Sag auf Wiedersehen zu schlampigen Deduktionen“ in nur 0,99 Sekunden fertig und besser abgeschnitten als 99,99 % der Leute in Planarcadia. Versuch’s doch mal selbst!</u>",
          "next": [
            202290001,
            202290003
          ]
        },
        "202290001": {
          "id": 202290001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Moment mal, heißt das, man braucht jetzt Quanten-Schnelllesen-Fähigkeiten, um Bücher zu verkaufen?",
          "next": [
            202290002
          ]
        },
        "202290002": {
          "id": 202290002,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nur zu, ich kann noch schneller!",
          "next": [
            202290005
          ]
        },
        "202290003": {
          "id": 202290003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist das etwa ein Auftrag, um Bücher zu verkaufen?",
          "next": [
            202290004
          ]
        },
        "202290004": {
          "id": 202290004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Komm schon, du hast keine Chance gegen mich!",
          "next": [
            202290005
          ]
        },
        "202290005": {
          "id": 202290005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Vorabzugang-Frage 1:",
          "next": [
            202290006
          ]
        },
        "202290006": {
          "id": 202290006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "„Spät in der Nacht suchte das Opfer in der Küche nach Essen, als plötzlich ein lauter Knall ertönte und es auf der Stelle getötet wurde.“ Nun rekonstruiere bitte den Tatort ...",
          "next": [
            202290007,
            202290012,
            202290017
          ]
        },
        "202290007": {
          "id": 202290007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ein hungriges Opfer schlich sich in die Küche eines anderen, um einen Happen zu essen, und lief direkt dem Hausbesitzer in die Arme, der das Geräusch gehört hatte und ihn umgehauen hat.",
          "next": [
            202290008
          ]
        },
        "202290008": {
          "id": 202290008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hmm, klingt nach einem völlig normalen Einbruch. Aber du scheinst einen entscheidenden Hinweis übersehen zu haben: den lauten Knall.",
          "next": [
            202290009
          ]
        },
        "202290009": {
          "id": 202290009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Warum hat’s einen „Knall“ gegeben und kein „Ah!“?",
          "next": [
            202290010
          ]
        },
        "202290010": {
          "id": 202290010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Die Antwort ist ...",
          "next": [
            202290011
          ]
        },
        "202290011": {
          "id": 202290011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Das Opfer war eine Kakerlake.",
          "next": [
            202290021
          ]
        },
        "202290012": {
          "id": 202290012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Der Hausbesitzer verhungerte. In seiner Verzweiflung aß er verdorbenes Essen und starb, wobei er mit einem lauten Knall zu Boden fiel.",
          "next": [
            202290013
          ]
        },
        "202290013": {
          "id": 202290013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Es sieht nach Mord aus, stellt sich aber als Unfall heraus. Netter Twist in deinem Denken. Leider liegst du daneben.",
          "next": [
            202290014
          ]
        },
        "202290014": {
          "id": 202290014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Die Leute werden zu jeder Tageszeit hungrig und können essen, wann immer sie wollen. Der Schlüssel zu dieser Frage liegt in „spät in der Nacht“.",
          "next": [
            202290015
          ]
        },
        "202290015": {
          "id": 202290015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Die Antwort ist ...",
          "next": [
            202290016
          ]
        },
        "202290016": {
          "id": 202290016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Das Opfer war eine Kakerlake.",
          "next": [
            202290021
          ]
        },
        "202290017": {
          "id": 202290017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Spät in der Nacht ... Küche ... Essen ... und ein lauter Knall ...",
          "next": [
            202290018
          ]
        },
        "202290018": {
          "id": 202290018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das Opfer war eine Kakerlake.",
          "next": [
            202290019
          ]
        },
        "202290019": {
          "id": 202290019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich habe einfach nur ins Blaue geraten.",
          "next": [
            202290020
          ]
        },
        "202290020": {
          "id": 202290020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, was für ein genialer Detektiv!",
          "next": [
            202290021
          ]
        },
        "202290021": {
          "id": 202290021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Die meisten Fälle, die ich knacke, sind ähnlich. Im Nachhinein sind sie total logisch, aber auf den ersten Blick völlig unerwartet.",
          "next": [
            202290022
          ]
        },
        "202290022": {
          "id": 202290022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Also, wie wär’s mit einem professionellen Deduktionshandbuch? Willst du wirklich keins?",
          "next": [
            202290023
          ]
        },
        "202290023": {
          "id": 202290023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hier ist noch einer für dich: „Das Opfer war spazieren, als es auf etwas Langes und Grünes traf und bei einem Unfall starb.“ Nun rekonstruiere bitte den Tatort ...",
          "next": [
            202290024
          ]
        },
        "202290024": {
          "id": 202290024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Äh ... warte mal kurz.",
          "next": [
            202290025
          ]
        },
        "202290025": {
          "id": 202290025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hoppla, habe aus Versehen ein Rätselbuch erwischt.",
          "next": [
            202290026
          ]
        },
        "202290026": {
          "id": 202290026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es ist wohl auch eine Art Deduktionsbuch. Ob du daraus wirklich etwas lernen kannst, ist eine andere Frage.",
          "next": [
            202290027
          ]
        },
        "202290027": {
          "id": 202290027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Keine Sorge.",
          "next": [
            202290028
          ]
        },
        "202290028": {
          "id": 202290028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Das steht auch auf meiner Auftragsliste.",
          "next": [
            202290029
          ]
        },
        "202290029": {
          "id": 202290029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "<u>Für alle von 9 bis 999 Jahren: Ich hatte diese „Denksportaufgabe“ in nur 0,99 Sekunden fertig und besser abgeschnitten als 99,99 % der Leute in Planarcadia. Versuch’s doch mal selbst!</u>",
          "next": [
            202290030
          ]
        },
