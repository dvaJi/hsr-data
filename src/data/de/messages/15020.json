          ]
        },
        "150200102": {
          "id": 150200102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 211,
          "text": "Du warst es, der mich herausgefordert hat, und jetzt weichst du ständig unserem Duell aus?",
