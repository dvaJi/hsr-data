  "sections": [
    {
      "id": 2022500,
      "startingMessageId": [
        202250000
      ],
      "messages": {
        "202250000": {
          "id": 202250000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ich habe es erst gemerkt, als ich nachgezählt habe ... Meine Siegesserie am Kartentisch liegt bei 888 Spielen.",
          "next": [
            202250001
          ]
        },
        "202250001": {
          "id": 202250001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Diesen glücklichen Moment nutze ich, um meinen Glückszug zu bewerben und gleichzeitig eine Siegesserie von über tausend Spielen zu feiern.",
          "next": [
            202250002
          ]
        },
        "202250002": {
          "id": 202250002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Natürlich machen wir unsere eigenen Pläne und ziehen sie durch. Dieser Zug ist nicht in Stein gemeißelt. Das Wichtigste ist, dass wir Spaß haben!",
          "next": [
            202250003
          ]
        },
        "202250003": {
          "id": 202250003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wenn du komplett verloren bist, kannst du es ja auch einfach versuchen!",
          "next": [
            202250004,
            202250007
          ]
        },
        "202250004": {
          "id": 202250004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das übernehme ich!",
          "next": [
            202250005
          ]
        },
        "202250005": {
          "id": 202250005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bring mir bei, wie man beim Kartenspielen gewinnt!",
          "next": [
            202250006
          ]
        },
        "202250006": {
          "id": 202250006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Denke größer! Dieser Glücksboost lässt sich bei allen möglichen Spielen anwenden.",
          "next": [
            202250010
          ]
        },
        "202250007": {
          "id": 202250007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aber ich war noch nie gut in Kartenspielen.",
          "next": [
            202250008
          ]
        },
        "202250008": {
          "id": 202250008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Denke größer! Dieser Glücksboost lässt sich bei allen möglichen Spielen anwenden.",
          "next": [
            202250009
          ]
        },
        "202250009": {
          "id": 202250009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das übernehme ich!",
          "next": [
            202250010
          ]
        },
        "202250010": {
          "id": 202250010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ob beim Spielen oder beim Ziehen von Preisen: Achte darauf, dass du nicht mit dem Rücken zu scharfen Gegenständen oder Türen und Fenstern sitzt, da diese Positionen negative Energie ansammeln und Wohlstand entweichen lassen.",
          "next": [
            202250011
          ]
        },
        "202250011": {
          "id": 202250011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Iss reichlich Eintopf, Auberginen, Birnen und Tomaten. Je mehr du isst, desto mehr Glück wirst du haben.",
          "next": [
            202250012
          ]
        },
        "202250012": {
          "id": 202250012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Außerdem: Glückszahl, Glückszeit und Glücksobjekt ... Wenn du deine Augen offen hältst, kann nichts schiefgehen.",
          "next": [
            202250013
          ]
        },
        "202250013": {
          "id": 202250013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Oh, und hier ein Tipp, der leicht zu übersehen ist: Achte besonders auf Gegenstände in deiner Umgebung, die einen gemeinsamen Klang mit dem Wort „verlieren“ oder „ausrutschen“ haben.",
          "next": [
            202250014
          ]
        },
        "202250014": {
          "id": 202250014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ich hatte mal einen Kartenkumpel, der fünf Spiele in Folge verloren hat. In seinem verzweifelten Durst griff er zu einem Glas Flutschen-Saft und stellte damit einen persönlichen Rekord von fünfzig aufeinanderfolgenden Niederlagen auf.",
          "next": [
            202250015,
            202250018
          ]
        },
        "202250015": {
          "id": 202250015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich werde es im Hinterkopf behalten.",
          "next": [
            202250016
          ]
        },
        "202250016": {
          "id": 202250016,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wünsch mir Glück beim Ziehen von 5-Sterne-Figuren, beim Ergattern limitierter Fan-Artikel und beim Öffnen von Überraschungsboxen der Sammleredition!",
          "next": [
            202250017
          ]
        },
        "202250017": {
          "id": 202250017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Scharfsinnig wie immer.",
          "next": [
            202250021
          ]
        },
        "202250018": {
          "id": 202250018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Flutschen-Saft? Was soll das denn sein?",
          "next": [
            202250019
          ]
        },
        "202250019": {
          "id": 202250019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sag bloß nicht, das war dein Werk, Madame Yao?",
          "next": [
            202250020
          ]
        },
        "202250020": {
          "id": 202250020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "So schamlos bin ich nun auch wieder nicht!",
          "next": [
            202250021
          ]
        },
        "202250021": {
          "id": 202250021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Zeit für meinen ultimativen Zug, die sechs heiligen Worte der Wahrheit ...",
          "next": [
            202250022
          ]
        },
        "202250022": {
          "id": 202250022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Hau ab, wenn es brenzlig wird.",
          "next": [
            202250023
          ]
        },
        "202250023": {
          "id": 202250023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Das ist der wahre Weg, Unglück zu vermeiden. Verstanden?",
          "next": [
            202250024
          ]
        },
        "202250024": {
          "id": 202250024,
          "type": "Sticker",
