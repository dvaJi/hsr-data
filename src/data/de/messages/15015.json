      "messages": {
        "150150100": {
          "id": 150150100,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asta, ich habe Peppy in der Nähe des @Tors von Planarcadia gesehen, aber ...",
          "next": [
            150150102
          ]
        },
        "150150101": {
          "id": 150150101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Asta! Komm schnell zum @Tor von Planarcadia! Peppy steckt in großen Schwierigkeiten!",
          "next": [
            150150102
          ]
        },
        "150150102": {
          "id": 150150102,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Es sieht aus, als wäre er fast tot!",
          "next": [
            150150103,
            150150105
          ]
        },
        "150150103": {
          "id": 150150103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bitte, bitte, antworte mir schnell!",
          "next": [
            150150104
          ]
        },
        "150150104": {
          "id": 150150104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Lass mich wenigstens sichergehen, dass es dir gut geht!",
          "next": [
            150150107
          ]
        },
        "150150105": {
          "id": 150150105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Warum antwortest du nicht auf meine Nachrichten?",
          "next": [
            150150106
          ]
        },
        "150150106": {
          "id": 150150106,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Dir ist doch etwa nicht auch etwas passiert?",
          "next": [
            150150107
          ]
        },
        "150150107": {
          "id": 150150107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1009,
          "text": "Peppy? Tut mir leid, ich bin gerade in Planarcadia beim Einkaufen und habe die Hände voll, deshalb kann ich dir nur eine Sprachnachricht schicken. Peppy ist wahrscheinlich weggelaufen, als ich nicht aufgepasst habe. Ich überprüfe mal kurz sein Ortungssystem.",
          "next": [
            150150108
          ]
        },
        "150150108": {
          "id": 150150108,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            150150109
          ]
        },
        "150150109": {
          "id": 150150109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1009,
          "text": "Peppys Vitalwerte sind normal, und er bewegt sich ... ach, er nähert sich auch dem @Tor. Wenn du ihn siehst, kümmerst du dich bitte für mich darum – nicht drauftreten, das ist ein maßgeschneidertes Kleid von Frau Herta!",
          "next": [
            150150110
          ]
        },
        "150150110": {
          "id": 150150110,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            150150111
          ]
        },
        "150150111": {
          "id": 150150111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1009,
          "text": "Danke für deine Mühe, ich werde seinen Standort ständig im Auge behalten. Sobald ich hier fertig bin, komme ich sofort zu euch!",
          "next": [
            150150112
          ]
        },
