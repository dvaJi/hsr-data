        },
        "202030008": {
          "id": 202030008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Der Kleine Ika ist vor den Fotostein gelaufen! Jetzt halte ich ihn fest.",
          "next": [
            202030009
          ]
        },
        "202030009": {
          "id": 202030009,
          "type": "Image",
          "sender": "NPC",
          "senderContactId": 1409,
          "image": "PhoneMessagePic_10053",
          "next": [
            202030010
          ]
        },
        "202030010": {
          "id": 202030010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Ach, der kleine Vogel ist weggeflogen ... Fast hätte ich ihn im Kasten gehabt!",
          "next": [
            202030011
          ]
        },
        "202030011": {
          "id": 202030011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Seine Federn sind tiefblau und von Weitem sieht es aus, als würde er leuchten! Wirklich wunderschön.",
          "next": [
            202030012
          ]
        },
        "202030012": {
          "id": 202030012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Als er gerade über die Wasseroberfläche glitt, glich er einem sanften Blitz, und die aufspritzenden Wassertropfen funkelten wie Sterne.",
          "next": [
            202030013
          ]
        },
        "202030013": {
          "id": 202030013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Schade, dass ich es nicht mit dir teilen konnte.",
          "next": [
            202030014,
            202030016,
            202030018
          ]
        },
        "202030014": {
          "id": 202030014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Aber ich habe den Himmel gesehen, und der war auch wunderschön.",
          "next": [
            202030015
          ]
        },
        "202030015": {
          "id": 202030015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Grey ist so sanftmütig wie eh und je.",
          "next": [
            202030020
          ]
        },
        "202030016": {
          "id": 202030016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich kann es schon vor mir sehen! Deine Beschreibung ist echt bildhaft.",
          "next": [
            202030017
          ]
        },
        "202030017": {
          "id": 202030017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Grey ist so sanftmütig wie eh und je.",
          "next": [
            202030020
          ]
        },
        "202030018": {
          "id": 202030018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lass den Kleinen Ika einen sanften Blitz vorführen!",
          "next": [
            202030019
          ]
        },
        "202030019": {
          "id": 202030019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Haha, woher weißt du, dass es sich schon wieder kaum zurückhalten kann?",
          "next": [
            202030020
          ]
        },
        "202030020": {
          "id": 202030020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Wenn du das nächste Mal nach Amphoreus zurückkehrst, lass uns wieder zusammen hingehen.",
          "next": [
            202030021
          ]
        },
        "202030021": {
          "id": 202030021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Erfasse es mit deinen Augen, lass dir keinen Vogel und keine Landschaft entgehen.",
          "next": [
            202030022,
            202030023,
            202030024
          ]
        },
        "202030022": {
          "id": 202030022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gut! Abgemacht!",
          "next": [
