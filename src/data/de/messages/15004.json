      "messages": {
        "150040101": {
          "id": 150040101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "@{NICKNAME}, @7. März, geht es euch gut?",
          "next": [
            150040103
          ]
        },
        "150040102": {
          "id": 150040102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "@{NICKNAME}, @7. März, geht es euch gut?",
          "next": [
            150040103
          ]
        },
        "150040103": {
          "id": 150040103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich habe gehört, ihr zwei hattet ein paar Probleme.",
          "next": [
            150040104
          ]
        },
        "150040104": {
          "id": 150040104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Was ist los?",
          "next": [
            150040105
          ]
        },
        "150040105": {
          "id": 150040105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Uns beiden geht es gut, aber wir sind beim Einkaufen auf jemanden namens Sparxie getroffen.",
          "next": [
            150040106
          ]
        },
        "150040106": {
          "id": 150040106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Sie hat verkündet, dass sie {NICKNAME} und mich fertig machen und die Express-Besatzung von den Phantasmond-Spielen ausschließen wird.",
          "next": [
            150040107
          ]
        },
        "150040107": {
          "id": 150040107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Wir gehen also besser, aber ein bisschen dalli!",
          "next": [
            150040108
          ]
        },
        "150040108": {
          "id": 150040108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Also, habt ihr euch alle entschieden?",
          "next": [
            150040109
          ]
        },
        "150040109": {
          "id": 150040109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ich habe da ein paar Ideen, weiß aber nicht, was {NICKNAME} davon hält.",
          "next": [
            150040110
          ]
        },
        "150040110": {
          "id": 150040110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Ich möchte an den Phantasmond-Spielen teilnehmen.",
          "next": [
            150040111
          ]
        },
        "150040111": {
          "id": 150040111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Ich habe die ganze Zeit darüber nachgedacht, was ich mit dieser Macht anstellen würde, wenn ich gewinne, oder was ich Aha für mich tun lassen könnte.",
          "next": [
            150040112
          ]
        },
        "150040112": {
          "id": 150040112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 8000,
          "text": "Wenn ich Zeit habe, erzähle ich euch alles im Detail.",
          "next": [
            150040113
          ]
        },
        "150040113": {
          "id": 150040113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie läuft’s bei dir, @Dan Heng?",
          "next": [
            150040114
          ]
        },
        "150040114": {
          "id": 150040114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Ich habe Kontakt mit den Gesandten aus Xianzhou aufgenommen, aber sie hatten einige Probleme und bitten um Hilfe.",
          "next": [
            150040115
          ]
        },
        "150040115": {
          "id": 150040115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sonntag und ich sind unterwegs.",
          "next": [
            150040116
          ]
        },
        "150040116": {
          "id": 150040116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Sag Bescheid, wenn du etwas brauchst.",
          "next": [
            150040117
          ]
        },
        "150040117": {
          "id": 150040117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Also, Himeko, was machen wir als Nächstes?",
          "next": [
            150040118
          ]
        },
        "150040118": {
          "id": 150040118,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Begebt euch bitte zur Graphia-Akademie, meiner Alma Mater.",
          "next": [
            150040119
          ]
        },
        "150040119": {
          "id": 150040119,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "„Standort der Graphia-Akademie“",
          "next": [
            150040120
          ]
        },
        "150040120": {
          "id": 150040120,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "An dieser Schule gab es eine Lehrerin namens Dollie.",
          "next": [
            150040121
          ]
        },
        "150040121": {
          "id": 150040121,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Sie ist meine Freundin und bewahrt die für die Phantasmond-Spiele benötigte Maske auf.",
          "next": [
            150040122
          ]
        },
        "150040122": {
          "id": 150040122,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Um Komplikationen zu vermeiden, geht zuerst zu ihr und holt euch die Maske.",
          "next": [
            150040123
          ]
        },
        "150040123": {
          "id": 150040123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Dann los.",
          "next": [
            150040124
          ]
        },
        "150040124": {
          "id": 150040124,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Welt und ich werden euch treffen.",
          "next": []
        }
      },
