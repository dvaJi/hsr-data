      "messages": {
        "150970100": {
          "id": 150970100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Hallo!",
          "next": [
            150970101
          ]
        },
        "150970101": {
          "id": 150970101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "I... Ist da jemand? Na ja, ich gehe einfach mal davon aus.",
          "next": [
            150970102
          ]
        },
        "150970102": {
          "id": 150970102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Du hast eine neue Nachricht.",
          "next": [
            150970103
          ]
        },
        "150970103": {
          "id": 150970103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "„Danke, dass du die Kleinen zurückgebracht hast! Sie haben ein Dankesgeschenk für dich vorbereitet. Komm bei der Geheimbasis der besten Freunde vorbei, wenn du Zeit hast, um es abzuholen!“",
          "next": [
            150970104
          ]
        },
        "150970104": {
          "id": 150970104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "„Oh, und noch was! Ich habe auch ein kleines Geschenk für dich in Duomension City hinterlassen. Wo genau es ist ...“",
          "next": [
            150970106
          ]
        },
        "150970105": {
          "id": 150970105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "Ja, das ist der Plan! Ich warte dort drüben auf dich.",
          "next": []
        },
        "150970106": {
          "id": 150970106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "1. Irgendwo, wo du den Phantasmond sehen kannst!",
          "next": [
            150970107
          ]
        },
        "150970107": {
          "id": 150970107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "2. An einem wirklich hoch gelegenen Ort!",
          "next": [
            150970108
          ]
        },
        "150970108": {
          "id": 150970108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "3. An einem Ort unter deinen Füßen, an dem sich eine Metallkiste bewegt!",
          "next": [
            150970109
          ]
        },
        "150970109": {
          "id": 150970109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 244,
          "text": "„Das sind alle Hinweise. Geh und finde es!“",
          "next": [
            150970105
          ]
        }
      },
      "participatingContactsIds": [
        244
      ]
    }
  ]
}