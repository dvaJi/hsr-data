      "messages": {
        "202450000": {
          "id": 202450000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Vögelchens Mittagessen heute: Mais, Quinoa und Erbsenpüree (vergiss nicht, Wasser zu trinken!)",
          "next": [
            202450001,
            202450002
          ]
        },
        "202450001": {
          "id": 202450001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ganz schön viel Grünzeug. Da drin ist überhaupt kein Fleisch.",
          "next": [
            202450003
          ]
        },
        "202450002": {
          "id": 202450002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das isst du also, um deine Stimme zu pflegen? Ganz schön akribisch. Kein Wunder, dass du so ein großer Star bist!",
          "next": [
            202450003
          ]
        },
        "202450003": {
          "id": 202450003,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": [
            202450004
          ]
        },
        "202450004": {
          "id": 202450004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sorry! Ich wollte das an mich schicken, aber ich habe den falschen Chat erwischt.",
          "next": [
            202450005
          ]
        },
        "202450005": {
          "id": 202450005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Weißt du noch, als ich dir erzählt habe, dass ich ein kleines Vogelküken mit einem gebrochenen Flügel gefunden habe?",
          "next": [
            202450006
          ]
        },
        "202450006": {
          "id": 202450006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Das Rezept ist nicht für mich. Ich habe es für das kleine Vögelchen gemacht.",
          "next": [
            202450007
          ]
        },
        "202450007": {
          "id": 202450007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Jetzt ist wieder alles gut und seine Federn sind nachgewachsen.",
          "next": [
            202450008
          ]
        },
        "202450008": {
          "id": 202450008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich bin fast zu Hause. Willst du sehen, wie es ihm jetzt geht?",
          "next": [
            202450009,
            202450010
          ]
        },
        "202450009": {
          "id": 202450009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin und Vögelchen. Aww, das ist so süß!",
          "next": [
            202450011
          ]
        },
        "202450010": {
          "id": 202450010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das kleine Vögelchen, das du aufgezogen hast, muss mittlerweile ein richtiges kleines Pummelchen sein!",
          "next": [
            202450011
          ]
        },
        "202450011": {
          "id": 202450011,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Deine Freundin Robin ist offline.",
          "next": [
            202450012
          ]
        },
        "202450012": {
          "id": 202450012,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Deine Freundin Robin ist online.",
          "next": [
            202450013
          ]
        },
        "202450013": {
          "id": 202450013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202450014
          ]
        },
        "202450014": {
          "id": 202450014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich bin zu Hause, aber der kleine Vogel ist weg.",
          "next": [
            202450015
          ]
        },
        "202450015": {
          "id": 202450015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Er muss durch das offene Fenster rausgeflogen sein.",
          "next": [
            202450016,
            202450019,
            202450021
          ]
        },
        "202450016": {
          "id": 202450016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ah ... Sei nicht traurig. Vielleicht ist er jetzt einfach flügge.",
          "next": [
            202450017
          ]
        },
        "202450017": {
          "id": 202450017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Danke für den Trost. Ich hatte denselben Gedanken.",
          "next": [
            202450018
          ]
        },
        "202450018": {
          "id": 202450018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich habe mich auf den Tag gefreut, an dem er wieder frei fliegen kann.",
          "next": [
            202450023
          ]
        },
        "202450019": {
          "id": 202450019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Auch wenn es etwas plötzlich kam ... Du hast doch auch darauf gewartet, dass er wieder in den Himmel aufsteigt, oder?",
          "next": [
            202450020
          ]
        },
        "202450020": {
          "id": 202450020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mm, ich wusste, du würdest es verstehen.",
          "next": [
            202450023
          ]
        },
        "202450021": {
          "id": 202450021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Der kleine Vogel beginnt sein neues Leben und Abenteuer! Er wird dich niemals vergessen.",
          "next": [
            202450022
          ]
        },
        "202450022": {
          "id": 202450022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Japp! Ich habe mich tatsächlich schon auf den Tag gefreut, an dem er wieder frei fliegen kann.",
          "next": [
            202450023
          ]
        },
        "202450023": {
          "id": 202450023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Er flatterte früher ständig auf das Fensterbrett und blickte in die Welt hinaus. Ich schätze, dieses Mal war er endlich bereit.",
          "next": [
            202450024
          ]
        },
        "202450024": {
          "id": 202450024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Schade nur, dass ich nicht sehen konnte, wie er seine Flügel ausbreitet und abhebt.",
          "next": [
            202450025
          ]
        },
        "202450025": {
          "id": 202450025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Tschiep, tschiep! Schuhu, schuhu! Piep, piep!",
          "next": [
            202450026
          ]
        },
        "202450026": {
          "id": 202450026,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert (freie hohe Töne erkannt)",
          "next": [
            202450027
          ]
        },
        "202450027": {
          "id": 202450027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Haha, das sind die drei kleinen Musiker neben mir.",
          "next": [
            202450028
          ]
        },
        "202450028": {
          "id": 202450028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Sie sagen, der Vogel muss wunderschön ausgesehen haben, als er davongeflogen ist.",
          "next": [
            202450029
          ]
        },
        "202450029": {
          "id": 202450029,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1309,
          "next": []
        }
