        "150370116": {
          "id": 150370116,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich habe wirklich keine Zeit für diesen Quatsch! Verbinde mich mit einem Mitarbeiter, und zwar sofort!",
