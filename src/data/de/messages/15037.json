            150370114,
            150370116
          ]
        },
        "150370114": {
          "id": 150370114,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eine hundertjährige Sperre? An den wievielten Spielen darf ich dann wieder teilnehmen? Ihr müsst mir einen Grund nennen!",
