            150370117
          ]
        },
        "150370117": {
          "id": 150370117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Es tut uns überhaupt nicht leid, dir mitteilen zu müssen, dass der menschliche Kundenservice gerade beschäftigt ist. Bitte warte einen Moment ...",
