        "150370112": {
          "id": 150370112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Warnung: Nach erneuter Prüfung wurde festgestellt, dass du die Teilnahmestandards für die Phantasmond-Spiele nicht erfüllst. Deine Waschbärmaske wurde gesperrt.",
          "next": [
            150370113
