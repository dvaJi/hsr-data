        },
        "150370113": {
          "id": 150370113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 219,
          "text": "Aktueller Status: Arcadia-Kalender 25.03.2099 10:00 Uhr. Sperre aufhebbar.",
