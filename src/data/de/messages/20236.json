      ],
      "messages": {
        "202360000": {
          "id": 202360000,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Die Version des Plug-ins „Blade-Aufspürer“ wurde für dich aktualisiert.",
          "next": [
            202360001
          ]
        },
        "202360001": {
          "id": 202360001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Das ist neu: Bestimmte bekannte Probleme wurden behoben und eine vibrationsreduzierende Funktion hinzugefügt.",
          "next": [
            202360002,
            202360003
          ]
        },
        "202360002": {
          "id": 202360002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wow, das ging schnell. Sogar schneller als das Spielupdate.",
          "next": [
            202360004
          ]
        },
        "202360003": {
          "id": 202360003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie ist die Vibrationsreduktion? Lass mich mal probieren.",
          "next": [
            202360004
          ]
        },
        "202360004": {
          "id": 202360004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du hast eine Nachricht gesendet, Blades Handy angestupst und es einmal vibrieren lassen.",
          "next": [
            202360005
          ]
        },
        "202360005": {
          "id": 202360005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du hast Blades Handy angestupst und es einmal vibrieren lassen.",
          "next": [
            202360006
          ]
        },
        "202360006": {
          "id": 202360006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Blade ist jetzt online.",
          "next": [
            202360007
          ]
        },
        "202360007": {
          "id": 202360007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Pssst. Sei leise.",
          "next": [
            202360008
          ]
        },
        "202360008": {
          "id": 202360008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich beobachte die Monitore. Was ist es dieses Mal?",
          "next": [
            202360009,
            202360010,
            202360011
          ]
        },
        "202360009": {
          "id": 202360009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Betreibst du gerade intensive Personenverfolgung auf den Überwachungskameras?",
          "next": [
            202360013
          ]
        },
        "202360010": {
          "id": 202360010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wieder auf einer Mission? Betreibst du gerade intensive Personenverfolgung auf den Überwachungskameras?",
          "next": [
            202360013
          ]
        },
        "202360011": {
          "id": 202360011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keine Sorge, ich schicke keine Sprachnachrichten.",
          "next": [
            202360012
          ]
        },
        "202360012": {
          "id": 202360012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was siehst du dir auf den Monitoren an? Verfolgst du die Leute auf den Überwachungskameras intensiv?",
          "next": [
            202360013
          ]
        },
        "202360013": {
          "id": 202360013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Nein.",
          "next": [
            202360014
          ]
        },
        "202360014": {
          "id": 202360014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360015
          ]
        },
        "202360015": {
          "id": 202360015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360016
          ]
        },
        "202360016": {
          "id": 202360016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360017
          ]
        },
        "202360017": {
          "id": 202360017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich sehe mir die Überwachungsaufnahmen von Katzenkuchen an.",
          "next": [
            202360018,
            202360020,
            202360022
          ]
        },
        "202360018": {
          "id": 202360018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wirfst du einen Blick auf die Sesampastete?",
          "next": [
            202360019
          ]
        },
        "202360019": {
          "id": 202360019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mhmm.",
          "next": [
            202360025
          ]
        },
        "202360020": {
          "id": 202360020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie lange spionierst du Katzenkuchen schon hinterher?",
          "next": [
            202360021
          ]
        },
        "202360021": {
          "id": 202360021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich habe nicht auf die Zeit geachtet.",
          "next": [
            202360025
          ]
        },
        "202360022": {
          "id": 202360022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh, Katzenkuchen! Das hättest du doch gleich sagen können!",
          "next": [
            202360023
          ]
        },
        "202360023": {
          "id": 202360023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nächstes Mal nehme ich dich direkt mit hinein.",
          "next": [
            202360024
          ]
        },
        "202360024": {
          "id": 202360024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Okay, dann eben beim nächsten Mal.",
          "next": [
            202360025
          ]
        },
        "202360025": {
          "id": 202360025,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was hast du auf den Monitoren gesehen? Geht es Sesampastete gut?",
          "next": [
            202360026
          ]
        },
        "202360026": {
          "id": 202360026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sie hat zwei neue Freunde gefunden.",
          "next": [
            202360027
          ]
        },
        "202360027": {
          "id": 202360027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Der eine ist weiß. Er kann scheinbar nicht stillsitzen, hat ein ziemliches Temperament und redet gern.",
          "next": [
            202360028
          ]
        },
        "202360028": {
          "id": 202360028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Der andere ist rot. Redet nicht viel, hat aber auch ein ganz schönes Temperament.",
          "next": [
            202360029
          ]
        },
        "202360029": {
          "id": 202360029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Na gut. Weißt du, Sesampastete kommt normalerweise allein.",
          "next": [
            202360030,
            202360033
          ]
        },
        "202360030": {
          "id": 202360030,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hast du ihnen Namen gegeben?",
          "next": [
            202360031
          ]
        },
        "202360031": {
          "id": 202360031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich?",
          "next": [
            202360032
          ]
        },
        "202360032": {
          "id": 202360032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Dann nennen wir sie Schneeflocken-Knusper und Rotdattel-Pudding.",
          "next": [
            202360037
          ]
        },
        "202360033": {
          "id": 202360033,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eigentlich sind sie so ein bisschen wie du. Du weißt schon, diese ganze temperamentvolle Art.",
          "next": [
            202360034
          ]
        },
        "202360034": {
          "id": 202360034,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Haben unsere neuen Freunde denn schon Namen bekommen?",
          "next": [
            202360035
          ]
        },
        "202360035": {
          "id": 202360035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Mal überlegen. Gib mir eine Minute.",
          "next": [
            202360036
          ]
        },
        "202360036": {
          "id": 202360036,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Wie wäre es mit Rotdattel-Pudding und Schneeflocken-Knusper?",
          "next": [
            202360037
          ]
        },
        "202360037": {
          "id": 202360037,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360038
          ]
        },
        "202360038": {
          "id": 202360038,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Tja, jetzt kämpfen sie gegeneinander.",
          "next": [
            202360039
          ]
        },
        "202360039": {
          "id": 202360039,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sieht so aus, als wäre ihre Beziehung etwas ... angespannt.",
          "next": [
            202360040
          ]
        },
        "202360040": {
          "id": 202360040,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360041
          ]
        },
        "202360041": {
          "id": 202360041,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Wer hätte das gedacht? Jetzt lecken sie einander ab.",
          "next": [
            202360042
          ]
        },
        "202360042": {
          "id": 202360042,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Es hat sich alles als Missverständnis herausgestellt. Sie kommen gut miteinander aus.",
          "next": [
            202360043
          ]
        },
        "202360043": {
          "id": 202360043,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202360044
          ]
        },
        "202360044": {
          "id": 202360044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Sie sind weg.",
          "next": [
            202360045
          ]
        },
        "202360045": {
          "id": 202360045,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Vielleicht haben sie mich beim Beobachten bemerkt und sich versteckt.",
          "next": [
            202360046
          ]
        },
        "202360046": {
          "id": 202360046,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich überprüfe die anderen Überwachungsaufnahmen.",
          "next": [
            202360047
          ]
        },
        "202360047": {
          "id": 202360047,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Wenn es nichts Wichtiges mehr gibt, sehen wir uns das nächste Mal.",
          "next": [
            202360048
          ]
        },
        "202360048": {
          "id": 202360048,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Blade ist offline gegangen.",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1205
      ]
    }
  ]
}