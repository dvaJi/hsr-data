  "sections": [
    {
      "id": 1507001,
      "startingMessageId": [
        150700100
      ],
      "messages": {
        "150700100": {
          "id": 150700100,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wie läuft’s denn so in Astropolis in letzter Zeit? Ich wollte dich eigentlich um einen Gefallen bitten.",
          "next": [
            150700101
          ]
        },
        "150700101": {
          "id": 150700101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Die Arbeit ist fast geschafft, ich mache gerade ganz entspannt Urlaub.",
          "next": [
            150700102
          ]
        },
        "150700102": {
          "id": 150700102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wobei soll ich helfen?",
          "next": [
            150700103
          ]
        },
        "150700103": {
          "id": 150700103,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "In Astropolis gibt es einen Filmstar namens Heiliges Wubbaboo. Ich weiß nicht, ob du ihn kennst.",
          "next": [
            150700104
          ]
        },
        "150700104": {
          "id": 150700104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wenn es dir passt, könntest du uns vielleicht einander vorstellen?",
          "next": [
            150700105
          ]
        },
        "150700105": {
          "id": 150700105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Heiliges Wubbaboo? Kenne ich tatsächlich.",
          "next": [
            150700106
          ]
        },
        "150700106": {
          "id": 150700106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Mein Manager und Agent war mit Cardway Films in Verhandlungen über einen Werbevertrag, bei dem ich meine Stimme für eines seiner neuen Projekte zur Verfügung stellen sollte.",
          "next": [
            150700107
          ]
        },
        "150700107": {
          "id": 150700107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich helfe dir dabei! Warte kurz.",
          "next": [
            150700108
          ]
        },
        "150700108": {
          "id": 150700108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wir haben Glück, Heiliges Wubbaboo ruht sich heute Nachmittag im Zeigerturm aus.",
          "next": [
            150700109
          ]
        },
        "150700109": {
          "id": 150700109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Ich habe ein Treffen für dich arrangiert. Geh einfach hin, du kannst ihn gar nicht verfehlen.",
          "next": [
            150700110,
            150700111
          ]
        },
        "150700110": {
          "id": 150700110,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du bist meine Rettung, im Ernst! Vielen Dank!",
          "next": []
        },
        "150700111": {
          "id": 150700111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Robin, du bist einfach unglaublich!",
          "next": []
        }
      },
      "participatingContactsIds": [
        8001,
        1309
      ]
    }
  ]
