  "sections": [
    {
      "id": 1500901,
      "startingMessageId": [
        150090101
      ],
      "messages": {
        "150090101": {
          "id": 150090101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Hallo, ich bin die Besitzerin von Charings Buchladen. Tut mir leid, dass ich dich störe.",
          "next": [
            150090102
          ]
        },
        "150090102": {
          "id": 150090102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Bist du gerade auf einen Text aus den „Chroniken des schwimmenden Schmieröls“ gestoßen?",
          "next": [
            150090103,
            150090107,
            150090111
          ]
        },
        "150090103": {
          "id": 150090103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bin ich, aber ...",
          "next": [
            150090104
          ]
        },
        "150090104": {
          "id": 150090104,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Woher wusstest du das?",
          "next": [
            150090105
          ]
        },
        "150090105": {
          "id": 150090105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Die „Chroniken des schwimmenden Schmieröls“ auf dem Platz haben es mir erzählt ...",
          "next": [
            150090106
          ]
        },
        "150090106": {
          "id": 150090106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Ich habe gelesen, wie du ihn gerettet hast.",
          "next": [
            150090115
          ]
        },
        "150090107": {
          "id": 150090107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was sind die „Chroniken des schwimmenden Schmieröls“?",
          "next": [
            150090108
          ]
        },
        "150090108": {
          "id": 150090108,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das kommt mir irgendwie bekannt vor, aber auch wieder nicht.",
          "next": [
            150090109
          ]
        },
        "150090109": {
          "id": 150090109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Sie sind sowohl ein Buch als auch ein Imagenae.",
          "next": [
            150090110
          ]
        },
        "150090110": {
          "id": 150090110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Erinnerst du dich? Du bist ihm vorhin auf dem Platz begegnet.",
          "next": [
            150090115
          ]
        },
        "150090111": {
          "id": 150090111,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hä? Du musst mich mit jemandem verwechseln.",
          "next": [
            150090112
          ]
        },
        "150090112": {
          "id": 150090112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Es ist keine Verwechslung. Die „Chroniken des schwimmenden Schmieröls erzählen“, wie du ihn rettest.",
          "next": [
            150090113
          ]
        },
        "150090113": {
          "id": 150090113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Das ist kein Betrug. Du kannst zum Platz kommen und dich selbst davon überzeugen.",
          "next": [
            150090114
          ]
        },
        "150090114": {
          "id": 150090114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "„Die Chroniken des schwimmenden Schmieröls“ sind sowohl ein Buch als auch ein Imagenae.",
          "next": [
            150090115
          ]
        },
        "150090115": {
          "id": 150090115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Es ist auf dem Rasen in der Mitte des Platzes. Du kannst jederzeit vorbeikommen.",
          "next": [
            150090116
          ]
        },
        "150090116": {
          "id": 150090116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Genau wie in dem Text, den du gerade gefunden hast.",
          "next": [
            150090117
          ]
        },
        "150090117": {
          "id": 150090117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Die verlorenen „Chroniken des schwimmenden Schmieröls“ dokumentieren unschätzbare Legenden über die Ursprünge der Zivilisation des alten Benzaitengoku.",
          "next": [
            150090118
          ]
        },
        "150090118": {
          "id": 150090118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 205,
          "text": "Na dann, wir sehen uns dort.",
          "next": []
        }
      },
      "participatingContactsIds": [
        205,
        8001
      ]
    }
  ]
}