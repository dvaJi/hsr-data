          ]
        },
        "202020004": {
          "id": 202020004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Cinny Cinny Cinny Cinny ...",
          "next": [
            202020005
          ]
        },
        "202020005": {
          "id": 202020005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was ist passiert?",
          "next": [
            202020006
          ]
        },
        "202020006": {
          "id": 202020006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Nichts, nichts! Der Kleine Ika ist gerade über mein Bein geklettert und hat meine Abkürzungstaste getroffen.",
          "next": [
            202020007
          ]
        },
        "202020007": {
          "id": 202020007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Aber ich wollte wirklich mit dir sprechen. Immerhin wird die letzte Schlacht kein Zuckerschlecken.",
          "next": [
            202020008
          ]
        },
        "202020008": {
          "id": 202020008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Sind deinen Verletzungen verheilt? Schläfst du gut? Hast du Appetit? Fühlst du dich bei der Arbeit müde? Hast du noch andere Beschwerden?",
          "next": [
            202020009,
            202020011,
            202020015
          ]
        },
        "202020009": {
          "id": 202020009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mir geht’s prima!",
          "next": [
            202020010
          ]
        },
        "202020010": {
          "id": 202020010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Dann bin ich ja beruhigt!",
          "next": [
            202020018
          ]
        },
        "202020011": {
          "id": 202020011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich liebe es zu schlafen und zu essen, aber nicht Sport zu treiben ... Gibt es für mich noch Hoffnung, Fräulein Hyacine?",
          "next": [
            202020012
          ]
        },
        "202020012": {
          "id": 202020012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Wenn dein Körper schlafen will, dann lass ihn schlafen! Du musst sehr müde sein ... Zwing dich nicht, wach zu bleiben.",
          "next": [
            202020013
          ]
        },
        "202020013": {
          "id": 202020013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Wenn du etwas Gesundes und Leckeres willst, gibt es natürlich noch eine andere Möglichkeit.",
          "next": [
            202020014
          ]
        },
        "202020014": {
          "id": 202020014,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020015": {
          "id": 202020015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie kann man mangelnde Arbeitsmotivation behandeln?",
          "next": [
            202020016
          ]
        },
        "202020016": {
          "id": 202020016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Zu viel Stress? Kinderleicht!",
          "next": [
            202020017
          ]
        },
        "202020017": {
          "id": 202020017,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1409,
          "next": [
            202020018
          ]
        },
        "202020018": {
          "id": 202020018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Komm zum Hof der Dämmerung! Ich mache dir ein paar Snacks ...",
          "next": [
            202020019
          ]
        },
        "202020019": {
          "id": 202020019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Wir können auch in der Sonne sitzen, den Wind spüren und die Klänge des Windspiels zählen.",
          "next": [
            202020020
          ]
        },
        "202020020": {
          "id": 202020020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Ich werde noch eines von meinen exklusiv entwickelten Dämmerungs-Räucherstäbchen anzünden.",
          "next": [
            202020021
          ]
        },
        "202020021": {
          "id": 202020021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Dann auf dem weichen Schaukelstuhl liegen und den Schlafliedservice vom Kleinen Ika genießen ...",
          "next": [
            202020022,
            202020025
          ]
        },
        "202020022": {
          "id": 202020022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin gleich da!",
          "next": [
            202020023
          ]
        },
        "202020023": {
          "id": 202020023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1409,
          "text": "Alles klar, der Kleine Ika und ich warten auf dich.",
          "next": [
            202020024
          ]
        },
