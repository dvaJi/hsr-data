          ]
        },
        "202330043": {
          "id": 202330043,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{M#Ein geborener Wahnsinniger}{F#Eine gebohrene Wahnsinnige}: Hat Nanook mit nichts als einem Baseballschläger bewaffnet herausgefordert.",
          "next": [
            202330044
          ]
        },
        "202330044": {
          "id": 202330044,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
