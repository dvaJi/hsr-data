      "messages": {
        "202330000": {
          "id": 202330000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Habe ein kleines „Skript“-Generator-Mini-Programm gebaut.",
          "next": [
            202330001
          ]
        },
        "202330001": {
          "id": 202330001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Willst du spielen?",
          "next": [
            202330002
          ]
        },
        "202330002": {
          "id": 202330002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Also gut, wie spielen wir?",
          "next": [
            202330003
          ]
        },
        "202330003": {
          "id": 202330003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Lebenssimulator „Schreib dein eigenes Drehbuch“ (Version ohne Elio) im Chat platziert",
          "next": [
            202330004
          ]
        },
        "202330004": {
          "id": 202330004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Bitte wähle einen Modus, um die Simulation zu starten:{SPACE}",
          "next": [
            202330005,
            202330027
          ]
        },
        "202330005": {
          "id": 202330005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Klassischer Modus",
          "next": [
            202330006
          ]
        },
        "202330006": {
          "id": 202330006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "„Start im Klassischen Modus“ Hintergrund -10, Intelligenz -10, Ausdauer -10, Stärke -10, Vitalität -10",
          "next": [
            202330007
          ]
        },
        "202330007": {
          "id": 202330007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{NICKNAME}s Lebensskript: „Ich wurde wiedergeboren: Mama, das Leben ist eine Wildnis“",
          "next": [
            202330008
          ]
        },
        "202330008": {
          "id": 202330008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Und jetzt, mach den ersten Schritt deines Lebens.",
          "next": [
            202330009,
            202330016
          ]
        },
        "202330009": {
          "id": 202330009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin {M#der Schaffner}{F#die Schaffnerin}: {M#der Erste}{F#die Erste} an Bord des Astralexpresses!",
          "next": [
            202330010
          ]
        },
        "202330010": {
          "id": 202330010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Als Kind ging {NICKNAME} an Bord des Astralexpresses und wollte nicht mehr aussteigen.",
          "next": [
            202330011
          ]
        },
        "202330011": {
          "id": 202330011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Als Teenager manövrierte {NICKNAME} den Express gekonnt aus der Patsche, als das Universum in der Krise steckte.",
          "next": [
            202330012
          ]
        },
        "202330012": {
          "id": 202330012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "In jungen Jahren tappte {NICKNAME} in die Falle eines Äons und konnte nicht entkommen.",
          "next": [
            202330013
          ]
        },
        "202330013": {
          "id": 202330013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Das Erwachsenenalter erweckte {M#seine}{F#ihre}Fähigkeiten und {M#er}{F#sie} schwor, die Welt zu retten.",
          "next": [
            202330014
          ]
        },
        "202330014": {
          "id": 202330014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Nanook, verstorben",
          "next": [
            202330015
          ]
        },
        "202330015": {
          "id": 202330015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ein Märchen?",
          "next": [
            202330046
          ]
        },
        "202330016": {
          "id": 202330016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "„Nicht mutig genug, um den ersten Schritt zu machen.“",
          "next": [
            202330017
          ]
        },
        "202330017": {
          "id": 202330017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Verstorben",
          "next": [
            202330018
          ]
        },
        "202330018": {
          "id": 202330018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "?",
          "next": [
            202330019
          ]
        },
        "202330019": {
          "id": 202330019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das klingt nicht richtig ...",
          "next": [
            202330020
          ]
        },
        "202330020": {
          "id": 202330020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Moment, Kafkas ikonischer Spruch fehlt.",
          "next": [
            202330021
          ]
        },
        "202330021": {
          "id": 202330021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Wenn du eine Wahl treffen kannst, dann triff eine, von der du weißt, dass du sie nicht bereuen wirst ...",
          "next": [
            202330022
          ]
        },
        "202330022": {
          "id": 202330022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Okay. Zeit, dir die Geschichte deines Lebens anzusehen:",
          "next": [
            202330023
          ]
        },
        "202330023": {
          "id": 202330023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Während {NICKNAME}s Kindheit herrschte Frieden im Universum und das Leben in Pegana bestand darin, unvergessliche Erinnerungen zu schaffen.",
          "next": [
            202330024
          ]
        },
        "202330024": {
          "id": 202330024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Während {NICKNAME}s Jugend befand sich das Universum in einer Krise und {NICKNAME} konnte nur dank der eigenen Herkunft und purem Glück überleben.",
          "next": [
            202330025
          ]
        },
        "202330025": {
          "id": 202330025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "In jungen Jahren tappte {NICKNAME} in die Falle eines Äons und konnte nicht entkommen.",
          "next": [
            202330026
          ]
        },
        "202330026": {
          "id": 202330026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Verstorben",
          "next": [
            202330046
          ]
        },
        "202330027": {
          "id": 202330027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Überraschungsmodus",
          "next": [
            202330028
          ]
        },
        "202330028": {
          "id": 202330028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "„Start im Überraschungsmodus“ 10 Ziehungen für die kostenlose Werteverteilung: Hintergrund -0, Intelligenz -0, Ausdauer -0, Stärke -0, Vitalität -50",
          "next": [
            202330029
          ]
        },
        "202330029": {
          "id": 202330029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "{NICKNAME}s Lebensskript: „Ich wurde wiedergeboren: Hä? Ich bin {M#ein geborener Verrückter}{F#eine geborene Verrücktere}.“",
          "next": [
            202330030
          ]
        },
        "202330030": {
          "id": 202330030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Und jetzt, mach den ersten Schritt deines Lebens.",
          "next": [
            202330031,
            202330037
          ]
        },
        "202330031": {
          "id": 202330031,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Danke für die Einladung. Ich bin buchstäblich ein Neugeborenes und muss mich darauf vorbereiten, es mit Nanook aufzunehmen.",
          "next": [
            202330032
          ]
        },
        "202330032": {
          "id": 202330032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "In {F#ihrem}{M#seinem} früheren Leben war {F#sie}{M#er} einfach nur durchschnittlich, wehrlos.",
          "next": [
            202330033
          ]
        },
        "202330033": {
          "id": 202330033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "In diesem Leben hat {F#sie}{M#er} göttliche Macht und kämpft mit vollem Einsatz.",
          "next": [
            202330034
          ]
        },
        "202330034": {
          "id": 202330034,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
          "text": "Hintergrund: Unendlich; Intellekt: Unendlich; Ausdauer: Unendlich; Stärke: Unendlich; Vitalität: Unendlich",
          "next": [
            202330035
          ]
        },
        "202330035": {
          "id": 202330035,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 220,
