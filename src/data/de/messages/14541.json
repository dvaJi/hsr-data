      "messages": {
        "145410101": {
          "id": 145410101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Anscheinend hast du alle Umgebungen aktiviert.",
          "next": [
            145410102
          ]
        },
        "145410102": {
          "id": 145410102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Wie hat dir das Zuschauen gefallen?",
          "next": [
            145410103,
            145410106
          ]
        },
        "145410103": {
          "id": 145410103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Eine unberechenbare Bühne der Schöpfungen. Sehr interessant.",
          "next": [
            145410104
          ]
        },
        "145410104": {
          "id": 145410104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Genau darin liegt der Reiz der natürlichen Auslese.",
          "next": [
            145410105
          ]
        },
        "145410105": {
          "id": 145410105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "In einer sich ständig verändernden Umgebung gibt es keine optimale Lösung für das Leben.",
          "next": [
            145410109
          ]
        },
        "145410106": {
          "id": 145410106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nur ein paar herumrennende Tierchen. Davon habe ich schon viel zu viele gesehen.",
          "next": [
            145410107
          ]
        },
        "145410107": {
          "id": 145410107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Verstehe.",
          "next": [
            145410108
          ]
        },
        "145410108": {
          "id": 145410108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Zumindest hast du erlebt, wie das Leben in einer ungewohnten Umgebung erkundet und Entscheidungen trifft.",
          "next": [
            145410109
          ]
        },
        "145410109": {
          "id": 145410109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Vielleicht hat das Ziel keine Bedeutung, aber damit geben sie sich offensichtlich nicht zufrieden.",
          "next": [
            145410110
          ]
        },
        "145410110": {
          "id": 145410110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Das hast du sehr gut gemacht.",
          "next": [
            145410111
          ]
        },
        "145410111": {
          "id": 145410111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Ich habe ein paar Belohnungen vorbereitet, die du jederzeit abholen kannst.",
          "next": [
            145410112,
            145410113
          ]
        },
        "145410112": {
          "id": 145410112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Harte Arbeit verdient eine Belohnung. Sie steht mir rechtmäßig zu.",
          "next": [
            145410114
          ]
        },
        "145410113": {
          "id": 145410113,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Danke. Ich nehme alles mit.",
          "next": [
            145410114
          ]
        },
        "145410114": {
          "id": 145410114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Mhm. Ich habe die Forschungsgelder der Raumstation dafür ausgegeben.",
          "next": [
            145410115
          ]
        },
        "145410115": {
          "id": 145410115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1303,
          "text": "Bedien dich.",
          "next": [
            145410116
