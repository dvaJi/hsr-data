  "sections": [
    {
      "id": 2022700,
      "startingMessageId": [
        202270000
      ],
      "messages": {
        "202270000": {
          "id": 202270000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Du hast deinen entspannten Urlaub genossen und warst damit beschäftigt, zu essen und zu trinken.",
          "next": [
            202270001
          ]
        },
        "202270001": {
          "id": 202270001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Du bist viel besser darin, dich an den freien Tagen zu entspannen, als ich.",
          "next": [
            202270002
          ]
        },
        "202270002": {
          "id": 202270002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Versteh mich nicht falsch. Das ist ein aufrichtiges Kompliment.",
          "next": [
            202270003
          ]
        },
        "202270003": {
          "id": 202270003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wenn ich mit der ganzen Arbeit fertig bin, mache ich auch eine Pause. Hast du Tipps, wie ich am besten entspannen und Stress abbauen kann?",
          "next": [
            202270004,
            202270006,
            202270008
          ]
        },
        "202270004": {
          "id": 202270004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Schlaf ein wenig, um deinen Kopf frei zu bekommen, denn in deinen Träumen gibt es nichts, was du nicht tun kannst.",
          "next": [
            202270005
          ]
        },
        "202270005": {
          "id": 202270005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was machst du denn noch außer Karten spielen?",
          "next": [
            202270011
          ]
        },
        "202270006": {
          "id": 202270006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gehe spazieren, gib etwas Geld aus und gönne dir was.",
          "next": [
            202270007
          ]
        },
        "202270007": {
          "id": 202270007,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was machst du denn noch außer Karten spielen?",
          "next": [
            202270011
          ]
        },
        "202270008": {
          "id": 202270008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lockere deine Muskeln, bleibe fit, reise oder ...",
          "next": [
            202270009
          ]
        },
        "202270009": {
          "id": 202270009,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "finde einen anderen Platz zum Zocken.",
          "next": [
            202270010
          ]
        },
        "202270010": {
          "id": 202270010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Was machst du denn noch außer Karten spielen?",
          "next": [
            202270011
          ]
        },
        "202270011": {
          "id": 202270011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Du denkst, Kartenspielen ist meine einzige Möglichkeit, Stress abzubauen? Ist das alles, was du mir zutraust?",
          "next": [
            202270012
          ]
        },
        "202270012": {
          "id": 202270012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ich muss meinen Urlaub ausnutzen, um Speedruns zu machen und ein paar Rekorde in Jade-Abakus und Hexanexus in allen Reichen zu brechen ...",
          "next": [
            202270013
          ]
        },
        "202270013": {
          "id": 202270013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "... die Rätsel der fünf Schätze und drei Weissagungen von Xianzhou zu lösen und die acht Trigramme der gesamten Diting-Familie zu ergründen.",
          "next": [
            202270014,
            202270016,
            202270018
          ]
        },
        "202270014": {
          "id": 202270014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist deine Vorstellung von einer Pause?",
          "next": [
            202270015
          ]
        },
        "202270015": {
          "id": 202270015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wenn du nichts zu tun hast, ist es völlig in Ordnung, einfach nichts zu tun.",
          "next": [
            202270020
          ]
        },
        "202270016": {
          "id": 202270016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das nenne ich mal Kampfgeist!",
          "next": [
            202270017
          ]
        },
        "202270017": {
          "id": 202270017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du kannst es ruhig angehen.",
          "next": [
            202270020
          ]
        },
        "202270018": {
          "id": 202270018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Die acht Trigramme der Diting-Familie? Geht es ihnen gut?",
          "next": [
            202270019
          ]
        },
        "202270019": {
          "id": 202270019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Natürlich. Es geht ihnen immer gut. Schließlich sind sie Experten im Vergessen.",
          "next": [
            202270020
          ]
        },
        "202270020": {
          "id": 202270020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wo wir gerade davon sprechen: Ich konnte mich vorhin nicht auf die Arbeit konzentrieren, also habe ich angefangen, die Zukunft über Geldverdienungsmöglichkeiten für die nächsten fünf Jahre vorherzusagen.",
          "next": [
            202270021
          ]
        },
        "202270021": {
          "id": 202270021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Na, sieh mal an, was ich hier herausgefunden habe!",
          "next": [
            202270022
          ]
        },
        "202270022": {
          "id": 202270022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wie man so schön sagt: Wer Glücksbeutel verschenkt, der hat Glück.",
          "next": [
            202270023
          ]
        },
        "202270023": {
          "id": 202270023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Da die Zeit günstig ist, möchte ich es jetzt mit dir in die Praxis umsetzen.",
          "next": [
            202270024
          ]
        },
        "202270024": {
          "id": 202270024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Na bitte!",
          "next": [
            202270025
          ]
        },
        "202270025": {
          "id": 202270025,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1502,
          "next": []
        }
      },
