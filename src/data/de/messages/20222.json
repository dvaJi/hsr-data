        "202220009": {
          "id": 202220009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "Die Hupe ertönt und es ist der Elektro-Folk-Song, den man früher an jeder Ecke in Planarcadia hören konnte!",
