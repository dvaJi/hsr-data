        "202220018": {
          "id": 202220018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "Wir kümmern uns alle umeinander und haben uns lieb! So läuft das bei Sparxie ( ✿＞◡•)",
