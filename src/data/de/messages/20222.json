        "202220016": {
          "id": 202220016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "Mit einem Feuerwerk strömen Hunderte von Glitzerkaninchen und Feuerpilzen in den Livestream-Raum.",
