        },
        "202220019": {
          "id": 202220019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "Die letzten 10 Sekunden! Das ist der entscheidende Kampf für Sparxie, um sich den Spitzenplatz in den Streamer-Rankings zurückzuholen. Liebe Funkel, gebt eure Stimme ab!",
