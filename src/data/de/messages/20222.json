        },
        "202220017": {
          "id": 202220017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 214,
          "text": "Menschen, Kaninchen, Pilze und Mechatrons wirbeln Taschentücher in perfekter Synchronität. Was für ein speziesübergreifendes Tanzwunder!",
