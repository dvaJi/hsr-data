            202350013
          ]
        },
        "202350013": {
          "id": 202350013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Ich weiß. Sie hat bei Kafka und Glühwürmchen das Gleiche installiert.",
