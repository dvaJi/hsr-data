            202350014
          ]
        },
        "202350014": {
          "id": 202350014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1205,
          "text": "Was ist los? Ich bin auf einer Mission.",
          "next": [
            202350015,
            202350016
          ]
        },
        "202350015": {
          "id": 202350015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was treibst du so? Irgendeine Geheimmission?",
