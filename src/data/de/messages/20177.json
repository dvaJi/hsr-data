  "sections": [
    {
      "id": 2017700,
      "startingMessageId": [
        201770000
      ],
      "messages": {
        "201770000": {
          "id": 201770000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Komm, es gibt eine Belohnung.",
          "next": [
            201770001,
            201770002
          ]
        },
        "201770001": {
          "id": 201770001,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie hoch ist die Belohnung? Ich nehme nicht jeden Auftrag an.",
          "next": [
            201770003
          ]
        },
        "201770002": {
          "id": 201770002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was soll jetzt wieder getestet werden? Meine Preise sind inzwischen gestiegen.",
          "next": [
            201770003
          ]
        },
        "201770003": {
          "id": 201770003,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Anhang „Einkaufsliste für neue Kleidung und Aufbewahrungsanleitung“ wird abgerufen ...",
          "next": [
            201770004
          ]
        },
        "201770004": {
          "id": 201770004,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Die Datei ist zu groß zum Herunterladen.",
          "next": [
            201770005
          ]
        },
        "201770005": {
          "id": 201770005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Aktualisiere umgehend das Nachrichtensystem.",
          "next": [
            201770006
          ]
        },
        "201770006": {
          "id": 201770006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ich sage es mal so, ich habe ein paar neue Klamotten gekauft und die Marionetten allein kommen mit dem Sortieren nicht hinterher.",
          "next": [
            201770007,
            201770008
          ]
        },
        "201770007": {
          "id": 201770007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie viele Klamotten hast du gekauft? Schenk mir etwas davon.",
          "next": [
            201770009
          ]
        },
        "201770008": {
          "id": 201770008,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin {NICKNAME}, schenk mir etwas.",
          "next": [
            201770009
          ]
        },
        "201770009": {
          "id": 201770009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Das kannst du nicht anziehen.",
          "next": [
            201770010
          ]
        },
        "201770010": {
          "id": 201770010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Das habe ich für die Marionetten gekauft.",
          "next": [
            201770011,
            201770013
          ]
        },
        "201770011": {
          "id": 201770011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Marionetten müssen sich auch umziehen?",
          "next": [
            201770012
          ]
        },
        "201770012": {
          "id": 201770012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Natürlich, bei so einem hübschen Gesicht kann niemand widerstehen, ihr schöne Kleidung zu kaufen.",
          "next": [
            201770015
          ]
        },
        "201770013": {
          "id": 201770013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh Mann, sogar Marionetten haben mehr Kleidung als ich.",
          "next": [
            201770014
          ]
        },
        "201770014": {
          "id": 201770014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ah, jetzt weißt du es auch.",
          "next": [
            201770015
          ]
        },
        "201770015": {
          "id": 201770015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Es gibt dieses Mal unzählige Stile. Denk daran, sie nach Kategorien zu sortieren, wenn du sie ordnest.",
          "next": [
            201770016
          ]
        },
        "201770016": {
          "id": 201770016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Mit einem Blick sieht man, dass sie geschmackvoll sind und perfekt zu mir passen. Ganz einfach. Ordnen wir sie zunächst.",
          "next": [
            201770017
          ]
        },
        "201770017": {
          "id": 201770017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ruan Mei empfiehlt immer wieder die Gleichen, also legen wir sie zu denen oben dazu.",
          "next": [
            201770018
          ]
        },
        "201770018": {
          "id": 201770018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Je auffälliger die Farbkombination, desto eher gehört das Stück in die Retro-Abteilung.",
          "next": [
            201770019
          ]
        },
        "201770019": {
          "id": 201770019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Je unbeschreiblicher und unverständlicher der Schnitt ist, desto eher gehört das Stück in die Haute-Couture-Abteilung.",
          "next": [
            201770020
          ]
        },
        "201770020": {
          "id": 201770020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Was die anderen angeht, folge einfach dem Leitfaden.",
          "next": [
            201770021
          ]
        },
        "201770021": {
          "id": 201770021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Kontakt hat seinen Standort freigegeben.",
          "next": [
            201770022
          ]
        },
        "201770022": {
          "id": 201770022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ich habe dir die Adresse der Garderobe geschickt, sie sollte nicht weit von deinen Koordinaten entfernt sein.",
          "next": [
            201770023
          ]
        },
        "201770023": {
          "id": 201770023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Da ist eine kleine Raumstation.",
          "next": [
            201770024
          ]
        },
        "201770024": {
          "id": 201770024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Du musst dir keine Sorgen machen, dass der Platz nicht ausreicht.",
          "next": [
            201770025,
            201770027
          ]
        },
        "201770025": {
          "id": 201770025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wo? Eine Raumstation? Weiß Asta davon?",
          "next": [
            201770026
          ]
        },
        "201770026": {
          "id": 201770026,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich brauche erst die Bezahlung, dann arbeite ich.",
          "next": [
            201770029
          ]
        },
        "201770027": {
          "id": 201770027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du hast für die Marionetten einen Raumstation-Kleiderschrank gekauft? Weiß Asta davon?",
          "next": [
            201770028
          ]
        },
        "201770028": {
          "id": 201770028,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich fange erst nach der Bezahlung an.",
          "next": [
            201770029
          ]
        },
        "201770029": {
          "id": 201770029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Was den Rest angeht, wende dich an sie.",
          "next": [
            201770030
          ]
        },
        "201770030": {
          "id": 201770030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Du wirst an deine Freundin Asta weitergeleitet ...",
          "next": []
        }
      },
      "participatingContactsIds": [
        1401,
        8001
      ]
    }
  ]
}