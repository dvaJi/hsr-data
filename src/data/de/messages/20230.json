  "sections": [
    {
      "id": 2023000,
      "startingMessageId": [
        202300000
      ],
      "messages": {
        "202300000": {
          "id": 202300000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Wie kann es so ein süßes Geschöpf auf der Welt geben?!",
          "next": [
            202300001
          ]
        },
        "202300001": {
          "id": 202300001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Seine Pfoten sind so weich und es riecht nach frischem Reis!",
          "next": [
            202300002
          ]
        },
        "202300002": {
          "id": 202300002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Schade, dass meine Kamera kaputt ist, kann kein Foto von diesem kleinen Engel schießen.",
          "next": [
            202300003,
            202300004,
            202300006
          ]
        },
        "202300003": {
          "id": 202300003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Einverstanden! Welpen machen die Welt zu einem besseren Ort!",
          "next": [
            202300008
          ]
        },
        "202300004": {
          "id": 202300004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du hast einen Hund? Darf ich ihn streicheln?",
          "next": [
            202300005
          ]
        },
        "202300005": {
          "id": 202300005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Leider ist es der Hund meines Klienten.",
          "next": [
            202300008
          ]
        },
        "202300006": {
          "id": 202300006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sorry, aber ich bin ein Katzenmensch.",
          "next": [
            202300007
          ]
        },
        "202300007": {
          "id": 202300007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, ich verstehe.",
          "next": [
            202300008
          ]
        },
        "202300008": {
          "id": 202300008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Eine wichtige Persönlichkeit, deren Identität vertraulich bleibt, hat heute Morgen einen Drohbrief von einer unbekannten Quelle erhalten.",
          "next": [
            202300009
          ]
        },
        "202300009": {
          "id": 202300009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Es standen nur ein paar Worte darin: „Du Hund! Deine Tage sind gezählt.“",
          "next": [
            202300010
          ]
        },
        "202300010": {
          "id": 202300010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Ich habe keine Sekunde gezögert und den Auftrag sofort angenommen.",
          "next": [
            202300011
          ]
        },
        "202300011": {
          "id": 202300011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Jetzt traut sich niemand mehr, dem Kleinen auch nur ein Haar zu krümmen.",
          "next": [
            202300012
          ]
        },
        "202300012": {
          "id": 202300012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ist es möglich, dass mit „du“ in dem Brief nicht der Hund gemeint war, sondern ...",
          "next": [
            202300013
          ]
        },
        "202300013": {
          "id": 202300013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Oh, du meinst den Klienten? Das weiß ich natürlich. Keine Sorge, Herr E ist bereits unterwegs, um ihn zu beschützen.",
          "next": [
            202300014
          ]
        },
        "202300014": {
          "id": 202300014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Der Welpe braucht mich mehr als mein Klient.",
          "next": [
            202300015,
            202300016
          ]
        },
        "202300015": {
          "id": 202300015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sieht für mich so aus, als bräuchtest du das dringender.",
          "next": [
            202300017
          ]
        },
        "202300016": {
          "id": 202300016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Warum schaffst du dir nicht einfach selbst einen Hund an? Dann musst du nicht immer bei anderen schnorren.",
          "next": [
            202300017
          ]
        },
        "202300017": {
          "id": 202300017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Hey!!! Ich würde mir selbst einen Hund anschaffen, wenn ich mir Hundefutter leisten könnte ...",
          "next": [
            202300018
          ]
        },
        "202300018": {
          "id": 202300018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Mein Klient sagte, Hunde seien Geldfresser ... Ich kann nicht zulassen, dass der Kleine bei mir leidet.",
          "next": [
            202300019
          ]
        },
        "202300019": {
          "id": 202300019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1504,
          "next": [
            202300020
          ]
        },
        "202300020": {
          "id": 202300020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Warte, irgendetwas stimmt hier nicht.",
          "next": [
            202300021
          ]
        },
        "202300021": {
          "id": 202300021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202300022
          ]
        },
        "202300022": {
          "id": 202300022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Braver Hund. Beiß nicht in mein Portemonnaie, da ist nichts drin. Du sollst nicht einfach alles fressen. Wuff, wuff, wuff, wuff!",
          "next": [
            202300023
          ]
        },
        "202300023": {
          "id": 202300023,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert.",
          "next": [
            202300024
          ]
        },
        "202300024": {
          "id": 202300024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Wow, was soll denn diese Gossensprache? Wuff, wuff, wuff! Hörst du mir zu? Welpen fluchen nicht. Wuff, wuff, wuff, wuff!",
          "next": [
            202300025
          ]
        },
        "202300025": {
