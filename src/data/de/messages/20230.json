          ]
        },
        "202300026": {
          "id": 202300026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1504,
          "text": "Wuff, wuff, wuff, mein Geld, wuff, wuff, wuff! Wuff, wuff, wuff, wuff!",
          "next": [
            202300027
          ]
        },
        "202300027": {
