      "messages": {
        "202050000": {
          "id": 202050000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hallo {F#Rätselhafte Grey}{M#Rätselhafter Grey}, ich bin Ciferas",
          "next": [
            202050001
          ]
        },
        "202050001": {
          "id": 202050001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Oma. Entschuldigung, ich habe aus Versehen auf Senden gedrückt.",
          "next": [
            202050002
          ]
        },
        "202050002": {
          "id": 202050002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hast du Cifera gesehen?",
          "next": [
            202050003,
            202050005,
            202050007
          ]
        },
        "202050003": {
          "id": 202050003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Guten Tag, die Dame.",
          "next": [
            202050004
          ]
        },
        "202050004": {
          "id": 202050004,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Soll ich helfen, die Katze zu finden?",
          "next": [
            202050009
          ]
        },
        "202050005": {
          "id": 202050005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich hab sie auch nicht gesehen.",
          "next": [
            202050006
          ]
        },
        "202050006": {
          "id": 202050006,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich werde dir sofort helfen, die Katze zu finden.",
          "next": [
            202050009
          ]
        },
        "202050007": {
          "id": 202050007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vielleicht beim Bad?",
          "next": [
            202050008
          ]
        },
        "202050008": {
          "id": 202050008,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Soll ich helfen, die Katze zu finden?",
          "next": [
            202050009
          ]
        },
        "202050009": {
          "id": 202050009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Danke dir, das ist schon in Ordnung. Ich weiß, dass es viel Mühe kosten wird, sie zu finden.",
          "next": [
            202050010
          ]
        },
        "202050010": {
          "id": 202050010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Also muss ich mir etwas einfallen lassen, damit sie von selbst zurückkommt.",
          "next": [
            202050011
          ]
        },
        "202050011": {
          "id": 202050011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Kommst du später zu uns zum Essen, {F#Rätselhafte Grey}{M#Rätselhafter Grey}?",
          "next": [
            202050012
          ]
        },
        "202050012": {
          "id": 202050012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ähem. Ich benutze besser die Sprache-zu-Text-Funktion. In letzter Zeit hat Cifera oft verschiedene Freunde mit nach Hause zum Essen gebracht. Da sie plötzlich während der Abendessenszeit verschwunden ist, vermute ich, sie ist wieder zu einem Freund gegangen. Aber ich weiß nicht, bei wem ich sie finden könnte, diese kleine Ausreißerin. Deshalb bin ich auf diese Idee gekommen.",
          "next": [
            202050013
          ]
        },
        "202050013": {
          "id": 202050013,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            202050014
          ]
        },
        "202050014": {
          "id": 202050014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ich habe alle Freunde eingeladen, die sie in dieser Tafel als Kontakt gespeichert hat. Da gibt es ... Agi. Moment, lass mich nachsehen. Ich zähle sie für dich auf: Agi, Große Schwester Tribbie, Professor Anaxa, Unsterblicher kleiner Prinz, Schlafprinzessin, Rosa Kuchen, Kleiner Erlöser im Ruhestand, Große Imperatorin, Trockenfisch-Verkäufer, Zaggy ... und {F#Rätselhafte Grey}{M#Rätselhafter Grey}. Ah, das bist dann wohl du. Was für schöne Namen. Gut verständlich und mit Charakter.",
          "next": [
            202050015
          ]
        },
        "202050015": {
          "id": 202050015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            202050016,
            202050017,
            202050019
          ]
        },
        "202050016": {
          "id": 202050016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Nimm diese Namen nicht zu ernst.",
          "next": [
            202050020
          ]
        },
        "202050017": {
          "id": 202050017,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Reicht der Esstisch für alle? Ich könnte einen größeren mitbringen.",
          "next": [
            202050018
          ]
        },
        "202050018": {
          "id": 202050018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ja, der Tisch ist groß genug und das Essen reicht auch.",
          "next": [
            202050020
          ]
        },
        "202050019": {
          "id": 202050019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ein großer Topf Essen für alle! Und Teigtaschen!",
          "next": [
            202050020
          ]
        },
        "202050020": {
          "id": 202050020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ach herrje, die Kleinen sind schon ... Hört auf herumzurasen! Sie sind schon hier. Ich gehe mich kurz um sie kümmern. Ach je. Nun, dann warten wir auf euch. Cifera wird sich bestimmt sehr freuen.",
          "next": [
            202050021
          ]
        },
        "202050021": {
          "id": 202050021,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            202050022
          ]
        },
        "202050022": {
          "id": 202050022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Hihi! Ich bin zurück!",
          "next": [
            202050023
          ]
        },
        "202050023": {
          "id": 202050023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "{F#Rätselhafte Grey}{M#Rätselhafter Grey}, komm essen!",
          "next": [
            202050024
          ]
        },
        "202050024": {
          "id": 202050024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Sonst schickt Oma wieder überall Nachrichten von meiner Tafel raus.",
          "next": [
            202050025
          ]
        },
        "202050025": {
          "id": 202050025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1406,
          "text": "Ich warte auf dich!",
          "next": []
        }
      },
