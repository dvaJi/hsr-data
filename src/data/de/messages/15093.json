      ],
      "messages": {
        "150930100": {
          "id": 150930100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Ooh, ich habe gehört, du hast gerade die peinlichste Schlappe deines Lebens kassiert? Wie fühlt es sich an, zur Abwechslung mal in meiner Haut zu stecken?",
          "next": [
            150930101,
            150930102
          ]
        },
        "150930101": {
          "id": 150930101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie findest du so was überhaupt so schnell heraus? Das war buchstäblich vor weniger als einer Minute zu Ende!",
          "next": [
            150930103
          ]
        },
        "150930102": {
          "id": 150930102,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jetzt zufrieden? Endlich kannst du auf meine Kosten lachen, was?",
          "next": [
            150930103
          ]
        },
        "150930103": {
          "id": 150930103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Ich habe ein paar Geister-Handlanger im postmortalen Beschäftigungszentrum, musst du wissen. Sie haben sich in der Nähe versteckt und alles die ganze Zeit über live gestreamt.",
          "next": [
            150930104
          ]
        },
        "150930104": {
          "id": 150930104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Aber hey, ich bin nicht nur hergekommen, um es dir unter die Nase zu reiben. Ich habe tatsächlich eine Möglichkeit, dir aus der Patsche zu helfen.",
          "next": [
            150930105
          ]
        },
        "150930105": {
          "id": 150930105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Wir besprechen die Details persönlich. Ich bin in der Nähe, also komm einfach zu mir.",
          "next": [
            150930106
          ]
        },
        "150930106": {
          "id": 150930106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Skott hat den Standort freigegeben.",
          "next": [
            150930107
          ]
        },
        "150930107": {
          "id": 150930107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mir helfen? Woher der plötzliche Sinneswandel?",
          "next": [
            150930108
          ]
        },
        "150930108": {
          "id": 150930108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Immer noch so vorsichtig wie eh und je, was?",
          "next": [
            150930109
          ]
        },
        "150930109": {
          "id": 150930109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Komm einfach rüber und lass uns quatschen, okay? Es ist ja nicht so, als könnte ich es in einem Kampf mit dir aufnehmen. Wovor hast du Angst?",
          "next": [
            150930110
          ]
        },
        "150930110": {
          "id": 150930110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 239,
          "text": "Beeil dich, ich bin beschäftigt.",
          "next": []
        }
      },
      "participatingContactsIds": [
        239,
        8001
      ]
    }
  ]
}