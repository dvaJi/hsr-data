  "sections": [
    {
      "id": 2019900,
      "startingMessageId": [
        201990000
      ],
      "messages": {
        "201990000": {
          "id": 201990000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Entschuldige die Störung, {F#Frau}{M#Herr} {NICKNAME}.",
          "next": [
            201990001
          ]
        },
        "201990001": {
          "id": 201990001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Erinnerst du dich noch an die beiden kleinen Chimären, die ich aufgezogen habe? Ich habe herausgefunden, dass sie es lieben, beim Einschlafen Märchen zu hören.",
          "next": [
            201990002
          ]
        },
        "201990002": {
          "id": 201990002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ich habe in letzter Zeit darüber nachgedacht, beim Schreiben ein paar neue Ansätze zu verfolgen. Daher möchte ich versuchen, eines zu schreiben.",
          "next": [
            201990003,
            201990004
          ]
        },
        "201990003": {
          "id": 201990003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was für eine neue Geschichte erwartet uns dieses Mal?",
          "next": [
            201990006
          ]
        },
        "201990004": {
          "id": 201990004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Komme ich auch darin vor?",
          "next": [
            201990005
          ]
        },
        "201990005": {
          "id": 201990005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Aber ja.",
          "next": [
            201990006
          ]
        },
        "201990006": {
          "id": 201990006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Tatsächlich wollte ich gerade nach deiner Meinung fragen. Die aktuelle Idee lautet wie folgt:",
          "next": [
            201990007
          ]
        },
        "201990007": {
          "id": 201990007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Die Hauptfigur gelangt zufällig in eine kleine Stadt. In dieser leben Katzen und Mäuse, singende Raben, rosafarbene Schweinchen und eine kooperativ arbeitende Ameisenfamilie.",
          "next": [
            201990008
          ]
        },
        "201990008": {
          "id": 201990008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sie sind sehr menschlich, spielen gerne mit der Hauptfigur und hören auch recht gerne bei Geschichten zu.",
          "next": [
            201990009
          ]
        },
        "201990009": {
          "id": 201990009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Nein, sie hören wirklich, wirklich gerne zu ...",
          "next": [
            201990010
          ]
        },
        "201990010": {
          "id": 201990010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Wenn die tiefe Nacht in der Märchenstadt hereinbricht, wird alles still ... aber die Tierchen können nicht einschlafen ...",
          "next": [
            201990011
          ]
        },
        "201990011": {
          "id": 201990011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "„Hier kann es nicht ruhig sein“, sagen sie. „Hier kann es nicht ruhig sein“ ...",
          "next": [
            201990012
          ]
        },
        "201990012": {
          "id": 201990012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Also kommen sie an das Bett der Hauptfigur.",
          "next": [
            201990013
          ]
        },
        "201990013": {
          "id": 201990013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Das war’s.",
          "next": [
            201990014
          ]
        },
        "201990014": {
          "id": 201990014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "●_●",
          "next": [
            201990015
          ]
        },
        "201990015": {
          "id": 201990015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◕_◕",
          "next": [
            201990016
          ]
        },
        "201990016": {
          "id": 201990016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "◐‿◑",
          "next": [
            201990017
          ]
        },
        "201990017": {
          "id": 201990017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ich gucke dich an.",
          "next": [
            201990018,
            201990021,
            201990024
          ]
        },
        "201990018": {
          "id": 201990018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist also ein „Märchen“? So gruselig?!",
          "next": [
            201990019
          ]
        },
        "201990019": {
          "id": 201990019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ah, es ist also tatsächlich beängstigend?",
          "next": [
            201990020
          ]
        },
        "201990020": {
          "id": 201990020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ehrlich gesagt, während ich geschrieben habe, ist mir aufgefallen, dass sich dieses Thema vielleicht besser für einen Horrorroman eignet.",
          "next": [
            201990027
          ]
        },
        "201990021": {
          "id": 201990021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist echt ziemlich niedlich.",
          "next": [
            201990022
          ]
        },
        "201990022": {
          "id": 201990022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ehrlich gesagt, während ich geschrieben habe, ist mir aufgefallen, dass sich dieses Thema vielleicht besser für einen Horrorroman eignet.",
          "next": [
            201990023
          ]
        },
        "201990023": {
          "id": 201990023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Aber nach deiner Reaktion zu urteilen, scheinen die Horrorelemente wohl noch nicht gruselig genug zu sein.",
          "next": [
            201990027
          ]
        },
        "201990024": {
          "id": 201990024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Also, wo ist dieser ruhige Ort?",
          "next": [
            201990025
          ]
        },
        "201990025": {
          "id": 201990025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Wie erwartet, deine Aufmerksamkeit richtet sich immer auf so ... ungewöhnliche Aspekte.",
          "next": [
            201990026
          ]
        },
        "201990026": {
          "id": 201990026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ehrlich gesagt, während ich geschrieben habe, ist mir aufgefallen, dass sich dieses Thema vielleicht besser für einen Horrorroman eignet.",
          "next": [
            201990027
          ]
        },
        "201990027": {
          "id": 201990027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": [
            201990028
          ]
        },
        "201990028": {
          "id": 201990028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Aber ich bin nicht so bewandert in Horrorgeschichten. Um mich besser hineinversetzen zu können, habe ich mir ein paar Referenzbücher besorgt, zum Beispiel „20 ungelöste Mysterien“ und „Verschiedene Ursachen des Verschwindens“ ...",
          "next": [
            201990029
          ]
        },
        "201990029": {
          "id": 201990029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Ich habe gerade „Gut essen“ zu Ende gelesen und finde, dass da einige gute Ideen dabei sind.",
          "next": [
            201990030
          ]
        },
        "201990030": {
          "id": 201990030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Sobald ich Fortschritte gemacht habe, komme ich wieder auf dich zu.",
          "next": [
            201990031
          ]
        },
        "201990031": {
          "id": 201990031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1407,
          "text": "Keine Sorge, die kleinen Chimären drängen einen auch täglich zum Schreiben. Sie lieben es einfach, Geschichten zu hören.",
          "next": [
            201990032
          ]
        },
        "201990032": {
          "id": 201990032,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1407,
          "next": []
        }
      },
      "participatingContactsIds": [
        1407,
        8001
      ]
    }
  ]
}