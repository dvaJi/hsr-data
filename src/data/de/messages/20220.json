{
  "id": 20220,
  "contacts": {
    "id": 1321,
    "name": "Die Dahlie",
    "icon": "1321",
    "signature": "Warum sagst du nichts?",
    "typeId": 1,
    "type": "Figuren"
  },
  "relatedMessages": [
    20219,
    20220,
    20221
  ],
  "sections": [
    {
      "id": 2022000,
      "startingMessageId": [
        202200000
      ],
      "messages": {
        "202200000": {
          "id": 202200000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, wusstest du, dass es in Penacony noch mehr unentdeckte Erinnerungen gibt?",
          "next": [
            202200001
          ]
        },
        "202200001": {
          "id": 202200001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Niemand hat es je wirklich verstanden, nicht einmal du, {F#die}{M#der} du gerade diese Erinnerung wiedererlangt hast.",
          "next": [
            202200002
          ]
        },
        "202200002": {
          "id": 202200002,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Diese vertrauten Gesichter, diese unausgesprochenen Geheimnisse ... Macht dich das nicht neugierig?",
          "next": [
            202200003
          ]
        },
        "202200003": {
          "id": 202200003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Die Dame, die in jener Nacht von Ewigflammen eine Hülle aus Feuer führte.",
          "next": [
            202200004
          ]
        },
        "202200004": {
          "id": 202200004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Oder ... die Jäger, die es auf dich abgesehen haben?",
          "next": [
            202200005
          ]
        },
        "202200005": {
          "id": 202200005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Und natürlich gibt es noch mich. Ich freue mich sehr darauf, dir mein Herz zu öffnen.",
          "next": [
            202200006
          ]
        },
        "202200006": {
          "id": 202200006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Lass mich ein paar Erinnerungen mit dir teilen, bevor ich sie verbrenne.",
          "next": [
            202200007,
            202200016,
            202200022
          ]
        },
        "202200007": {
          "id": 202200007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich will wissen, welches Geheimnis Acheron hat, das nicht einmal sie selbst kennt.",
          "next": [
            202200008
          ]
        },
        "202200008": {
          "id": 202200008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "In der Nacht, als der letzte Funke erlosch,",
          "next": [
            202200009
          ]
        },
        "202200009": {
          "id": 202200009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Sah ich, dass sie",
          "next": [
            202200010
          ]
        },
        "202200010": {
          "id": 202200010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Eine Blaupause nahm, aber leider war es keine Karte, es war ...",
          "next": [
            202200011
          ]
        },
        "202200011": {
          "id": 202200011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ein Menü.",
          "next": [
            202200012
          ]
        },
        "202200012": {
          "id": 202200012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Aber sie hat es wahrscheinlich bis heute noch nicht herausgefunden.",
          "next": [
            202200013
          ]
        },
        "202200013": {
          "id": 202200013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Vielleicht hat sie einfach nur Hunger. Du weißt doch gar nicht, ob sie kochen kann, oder?",
          "next": [
            202200014
          ]
        },
        "202200014": {
          "id": 202200014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Wer weiß?",
          "next": [
            202200015
          ]
        },
        "202200015": {
          "id": 202200015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Vielleicht ... Ich habe ihr Essen schon mal probiert.",
          "next": [
            202200028
          ]
        },
        "202200016": {
          "id": 202200016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Hast du wirklich die Stellaron-Jäger infiltriert? Ich habe da so meine Zweifel.",
          "next": [
            202200017
          ]
        },
        "202200017": {
          "id": 202200017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Willst du ein Geheimnis über sie erfahren?",
          "next": [
            202200018
          ]
        },
        "202200018": {
          "id": 202200018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Stellaron-Jäger, Knecht des Schicksals ... heh, selbst diese Titel können die Verbindung zwischen euch nicht adequat beschreiben.",
          "next": [
            202200019
          ]
        },
        "202200019": {
          "id": 202200019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Wie kommt es, dass sie 42 Gruppenchats für Skripte haben? Ich bin so neugierig!",
          "next": [
            202200020
          ]
        },
        "202200020": {
          "id": 202200020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "In Mathe bist du wirklich miserabel. Es sind doch 56, oder?",
          "next": [
            202200021
          ]
        },
        "202200021": {
          "id": 202200021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Rate mal, in welcher Gruppe ich bin!",
          "next": [
            202200028
          ]
        },
        "202200022": {
          "id": 202200022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich möchte deine unerzählten Geheimnisse hören.",
          "next": [
            202200023
          ]
        },
        "202200023": {
          "id": 202200023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ich habe einmal das halbe Bernsteinzeitalter mit dem Essigfischkult des Sternensees bereist.",
          "next": [
            202200024
          ]
        },
        "202200024": {
          "id": 202200024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Sein Motto lautet: „Mit dem Himmel über dir und dem Sternensee unter dir, nur ein Bissen und du wirst nie wieder Saures schmecken.“",
          "next": [
            202200025
          ]
        },
        "202200025": {
          "id": 202200025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Schade, dass sich niemand erinnert. Erinnerungen waren schon immer so vergänglich.",
          "next": [
            202200026
          ]
        },
        "202200026": {
          "id": 202200026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Jetzt, wo alle Bescheid wissen, wollen wir dich das Motto rufen hören!",
          "next": [
            202200027
          ]
        },
        "202200027": {
          "id": 202200027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Du wirst einen zusätzlichen Preis zahlen müssen.",
          "next": [
            202200028
          ]
        },
        "202200028": {
          "id": 202200028,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was für ein ausgefallenes Geheimnis ich da entdeckt habe!",
          "next": [
            202200029
          ]
        },
        "202200029": {
          "id": 202200029,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Um deine Freundlichkeit zu erwidern, verrate ich dir auch ein Geheimnis!",
          "next": [
            202200030
          ]
        },
        "202200030": {
          "id": 202200030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Eigentlich ...",
          "next": [
            202200031
          ]
        },
        "202200031": {
          "id": 202200031,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Eigentlich war Mikhail früher Schauspieler.",
          "next": [
            202200032
          ]
        },
        "202200032": {
          "id": 202200032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Da du es bist, könnte ich das wirklich glauben.",
          "next": [
            202200033
          ]
        },
        "202200033": {
          "id": 202200033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": []
        }
      },
      "participatingContactsIds": [
        1321,
        8001
      ]
    }
  ]
}