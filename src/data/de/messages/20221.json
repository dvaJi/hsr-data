  "sections": [
    {
      "id": 2022100,
      "startingMessageId": [
        202210000
      ],
      "messages": {
        "202210000": {
          "id": 202210000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "{NICKNAME}, was die Zerstörung angeht ...",
          "next": [
            202210001
          ]
        },
        "202210001": {
          "id": 202210001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Du musst dich wirklich gut auskennen.",
          "next": [
            202210002
          ]
        },
        "202210002": {
          "id": 202210002,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210003
          ]
        },
        "202210003": {
          "id": 202210003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Bestie des Jüngsten Gerichts, Phantylia, Eisengrab ...",
          "next": [
            202210004
          ]
        },
        "202210004": {
          "id": 202210004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ich bin neugierig: Wie hast du dich bei deiner freundlichen Begegnung mit ihnen gefühlt?",
          "next": [
            202210005,
            202210007,
            202210009
          ]
        },
        "202210005": {
          "id": 202210005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Es war witzig. Ich musste sie einfach nur anstarren, ohne einen Finger zu rühren.",
          "next": [
            202210006
          ]
        },
        "202210006": {
          "id": 202210006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Mhm, Blicke können wohl doch töten.",
          "next": [
            202210012
          ]
        },
        "202210007": {
          "id": 202210007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Leider habe ich gar nichts gefühlt. Ich bin einfach nur innerlich tot.",
          "next": [
            202210008
          ]
        },
        "202210008": {
          "id": 202210008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Hmm, wie selbstlos!",
          "next": [
            202210012
          ]
        },
        "202210009": {
          "id": 202210009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lass uns das Schritt für Schritt angehen.",
          "next": [
            202210010
          ]
        },
        "202210010": {
          "id": 202210010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Wir haben einander Schläge verpasst, und das war’s auch schon.",
          "next": [
            202210011
          ]
        },
        "202210011": {
          "id": 202210011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ach so, rundenbasiert!",
          "next": [
            202210012
          ]
        },
        "202210012": {
          "id": 202210012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Zerstörung ist kein glorreicher Moment, aber ihre Schönheit ist zweifellos unbestreitbar.",
          "next": [
            202210013
          ]
        },
        "202210013": {
          "id": 202210013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Du wirst auf diesem Pfad bleiben und weiter voranschreiten.",
          "next": [
            202210014
          ]
        },
        "202210014": {
          "id": 202210014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Bis du die Zerstörung zerstörst, richtig?",
          "next": [
            202210015,
            202210018
          ]
        },
        "202210015": {
          "id": 202210015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Willst du dich uns anschließen? Du hast die Zerstörung sowieso schon verraten.",
          "next": [
            202210016
          ]
        },
        "202210016": {
          "id": 202210016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Ich kann es kaum erwarten, dass dieser Tag kommt!",
          "next": [
            202210017
          ]
        },
        "202210017": {
          "id": 202210017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Wenn du dich jedoch gegen den Trailblaze stellst ...",
          "next": [
            202210021
          ]
        },
        "202210018": {
          "id": 202210018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Willst du zur Zerstörung zurückkehren? Wie soll zweimaliger Verrat kein Verrat sein?",
          "next": [
            202210019
          ]
        },
        "202210019": {
          "id": 202210019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Das ist eine tolle Idee, die gefällt mir!",
          "next": [
            202210020
          ]
        },
        "202210020": {
          "id": 202210020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Wenn du dich gegen den Trailblaze stellst ...",
          "next": [
            202210021
          ]
        },
        "202210021": {
          "id": 202210021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Dann tritt in die Feuerwerke, die du entzündet hast.",
          "next": [
            202210022
          ]
        },
        "202210022": {
          "id": 202210022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Also, genau wie es in ihrem Skript steht.",
          "next": [
            202210023
          ]
        },
        "202210023": {
          "id": 202210023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Der Verwüsterfürst zu werden, um das Gedenken zu zerstören, ist keine so schlechte Wahl.",
          "next": [
            202210024
          ]
        },
        "202210024": {
          "id": 202210024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": [
            202210025
          ]
        },
        "202210025": {
          "id": 202210025,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Reiß dich zusammen!",
          "next": [
            202210026
          ]
        },
        "202210026": {
          "id": 202210026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1321,
          "text": "Liebe, Vertrauen, Erwartung.",
          "next": [
            202210027
          ]
        },
        "202210027": {
          "id": 202210027,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1321,
          "next": []
        }
