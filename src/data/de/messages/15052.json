        "150520104": {
          "id": 150520104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 133,
          "text": "Überrascht, was? Ich bin jetzt ihre temporäre Aushilfe. Ich habe hier auf dich gewartet.",
