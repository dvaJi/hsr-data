          ]
        },
        "150520106": {
          "id": 150520106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 133,
          "text": "Es gibt nichts zu erklären. Ich bin im Moment ihre temporäre Assistentin. Sie war es, die mir gesagt hat, dass du hierherkommen würdest.",
          "next": [
            150520107,
            150520108
          ]
        },
        "150520107": {
          "id": 150520107,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wieso sind hier so viele Leute? ... Ist es überhaupt günstig für uns, uns hier zu treffen?",
          "next": [
