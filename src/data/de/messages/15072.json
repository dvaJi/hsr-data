      "messages": {
        "150720100": {
          "id": 150720100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Fertig mit dem Streifen!",
          "next": [
            150720101
          ]
        },
        "150720101": {
          "id": 150720101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Also gut, Leute, macht euer Ding. Toilettenpausen, Fotosessions, was auch immer. Wir treffen uns dann am Eingang des Kinos.",
          "next": [
            150720102
          ]
        },
        "150720102": {
          "id": 150720102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "Dieser Film hat ein ordentliches Budget! Die Produktionsqualität geht durch die Decke!",
          "next": [
            150720103
          ]
        },
        "150720103": {
          "id": 150720103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Es geht doch nichts über eine gute, actiongeladene Geschichte!",
          "next": [
            150720104
          ]
        },
        "150720104": {
          "id": 150720104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 204,
          "text": "Und in der Hauptrolle Heiliges Wubbaboo, ein echter Bühnenveteran.",
          "next": [
            150720105
          ]
        },
        "150720105": {
          "id": 150720105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 209,
          "text": "Absolut! Wie es die Alltagsprobleme eines Superhelden darstellt, spricht mir echt aus der Seele.",
          "next": [
            150720106
          ]
        },
        "150720106": {
          "id": 150720106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Wie auch immer, hat jemand Furli gesehen?",
          "next": [
            150720107
          ]
        },
        "150720107": {
          "id": 150720107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Wie kann ein Furbo beim Filmschauen einfach so verschwinden?",
          "next": [
            150720108
          ]
        },
        "150720108": {
          "id": 150720108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 228,
          "text": "Ich habe Furli tränenüberströmt aus dem Kino kommen und dann geradewegs zum Verlag rennen sehen.",
          "next": [
            150720109
          ]
        },
        "150720109": {
          "id": 150720109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 229,
          "text": "Ein flinkes Fellknäuel, dieser Furli.",
          "next": [
            150720110
          ]
        },
        "150720110": {
          "id": 150720110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 207,
          "text": "Hat er es mit dem Einstempeln so eilig? Die ganze Hetzerei wird diesen Furbo noch umbringen!",
          "next": []
        }
      },
