        },
        "202000006": {
          "id": 202000006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin Nanook und ernenne dich zum Verwüsterfürsten.",
          "next": [
            202000008
          ]
        },
        "202000007": {
          "id": 202000007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin Aha! Ahaaa-men!",
          "next": [
            202000008
          ]
        },
        "202000008": {
          "id": 202000008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Auf den ersten Blick scheint es auf der konzeptionellen Dimension des Pfades zu basieren und versucht, durch Kategorisierung die Selbsterkenntnis und Verhaltensprognose des Individuums zu entschlüsseln.",
          "next": [
            202000009
          ]
        },
        "202000009": {
          "id": 202000009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund Anaxa ist offline.",
