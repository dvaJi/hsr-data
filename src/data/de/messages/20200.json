        "202000012": {
          "id": 202000012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "Der Kommentar dazu lautet:",
          "next": [
            202000013
          ]
        },
        "202000013": {
          "id": 202000013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "„Du und Oroboros seid nicht ohne Zusammenhang – wie ein Droma, das Rotlehm zerkaut, bist du gierig nach der Wahrheit, verschlingst und vereinnahmst sie. Verlangen ist der Antrieb deines Verhaltens.“",
          "next": [
            202000014
          ]
        },
        "202000014": {
          "id": 202000014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1405,
          "text": "„Dein Lebensmotto lautet: Gib dich niemals zufrieden!“",
          "next": [
            202000015,
            202000016,
            202000017
          ]
        },
        "202000015": {
          "id": 202000015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Sollte das nicht der Androidenkopf sein?",
