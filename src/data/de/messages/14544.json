      ],
      "messages": {
        "145440101": {
          "id": 145440101,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Guinaifen hat {NICKNAME} in den Gruppenchat eingeladen.",
          "next": [
            145440102
          ]
        },
        "145440102": {
          "id": 145440102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Leute.",
          "next": [
            145440103
          ]
        },
        "145440103": {
          "id": 145440103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Ich wollte nur sagen ...",
          "next": [
            145440104
          ]
        },
        "145440104": {
          "id": 145440104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Das war ja so süß!",
          "next": [
            145440105
          ]
        },
        "145440105": {
          "id": 145440105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Ja! Besonders dieser Unruhestifter ... Ich glaube, er will mit mir nach Hause kommen.",
          "next": [
            145440106
          ]
        },
        "145440106": {
          "id": 145440106,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Asta hat Herta in den Gruppenchat eingeladen.",
          "next": [
            145440107
          ]
        },
        "145440107": {
          "id": 145440107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "*hust*",
          "next": [
            145440108
          ]
        },
        "145440108": {
          "id": 145440108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Ich muss sagen, dass Rebenkuchen mit fortgesetztem Training definitiv mehr Magie lernen wird.",
          "next": [
            145440109
          ]
        },
        "145440109": {
          "id": 145440109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Aber wenn es um Schönheit geht, scheint es wohl keinen Verbesserungsbedarf zu geben.",
          "next": [
            145440110
          ]
        },
        "145440110": {
          "id": 145440110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Genug, genug! Hört auf, heimlich stärker zu werden.",
          "next": [
            145440111
          ]
        },
        "145440111": {
          "id": 145440111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Wenn ich mich doch nur in Glückssnack verwandeln könnte ...",
          "next": [
            145440112
          ]
        },
        "145440112": {
          "id": 145440112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Und der Jade-Abakus funktioniert nicht mehr, wenn ich in die Nähe komme, dann muss ich keine Arbeitsnachrichten mehr empfangen.",
          "next": [
            145440113
          ]
        },
        "145440113": {
          "id": 145440113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Ich kann dir helfen, deinen ersten Traum zu erfüllen. Willst du es ausprobieren?",
          "next": [
            145440114
          ]
        },
        "145440114": {
          "id": 145440114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1201,
          "text": "Nein, danke.",
          "next": [
            145440115,
            145440118
          ]
        },
        "145440115": {
          "id": 145440115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wer hätte gedacht, dass dieser kleine Wettkampf der Schöpfungen ein solcher Tummelplatz für verborgene Talente sein würde?",
          "next": [
            145440116
          ]
        },
        "145440116": {
          "id": 145440116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "Immerhin war es eine Live-Übertragung mit Kommentar und allem drum und dran.",
          "next": [
            145440117
          ]
        },
        "145440117": {
          "id": 145440117,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1210,
          "next": [
            145440121
          ]
        },
        "145440118": {
          "id": 145440118,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lass nicht zu, dass die Ranglisten die harte Arbeit der Spieler schmälern.",
          "next": [
            145440119
          ]
        },
        "145440119": {
          "id": 145440119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1013,
          "text": "Rate mal, wer einen leichten Sieg errungen hat.",
          "next": [
            145440120
          ]
        },
        "145440120": {
          "id": 145440120,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1201,
          "next": [
            145440121
          ]
        },
        "145440121": {
          "id": 145440121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1210,
          "text": "{NICKNAME}, möchtest du deinem Favoriten etwas sagen?",
          "next": [
            145440122,
            145440123
          ]
        },
        "145440122": {
          "id": 145440122,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ehrlich gesagt bin ich ziemlich neugierig, wie dieser Snack wirklich schmeckt.",
          "next": [
            145440124
          ]
        },
        "145440123": {
          "id": 145440123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Versprich mir, dass du niemals aufhörst!",
          "next": [
            145440124
          ]
        },
