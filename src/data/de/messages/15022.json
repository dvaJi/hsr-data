  "sections": [
    {
      "id": 1502201,
      "startingMessageId": [
        150220100
      ],
      "messages": {
        "150220100": {
          "id": 150220100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "{NICKNAME}, lange nicht gesehen.",
          "next": [
            150220101,
            150220103
          ]
        },
        "150220101": {
          "id": 150220101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Richterin Xueyi! Ich hätte nie erwartet, eine Nachricht von dir zu bekommen!",
          "next": [
            150220102
          ]
        },
        "150220102": {
          "id": 150220102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Du bist ja immer noch so voller Energie!",
          "next": [
            150220106
          ]
        },
        "150220103": {
          "id": 150220103,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wir haben uns schon ewig nicht mehr unterhalten!",
          "next": [
            150220104
          ]
        },
        "150220104": {
          "id": 150220104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Verzeihung, das war mein Versehen.",
          "next": [
            150220105
          ]
        },
        "150220105": {
          "id": 150220105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "In Zukunft werde ich öfter mit dir reden, wenn ich Zeit habe.",
          "next": [
            150220106
          ]
        },
        "150220106": {
          "id": 150220106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich habe gehört, dass du gerade durch Planarcadia reist.",
          "next": [
            150220107
          ]
        },
        "150220107": {
          "id": 150220107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich muss dich um einen kleinen Gefallen bitten.",
          "next": [
            150220108
          ]
        },
        "150220108": {
          "id": 150220108,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kein Problem, Euer Ehren, nur zu!",
          "next": [
            150220109
          ]
        },
        "150220109": {
          "id": 150220109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Hast du schon mal von „Das Labyrinthspiel“ gehört?",
          "next": [
            150220110
          ]
        },
        "150220110": {
          "id": 150220110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich interessiere mich sehr für diesen Comic.",
          "next": [
            150220111
          ]
        },
        "150220111": {
          "id": 150220111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Verbrecher festzunehmen und Gegner zu verfolgen, sagt mir mehr zu als das Debütwerk „Wok-Star“ des Autors.",
          "next": [
            150220112
          ]
        },
        "150220112": {
          "id": 150220112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich habe gehört, dass in Duomension City gerade die exklusive Ausstellung zu „Das Labyrinthspiel“ stattfindet, auf der viele Fan-Werke zum Verkauf angeboten werden.",
          "next": [
            150220113
          ]
        },
        "150220113": {
          "id": 150220113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Schade, dass ich aufgrund meiner Position nicht persönlich zur Convention in Planarcadia gehen kann.",
          "next": [
            150220114
          ]
        },
        "150220114": {
          "id": 150220114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich hoffe, du kannst mir ein paar Fan-Comics kaufen, damit ich nichts mehr bereuen muss.",
          "next": [
            150220115,
            150220121,
            150220123
          ]
        },
        "150220115": {
          "id": 150220115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich war gerade in der Nähe der Convention unterwegs, als ich deine Nachricht bekommen habe ... Du verfolgst mich doch nicht, oder?",
          "next": [
            150220116
          ]
        },
        "150220116": {
          "id": 150220116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Piep, piep, Verfolgungsdrohne „Xueyi Typ 9527“ enttarnt, initiiere Selbstzerstörungsprogramm.",
          "next": [
            150220117
          ]
        },
        "150220117": {
          "id": 150220117,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Waaah, hab Erbarmen! Jag mich nicht in die Luft! Ich kaufe dir auch ein paar Fan-Comics, versprochen!",
          "next": [
            150220118
          ]
        },
        "150220118": {
          "id": 150220118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Keine Angst, war nur ein Scherz.",
          "next": [
            150220119
          ]
        },
        "150220119": {
          "id": 150220119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Es gibt keine explodierenden Drohnen, seid unbesorgt.",
          "next": [
            150220120
          ]
        },
        "150220120": {
          "id": 150220120,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich freue mich darauf, die neuen Fan-Werke zu sehen, danke.",
          "next": []
        },
        "150220121": {
          "id": 150220121,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was für ein Zufall, ich bin auch auf der Comic-Convention!",
          "next": [
            150220122
          ]
        },
        "150220122": {
          "id": 150220122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Hast du es auch gesehen? Das ist wunderbar, danke.",
          "next": []
        },
        "150220123": {
          "id": 150220123,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kein Ding, überlass das einfach mir.",
          "next": [
            150220124
          ]
        },
        "150220124": {
          "id": 150220124,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1214,
          "text": "Ich freue mich darauf, die neuen Fan-Werke zu sehen, danke.",
          "next": []
        }
      },
