      "messages": {
        "133880100": {
          "id": 133880100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Sie ist wach.",
          "next": [
            133880101,
            133880105
          ]
        },
        "133880101": {
          "id": 133880101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "... Geht es ihr gut?",
          "next": [
            133880102
          ]
        },
        "133880102": {
          "id": 133880102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            133880103
          ]
        },
        "133880103": {
          "id": 133880103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "So lautete auch ihre erste Frage.",
          "next": [
            133880104
          ]
        },
        "133880104": {
          "id": 133880104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Sie hat gefragt, ob es dir gut geht.",
          "next": [
            133880107
          ]
        },
        "133880105": {
          "id": 133880105,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wer?",
          "next": [
            133880106
          ]
        },
        "133880106": {
          "id": 133880106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Glühwürmchen.",
          "next": [
            133880107
          ]
        },
        "133880107": {
          "id": 133880107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Momentan geht es ihr gut.",
          "next": [
            133880108
          ]
        },
        "133880108": {
          "id": 133880108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "So ging es ihr auch schon, als Kafka sie zurückgebracht hat.",
          "next": [
            133880109
          ]
        },
        "133880109": {
          "id": 133880109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Sie wird ständig ohnmächtig und kann nicht einmal ihren Mech steuern.",
          "next": [
            133880110
          ]
        },
        "133880110": {
          "id": 133880110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Wirklich furchtbar.",
          "next": [
            133880111
          ]
        },
        "133880111": {
          "id": 133880111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Aber die Behandlung schlägt gut an. Wir müssen Geduld haben.",
          "next": [
            133880112,
            133880115,
            133880120
          ]
        },
        "133880112": {
          "id": 133880112,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kann ich mit ihr sprechen?",
          "next": [
            133880113
          ]
        },
        "133880113": {
          "id": 133880113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Warte erst mal, bis sie ihren Mech wieder unter Kontrolle hat.",
          "next": [
            133880114
          ]
        },
        "133880114": {
          "id": 133880114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Die Genesung wird etwas Zeit brauchen.",
          "next": []
        },
        "133880115": {
          "id": 133880115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wann können wir uns wohl wiedersehen?",
          "next": [
            133880116
          ]
        },
        "133880116": {
          "id": 133880116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Keine Ahnung. Im „Skript“ standen keine Details.",
          "next": [
            133880117
          ]
        },
        "133880117": {
          "id": 133880117,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Oh, warte, nein!",
          "next": [
            133880118
          ]
        },
        "133880118": {
          "id": 133880118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Es standen schon Details darin, aber ich verstehe sie einfach nicht.",
          "next": [
            133880119
          ]
        },
        "133880119": {
          "id": 133880119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Hier steht, du musst „warten, bis du dir selbst gegenüberstehst“.",
          "next": []
        },
        "133880120": {
          "id": 133880120,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Glückwunsch!",
          "next": [
            133880121
          ]
        },
        "133880121": {
          "id": 133880121,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "...",
          "next": [
            133880122
          ]
        },
        "133880122": {
          "id": 133880122,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Na gut",
          "next": [
            133880123
          ]
        },
        "133880123": {
          "id": 133880123,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1006,
          "text": "Ich werde es ihr sagen.",
          "next": []
        }
      },
