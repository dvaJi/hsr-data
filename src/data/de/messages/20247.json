      "messages": {
        "202470000": {
          "id": 202470000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Mutmaßliches Schiffbruch-SOS erfasst: Nach Erkennen einer Gefahr hat Aventurin von diesem ungefähren Standort aus den Notruf gewählt. Du erhältst diese Nachricht, weil du in seinen Kontakten derzeit der Notfallkontakt bist, der Aventurin am nächsten ist.",
          "next": [
            202470001
          ]
        },
        "202470001": {
          "id": 202470001,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Aventurins aktueller Standort wurde geteilt.",
          "next": [
            202470002
          ]
        },
        "202470002": {
          "id": 202470002,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notruf-SOS: Aventurins aktuelle Herzfrequenz nähert sich 20. Bitte rufe sofort Hilfe!",
          "next": [
            202470003,
            202470004,
            202470005
          ]
        },
        "202470003": {
          "id": 202470003,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Diese Herzfrequenz sieht gar nicht gut aus! Du machst mir wirklich Angst, Aventurin! Halte durch, ich komme!",
          "next": [
            202470006
          ]
        },
        "202470004": {
          "id": 202470004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Diese Herzfrequenz sieht gar nicht gut aus! Aventurin!!! Ich komme, um dich zu retten!",
          "next": [
            202470006
          ]
        },
        "202470005": {
          "id": 202470005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Diese Herzfrequenz kann nicht stimmen! Wo ist die IFK!? Wo ist die Bewahrung!? Bernsteinfürst! Muttergöttin! Er braucht Hilfe!",
          "next": [
            202470006
          ]
        },
        "202470006": {
          "id": 202470006,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Aventurins aktueller Standort hat sich geändert.",
          "next": [
            202470007
          ]
        },
        "202470007": {
          "id": 202470007,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Es wird festgestellt, dass Aventurin einen massiven Höhenverlust erleidet und extremem Wasserdruck ausgesetzt ist.",
          "next": [
            202470008
          ]
        },
        "202470008": {
          "id": 202470008,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Aventurines aktuelle Herzfrequenz beträgt 180. Bitte rufe sofort Hilfe!",
          "next": [
            202470009
          ]
        },
        "202470009": {
          "id": 202470009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Aventurins aktueller Standort hat sich geändert.",
          "next": [
            202470010
          ]
        },
        "202470010": {
          "id": 202470010,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Notfall-SOS: Aventurines aktuelle Herzfrequenz beträgt 20. Bitte rufe sofort Hilfe!",
          "next": [
            202470011,
            202470013
          ]
        },
        "202470011": {
          "id": 202470011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Braucht er noch meine Hilfe? Braucht er sie? Sollte ich? Na ja, ich sollte wohl ...",
          "next": [
            202470012
          ]
        },
        "202470012": {
          "id": 202470012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Aventurin! Sag was, wenn du noch lebst!",
          "next": [
            202470015
          ]
        },
        "202470013": {
          "id": 202470013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Schwankt zwischen 20 und 180. Ist das wirklich meine Herzfrequenz?",
          "next": [
            202470014
          ]
        },
        "202470014": {
          "id": 202470014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Bist du auf einer Achterbahn!? Sag was, wenn du noch lebst!",
          "next": [
            202470015
          ]
        },
        "202470015": {
          "id": 202470015,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202470016
          ]
        },
        "202470016": {
          "id": 202470016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Bla, bla, bla! Entspann dich, mir geht’s bestens. Ich war nur surfen. Gib mir eine Sekunde, um an Land zu kommen, dann bringe ich dich auf den neuesten Stand.",
          "next": [
            202470017
          ]
        },
        "202470017": {
          "id": 202470017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Sprachnachricht wurde in Text konvertiert",
          "next": [
            202470018
          ]
        },
        "202470018": {
          "id": 202470018,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202470019
          ]
        },
        "202470019": {
          "id": 202470019,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Aventurins ungefährer Standort hat sich geändert.",
          "next": [
            202470020
          ]
        },
        "202470020": {
          "id": 202470020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Hier bin ich.",
          "next": [
            202470021
          ]
        },
        "202470021": {
          "id": 202470021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Seit wann ist diese Smartwatch so überfürsorglich geworden? Komm schon, das ist nur eine 50-Meter-Welle, halb so wild.",
          "next": [
            202470022,
            202470023
          ]
        },
        "202470022": {
          "id": 202470022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "50 Meter bedeuten Schiffbruch-Alarm! Und deine Herzfrequenz schwankte zwischen 20 und 180.",
          "next": [
            202470024
          ]
        },
        "202470023": {
          "id": 202470023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kann Surfen deine Herzfrequenz zwischen 20 und 180 schwanken lassen!?",
          "next": [
            202470024
          ]
        },
        "202470024": {
          "id": 202470024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Das alles hat mich also verraten?",
          "next": [
            202470025
          ]
        },
        "202470025": {
          "id": 202470025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Entspann dich. Eine Herzfrequenz von 20 lag wahrscheinlich daran, dass ich den Tiefpunkt der Welle erreicht und den Atem angehalten habe.",
          "next": [
            202470026
          ]
        },
        "202470026": {
          "id": 202470026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Selbst wenn sie auf 180 hochschnellt, ist sie immer noch nicht so hoch wie während unseres nächtlichen Kampfes in Penacony.",
          "next": [
            202470027
          ]
        },
        "202470027": {
          "id": 202470027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Haha, Spaß beiseite. Tut mir leid, dass ich dir gerade Sorgen bereitet habe.",
          "next": [
            202470028
          ]
        },
        "202470028": {
          "id": 202470028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ich probiere den neuesten Hover-Surf-Wing aus.",
          "next": [
            202470029
          ]
        },
        "202470029": {
          "id": 202470029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Dieses Gefühl der Schwerelosigkeit, wenn du vom Kamm einer riesigen Welle hinabtauchst, macht wirklich süchtig.",
          "next": [
            202470030
          ]
        },
        "202470030": {
          "id": 202470030,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202470031
          ]
        },
        "202470031": {
          "id": 202470031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Was für ein Glück! Da kommt noch eine Welle!",
          "next": [
            202470032
          ]
        },
        "202470032": {
          "id": 202470032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Ich lege los.",
          "next": [
            202470033
          ]
        },
        "202470033": {
          "id": 202470033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1304,
          "text": "Nächstes Mal nehme ich dich mit, damit du es selbst erleben kannst!",
          "next": [
            202470034
          ]
        },
        "202470034": {
          "id": 202470034,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Aventurins aktueller Standort hat sich geändert.",
          "next": []
        }
      },
