        },
        "202510005": {
          "id": 202510005,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt ...",
          "next": [
            202510006,
            202510007
          ]
        },
        "202510006": {
          "id": 202510006,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was ist los? Zögern ist eigentlich gar nicht dein Stil.",
          "next": [
            202510008
          ]
        },
        "202510007": {
          "id": 202510007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "In Gedanken versunken?",
          "next": [
            202510008
          ]
        },
        "202510008": {
          "id": 202510008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Ich habe ein Kunstwerk erhalten.",
          "next": [
            202510009
          ]
        },
        "202510009": {
          "id": 202510009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Vor einer Weile bat mich ein Straßenporträtmaler, ihm Modell zu stehen, und malte ein Bild mit dem Titel „Pearl“.",
          "next": [
            202510010
          ]
        },
        "202510010": {
          "id": 202510010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Der Negativraum in diesem Werk ist unglaublich beeindruckend.",
          "next": [
            202510011
          ]
        },
        "202510011": {
          "id": 202510011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Weil er einfach nur mit einem Messer einen einzigen Schnitt über das Papier gezogen hat.",
          "next": [
            202510012
          ]
        },
        "202510012": {
          "id": 202510012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Reflexion: Welche Verbindung besteht zwischen dem Kunstwerk und mir ...",
          "next": [
            202510013,
            202510016
          ]
        },
        "202510013": {
          "id": 202510013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kunst ist immer noch viel zu schwer zu verstehen.",
          "next": [
            202510014
          ]
        },
        "202510014": {
          "id": 202510014,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ein einzelner Schnitt ... ehrlich gesagt, würde er sich super als Schlitz für einen Taschentuchspender eignen. Vielleicht meinte er damit ...",
          "next": [
            202510015
          ]
        },
        "202510015": {
          "id": 202510015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "„Pearl, zieh mich?“",
          "next": [
            202510019
          ]
        },
        "202510016": {
          "id": 202510016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Kunst ist jetzt viel zu leicht zu verstehen.",
          "next": [
            202510017
          ]
        },
        "202510017": {
          "id": 202510017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ein Schnitt, der den Raum zerreißt, sieht das nicht irgendwie aus wie ein offener Geldbeutel?",
          "next": [
            202510018
          ]
        },
        "202510018": {
          "id": 202510018,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Steck deine Hand rein und du wirst definitiv etwas herausziehen ...",
          "next": [
            202510019
          ]
        },
        "202510019": {
          "id": 202510019,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510020
          ]
        },
        "202510020": {
          "id": 202510020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Vermutung: Wie sich herausstellt, ist es ein getarnter Überraschungsboxenhändler. Kein Wunder, dass er mich auf der Straße angehalten hat.",
          "next": [
            202510021
          ]
        },
        "202510021": {
          "id": 202510021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aber deine Interpretation ist wirklich interessant.",
          "next": [
            202510022
          ]
        },
        "202510022": {
          "id": 202510022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Kunst: die Dekonstruktion des Lebens.",
          "next": [
            202510023
          ]
        },
        "202510023": {
          "id": 202510023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Kunst zu interpretieren: auch die Dekonstruktion der Kunst.",
          "next": [
            202510024
          ]
        },
        "202510024": {
          "id": 202510024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aber: Liefert dir die Dekonstruktion von Kunst eine Antwort?",
          "next": [
            202510025
          ]
        },
        "202510025": {
          "id": 202510025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Vielleicht nicht. Also: musst du die Dekonstruktion der Kunst dekonstruieren.",
          "next": [
            202510026,
            202510027
          ]
        },
        "202510026": {
          "id": 202510026,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was habe ich da gerade ausgelöst? Gehirn, halt die Klappe, halt die Klappe!",
          "next": [
            202510028
          ]
        },
        "202510027": {
          "id": 202510027,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Oh nein. Was habe ich getan, Pearl hat sich festgefahren.",
          "next": [
            202510028
          ]
        },
        "202510028": {
          "id": 202510028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510029
          ]
        },
        "202510029": {
          "id": 202510029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Keine Sorge. Ich habe mich nur von dir inspirieren lassen und einen kleinen abstrakten Umweg gemacht.",
          "next": [
            202510030
          ]
        },
        "202510030": {
          "id": 202510030,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Aber ich habe jetzt tatsächlich ein völlig neues Verständnis von diesem Stück ...",
          "next": [
            202510031
          ]
        },
        "202510031": {
          "id": 202510031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "Es könnte sagen:",
          "next": [
            202510032
          ]
        },
        "202510032": {
          "id": 202510032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1503,
          "text": "„Öffne die Muschel, ich bin die Perle.“",
          "next": [
            202510033
          ]
        },
        "202510033": {
          "id": 202510033,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1503,
          "next": [
            202510034
          ]
        },
        "202510034": {
          "id": 202510034,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund ist offline.",
          "next": []
        }
      },
