  "sections": [
    {
      "id": 1507301,
      "startingMessageId": [
        150730100
      ],
      "messages": {
        "150730100": {
          "id": 150730100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "@Himeko @Dan Heng @Welt, geht es euch gut?",
          "next": [
            150730101
          ]
        },
        "150730101": {
          "id": 150730101,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Bitte antworten, bitte antworten! Hört mich jemand?",
          "next": [
            150730102
          ]
        },
        "150730102": {
          "id": 150730102,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Warnung: Aktuelles Signal schwach. Bitte überprüfe deine Verbindung.]",
          "next": [
            150730103
          ]
        },
        "150730103": {
          "id": 150730103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@7. März @{NICKNAME} @Sonntag, verstanden, bei uns ist alles in Ordnung.",
          "next": [
            150730104
          ]
        },
        "150730104": {
          "id": 150730104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Bei uns ist alles in Ordnung. @Dan Heng, gibst du ihnen auch Bescheid?",
          "next": [
            150730105
          ]
        },
        "150730105": {
          "id": 150730105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1002,
          "text": "Mach dir keine Sorgen um uns. Wir haben gerade eine Welle von Tentakelmonstern abgewehrt, die aus dem Boden aufgetaucht sind.",
          "next": [
            150730106
          ]
        },
        "150730106": {
          "id": 150730106,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Puh.",
          "next": [
            150730107
          ]
        },
        "150730107": {
          "id": 150730107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Aber mal ehrlich, müssen wir wirklich nach Astropolis? Nichts für ungut, aber die IFK ist mir irgendwie nicht ganz geheuer.",
          "next": [
            150730108
          ]
        },
        "150730108": {
          "id": 150730108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Könnten wir stattdessen vielleicht einfach die Xianzhou oder Frau Hertas Raumstation um Hilfe bitten?",
          "next": [
            150730109
          ]
        },
        "150730109": {
          "id": 150730109,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Der Gedanke ist mir auch schon gekommen.",
          "next": [
            150730110
          ]
        },
        "150730110": {
          "id": 150730110,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Was die Entfernung angeht, sind die Xianzhou und die Herta-Raumstation beide zu weit entfernt. Verzweifelte Zeiten erfordern verzweifelte Maßnahmen. Kurs auf Astropolis zu nehmen, ist immer noch unsere beste Option.",
          "next": [
            150730111
          ]
        },
        "150730111": {
          "id": 150730111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Aber was noch mehr Kopfzerbrechen als die Entfernung bereitet, ist, dass Planarcadia zum Handelsnetzwerk der IFK gehört.",
          "next": [
            150730112
          ]
        },
        "150730112": {
          "id": 150730112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1004,
          "text": "Nach den interstellaren Handelsregeln hat die IFK das Vorrecht, sich darum zu kümmern. Wenn sich Außenstehende ohne Freigabe einmischen, könnten wir ein diplomatisches und rechtliches Chaos am Hals haben.",
          "next": [
            150730113
          ]
        },
        "150730113": {
          "id": 150730113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Also ... ja. Geht wohl nicht anders, was?",
          "next": [
            150730114
          ]
        },
        "150730114": {
          "id": 150730114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "@{NICKNAME}, du übernimmst die Navigation.",
          "next": [
            150730115,
            150730117
          ]
        },
        "150730115": {
          "id": 150730115,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alles klar. Ich kümmere mich darum.",
          "next": [
            150730116
          ]
        },
        "150730116": {
          "id": 150730116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ich weiß, dass du das tun wirst. Ich glaube an dich.",
          "next": [
            150730119
          ]
        },
        "150730117": {
          "id": 150730117,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich ... Ich weiß nicht, was ich tun soll.",
          "next": [
            150730118
          ]
        },
        "150730118": {
          "id": 150730118,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Keine Sorge. Ich glaube an dich. Als {F#amtierende Navigatorin}{M#amtierender Navigator} wirst du das schon herausfinden.",
          "next": [
            150730119
          ]
        },
        "150730119": {
          "id": 150730119,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Die Zeit drängt, also stehen wir hinter jeder Entscheidung, die du triffst.",
          "next": [
            150730120
          ]
        },
        "150730120": {
          "id": 150730120,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "[Warnung: Aktuelles Signal schwach. Bitte überprüfe deine Verbindung.]",
          "next": []
        }
      },
