      "messages": {
        "202070000": {
          "id": 202070000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "{F#Partnerin}{M#Partner}! Erinnerst du dich noch an unser Versprechen?",
          "next": [
            202070001
          ]
        },
        "202070001": {
          "id": 202070001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Über das Ende der „Legende der Sternenmeers“ ...",
          "next": [
            202070002,
            202070004,
            202070005
          ]
        },
        "202070002": {
          "id": 202070002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Natürlich erinnere ich mich. Aber ich würde vorschlagen, dass du es jetzt selbst liest.",
          "next": [
            202070003
          ]
        },
        "202070003": {
          "id": 202070003,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Es ist so spannend, ich möchte es dir nicht spoilern.",
          "next": [
            202070006
          ]
        },
        "202070004": {
          "id": 202070004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Lies es doch selbst ... Es ist so spannend, ich möchte es dir nicht spoilern.",
          "next": [
            202070006
          ]
        },
        "202070005": {
          "id": 202070005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich habe es noch nicht gelesen.",
          "next": [
            202070006
          ]
        },
        "202070006": {
          "id": 202070006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Hehe, tatsächlich konnte ich vor Kurzem nicht widerstehen und habe es heimlich gelesen.",
          "next": [
            202070007
          ]
        },
        "202070007": {
          "id": 202070007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Die Helden durchquerten die Raumzeit und besiegten vereint das letzte Monster. Doch sie wurden durch dessen Kräfte in eine andere Welt teleportiert, wo sie ein neues Leben von Grund auf beginnen mussten.",
          "next": [
            202070008
          ]
        },
        "202070008": {
          "id": 202070008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Ich würde so gerne wissen, was danach passiert ist, aber hier endet die Geschichte!",
          "next": [
            202070009
          ]
        },
        "202070009": {
          "id": 202070009,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070010,
            202070012,
            202070014
          ]
        },
        "202070010": {
          "id": 202070010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist ja unerhört!",
          "next": [
            202070011
          ]
        },
        "202070011": {
          "id": 202070011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Nicht wahr?!",
          "next": [
            202070016
          ]
        },
        "202070012": {
          "id": 202070012,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Gut, dann überlasse ich das Schreiben dir!",
          "next": [
            202070013
          ]
        },
        "202070013": {
          "id": 202070013,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1408,
          "next": [
            202070016
          ]
        },
        "202070014": {
          "id": 202070014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dem Leser Raum für seine eigene Fantasie zu lassen, ist eine Schreibtechnik.",
          "next": [
            202070015
          ]
        },
        "202070015": {
          "id": 202070015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Na gut, das hat es tatsächlich geschafft!",
          "next": [
            202070016
          ]
        },
        "202070016": {
          "id": 202070016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Aber das ist wohl auch der Antrieb, das nächste Buch aufzuschlagen.",
          "next": [
            202070017
          ]
        },
        "202070017": {
          "id": 202070017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "{F#Partnerin}{M#Partner}, hast du in letzter Zeit etwas Interessantes gelesen? Ich bin in einer Bücherflaute.",
          "next": [
            202070018,
            202070021,
            202070023
          ]
        },
        "202070018": {
          "id": 202070018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich empfehle dringend die Krimigeschichten, die März neulich geschrieben hat.",
          "next": [
            202070019
          ]
        },
        "202070019": {
          "id": 202070019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du wirst nie erraten, wer der Täter ist. Oder auch nur, wie viele es sind.",
          "next": [
            202070020
          ]
        },
        "202070020": {
          "id": 202070020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ich schicke dir nachher den Link.",
          "next": [
            202070025
          ]
        },
        "202070021": {
          "id": 202070021,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich empfehle dringend die Fan-Fictions von Castorice.",
          "next": [
            202070022
          ]
        },
        "202070022": {
          "id": 202070022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Ihr Schreibstil ist wirklich vielseitig. Früher oder später wird dich ein Werk völlig umhauen.",
          "next": [
            202070025
          ]
        },
        "202070023": {
          "id": 202070023,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Unter dem Lesestoff aus Amphoreus gibt es auch einige bahnbrechende Werke.",
          "next": [
            202070024
          ]
        },
        "202070024": {
          "id": 202070024,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Lass mich das noch mal durchgehen und dann später eine Liste erstellen.",
          "next": [
            202070025
          ]
        },
        "202070025": {
          "id": 202070025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Super! Ich kann es kaum erwarten!",
          "next": [
            202070026
          ]
        },
        "202070026": {
          "id": 202070026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1408,
          "text": "Wenn ich etwas Interessantes sehe, werde ich es dir auch empfehlen.",
          "next": [
            202070027
          ]
        },
