            202080017
          ]
        },
        "202080017": {
          "id": 202080017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Was für eine warme und melancholische Stimme, ganz anders als alles, was ich je gehört habe. Sie kommt wohl aus dieser Welt, die aus süßen Träumen besteht? Ich würde sie so gerne live hören.",
          "next": [
            202080018
          ]
        },
        "202080018": {
          "id": 202080018,
          "type": "Text",
