            202080008
          ]
        },
        "202080008": {
          "id": 202080008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Hmm. Ich habe eine neue Geige gebaut. Ich habe sie mit glänzenden Perlen verziert. Die Goldweberin hat die Saiten für mich geflochten. Die Imperatorin hat ihr einen Namen gegeben. Die Obertöne sind wie das tanzende Licht auf den Wellen. Jetzt lebt sie nur noch, um gespielt zu werden.",
          "next": [
            202080009
          ]
        },
        "202080009": {
          "id": 202080009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
