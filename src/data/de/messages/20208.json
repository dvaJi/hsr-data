        "202080010": {
          "id": 202080010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Es ist schon lange her, dass ich eine echte Melodie gespielt habe ... Ich bin etwas aus der Übung.",
