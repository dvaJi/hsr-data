          ]
        },
        "202080015": {
          "id": 202080015,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich würde gerne „Wenn ich verhindern kann, dass ein Herz bricht“ hören. Ich schicke dir eine Audiodatei!",
