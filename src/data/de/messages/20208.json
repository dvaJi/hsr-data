        "202080013": {
          "id": 202080013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1410,
          "text": "Ich habe gerade ein bisschen getrunken und bin jetzt in Stimmung. Kleiner grauer Fisch, gibt es etwas, das du hören möchtest? Ich kann es für dich spielen.",
          "next": [
            202080014
          ]
        },
        "202080014": {
          "id": 202080014,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
