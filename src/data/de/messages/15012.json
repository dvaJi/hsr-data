      "messages": {
        "150120100": {
          "id": 150120100,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Hey du Gauner, was machst du da?",
          "next": [
            150120101
          ]
        },
        "150120101": {
          "id": 150120101,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wer bist du?",
          "next": [
            150120102
          ]
        },
        "150120102": {
          "id": 150120102,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Stell dich nicht dumm! Du bist der Verantwortliche von Furbokom, du hast das alles hier geplant, oder?",
          "next": [
            150120103
          ]
        },
        "150120103": {
          "id": 150120103,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Meine Hände gehorchen mir nicht mehr.",
          "next": [
            150120104
          ]
        },
        "150120104": {
          "id": 150120104,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Meine Nase zuckt auch.",
          "next": [
            150120105
          ]
        },
        "150120105": {
          "id": 150120105,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Hör sofort auf!",
          "next": [
            150120106,
            150120109
          ]
        },
        "150120106": {
          "id": 150120106,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du bist also der Millennium-Killer?",
          "next": [
            150120107
          ]
        },
        "150120107": {
          "id": 150120107,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Woher kennst du meine Telefonnummer?",
          "next": [
            150120108
          ]
        },
        "150120108": {
          "id": 150120108,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Du weißt nicht einmal, wer ich bin? Wie lächerlich, du weißt überhaupt nicht, wer ich bin, und trotzdem gehst du so weit.",
          "next": [
            150120112
          ]
        },
        "150120109": {
          "id": 150120109,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du bist also dieser Arzt, Izol?",
          "next": [
            150120110
          ]
        },
        "150120110": {
          "id": 150120110,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Woher kennst du meine Telefonnummer?",
          "next": [
            150120111
          ]
        },
        "150120111": {
          "id": 150120111,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Bin ich nicht! Wie lächerlich, du weißt überhaupt nicht, wer ich bin, und trotzdem gehst du so weit.",
          "next": [
            150120112
          ]
        },
        "150120112": {
          "id": 150120112,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Was deine Kontaktdaten angeht,",
          "next": [
            150120113
          ]
        },
        "150120113": {
          "id": 150120113,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "sind die Kontaktdaten der Medienverantwortlichen alle öffentlich zugänglich. Weißt du das etwa nicht?",
          "next": [
            150120114
          ]
        },
        "150120114": {
          "id": 150120114,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Hör auf damit. Nenn mir deine Bedingungen, ich werde sie alle erfüllen. Du musst nicht so grausam sein.",
          "next": [
            150120115
          ]
        },
        "150120115": {
          "id": 150120115,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Meine Unterschenkel zeigen in eine komische Richtung.",
          "next": [
            150120116
          ]
        },
        "150120116": {
          "id": 150120116,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 206,
          "text": "Sei nicht so.",
          "next": []
        }
      },
