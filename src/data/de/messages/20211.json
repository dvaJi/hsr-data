  "sections": [
    {
      "id": 2021100,
      "startingMessageId": [
        202110000
      ],
      "messages": {
        "202110000": {
          "id": 202110000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Dux Primarius, ich bereite gerade einen Plan für meine erste „Extreme Erkundung“ vor.",
          "next": [
            202110001
          ]
        },
        "202110001": {
          "id": 202110001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Als {F#erfahrene interstellare Reisende}{M#erfahrener interstellarer Reisender} wirst du mir bestimmt umfassendere Ratschläge geben können.",
          "next": [
            202110002,
            202110004,
            202110005
          ]
        },
        "202110002": {
          "id": 202110002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du gehst allein? Wo willst du denn hin?",
          "next": [
            202110003
          ]
        },
        "202110003": {
          "id": 202110003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Wenn jemand mitkommen möchte, habe ich natürlich nichts dagegen.",
          "next": [
            202110007
          ]
        },
        "202110004": {
          "id": 202110004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wo willst du denn hin?",
          "next": [
            202110007
          ]
        },
        "202110005": {
          "id": 202110005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du kannst gerne in den Astralexpress einsteigen.",
          "next": [
            202110006
          ]
        },
        "202110006": {
          "id": 202110006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Ein möglicher Zwischenstopp auf meiner Reise. Aber heben wir uns das für später auf ...",
          "next": [
            202110007
          ]
        },
        "202110007": {
          "id": 202110007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Zielort: Amphoreus in der Zukunft.",
          "next": [
            202110008
          ]
        },
        "202110008": {
          "id": 202110008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Auf meinen vergangenen Eroberungen blieben mir die Stadtstaaten nur als Flammen des Zwists oder die todbringende Schwarze Flut in Erinnerung.",
          "next": [
            202110009
          ]
        },
        "202110009": {
          "id": 202110009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Wenn der Samen der Erinnerung erblüht, wird Amphoreus zum Leben erwachen. Die perfekte Zeit für mich, es zu erkunden.",
          "next": [
            202110010
          ]
        },
        "202110010": {
          "id": 202110010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Ich möchte mit einem Segelboot durch die Gewässer von Skiana segeln, wo sich die dunklen Wolken und die gewaltigen Wellen in einem ewigen Kampf befinden.",
          "next": [
            202110011
          ]
        },
        "202110011": {
          "id": 202110011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Hast du schon von Ladon gehört? Dort gibt es einen Gipfel, der so hoch ist, dass er die Wolken berührt.",
          "next": [
            202110012
          ]
        },
        "202110012": {
          "id": 202110012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Ich überlege noch, ob ich einen Wingsuit-Flug oder einen Fallschirmsprung machen soll.",
          "next": [
            202110013
          ]
        },
        "202110013": {
          "id": 202110013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Irgendwelche Vorschläge, Dux Primarius?",
          "next": [
            202110014,
            202110016,
            202110019
          ]
        },
        "202110014": {
          "id": 202110014,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mir ist alles recht. Ich bin es ja gewohnt, mich zu drehen und zu springen und dann aus großer Höhe in eine andere Welt zu fallen.",
          "next": [
            202110015
          ]
        },
        "202110015": {
          "id": 202110015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Klingt wunderbar.",
          "next": [
            202110021
          ]
        },
        "202110016": {
          "id": 202110016,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Das ist eine lange Geschichte ... Ich lande oft aus großer Höhe in einer neuen Welt.",
          "next": [
            202110017
          ]
        },
        "202110017": {
          "id": 202110017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du solltest es auch mal versuchen.",
          "next": [
            202110018
          ]
        },
        "202110018": {
          "id": 202110018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Klingt wunderbar.",
          "next": [
            202110021
          ]
        },
        "202110019": {
          "id": 202110019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Bitte pass auf dich auf!",
          "next": [
            202110020
          ]
        },
        "202110020": {
          "id": 202110020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Keine Sorge, die Imperatorin ist alles andere als zimperlich.",
          "next": [
            202110021
          ]
        },
        "202110021": {
          "id": 202110021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Vor Kurzem habe ich das spezielle Überlebenstraining des Kätzchens und das Seilknottraining von Dux Goldweberin absolviert.",
          "next": [
            202110022
          ]
        },
        "202110022": {
          "id": 202110022,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Nun ist es Zeit für das Schwimmtraining mit Dux Gladiorum.",
          "next": [
            202110023
          ]
        },
        "202110023": {
          "id": 202110023,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1412,
          "text": "Bis später, Dux Primarius.",
          "next": []
        }
      },
