      "messages": {
        "202260000": {
          "id": 202260000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wettervorhersage für heute: Schau zur Sonne auf, vergrabe deinen Kopf nicht in Sorgen. Sing vor dem Schlafengehen, lass keine Mahlzeiten aus.",
          "next": [
            202260001
          ]
        },
        "202260001": {
          "id": 202260001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Egal, das heutige Hexagramm zeigt „Wohlstand“. Herzlichen Glückwunsch!",
          "next": [
            202260002,
            202260005
          ]
        },
        "202260002": {
          "id": 202260002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Woher wusstest du das?",
          "next": [
            202260003
          ]
        },
        "202260003": {
          "id": 202260003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Gerade eben ist ein grünes Blatt direkt vor meinen Augen heruntergeschwebt.",
          "next": [
            202260004
          ]
        },
        "202260004": {
          "id": 202260004,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Wie Blätter zu ihren Wurzeln zurückkehren, verflechten sich Ursache und Wirkung, und ich kenne Freud und Leid.",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260005": {
          "id": 202260005,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Wie sieht mein Hexagramm für morgen aus? Meisterin Yao, kannst du eine Weissagung für mich machen?",
          "next": [
            202260006
          ]
        },
        "202260006": {
          "id": 202260006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Gerade eben ist ein grünes Blatt direkt vor meinen Augen heruntergeschwebt.",
          "next": [
            202260007
          ]
        },
        "202260007": {
          "id": 202260007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Aber wer weiß, welches Blatt morgen zu seinen Wurzeln zurückkehren wird?",
          "next": [
            202260008
          ]
        },
        "202260008": {
          "id": 202260008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Das werden wir sehen, wenn es so weit ist.",
          "next": [
            202260009,
            202260011
          ]
        },
        "202260009": {
          "id": 202260009,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Madame Yaos Wahrsagekünste sind der Wahnsinn!",
          "next": [
            202260010
          ]
        },
        "202260010": {
          "id": 202260010,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Und trotzdem habe ich das Gefühl, dass du mich übers Ohr haust.",
          "next": [
            202260013
          ]
        },
        "202260011": {
          "id": 202260011,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Was für eine einzigartige Art der Wahrsagerei.",
          "next": [
            202260012
          ]
        },
        "202260012": {
          "id": 202260012,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Und trotzdem habe ich das Gefühl, dass du mich übers Ohr haust.",
          "next": [
            202260013
          ]
        },
        "202260013": {
          "id": 202260013,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Omniscia verschont niemanden, und hinter jeder Bewegung aller Dinge stecken Gründe.",
          "next": [
            202260014
          ]
        },
        "202260014": {
          "id": 202260014,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1502,
          "next": [
            202260015
          ]
        },
        "202260015": {
          "id": 202260015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Abgesehen von der Weissagung mit bestimmten Werkzeugen ist dies eine flexiblere Methode.",
          "next": [
            202260016
          ]
        },
        "202260016": {
          "id": 202260016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Welche Beispiele soll ich nennen? Die Muster auf den Blättern, die Fingerabdrücke auf der Tasse ... Oh, ich koche nun Tee-Eier.",
          "next": [
            202260017
          ]
        },
        "202260017": {
          "id": 202260017,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Freund tippt gerade ...",
          "next": [
            202260018
          ]
        },
        "202260018": {
          "id": 202260018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Ich habe eines zufällig ausgewählt. Die Risse auf der Eierschale sind wie Brokat, also gibt es reichlich Gelegenheiten, und das Protein kondensiert in der Schale, also ist es der Moment, in dem sich der Reichtum sammelt!",
          "next": [
            202260019
          ]
        },
        "202260019": {
          "id": 202260019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1502,
          "text": "Gut, sieht so aus, als hätten wir beide eine Glückssträhne.",
          "next": [
            202260020,
            202260022
          ]
        },
        "202260020": {
          "id": 202260020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Dein Name ... Er hat 8 Buchstaben!",
          "next": [
            202260021
          ]
        },
        "202260021": {
          "id": 202260021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Alle Wege führen zum Erfolg ... Madame Yao, morgen muss es Wohl sein!",
          "next": [
            202260024
          ]
        },
        "202260022": {
          "id": 202260022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Die Sonne geht im Osten auf und im Westen unter ...",
          "next": [
            202260023
          ]
        },
        "202260023": {
          "id": 202260023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Madame Yao, morgen muss es Wohl sein!",
