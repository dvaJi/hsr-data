        "150510107": {
          "id": 150510107,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1309,
          "text": "Wir haben noch ein bisschen Zeit bis zur nächsten Ankündigung. Wollen wir uns kurz am Transitdock treffen?",
