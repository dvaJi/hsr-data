      "messages": {
        "202130000": {
          "id": 202130000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "{NICKNAME}, schläfst du?",
          "next": [
            202130001
          ]
        },
        "202130001": {
          "id": 202130001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ich kann nicht schlafen ...",
          "next": [
            202130002,
            202130004
          ]
        },
        "202130002": {
          "id": 202130002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich schlafe.",
          "next": [
            202130003
          ]
        },
        "202130003": {
          "id": 202130003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Wie unlustig.",
          "next": [
            202130005
          ]
        },
        "202130004": {
          "id": 202130004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich kann auch nicht schlafen.",
          "next": [
            202130005
          ]
        },
        "202130005": {
          "id": 202130005,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "*seufz* Ich hab mir gerade einen Film angeschaut.",
          "next": [
            202130006
          ]
        },
        "202130006": {
          "id": 202130006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Er soll auf einer wahren Geschichte basieren. Es ging um jemanden mit über zwanzig Persönlichkeiten ...",
          "next": [
            202130007
          ]
        },
        "202130007": {
          "id": 202130007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Der Protagonist hatte außerdem Gedächtnislücken. Er dachte, es sei nur eine normale Amnesie, aber in Wirklichkeit haben andere Persönlichkeiten sein Leben für ihn weitergeführt.",
          "next": [
            202130008
          ]
        },
        "202130008": {
          "id": 202130008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Meinst du, ich bin vielleicht auch ...",
          "next": [
            202130009
          ]
        },
        "202130009": {
          "id": 202130009,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Kontakt tippt gerade ...",
          "next": [
            202130010,
            202130013
          ]
        },
        "202130010": {
          "id": 202130010,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ja ... Du hast es erraten ...",
          "next": [
            202130011
          ]
        },
        "202130011": {
          "id": 202130011,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Also ... du gestern ... warst nicht du heute ... denn du gestern ... warst niedlicher ...",
          "next": [
            202130012
          ]
        },
        "202130012": {
          "id": 202130012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Sei gefälligst nicht so unhöflich! Ich bin heute niedlich und morgen noch niedlicher!",
          "next": [
            202130014
          ]
        },
        "202130013": {
          "id": 202130013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keine Sorge. Aus meiner allwissenden Perspektive kann ich dir versichern, du bist vollkommen du selbst.",
          "next": [
            202130014
          ]
        },
        "202130014": {
          "id": 202130014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Auch wenn du darüber Witze machst, mache ich mir trotzdem ein bisschen Sorgen.",
          "next": [
            202130015
          ]
        },
        "202130015": {
          "id": 202130015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Ob es ... vielleicht noch andere 7. Märze gibt!?",
          "next": [
            202130016
          ]
        },
        "202130016": {
          "id": 202130016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Vielleicht ... eine 7. März, die exzentrische Künstlerin ist? Oder eine elegante Auftragsmörderin mit ausgezeichneten sozialen Fähigkeiten? Gruselig ...",
          "next": [
            202130017
          ]
        },
        "202130017": {
          "id": 202130017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Es wird doch nicht etwa noch eine weitere 7. März geben, die ein wahres Genie ist ...",
          "next": [
            202130018,
            202130020,
            202130022
          ]
        },
        "202130018": {
          "id": 202130018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Alles klar. Gerade ist wohl Träumerei angesagt ... Du solltest schlafen gehen.",
          "next": [
            202130019
          ]
        },
        "202130019": {
          "id": 202130019,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Nach dem Aufwachen wirst du immer noch die süße, sanfte, gütige, unschuldige, hübsche 7. März sein.",
          "next": [
            202130024
          ]
        },
        "202130020": {
          "id": 202130020,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Und vergiss nicht, du bist auch 7. März, die Schwertmeisterin des Astralexpresses.",
          "next": [
            202130021
          ]
        },
        "202130021": {
          "id": 202130021,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Keine Sorge, du bist immer noch die süße, sanfte, gütige, unschuldige, hübsche 7. März.",
          "next": [
            202130024
          ]
        },
        "202130022": {
          "id": 202130022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Keine Sorge, es ist alles in Ordnung.",
          "next": [
            202130023
          ]
        },
        "202130023": {
          "id": 202130023,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du bist die süße, sanfte, gütige, unschuldige, hübsche 7. März.",
          "next": [
            202130024
          ]
        },
        "202130024": {
          "id": 202130024,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1001,
          "next": [
            202130025
          ]
        },
        "202130025": {
          "id": 202130025,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Du weißt echt, wie man mit Worten umgeht ...",
          "next": [
            202130026
          ]
        },
        "202130026": {
          "id": 202130026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Na gut, ich gebe zu, dass es mir jetzt wohl nicht mehr so wichtig ist.",
          "next": [
            202130027
          ]
        },
        "202130027": {
          "id": 202130027,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Immerhin bin ich die gesellige, großzügige, kluge, bezaubernde, schlaue, süße, sanfte, gütige und unschuldige, hübsche 7. März!",
          "next": [
            202130028
          ]
        },
        "202130028": {
          "id": 202130028,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Geh schlafen, {NICKNAME}.",
          "next": [
            202130029
          ]
        },
        "202130029": {
          "id": 202130029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1001,
          "text": "Morgen wasche ich nach dem Essen dein Geschirr ab.",
          "next": []
        }
      },
