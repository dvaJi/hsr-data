        },
        "201760014": {
          "id": 201760014,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Ach nein, das ist eine Fälschung. Das Original wurde schon verkauft.",
          "next": [
            201760015
          ]
        },
        "201760015": {
          "id": 201760015,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Warte.",
          "next": [
            201760016
          ]
        },
        "201760016": {
          "id": 201760016,
          "type": "Text",
          "sender": "System",
          "senderContactId": 8001,
          "text": "Dein Kontakt hat seinen Standort freigegeben.",
          "next": [
            201760017
          ]
        },
        "201760017": {
          "id": 201760017,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Wenn du kommst, achte auf das Schild mit der Aufschrift „Käufer: Die unvergleichliche Frau Herta“.",
