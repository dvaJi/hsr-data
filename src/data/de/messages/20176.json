        },
        "201760024": {
          "id": 201760024,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Aber sie haben mich gelobt, dass ich ihr sehr ähnlich sehe, und mir ein paar Herta-Fanartikel gegeben.",
