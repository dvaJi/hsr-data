            201760018
          ]
        },
        "201760018": {
          "id": 201760018,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Du hast eine Fälschung gekauft?",
          "next": [
            201760019
          ]
        },
        "201760019": {
          "id": 201760019,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Das Original habe ich schon längst gekauft. Total vergessen.",
          "next": [
            201760020
          ]
        },
        "201760020": {
          "id": 201760020,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Hier wird noch eine Nachbildung zur Ausstellung genutzt.",
          "next": [
            201760021
          ]
        },
        "201760021": {
          "id": 201760021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Kein Wunder, dass sich hier so viele Leute versammelt haben. Es sind meine Fans.",
          "next": [
            201760022
          ]
        },
        "201760022": {
          "id": 201760022,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Die Fans hätten nie gedacht, dass sie auf das Original treffen würden.",
