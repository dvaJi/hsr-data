          ]
        },
        "201760007": {
          "id": 201760007,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1401,
          "text": "Etwas Interessantes ist aufgetaucht. Wir sollten überlegen, es in die Universum-Simulation aufzunehmen.",
