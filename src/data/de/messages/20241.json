  "sections": [
    {
      "id": 2024100,
      "startingMessageId": [
        202410000
      ],
      "messages": {
        "202410000": {
          "id": 202410000,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ich habe meinen Koffer neu geordnet und dabei eine lebenslange Mitgliedskarte gefunden, die für alle Friseursalons in ganz Planarcadia gültig ist.",
          "next": [
            202410001
          ]
        },
        "202410001": {
          "id": 202410001,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Wem gebe ich das am besten?",
          "next": [
            202410002,
            202410004,
            202410007
          ]
        },
        "202410002": {
          "id": 202410002,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich bin {F#die einzige Minderjährige}{M#der einzige Minderjährige} im ganzen Express. Gib sie mir!",
          "next": [
            202410003
          ]
        },
        "202410003": {
          "id": 202410003,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ich wusste, dass sie dir gefällt! Hier, für dich. Später kannst du sogar alle zum Friseur mitnehmen.",
          "next": [
            202410009
          ]
        },
        "202410004": {
          "id": 202410004,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Mal überlegen ... März wird es bestimmt gefallen, Dan Heng wird es wohl nicht ablehnen, Sonntag ist auch recht gepflegt, und Herr Yang hat ja auch Haare ...",
          "next": [
            202410005
          ]
        },
        "202410005": {
          "id": 202410005,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Gib sie lieber mir! Ich nehme alle mit zum Friseur.",
          "next": [
            202410006
          ]
        },
        "202410006": {
          "id": 202410006,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Gut. Das dachte ich mir auch.",
          "next": [
            202410009
          ]
        },
        "202410007": {
          "id": 202410007,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Die ganze Express-Familie kann abwechselnd den Service des Cheffriseurs genießen und sich die Haare stylen lassen!",
          "next": [
            202410008
          ]
        },
        "202410008": {
          "id": 202410008,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Das dachte ich mir auch!",
          "next": [
            202410009
          ]
        },
        "202410009": {
          "id": 202410009,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Während meiner Schulzeit in Planarcadia habe ich es auch geliebt, verschiedene Frisuren auszuprobieren.",
          "next": [
            202410010
          ]
        },
        "202410010": {
          "id": 202410010,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Ich erinnere mich, dass ich mir die Haare in einer Farbe gefärbt habe, die der von Märzchen sehr ähnlich war. Ich wollte auch mal eine Kurzhaarfrisur wie die von Dan Heng ausprobieren, aber mein Friseur hat mich mit Händen und Füßen davon abgehalten.",
          "next": [
            202410011
          ]
        },
        "202410011": {
          "id": 202410011,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Am Ende sah die Frisur eher wie ein Vokuhila aus und ähnelte ein wenig der von Sonntag.",
          "next": [
            202410012
          ]
        },
        "202410012": {
          "id": 202410012,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Wenn ich so darüber nachdenke, war es ziemlich rücksichtsvoll von ihnen, diese Friseurkarte als Schutzgeld abzugeben.",
          "next": [
            202410013,
            202410019,
            202410024
          ]
        },
        "202410013": {
          "id": 202410013,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Ich will den ganzen Katalog von Himekos Frisuren sehen! Gibt es Fotos?!",
          "next": [
            202410014
          ]
        },
        "202410014": {
          "id": 202410014,
          "type": "Sticker",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "next": [
            202410015
          ]
        },
        "202410015": {
          "id": 202410015,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Moment mal, welches Geld??",
          "next": [
            202410016
          ]
        },
        "202410016": {
          "id": 202410016,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Hm? Oh, nur ein freundliches Andenken, das ich während meiner Schulzeit bekommen habe.",
          "next": [
            202410017
          ]
        },
        "202410017": {
          "id": 202410017,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das nennst du also freundlich!",
          "next": [
            202410018
          ]
        },
        "202410018": {
          "id": 202410018,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Was die Fotos betrifft, erinnere ich mich nicht mehr genau, ob ich welche mit an Bord des Expresses genommen habe, aber ich kann mal nachsehen.",
          "next": [
            202410029
          ]
        },
        "202410019": {
          "id": 202410019,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Himeko, kannst du mir eine Frisur empfehlen? Ich möchte diesen Schopf auf meinem Kopf auch mal verändern.",
          "next": [
            202410020
          ]
        },
        "202410020": {
          "id": 202410020,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Moment mal, Schutzgeld??",
          "next": [
            202410021
          ]
        },
        "202410021": {
          "id": 202410021,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Hm? Oh, nur ein freundliches Andenken ... das ich während meiner Schulzeit bekommen habe.",
          "next": [
            202410022
          ]
        },
        "202410022": {
          "id": 202410022,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das nennst du also freundlich!",
          "next": [
            202410023
          ]
        },
        "202410023": {
          "id": 202410023,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1003,
          "next": [
            202410029
          ]
        },
        "202410024": {
          "id": 202410024,
          "type": "Text",
          "sender": "Player",
          "senderContactId": 8001,
          "text": "Moment mal, welches Geld?",
          "next": [
