          ]
        },
        "202410026": {
          "id": 202410026,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Oh, nur ein freundliches Andenken ... das ich während meiner Schulzeit bekommen habe.",
          "next": [
            202410027
          ]
        },
        "202410027": {
          "id": 202410027,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Das nennst du also freundlich!",
          "next": [
            202410028
          ]
        },
        "202410028": {
          "id": 202410028,
          "type": "Sticker",
          "sender": "NPC",
          "senderContactId": 1003,
          "next": [
            202410029
          ]
        },
        "202410029": {
          "id": 202410029,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Eigentlich habe ich noch über ein Dutzend Perücken verstaut ... Damals an der Uni, immer wenn Motoko und ich vom Zeichnen und Reparieren erschöpft waren, haben wir uns gegenseitig verschiedene Perücken angefertigt und zugeschnitten, um sie anzuprobieren.",
          "next": [
            202410030
          ]
        },
        "202410030": {
          "id": 202410030,
          "type": "Text",
          "sender": "PlayerAuto",
          "senderContactId": 8001,
          "text": "Du wechselst das Thema!",
          "next": [
            202410031
          ]
        },
        "202410031": {
          "id": 202410031,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Jetzt habe ich einen Grund, sie hervorzuholen und mit euch allen zu teilen! Ich würde gerne sehen, welche Frisuren und Farben euch jeweils gefallen.",
          "next": [
            202410032
          ]
        },
        "202410032": {
          "id": 202410032,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Selbst wenn sie nicht perfekt passen, sollte mein Gespür fürs Styling noch da sein. Ich kann sie direkt vor Ort anpassen.",
          "next": [
            202410033
          ]
        },
        "202410033": {
          "id": 202410033,
          "type": "Text",
          "sender": "NPC",
          "senderContactId": 1003,
          "text": "Sobald alle wieder im Express sind, nehme ich das in die Hand.",
          "next": [
            202410034
          ]
        },
        "202410034": {
          "id": 202410034,
          "type": "Sticker",
